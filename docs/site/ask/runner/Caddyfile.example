# Replace this hostname. Keep the Python server listening on loopback only.
run-landin.example.net {
    request_body {
        max_size 16KB
    }
    @run {
        path /run
        method POST
    }
    handle @run {
        reverse_proxy 127.0.0.1:8788 {
            transport http {
                response_header_timeout 30s
            }
        }
    }
    handle {
        respond 404
    }
}
