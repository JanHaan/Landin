--  The C library, declared as ordinary extern(c) imports, raw: the
--  system's own interface on Darwin and FreeBSD, and C's on Linux.  On
--  Darwin and FreeBSD, whose C library is their system interface,
--  platform/posix reaches the operating system only through these
--  declarations; on Linux it makes platform/linux's system calls, and this
--  module serves a program linked with --link=libc.  Its scope is the
--  systems with a C library, Linux, Darwin and FreeBSD.  Every declaration
--  here is bodyless, so a program that names none of them needs no C
--  library, and a static Linux program that names one is refused before it
--  links (D280).  Facts that differ between systems are selected by
--  `compiler.os`, record layouts by the C ABI as well, and the native C
--  headers of each system check them: the `stat` record in
--  abi/core-io-file-identity, the rest in the hosted runtime and ABI
--  fixtures.

compiler.assert(compiler.os == linux or compiler.os == darwin
                or compiler.os == freebsd)

--- Open the file at the NUL-terminated `path` and return its descriptor, or
--- -1 with the reason in errno.  `flags` is `o_rdonly` or `o_wronly`, or'd
--- with `o_creat` and `o_trunc`; with `o_creat` the one variadic argument
--- is the new file's permission bits as an `i32`, which the process umask
--- filters.
public extern(c) open: (path: ptr u8, flags: i32, ...) -> (descriptor: i32)

--- Read at most `length` bytes from `descriptor` into `data`.  The count
--- read, zero at end of file, or -1 with the reason in errno.  EINTR means
--- nothing was transferred.
public extern(c) read: (descriptor: i32, data: ptr mut u8, length: usize)
                       -> (count: isize)

--- Write at most `length` bytes from `data` to `descriptor`.  The count
--- accepted, which may be short, or -1 with the reason in errno.  EINTR
--- means nothing was transferred.
public extern(c) write: (descriptor: i32, data: ptr u8, length: usize)
                        -> (count: isize)

--- Open `path`, relative to the directory open as `directory` (or
--- `at_fdcwd`), as `open` does: the new descriptor, or -1 with the reason
--- in errno.  With `o_creat` the one variadic argument is the permission
--- bits as an `i32`.
public extern(c) openat: (directory: i32, path: ptr u8, flags: i32, ...)
                         -> (descriptor: i32)

--- Close `descriptor`: 0, or -1 with the reason in errno.  The descriptor
--- may be released even when this fails, so a failed close is never
--- retried.
public extern(c) close: (descriptor: i32) -> (status: i32)

--- The number of bytes before the first NUL at `text`.
public extern(c) strlen: (text: ptr u8) -> (length: usize)

--- What `malloc` returns when it cannot allocate: C's null pointer.
public no_allocation: atom

--- A `malloc` result: a block, or `no_allocation`.
public allocation: type = no_allocation | ptr mut u8

--- Allocate `size` bytes aligned for any C object, or `no_allocation`.
--- `malloc(0)` may return either; a caller that needs a distinct block for
--- an empty request asks for a nonzero size.
public extern(c) malloc: (size: usize) -> (block: allocation)

--- Give a block from `malloc` back to the C library.
public extern(c) free: (block: ptr mut u8) -> none

fixed if compiler.os == linux then
    --- The calling thread's errno cell, `__errno_location` on Linux and
    --- `__error` on Darwin and FreeBSD.  Read it immediately after the
    --- failing call, before any other call that may set it.
    public extern(c) link(symbol: "__errno_location") errno_cell:
        () -> (cell: ptr mut i32)
else
    --- The calling thread's errno cell, `__errno_location` on Linux and
    --- `__error` on Darwin and FreeBSD.  Read it immediately after the
    --- failing call, before any other call that may set it.
    public extern(c) link(symbol: "__error") errno_cell:
        () -> (cell: ptr mut i32)
end if

--- errno: the operation is not permitted.  The same on every hosted
--- system.
public eperm: i32 = 1
--- errno: no such file or directory.
public enoent: i32 = 2
--- errno: interrupted by a signal before anything was transferred.
public eintr: i32 = 4
--- errno: permission denied.
public eacces: i32 = 13
--- errno: a path component is not a directory.
public enotdir: i32 = 20
--- errno: the file system is read-only.
public erofs: i32 = 30

--- `open` flag: read only.  The same on every hosted system.
public o_rdonly: i32 = 0
--- `open` flag: write only.  The same on every hosted system.
public o_wronly: i32 = 1
--- `open` flag: read and write.  The same on every hosted system.
public o_rdwr: i32 = 2

fixed if compiler.os == linux then
    --- `open` flag: create the file if it does not exist.  Linux keeps one
    --- value on every architecture; Darwin and FreeBSD share the BSD one.
    public o_creat: i32 = 64
    --- `open` flag: truncate an existing regular file to length zero.
    public o_trunc: i32 = 512
    --- `open` flag: with `o_creat`, fail with EEXIST if the name is taken.
    public o_excl: i32 = 128
    --- `open` flag: every write goes to the end of the file.
    public o_append: i32 = 1024
    --- `mmap` flag: the mapping is backed by no file and starts zeroed.
    public map_anonymous: i32 = 32
    --- `poll`'s count of records, C's `nfds_t`.
    public poll_count: type = u64
else
    --- `open` flag: create the file if it does not exist.  Linux keeps one
    --- value on every architecture; Darwin and FreeBSD share the BSD one.
    public o_creat: i32 = 512
    --- `open` flag: truncate an existing regular file to length zero.
    public o_trunc: i32 = 1024
    --- `open` flag: with `o_creat`, fail with EEXIST if the name is taken.
    public o_excl: i32 = 2048
    --- `open` flag: every write goes to the end of the file.
    public o_append: i32 = 8
    --- `mmap` flag: the mapping is backed by no file and starts zeroed.
    public map_anonymous: i32 = 4096
    --- `poll`'s count of records, C's `nfds_t`.
    public poll_count: type = u32
end if

--- `mmap` protection: the pages may be read.  The same on every hosted
--- system.
public prot_read: i32 = 1
--- `mmap` protection: the pages may be written.
public prot_write: i32 = 2
--- `mmap` flag: the mapping is private to this process.
public map_private: i32 = 2

--- Map `length` bytes, at a place of the system's choosing when `address`
--- is zero: the mapping's address, or `map_failed` with the reason in
--- errno.  With `map_anonymous` the descriptor is -1 and the offset zero.
public extern(c) mmap: (address: usize, length: usize, protection: i32,
                        flags: i32, descriptor: i32, offset: i64)
                       -> (result: usize)

--- What `mmap` returns when it fails: C's `MAP_FAILED`, all bits set.
public map_failed: usize = 0 -% 1

--- Unmap the `length` bytes at `address`: 0, or -1 with the reason in
--- errno.
public extern(c) munmap: (address: usize, length: usize) -> (status: i32)

--- The size of a page in bytes, 16 KiB on Darwin arm64 and 4 KiB on the
--- others.
public extern(c) getpagesize: () -> (bytes: i32)

--- End the process with `status` at once: no `atexit` handler runs and no
--- C stream is flushed.
public extern(c) _exit: (status: i32) -> noreturn

--- One record `poll` reads and fills, C's `struct pollfd`: the descriptor
--- to watch, the events asked about and the events that happened.  A
--- negative descriptor is ignored.  The same on every hosted system.
public poll_record: type = struct
    descriptor: i32
    events: i16
    returned: i16
end poll_record

--- Wait until one of the `count` records at `records` has an event, or
--- `timeout` milliseconds pass, waiting indefinitely when it is negative:
--- the number of records with an event, zero when the time passed first,
--- or -1 with the reason in errno.
public extern(c) poll: (records: ptr mut poll_record, count: poll_count,
                        timeout: i32) -> (result: i32)

--- C's `struct timespec`: whole seconds and the nanoseconds after them.
public timespec: type = struct
    seconds: i64
    nanoseconds: i64
end timespec

--- `clock_gettime` clock: the wall clock.  The same on every hosted
--- system.
public clock_realtime: i32 = 0

fixed if compiler.os == linux then
    --- `clock_gettime` clock: time since a point the system fixes, never
    --- set back.  Each system numbers it its own way.
    public clock_monotonic: i32 = 1
elsif compiler.os == darwin then
    --- `clock_gettime` clock: time since a point the system fixes, never
    --- set back.  Each system numbers it its own way.
    public clock_monotonic: i32 = 6
else
    --- `clock_gettime` clock: time since a point the system fixes, never
    --- set back.  Each system numbers it its own way.
    public clock_monotonic: i32 = 4
end if

--- Fill `into` with the clock `clock`'s time, `clock` a C `clockid_t`,
--- which is an `int` on every hosted system: 0, or -1 with the reason in
--- errno.
public extern(c) clock_gettime: (clock: i32, into: ptr mut timespec)
                                -> (status: i32)

--- Sleep for the time `request` gives: 0 once it has passed, or -1 with
--- the reason in errno, EINTR when a signal came first, with what was
--- left in `remaining`.
public extern(c) nanosleep: (request: ptr timespec,
                             remaining: ptr mut timespec) -> (status: i32)

fixed if compiler.os == darwin or compiler.os == freebsd then
    --- Fill the `length` bytes at `into` with random bytes from the C
    --- library's generator, which the kernel's entropy keys and rekeys and
    --- which is fit for keys.  It never fails.  Darwin's and FreeBSD's.
    public extern(c) arc4random_buf: (into: ptr mut u8, length: usize)
                                     -> none
end if

--  Full records rather than guessed opaque storage, selected by hosted
--  system and C ABI.  Darwin arm64 uses the ordinary stat symbol with its
--  64-bit inode ABI.

fixed if compiler.os == freebsd then
    --- `sizeof (struct stat)` in the native C headers.
    public file_status_size: usize = 224
    --- C's `struct stat`, as `stat` fills it on this system.
    public file_status: type = struct
        device: u64
        inode: u64
        links: u64
        mode: u16
        bsdflags: i16
        uid: u32
        gid: u32
        padding: i32
        special_device: u64
        accessed: timespec
        modified: timespec
        changed: timespec
        born: timespec
        bytes: i64
        blocks: i64
        block_size: i32
        flags: u32
        generation: u64
        revision: u64
        spare: [9]u64
    end file_status
elsif compiler.c_sysv_lp64 then
    --- `sizeof (struct stat)` in the native C headers.
    public file_status_size: usize = 144
    --- C's `struct stat`, as `stat` fills it on this system.
    public file_status: type = struct
        device: u64
        inode: u64
        links: u64
        mode: u32
        uid: u32
        gid: u32
        padding: i32
        special_device: u64
        bytes: i64
        block_size: i64
        blocks: i64
        accessed: timespec
        modified: timespec
        changed: timespec
        reserved: [3]i64
    end file_status
elsif compiler.c_aapcs64_lp64 or compiler.c_riscv_lp64d then
    --- `sizeof (struct stat)` in the native C headers.
    public file_status_size: usize = 128
    --- C's `struct stat`, as `stat` fills it on this system.
    public file_status: type = struct
        device: u64
        inode: u64
        mode: u32
        links: u32
        uid: u32
        gid: u32
        special_device: u64
        padding1: u64
        bytes: i64
        block_size: i32
        padding2: i32
        blocks: i64
        accessed: timespec
        modified: timespec
        changed: timespec
        reserved: [2]u32
    end file_status
else
    --- `sizeof (struct stat)` in the native C headers.
    public file_status_size: usize = 144
    --- C's `struct stat`, as `stat` fills it on this system. C declares
    --- `dev_t` as `int32_t` here, but a device number is a bit pattern, not
    --- a quantity, and devfs's may have the sign bit set, so both device
    --- fields are unsigned and widening them never traps.
    public file_status: type = struct
        device: u32
        mode: u16
        links: u16
        inode: u64
        uid: u32
        gid: u32
        special_device: u32
        accessed: timespec
        modified: timespec
        changed: timespec
        created: timespec
        bytes: i64
        blocks: i64
        block_size: i32
        flags: u32
        generation: u32
        spare: i32
        reserved: [2]i64
    end file_status
end if

--- Fill `result` with the status of the file `path` names, following
--- symbolic links: 0, or -1 with the reason in errno.
public extern(c) stat: (path: ptr u8, result: ptr mut file_status)
                       -> (status: i32)

--- Fill `result` with the status of `path`, relative to the directory
--- open as `directory`: 0, or -1 with the reason in errno.  With
--- `at_symlink_nofollow` in `flags` a symbolic link is reported itself.
public extern(c) fstatat: (directory: i32, path: ptr u8,
                           result: ptr mut file_status, flags: i32)
                          -> (status: i32)

--- errno: the name already exists.  The same on every hosted system.
public eexist: i32 = 17

--- A `struct dirent`'s `d_type`: the entry's type is not known, and a
--- status call relative to the directory tells it.  The values are the
--- same on every hosted system.
public dt_unknown: u8 = 0
--- `d_type`: a directory.
public dt_dir: u8 = 4
--- `d_type`: a regular file.
public dt_reg: u8 = 8
--- `d_type`: a symbolic link.
public dt_lnk: u8 = 10

--- A `stat` mode's file-type bits, and the types among them.  The same on
--- every hosted system.
public s_ifmt: u32 = 0o170000
--- `stat` mode: a directory.
public s_ifdir: u32 = 0o040000
--- `stat` mode: a regular file.
public s_ifreg: u32 = 0o100000
--- `stat` mode: a symbolic link.
public s_iflnk: u32 = 0o120000

fixed if compiler.os == linux then
    fixed if compiler.arch == arm64 then
        --- `open` flag: fail with ENOTDIR unless the path names a
        --- directory.  Linux's arm64 keeps a value of its own.
        public o_directory: i32 = 16384
    else
        --- `open` flag: fail with ENOTDIR unless the path names a
        --- directory.  Linux's arm64 keeps a value of its own.
        public o_directory: i32 = 65536
    end if
    --- `fstatat` flag: report a symbolic link itself.
    public at_symlink_nofollow: i32 = 256

    --- C's `struct dirent` as `readdir` returns it.  glibc gives no name
    --- length: the name ends at its NUL.
    public directory_record: type = struct
        inode: u64
        offset: i64
        record_length: u16
        kind: u8
        name: [256]u8
    end directory_record

    --- The directory descriptor that makes an `*at` call's relative path
    --- relative to the working directory.
    public at_fdcwd: i32 = -100
    --- `unlinkat` flag: remove an empty directory rather than a file.
    public at_removedir: i32 = 512

    --- Make the directory `path`, relative to `directory` (or `at_fdcwd`),
    --- with the permission bits `mode`, which the process umask filters:
    --- 0, or -1 with the reason in errno.
    public extern(c) mkdirat: (directory: i32, path: ptr u8, mode: u32)
                              -> (status: i32)
elsif compiler.os == darwin then
    --- `open` flag: fail with ENOTDIR unless the path names a directory.
    --- Linux's arm64 keeps a value of its own.
    public o_directory: i32 = 1048576
    --- `fstatat` flag: report a symbolic link itself.
    public at_symlink_nofollow: i32 = 32

    --- C's `struct dirent` as `readdir` returns it, with the 64-bit
    --- inode every arm64 Darwin has.
    public directory_record: type = struct
        inode: u64
        seek_offset: u64
        record_length: u16
        name_length: u16
        kind: u8
        name: [1024]u8
    end directory_record

    --- The directory descriptor that makes an `*at` call's relative path
    --- relative to the working directory.
    public at_fdcwd: i32 = -2
    --- `unlinkat` flag: remove an empty directory rather than a file.
    public at_removedir: i32 = 128

    --- Make the directory `path`, relative to `directory` (or `at_fdcwd`),
    --- with the permission bits `mode`, which the process umask filters:
    --- 0, or -1 with the reason in errno.
    public extern(c) mkdirat: (directory: i32, path: ptr u8, mode: u16)
                              -> (status: i32)
else
    --- `open` flag: fail with ENOTDIR unless the path names a directory.
    --- Linux's arm64 keeps a value of its own.
    public o_directory: i32 = 131072
    --- `fstatat` flag: report a symbolic link itself.
    public at_symlink_nofollow: i32 = 512

    --- C's `struct dirent` as `readdir` returns it, in the layout
    --- FreeBSD 12 gave it with 64-bit inodes.
    public directory_record: type = struct
        inode: u64
        offset: i64
        record_length: u16
        kind: u8
        padding0: u8
        name_length: u16
        padding1: u16
        name: [256]u8
    end directory_record

    --- The directory descriptor that makes an `*at` call's relative path
    --- relative to the working directory.
    public at_fdcwd: i32 = -100
    --- `unlinkat` flag: remove an empty directory rather than a file.
    public at_removedir: i32 = 2048

    --- Make the directory `path`, relative to `directory` (or `at_fdcwd`),
    --- with the permission bits `mode`, which the process umask filters:
    --- 0, or -1 with the reason in errno.
    public extern(c) mkdirat: (directory: i32, path: ptr u8, mode: u16)
                              -> (status: i32)
end if

--- What `fdopendir` gives when it cannot open a directory stream, and
--- `readdir` at the end or on a failure: C's null pointer.
public no_directory: atom

--- An `fdopendir` result: a directory stream, `DIR *`, or `no_directory`.
public directory_stream: type = no_directory | ptr mut u8

--- A `readdir` result: the next record, or `no_directory`.
public directory_entry: type = no_directory | ptr directory_record

--- A directory stream over the directory open as `descriptor`, which the
--- stream then owns and `closedir` closes, or `no_directory` with the
--- reason in errno.
public extern(c) fdopendir: (descriptor: i32) -> (stream: directory_stream)

--- The stream's next record, good until the next `readdir` or `closedir`
--- on it, or `no_directory` at the end and on a failure, which errno tells
--- apart when the caller zeroed it first.  Records include `.` and `..`.
public extern(c) readdir: (stream: ptr mut u8) -> (record: directory_entry)

--- Close a directory stream and its descriptor: 0, or -1 with the reason
--- in errno.  The stream is released either way.
public extern(c) closedir: (stream: ptr mut u8) -> (status: i32)

--- Remove the name `path`, relative to `directory` (or `at_fdcwd`): a
--- file with `flags` zero, an empty directory with `at_removedir`.  0, or
--- -1 with the reason in errno.
public extern(c) unlinkat: (directory: i32, path: ptr u8, flags: i32)
                           -> (status: i32)

--- `fcntl` command: read a descriptor's flags, `fd_cloexec` among them.
--- The same on every hosted system.
public f_getfd: i32 = 1
--- `fcntl` command: set a descriptor's flags, `fd_cloexec` among them.
--- The same on every hosted system.
public f_setfd: i32 = 2
--- `fcntl` flag: the descriptor is closed when the process executes a
--- program.  The same on every hosted system.
public fd_cloexec: i32 = 1

fixed if compiler.os == linux then
    --- `open` and `pipe2` flag: the new descriptor is closed when the
    --- process executes a program, set with it.
    public o_cloexec: i32 = 524288
    --- `fcntl` command: duplicate a descriptor onto the lowest free number
    --- at or above the argument, closed on exec.
    public f_dupfd_cloexec: i32 = 1030
elsif compiler.os == darwin then
    --- `open` flag: the new descriptor is closed when the process executes
    --- a program, set with it.  Darwin has no `pipe2`.
    public o_cloexec: i32 = 16777216
    --- `fcntl` command: duplicate a descriptor onto the lowest free number
    --- at or above the argument, closed on exec.
    public f_dupfd_cloexec: i32 = 67
else
    --- `open` and `pipe2` flag: the new descriptor is closed when the
    --- process executes a program, set with it.
    public o_cloexec: i32 = 1048576
    --- `fcntl` command: duplicate a descriptor onto the lowest free number
    --- at or above the argument, closed on exec.
    public f_dupfd_cloexec: i32 = 17
end if

--- `fcntl(descriptor, command, ...)`, declared variadic as C declares it:
--- for `f_setfd` and `f_dupfd_cloexec` the one variadic argument is an
--- `i32`.  Its result, or -1 with the reason in errno.
public extern(c) fcntl: (descriptor: i32, command: i32, ...)
                        -> (result: i32)

--- Make a pipe and put its reading end in `ends[0]` and its writing end in
--- `ends[1]`: 0, or -1 with the reason in errno.  The ends are inherited
--- by a program this process executes unless `fd_cloexec` is set on each;
--- `pipe2`, where there is one, sets it with them.
public extern(c) pipe: (ends: ptr mut i32) -> (status: i32)

fixed if compiler.os == linux or compiler.os == freebsd then
    --- `pipe` with `flags`, `o_cloexec` among them, set as the pipe is
    --- made: 0, or -1 with the reason in errno.  Darwin has none.
    public extern(c) pipe2: (ends: ptr mut i32, flags: i32) -> (status: i32)
end if

--- Wait for the child `child` to end, or with `options` for less, and put
--- its status in `status`: the child's ID, or -1 with the reason in errno,
--- ECHILD when it is not this process's child.
public extern(c) waitpid: (child: i32, status: ptr mut i32, options: i32)
                          -> (result: i32)

fixed if compiler.os == darwin or compiler.os == freebsd then
    --- A `posix_spawn_file_actions_t` or a `posix_spawnattr_t`: on Darwin
    --- and FreeBSD a pointer the C library allocates, which its `init` writes
    --- into the caller's cell and its `destroy` frees.  glibc's are records of
    --- its own, so these declarations are Darwin's and FreeBSD's alone.
    public spawn_object: type = usize

    --- Start a list of the actions `posix_spawn` performs in the child before
    --- it executes the program: 0, or the errno.
    public extern(c) posix_spawn_file_actions_init:
        (actions: ptr mut spawn_object) -> (error: i32)

    --- Free a list of actions: 0, or the errno.
    public extern(c) posix_spawn_file_actions_destroy:
        (actions: ptr mut spawn_object) -> (error: i32)

    --- Add to `actions` making the child's `target` a duplicate of `source`:
    --- 0, or the errno.
    public extern(c) posix_spawn_file_actions_adddup2:
        (actions: ptr mut spawn_object, source: i32, target: i32) -> (error: i32)

    --- Start a set of attributes for `posix_spawn`: 0, or the errno.
    public extern(c) posix_spawnattr_init:
        (attributes: ptr mut spawn_object) -> (error: i32)

    --- Free a set of attributes: 0, or the errno.
    public extern(c) posix_spawnattr_destroy:
        (attributes: ptr mut spawn_object) -> (error: i32)

    --- Set the attributes' flags, C's `short`: 0, or the errno.
    public extern(c) posix_spawnattr_setflags:
        (attributes: ptr mut spawn_object, flags: i16) -> (error: i32)

    --- Start the program at `path`, with the null-terminated `arguments` and
    --- `environment` tables, in a child, applying `actions` and `attributes`
    --- first, and put its ID in `child`: 0, or the errno, which a program
    --- that could not be executed reports too, its child already reaped.
    --- Nothing searches a path for the program.
    public extern(c) posix_spawn:
        (child: ptr mut i32, path: ptr u8, actions: ptr spawn_object,
         attributes: ptr spawn_object, arguments: ptr ptr u8,
         environment: ptr ptr u8) -> (error: i32)
end if

fixed if compiler.os == darwin then
    --- `posix_spawnattr_setflags` flag, Darwin's own: every descriptor the
    --- actions do not name is closed in the child, as though each were
    --- closed on exec.
    public posix_spawn_cloexec_default: i16 = 16384

    --- Add to `actions` that the child keeps `descriptor` as it is, which
    --- `posix_spawn_cloexec_default` would otherwise close: Darwin's own.
    public extern(c) posix_spawn_file_actions_addinherit_np:
        (actions: ptr mut spawn_object, descriptor: i32) -> (error: i32)
elsif compiler.os == freebsd then
    --- Add to `actions` closing every descriptor of the child from
    --- `first` up: FreeBSD's own, since 13.1.
    public extern(c) posix_spawn_file_actions_addclosefrom_np:
        (actions: ptr mut spawn_object, first: i32) -> (error: i32)
end if

--  Sockets and the SIGPIPE disposition.  Every call is declared on the
--  three systems, whose C signatures agree; the numbers that differ are
--  selected by `compiler.os`.  An address is the system's own `struct
--  sockaddr` record, given as a pointer and a length: platform/posix
--  lays out each system's records, `sin_len` and all.

--- `socket` domain: Unix-domain sockets, named by a path, AF_UNIX.  The
--- same on every hosted system.
public af_unix: i32 = 1
--- `socket` domain: IPv4, AF_INET.  The same on every hosted system.
public af_inet: i32 = 2
--- `socket` type: a connected byte stream, TCP over IP.  The same on every
--- hosted system.
public sock_stream: i32 = 1
--- `socket` type: datagrams, UDP over IP.
public sock_dgram: i32 = 2
--- `setsockopt` level: TCP.  The same on every hosted system.
public ipproto_tcp: i32 = 6
--- `setsockopt` level: IPv6.
public ipproto_ipv6: i32 = 41
--- `ipproto_tcp` option, an `i32`: Nagle's algorithm off.  The same on
--- every hosted system.
public tcp_nodelay: i32 = 1
--- `shutdown` side: no more receives.  The same on every hosted system.
public shut_rd: i32 = 0
--- `shutdown` side: no more sends; the peer reads the end.
public shut_wr: i32 = 1
--- `shutdown` side: neither.
public shut_rdwr: i32 = 2
--- An address record's room on every hosted system, `sizeof (struct
--- sockaddr_storage)`.
public sockaddr_storage_size: u32 = 128
--- `sizeof (struct sockaddr_in)` on every hosted system.
public sockaddr_in_size: u32 = 16
--- `sizeof (struct sockaddr_in6)` on every hosted system.
public sockaddr_in6_size: u32 = 28

--- The signal a write to a pipe or a socket nobody reads raises, SIGPIPE.
--- The same on every hosted system.
public sigpipe: i32 = 13
--- A signal's disposition: the system's default, C's `SIG_DFL`.
public sig_dfl: u64 = 0
--- A signal's disposition: ignored, C's `SIG_IGN`.
public sig_ign: u64 = 1

fixed if compiler.os == linux then
    --- `socket` domain: IPv6, AF_INET6, which each system numbers its own
    --- way.
    public af_inet6: i32 = 10
    --- `setsockopt` level: the socket itself, SOL_SOCKET.
    public sol_socket: i32 = 1
    --- `sol_socket` option, an `i32`: a listener may bind an address that
    --- earlier connections still hold in TIME_WAIT.
    public so_reuseaddr: i32 = 2
    --- `sol_socket` option, read as an `i32`: the pending error, cleared as
    --- it is read.
    public so_error: i32 = 4
    --- `sol_socket` option, a `time_limit`: how long a receive waits.
    public so_rcvtimeo: i32 = 20
    --- `sol_socket` option, a `time_limit`: how long a send waits.
    public so_sndtimeo: i32 = 21
    --- `ipproto_ipv6` option, an `i32`: an IPv6 socket takes IPv6 alone.
    public ipv6_v6only: i32 = 26
    --- `socket`, `socketpair` and `accept4` flag: closed on exec, set with
    --- the descriptor.  Darwin has none.
    public sock_cloexec: i32 = 524288
    --- `send` flag: a send to a peer that has gone fails with EPIPE and
    --- raises no SIGPIPE.  Darwin has none.
    public msg_nosignal: i32 = 16384
    --- `sizeof (struct sockaddr_un)`'s path: the longest Unix-domain path
    --- with its NUL.
    public sockaddr_un_path: u32 = 108

    --- C's `struct timeval`, which a socket time limit is.
    public time_limit: type = struct
        seconds: i64
        microseconds: i64
    end time_limit

    --- glibc's `sigset_t`, 1024 bits.
    public signal_set: type = struct
        bits: [16]u64
    end signal_set

    --- C's `struct sigaction` as glibc declares it.
    public signal_action: type = struct
        handler: u64
        mask: signal_set
        flags: i32
        padding: i32
        restorer: u64
    end signal_action
elsif compiler.os == darwin then
    --- `socket` domain: IPv6, AF_INET6, which each system numbers its own
    --- way.
    public af_inet6: i32 = 30
    --- `setsockopt` level: the socket itself, SOL_SOCKET.
    public sol_socket: i32 = 65535
    --- `sol_socket` option, an `i32`: a listener may bind an address that
    --- earlier connections still hold in TIME_WAIT.
    public so_reuseaddr: i32 = 4
    --- `sol_socket` option, read as an `i32`: the pending error, cleared as
    --- it is read.
    public so_error: i32 = 4103
    --- `sol_socket` option, a `time_limit`: how long a receive waits.
    public so_rcvtimeo: i32 = 4102
    --- `sol_socket` option, a `time_limit`: how long a send waits.
    public so_sndtimeo: i32 = 4101
    --- `ipproto_ipv6` option, an `i32`: an IPv6 socket takes IPv6 alone.
    public ipv6_v6only: i32 = 27
    --- `sol_socket` option, an `i32`: a write or send to a peer that has
    --- gone fails with EPIPE and raises no SIGPIPE.  Linux has none.
    public so_nosigpipe: i32 = 4130
    --- `sizeof (struct sockaddr_un)`'s path: the longest Unix-domain path
    --- with its NUL.
    public sockaddr_un_path: u32 = 104

    --- C's `struct timeval`, which a socket time limit is: Darwin's
    --- microseconds are an `int`.
    public time_limit: type = struct
        seconds: i64
        microseconds: i32
        padding: i32
    end time_limit

    --- Darwin's `sigset_t`, 32 bits.
    public signal_set: type = struct
        bits: [1]u32
    end signal_set

    --- C's `struct sigaction` as Darwin declares it.
    public signal_action: type = struct
        handler: u64
        mask: signal_set
        flags: i32
    end signal_action

    --- `posix_spawnattr_setflags` flag: the child's signals named by
    --- `posix_spawnattr_setsigdefault` start at their default disposition.
    public posix_spawn_setsigdef: i16 = 4
else
    --- `socket` domain: IPv6, AF_INET6, which each system numbers its own
    --- way.
    public af_inet6: i32 = 28
    --- `setsockopt` level: the socket itself, SOL_SOCKET.
    public sol_socket: i32 = 65535
    --- `sol_socket` option, an `i32`: a listener may bind an address that
    --- earlier connections still hold in TIME_WAIT.
    public so_reuseaddr: i32 = 4
    --- `sol_socket` option, read as an `i32`: the pending error, cleared as
    --- it is read.
    public so_error: i32 = 4103
    --- `sol_socket` option, a `time_limit`: how long a receive waits.
    public so_rcvtimeo: i32 = 4102
    --- `sol_socket` option, a `time_limit`: how long a send waits.
    public so_sndtimeo: i32 = 4101
    --- `ipproto_ipv6` option, an `i32`: an IPv6 socket takes IPv6 alone.
    public ipv6_v6only: i32 = 27
    --- `sol_socket` option, an `i32`: a write or send to a peer that has
    --- gone fails with EPIPE and raises no SIGPIPE.  Linux has none.
    public so_nosigpipe: i32 = 2048
    --- `socket`, `socketpair` and `accept4` flag: closed on exec, set with
    --- the descriptor.  Darwin has none.
    public sock_cloexec: i32 = 268435456
    --- `send` flag: a send to a peer that has gone fails with EPIPE and
    --- raises no SIGPIPE.  Darwin has none.
    public msg_nosignal: i32 = 131072
    --- `sizeof (struct sockaddr_un)`'s path: the longest Unix-domain path
    --- with its NUL.
    public sockaddr_un_path: u32 = 104

    --- C's `struct timeval`, which a socket time limit is.
    public time_limit: type = struct
        seconds: i64
        microseconds: i64
    end time_limit

    --- FreeBSD's `sigset_t`, 128 bits.
    public signal_set: type = struct
        bits: [4]u32
    end signal_set

    --- C's `struct sigaction` as FreeBSD declares it.
    public signal_action: type = struct
        handler: u64
        flags: i32
        mask: signal_set
    end signal_action

    --- `posix_spawnattr_setflags` flag: the child's signals named by
    --- `posix_spawnattr_setsigdefault` start at their default disposition.
    public posix_spawn_setsigdef: i16 = 16
end if

--- What a socket call takes for an address it has none of, and
--- `sigaction` for an action it is not given: C's null pointer.
public no_address: atom
--- An address record a call fills, or `no_address`.
public address_filled: type = no_address | ptr mut u8
--- The cell a call reads a record's room from and writes its length into,
--- or `no_address`.
public address_length: type = no_address | ptr mut u32
--- An action `sigaction` sets, or `no_address`.
public action_given: type = no_address | ptr signal_action
--- Where `sigaction` puts the action it replaces, or `no_address`.
public action_kept: type = no_address | ptr mut signal_action

--- Make a socket of `domain` and `kind` for `protocol`, zero for the kind's
--- own: the new descriptor, or -1 with the reason in errno.
public extern(c) socket: (domain: i32, kind: i32, protocol: i32)
                         -> (descriptor: i32)

--- Make a pair of connected sockets and put them in `ends[0]` and
--- `ends[1]`: 0, or -1 with the reason in errno.
public extern(c) socketpair: (domain: i32, kind: i32, protocol: i32,
                              ends: ptr mut i32) -> (status: i32)

--- Give the socket `descriptor` the address in the `length` bytes at
--- `address`: 0, or -1 with the reason in errno.
public extern(c) bind: (descriptor: i32, address: ptr u8, length: u32)
                       -> (status: i32)

--- Make a bound stream socket accept connections, at most `backlog`
--- waiting: 0, or -1 with the reason in errno.
public extern(c) listen: (descriptor: i32, backlog: i32) -> (status: i32)

--- Take the next connection waiting on `descriptor` as a new socket, and
--- the peer's address in `address` when it is given: the new descriptor,
--- or -1 with the reason in errno.  It is inherited by a program this
--- process executes unless `fd_cloexec` is set on it.
public extern(c) accept: (descriptor: i32, address: address_filled,
                          length: address_length) -> (accepted: i32)

fixed if compiler.os == linux or compiler.os == freebsd then
    --- `accept` with `flags`, `sock_cloexec` among them, set as the socket
    --- is made: Linux's and FreeBSD's; Darwin has none.
    public extern(c) accept4: (descriptor: i32, address: address_filled,
                               length: address_length, flags: i32)
                              -> (accepted: i32)
end if

--- Connect the socket `descriptor` to the address in the `length` bytes at
--- `address`: 0, or -1 with the reason in errno.
public extern(c) connect: (descriptor: i32, address: ptr u8, length: u32)
                          -> (status: i32)

--- Send at most `length` bytes from `data` to the connected peer with
--- `flags`: the count sent, or -1 with the reason in errno.
public extern(c) send: (descriptor: i32, data: ptr u8, length: usize,
                        flags: i32) -> (count: isize)

--- Receive at most `length` bytes into `data` with `flags`: the count, zero
--- when a stream's peer has finished sending, or -1 with the reason in
--- errno.
public extern(c) recv: (descriptor: i32, data: ptr mut u8, length: usize,
                        flags: i32) -> (count: isize)

--- Send the `length` bytes from `data` to the address in the
--- `address_size` bytes at `address`: the count, or -1 with the reason in
--- errno.
public extern(c) sendto: (descriptor: i32, data: ptr u8, length: usize,
                          flags: i32, address: ptr u8, address_size: u32)
                         -> (count: isize)

--- Receive at most `length` bytes into `data`, and the sender's address in
--- `address` when it is given: the count, or -1 with the reason in errno.
public extern(c) recvfrom: (descriptor: i32, data: ptr mut u8, length: usize,
                            flags: i32, address: address_filled,
                            address_size: address_length) -> (count: isize)

--- Stop receiving, sending or both on a socket: 0, or -1 with the reason
--- in errno.
public extern(c) shutdown: (descriptor: i32, side: i32) -> (status: i32)

--- Set the option `name` at `level` to the `length` bytes at `value`: 0,
--- or -1 with the reason in errno.
public extern(c) setsockopt: (descriptor: i32, level: i32, name: i32,
                              value: ptr u8, length: u32) -> (status: i32)

--- Read the option `name` at `level` into `value`, whose room `length`
--- holds and which then holds its length: 0, or -1 with the reason in
--- errno.
public extern(c) getsockopt: (descriptor: i32, level: i32, name: i32,
                              value: ptr mut u8, length: ptr mut u32)
                             -> (status: i32)

--- Put the address the socket is bound to in `address`, as `accept` puts
--- a peer's: 0, or -1 with the reason in errno.
public extern(c) getsockname: (descriptor: i32, address: ptr mut u8,
                               length: ptr mut u32) -> (status: i32)

--- Put the address of the socket's connected peer in `address`: 0, or -1
--- with the reason in errno, ENOTCONN when there is none.
public extern(c) getpeername: (descriptor: i32, address: ptr mut u8,
                               length: ptr mut u32) -> (status: i32)

--- Set the action of `signal` to `action` when it is given, and put the one
--- it had in `previous` when that is given: 0, or -1 with the reason in
--- errno.
public extern(c) sigaction: (signal: i32, action: action_given,
                             previous: action_kept) -> (status: i32)

fixed if compiler.os == darwin or compiler.os == freebsd then
    --- Name the signals whose disposition a child `posix_spawn` starts with
    --- `posix_spawn_setsigdef` set is reset to the default: 0, or the
    --- errno.
    public extern(c) posix_spawnattr_setsigdefault:
        (attributes: ptr mut spawn_object, signals: ptr signal_set)
        -> (error: i32)
end if

--  The rest of the file system: positional reads and writes, sizes,
--  synchronizing, renaming, links, permission bits, owners, file times,
--  locks, the working directory, terminals, and the user and group
--  databases.  Every call is declared on the three systems where its C
--  signature agrees; a `mode_t` is 16 bits on Darwin and FreeBSD and 32 on
--  Linux, so the calls taking one are declared beside the system's.

--- Read at most `length` bytes from `descriptor` into `data`, starting
--- `offset` bytes into the file, without moving its position: the count,
--- zero at or past its end, or -1 with the reason in errno.
public extern(c) pread: (descriptor: i32, data: ptr mut u8, length: usize,
                         offset: i64) -> (count: isize)

--- Write at most `length` bytes from `data` to `descriptor`, starting
--- `offset` bytes into the file, without moving its position: the count,
--- or -1 with the reason in errno.
public extern(c) pwrite: (descriptor: i32, data: ptr u8, length: usize,
                          offset: i64) -> (count: isize)

--- Give the file open as `descriptor` the size `length`, cutting it or
--- extending it with zeros: 0, or -1 with the reason in errno.
public extern(c) ftruncate: (descriptor: i32, length: i64) -> (status: i32)

--- Hand the file's data and status to its device: 0, or -1 with the reason
--- in errno.  On Darwin the device may still hold them in its own cache;
--- `fcntl` with `f_fullfsync` asks it to write them.
public extern(c) fsync: (descriptor: i32) -> (status: i32)

--- Put the working directory's absolute path, with a NUL after it, in the
--- `length` bytes at `into`: `into`'s address, or zero with the reason in
--- errno, ERANGE when it does not fit.
public extern(c) getcwd: (into: ptr mut u8, length: usize) -> (result: usize)

--- Give the file `old`, relative to `old_directory`, the name `new`,
--- relative to `new_directory`, replacing a file already named `new` in
--- one step: 0, or -1 with the reason in errno.
public extern(c) renameat: (old_directory: i32, old: ptr u8,
                            new_directory: i32, new: ptr u8) -> (status: i32)

--- Give the file `old` a second name `new`, each relative to its
--- directory, not following a final symbolic link of `old` unless `flags`
--- holds `at_symlink_follow`: 0, or -1 with the reason in errno.
public extern(c) linkat: (old_directory: i32, old: ptr u8,
                          new_directory: i32, new: ptr u8, flags: i32)
                         -> (status: i32)

--- Make `path`, relative to `directory`, a symbolic link to `target`: 0,
--- or -1 with the reason in errno.
public extern(c) symlinkat: (target: ptr u8, directory: i32, path: ptr u8)
                            -> (status: i32)

--- Put the target of the symbolic link `path`, relative to `directory`, in
--- at most `length` bytes at `into`, with no NUL: the count, or -1 with the
--- reason in errno.
public extern(c) readlinkat: (directory: i32, path: ptr u8, into: ptr mut u8,
                              length: usize) -> (count: isize)

--- Set the owner and group of the file `path` names, relative to
--- `directory`, either kept when it is `0xFFFFFFFF`, not following a final
--- symbolic link with `at_symlink_nofollow`: 0, or -1 with the reason in
--- errno.
public extern(c) fchownat: (directory: i32, path: ptr u8, user: u32,
                            group: u32, flags: i32) -> (status: i32)

--- Set the owner and group of the file open as `descriptor`: 0, or -1 with
--- the reason in errno.
public extern(c) fchown: (descriptor: i32, user: u32, group: u32)
                         -> (status: i32)

--- Set the last access and modification times of the file `path` names,
--- relative to `directory`, to the two `timespec`s at `times`, access
--- first, a final symbolic link's own with `at_symlink_nofollow`: 0, or -1
--- with the reason in errno.
public extern(c) utimensat: (directory: i32, path: ptr u8, times: ptr timespec,
                             flags: i32) -> (status: i32)

--- Set the two times of the file open as `descriptor`, as `utimensat`
--- does: 0, or -1 with the reason in errno.
public extern(c) futimens: (descriptor: i32, times: ptr timespec)
                           -> (status: i32)

--- Take, change or give up the whole-file lock on the open file
--- `descriptor` belongs to: `lock_sh` or `lock_ex`, with `lock_nb` not to
--- wait, or `lock_un`.  0, or -1 with the reason in errno, EWOULDBLOCK when
--- another open file holds it and `lock_nb` was given.
public extern(c) flock: (descriptor: i32, operation: i32) -> (status: i32)

--- `flock` operation: a shared lock.  The same on every hosted system.
public lock_sh: i32 = 1
--- `flock` operation: an exclusive lock.
public lock_ex: i32 = 2
--- `flock` flag: fail at once rather than wait.
public lock_nb: i32 = 4
--- `flock` operation: give the lock up.
public lock_un: i32 = 8

--- `ioctl(descriptor, request, ...)`, declared variadic as C declares it,
--- its one variadic argument a pointer for the requests here: its result,
--- or -1 with the reason in errno.
public extern(c) ioctl: (descriptor: i32, request: u64, ...) -> (result: i32)

--- Whether `descriptor` is a terminal: 1, or 0 with the reason in errno,
--- ENOTTY for any other open file.
public extern(c) isatty: (descriptor: i32) -> (yes: i32)

--- The process's real user ID.  It cannot fail.
public extern(c) getuid: () -> (user: u32)
--- The process's effective user ID, which permission checks use.
public extern(c) geteuid: () -> (user: u32)
--- The process's real group ID.
public extern(c) getgid: () -> (group: u32)
--- The process's effective group ID.
public extern(c) getegid: () -> (group: u32)

--- Fill `result` with the status of the file open as `descriptor`: 0, or
--- -1 with the reason in errno.
public extern(c) fstat: (descriptor: i32, result: ptr mut file_status)
                        -> (status: i32)

--- `tcsetattr` timing: set the terminal's settings at once.  The same on
--- every hosted system.
public tcsanow: i32 = 0
--- `tcsetattr` timing: once all written output has been sent.
public tcsadrain: i32 = 1
--- `tcsetattr` timing: once output has been sent, discarding input not yet
--- read.
public tcsaflush: i32 = 2

--- A terminal's size, `struct winsize`: rows and columns, and pixels.  The
--- same on every hosted system.
public window_record: type = struct
    rows: u16
    columns: u16
    width: u16
    height: u16
end window_record

--- A record lock's start counts from the file's start, `SEEK_SET`.
public seek_set: i16 = 0

--- C's `struct group`, the same on every hosted system: the group's name,
--- password, ID and its members, a null-terminated table of names.
public group_record: type = struct
    name: usize
    password: usize
    group: u32
    padding: u32
    members: usize
end group_record

--- Find the account with user ID `user`, filling `into` with pointers into
--- the `length` bytes at `buffer` and putting `into`'s address in `found`,
--- or zero when there is none: 0, or the errno, ERANGE when the buffer is
--- too small.  The C library asks every database the system names, NSS
--- on Linux.
public extern(c) getpwuid_r: (user: u32, into: ptr mut account_record,
                              buffer: ptr mut u8, length: usize,
                              found: ptr mut usize) -> (error: i32)

--- Find the account named `name`, as `getpwuid_r` finds one by ID.
public extern(c) getpwnam_r: (name: ptr u8, into: ptr mut account_record,
                              buffer: ptr mut u8, length: usize,
                              found: ptr mut usize) -> (error: i32)

--- Find the group with group ID `group`, as `getpwuid_r` finds an account.
public extern(c) getgrgid_r: (group: u32, into: ptr mut group_record,
                              buffer: ptr mut u8, length: usize,
                              found: ptr mut usize) -> (error: i32)

--- Find the group named `name`, as `getgrgid_r` finds one by ID.
public extern(c) getgrnam_r: (name: ptr u8, into: ptr mut group_record,
                              buffer: ptr mut u8, length: usize,
                              found: ptr mut usize) -> (error: i32)

fixed if compiler.os == linux then
    --- Set the permission bits of the file `path` names, relative to
    --- `directory`, to `mode`, following a final symbolic link with
    --- `flags` zero: 0, or -1 with the reason in errno.
    public extern(c) fchmodat: (directory: i32, path: ptr u8, mode: u32,
                                flags: i32) -> (status: i32)
    --- Set the permission bits of the file open as `descriptor`: 0, or -1
    --- with the reason in errno.
    public extern(c) fchmod: (descriptor: i32, mode: u32) -> (status: i32)
    --- Hand the file's data to its device, and its status only where
    --- reading the data back needs it: 0, or -1 with the reason in errno.
    --- Darwin declares none.
    public extern(c) fdatasync: (descriptor: i32) -> (status: i32)

    --- `linkat` flag: follow a final symbolic link of the old path.
    public at_symlink_follow: i32 = 1024
    --- `open` flag: a terminal opened does not become the controlling one.
    public o_noctty: i32 = 256
    --- `fcntl` command: describe a record lock in the way, `F_GETLK`.
    public f_getlk: i32 = 5
    --- `fcntl` command: take or give up a record lock at once, `F_SETLK`.
    public f_setlk: i32 = 6
    --- `fcntl` command: take a record lock, waiting for it, `F_SETLKW`.
    public f_setlkw: i32 = 7
    --- A record lock's type: shared.
    public f_rdlck: i16 = 0
    --- A record lock's type: exclusive.
    public f_wrlck: i16 = 1
    --- A record lock's type: none.
    public f_unlck: i16 = 2

    --- C's `struct flock`, a record lock: its type, where its start counts
    --- from, its start and length, zero to the end of the file however far
    --- it reaches, and the process holding it, which `f_getlk` fills.
    public lock_record: type = struct
        kind: i16
        whence: i16
        padding: i32
        start: i64
        length: i64
        process: i32
        spare: i32
    end lock_record

    --- glibc's `struct passwd`: the account's name, password, user and
    --- group IDs, comment, home directory and shell, the strings pointers
    --- into the buffer the call was given.
    public account_record: type = struct
        name: usize
        password: usize
        user: u32
        group: u32
        comment: usize
        home: usize
        shell: usize
    end account_record
elsif compiler.os == darwin then
    --- Set the permission bits of the file `path` names, relative to
    --- `directory`, to `mode`, following a final symbolic link with
    --- `flags` zero: 0, or -1 with the reason in errno.
    public extern(c) fchmodat: (directory: i32, path: ptr u8, mode: u16,
                                flags: i32) -> (status: i32)
    --- Set the permission bits of the file open as `descriptor`: 0, or -1
    --- with the reason in errno.
    public extern(c) fchmod: (descriptor: i32, mode: u16) -> (status: i32)

    --- `fcntl` command, Darwin's own: hand the file to its device and have
    --- the device write what it holds in its own cache, which `fsync`
    --- leaves there.  A file system that cannot fails with ENOTSUP.
    public f_fullfsync: i32 = 51

    --- `linkat` flag: follow a final symbolic link of the old path.
    public at_symlink_follow: i32 = 64
    --- `open` flag: a terminal opened does not become the controlling one.
    public o_noctty: i32 = 131072
    --- `fcntl` command: describe a record lock in the way, `F_GETLK`.
    public f_getlk: i32 = 7
    --- `fcntl` command: take or give up a record lock at once, `F_SETLK`.
    public f_setlk: i32 = 8
    --- `fcntl` command: take a record lock, waiting for it, `F_SETLKW`.
    public f_setlkw: i32 = 9
    --- A record lock's type: shared.
    public f_rdlck: i16 = 1
    --- A record lock's type: exclusive.
    public f_wrlck: i16 = 3
    --- A record lock's type: none.
    public f_unlck: i16 = 2

    --- C's `struct flock`, a record lock: its start and length, zero to the
    --- end of the file however far it reaches, the process holding it,
    --- which `f_getlk` fills, its type and where its start counts from.
    public lock_record: type = struct
        start: i64
        length: i64
        process: i32
        kind: i16
        whence: i16
    end lock_record

    --- Darwin's `struct passwd`: the account's name, password, user and
    --- group IDs, password change time, class, comment, home directory,
    --- shell and expiry, the strings pointers into the call's buffer.
    public account_record: type = struct
        name: usize
        password: usize
        user: u32
        group: u32
        changed: i64
        class: usize
        comment: usize
        home: usize
        shell: usize
        expires: i64
    end account_record

    --- A terminal's settings, Darwin's `struct termios`, whose flags and
    --- speeds are C `long`s: the input, output, control and local modes,
    --- the control characters, `vmin` and `vtime` among them, and the
    --- speeds.
    public terminal_record: type = struct
        input_modes: u64
        output_modes: u64
        control_modes: u64
        local_modes: u64
        characters: [20]u8
        padding: u32
        input_speed: u64
        output_speed: u64
    end terminal_record
else
    --- Set the permission bits of the file `path` names, relative to
    --- `directory`, to `mode`, following a final symbolic link with
    --- `flags` zero: 0, or -1 with the reason in errno.
    public extern(c) fchmodat: (directory: i32, path: ptr u8, mode: u16,
                                flags: i32) -> (status: i32)
    --- Set the permission bits of the file open as `descriptor`: 0, or -1
    --- with the reason in errno.
    public extern(c) fchmod: (descriptor: i32, mode: u16) -> (status: i32)
    --- Hand the file's data to its device, and its status only where
    --- reading the data back needs it: 0, or -1 with the reason in errno.
    --- Darwin declares none.
    public extern(c) fdatasync: (descriptor: i32) -> (status: i32)

    --- `linkat` flag: follow a final symbolic link of the old path.
    public at_symlink_follow: i32 = 1024
    --- `open` flag: a terminal opened does not become the controlling one.
    public o_noctty: i32 = 32768
    --- `fcntl` command: describe a record lock in the way, `F_GETLK`.
    public f_getlk: i32 = 11
    --- `fcntl` command: take or give up a record lock at once, `F_SETLK`.
    public f_setlk: i32 = 12
    --- `fcntl` command: take a record lock, waiting for it, `F_SETLKW`.
    public f_setlkw: i32 = 13
    --- A record lock's type: shared.
    public f_rdlck: i16 = 1
    --- A record lock's type: exclusive.
    public f_wrlck: i16 = 3
    --- A record lock's type: none.
    public f_unlck: i16 = 2

    --- C's `struct flock`, a record lock: its start and length, zero to the
    --- end of the file however far it reaches, the process holding it,
    --- which `f_getlk` fills, its type, where its start counts from and the
    --- system holding it, zero for this one.
    public lock_record: type = struct
        start: i64
        length: i64
        process: i32
        kind: i16
        whence: i16
        system: i32
        padding: i32
    end lock_record

    --- FreeBSD's `struct passwd`: Darwin's, and which fields are filled.
    public account_record: type = struct
        name: usize
        password: usize
        user: u32
        group: u32
        changed: i64
        class: usize
        comment: usize
        home: usize
        shell: usize
        expires: i64
        fields: i32
        padding: i32
    end account_record

    --- A terminal's settings, FreeBSD's `struct termios`: the input,
    --- output, control and local modes, the control characters, `vmin`
    --- and `vtime` among them, and the speeds.
    public terminal_record: type = struct
        input_modes: u32
        output_modes: u32
        control_modes: u32
        local_modes: u32
        characters: [20]u8
        input_speed: u32
        output_speed: u32
    end terminal_record
end if

fixed if compiler.os == darwin or compiler.os == freebsd then
    --- Read the terminal `descriptor`'s settings into `into`: 0, or -1 with
    --- the reason in errno, ENOTTY for any other file.
    public extern(c) tcgetattr: (descriptor: i32, into: ptr mut terminal_record)
                                -> (status: i32)
    --- Set the terminal `descriptor`'s settings to `settings`, when `timing`
    --- says: 0, or -1 with the reason in errno.
    public extern(c) tcsetattr: (descriptor: i32, timing: i32,
                                 settings: ptr terminal_record) -> (status: i32)

    --- `terminal_record` input mode: ignore a break.  Darwin and FreeBSD
    --- share 4.4BSD's numbers.
    public ignbrk: u32 = 1
    --- Input mode: a break interrupts.
    public brkint: u32 = 2
    --- Input mode: mark a parity error.
    public parmrk: u32 = 8
    --- Input mode: strip the eighth bit.
    public istrip: u32 = 32
    --- Input mode: read a newline as a carriage return.
    public inlcr: u32 = 64
    --- Input mode: ignore a carriage return.
    public igncr: u32 = 128
    --- Input mode: read a carriage return as a newline.
    public icrnl: u32 = 256
    --- Input mode: XON and XOFF control output.
    public ixon: u32 = 512
    --- Output mode: process output.
    public opost: u32 = 1
    --- Control mode: the character size's bits.
    public csize: u32 = 768
    --- Control mode: eight-bit characters.
    public cs8: u32 = 768
    --- Control mode: parity.
    public parenb: u32 = 4096
    --- Local mode: input is echoed.
    public echo: u32 = 8
    --- Local mode: a newline is echoed even without `echo`.
    public echonl: u32 = 16
    --- Local mode: the interrupt, quit and suspend characters raise their
    --- signals.
    public isig: u32 = 128
    --- Local mode: input is read a line at a time and may be edited.
    public icanon: u32 = 256
    --- Local mode: the implementation's own input processing.
    public iexten: u32 = 1024
    --- `terminal_record` character index: how few bytes a read returns,
    --- outside line mode.
    public vmin: usize = 16
    --- `terminal_record` character index: how long a read waits, in tenths
    --- of a second, outside line mode.
    public vtime: usize = 17

    --- `ioctl` request: read a terminal's `window_record`.
    public tiocgwinsz: u64 = 0x40087468
    --- `ioctl` request: set a terminal's `window_record`.
    public tiocswinsz: u64 = 0x80087467

    --- Open a new pseudo-terminal's controller with the `open` flags given:
    --- its descriptor, or -1 with the reason in errno.
    public extern(c) posix_openpt: (flags: i32) -> (descriptor: i32)
    --- Give the caller the pseudo-terminal of the controller `descriptor`:
    --- 0, or -1 with the reason in errno.
    public extern(c) grantpt: (descriptor: i32) -> (status: i32)
    --- Let the pseudo-terminal of the controller `descriptor` be opened: 0,
    --- or -1 with the reason in errno.
    public extern(c) unlockpt: (descriptor: i32) -> (status: i32)
    --- Put the path of the controller `descriptor`'s terminal, with a NUL,
    --- in the `length` bytes at `into`: 0, or nonzero, the errno itself
    --- or -1 with it in errno, ERANGE when it does not fit.
    public extern(c) ptsname_r: (descriptor: i32, into: ptr mut u8,
                                 length: usize) -> (status: i32)
end if

--- What `dlopen` returns when it loads nothing: C's null pointer, with the
--- reason in `dlerror`'s text.
public not_loaded: atom

--- A `dlopen` result: the loaded object's handle, or `not_loaded`.
public loaded_object: type = not_loaded | ptr mut u8

--- A `dlsym` or `dlerror` result: an address, or `no_address` for C's
--- null pointer when they have nothing.
public found_address: type = no_address | ptr u8

--- Load the shared object at the NUL-terminated `path`, or find it by the
--- system's search when `path` holds no slash, as `mode` says: its handle,
--- or `not_loaded` with the reason in `dlerror`.  Loading an object
--- already loaded counts another use of it and returns the same handle.
--- In glibc's libc since 2.34, and in libdl before it; in Darwin's and
--- FreeBSD's libc.
public extern(c) dlopen: (path: ptr u8, mode: i32) -> (handle: loaded_object)

--- The address of the NUL-terminated symbol `name` in the object `handle`
--- names or in what it loaded with it, or `no_address` with the reason in
--- `dlerror`.  The address has no type: what is there is the caller's to
--- know.
public extern(c) dlsym: (handle: ptr mut u8, name: ptr u8)
                        -> (address: found_address)

--- Count one use of `handle` as over: 0, or nonzero with the reason in
--- `dlerror`.  The object may be unloaded once no use is left, and every
--- address found in it is then no longer the program's to use.
public extern(c) dlclose: (handle: ptr mut u8) -> (status: i32)

--- The text of the last failure of `dlopen`, `dlsym` or `dlclose` on this
--- thread, NUL-terminated, or `no_address` when there was none since it was
--- last asked.  Asking clears it, and the next of those calls may overwrite
--- it, so it is read at once.
public extern(c) dlerror: () -> (text: found_address)

--- `dlopen` mode: bind every symbol the object needs as it is loaded.  The
--- same on every hosted system.
public rtld_now: i32 = 2

fixed if compiler.os == darwin then
    --- `dlopen` mode: the object's symbols resolve no other object's
    --- references.  Darwin's default is `rtld_global`, so it is always
    --- given.
    public rtld_local: i32 = 4
    --- `dlopen` mode: the object's symbols resolve the references of an
    --- object loaded after it.
    public rtld_global: i32 = 8
else
    --- `dlopen` mode: the object's symbols resolve no other object's
    --- references.  Darwin's default is `rtld_global`, so it is always
    --- given.
    public rtld_local: i32 = 0
    --- `dlopen` mode: the object's symbols resolve the references of an
    --- object loaded after it.
    public rtld_global: i32 = 256
end if
