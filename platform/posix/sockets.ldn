--  POSIX's sockets in Landin types: TCP and UDP over IPv4 and IPv6, and
--  Unix-domain sockets, which name a path and are this module's alone.  An
--  address is the system's own record, laid out here once for each
--  system: Linux's begins with a 16-bit family, Darwin's and FreeBSD's
--  with a length byte and a family byte, and each system numbers IPv6's
--  family its own way.  Every socket is closed on exec, as every
--  descriptor this module makes is, and a send to a peer that has gone
--  fails with `epipe` without raising SIGPIPE: Linux sends with
--  MSG_NOSIGNAL, and Darwin and FreeBSD set SO_NOSIGPIPE on each socket.

import core/io
import core/text

--- An IPv4 socket, AF_INET.
public internet: atom
--- An IPv6 socket, AF_INET6.
public internet6: atom
--- A Unix-domain socket, AF_UNIX, named by a path on this system.
public local: atom
--- A socket's family: `internet`, `internet6` or `local`.
public socket_family: type = internet | internet6 | local

--- A connected byte stream, SOCK_STREAM: TCP over IP.
public stream: atom
--- Datagrams, SOCK_DGRAM: UDP over IP.
public datagram: atom
--- A socket's kind: `stream` or `datagram`.
public socket_kind: type = stream | datagram

--- Stop receiving, SHUT_RD.
public shut_reading: atom
--- Stop sending, SHUT_WR: the peer reads the end of the stream.
public shut_writing: atom
--- Stop both, SHUT_RDWR.
public shut_both: atom
--- Which side `shutdown` stops.
public shutdown_side: type = shut_reading | shut_writing | shut_both

--- A socket address as the system lays it out, C's `struct
--- sockaddr_storage` and the length of the part in use.  Its fields belong
--- to this module: make one with `internet_address` or `unix_address`, and
--- read one with `family_of`, `address_of` and `unix_path`.
public socket_address: type = struct
    bytes: [128]u8
    length: u32
end socket_address

--- Two descriptors of one connection, `socket_pair`'s: what is sent on
--- either is received on the other.
public connected_pair: type = struct
    first: descriptor
    second: descriptor
end connected_pair

fixed if compiler.os == linux then
    --  The longest Unix-domain path, its NUL included: `sun_path`'s room.
    unix_path_room: usize = 108

    --  Linux's records begin with the family, a 16-bit number in the
    --  host's order, which is little-endian everywhere Landin runs Linux.
    put_family: (inout record: socket_address, family: socket_family)
                -> none =
        number: i32 = system_family_number(family)
        record.bytes[0] = u8(number & 255)
        record.bytes[1] = u8((number >> 8) & 255)
    end put_family

    family_number: (record: socket_address) -> (number: i32) =
        number = i32(record.bytes[0]) | (i32(record.bytes[1]) << 8)
    end family_number
else
    --  The longest Unix-domain path, its NUL included: `sun_path`'s room.
    unix_path_room: usize = 104

    --  Darwin's and FreeBSD's records begin with their own length, `sa_len`,
    --  and then the family, a byte each.
    put_family: (inout record: socket_address, family: socket_family)
                -> none =
        record.bytes[0] = u8(record.length)
        record.bytes[1] = u8(system_family_number(family))
    end put_family

    family_number: (record: socket_address) -> (number: i32) =
        number = i32(record.bytes[1])
    end family_number
end if

--  Where a Unix-domain record's path begins on every system.
unix_path_offset: usize = 2

--- The system's record of the internet address `at`: C's `struct
--- sockaddr_in`, 16 bytes, for an IPv4 address and `struct sockaddr_in6`,
--- 28 bytes, for an IPv6 one, the port in network order and the IPv6 flow
--- label and scope zero.
public link(symbol: "_landin_posix_internet_address") internet_address:
    (at: io.address) -> (made: socket_address) =
    made = (bytes: zeroed, length: 16)
    made.bytes[2] = u8(at.port >> 8)
    made.bytes[3] = u8(at.port & 255)
    if at.family == io.ipv4 then
        put_family(made, internet)
        for index in usize(0)..<4 do
            made.bytes[4 + index] = at.octets[index]
        end for
    else
        made.length = 28
        put_family(made, internet6)
        for index in usize(0)..<16 do
            made.bytes[8 + index] = at.octets[index]
        end for
    end if
end internet_address

--- The system's record of the Unix-domain socket at `path`, C's `struct
--- sockaddr_un`: `enametoolong` when the path and its NUL do not fit its
--- 108 bytes on Linux or 104 on Darwin and FreeBSD, and `einval` for an
--- empty path or one holding a NUL, which Linux would read as an abstract
--- name.
public link(symbol: "_landin_posix_unix_address") unix_address:
    (path: text.host_string) -> (made: socket_address) ! errno =
    bytes: []u8 = text.host_bytes(path)
    fail einval when lenof bytes == 0
    fail enametoolong when lenof bytes >= unix_path_room
    made = (bytes: zeroed,
            length: u32(unix_path_offset + lenof bytes + 1))
    for index in usize(0)..<lenof bytes do
        fail einval when bytes[index] == 0
        made.bytes[unix_path_offset + index] = bytes[index]
    end for
    put_family(made, local)
end unix_address

--- The family of the socket address `at`: `eafnosupport` for one this
--- module does not name.
public link(symbol: "_landin_posix_family_of") family_of:
    (at: socket_address) -> (family: socket_family) ! errno =
    number: i32 = family_number(at)
    family = if number == system_family_number(internet) then internet
             elsif number == system_family_number(internet6) then internet6
             elsif number == system_family_number(local) then local
             else internet end if
    fail eafnosupport when number <> system_family_number(family)
end family_of

--- The internet address and port the socket address `at` holds, its IPv6
--- scope dropped: `eafnosupport` for a Unix-domain one, or a record too
--- short for its family.
public link(symbol: "_landin_posix_address_of") address_of:
    (at: socket_address) -> (result: io.address) ! errno =
    family: socket_family = try family_of(at)
    port: u16 = (u16(at.bytes[2]) << 8) | u16(at.bytes[3])
    result = io.unspecified(io.ipv4, port)
    if family == internet then
        fail eafnosupport when at.length < 8
        result = io.ipv4_address(at.bytes[4], at.bytes[5], at.bytes[6],
                                 at.bytes[7], port)
    elsif family == internet6 then
        fail eafnosupport when at.length < 24
        result = io.unspecified(io.ipv6, port)
        for index in usize(0)..<16 do
            result.octets[index] = at.bytes[8 + index]
        end for
    else
        fail eafnosupport
    end if
end address_of

--- The path a Unix-domain socket address names, copied into `room` and
--- lent from it: `eafnosupport` for an internet address, and `erange` when
--- the path does not fit `room`.  A socket bound to no path has an empty
--- one.
public link(symbol: "_landin_posix_unix_path") unix_path:
    (at: socket_address, room: []mut u8)
    -> (path: text.host_string from room) ! errno =
    family: socket_family = try family_of(at)
    fail eafnosupport when family <> local
    mut length: usize = 0
    mut limit: usize = usize(at.length)
    if limit > 128 then limit = 128 end if
    while unix_path_offset + length < limit
      and at.bytes[unix_path_offset + length] <> 0 do
        inc length
    end while
    fail erange when length > lenof room
    for index in usize(0)..<length do
        room[index] = at.bytes[unix_path_offset + index]
    end for
    path = text.host_over(room[0..<length])
end unix_path

--- Make a socket of `family` and `kind`, closed on exec and raising no
--- SIGPIPE: `eafnosupport` when the system does not have the family, as
--- one without IPv6 does not.  On Darwin, which has no SOCK_CLOEXEC, the
--- flag is set just after the socket is made, as `pipe`'s is.
public link(symbol: "_landin_posix_socket") socket:
    (family: socket_family, kind: socket_kind) -> (made: descriptor)
    ! errno =
    made = try system_socket(family, kind)
end socket

--- Make a pair of connected Unix-domain sockets of `kind`, each closed on
--- exec and raising no SIGPIPE.
public link(symbol: "_landin_posix_socket_pair") socket_pair:
    (kind: socket_kind) -> (ends: connected_pair) ! errno =
    ends = try system_socket_pair(kind)
end socket_pair

--- Bind `socket` to the address `at`: `eaddrinuse` when another socket
--- holds it, `eaddrnotavail` when no interface here has it, `eacces` for a
--- port the process may not take.
public link(symbol: "_landin_posix_bind") bind:
    (socket: descriptor, at: socket_address) -> none ! errno =
    try system_bind(socket, addr at.bytes[0], at.length)
end bind

--- Make the bound stream socket `socket` a listener, with at most `backlog`
--- connections waiting to be accepted, which each system caps at its own
--- limit.
public link(symbol: "_landin_posix_listen") listen:
    (socket: descriptor, backlog: i32) -> none ! errno =
    try system_listen(socket, backlog)
end listen

--- Take the next connection waiting on `listener` as a new socket, closed
--- on exec and raising no SIGPIPE, waiting for one, or the errno: `eagain`
--- when the listener's receive time limit passed first, `econnaborted` for
--- a connection reset before it was taken.  Linux limits the wait itself;
--- Darwin and FreeBSD do not, so it is waited out here with `poll` for
--- the limit `receive_timeout` reads.  On Darwin the new socket is marked
--- closed on exec just after it is made.
public link(symbol: "_landin_posix_accept") accept:
    (listener: descriptor) -> (accepted: descriptor) ! errno =
    accepted = try system_accept(listener)
end accept

--- Connect `socket` to `to`: `econnrefused` when nothing listens there,
--- `eintr` when a signal came first, after which the connection goes on and
--- its outcome is what `poll` for `poll_output` and then `pending_error`
--- say.
public link(symbol: "_landin_posix_connect") connect:
    (socket: descriptor, to: socket_address) -> none ! errno =
    try system_connect(socket, addr to.bytes[0], to.length)
end connect

--- Send at most `lenof bytes` bytes on the connected `socket`: the count
--- accepted, which a stream may find short, or the errno, `epipe` once
--- the peer has gone, without SIGPIPE, and `eagain` when the send time
--- limit passed.
public link(symbol: "_landin_posix_send") send:
    (socket: descriptor, bytes: []u8) -> (count: usize) ! errno =
    count = try system_send(socket, bytes)
end send

--- Receive at most `lenof into` bytes from the connected `socket`: the
--- count, zero once a stream's peer has finished sending, or the errno,
--- `eagain` when the receive time limit passed and `econnreset` when the
--- peer reset the connection.
public link(symbol: "_landin_posix_receive") receive:
    (socket: descriptor, into: []mut u8) -> (count: usize) ! errno =
    count = try system_receive(socket, into)
end receive

--- Send `bytes` as one datagram to `to`: the count, which is all of them,
--- or the errno, `emsgsize` for a datagram larger than the system sends.
public link(symbol: "_landin_posix_send_to") send_to:
    (socket: descriptor, bytes: []u8, to: socket_address)
    -> (count: usize) ! errno =
    count = try system_send_to(socket, bytes, addr to.bytes[0], to.length)
end send_to

--- What one `receive_from` took: the count, and the sender's address.
public received: type = struct
    count: usize
    sender: socket_address
end received

--- Receive the next datagram into `into` and the address of its sender: a
--- datagram longer than `into` is cut to it.
public link(symbol: "_landin_posix_receive_from") receive_from:
    (socket: descriptor, into: []mut u8) -> (result: received) ! errno =
    result = (count: 0, sender: (bytes: zeroed, length: 128))
    result.count = try system_receive_from(socket, into,
                                           addr result.sender.bytes[0],
                                           addr result.sender.length)
end receive_from

--- Stop receiving, sending or both on `socket`: `enotconn` when it is not
--- connected.
public link(symbol: "_landin_posix_shutdown") shutdown:
    (socket: descriptor, side: shutdown_side) -> none ! errno =
    how: i32 = match side
        shut_reading: 0
        shut_writing: 1
        shut_both: 2
    end match
    try system_shutdown(socket, how)
end shutdown

--- The address `socket` is bound to, POSIX's `getsockname`.
public link(symbol: "_landin_posix_socket_name") socket_name:
    (socket: descriptor) -> (at: socket_address) ! errno =
    at = (bytes: zeroed, length: 128)
    try system_socket_name(socket, addr at.bytes[0], addr at.length)
end socket_name

--- The address of the peer `socket` is connected to, POSIX's
--- `getpeername`: `enotconn` when there is none.
public link(symbol: "_landin_posix_peer_name") peer_name:
    (socket: descriptor) -> (at: socket_address) ! errno =
    at = (bytes: zeroed, length: 128)
    try system_peer_name(socket, addr at.bytes[0], addr at.length)
end peer_name

--  The socket options this module sets, each system numbering them its
--  own way.
reuse_address: atom
no_delay: atom
ipv6_only: atom
receive_limit: atom
send_limit: atom
pending: atom
socket_option: type = reuse_address | no_delay | ipv6_only | receive_limit
    | send_limit | pending

--  Set a flag option.
flag_set: (socket: descriptor, option: socket_option, on: bool)
          -> none ! errno =
    value: i32 = if on then 1 else 0 end if
    try system_set_number(socket, option, value)
end flag_set

--- Let the listener `socket` bind an address that earlier connections
--- still hold in TIME_WAIT, `SO_REUSEADDR`, never one another listener
--- holds.  Set it before `bind`.
public link(symbol: "_landin_posix_set_reuse_address") set_reuse_address:
    (socket: descriptor, on: bool) -> none ! errno =
    try flag_set(socket, reuse_address, on)
end set_reuse_address

--- Send a stream's small writes at once, `TCP_NODELAY`.
public link(symbol: "_landin_posix_set_no_delay") set_no_delay:
    (socket: descriptor, on: bool) -> none ! errno =
    try flag_set(socket, no_delay, on)
end set_no_delay

--- Make an IPv6 socket take IPv6 alone, never IPv4 through mapped
--- addresses, `IPV6_V6ONLY`, which Darwin and FreeBSD do from the start
--- and Linux does not.  Set it before `bind`.
public link(symbol: "_landin_posix_set_ipv6_only") set_ipv6_only:
    (socket: descriptor, on: bool) -> none ! errno =
    try flag_set(socket, ipv6_only, on)
end set_ipv6_only

--- Limit how long a receive or an `accept` on `socket` waits,
--- `SO_RCVTIMEO`, after which it fails `eagain`; a span of zero waits as
--- long as it takes.  The system keeps microseconds, so a part of one
--- counts as a whole one, and Linux keeps its own ticks.
public link(symbol: "_landin_posix_set_receive_timeout") set_receive_timeout:
    (socket: descriptor, span: time_value) -> none ! errno =
    fail einval when span.seconds < 0 or span.nanoseconds >= 1000000000
    try system_set_time(socket, receive_limit, span)
end set_receive_timeout

--- Limit how long a send on `socket` waits, `SO_SNDTIMEO`, as
--- `set_receive_timeout` limits a receive.
public link(symbol: "_landin_posix_set_send_timeout") set_send_timeout:
    (socket: descriptor, span: time_value) -> none ! errno =
    fail einval when span.seconds < 0 or span.nanoseconds >= 1000000000
    try system_set_time(socket, send_limit, span)
end set_send_timeout

--- How long a receive on `socket` waits, as `set_receive_timeout` set it,
--- zero for no limit, to the microsecond: `unlisted` when the system gives
--- back a record of another size, as QEMU's user emulation does.
public link(symbol: "_landin_posix_receive_timeout") receive_timeout:
    (socket: descriptor) -> (span: time_value) ! errno =
    span = try system_get_time(socket, receive_limit)
end receive_timeout

--- Fail with the error pending on `socket`, `SO_ERROR`, clearing it, or
--- return when there is none: how a connection `connect` began and a
--- signal interrupted ended.
public link(symbol: "_landin_posix_pending_error") pending_error:
    (socket: descriptor) -> none ! errno =
    number: i32 = try system_get_number(socket, pending)
    fail errno_of(number) when number <> 0
end pending_error

--  A time value as microseconds, a part of one rounded up.
microseconds_of: (span: time_value) -> (seconds: i64, microseconds: i64) =
    seconds = span.seconds
    microseconds = i64((span.nanoseconds + 999) / 1000)
    if microseconds == 1000000 then
        inc seconds
        microseconds = 0
    end if
end microseconds_of
