--  The process and the programs it runs: its arguments and environment,
--  as the entry found them, SIGPIPE's disposition, pipes, spawning a
--  program and waiting for it, and ending at once.

import core/atomic
import core/io
import core/mem
import core/text
import platform/libc
import platform/linux

--- End the process with `status` at once, POSIX's `_exit`: nothing more
--- of the program runs, and no C stream is flushed.
public exit:
    (status: i32) -> noreturn =
    system_exit(status)
end exit

--  What the argument root holds before it is established, and what C's
--  null pointer is in an argv entry: no table, no string.
no_table: atom

no_string: atom

root_table: type = no_table | ptr ptr u8

argument_string: type = no_string | ptr u8

--  The argument root: C's argv and argc as the process's entry gave them,
--  retained without copying.  The table is the pointer the entry gave,
--  kept in module storage, so what is lent from it outlives every call.
--  Beside it the environment the entry gave, `no_table` for C's null.
mut root_values: root_table = no_table

mut root_count: i32

mut root_environment: root_table = no_table

word: usize = sizeof usize

--- Establish the process's argument root from C's `main` carriers.  The
--- hosted entry calls this with its own `argc`, `argv` and `envp` before
--- its body runs; a C `main` that drives Landin exports calls it itself,
--- with its own or with C's `environ`, before it reads an argument or a
--- variable and before starting a thread that may.
---
--- The first call also ignores SIGPIPE when its disposition is the
--- default, so that a write to a pipe or a socket nobody reads fails with
--- `epipe` rather than ending the process; a handler a C `main` installed
--- first is kept.  `spawn` gives every child the default back.
---
--- The first call needs a nonnegative count and a non-null table, and
--- keeps that exact triple without copying: the caller keeps both tables
--- and their strings readable while any argument or variable lent from
--- them is in use.  A null environment is an empty one.  Repeating the
--- identical triple changes nothing; a negative count, a null argument
--- table or a different triple traps.  The published arguments omit
--- `argv[0]`, so their count is `max(argc - 1, 0)`.
public extern(c) _landin_host_initialize_arguments:
    (count: i32, escaping values: ptr ptr u8,
     escaping environment: ptr ptr u8) -> none =
    --  Every misuse of the root stops at compiler.unreachable(), which a
    --  selected panic handler sees as `unreachable` at that site [1560].
    --  C may pass a null table, which no Landin pointer is, so its address
    --  is what is checked.
    given: usize = usize(values)
    variables: usize = usize(environment)
    held: usize = match root_values
        no_table: usize(0)
        ptr (table): usize(table)
    end match
    if held <> 0 then
        --  An identical repeat changes nothing; another triple would
        --  replace a root that lent arguments may still use.
        kept: usize = match root_environment
            no_table: usize(0)
            ptr (table): usize(table)
        end match
        if count <> root_count or given <> held or variables <> kept then
            compiler.unreachable()
        end if
        return
    end if
    if count < 0 or given == 0 then
        compiler.unreachable()
    end if
    root_count = count
    root_values = values
    --  A write to a pipe or a socket nobody reads is EPIPE, an error the
    --  program answers, rather than SIGPIPE ending the process.
    system_ignore_broken_pipe()
    if variables <> 0 then
        root_environment = environment
        --  On Linux, the auxiliary vector after the initial stack's envp,
        --  when that is where C's runtime found these tables.
        system_adopt_start(count, values, environment)
    end if
end _landin_host_initialize_arguments

--- Whether SIGPIPE is ignored in this process, as
--- `_landin_host_initialize_arguments` makes it when it was the default:
--- a write to a pipe or a socket nobody reads then fails with `epipe`.
public broken_pipe_ignored:
    () -> (ignored: bool) =
    ignored = system_broken_pipe_ignored()
end broken_pipe_ignored

--- The process's arguments as its entry gave them: argv after `argv[0]`
--- and their count.  `arguments` gives the table, which lends what it
--- points to from storage the process keeps, and `argument` reads it.
public argument_table: type = struct
    values: ptr ptr u8
    count: usize
end argument_table

--- The process's arguments, `argv[0]` not among them.  It traps when no
--- argument root has been established: the hosted entry establishes one
--- before `main` runs, and a C `main` calls
--- `_landin_host_initialize_arguments` itself.
public arguments:
    () -> (table: argument_table) =
    held: ptr ptr u8 = match root_values
        no_table: compiler.unreachable()
        ptr (found): found
    end match
    first: ptr ptr u8 = ptr(usize(held) + word)
    table = (values: first,
             count: if root_count > 0 then usize(root_count - 1)
                    else usize(0) end if)
end arguments

--- The argument `index`, from zero, as a host string lending the
--- process's own storage, which nothing copies.  An index at or past the
--- table's `count` traps, as does a null entry, which C promises none
--- below argc is.
public argument:
    (table: argument_table, index: usize)
    -> (value: text.host_string from table) =
    if index >= table.count then
        compiler.unreachable()
    end if
    entry: ptr argument_string = ptr(usize(table.values) + index * word)
    match entry.val
        no_string: compiler.unreachable()
        ptr (data): value = text.host_over(view(data,
                                                terminated_length(data)))
    end match
end argument

--- The program's name as the process's entry gave it, `argv[0]`: what
--- its parent called it, often the path it was started by, as a host
--- string lending the process's own storage.  It is empty when the
--- parent gave no arguments at all, and it traps before the argument root
--- exists, as `arguments` does.
public program_name:
    () -> (name: text.host_string) =
    held: ptr ptr u8 = match root_values
        no_table: compiler.unreachable()
        ptr (found): found
    end match
    name = text.host_over(no_bytes[0..<0])
    return when root_count < 1
    first: ptr argument_string = ptr(usize(held))
    match first.val
        no_string: return
        ptr (data): name = text.host_over(view(data, terminated_length(data)))
    end match
end program_name

no_bytes: [1]u8 = [0]

--- The process's environment as its entry gave it: C's `envp`, null
--- terminated, and the count of its entries before the null, counted when
--- it is asked for.  `variable` reads it.
public environment_table: type = struct
    values: ptr ptr u8
    count: usize
end environment_table

--  The table of an empty environment: one null entry.
empty_environment: [1]usize = [0]

--- The process's environment, read where the entry left it: the initial
--- stack's on a static Linux program, and what the C runtime gave `main`
--- otherwise, each `NAME=value` in the order it was given.  It is counted
--- afresh each time, since C code in the same process may change its own
--- `environ` in place, which this module never does: changing the
--- environment is not safe beside threads, and a child is given the one
--- its parent builds instead.  It traps before the argument root exists,
--- as `arguments` does.
public environment:
    () -> (table: environment_table) =
    _ = arguments()
    values: ptr ptr u8 = match root_environment
        no_table: ptr(usize(addr empty_environment[0]))
        ptr (found): found
    end match
    mut count: usize = 0
    loop do
        entry: ptr usize = ptr(usize(values) + count * word)
        break when entry.val == 0
        inc count
    end loop
    table = (values: values, count: count)
end environment

--- The variable at `index`, from zero, of the environment `table`: the
--- bytes of its entry before the first `=` as its name and those after it
--- as its value, host strings lending the process's own storage, which
--- nothing copies.  An entry with no `=` is a name with an empty value.  An
--- index at or past the table's `count` traps, as does a null entry, which
--- a table changed since it was counted may hold.
public variable:
    (table: environment_table, index: usize)
    -> (item: io.variable from table) =
    if index >= table.count then
        compiler.unreachable()
    end if
    entry: ptr argument_string = ptr(usize(table.values) + index * word)
    match entry.val
        no_string: compiler.unreachable()
        ptr (data): begin
            whole: []u8 = view(data, terminated_length(data))
            at: usize = mem.find(whole, u8('='))
            value: []u8 = if at < lenof whole then whole[at + 1..<lenof whole]
                          else whole[lenof whole..<lenof whole] end if
            item = (name: text.host_over(whole[0..<at]),
                    value: text.host_over(value))
        end
    end match
end variable

--- The two ends of a pipe: what is written to `writing` is read from
--- `reading`.
public pipe_ends: type = struct
    reading: descriptor
    writing: descriptor
end pipe_ends

--- Make a pipe, POSIX's `pipe`: its two ends, each closed when the process
--- executes a program, which Linux and FreeBSD set as the pipe is made,
--- with `pipe2`, and Darwin, which has none, just after; or the errno,
--- `emfile` when the process has no descriptor to spare.  A pipe holds 64
--- KiB on Linux and between 16 and 64 KiB on Darwin and FreeBSD, and a
--- write to a full one waits until its reader reads.
public pipe:
    () -> (ends: pipe_ends) ! errno =
    ends = try system_pipe()
end pipe

--- Whether `opened` is closed when the process executes a program, its
--- `FD_CLOEXEC` flag, as every descriptor this module makes is: or the
--- errno, `ebadf` for a descriptor that is not open.
public closed_on_exec:
    (opened: descriptor) -> (yes: bool) ! errno =
    yes = try system_closed_on_exec(opened)
end closed_on_exec

process_value: type = distinct i32

--- A child process's ID, as `spawn` gives it and `wait` takes it: a
--- handle, not a number to count with.
public process_id: type = process_value

--- The descriptors a child's standard input, output and error are made
--- from: each is duplicated onto the child's descriptor 0, 1 or 2, so the
--- child receives it open whether or not it is closed on exec, one that
--- already is that number among them, and the same descriptor may be given
--- for more than one.  The parent's descriptors and their flags are left as
--- they are.  A stream that is its own number and is not open in the parent
--- is not open in the child either; any other that is not open is `ebadf`.
public standard_streams: type = struct
    input: descriptor
    output: descriptor
    errors: descriptor
end standard_streams

--- The parent's own three standard streams, inherited.
public inherited_streams: standard_streams = (input: standard_input,
                                              output: standard_output,
                                              errors: standard_error)

--  The signals besides SIGPIPE whose default disposition every child
--  `spawn` starts is given, signal N at bit N - 1: those a provider took
--  and named to `default_in_children`.  Any thread may name one while
--  another spawns, so the set is an atomic cell, a bit added by a
--  compare-exchange and the whole set read by an acquiring load (D503).
mut child_defaults: atomic.cell(u64) = zeroed

--- Give `signal` its default disposition in every child `spawn` starts
--- from now on, as SIGPIPE's always is.  A provider that takes a signal
--- from its disposition to deliver it as an event, ignoring it while
--- kqueue's signal filter counts it, names it here, so that no program it
--- runs inherits the ignore, which an exec keeps.  A signal nobody named
--- keeps in the child the disposition this process gives it, an ignore
--- included, as a shell's background job and `nohup` rely on.  The name
--- is kept for the rest of the process.  `einval` for a number that is no
--- signal of the system's, one above 64 or Darwin's 31 among them, and for
--- SIGKILL and SIGSTOP, whose disposition never changes.
public default_in_children: (signal: i32) -> none ! errno =
    fail einval when signal < 1 or signal > signal_limit or signal == 9
      or signal == stop_signal
    bit: u64 = u64(1) << u64(signal - 1)
    mut seen: u64 = atomic.load_relaxed(addr child_defaults)
    loop do
        observed: u64 = atomic.compare_exchange(addr child_defaults, seen,
                                                seen | bit)
        break when observed == seen
        seen = observed
    end loop
end default_in_children

--- Start the program at `path` in a child process, POSIX's `posix_spawn`:
--- the program is given `path` as its name, `argv[0]`, then `arguments`,
--- and exactly the variables of `environment`, each as `NAME=value`, and
--- its standard streams are `streams`.  Nothing searches a path for the
--- program and no shell reads anything.  Every other descriptor is closed
--- in the child, so it receives no file but its three streams.  The
--- child's ID, or the errno, with no child started: `enoent` for a missing
--- program, `eacces` for one that may not be executed, `enoexec` for one
--- that is no program, `einval` for an argument or a value holding a NUL
--- or a name that is empty or holds `=` or a NUL, and `e2big` for more than
--- the system takes.  A child must be waited for, with `wait`, or it keeps
--- its place in the system's table until this process ends.
---
--- The child starts with no signal blocked, whatever this thread's mask
--- is, which an exec would otherwise pass on: a provider that blocks a
--- signal to read it through a signalfd starts no child with it blocked.
--- It starts with SIGPIPE's default disposition, whatever this process's
--- is, since this process ignores it, and with the default of every signal
--- `default_in_children` was given.
---
--- On Linux it is a `clone` that copies this process, as `fork` does,
--- which in the child moves the streams into place, gives those signals
--- their default, empties its mask and executes the program, and reports
--- a failure to the parent through a pipe closed on exec; on Darwin and
--- FreeBSD it is the C library's `posix_spawn`, told to reset those
--- signals with `posix_spawnattr_setsigdefault` and the mask with
--- `posix_spawnattr_setsigmask`.  The
--- block of strings and tables the child is given is mapped for the call
--- and unmapped after it.
public spawn:
    (path: text.host_string, arguments: []text.host_string,
     environment: []io.variable, streams: standard_streams)
    -> (child: process_id) ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    named: []u8 = text.host_bytes(path)
    --  The tables first, so each pointer is aligned, then every string
    --  with its NUL: the name, the arguments, and each variable as
    --  `NAME=value`.
    entries: usize = (lenof arguments + 2) + (lenof environment + 1)
    mut size: usize = entries * word + lenof named + 1
    for argument in arguments do
        bytes: []u8 = text.host_bytes(argument)
        fail einval when mem.find(bytes, 0) < lenof bytes
        size += lenof bytes + 1
    end for
    for item in environment do
        name: []u8 = text.host_bytes(item.name)
        value: []u8 = text.host_bytes(item.value)
        fail einval when lenof name == 0 or mem.find(name, u8('=')) < lenof name
          or mem.find(name, 0) < lenof name or mem.find(value, 0) < lenof value
        size += lenof name + lenof value + 2
    end for
    block: ptr mut u8 = try map(size)
    defer release(block, size)
    whole: []mut u8 = writable_view(block, size)
    mut table: usize = usize(block)
    mut at: usize = entries * word
    at = place(whole, at, table, named)
    table += word
    for argument in arguments do
        at = place(whole, at, table, text.host_bytes(argument))
        table += word
    end for
    table += word
    variables: usize = table
    for item in environment do
        start: usize = at
        at = place(whole, at, table, text.host_bytes(item.name))
        --  The name's NUL becomes the `=`, and the value follows it.
        whole[at - 1] = u8('=')
        at = place(whole, at, table, text.host_bytes(item.value))
        slot: ptr mut usize = ptr(table)
        slot.val = usize(block) + start
        table += word
    end for
    (result: input, made: made_input) :=
        try lifted(streams.input, standard_input)
    defer forget(input, made_input)
    (result: output, made: made_output) :=
        try lifted(streams.output, standard_output)
    defer forget(output, made_output)
    (result: errors, made: made_errors) :=
        try lifted(streams.errors, standard_error)
    defer forget(errors, made_errors)
    named_table: ptr ptr u8 = ptr(usize(block))
    variable_table: ptr ptr u8 = ptr(variables)
    child = try system_spawn(terminated, named_table, variable_table,
                             (input: input, output: output, errors: errors))
end spawn

--  Copy BYTES to WHOLE at AT with a NUL after them, which the mapping
--  already is, and put their address in the table slot at TABLE: where the
--  next string goes.
place: (whole: []mut u8, at: usize, table: usize, bytes: []u8)
       -> (next: usize) =
    next = at + lenof bytes + 1
    mem.copy(whole[at..<at + lenof bytes], bytes) else (problem)
        _ = problem
        compiler.unreachable()
    end
    slot: ptr mut usize = ptr(table)
    slot.val = usize(addr whole[0]) + at
end place

--  Give a mapping back, whatever the system says.
release: (block: ptr mut u8, size: usize) -> none =
    unmap(block, size) else none
end release

--  Every stream for the child below 3 is duplicated above 2 for the call,
--  and the duplicate closed after: one that is not its own number would be
--  overwritten by another stream moved into place before it is read, and
--  one that is would keep its `FD_CLOEXEC` flag and be closed by the exec,
--  where a duplication onto its number clears the flag.  The duplicate is
--  the parent's own, so the parent's flags are left as they are.  A
--  stream that is its own number and is not open stays as it is, so the
--  child's is not open either.
lifted: (source: descriptor, target: descriptor)
        -> (result: descriptor, made: bool) ! errno =
    result = source
    made = false
    return when i32(source) >= 3 or i32(source) < 0
    result = system_duplicate_above(source, 3) else (problem)
        return when source == target and problem == ebadf
        fail problem
    end
    made = true
end lifted

forget: (made_from: descriptor, made: bool) -> none =
    if made then forgotten(made_from) end if
end forget

--- How a child ended, as `wait` reports it: it `exited` with the code its
--- program gave `_exit` or returned from `main`, of which the parent sees
--- the low eight bits, or it was `signalled`, ended by the signal of
--- that number, a number each system gives its signals: SIGKILL is 9
--- and SIGTERM 15 on all three, SIGUSR1 10 on Linux and 30 on Darwin and
--- FreeBSD.
public child_status: type = struct
    how: variant
        exited: (code: i32) |
        signalled: (signal: i32)
    end how
end child_status

--- Wait for the child `child` to end and report how it did, POSIX's
--- `waitpid`, after which it is gone: or the errno, `echild` for no child
--- of this process, `eintr` when a signal came first and the child is
--- still to be waited for.
public wait:
    (child: process_id) -> (status: child_status) ! errno =
    word: i32 = try system_wait(child)
    --  The status word is the same on all three systems: the low seven
    --  bits are the signal that ended the child, zero when it exited, and
    --  the next eight its code.
    ending: i32 = word & 127
    status = if ending == 0 then (how: exited(code: (word >> 8) & 255))
             else (how: signalled(signal: ending)) end if
end wait

--  The system's own calls beneath the facility above: Linux's system
--  calls through platform/linux, and the C library through
--  platform/libc on Darwin and FreeBSD, whose system interface it is.

fixed if compiler.os == linux then
    --  The highest signal `default_in_children` takes, and SIGSTOP, whose
    --  disposition never changes: Linux numbers it 19.
    signal_limit: i32 = 64
    stop_signal: i32 = 19

    system_exit: (status: i32) -> noreturn =
        linux.exit_group(status)
    end system_exit

    system_pipe: () -> (ends: pipe_ends) ! errno =
        mut made: [2]i32 = zeroed
        result: i32 = linux.pipe2(addr made[0], linux.o_cloexec)
        fail errno_of(-result) when result < 0
        ends = (reading: descriptor(made[0]), writing: descriptor(made[1]))
    end system_pipe

    system_closed_on_exec: (opened: descriptor) -> (yes: bool) ! errno =
        flags: i32 = linux.fcntl(i32(opened), linux.f_getfd, 0)
        fail errno_of(-flags) when flags < 0
        yes = (flags & linux.fd_cloexec) <> 0
    end system_closed_on_exec

    system_duplicate_above: (source: descriptor, lowest: i32)
                            -> (result: descriptor) ! errno =
        made: i32 = linux.fcntl(i32(source), linux.f_dupfd_cloexec,
                                i64(lowest))
        fail errno_of(-made) when made < 0
        result = descriptor(made)
    end system_duplicate_above

    --  An end of the report pipe moved above the standard streams, so that
    --  moving them into place in the child cannot overwrite it.
    report_end: (given: i32) -> (result: i32) ! errno =
        result = given
        return when given >= 3
        moved: i32 = linux.fcntl(given, linux.f_dupfd_cloexec, 3)
        _ = linux.close(given)
        fail errno_of(-moved) when moved < 0
        result = moved
    end report_end

    --  What the child runs between the copy and the program: it moves the
    --  streams into place, each lifted above 2 by `spawn`, so that `dup3`
    --  clears the close-on-exec flag in the child alone, and one still its
    --  own number, which the parent has not got open, is left closed; it
    --  marks every other descriptor closed on exec and executes the
    --  program, and when any of that fails writes the errno to the report
    --  pipe and ends.  It makes system calls and nothing
    --  else: no allocation, and nothing another thread of the parent could
    --  have held.
    start_child: (path: ptr u8, arguments: ptr ptr u8,
                  environment: ptr ptr u8, streams: standard_streams,
                  report: i32) -> noreturn =
        mut result: i32 = 0
        if streams.input <> standard_input then
            result = linux.dup3(i32(streams.input), 0, 0)
        end if
        if result >= 0 and streams.output <> standard_output then
            result = linux.dup3(i32(streams.output), 1, 0)
        end if
        if result >= 0 and streams.errors <> standard_error then
            result = linux.dup3(i32(streams.errors), 2, 0)
        end if
        if result >= 0 then
            --  Descriptors this layer made are closed on exec already; this
            --  closes any a C library or an inherited one left open, and a
            --  kernel older than 5.11 that refuses it leaves only those.
            _ = linux.close_range(3, 0 -% 1, linux.close_range_cloexec)
            --  The parent ignores SIGPIPE, which an exec keeps, and a
            --  provider may ignore a signal it reads; the child starts
            --  with their default, as a program expects to.
            mut restored: linux.signal_action = zeroed
            restored.handler = linux.sig_dfl
            result = linux.rt_sigaction(linux.sigpipe, addr restored,
                                        linux.no_action)
            defaults: u64 = atomic.load(addr child_defaults)
            mut number: i32 = 1
            while result >= 0 and number <= signal_limit do
                if (defaults & (u64(1) << u64(number - 1))) <> 0 then
                    result = linux.rt_sigaction(number, addr restored,
                                                linux.no_action)
                end if
                number += 1
            end while
        end if
        if result >= 0 then
            --  The mask is the thread's and an exec keeps it: a signal the
            --  parent blocks to read through a signalfd is not blocked in
            --  the program.
            unblocked: u64 = 0
            result = linux.rt_sigprocmask(linux.sig_setmask, addr unblocked,
                                          linux.no_mask)
        end if
        if result >= 0 then
            result = linux.execve(path, arguments, environment)
        end if
        problem: u32 = u32(-result)
        word: [4]u8 = [u8(problem & 255), u8((problem >> 8) & 255),
                       u8((problem >> 16) & 255), u8(problem >> 24)]
        _ = linux.write(report, addr word[0], 4)
        linux.exit_group(127)
    end start_child

    --  The child's report: four bytes of the errno that stopped it, or none
    --  once its exec closed the pipe.  A read interrupted by a signal is
    --  made again: the child exists either way, and only its report says
    --  whether it is running the program.
    read_report: (reading: i32) -> (problem: i32) =
        mut word: [4]u8 = zeroed
        mut got: isize = 0
        loop do
            got = linux.read(reading, addr word[0], 4)
            break when got <> -4
        end loop
        problem = 0
        return when got <> 4
        problem = i32(u32(word[0]) | (u32(word[1]) << 8)
                      | (u32(word[2]) << 16) | (u32(word[3]) << 24))
    end read_report

    system_spawn: (path: ptr u8, arguments: ptr ptr u8,
                   environment: ptr ptr u8, streams: standard_streams)
                  -> (child: process_id) ! errno =
        mut made: [2]i32 = zeroed
        opened: i32 = linux.pipe2(addr made[0], linux.o_cloexec)
        fail errno_of(-opened) when opened < 0
        reading: i32 = report_end(made[0]) else (problem)
            _ = linux.close(made[1])
            fail problem
        end
        writing: i32 = report_end(made[1]) else (problem)
            _ = linux.close(reading)
            fail problem
        end
        copied: i64 = linux.fork()
        if copied == 0 then
            start_child(path, arguments, environment, streams, writing)
        end if
        _ = linux.close(writing)
        if copied < 0 then
            _ = linux.close(reading)
            fail errno_of(i32(-copied))
        end if
        problem: i32 = read_report(reading)
        _ = linux.close(reading)
        child = process_id(i32(copied))
        return when problem == 0
        --  The child ended without its program: reap it, so no trace of it
        --  is left.
        mut status: i32 = 0
        loop do
            reaped: i32 = linux.wait4(i32(copied), addr status, 0)
            break when reaped <> -4
        end loop
        fail errno_of(problem)
    end system_spawn

    --  A program the C runtime started gives `main` the initial stack's
    --  tables, and the auxiliary vector after them is platform/linux's
    --  once it has held them to the kernel's layout.
    system_adopt_start: (count: i32, values: ptr ptr u8,
                         environment: ptr ptr u8) -> none =
        _ = linux.adopt_start(count, values, environment)
    end system_adopt_start

    --  SIGPIPE's disposition, the process's own: ignored when it was the
    --  default, so that a write to a pipe or a socket nobody reads fails
    --  with EPIPE rather than ending the process; a handler a C `main`
    --  installed, and an ignore the process was started with, are kept.
    system_ignore_broken_pipe: () -> none =
        mut previous: linux.signal_action = zeroed
        return when linux.rt_sigaction(linux.sigpipe, linux.no_action,
                                       addr previous) < 0
        return when previous.handler <> linux.sig_dfl
        mut ignoring: linux.signal_action = zeroed
        ignoring.handler = linux.sig_ign
        _ = linux.rt_sigaction(linux.sigpipe, addr ignoring, linux.no_action)
    end system_ignore_broken_pipe

    --  Whether SIGPIPE is ignored, for a program to ask.
    system_broken_pipe_ignored: () -> (ignored: bool) =
        mut previous: linux.signal_action = zeroed
        ignored = linux.rt_sigaction(linux.sigpipe, linux.no_action,
                                     addr previous) >= 0
                  and previous.handler == linux.sig_ign
    end system_broken_pipe_ignored

    system_wait: (child: process_id) -> (word: i32) ! errno =
        mut status: i32 = 0
        result: i32 = linux.wait4(i32(child), addr status, 0)
        fail errno_of(-result) when result < 0
        word = status
    end system_wait
elsif compiler.os == darwin or compiler.os == freebsd then
    --  The highest signal `default_in_children` takes, Darwin's set
    --  holding 31 and FreeBSD's more than the record's 64, and SIGSTOP,
    --  whose disposition never changes: both number it 17.
    fixed if compiler.os == darwin then
        signal_limit: i32 = 31
    else
        signal_limit: i32 = 64
    end if
    stop_signal: i32 = 17

    system_exit: (status: i32) -> noreturn =
        libc._exit(status)
    end system_exit

    fixed if compiler.os == darwin then
        --  Darwin has no pipe2, so each end is marked closed on exec just
        --  after the pipe is made.  A program another thread executes in
        --  between could inherit the pair; `spawn` closes every descriptor
        --  it does not give the child either way.
        system_pipe: () -> (ends: pipe_ends) ! errno =
            mut made: [2]i32 = zeroed
            fail failure() when libc.pipe(addr made[0]) <> 0
            if libc.fcntl(made[0], libc.f_setfd, libc.fd_cloexec) <> 0
              or libc.fcntl(made[1], libc.f_setfd, libc.fd_cloexec) <> 0
            then
                problem: errno = failure()
                _ = libc.close(made[0])
                _ = libc.close(made[1])
                fail problem
            end if
            ends = (reading: descriptor(made[0]),
                    writing: descriptor(made[1]))
        end system_pipe
    else
        system_pipe: () -> (ends: pipe_ends) ! errno =
            mut made: [2]i32 = zeroed
            fail failure() when libc.pipe2(addr made[0], libc.o_cloexec) <> 0
            ends = (reading: descriptor(made[0]),
                    writing: descriptor(made[1]))
        end system_pipe
    end if

    system_closed_on_exec: (opened: descriptor) -> (yes: bool) ! errno =
        flags: i32 = libc.fcntl(i32(opened), libc.f_getfd)
        fail failure() when flags < 0
        yes = (flags & libc.fd_cloexec) <> 0
    end system_closed_on_exec

    system_duplicate_above: (source: descriptor, lowest: i32)
                            -> (result: descriptor) ! errno =
        made: i32 = libc.fcntl(i32(source), libc.f_dupfd_cloexec, lowest)
        fail failure() when made < 0
        result = descriptor(made)
    end system_duplicate_above

    --  The actions that make the child's streams: each stream, above 2 once
    --  `spawn` has lifted it, is duplicated onto its number, which clears
    --  the close-on-exec flag in the child alone.  A stream still its own
    --  number is one the parent has not got open, and is left closed.
    --  Darwin closes every descriptor no action names through its own
    --  spawn flag; FreeBSD closes every descriptor from 3 up as the last
    --  action.
    stream_action: (actions: ptr mut libc.spawn_object,
                    source: descriptor, target: i32) -> (error: i32) =
        error = 0
        return when i32(source) == target
        error = libc.posix_spawn_file_actions_adddup2(actions, i32(source),
                                                      target)
    end stream_action

    fixed if compiler.os == darwin then
        last_actions: (actions: ptr mut libc.spawn_object,
                       attributes: ptr mut libc.spawn_object)
                      -> (error: i32) =
            _ = actions
            _ = attributes
            error = 0
        end last_actions

        --  Every descriptor the actions do not name is closed, the
        --  signals the attributes name start at their default, and the
        --  child's mask is the attributes'.
        spawn_flags: i16 = libc.posix_spawn_cloexec_default
                           | libc.posix_spawn_setsigdef
                           | libc.posix_spawn_setsigmask
    else
        last_actions: (actions: ptr mut libc.spawn_object,
                       attributes: ptr mut libc.spawn_object)
                      -> (error: i32) =
            _ = attributes
            error = libc.posix_spawn_file_actions_addclosefrom_np(actions, 3)
        end last_actions

        --  The signals the attributes name start at their default, and
        --  the child's mask is the attributes'.
        spawn_flags: i16 = libc.posix_spawn_setsigdef
                           | libc.posix_spawn_setsigmask
    end if

    --  The parent ignores SIGPIPE, which an exec keeps, and a provider
    --  may ignore a signal it reads, so the child is told to start with
    --  their default, as a program expects to: signal N is bit N - 1 of
    --  the set's words of 32, SIGPIPE, 13, bit 12 on both systems.  Its
    --  mask, which an exec keeps too, starts empty.
    signal_defaults: (attributes: ptr mut libc.spawn_object)
                     -> (error: i32) =
        mut signals: libc.signal_set = zeroed
        signals.bits[0] = u32(1) << u32(libc.sigpipe - 1)
        defaults: u64 = atomic.load(addr child_defaults)
        mut number: i32 = 1
        while number <= signal_limit do
            if (defaults & (u64(1) << u64(number - 1))) <> 0 then
                index: usize = usize((number - 1) / 32)
                signals.bits[index] = signals.bits[index]
                                      | (u32(1) << u32((number - 1) % 32))
            end if
            number += 1
        end while
        error = libc.posix_spawnattr_setsigdefault(attributes, addr signals)
        if error == 0 then
            unblocked: libc.signal_set = zeroed
            error = libc.posix_spawnattr_setsigmask(attributes,
                                                    addr unblocked)
        end if
        if error == 0 then
            error = libc.posix_spawnattr_setflags(attributes, spawn_flags)
        end if
    end signal_defaults

    --  posix_spawn reports its failure as its result rather than in errno.
    spawn_with: (path: ptr u8, arguments: ptr ptr u8,
                 environment: ptr ptr u8, streams: standard_streams,
                 actions: ptr mut libc.spawn_object,
                 attributes: ptr mut libc.spawn_object)
                -> (child: process_id) ! errno =
        mut error: i32 = stream_action(actions, streams.input, 0)
        if error == 0 then
            error = stream_action(actions, streams.output, 1)
        end if
        if error == 0 then
            error = stream_action(actions, streams.errors, 2)
        end if
        if error == 0 then error = last_actions(actions, attributes) end if
        if error == 0 then error = signal_defaults(attributes) end if
        fail errno_of(error) when error <> 0
        mut made: i32 = 0
        error = libc.posix_spawn(addr made, path, actions, attributes,
                                 arguments, environment)
        fail errno_of(error) when error <> 0
        child = process_id(made)
    end spawn_with

    system_spawn: (path: ptr u8, arguments: ptr ptr u8,
                   environment: ptr ptr u8, streams: standard_streams)
                  -> (child: process_id) ! errno =
        mut actions: libc.spawn_object = 0
        mut attributes: libc.spawn_object = 0
        error: i32 = libc.posix_spawn_file_actions_init(addr actions)
        fail errno_of(error) when error <> 0
        given: i32 = libc.posix_spawnattr_init(addr attributes)
        if given <> 0 then
            _ = libc.posix_spawn_file_actions_destroy(addr actions)
            fail errno_of(given)
        end if
        child = spawn_with(path, arguments, environment, streams,
                           addr actions, addr attributes) else (problem)
            _ = libc.posix_spawnattr_destroy(addr attributes)
            _ = libc.posix_spawn_file_actions_destroy(addr actions)
            fail problem
        end
        _ = libc.posix_spawnattr_destroy(addr attributes)
        _ = libc.posix_spawn_file_actions_destroy(addr actions)
    end system_spawn

    --  Darwin and FreeBSD keep no auxiliary vector here to adopt.
    system_adopt_start: (count: i32, values: ptr ptr u8,
                         environment: ptr ptr u8) -> none =
        _ = count
        _ = values
        _ = environment
    end system_adopt_start

    --  SIGPIPE's disposition, the process's own: ignored when it was the
    --  default, so that a write to a pipe or a socket nobody reads fails
    --  with EPIPE rather than ending the process; a handler a C `main`
    --  installed, and an ignore the process was started with, are kept.
    system_ignore_broken_pipe: () -> none =
        mut previous: libc.signal_action = zeroed
        return when libc.sigaction(libc.sigpipe, libc.no_address,
                                   addr previous) <> 0
        return when previous.handler <> libc.sig_dfl
        mut ignoring: libc.signal_action = zeroed
        ignoring.handler = libc.sig_ign
        _ = libc.sigaction(libc.sigpipe, addr ignoring, libc.no_address)
    end system_ignore_broken_pipe

    --  Whether SIGPIPE is ignored, for a program to ask.
    system_broken_pipe_ignored: () -> (ignored: bool) =
        mut previous: libc.signal_action = zeroed
        ignored = libc.sigaction(libc.sigpipe, libc.no_address,
                                 addr previous) == 0
                  and previous.handler == libc.sig_ign
    end system_broken_pipe_ignored

    system_wait: (child: process_id) -> (word: i32) ! errno =
        mut status: i32 = 0
        fail failure() when libc.waitpid(i32(child), addr status, 0) < 0
        word = status
    end system_wait
end if
