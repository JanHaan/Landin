--- Every failure a POSIX call here reports: the errno it failed with, as
--- an atom, or `unlisted`.  `number` gives the errno's number on this
--- system and `errno_of` the atom for a number.
public errno: type = eperm | enoent | esrch | eintr | eio | enxio | e2big
    | enoexec | ebadf | echild | eagain | enomem | eacces | efault | enotblk
    | ebusy | eexist | exdev | enodev | enotdir | eisdir | einval | enfile
    | emfile | enotty | etxtbsy | efbig | enospc | espipe | erofs | emlink
    | epipe | edom | erange | edeadlk | enametoolong | enolck | enosys
    | enotempty | eloop | enomsg | eidrm | echrng | el2nsync | el3hlt | el3rst
    | elnrng | eunatch | enocsi | el2hlt | ebade | ebadr | exfull | enoano
    | ebadrqc | ebadslt | ebfont | enostr | enodata | etime | enosr | enonet
    | enopkg | eremote | enolink | eadv | esrmnt | ecomm | eproto | emultihop
    | edotdot | ebadmsg | eoverflow | enotuniq | ebadfd | eremchg | elibacc
    | elibbad | elibscn | elibmax | elibexec | eilseq | erestart | estrpipe
    | eusers | enotsock | edestaddrreq | emsgsize | eprototype | enoprotoopt
    | eprotonosupport | esocktnosupport | eopnotsupp | epfnosupport
    | eafnosupport | eaddrinuse | eaddrnotavail | enetdown | enetunreach
    | enetreset | econnaborted | econnreset | enobufs | eisconn | enotconn
    | eshutdown | etoomanyrefs | etimedout | econnrefused | ehostdown
    | ehostunreach | ealready | einprogress | estale | euclean | enotnam
    | enavail | eisnam | eremoteio | edquot | enomedium | emediumtype
    | ecanceled | enokey | ekeyexpired | ekeyrevoked | ekeyrejected
    | eownerdead | enotrecoverable | erfkill | ehwpoison | eauth | ebadarch
    | ebadexec | ebadmacho | ebadrpc | ecapmode | edeverr | edoofus | eftype
    | eintegrity | eneedauth | enoattr | enopolicy | enotcapable | enotsup
    | eproclim | eprocunavail | eprogmismatch | eprogunavail | epwroff
    | eqfull | erpcmismatch | eshlibvers | unlisted

--  Each system's errno numbers in order: entry N is the atom for errno N,
--  and a number the system leaves unused is `unlisted`.
fixed if compiler.os == darwin then
    --  Whether ENOTSUP is EOPNOTSUPP's number.
    shared_notsup: bool = false
else
    shared_notsup: bool = true
end if

fixed if compiler.os == linux then
    errno_table: [134]errno =
        [unlisted, eperm, enoent, esrch, eintr, eio, enxio, e2big, enoexec,
         ebadf, echild, eagain, enomem, eacces, efault, enotblk, ebusy,
         eexist, exdev, enodev, enotdir, eisdir, einval, enfile, emfile,
         enotty, etxtbsy, efbig, enospc, espipe, erofs, emlink, epipe, edom,
         erange, edeadlk, enametoolong, enolck, enosys, enotempty, eloop,
         unlisted, enomsg, eidrm, echrng, el2nsync, el3hlt, el3rst, elnrng,
         eunatch, enocsi, el2hlt, ebade, ebadr, exfull, enoano, ebadrqc,
         ebadslt, unlisted, ebfont, enostr, enodata, etime, enosr, enonet,
         enopkg, eremote, enolink, eadv, esrmnt, ecomm, eproto, emultihop,
         edotdot, ebadmsg, eoverflow, enotuniq, ebadfd, eremchg, elibacc,
         elibbad, elibscn, elibmax, elibexec, eilseq, erestart, estrpipe,
         eusers, enotsock, edestaddrreq, emsgsize, eprototype, enoprotoopt,
         eprotonosupport, esocktnosupport, eopnotsupp, epfnosupport,
         eafnosupport, eaddrinuse, eaddrnotavail, enetdown, enetunreach,
         enetreset, econnaborted, econnreset, enobufs, eisconn, enotconn,
         eshutdown, etoomanyrefs, etimedout, econnrefused, ehostdown,
         ehostunreach, ealready, einprogress, estale, euclean, enotnam,
         enavail, eisnam, eremoteio, edquot, enomedium, emediumtype,
         ecanceled, enokey, ekeyexpired, ekeyrevoked, ekeyrejected,
         eownerdead, enotrecoverable, erfkill, ehwpoison]
elsif compiler.os == darwin then
    errno_table: [108]errno =
        [unlisted, eperm, enoent, esrch, eintr, eio, enxio, e2big, enoexec,
         ebadf, echild, edeadlk, enomem, eacces, efault, enotblk, ebusy,
         eexist, exdev, enodev, enotdir, eisdir, einval, enfile, emfile,
         enotty, etxtbsy, efbig, enospc, espipe, erofs, emlink, epipe, edom,
         erange, eagain, einprogress, ealready, enotsock, edestaddrreq,
         emsgsize, eprototype, enoprotoopt, eprotonosupport, esocktnosupport,
         enotsup, epfnosupport, eafnosupport, eaddrinuse, eaddrnotavail,
         enetdown, enetunreach, enetreset, econnaborted, econnreset, enobufs,
         eisconn, enotconn, eshutdown, etoomanyrefs, etimedout, econnrefused,
         eloop, enametoolong, ehostdown, ehostunreach, enotempty, eproclim,
         eusers, edquot, estale, eremote, ebadrpc, erpcmismatch,
         eprogunavail, eprogmismatch, eprocunavail, enolck, enosys, eftype,
         eauth, eneedauth, epwroff, edeverr, eoverflow, ebadexec, ebadarch,
         eshlibvers, ebadmacho, ecanceled, eidrm, enomsg, eilseq, enoattr,
         ebadmsg, emultihop, enodata, enolink, enosr, enostr, eproto, etime,
         eopnotsupp, enopolicy, enotrecoverable, eownerdead, eqfull,
         enotcapable]
else
    errno_table: [98]errno =
        [unlisted, eperm, enoent, esrch, eintr, eio, enxio, e2big, enoexec,
         ebadf, echild, edeadlk, enomem, eacces, efault, enotblk, ebusy,
         eexist, exdev, enodev, enotdir, eisdir, einval, enfile, emfile,
         enotty, etxtbsy, efbig, enospc, espipe, erofs, emlink, epipe, edom,
         erange, eagain, einprogress, ealready, enotsock, edestaddrreq,
         emsgsize, eprototype, enoprotoopt, eprotonosupport, esocktnosupport,
         eopnotsupp, epfnosupport, eafnosupport, eaddrinuse, eaddrnotavail,
         enetdown, enetunreach, enetreset, econnaborted, econnreset, enobufs,
         eisconn, enotconn, eshutdown, etoomanyrefs, etimedout, econnrefused,
         eloop, enametoolong, ehostdown, ehostunreach, enotempty, eproclim,
         eusers, edquot, estale, eremote, ebadrpc, erpcmismatch,
         eprogunavail, eprogmismatch, eprocunavail, enolck, enosys, eftype,
         eauth, eneedauth, eidrm, enomsg, eoverflow, ecanceled, eilseq,
         enoattr, edoofus, ebadmsg, emultihop, enolink, eproto, enotcapable,
         ecapmode, enotrecoverable, eownerdead, eintegrity]
end if

--- The errno atom for the number `value` on this system: `unlisted` for a
--- number it does not define.
public errno_of:
    (value: i32) -> (problem: errno) =
    problem = unlisted
    return when value <= 0 or usize(value) >= lenof errno_table
    problem = errno_table[usize(value)]
end errno_of

--- The number `problem` has on this system, as C's `errno` holds it: zero for
--- `unlisted` and for an errno this system does not define.  ENOTSUP is
--- EOPNOTSUPP's number on Linux and FreeBSD.
public number:
    (problem: errno) -> (value: i32) =
    value = 0
    return when problem == unlisted
    mut sought: errno = problem
    if shared_notsup and sought == enotsup then sought = eopnotsupp end if
    for at in usize(1)..<lenof errno_table do
        if errno_table[at] == sought then
            value = i32(at)
            return
        end if
    end for
end number
