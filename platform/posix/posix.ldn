--  POSIX's facilities in Landin types, on the systems that give them:
--  Linux, Darwin and FreeBSD.  A descriptor is a handle type of its own,
--  a failure is the errno as an atom whose number `number` keeps, a path
--  or an argument is a host string, and a file's status is a record.  It
--  is written twice, beneath this file: once over platform/linux's system
--  calls in linux.ldn, and once over platform/libc, the C library Darwin
--  and FreeBSD give as their system interface, in libc.ldn.  hosted/io and
--  hosted/heap are written once over it.  A system that is not POSIX, as
--  Windows is not, has no platform/posix: its providers implement the
--  core concepts over its own interface instead.
--
--  The calls are POSIX's own, not policy: a call interrupted by a signal
--  fails with `eintr` and is not retried here, a short read or write is
--  returned as it came, and nothing is closed on the caller's behalf.
--  Every descriptor the module makes is closed when the process executes
--  a program, so a child receives only the standard streams `spawn` gives
--  it.  A
--  path is copied into a buffer of the system's PATH_MAX with a NUL after
--  it on its way to the system, so the terminator is this module's and
--  never the caller's: a path holding a NUL fails with `einval`, as no
--  system could be given it, and one too long for the buffer with
--  `enametoolong`, as the system says of a path longer than it takes.

import core/io
import core/mem
import core/text

compiler.assert(compiler.os == linux or compiler.os == darwin
                or compiler.os == freebsd)

descriptor_value: type = distinct i32

--- An open file's descriptor: a handle the system gives, which names one
--- open file until it is closed.  It is a handle and not a number to
--- count with; `descriptor(n)` and `i32(d)` convert at a C boundary.
public descriptor: type = descriptor_value

--- Standard input, descriptor 0.
public standard_input: descriptor = descriptor_value(0)
--- Standard output, descriptor 1.
public standard_output: descriptor = descriptor_value(1)
--- Standard error, descriptor 2.
public standard_error: descriptor = descriptor_value(2)

fixed if compiler.os == linux then
    --  PATH_MAX: room for the longest path a call takes, its NUL
    --  included.
    path_room: type = [4096]u8
else
    --  PATH_MAX: room for the longest path a call takes, its NUL
    --  included.
    path_room: type = [1024]u8
end if

--- Open for reading only.
public read_only: atom
--- Open for writing only.
public write_only: atom
--- Open for reading and writing.
public read_write: atom
--- How an open file may be used: `read_only`, `write_only` or
--- `read_write`.
public access: type = read_only | write_only | read_write

--- How `open_at` opens a file: its access, and whether to create it when
--- it is missing, refuse it when it exists (`exclusive`, with `create`),
--- truncate it, append every write to its end, or refuse anything that is
--- not a directory with `enotdir`.
public open_options: type = struct
    access: access
    create: bool
    exclusive: bool
    truncate: bool
    append: bool
    directory: bool
end open_options

--- The options for reading an existing file.
public reading: open_options = (access: read_only, create: false,
                                exclusive: false, truncate: false,
                                append: false, directory: false)

--- The options for writing a file from its start, creating it when it is
--- missing and truncating it when it is not.
public writing: open_options = (access: write_only, create: true,
                                exclusive: false, truncate: true,
                                append: false, directory: false)

--- Open the file `path` names, relative to the directory open as `at`
--- (or `working_directory`), with `options`; a file it creates gets the
--- permission bits `permissions`, which the process umask filters.  The
--- descriptor is closed when the process executes a program, POSIX's
--- `O_CLOEXEC`, set as it is opened, and a terminal opened never becomes
--- the process's controlling terminal, `O_NOCTTY`.  The new descriptor,
--- or the errno: `enoent` for a missing name, `enotdir` when a component
--- is not a directory, `eacces` when refused, `eexist` for an `exclusive`
--- name that is taken, `eintr` when a signal came first.
public link(symbol: "_landin_posix_open_at") open_at:
    (at: descriptor, path: text.host_string,
     options: open_options, permissions: u32)
    -> (opened: descriptor) ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    opened = try system_open(at, terminated, options, permissions)
end open_at

--- Read at most `lenof into` bytes from `source` into `into`: the count
--- read, zero at the end of a file, or the errno; `eintr` means nothing
--- was read.
public link(symbol: "_landin_posix_read") read:
    (source: descriptor, into: []mut u8) -> (count: usize) ! errno =
    count = try system_read(source, into)
end read

--- Write at most `lenof bytes` bytes of `bytes` to `to`: the count
--- accepted, which may be short, or the errno; `eintr` means nothing was
--- written.
public link(symbol: "_landin_posix_write") write:
    (to: descriptor, bytes: []u8) -> (count: usize) ! errno =
    count = try system_write(to, bytes)
end write

--- Close `closing`.  The descriptor is released even when this fails, so
--- a failed close is never retried: the number may already name another
--- file.
public link(symbol: "_landin_posix_close") close:
    (closing: descriptor) -> none ! errno =
    try system_close(closing)
end close

--- A regular file.
public regular: atom
--- A directory.
public directory: atom
--- A symbolic link, reported as itself when it is not followed.
public symbolic_link: atom
--- A FIFO, a named pipe.
public fifo: atom
--- A socket: `socket_file`, since `socket` is the name of a call.
public socket_file: atom
--- A character device.
public character_device: atom
--- A block device.
public block_device: atom
--- A kind the system did not say: a directory entry whose file system
--- records none, which `status_at` then tells.
public unknown_kind: atom
--- What a file is.
public file_kind: type = regular | directory | symbolic_link | fifo
    | socket_file | character_device | block_device
    | unknown_kind

--- A file's status, POSIX's `stat`: the device and inode that identify
--- it, what it is and its size in bytes; its permission bits, the mode
--- without its type, `0o644` for one its owner may write and everyone
--- read; how many names it has, its owner and group; and when it was last
--- read, last written and last changed in any way, a change of its status
--- included, as the wall clock read then.  On Linux the device is the
--- kernel's major number in the upper 32 bits and its minor in the lower,
--- as `statx` reports them; elsewhere it is the system's `st_dev`.  Two
--- paths name the same file when both identify it alike.  A time the file
--- system does not keep reads as the system gives it, often zero.
public status: type = struct
    device: u64
    inode: u64
    kind: file_kind
    size: u64
    permissions: u32
    links: u64
    user: user_id
    group: group_id
    accessed: time_value
    modified: time_value
    changed: time_value
end status

--- The status of the file `path` names, relative to the directory open as
--- `at` (or `working_directory`), following a final symbolic link when
--- `follow` is true and reporting the link itself when it is not.
public link(symbol: "_landin_posix_status_at") status_at:
    (at: descriptor, path: text.host_string, follow: bool)
    -> (result: status) ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    result = try system_status(at, terminated, follow)
end status_at

--- The least a buffer `read_directory` reads into holds: room for any
--- entry any of the three systems gives, its record and its NUL included.
public directory_buffer: usize = 1024

--- An open directory stream, POSIX's `DIR`: a value its caller keeps and
--- passes `inout` to `read_directory`, with the same buffer each time.
--- Its fields belong to this module: the directory's descriptor, the C
--- library's stream where there is one, and how much of the buffer the
--- system has filled and the caller has read.
public directory_stream: type = struct
    descriptor: descriptor
    stream: usize
    filled: usize
    cursor: usize
    finished: bool
end directory_stream

--- An entry of a directory: its name, lent from the buffer it was read
--- into until the next read, and its kind, `unknown_kind` where the file
--- system records none.
public directory_entry: type = struct
    name: text.host_string
    kind: file_kind
end directory_entry

--- Open the directory `path` names, relative to `at`, for reading, its
--- descriptor closed on exec as `open_at`'s is: `enotdir` when it is not
--- a directory, `enoent` when it is missing.
--- Close it with `close_directory`, which also closes its descriptor.
public link(symbol: "_landin_posix_open_directory") open_directory:
    (at: descriptor, path: text.host_string)
    -> (opened: directory_stream) ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    opened = try system_open_directory(at, terminated)
end open_directory

--- The directory's next entry, read into `buffer`, which must be the
--- buffer every earlier read of this stream was given and hold at least
--- `directory_buffer` bytes, or `einval`.  The entry lends its name from
--- `buffer` until the next read.  An entry with an empty name is the end
--- of the directory.  Entries come in the system's order, `.` and `..`
--- among them, as POSIX's `readdir` gives them.
public link(symbol: "_landin_posix_read_directory") read_directory:
    (inout opened: directory_stream, buffer: []mut u8)
    -> (item: directory_entry from buffer) ! errno =
    fail einval when lenof buffer < directory_buffer
    item = try system_read_directory(opened, buffer)
end read_directory

--- Close the directory stream and its descriptor, which are released even
--- when this fails.
public link(symbol: "_landin_posix_close_directory") close_directory:
    (opened: directory_stream) -> none ! errno =
    try system_close_directory(opened)
end close_directory

--- Make the directory `path` names, relative to `at`, with the permission
--- bits `permissions`, which the process umask filters: `eexist` when the
--- name is taken, `enoent` when its parent is missing.
public link(symbol: "_landin_posix_make_directory_at") make_directory_at:
    (at: descriptor, path: text.host_string,
     permissions: u32) -> none ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    try system_make_directory(at, terminated, permissions)
end make_directory_at

--- Remove the name `path`, relative to `at`, of a file that is not a
--- directory, POSIX's `unlinkat`.
public link(symbol: "_landin_posix_unlink_at") unlink_at:
    (at: descriptor, path: text.host_string) -> none ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    try system_remove(at, terminated, false)
end unlink_at

--- Remove the empty directory `path` names, relative to `at`, POSIX's
--- `unlinkat` with `AT_REMOVEDIR`: `enotempty` when it holds anything.
public link(symbol: "_landin_posix_remove_directory_at") remove_directory_at:
    (at: descriptor, path: text.host_string)
    -> none ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    try system_remove(at, terminated, true)
end remove_directory_at

--- Map `length` bytes of fresh, zeroed memory that this process alone may
--- read and write, POSIX's anonymous private `mmap`: its first byte, which
--- is aligned to a page, or the errno, `enomem` when the system has no
--- room.
public link(symbol: "_landin_posix_map") map:
    (length: usize) -> (base: ptr mut u8) ! errno =
    base = try system_map(length)
end map

--- Give back the `length` bytes mapped at `base`, POSIX's `munmap`.
public link(symbol: "_landin_posix_unmap") unmap:
    (base: ptr mut u8, length: usize) -> none ! errno =
    try system_unmap(base, length)
end unmap

--- Make the `length` bytes `map` mapped at `base` `new_length` bytes long,
--- at least `length`, where they are: the pages after them must be free,
--- or it fails with `enomem` and the mapping is as it was.  Linux's
--- `mremap` without `MREMAP_MAYMOVE`.  Darwin and FreeBSD have no `mremap`:
--- there the pages after the mapping are asked for, and kept only when the
--- system puts them there.  A shorter `new_length` fails with `einval`;
--- give a mapping's tail back with `unmap`.
public link(symbol: "_landin_posix_extend") extend:
    (base: ptr mut u8, length: usize, new_length: usize) -> none ! errno =
    fail einval when new_length < length
    return when new_length == length
    try system_extend(base, length, new_length)
end extend

--- Make the `length` bytes `map` mapped at `base` `new_length` bytes long,
--- at least `length`, and return where they now are: in place, as `extend`
--- does, or else at an address with room, the pages moved rather than their
--- bytes copied, which is Linux's `mremap` with `MREMAP_MAYMOVE`.  Darwin
--- and FreeBSD cannot move a mapping, so there it is `extend`.  A failure
--- leaves the mapping as it was; a shorter `new_length` fails with
--- `einval`.
public link(symbol: "_landin_posix_remap") remap:
    (base: ptr mut u8, length: usize, new_length: usize)
    -> (moved: ptr mut u8) ! errno =
    fail einval when new_length < length
    moved = ptr(usize(base))
    return when new_length == length
    moved = try system_remap(base, length, new_length)
end remap

--- The size of the system's pages in bytes, which `map` aligns to: 16 KiB
--- on Darwin arm64 and 4 KiB on the others.  On Linux it is what the
--- kernel told a static executable's entry or, under `--link=libc`, what
--- the auxiliary vector after C `main`'s `envp` says, and 4096 when no
--- vector was found.
public link(symbol: "_landin_posix_page_size") page_size:
    () -> (bytes: usize) =
    bytes = system_page_size()
end page_size

--- End the process with `status` at once, POSIX's `_exit`: nothing more
--- of the program runs, and no C stream is flushed.
public link(symbol: "_landin_posix_exit") exit:
    (status: i32) -> noreturn =
    system_exit(status)
end exit

--- The clock that counts steadily from a point the system fixes, its
--- start, and is never set: POSIX's `CLOCK_MONOTONIC`.  Only the
--- difference between two of its readings means anything.
public monotonic_clock: atom
--- The wall clock, UTC seconds and nanoseconds since 1970-01-01 without
--- leap seconds, as the system keeps it, which may be set and so jump
--- either way: POSIX's `CLOCK_REALTIME`.
public realtime_clock: atom
--- Which clock `clock_time` reads: `monotonic_clock` or `realtime_clock`.
public clock_kind: type = monotonic_clock | realtime_clock

--- A time or a span of time, POSIX's `struct timespec`: whole seconds and
--- the nanoseconds after them, from 0 to 999,999,999.
public time_value: type = struct
    seconds: i64
    nanoseconds: u32
end time_value

--- The time the clock `clock` reads now, POSIX's `clock_gettime`, or the
--- errno.  On Linux it is the vDSO's `clock_gettime` when the auxiliary
--- vector names a vDSO that has one, which answers without entering the
--- kernel, under `--link=libc` too, and the system call otherwise; on
--- Darwin and FreeBSD it is the C library's.
public link(symbol: "_landin_posix_clock_time") clock_time:
    (clock: clock_kind) -> (time: time_value) ! errno =
    time = try system_clock_time(clock)
end clock_time

--- Sleep for `span`, POSIX's `nanosleep`, measured on the monotonic clock
--- on Linux and on the system's own clock for sleeping elsewhere: or the
--- errno, `eintr` when a signal came first, which leaves part of the span
--- unslept, and `einval` for nanoseconds of a second or more.  It may
--- return late, never early, of the clock it sleeps on.
public link(symbol: "_landin_posix_sleep") sleep:
    (span: time_value) -> none ! errno =
    fail einval when span.seconds < 0 or span.nanoseconds >= 1000000000
    try system_sleep(span)
end sleep

--- Fill as much of `into` as the system gives at once with random bytes
--- from its own source, which is fit for keys: how many, or the errno.  On
--- Linux it is `getrandom`, which waits while the kernel's pool is not yet
--- ready, only early in boot, may fill a request over 256 bytes short and
--- fails `eintr` when a signal came before any byte.  On Darwin and
--- FreeBSD it is the C library's `arc4random_buf`, which fills all of
--- `into` and never fails.
public link(symbol: "_landin_posix_random_bytes") random_bytes:
    (into: []mut u8) -> (count: usize) ! errno =
    count = 0
    return when lenof into == 0
    count = try system_random_bytes(into)
end random_bytes

events_value: type = distinct u16

--- Poll events, POSIX's `poll` bits as a set: a value combines with `|`,
--- `&` and `~` and compares with `==` and `<>`.  `poll_input`,
--- `poll_output` and `poll_urgent` are what an entry can ask about;
--- `poll_error`, `poll_hung_up` and `poll_invalid` are only ever
--- reported.  The bits are the same on Linux,
--- Darwin and FreeBSD.
public poll_events: type = events_value

--- No event.
public poll_no_events: poll_events = events_value(0)
--- Data to read, or the end of a file.
public poll_input: poll_events = events_value(1)
--- Out-of-band data to read.
public poll_urgent: poll_events = events_value(2)
--- Room to write.
public poll_output: poll_events = events_value(4)
--- An error on the file.
public poll_error: poll_events = events_value(8)
--- The peer has gone.
public poll_hung_up: poll_events = events_value(16)
--- A descriptor that is not open.
public poll_invalid: poll_events = events_value(32)

--  C's `struct pollfd`, the same on all three systems, so a slice of
--  entries is what the system reads and fills: `short` fields, whose bits
--  these are.
poll_record: type = struct
    descriptor: descriptor
    events: poll_events
    returned: poll_events
end poll_record

--- One descriptor for `poll` to watch and the events asked about, made by
--- `watch`, and after the call what happened, which `happened` reads.
public poll_entry: type = poll_record

--- An entry watching `watched` for the events `wanted` asks about; its
--- `poll_error`, `poll_hung_up` and `poll_invalid` are reported whether
--- asked or not.
public link(symbol: "_landin_posix_watch") watch:
    (watched: descriptor, wanted: poll_events)
    -> (entry: poll_entry) =
    asked: poll_events = poll_input | poll_urgent | poll_output
    entry = (descriptor: watched, events: wanted & asked,
             returned: poll_no_events)
end watch

--- What happened to an entry's descriptor in the last `poll`; nothing,
--- before one.
public link(symbol: "_landin_posix_happened") happened:
    (entry: poll_entry) -> (events: poll_events) =
    events = entry.returned
end happened

--- Wait until an event happens to one of `entries`' descriptors, or
--- `milliseconds` pass, waiting indefinitely when it is negative and not
--- at all when it is zero, POSIX's `poll`: how many entries had an event,
--- each of which `happened` reads, zero when the time passed first, or
--- the errno, `eintr` when a signal came first.
public link(symbol: "_landin_posix_poll") poll:
    (entries: []mut poll_entry, milliseconds: i32)
    -> (ready: usize) ! errno =
    ready = try system_poll(entries, milliseconds)
end poll

--  What the argument root holds before it is established, and what C's
--  null pointer is in an argv entry: no table, no string.
no_table: atom
no_string: atom
root_table: type = no_table | ptr ptr u8
argument_string: type = no_string | ptr u8

--  The argument root: C's argv and argc as the process's entry gave them,
--  retained without copying.  The table is the pointer the entry gave,
--  kept in module storage, so what is lent from it outlives every call.
--  Beside it the environment the entry gave, `no_table` for C's null.
mut root_values: root_table = no_table
mut root_count: i32
mut root_environment: root_table = no_table

word: usize = sizeof usize

--- Establish the process's argument root from C's `main` carriers.  The
--- hosted entry calls this with its own `argc`, `argv` and `envp` before
--- its body runs; a C `main` that drives Landin exports calls it itself,
--- with its own or with C's `environ`, before it reads an argument or a
--- variable and before starting a thread that may.
---
--- The first call also ignores SIGPIPE when its disposition is the
--- default, so that a write to a pipe or a socket nobody reads fails with
--- `epipe` rather than ending the process; a handler a C `main` installed
--- first is kept.  `spawn` gives every child the default back.
---
--- The first call needs a nonnegative count and a non-null table, and
--- keeps that exact triple without copying: the caller keeps both tables
--- and their strings readable while any argument or variable lent from
--- them is in use.  A null environment is an empty one.  Repeating the
--- identical triple changes nothing; a negative count, a null argument
--- table or a different triple traps.  The published arguments omit
--- `argv[0]`, so their count is `max(argc - 1, 0)`.
public extern(c) _landin_host_initialize_arguments:
    (count: i32, escaping values: ptr ptr u8,
     escaping environment: ptr ptr u8) -> none =
    --  Every misuse of the root stops at compiler.unreachable(), which a
    --  selected panic handler sees as `unreachable` at that site [1560].
    --  C may pass a null table, which no Landin pointer is, so its address
    --  is what is checked.
    given: usize = usize(values)
    variables: usize = usize(environment)
    held: usize = match root_values
        no_table: usize(0)
        ptr (table): usize(table)
    end match
    if held <> 0 then
        --  An identical repeat changes nothing; another triple would
        --  replace a root that lent arguments may still use.
        kept: usize = match root_environment
            no_table: usize(0)
            ptr (table): usize(table)
        end match
        if count <> root_count or given <> held or variables <> kept then
            compiler.unreachable()
        end if
        return
    end if
    if count < 0 or given == 0 then
        compiler.unreachable()
    end if
    root_count = count
    root_values = values
    --  A write to a pipe or a socket nobody reads is EPIPE, an error the
    --  program answers, rather than SIGPIPE ending the process.
    system_ignore_broken_pipe()
    if variables <> 0 then
        root_environment = environment
        --  On Linux, the auxiliary vector after the initial stack's envp,
        --  when that is where C's runtime found these tables.
        system_adopt_start(count, values, environment)
    end if
end _landin_host_initialize_arguments

--- Whether SIGPIPE is ignored in this process, as
--- `_landin_host_initialize_arguments` makes it when it was the default:
--- a write to a pipe or a socket nobody reads then fails with `epipe`.
public link(symbol: "_landin_posix_broken_pipe_ignored") broken_pipe_ignored:
    () -> (ignored: bool) =
    ignored = system_broken_pipe_ignored()
end broken_pipe_ignored

--- The process's arguments as its entry gave them: argv after `argv[0]`
--- and their count.  `arguments` gives the table, which lends what it
--- points to from storage the process keeps, and `argument` reads it.
public argument_table: type = struct
    values: ptr ptr u8
    count: usize
end argument_table

--- The process's arguments, `argv[0]` not among them.  It traps when no
--- argument root has been established: the hosted entry establishes one
--- before `main` runs, and a C `main` calls
--- `_landin_host_initialize_arguments` itself.
public link(symbol: "_landin_posix_arguments") arguments:
    () -> (table: argument_table) =
    held: ptr ptr u8 = match root_values
        no_table: compiler.unreachable()
        ptr (found): found
    end match
    first: ptr ptr u8 = ptr(usize(held) + word)
    table = (values: first,
             count: if root_count > 0 then usize(root_count - 1)
                    else usize(0) end if)
end arguments

--- The argument `index`, from zero, as a host string lending the
--- process's own storage, which nothing copies.  An index at or past the
--- table's `count` traps, as does a null entry, which C promises none
--- below argc is.
public link(symbol: "_landin_posix_argument") argument:
    (table: argument_table, index: usize)
    -> (value: text.host_string from table) =
    if index >= table.count then
        compiler.unreachable()
    end if
    entry: ptr argument_string = ptr(usize(table.values) + index * word)
    match entry.val
        no_string: compiler.unreachable()
        ptr (data): value = text.host_over(view(data,
                                                terminated_length(data)))
    end match
end argument

--- The program's name as the process's entry gave it, `argv[0]`: what
--- its parent called it, often the path it was started by, as a host
--- string lending the process's own storage.  It is empty when the
--- parent gave no arguments at all, and it traps before the argument root
--- exists, as `arguments` does.
public link(symbol: "_landin_posix_program_name") program_name:
    () -> (name: text.host_string) =
    held: ptr ptr u8 = match root_values
        no_table: compiler.unreachable()
        ptr (found): found
    end match
    name = text.host_over(no_bytes[0..<0])
    return when root_count < 1
    first: ptr argument_string = ptr(usize(held))
    match first.val
        no_string: return
        ptr (data): name = text.host_over(view(data, terminated_length(data)))
    end match
end program_name

no_bytes: [1]u8 = [0]

--- The process's environment as its entry gave it: C's `envp`, null
--- terminated, and the count of its entries before the null, counted when
--- it is asked for.  `variable` reads it.
public environment_table: type = struct
    values: ptr ptr u8
    count: usize
end environment_table

--  The table of an empty environment: one null entry.
empty_environment: [1]usize = [0]

--- The process's environment, read where the entry left it: the initial
--- stack's on a static Linux program, and what the C runtime gave `main`
--- otherwise, each `NAME=value` in the order it was given.  It is counted
--- afresh each time, since C code in the same process may change its own
--- `environ` in place, which this module never does: changing the
--- environment is not safe beside threads, and a child is given the one
--- its parent builds instead.  It traps before the argument root exists,
--- as `arguments` does.
public link(symbol: "_landin_posix_environment") environment:
    () -> (table: environment_table) =
    _ = arguments()
    values: ptr ptr u8 = match root_environment
        no_table: ptr(usize(addr empty_environment[0]))
        ptr (found): found
    end match
    mut count: usize = 0
    loop do
        entry: ptr usize = ptr(usize(values) + count * word)
        break when entry.val == 0
        inc count
    end loop
    table = (values: values, count: count)
end environment

--- The variable at `index`, from zero, of the environment `table`: the
--- bytes of its entry before the first `=` as its name and those after it
--- as its value, host strings lending the process's own storage, which
--- nothing copies.  An entry with no `=` is a name with an empty value.  An
--- index at or past the table's `count` traps, as does a null entry, which
--- a table changed since it was counted may hold.
public link(symbol: "_landin_posix_variable") variable:
    (table: environment_table, index: usize)
    -> (item: io.variable from table) =
    if index >= table.count then
        compiler.unreachable()
    end if
    entry: ptr argument_string = ptr(usize(table.values) + index * word)
    match entry.val
        no_string: compiler.unreachable()
        ptr (data): begin
            whole: []u8 = view(data, terminated_length(data))
            at: usize = mem.find(whole, 61)
            value: []u8 = if at < lenof whole then whole[at + 1..<lenof whole]
                          else whole[lenof whole..<lenof whole] end if
            item = (name: text.host_over(whole[0..<at]),
                    value: text.host_over(value))
        end
    end match
end variable

--- The two ends of a pipe: what is written to `writing` is read from
--- `reading`.
public pipe_ends: type = struct
    reading: descriptor
    writing: descriptor
end pipe_ends

--- Make a pipe, POSIX's `pipe`: its two ends, each closed when the process
--- executes a program, which Linux and FreeBSD set as the pipe is made,
--- with `pipe2`, and Darwin, which has none, just after; or the errno,
--- `emfile` when the process has no descriptor to spare.  A pipe holds 64
--- KiB on Linux and between 16 and 64 KiB on Darwin and FreeBSD, and a
--- write to a full one waits until its reader reads.
public link(symbol: "_landin_posix_pipe") pipe:
    () -> (ends: pipe_ends) ! errno =
    ends = try system_pipe()
end pipe

--- Whether `opened` is closed when the process executes a program, its
--- `FD_CLOEXEC` flag, as every descriptor this module makes is: or the
--- errno, `ebadf` for a descriptor that is not open.
public link(symbol: "_landin_posix_closed_on_exec") closed_on_exec:
    (opened: descriptor) -> (yes: bool) ! errno =
    yes = try system_closed_on_exec(opened)
end closed_on_exec

process_value: type = distinct i32

--- A child process's ID, as `spawn` gives it and `wait` takes it: a
--- handle, not a number to count with.
public process_id: type = process_value

--- The descriptors a child's standard input, output and error are made
--- from: each is duplicated onto the child's descriptor 0, 1 or 2, and one
--- that already is that number is the parent's own stream, inherited as it
--- is.
public standard_streams: type = struct
    input: descriptor
    output: descriptor
    errors: descriptor
end standard_streams

--- The parent's own three standard streams, inherited.
public inherited_streams: standard_streams = (input: standard_input,
                                              output: standard_output,
                                              errors: standard_error)

--- Start the program at `path` in a child process, POSIX's `posix_spawn`:
--- the program is given `path` as its name, `argv[0]`, then `arguments`,
--- and exactly the variables of `environment`, each as `NAME=value`, and
--- its standard streams are `streams`.  Nothing searches a path for the
--- program and no shell reads anything.  Every other descriptor is closed
--- in the child, so it receives no file but its three streams.  The
--- child's ID, or the errno, with no child started: `enoent` for a missing
--- program, `eacces` for one that may not be executed, `enoexec` for one
--- that is no program, `einval` for an argument or a value holding a NUL
--- or a name that is empty or holds `=` or a NUL, and `e2big` for more than
--- the system takes.  A child must be waited for, with `wait`, or it keeps
--- its place in the system's table until this process ends.
---
--- The child starts with SIGPIPE's default disposition, whatever this
--- process's is: this process ignores it, which an exec would otherwise
--- pass on.
---
--- On Linux it is a `clone` that copies this process, as `fork` does,
--- which in the child moves the streams into place, gives SIGPIPE its
--- default and executes the program, and reports a failure to the parent
--- through a pipe closed on exec; on Darwin and FreeBSD it is the C
--- library's `posix_spawn`, told to reset SIGPIPE with
--- `posix_spawnattr_setsigdefault`.  The
--- block of strings and tables the child is given is mapped for the call
--- and unmapped after it.
public link(symbol: "_landin_posix_spawn") spawn:
    (path: text.host_string, arguments: []text.host_string,
     environment: []io.variable, streams: standard_streams)
    -> (child: process_id) ! errno =
    mut room: path_room = zeroed
    terminated: ptr u8 = try terminate(path, room[0..<lenof room])
    named: []u8 = text.host_bytes(path)
    --  The tables first, so each pointer is aligned, then every string
    --  with its NUL: the name, the arguments, and each variable as
    --  `NAME=value`.
    entries: usize = (lenof arguments + 2) + (lenof environment + 1)
    mut size: usize = entries * word + lenof named + 1
    for argument in arguments do
        bytes: []u8 = text.host_bytes(argument)
        fail einval when mem.find(bytes, 0) < lenof bytes
        size += lenof bytes + 1
    end for
    for item in environment do
        name: []u8 = text.host_bytes(item.name)
        value: []u8 = text.host_bytes(item.value)
        fail einval when lenof name == 0 or mem.find(name, 61) < lenof name
          or mem.find(name, 0) < lenof name or mem.find(value, 0) < lenof value
        size += lenof name + lenof value + 2
    end for
    block: ptr mut u8 = try map(size)
    defer release(block, size)
    whole: []mut u8 = writable_view(block, size)
    mut table: usize = usize(block)
    mut at: usize = entries * word
    at = place(whole, at, table, named)
    table += word
    for argument in arguments do
        at = place(whole, at, table, text.host_bytes(argument))
        table += word
    end for
    table += word
    variables: usize = table
    for item in environment do
        start: usize = at
        at = place(whole, at, table, text.host_bytes(item.name))
        --  The name's NUL becomes the `=`, and the value follows it.
        whole[at - 1] = 61
        at = place(whole, at, table, text.host_bytes(item.value))
        slot: ptr mut usize = ptr(table)
        slot.val = usize(block) + start
        table += word
    end for
    (result: input, made: made_input) :=
        try lifted(streams.input, standard_input)
    defer forget(input, made_input)
    (result: output, made: made_output) :=
        try lifted(streams.output, standard_output)
    defer forget(output, made_output)
    (result: errors, made: made_errors) :=
        try lifted(streams.errors, standard_error)
    defer forget(errors, made_errors)
    named_table: ptr ptr u8 = ptr(usize(block))
    variable_table: ptr ptr u8 = ptr(variables)
    child = try system_spawn(terminated, named_table, variable_table,
                             (input: input, output: output, errors: errors))
end spawn

--  Copy BYTES to WHOLE at AT with a NUL after them, which the mapping
--  already is, and put their address in the table slot at TABLE: where the
--  next string goes.
place: (whole: []mut u8, at: usize, table: usize, bytes: []u8)
       -> (next: usize) =
    next = at + lenof bytes + 1
    mem.copy(whole[at..<at + lenof bytes], bytes) else (problem)
        _ = problem
        compiler.unreachable()
    end
    slot: ptr mut usize = ptr(table)
    slot.val = usize(addr whole[0]) + at
end place

--  Give a mapping back, whatever the system says.
release: (block: ptr mut u8, size: usize) -> none =
    unmap(block, size) else (problem)
        _ = problem
    end
end release

--  A stream for the child that is below 3 and not its own number would be
--  overwritten by another stream moved into place before it is read, so
--  it is duplicated above 2 for the call, and the duplicate closed after.
lifted: (source: descriptor, target: descriptor)
        -> (result: descriptor, made: bool) ! errno =
    result = source
    made = false
    return when source == target or i32(source) >= 3 or i32(source) < 0
    result = try system_duplicate_above(source, 3)
    made = true
end lifted

forget: (made_from: descriptor, made: bool) -> none =
    return when not made
    close(made_from) else (problem)
        _ = problem
    end
end forget

--- How a child ended, as `wait` reports it: it `exited` with the code its
--- program gave `_exit` or returned from `main`, of which the parent sees
--- the low eight bits, or it was `signalled`, ended by the signal of
--- that number, a number each system gives its signals: SIGKILL is 9
--- and SIGTERM 15 on all three, SIGUSR1 10 on Linux and 30 on Darwin and
--- FreeBSD.
public child_status: type = struct
    how: variant
        exited: (code: i32) |
        signalled: (signal: i32)
    end how
end child_status

--- Wait for the child `child` to end and report how it did, POSIX's
--- `waitpid`, after which it is gone: or the errno, `echild` for no child
--- of this process, `eintr` when a signal came first and the child is
--- still to be waited for.
public link(symbol: "_landin_posix_wait") wait:
    (child: process_id) -> (status: child_status) ! errno =
    word: i32 = try system_wait(child)
    --  The status word is the same on all three systems: the low seven
    --  bits are the signal that ended the child, zero when it exited, and
    --  the next eight its code.
    ending: i32 = word & 127
    status = if ending == 0 then (how: exited(code: (word >> 8) & 255))
             else (how: signalled(signal: ending)) end if
end wait

--  The `length` bytes at `first`, writable, which this module mapped.
writable_view: (first: ptr mut u8, length: usize)
               -> (bytes: []mut u8 from first) =
    whole: ptr mut [1]u8 = ptr(usize(first))
    bytes = whole.val[0..<0]
    if length > 0 then
        unchecked begin
            bytes = whole.val[0..<length]
        end unchecked
    end if
end writable_view

--  The bytes before the first NUL at `first`.
terminated_length: (first: ptr u8) -> (length: usize) =
    length = 0
    loop do
        at: ptr u8 = ptr(usize(first) + length)
        break when at.val == 0
        inc length
    end loop
end terminated_length

--  The `length` bytes at `first`, which the system or the process owns and
--  keeps readable.
view: (first: ptr u8, length: usize) -> (bytes: []u8 from first) =
    whole: ptr [1]u8 = ptr(usize(first))
    bytes = whole.val[0..<0]
    if length > 0 then
        unchecked begin
            bytes = whole.val[0..<length]
        end unchecked
    end if
end view

--  Copy PATH into ROOM with a NUL after it, for a call that takes a C
--  path: `enametoolong` when it and its NUL do not fit, before anything
--  is copied, and `einval` when it holds a NUL.
terminate: (path: text.host_string, room: []mut u8)
           -> (terminated: ptr u8 from room) ! errno =
    bytes: []u8 = text.host_bytes(path)
    fail enametoolong when lenof bytes >= lenof room
    for at in usize(0)..<lenof bytes do
        fail einval when bytes[at] == 0
        room[at] = bytes[at]
    end for
    room[lenof bytes] = 0
    terminated = addr room[0]
end terminate

--  What a mode's type bits, the same on all three systems, say a file is.
kind_of_mode: (mode: u32) -> (kind: file_kind) =
    bits: u32 = mode & 0o170000
    kind = if bits == 0o100000 then regular
           elsif bits == 0o040000 then directory
           elsif bits == 0o120000 then symbolic_link
           elsif bits == 0o010000 then fifo
           elsif bits == 0o140000 then socket_file
           elsif bits == 0o020000 then character_device
           elsif bits == 0o060000 then block_device
           else unknown_kind end if
end kind_of_mode

--  What a directory record's `d_type`, the same on all three systems, says
--  an entry is; DT_UNKNOWN and BSD's whiteout are `unknown_kind`.
kind_of_type: (type_byte: u8) -> (kind: file_kind) =
    kind = if type_byte == 8 then regular
           elsif type_byte == 4 then directory
           elsif type_byte == 10 then symbolic_link
           elsif type_byte == 1 then fifo
           elsif type_byte == 12 then socket_file
           elsif type_byte == 2 then character_device
           elsif type_byte == 6 then block_device
           else unknown_kind end if
end kind_of_type
