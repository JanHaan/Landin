--  platform/posix on Darwin and FreeBSD, over platform/libc: their C
--  library is their system interface.  A failing call's errno is read
--  from the calling thread's own cell immediately after it, before any
--  other call, and becomes the atom the call fails with, so no number is
--  shared between threads.  A path relative to the working directory goes
--  to `open` and `stat`, and only a path relative to an open directory to
--  `openat` and `fstatat`, so a program interposing on the C library meets
--  the calls it always has.

import core/text
import platform/libc

fixed if compiler.os == darwin or compiler.os == freebsd then
    --- The working directory as the directory an `*_at` call's relative
    --- path is relative to: C's `AT_FDCWD`, which is no open file.
    public working_directory: descriptor = descriptor_value(libc.at_fdcwd)

    --  The errno the calling thread's last failing call left, as an atom.
    failure: () -> (problem: errno) =
        cell: ptr mut i32 = libc.errno_cell()
        problem = errno_of(cell.val)
    end failure

    --  The flags `open` takes for `options`.
    flags_of: (options: open_options) -> (flags: i32) =
        flags = match options.access
            read_only: libc.o_rdonly
            write_only: libc.o_wronly
            read_write: libc.o_rdwr
        end match
        if options.create then flags = flags | libc.o_creat end if
        if options.exclusive then flags = flags | libc.o_excl end if
        if options.truncate then flags = flags | libc.o_trunc end if
        if options.append then flags = flags | libc.o_append end if
        if options.directory then flags = flags | libc.o_directory end if
        flags = flags | libc.o_cloexec | libc.o_noctty
    end flags_of

    --  `open`, or `openat` relative to an open directory, with the
    --  permission bits as the one variadic argument only when creating.
    opened_at: (at: descriptor, path: ptr u8, flags: i32, permissions: u32)
               -> (result: i32) =
        if at == working_directory then
            result = if (flags & libc.o_creat) <> 0
            then libc.open(path, flags, i32(permissions))
            else libc.open(path, flags) end if
        else
            result = if (flags & libc.o_creat) <> 0
            then libc.openat(i32(at), path, flags, i32(permissions))
            else libc.openat(i32(at), path, flags) end if
        end if
    end opened_at

    system_open: (at: descriptor, path: ptr u8, options: open_options,
                  permissions: u32) -> (opened: descriptor) ! errno =
        result: i32 = opened_at(at, path, flags_of(options), permissions)
        fail failure() when result < 0
        opened = descriptor(result)
    end system_open

    system_read: (source: descriptor, into: []mut u8)
                 -> (count: usize) ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = libc.read(i32(source), base, lenof into)
        fail failure() when result < 0
        count = usize(result)
    end system_read

    system_write: (to: descriptor, bytes: []u8) -> (count: usize) ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = libc.write(i32(to), base, lenof bytes)
        fail failure() when result < 0
        count = usize(result)
    end system_write

    system_close: (closing: descriptor) -> none ! errno =
        fail failure() when libc.close(i32(closing)) <> 0
    end system_close

    --  A C `timespec` as POSIX's time value; one the system could not
    --  have given reads as zero nanoseconds rather than trapping.
    time_of: (stamp: libc.timespec) -> (time: time_value) =
        kept: bool = stamp.nanoseconds >= 0
                     and stamp.nanoseconds < 1000000000
        part: u32 = if kept then u32(stamp.nanoseconds) else 0 end if
        time = (seconds: stamp.seconds, nanoseconds: part)
    end time_of

    status_of_record: (record: libc.file_status) -> (result: status) =
        result = (device: u64(record.device), inode: u64(record.inode),
                  kind: kind_of_mode(u32(record.mode)),
                  size: u64(record.bytes),
                  permissions: u32(record.mode) & 0o7777,
                  links: u64(record.links), user: user_id(record.uid),
                  group: group_id(record.gid),
                  accessed: time_of(record.accessed),
                  modified: time_of(record.modified),
                  changed: time_of(record.changed))
    end status_of_record

    --  The record is checked against the native header's size before it
    --  is used, as abi/core-io-file-identity holds it to that header: a
    --  disagreement is `unlisted`, which no errno describes.
    system_status: (at: descriptor, path: ptr u8, follow: bool)
                   -> (result: status) ! errno =
        fail unlisted when alignof libc.file_status <> 8
          or sizeof libc.file_status <> libc.file_status_size
        mut record: libc.file_status = zeroed
        outcome: i32 =
            if at == working_directory and follow
            then libc.stat(path, addr record)
            else libc.fstatat(i32(at), path, addr record,
                              if follow then 0
                              else libc.at_symlink_nofollow end if) end if
        fail failure() when outcome <> 0
        result = status_of_record(record)
    end system_status

    system_status_of: (opened: descriptor) -> (result: status) ! errno =
        fail unlisted when alignof libc.file_status <> 8
          or sizeof libc.file_status <> libc.file_status_size
        mut record: libc.file_status = zeroed
        fail failure() when libc.fstat(i32(opened), addr record) <> 0
        result = status_of_record(record)
    end system_status_of

    --  The directory is opened with o_directory, which makes anything else
    --  ENOTDIR, and a C directory stream made over it, which then owns the
    --  descriptor.
    system_open_directory: (at: descriptor, path: ptr u8)
                           -> (opened: directory_stream) ! errno =
        result: i32 = opened_at(at, path,
                                libc.o_rdonly | libc.o_directory
                                | libc.o_cloexec, 0)
        fail failure() when result < 0
        made: libc.directory_stream = libc.fdopendir(result)
        match made
            libc.no_directory: begin
                problem: errno = failure()
                _ = libc.close(result)
                fail problem
            end
            ptr (stream): opened = (descriptor: descriptor(result),
                                    stream: usize(stream), filled: 0,
                                    cursor: 0, finished: false)
        end match
    end system_open_directory

    --  The stream's next record, its name copied into the buffer with a
    --  NUL after it, since the record is the C library's and good only
    --  until the next readdir.  The buffer holds any name a record can:
    --  `directory_buffer` is larger than every d_name.  readdir's end and
    --  its failure are told apart by errno, zeroed before the call.
    system_read_directory: (inout opened: directory_stream, buffer: []mut u8)
                           -> (item: directory_entry from buffer) ! errno =
        cell: ptr mut i32 = libc.errno_cell()
        cell.val = 0
        if opened.finished then
            item = (name: text.host_over(buffer[0..<0]), kind: unknown_kind)
            return
        end if
        stream: ptr mut u8 = ptr(opened.stream)
        record: libc.directory_entry = libc.readdir(stream)
        match record
            libc.no_directory: begin
                fail errno_of(cell.val) when cell.val <> 0
                opened.finished = true
                item = (name: text.host_over(buffer[0..<0]),
                        kind: unknown_kind)
            end
            ptr (found): begin
                length: usize = usize(found.val.name_length)
                fail unlisted when length >= lenof buffer
                for at in usize(0)..<length do
                    buffer[at] = found.val.name[at]
                end for
                buffer[length] = 0
                item = (name: text.host_over(buffer[0..<length]),
                        kind: kind_of_type(found.val.kind))
            end
        end match
    end system_read_directory

    system_close_directory: (opened: directory_stream) -> none ! errno =
        stream: ptr mut u8 = ptr(opened.stream)
        fail failure() when libc.closedir(stream) <> 0
    end system_close_directory

    system_make_directory: (at: descriptor, path: ptr u8, permissions: u32)
                           -> none ! errno =
        fail failure() when libc.mkdirat(i32(at), path, u16(permissions)) <> 0
    end system_make_directory

    system_remove: (at: descriptor, path: ptr u8, directory: bool)
                   -> none ! errno =
        flags: i32 = if directory then libc.at_removedir else 0 end if
        fail failure() when libc.unlinkat(i32(at), path, flags) <> 0
    end system_remove

    system_map: (length: usize) -> (base: ptr mut u8) ! errno =
        result: usize = libc.mmap(0, length, libc.prot_read | libc.prot_write,
                                  libc.map_private | libc.map_anonymous, -1,
                                  0)
        fail failure() when result == libc.map_failed
        base = ptr(result)
    end system_map

    system_unmap: (base: ptr mut u8, length: usize) -> none ! errno =
        fail failure() when libc.munmap(usize(base), length) <> 0
    end system_unmap

    --  The pages after the mapping, asked for at its end without
    --  `MAP_FIXED`, which would replace whatever is mapped there: a system
    --  that puts them elsewhere has none free there, and they are given
    --  back.
    system_extend: (base: ptr mut u8, length: usize, new_length: usize)
                   -> none ! errno =
        wanted: usize = usize(base) + length
        extra: usize = new_length - length
        result: usize = libc.mmap(wanted, extra,
                                  libc.prot_read | libc.prot_write,
                                  libc.map_private | libc.map_anonymous, -1,
                                  0)
        fail failure() when result == libc.map_failed
        if result <> wanted then
            _ = libc.munmap(result, extra)
            fail enomem
        end if
    end system_extend

    --  A mapping cannot move here, so it grows where it is or not at all.
    system_remap: (base: ptr mut u8, length: usize, new_length: usize)
                  -> (moved: ptr mut u8) ! errno =
        try system_extend(base, length, new_length)
        moved = ptr(usize(base))
    end system_remap

    system_page_size: () -> (bytes: usize) =
        bytes = usize(libc.getpagesize())
    end system_page_size

    system_exit: (status: i32) -> noreturn =
        libc._exit(status)
    end system_exit

    system_poll: (entries: []mut poll_entry, milliseconds: i32)
                 -> (ready: usize) ! errno =
        mut spare: libc.poll_record = zeroed
        records: ptr mut libc.poll_record =
            if lenof entries > 0 then ptr(usize(addr entries[0]))
            else addr spare end if
        result: i32 = libc.poll(records, libc.poll_count(lenof entries),
                                milliseconds)
        fail failure() when result < 0
        ready = usize(result)
    end system_poll

    fixed if compiler.os == darwin then
        --  Darwin has no pipe2, so each end is marked closed on exec just
        --  after the pipe is made.  A program another thread executes in
        --  between could inherit the pair; `spawn` closes every descriptor
        --  it does not give the child either way.
        system_pipe: () -> (ends: pipe_ends) ! errno =
            mut made: [2]i32 = zeroed
            fail failure() when libc.pipe(addr made[0]) <> 0
            if libc.fcntl(made[0], libc.f_setfd, libc.fd_cloexec) <> 0
              or libc.fcntl(made[1], libc.f_setfd, libc.fd_cloexec) <> 0
            then
                problem: errno = failure()
                _ = libc.close(made[0])
                _ = libc.close(made[1])
                fail problem
            end if
            ends = (reading: descriptor(made[0]),
                    writing: descriptor(made[1]))
        end system_pipe
    else
        system_pipe: () -> (ends: pipe_ends) ! errno =
            mut made: [2]i32 = zeroed
            fail failure() when libc.pipe2(addr made[0], libc.o_cloexec) <> 0
            ends = (reading: descriptor(made[0]),
                    writing: descriptor(made[1]))
        end system_pipe
    end if

    system_closed_on_exec: (opened: descriptor) -> (yes: bool) ! errno =
        flags: i32 = libc.fcntl(i32(opened), libc.f_getfd)
        fail failure() when flags < 0
        yes = (flags & libc.fd_cloexec) <> 0
    end system_closed_on_exec

    system_duplicate_above: (source: descriptor, lowest: i32)
                            -> (result: descriptor) ! errno =
        made: i32 = libc.fcntl(i32(source), libc.f_dupfd_cloexec, lowest)
        fail failure() when made < 0
        result = descriptor(made)
    end system_duplicate_above

    --  The actions that make the child's streams: each stream that is not
    --  already its number is duplicated onto it.  Darwin closes every
    --  other descriptor through its own spawn flag, under which a stream
    --  kept as it is must be named; FreeBSD closes every descriptor from 3
    --  up as the last action.
    fixed if compiler.os == darwin then
        stream_action: (actions: ptr mut libc.spawn_object,
                        source: descriptor, target: i32) -> (error: i32) =
            error = if i32(source) == target
            then libc.posix_spawn_file_actions_addinherit_np(
                actions, target)
            else libc.posix_spawn_file_actions_adddup2(
                actions, i32(source), target) end if
        end stream_action

        last_actions: (actions: ptr mut libc.spawn_object,
                       attributes: ptr mut libc.spawn_object)
                      -> (error: i32) =
            _ = actions
            _ = attributes
            error = 0
        end last_actions

        --  Every descriptor the actions do not name is closed, and the
        --  signals the attributes name start at their default.
        spawn_flags: i16 = libc.posix_spawn_cloexec_default
                           | libc.posix_spawn_setsigdef
    else
        stream_action: (actions: ptr mut libc.spawn_object,
                        source: descriptor, target: i32) -> (error: i32) =
            error = 0
            return when i32(source) == target
            error = libc.posix_spawn_file_actions_adddup2(actions,
                                                          i32(source),
                                                          target)
        end stream_action

        last_actions: (actions: ptr mut libc.spawn_object,
                       attributes: ptr mut libc.spawn_object)
                      -> (error: i32) =
            _ = attributes
            error = libc.posix_spawn_file_actions_addclosefrom_np(actions, 3)
        end last_actions

        --  The signals the attributes name start at their default.
        spawn_flags: i16 = libc.posix_spawn_setsigdef
    end if

    --  The parent ignores SIGPIPE, which an exec keeps, so the child is
    --  told to start with its default, as a program expects to: SIGPIPE,
    --  13, is the set's bit 12 on both systems.
    signal_defaults: (attributes: ptr mut libc.spawn_object)
                     -> (error: i32) =
        mut signals: libc.signal_set = zeroed
        signals.bits[0] = u32(1) << u32(libc.sigpipe - 1)
        error = libc.posix_spawnattr_setsigdefault(attributes, addr signals)
        if error == 0 then
            error = libc.posix_spawnattr_setflags(attributes, spawn_flags)
        end if
    end signal_defaults

    --  posix_spawn reports its failure as its result rather than in errno.
    spawn_with: (path: ptr u8, arguments: ptr ptr u8,
                 environment: ptr ptr u8, streams: standard_streams,
                 actions: ptr mut libc.spawn_object,
                 attributes: ptr mut libc.spawn_object)
                -> (child: process_id) ! errno =
        mut error: i32 = stream_action(actions, streams.input, 0)
        if error == 0 then
            error = stream_action(actions, streams.output, 1)
        end if
        if error == 0 then
            error = stream_action(actions, streams.errors, 2)
        end if
        if error == 0 then error = last_actions(actions, attributes) end if
        if error == 0 then error = signal_defaults(attributes) end if
        fail errno_of(error) when error <> 0
        mut made: i32 = 0
        error = libc.posix_spawn(addr made, path, actions, attributes,
                                 arguments, environment)
        fail errno_of(error) when error <> 0
        child = process_id(made)
    end spawn_with

    system_spawn: (path: ptr u8, arguments: ptr ptr u8,
                   environment: ptr ptr u8, streams: standard_streams)
                  -> (child: process_id) ! errno =
        mut actions: libc.spawn_object = 0
        mut attributes: libc.spawn_object = 0
        error: i32 = libc.posix_spawn_file_actions_init(addr actions)
        fail errno_of(error) when error <> 0
        given: i32 = libc.posix_spawnattr_init(addr attributes)
        if given <> 0 then
            _ = libc.posix_spawn_file_actions_destroy(addr actions)
            fail errno_of(given)
        end if
        child = spawn_with(path, arguments, environment, streams,
                           addr actions, addr attributes) else (problem)
            _ = libc.posix_spawnattr_destroy(addr attributes)
            _ = libc.posix_spawn_file_actions_destroy(addr actions)
            fail problem
        end
        _ = libc.posix_spawnattr_destroy(addr attributes)
        _ = libc.posix_spawn_file_actions_destroy(addr actions)
    end system_spawn

    --  Darwin and FreeBSD keep no auxiliary vector here to adopt.
    system_adopt_start: (count: i32, values: ptr ptr u8,
                         environment: ptr ptr u8) -> none =
        _ = count
        _ = values
        _ = environment
    end system_adopt_start

    system_clock_time: (clock: clock_kind) -> (time: time_value) ! errno =
        number: i32 = match clock
            monotonic_clock: libc.clock_monotonic
            realtime_clock: libc.clock_realtime
        end match
        mut record: libc.timespec = zeroed
        fail failure() when libc.clock_gettime(number, addr record) <> 0
        fail unlisted when record.nanoseconds < 0
          or record.nanoseconds >= 1000000000
        time = (seconds: record.seconds, nanoseconds: u32(record.nanoseconds))
    end system_clock_time

    system_sleep: (span: time_value) -> none ! errno =
        request: libc.timespec = (seconds: span.seconds,
                                  nanoseconds: i64(span.nanoseconds))
        mut remaining: libc.timespec = zeroed
        fail failure() when libc.nanosleep(addr request, addr remaining) <> 0
    end system_sleep

    system_random_bytes: (into: []mut u8) -> (count: usize) ! errno =
        libc.arc4random_buf(addr into[0], lenof into)
        count = lenof into
    end system_random_bytes

    --  SIGPIPE's disposition, the process's own: ignored when it was the
    --  default, so that a write to a pipe or a socket nobody reads fails
    --  with EPIPE rather than ending the process; a handler a C `main`
    --  installed, and an ignore the process was started with, are kept.
    system_ignore_broken_pipe: () -> none =
        mut previous: libc.signal_action = zeroed
        return when libc.sigaction(libc.sigpipe, libc.no_address,
                                   addr previous) <> 0
        return when previous.handler <> libc.sig_dfl
        mut ignoring: libc.signal_action = zeroed
        ignoring.handler = libc.sig_ign
        _ = libc.sigaction(libc.sigpipe, addr ignoring, libc.no_address)
    end system_ignore_broken_pipe

    --  Whether SIGPIPE is ignored, for a program to ask.
    system_broken_pipe_ignored: () -> (ignored: bool) =
        mut previous: libc.signal_action = zeroed
        ignored = libc.sigaction(libc.sigpipe, libc.no_address,
                                 addr previous) == 0
                  and previous.handler == libc.sig_ign
    end system_broken_pipe_ignored

    system_family_number: (family: socket_family) -> (number: i32) =
        number = match family
            internet: libc.af_inet
            internet6: libc.af_inet6
            local: libc.af_unix
        end match
    end system_family_number

    kind_number: (kind: socket_kind) -> (number: i32) =
        number = match kind
            stream: libc.sock_stream
            datagram: libc.sock_dgram
        end match
    end kind_number

    --  A socket of this module's raises no SIGPIPE, whatever its
    --  disposition: SO_NOSIGPIPE, which both systems keep on the socket,
    --  covers a `write` to it as well as a `send`.
    quiet: (made: i32) -> none ! errno =
        on: i32 = 1
        given: ptr u8 = ptr(usize(addr on))
        fail failure() when libc.setsockopt(made, libc.sol_socket,
                                            libc.so_nosigpipe, given, 4) <> 0
    end quiet

    --  Darwin and FreeBSD do not limit `accept` by the receive limit, as
    --  Linux does, so the wait for a connection is limited here: a poll
    --  for one for as long as the limit, `eagain` when none came.
    limit_waited: (listener: descriptor) -> none ! errno =
        limit: time_value = try system_get_time(listener, receive_limit)
        return when limit.seconds == 0 and limit.nanoseconds == 0
        milliseconds: i64 = limit.seconds * 1000
                            + i64((limit.nanoseconds + 999999) / 1000000)
        bounded: i32 = if milliseconds > 2147483647 then 2147483647
                       else i32(milliseconds) end if
        mut entries: [1]poll_entry = [watch(listener, poll_input)]
        found: usize = try system_poll(entries[0..<1], bounded)
        fail eagain when found == 0
    end limit_waited

    fixed if compiler.os == darwin then
        --  Darwin has no SOCK_CLOEXEC, so the flag is set just after the
        --  socket is made, as a pipe's is: a program another thread
        --  executes in between could inherit it, and `spawn` closes every
        --  descriptor it does not give the child either way.
        kept: (made: i32) -> none ! errno =
            if libc.fcntl(made, libc.f_setfd, libc.fd_cloexec) <> 0 then
                problem: errno = failure()
                _ = libc.close(made)
                fail problem
            end if
            quiet(made) else (problem)
                _ = libc.close(made)
                fail problem
            end
        end kept

        system_socket: (family: socket_family, kind: socket_kind)
                       -> (made: descriptor) ! errno =
            result: i32 = libc.socket(system_family_number(family),
                                      kind_number(kind), 0)
            fail failure() when result < 0
            try kept(result)
            made = descriptor(result)
        end system_socket

        system_socket_pair: (kind: socket_kind) -> (ends: connected_pair)
                            ! errno =
            mut made: [2]i32 = zeroed
            fail failure() when libc.socketpair(libc.af_unix,
                                                kind_number(kind), 0,
                                                addr made[0]) <> 0
            kept(made[0]) else (problem)
                _ = libc.close(made[1])
                fail problem
            end
            kept(made[1]) else (problem)
                _ = libc.close(made[0])
                fail problem
            end
            ends = (first: descriptor(made[0]), second: descriptor(made[1]))
        end system_socket_pair

        system_accept: (listener: descriptor) -> (accepted: descriptor)
                       ! errno =
            try limit_waited(listener)
            result: i32 = libc.accept(i32(listener), libc.no_address,
                                      libc.no_address)
            fail failure() when result < 0
            try kept(result)
            accepted = descriptor(result)
        end system_accept

        --  Darwin has no MSG_NOSIGNAL; SO_NOSIGPIPE stands in for it.
        send_flags: i32 = 0
    else
        --  Close a socket just made when it cannot be quietened.
        quieted: (made: i32) -> none ! errno =
            quiet(made) else (problem)
                _ = libc.close(made)
                fail problem
            end
        end quieted

        system_socket: (family: socket_family, kind: socket_kind)
                       -> (made: descriptor) ! errno =
            result: i32 = libc.socket(system_family_number(family),
                                      kind_number(kind) | libc.sock_cloexec,
                                      0)
            fail failure() when result < 0
            try quieted(result)
            made = descriptor(result)
        end system_socket

        system_socket_pair: (kind: socket_kind) -> (ends: connected_pair)
                            ! errno =
            mut made: [2]i32 = zeroed
            fail failure() when libc.socketpair(
                libc.af_unix, kind_number(kind) | libc.sock_cloexec, 0,
                addr made[0]) <> 0
            quieted(made[0]) else (problem)
                _ = libc.close(made[1])
                fail problem
            end
            quieted(made[1]) else (problem)
                _ = libc.close(made[0])
                fail problem
            end
            ends = (first: descriptor(made[0]), second: descriptor(made[1]))
        end system_socket_pair

        system_accept: (listener: descriptor) -> (accepted: descriptor)
                       ! errno =
            try limit_waited(listener)
            result: i32 = libc.accept4(i32(listener), libc.no_address,
                                       libc.no_address, libc.sock_cloexec)
            fail failure() when result < 0
            try quieted(result)
            accepted = descriptor(result)
        end system_accept

        --  MSG_NOSIGNAL beside SO_NOSIGPIPE, for a socket this module did
        --  not make.
        send_flags: i32 = libc.msg_nosignal
    end if

    system_bind: (socket: descriptor, address: ptr u8, length: u32)
                 -> none ! errno =
        fail failure() when libc.bind(i32(socket), address, length) <> 0
    end system_bind

    system_listen: (socket: descriptor, backlog: i32) -> none ! errno =
        fail failure() when libc.listen(i32(socket), backlog) <> 0
    end system_listen

    system_connect: (socket: descriptor, address: ptr u8, length: u32)
                    -> none ! errno =
        fail failure() when libc.connect(i32(socket), address, length) <> 0
    end system_connect

    system_send: (socket: descriptor, bytes: []u8) -> (count: usize)
                 ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = libc.send(i32(socket), base, lenof bytes,
                                  send_flags)
        fail failure() when result < 0
        count = usize(result)
    end system_send

    system_receive: (socket: descriptor, into: []mut u8) -> (count: usize)
                    ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = libc.recv(i32(socket), base, lenof into, 0)
        fail failure() when result < 0
        count = usize(result)
    end system_receive

    system_send_to: (socket: descriptor, bytes: []u8, address: ptr u8,
                     length: u32) -> (count: usize) ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = libc.sendto(i32(socket), base, lenof bytes,
                                    send_flags, address, length)
        fail failure() when result < 0
        count = usize(result)
    end system_send_to

    system_receive_from: (socket: descriptor, into: []mut u8,
                          address: ptr mut u8, length: ptr mut u32)
                         -> (count: usize) ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = libc.recvfrom(i32(socket), base, lenof into, 0,
                                      address, length)
        fail failure() when result < 0
        count = usize(result)
    end system_receive_from

    system_shutdown: (socket: descriptor, how: i32) -> none ! errno =
        fail failure() when libc.shutdown(i32(socket), how) <> 0
    end system_shutdown

    system_socket_name: (socket: descriptor, address: ptr mut u8,
                         length: ptr mut u32) -> none ! errno =
        fail failure() when libc.getsockname(i32(socket), address,
                                             length) <> 0
    end system_socket_name

    system_peer_name: (socket: descriptor, address: ptr mut u8,
                       length: ptr mut u32) -> none ! errno =
        fail failure() when libc.getpeername(i32(socket), address,
                                             length) <> 0
    end system_peer_name

    --  An option's level and name.
    option_of: (option: socket_option) -> (level: i32, name: i32) =
        level = libc.sol_socket
        name = match option
            reuse_address: libc.so_reuseaddr
            no_delay: libc.tcp_nodelay
            ipv6_only: libc.ipv6_v6only
            receive_limit: libc.so_rcvtimeo
            send_limit: libc.so_sndtimeo
            pending: libc.so_error
        end match
        if option == no_delay then level = libc.ipproto_tcp end if
        if option == ipv6_only then level = libc.ipproto_ipv6 end if
    end option_of

    system_set_number: (socket: descriptor, option: socket_option,
                        value: i32) -> none ! errno =
        (level, name) := option_of(option)
        held: i32 = value
        given: ptr u8 = ptr(usize(addr held))
        fail failure() when libc.setsockopt(i32(socket), level, name, given,
                                            4) <> 0
    end system_set_number

    system_get_number: (socket: descriptor, option: socket_option)
                       -> (value: i32) ! errno =
        (level, name) := option_of(option)
        mut held: i32 = 0
        mut length: u32 = 4
        filled: ptr mut u8 = ptr(usize(addr held))
        fail failure() when libc.getsockopt(i32(socket), level, name, filled,
                                            addr length) <> 0
        value = held
    end system_get_number

    system_set_time: (socket: descriptor, option: socket_option,
                      span: time_value) -> none ! errno =
        (level, name) := option_of(option)
        (seconds, microseconds) := microseconds_of(span)
        limit: libc.time_limit = limit_of(seconds, microseconds)
        given: ptr u8 = ptr(usize(addr limit))
        fail failure() when libc.setsockopt(i32(socket), level, name, given,
                                            u32(sizeof libc.time_limit)) <> 0
    end system_set_time

    fixed if compiler.os == darwin then
        --  Darwin's microseconds are an `int`.
        limit_of: (seconds: i64, microseconds: i64)
                  -> (limit: libc.time_limit) =
            limit = (seconds: seconds, microseconds: i32(microseconds),
                     padding: 0)
        end limit_of
    else
        limit_of: (seconds: i64, microseconds: i64)
                  -> (limit: libc.time_limit) =
            limit = (seconds: seconds, microseconds: microseconds)
        end limit_of
    end if

    system_get_time: (socket: descriptor, option: socket_option)
                     -> (span: time_value) ! errno =
        (level, name) := option_of(option)
        mut limit: libc.time_limit = zeroed
        mut length: u32 = u32(sizeof libc.time_limit)
        filled: ptr mut u8 = ptr(usize(addr limit))
        fail failure() when libc.getsockopt(i32(socket), level, name, filled,
                                            addr length) <> 0
        fail unlisted when length <> u32(sizeof libc.time_limit)
        microseconds: i64 = i64(limit.microseconds)
        fail unlisted when microseconds < 0 or microseconds >= 1000000
        span = (seconds: limit.seconds,
                nanoseconds: u32(microseconds) * 1000)
    end system_get_time

    system_wait: (child: process_id) -> (word: i32) ! errno =
        mut status: i32 = 0
        fail failure() when libc.waitpid(i32(child), addr status, 0) < 0
        word = status
    end system_wait

    system_read_at: (source: descriptor, offset: u64, into: []mut u8)
                    -> (count: usize) ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = libc.pread(i32(source), base, lenof into, i64(offset))
        fail failure() when result < 0
        fail unlisted when usize(result) > lenof into
        count = usize(result)
    end system_read_at

    system_write_at: (to: descriptor, offset: u64, bytes: []u8)
                     -> (count: usize) ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = libc.pwrite(i32(to), base, lenof bytes, i64(offset))
        fail failure() when result < 0
        fail unlisted when usize(result) > lenof bytes
        count = usize(result)
    end system_write_at

    system_truncate: (opened: descriptor, size: u64) -> none ! errno =
        fail failure() when libc.ftruncate(i32(opened), i64(size)) <> 0
    end system_truncate

    fixed if compiler.os == darwin then
        --  Darwin's fsync leaves what the device caches in the device;
        --  F_FULLFSYNC has the device write it, and a file system that
        --  refuses it gets the fsync it has.
        system_synchronize: (opened: descriptor, data_only: bool)
                            -> none ! errno =
            _ = data_only
            return when libc.fcntl(i32(opened), libc.f_fullfsync) == 0
            fail failure() when libc.fsync(i32(opened)) <> 0
        end system_synchronize
    else
        system_synchronize: (opened: descriptor, data_only: bool)
                            -> none ! errno =
            result: i32 = if data_only then libc.fdatasync(i32(opened))
                          else libc.fsync(i32(opened)) end if
            fail failure() when result <> 0
        end system_synchronize
    end if

    system_rename: (old_at: descriptor, old: ptr u8, new_at: descriptor,
                    new: ptr u8) -> none ! errno =
        fail failure() when libc.renameat(i32(old_at), old, i32(new_at),
                                          new) <> 0
    end system_rename

    system_link: (old_at: descriptor, old: ptr u8, new_at: descriptor,
                  new: ptr u8) -> none ! errno =
        fail failure() when libc.linkat(i32(old_at), old, i32(new_at), new,
                                        0) <> 0
    end system_link

    system_symbolic_link: (target: ptr u8, at: descriptor, path: ptr u8)
                          -> none ! errno =
        fail failure() when libc.symlinkat(target, i32(at), path) <> 0
    end system_symbolic_link

    system_read_link: (at: descriptor, path: ptr u8, into: []mut u8)
                      -> (count: usize) ! errno =
        result: isize = libc.readlinkat(i32(at), path, addr into[0],
                                        lenof into)
        fail failure() when result < 0
        count = usize(result)
    end system_read_link

    system_change_mode_at: (at: descriptor, path: ptr u8, permissions: u32)
                           -> none ! errno =
        fail failure() when libc.fchmodat(i32(at), path, u16(permissions),
                                          0) <> 0
    end system_change_mode_at

    system_change_mode: (opened: descriptor, permissions: u32)
                        -> none ! errno =
        fail failure() when libc.fchmod(i32(opened), u16(permissions)) <> 0
    end system_change_mode

    system_change_owner_at: (at: descriptor, path: ptr u8, user: user_id,
                             group: group_id, follow: bool)
                            -> none ! errno =
        flags: i32 = if follow then 0 else libc.at_symlink_nofollow end if
        fail failure() when libc.fchownat(i32(at), path, u32(user),
                                          u32(group), flags) <> 0
    end system_change_owner_at

    system_change_owner: (opened: descriptor, user: user_id, group: group_id)
                         -> none ! errno =
        fail failure() when libc.fchown(i32(opened), u32(user),
                                        u32(group)) <> 0
    end system_change_owner

    --  The two times as C's pair of `timespec`s, access first.
    times_of: (accessed: time_value, modified: time_value)
              -> (times: [2]libc.timespec) =
        times = [(seconds: accessed.seconds,
                  nanoseconds: i64(accessed.nanoseconds)),
                 (seconds: modified.seconds,
                  nanoseconds: i64(modified.nanoseconds))]
    end times_of

    system_set_times_at: (at: descriptor, path: ptr u8, accessed: time_value,
                          modified: time_value, follow: bool)
                         -> none ! errno =
        times: [2]libc.timespec = times_of(accessed, modified)
        flags: i32 = if follow then 0 else libc.at_symlink_nofollow end if
        fail failure() when libc.utimensat(i32(at), path, addr times[0],
                                           flags) <> 0
    end system_set_times_at

    system_set_times: (opened: descriptor, accessed: time_value,
                       modified: time_value) -> none ! errno =
        times: [2]libc.timespec = times_of(accessed, modified)
        fail failure() when libc.futimens(i32(opened), addr times[0]) <> 0
    end system_set_times

    system_current_directory: (into: []mut u8) -> (count: usize) ! errno =
        fail failure() when libc.getcwd(addr into[0], lenof into) == 0
        count = 0
        while count < lenof into and into[count] <> 0 do
            inc count
        end while
        fail unlisted when count == lenof into
    end system_current_directory

    system_lock: (opened: descriptor, kind: lock_kind, wait: bool)
                 -> none ! errno =
        mut operation: i32 = if kind == shared_lock then libc.lock_sh
                             else libc.lock_ex end if
        if not wait then operation = operation | libc.lock_nb end if
        fail failure() when libc.flock(i32(opened), operation) <> 0
    end system_lock

    system_unlock: (opened: descriptor) -> none ! errno =
        fail failure() when libc.flock(i32(opened), libc.lock_un) <> 0
    end system_unlock

    --  Take a record lock of KIND, or with TAKING false give one up.
    system_lock_range: (opened: descriptor, kind: lock_kind, start: u64,
                        length: u64, wait: bool, taking: bool)
                       -> none ! errno =
        mut record: libc.lock_record = zeroed
        record.kind = if not taking then libc.f_unlck
                      elsif kind == shared_lock then libc.f_rdlck
                      else libc.f_wrlck end if
        record.whence = libc.seek_set
        record.start = i64(start)
        record.length = i64(length)
        command: i32 = if wait then libc.f_setlkw else libc.f_setlk end if
        fail failure() when libc.fcntl(i32(opened), command,
                                       addr record) == -1
    end system_lock_range

    system_real_user: () -> (user: u32) =
        user = libc.getuid()
    end system_real_user

    system_effective_user: () -> (user: u32) =
        user = libc.geteuid()
    end system_effective_user

    system_real_group: () -> (group: u32) =
        group = libc.getgid()
    end system_real_group

    system_effective_group: () -> (group: u32) =
        group = libc.getegid()
    end system_effective_group
end if
