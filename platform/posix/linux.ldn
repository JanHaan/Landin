--  platform/posix on Linux, over platform/linux's system calls.  A call's
--  failure is minus its errno in its result, so the errno is read from the
--  result itself and no cell is shared between threads.  The same calls
--  serve a program linked with --link=libc, whose C library this module
--  never calls.

import core/text
import platform/linux

fixed if compiler.os == linux then
    --- The working directory as the directory an `*_at` call's relative
    --- path is relative to: C's `AT_FDCWD`, which is no open file.
    public working_directory: descriptor = descriptor_value(linux.at_fdcwd)

    --  The flags `openat` takes for `options`.
    flags_of: (options: open_options) -> (flags: i32) =
        flags = match options.access
            read_only: linux.o_rdonly
            write_only: linux.o_wronly
            read_write: linux.o_rdwr
        end match
        if options.create then flags = flags | linux.o_creat end if
        if options.exclusive then flags = flags | linux.o_excl end if
        if options.truncate then flags = flags | linux.o_trunc end if
        if options.append then flags = flags | linux.o_append end if
        if options.directory then flags = flags | linux.o_directory end if
        flags = flags | linux.o_cloexec | linux.o_noctty
    end flags_of

    system_open: (at: descriptor, path: ptr u8, options: open_options,
                  permissions: u32) -> (opened: descriptor) ! errno =
        result: i32 = linux.openat(i32(at), path, flags_of(options),
                                   permissions)
        fail errno_of(-result) when result < 0
        opened = descriptor(result)
    end system_open

    system_read: (source: descriptor, into: []mut u8)
                 -> (count: usize) ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = linux.read(i32(source), base, lenof into)
        fail errno_of(i32(-result)) when result < 0
        count = usize(result)
    end system_read

    system_write: (to: descriptor, bytes: []u8) -> (count: usize) ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = linux.write(i32(to), base, lenof bytes)
        fail errno_of(i32(-result)) when result < 0
        count = usize(result)
    end system_write

    system_close: (closing: descriptor) -> none ! errno =
        result: i32 = linux.close(i32(closing))
        fail errno_of(-result) when result < 0
    end system_close

    --  A statx time as POSIX's.
    time_of: (stamp: linux.statx_time) -> (time: time_value) =
        time = (seconds: stamp.seconds, nanoseconds: stamp.nanoseconds)
    end time_of

    --  statx's record is the kernel's own on every architecture, so it
    --  needs no layout check.  Every basic field is asked for.
    status_of_record: (record: linux.file_status) -> (result: status) =
        result = (device: (u64(record.device_major) << 32)
                           | u64(record.device_minor),
                  inode: record.inode, kind: kind_of_mode(u32(record.mode)),
                  size: record.size,
                  permissions: u32(record.mode) & 0o7777,
                  links: u64(record.links), user: user_id(record.uid),
                  group: group_id(record.gid),
                  accessed: time_of(record.accessed),
                  modified: time_of(record.modified),
                  changed: time_of(record.changed))
    end status_of_record

    system_status: (at: descriptor, path: ptr u8, follow: bool)
                   -> (result: status) ! errno =
        mut record: linux.file_status = zeroed
        flags: i32 = if follow then 0 else linux.at_symlink_nofollow end if
        outcome: i32 = linux.statx(i32(at), path, flags,
                                   linux.statx_basic_stats, addr record)
        fail errno_of(-outcome) when outcome < 0
        result = status_of_record(record)
    end system_status

    --  The status of an open file: statx of an empty path relative to it.
    system_status_of: (opened: descriptor) -> (result: status) ! errno =
        mut record: linux.file_status = zeroed
        empty: [1]u8 = [0]
        outcome: i32 = linux.statx(i32(opened), addr empty[0],
                                   linux.at_empty_path,
                                   linux.statx_basic_stats, addr record)
        fail errno_of(-outcome) when outcome < 0
        result = status_of_record(record)
    end system_status_of

    system_open_directory: (at: descriptor, path: ptr u8)
                           -> (opened: directory_stream) ! errno =
        result: i32 = linux.openat(i32(at), path,
                                   linux.o_rdonly | linux.o_directory
                                   | linux.o_cloexec, 0)
        fail errno_of(-result) when result < 0
        opened = (descriptor: descriptor(result), stream: 0, filled: 0,
                  cursor: 0, finished: false)
    end system_open_directory

    --  A record's little-endian u16 at `at`.
    record_u16: (bytes: []u8, at: usize) -> (value: usize) =
        value = usize(bytes[at]) | (usize(bytes[at + 1]) << 8)
    end record_u16

    --  The next record in the buffer, refilling it from getdents64 when
    --  every record in it has been read.  A record is checked to lie
    --  within what the kernel filled before any byte of it is read, and
    --  its name to end within it, so a buffer's last record is never read
    --  past; one that does not is `unlisted`, which no errno describes.
    system_read_directory: (inout opened: directory_stream, buffer: []mut u8)
                           -> (item: directory_entry from buffer) ! errno =
        loop do
            if opened.cursor >= opened.filled then
                if opened.finished then
                    item = (name: text.host_over(buffer[0..<0]),
                            kind: unknown_kind)
                    return
                end if
                got: isize = linux.getdents64(i32(opened.descriptor),
                                              addr buffer[0], lenof buffer)
                fail errno_of(i32(-got)) when got < 0
                fail unlisted when usize(got) > lenof buffer
                if got == 0 then
                    opened.finished = true
                else
                    opened.filled = usize(got)
                    opened.cursor = 0
                end if
            else
                at: usize = opened.cursor
                --  The fixed part is 19 bytes and the name at least one
                --  byte and its NUL.
                fail unlisted when opened.filled - at < 21
                length: usize = record_u16(buffer, at + 16)
                fail unlisted when length < 21
                  or length > opened.filled - at
                opened.cursor = at + length
                mut stop: usize = at + 19
                while stop < at + length and buffer[stop] <> 0 do
                    inc stop
                end while
                fail unlisted when stop == at + length
                item = (name: text.host_over(buffer[at + 19..<stop]),
                        kind: kind_of_type(buffer[at + 18]))
                return
            end if
        end loop
    end system_read_directory

    system_close_directory: (opened: directory_stream) -> none ! errno =
        try system_close(opened.descriptor)
    end system_close_directory

    system_make_directory: (at: descriptor, path: ptr u8, permissions: u32)
                           -> none ! errno =
        result: i32 = linux.mkdirat(i32(at), path, permissions)
        fail errno_of(-result) when result < 0
    end system_make_directory

    system_remove: (at: descriptor, path: ptr u8, directory: bool)
                   -> none ! errno =
        result: i32 = linux.unlinkat(i32(at), path,
                                     if directory then linux.at_removedir
                                     else 0 end if)
        fail errno_of(-result) when result < 0
    end system_remove

    system_map: (length: usize) -> (base: ptr mut u8) ! errno =
        result: i64 = linux.mmap(0, length, linux.prot_read | linux.prot_write,
                                 linux.map_private | linux.map_anonymous, -1,
                                 0)
        fail errno_of(i32(-result)) when result < 0
        base = ptr(usize(result))
    end system_map

    system_unmap: (base: ptr mut u8, length: usize) -> none ! errno =
        result: i32 = linux.munmap(usize(base), length)
        fail errno_of(-result) when result < 0
    end system_unmap

    system_page_size: () -> (bytes: usize) =
        bytes = linux.page_size()
    end system_page_size

    system_exit: (status: i32) -> noreturn =
        linux.exit_group(status)
    end system_exit

    --  arm64 and RV64 have no `poll` call, so every architecture makes
    --  `ppoll`, with the milliseconds as its time limit.
    system_poll: (entries: []mut poll_entry, milliseconds: i32)
                 -> (ready: usize) ! errno =
        mut spare: linux.poll_record = zeroed
        records: ptr mut linux.poll_record =
            if lenof entries > 0 then ptr(usize(addr entries[0]))
            else addr spare end if
        mut limit: linux.timespec = zeroed
        limit.seconds = i64(milliseconds / 1000)
        limit.nanoseconds = i64(milliseconds % 1000) * 1000000
        bound: linux.poll_limit = if milliseconds < 0 then linux.no_limit
                                  else addr limit end if
        result: i32 = linux.ppoll(records, lenof entries, bound)
        fail errno_of(-result) when result < 0
        ready = usize(result)
    end system_poll

    system_pipe: () -> (ends: pipe_ends) ! errno =
        mut made: [2]i32 = zeroed
        result: i32 = linux.pipe2(addr made[0], linux.o_cloexec)
        fail errno_of(-result) when result < 0
        ends = (reading: descriptor(made[0]), writing: descriptor(made[1]))
    end system_pipe

    system_closed_on_exec: (opened: descriptor) -> (yes: bool) ! errno =
        flags: i32 = linux.fcntl(i32(opened), linux.f_getfd, 0)
        fail errno_of(-flags) when flags < 0
        yes = (flags & linux.fd_cloexec) <> 0
    end system_closed_on_exec

    system_duplicate_above: (source: descriptor, lowest: i32)
                            -> (result: descriptor) ! errno =
        made: i32 = linux.fcntl(i32(source), linux.f_dupfd_cloexec,
                                i64(lowest))
        fail errno_of(-made) when made < 0
        result = descriptor(made)
    end system_duplicate_above

    --  An end of the report pipe moved above the standard streams, so that
    --  moving them into place in the child cannot overwrite it.
    report_end: (given: i32) -> (result: i32) ! errno =
        result = given
        return when given >= 3
        moved: i32 = linux.fcntl(given, linux.f_dupfd_cloexec, 3)
        _ = linux.close(given)
        fail errno_of(-moved) when moved < 0
        result = moved
    end report_end

    --  What the child runs between the copy and the program: it moves the
    --  streams into place, marks every other descriptor closed on exec and
    --  executes the program, and when any of that fails writes the errno
    --  to the report pipe and ends.  It makes system calls and nothing
    --  else: no allocation, and nothing another thread of the parent could
    --  have held.
    start_child: (path: ptr u8, arguments: ptr ptr u8,
                  environment: ptr ptr u8, streams: standard_streams,
                  report: i32) -> noreturn =
        mut result: i32 = 0
        if streams.input <> standard_input then
            result = linux.dup3(i32(streams.input), 0, 0)
        end if
        if result >= 0 and streams.output <> standard_output then
            result = linux.dup3(i32(streams.output), 1, 0)
        end if
        if result >= 0 and streams.errors <> standard_error then
            result = linux.dup3(i32(streams.errors), 2, 0)
        end if
        if result >= 0 then
            --  Descriptors this layer made are closed on exec already; this
            --  closes any a C library or an inherited one left open, and a
            --  kernel older than 5.11 that refuses it leaves only those.
            _ = linux.close_range(3, 0 -% 1, linux.close_range_cloexec)
            --  The parent ignores SIGPIPE, which an exec keeps; the child
            --  starts with the default, as a program expects to.
            mut restored: linux.signal_action = zeroed
            restored.handler = linux.sig_dfl
            result = linux.rt_sigaction(linux.sigpipe, addr restored,
                                        linux.no_action)
        end if
        if result >= 0 then
            result = linux.execve(path, arguments, environment)
        end if
        problem: u32 = u32(-result)
        word: [4]u8 = [u8(problem & 255), u8((problem >> 8) & 255),
                       u8((problem >> 16) & 255), u8(problem >> 24)]
        _ = linux.write(report, addr word[0], 4)
        linux.exit_group(127)
    end start_child

    --  The child's report: four bytes of the errno that stopped it, or none
    --  once its exec closed the pipe.  A read interrupted by a signal is
    --  made again: the child exists either way, and only its report says
    --  whether it is running the program.
    read_report: (reading: i32) -> (problem: i32) =
        mut word: [4]u8 = zeroed
        mut got: isize = 0
        loop do
            got = linux.read(reading, addr word[0], 4)
            break when got <> -4
        end loop
        problem = 0
        return when got <> 4
        problem = i32(u32(word[0]) | (u32(word[1]) << 8)
                      | (u32(word[2]) << 16) | (u32(word[3]) << 24))
    end read_report

    system_spawn: (path: ptr u8, arguments: ptr ptr u8,
                   environment: ptr ptr u8, streams: standard_streams)
                  -> (child: process_id) ! errno =
        mut made: [2]i32 = zeroed
        opened: i32 = linux.pipe2(addr made[0], linux.o_cloexec)
        fail errno_of(-opened) when opened < 0
        reading: i32 = report_end(made[0]) else (problem)
            _ = linux.close(made[1])
            fail problem
        end
        writing: i32 = report_end(made[1]) else (problem)
            _ = linux.close(reading)
            fail problem
        end
        copied: i64 = linux.fork()
        if copied == 0 then
            start_child(path, arguments, environment, streams, writing)
        end if
        _ = linux.close(writing)
        if copied < 0 then
            _ = linux.close(reading)
            fail errno_of(i32(-copied))
        end if
        problem: i32 = read_report(reading)
        _ = linux.close(reading)
        child = process_id(i32(copied))
        return when problem == 0
        --  The child ended without its program: reap it, so no trace of it
        --  is left.
        mut status: i32 = 0
        loop do
            reaped: i32 = linux.wait4(i32(copied), addr status, 0)
            break when reaped <> -4
        end loop
        fail errno_of(problem)
    end system_spawn

    --  A program the C runtime started gives `main` the initial stack's
    --  tables, and the auxiliary vector after them is platform/linux's
    --  once it has held them to the kernel's layout.
    system_adopt_start: (count: i32, values: ptr ptr u8,
                         environment: ptr ptr u8) -> none =
        _ = linux.adopt_start(count, values, environment)
    end system_adopt_start

    --  The vDSO's `clock_gettime`, found the first time a clock is read:
    --  zero before then, one when there is none, its address otherwise.
    --  Process state of a single thread, as the heap's classes are: a C
    --  thread calling in under --link=libc, the only other thread there
    --  can be, finds the same vDSO and stores the same answer.  Threads of
    --  the program's own are the threads item's.
    mut vdso_clock: u64

    no_vdso_clock: u64 = 1

    --  The vDSO's clock function, found once and kept.
    vdso_clock_address: () -> (address: u64) =
        address = vdso_clock
        return when address <> 0
        (found, address: at) := linux.vdso_symbol(linux.vdso_clock_name,
                                                  linux.vdso_version)
        address = if found and u64(at) > no_vdso_clock then u64(at)
                  else no_vdso_clock end if
        vdso_clock = address
    end vdso_clock_address

    clock_number: (clock: clock_kind) -> (number: i32) =
        number = match clock
            monotonic_clock: linux.clock_monotonic
            realtime_clock: linux.clock_realtime
        end match
    end clock_number

    --  The vDSO's function is made a value of its C type from its address,
    --  as a looked-up symbol is.
    system_clock_time: (clock: clock_kind) -> (time: time_value) ! errno =
        mut record: linux.timespec = zeroed
        mut result: i32 = -1
        address: u64 = vdso_clock_address()
        if address <> no_vdso_clock then
            function: linux.vdso_clock_gettime =
                linux.vdso_clock_gettime(usize(address))
            result = function(clock_number(clock), addr record)
        end if
        if result <> 0 then
            result = linux.clock_gettime(clock_number(clock), addr record)
            fail errno_of(-result) when result < 0
        end if
        fail unlisted when record.nanoseconds < 0
          or record.nanoseconds >= 1000000000
        time = (seconds: record.seconds, nanoseconds: u32(record.nanoseconds))
    end system_clock_time

    system_sleep: (span: time_value) -> none ! errno =
        request: linux.timespec = (seconds: span.seconds,
                                   nanoseconds: i64(span.nanoseconds))
        mut remaining: linux.timespec = zeroed
        result: i32 = linux.clock_nanosleep(linux.clock_monotonic, 0,
                                            addr request, addr remaining)
        fail errno_of(-result) when result < 0
    end system_sleep

    system_random_bytes: (into: []mut u8) -> (count: usize) ! errno =
        result: isize = linux.getrandom(addr into[0], lenof into, 0)
        fail errno_of(i32(-result)) when result < 0
        fail unlisted when usize(result) > lenof into
        count = usize(result)
    end system_random_bytes

    --  SIGPIPE's disposition, the process's own: ignored when it was the
    --  default, so that a write to a pipe or a socket nobody reads fails
    --  with EPIPE rather than ending the process; a handler a C `main`
    --  installed, and an ignore the process was started with, are kept.
    system_ignore_broken_pipe: () -> none =
        mut previous: linux.signal_action = zeroed
        return when linux.rt_sigaction(linux.sigpipe, linux.no_action,
                                       addr previous) < 0
        return when previous.handler <> linux.sig_dfl
        mut ignoring: linux.signal_action = zeroed
        ignoring.handler = linux.sig_ign
        _ = linux.rt_sigaction(linux.sigpipe, addr ignoring, linux.no_action)
    end system_ignore_broken_pipe

    --  Whether SIGPIPE is ignored, for a program to ask.
    system_broken_pipe_ignored: () -> (ignored: bool) =
        mut previous: linux.signal_action = zeroed
        ignored = linux.rt_sigaction(linux.sigpipe, linux.no_action,
                                     addr previous) >= 0
                  and previous.handler == linux.sig_ign
    end system_broken_pipe_ignored

    system_family_number: (family: socket_family) -> (number: i32) =
        number = match family
            internet: linux.af_inet
            internet6: linux.af_inet6
            local: linux.af_unix
        end match
    end system_family_number

    kind_number: (kind: socket_kind) -> (number: i32) =
        number = match kind
            stream: linux.sock_stream
            datagram: linux.sock_dgram
        end match
    end kind_number

    system_socket: (family: socket_family, kind: socket_kind)
                   -> (made: descriptor) ! errno =
        result: i32 = linux.socket(system_family_number(family),
                                   kind_number(kind) | linux.sock_cloexec, 0)
        fail errno_of(-result) when result < 0
        made = descriptor(result)
    end system_socket

    system_socket_pair: (kind: socket_kind) -> (ends: connected_pair)
                        ! errno =
        mut made: [2]i32 = zeroed
        result: i32 = linux.socketpair(linux.af_unix,
                                       kind_number(kind) | linux.sock_cloexec,
                                       0, addr made[0])
        fail errno_of(-result) when result < 0
        ends = (first: descriptor(made[0]), second: descriptor(made[1]))
    end system_socket_pair

    system_bind: (socket: descriptor, address: ptr u8, length: u32)
                 -> none ! errno =
        result: i32 = linux.bind(i32(socket), address, length)
        fail errno_of(-result) when result < 0
    end system_bind

    system_listen: (socket: descriptor, backlog: i32) -> none ! errno =
        result: i32 = linux.listen(i32(socket), backlog)
        fail errno_of(-result) when result < 0
    end system_listen

    system_accept: (listener: descriptor) -> (accepted: descriptor) ! errno =
        result: i32 = linux.accept4(i32(listener), linux.no_address,
                                    linux.no_address, linux.sock_cloexec)
        fail errno_of(-result) when result < 0
        accepted = descriptor(result)
    end system_accept

    system_connect: (socket: descriptor, address: ptr u8, length: u32)
                    -> none ! errno =
        result: i32 = linux.connect(i32(socket), address, length)
        fail errno_of(-result) when result < 0
    end system_connect

    --  Every send is MSG_NOSIGNAL's, so a peer that has gone is EPIPE
    --  whatever SIGPIPE's disposition is.
    system_send: (socket: descriptor, bytes: []u8) -> (count: usize)
                 ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = linux.sendto(i32(socket), base, lenof bytes,
                                     linux.msg_nosignal, linux.no_address,
                                     0)
        fail errno_of(i32(-result)) when result < 0
        count = usize(result)
    end system_send

    system_receive: (socket: descriptor, into: []mut u8) -> (count: usize)
                    ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = linux.recvfrom(i32(socket), base, lenof into, 0,
                                       linux.no_address, linux.no_address)
        fail errno_of(i32(-result)) when result < 0
        count = usize(result)
    end system_receive

    system_send_to: (socket: descriptor, bytes: []u8, address: ptr u8,
                     length: u32) -> (count: usize) ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = linux.sendto(i32(socket), base, lenof bytes,
                                     linux.msg_nosignal, address, length)
        fail errno_of(i32(-result)) when result < 0
        count = usize(result)
    end system_send_to

    system_receive_from: (socket: descriptor, into: []mut u8,
                          address: ptr mut u8, length: ptr mut u32)
                         -> (count: usize) ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = linux.recvfrom(i32(socket), base, lenof into, 0,
                                       address, length)
        fail errno_of(i32(-result)) when result < 0
        count = usize(result)
    end system_receive_from

    system_shutdown: (socket: descriptor, how: i32) -> none ! errno =
        result: i32 = linux.shutdown(i32(socket), how)
        fail errno_of(-result) when result < 0
    end system_shutdown

    system_socket_name: (socket: descriptor, address: ptr mut u8,
                         length: ptr mut u32) -> none ! errno =
        result: i32 = linux.getsockname(i32(socket), address, length)
        fail errno_of(-result) when result < 0
    end system_socket_name

    system_peer_name: (socket: descriptor, address: ptr mut u8,
                       length: ptr mut u32) -> none ! errno =
        result: i32 = linux.getpeername(i32(socket), address, length)
        fail errno_of(-result) when result < 0
    end system_peer_name

    --  An option's level and name.
    option_of: (option: socket_option) -> (level: i32, name: i32) =
        level = linux.sol_socket
        name = match option
            reuse_address: linux.so_reuseaddr
            no_delay: linux.tcp_nodelay
            ipv6_only: linux.ipv6_v6only
            receive_limit: linux.so_rcvtimeo
            send_limit: linux.so_sndtimeo
            pending: linux.so_error
        end match
        if option == no_delay then level = linux.ipproto_tcp end if
        if option == ipv6_only then level = linux.ipproto_ipv6 end if
    end option_of

    system_set_number: (socket: descriptor, option: socket_option,
                        value: i32) -> none ! errno =
        (level, name) := option_of(option)
        held: i32 = value
        given: ptr u8 = ptr(usize(addr held))
        result: i32 = linux.setsockopt(i32(socket), level, name, given, 4)
        fail errno_of(-result) when result < 0
    end system_set_number

    system_get_number: (socket: descriptor, option: socket_option)
                       -> (value: i32) ! errno =
        (level, name) := option_of(option)
        mut held: i32 = 0
        mut length: u32 = 4
        filled: ptr mut u8 = ptr(usize(addr held))
        result: i32 = linux.getsockopt(i32(socket), level, name, filled,
                                       addr length)
        fail errno_of(-result) when result < 0
        value = held
    end system_get_number

    system_set_time: (socket: descriptor, option: socket_option,
                      span: time_value) -> none ! errno =
        (level, name) := option_of(option)
        (seconds, microseconds) := microseconds_of(span)
        limit: linux.time_limit = (seconds: seconds,
                                   microseconds: microseconds)
        given: ptr u8 = ptr(usize(addr limit))
        result: i32 = linux.setsockopt(i32(socket), level, name, given,
                                       u32(sizeof linux.time_limit))
        fail errno_of(-result) when result < 0
    end system_set_time

    system_get_time: (socket: descriptor, option: socket_option)
                     -> (span: time_value) ! errno =
        (level, name) := option_of(option)
        mut limit: linux.time_limit = zeroed
        mut length: u32 = u32(sizeof linux.time_limit)
        filled: ptr mut u8 = ptr(usize(addr limit))
        result: i32 = linux.getsockopt(i32(socket), level, name, filled,
                                       addr length)
        fail errno_of(-result) when result < 0
        fail unlisted when length <> u32(sizeof linux.time_limit)
          or limit.microseconds < 0
          or limit.microseconds >= 1000000
        span = (seconds: limit.seconds,
                nanoseconds: u32(limit.microseconds) * 1000)
    end system_get_time

    system_wait: (child: process_id) -> (word: i32) ! errno =
        mut status: i32 = 0
        result: i32 = linux.wait4(i32(child), addr status, 0)
        fail errno_of(-result) when result < 0
        word = status
    end system_wait

    system_read_at: (source: descriptor, offset: u64, into: []mut u8)
                    -> (count: usize) ! errno =
        mut spare: u8 = 0
        base: ptr mut u8 = if lenof into > 0 then addr into[0]
                           else addr spare end if
        result: isize = linux.pread64(i32(source), base, lenof into,
                                      i64(offset))
        fail errno_of(i32(-result)) when result < 0
        fail unlisted when usize(result) > lenof into
        count = usize(result)
    end system_read_at

    system_write_at: (to: descriptor, offset: u64, bytes: []u8)
                     -> (count: usize) ! errno =
        spare: u8 = 0
        base: ptr u8 = if lenof bytes > 0 then addr bytes[0]
                       else addr spare end if
        result: isize = linux.pwrite64(i32(to), base, lenof bytes,
                                       i64(offset))
        fail errno_of(i32(-result)) when result < 0
        fail unlisted when usize(result) > lenof bytes
        count = usize(result)
    end system_write_at

    system_truncate: (opened: descriptor, size: u64) -> none ! errno =
        result: i32 = linux.ftruncate(i32(opened), i64(size))
        fail errno_of(-result) when result < 0
    end system_truncate

    system_synchronize: (opened: descriptor, data_only: bool)
                        -> none ! errno =
        result: i32 = if data_only then linux.fdatasync(i32(opened))
                      else linux.fsync(i32(opened)) end if
        fail errno_of(-result) when result < 0
    end system_synchronize

    system_rename: (old_at: descriptor, old: ptr u8, new_at: descriptor,
                    new: ptr u8) -> none ! errno =
        result: i32 = linux.renameat2(i32(old_at), old, i32(new_at), new, 0)
        fail errno_of(-result) when result < 0
    end system_rename

    system_link: (old_at: descriptor, old: ptr u8, new_at: descriptor,
                  new: ptr u8) -> none ! errno =
        result: i32 = linux.linkat(i32(old_at), old, i32(new_at), new, 0)
        fail errno_of(-result) when result < 0
    end system_link

    system_symbolic_link: (target: ptr u8, at: descriptor, path: ptr u8)
                          -> none ! errno =
        result: i32 = linux.symlinkat(target, i32(at), path)
        fail errno_of(-result) when result < 0
    end system_symbolic_link

    system_read_link: (at: descriptor, path: ptr u8, into: []mut u8)
                      -> (count: usize) ! errno =
        result: isize = linux.readlinkat(i32(at), path, addr into[0],
                                         lenof into)
        fail errno_of(i32(-result)) when result < 0
        count = usize(result)
    end system_read_link

    system_change_mode_at: (at: descriptor, path: ptr u8, permissions: u32)
                           -> none ! errno =
        result: i32 = linux.fchmodat(i32(at), path, permissions)
        fail errno_of(-result) when result < 0
    end system_change_mode_at

    system_change_mode: (opened: descriptor, permissions: u32)
                        -> none ! errno =
        result: i32 = linux.fchmod(i32(opened), permissions)
        fail errno_of(-result) when result < 0
    end system_change_mode

    system_change_owner_at: (at: descriptor, path: ptr u8, user: user_id,
                             group: group_id, follow: bool)
                            -> none ! errno =
        flags: i32 = if follow then 0 else linux.at_symlink_nofollow end if
        result: i32 = linux.fchownat(i32(at), path, u32(user), u32(group),
                                     flags)
        fail errno_of(-result) when result < 0
    end system_change_owner_at

    system_change_owner: (opened: descriptor, user: user_id, group: group_id)
                         -> none ! errno =
        result: i32 = linux.fchown(i32(opened), u32(user), u32(group))
        fail errno_of(-result) when result < 0
    end system_change_owner

    --  The two times as the kernel's pair of `timespec`s, access first.
    times_of: (accessed: time_value, modified: time_value)
              -> (times: [2]linux.timespec) =
        times = [(seconds: accessed.seconds,
                  nanoseconds: i64(accessed.nanoseconds)),
                 (seconds: modified.seconds,
                  nanoseconds: i64(modified.nanoseconds))]
    end times_of

    system_set_times_at: (at: descriptor, path: ptr u8, accessed: time_value,
                          modified: time_value, follow: bool)
                         -> none ! errno =
        times: [2]linux.timespec = times_of(accessed, modified)
        flags: i32 = if follow then 0 else linux.at_symlink_nofollow end if
        result: i32 = linux.utimensat(i32(at), path, addr times[0], flags)
        fail errno_of(-result) when result < 0
    end system_set_times_at

    system_set_times: (opened: descriptor, accessed: time_value,
                       modified: time_value) -> none ! errno =
        times: [2]linux.timespec = times_of(accessed, modified)
        result: i32 = linux.utimensat(i32(opened), linux.no_path,
                                      addr times[0], 0)
        fail errno_of(-result) when result < 0
    end system_set_times

    --  The kernel puts the path and its NUL in the buffer and gives their
    --  length; a directory outside the process's root comes back as a path
    --  that does not begin with `/`, which is no path to it.
    system_current_directory: (into: []mut u8) -> (count: usize) ! errno =
        result: isize = linux.getcwd(addr into[0], lenof into)
        fail errno_of(i32(-result)) when result < 0
        fail unlisted when result == 0 or usize(result) > lenof into
        fail enoent when into[0] <> 47
        count = usize(result) - 1
    end system_current_directory

    system_lock: (opened: descriptor, kind: lock_kind, wait: bool)
                 -> none ! errno =
        mut operation: i32 = if kind == shared_lock then linux.lock_sh
                             else linux.lock_ex end if
        if not wait then operation = operation | linux.lock_nb end if
        result: i32 = linux.flock(i32(opened), operation)
        fail errno_of(-result) when result < 0
    end system_lock

    system_unlock: (opened: descriptor) -> none ! errno =
        result: i32 = linux.flock(i32(opened), linux.lock_un)
        fail errno_of(-result) when result < 0
    end system_unlock

    --  Take a record lock of KIND, or with TAKING false give one up.
    system_lock_range: (opened: descriptor, kind: lock_kind, start: u64,
                        length: u64, wait: bool, taking: bool)
                       -> none ! errno =
        mut record: linux.lock_record = zeroed
        record.kind = if not taking then linux.f_unlck
                      elsif kind == shared_lock then linux.f_rdlck
                      else linux.f_wrlck end if
        record.start = i64(start)
        record.length = i64(length)
        command: i32 = if wait then linux.f_setlkw else linux.f_setlk end if
        result: i32 = linux.fcntl(i32(opened), command,
                                  i64(usize(addr record)))
        fail errno_of(-result) when result < 0
    end system_lock_range

    system_real_user: () -> (user: u32) =
        user = linux.getuid()
    end system_real_user

    system_effective_user: () -> (user: u32) =
        user = linux.geteuid()
    end system_effective_user

    system_real_group: () -> (group: u32) =
        group = linux.getgid()
    end system_real_group

    system_effective_group: () -> (group: u32) =
        group = linux.getegid()
    end system_effective_group
end if
