--  The vDSO: a small shared object the kernel maps into every process,
--  whose functions answer some calls, the clocks among them, without
--  entering the kernel.  The auxiliary vector names where it is mapped,
--  AT_SYSINFO_EHDR, and its functions are found the way a dynamic loader
--  finds any: through its ELF program headers, its dynamic table, its
--  symbols and their versions.  Nothing here trusts the image: every
--  offset is held to lie within it before a byte is read, so an image that
--  is malformed, truncated or of another kind finds nothing rather than
--  trapping, and the caller makes the system call instead.

fixed if compiler.os == linux then
    --- The auxiliary-vector tag of the vDSO's address, AT_SYSINFO_EHDR.
    public at_sysinfo_ehdr: u64 = 33

    fixed if compiler.arch == x86_64 then
        --- The name the vDSO gives `clock_gettime` on this architecture.
        public vdso_clock_name: []u8 = "__vdso_clock_gettime"
        --- The symbol version it has: x86-64's is `LINUX_2.6`.
        public vdso_version: []u8 = "LINUX_2.6"
    elsif compiler.arch == arm64 then
        --- The name the vDSO gives `clock_gettime` on this architecture.
        public vdso_clock_name: []u8 = "__kernel_clock_gettime"
        --- The symbol version it has: arm64's is `LINUX_2.6.39`.
        public vdso_version: []u8 = "LINUX_2.6.39"
    else
        --- The name the vDSO gives `clock_gettime` on this architecture.
        public vdso_clock_name: []u8 = "__vdso_clock_gettime"
        --- The symbol version it has: RV64's is `LINUX_4.15`.
        public vdso_version: []u8 = "LINUX_4.15"
    end if

    --- The vDSO's `clock_gettime`, a C function: it fills `into` with the
    --- clock `clock`'s time and returns zero, or minus the errno, making
    --- the system call itself for a clock it cannot read.
    public vdso_clock_gettime: type = extern(c) (clock: i32, into: ptr mut timespec) -> (result: i32)

    --- The most of an image `vdso_symbol` believes: the kernel's vDSO is a
    --- few pages, and a load segment claiming more is not one.
    public vdso_largest: usize = 1048576

    --  The least of any page size Linux uses, which the vDSO's first page,
    --  holding its ELF header and program headers, is at least.
    first_page: usize = 4096

    --  Whether `size` bytes from `at` lie within `image`, asked without an
    --  addition that could overflow.
    fits: (image: []u8, at: u64, size: u64) -> (yes: bool) =
        length: u64 = u64(lenof image)
        yes = at <= length and size <= length - at
    end fits

    --  The little-endian integers at `at`, which the caller has held to lie
    --  within the image.
    half_at: (image: []u8, at: u64) -> (value: u64) =
        first: usize = usize(at)
        value = u64(image[first]) | (u64(image[first + 1]) << 8)
    end half_at

    word_at: (image: []u8, at: u64) -> (value: u64) =
        value = half_at(image, at) | (half_at(image, at + 2) << 16)
    end word_at

    double_at: (image: []u8, at: u64) -> (value: u64) =
        value = word_at(image, at) | (word_at(image, at + 4) << 32)
    end double_at

    --  Whether the NUL-terminated string `at` bytes into the string table,
    --  which starts at `table` and holds `size` bytes, is `wanted`.
    string_is: (image: []u8, table: u64, size: u64, at: u64, wanted: []u8)
               -> (yes: bool) =
        yes = false
        length: u64 = u64(lenof wanted)
        return when at >= size or length >= size - at
        start: u64 = table + at
        return when not fits(image, start, length + 1)
        for index in usize(0)..<lenof wanted do
            return when image[usize(start) + index] <> wanted[index]
        end for
        yes = image[usize(start + length)] == 0
    end string_is

    --  What the dynamic table says, as offsets into the image: zero for a
    --  table it does not name, since no table lies at the image's start.
    tables: type = struct
        hash: u64
        gnu_hash: u64
        strings: u64
        string_size: u64
        symbols: u64
        versions: u64
        definitions: u64
    end tables

    --  Where in the image the address `address` lies, given the first load
    --  segment's file offset and address: its offset, or the image's
    --  length when it lies outside.
    placed: (image: []u8, load_offset: u64, load_address: u64, address: u64)
            -> (offset: u64) =
        length: u64 = u64(lenof image)
        offset = length
        return when address < load_address
        distance: u64 = address - load_address
        return when distance > length or load_offset >= length - distance
        offset = load_offset + distance
    end placed

    --  How many symbols the symbol table holds: DT_HASH's chain count, or
    --  where DT_GNU_HASH's last chain ends.  Zero when neither says.
    symbol_count: (image: []u8, found: tables) -> (count: u64) =
        count = 0
        if found.hash <> 0 then
            return when not fits(image, found.hash, 8)
            count = word_at(image, found.hash + 4)
            return
        end if
        return when found.gnu_hash == 0 or not fits(image, found.gnu_hash, 16)
        buckets: u64 = word_at(image, found.gnu_hash)
        first: u64 = word_at(image, found.gnu_hash + 4)
        bloom: u64 = word_at(image, found.gnu_hash + 8)
        start: u64 = found.gnu_hash + 16
        length: u64 = u64(lenof image)
        return when bloom > length / 8 or not fits(image, start, bloom * 8)
        bucket_start: u64 = start + bloom * 8
        return when buckets > length / 4
          or not fits(image, bucket_start, buckets * 4)
        mut last: u64 = 0
        for index in u64(0)..<buckets do
            value: u64 = word_at(image, bucket_start + index * 4)
            if value > last then last = value end if
        end for
        if last < first then
            count = first
            return
        end if
        chain_start: u64 = bucket_start + buckets * 4
        loop do
            return when last - first > length / 4
            at: u64 = chain_start + (last - first) * 4
            return when not fits(image, at, 4)
            break when (word_at(image, at) & 1) <> 0
            inc last
        end loop
        count = last + 1
    end symbol_count

    --  Whether the symbol at `index` has the version named `version`: the
    --  version definitions are walked, as a dynamic loader walks them, for
    --  the one whose index the symbol's version entry gives.  A table of
    --  definitions that runs on is cut off after 256.
    has_version: (image: []u8, found: tables, index: u64, version: []u8)
                 -> (yes: bool) =
        yes = false
        entry: u64 = found.versions + index * 2
        return when not fits(image, entry, 2)
        wanted: u64 = half_at(image, entry) & 0x7fff
        mut at: u64 = found.definitions
        for step in usize(0)..<256 do
            _ = step
            return when not fits(image, at, 20)
            flags: u64 = half_at(image, at + 2)
            number: u64 = half_at(image, at + 4) & 0x7fff
            if (flags & 1) == 0 and number == wanted then
                auxiliary: u64 = at + word_at(image, at + 12)
                return when not fits(image, auxiliary, 8)
                yes = string_is(image, found.strings, found.string_size,
                                word_at(image, auxiliary), version)
                return
            end if
            next: u64 = word_at(image, at + 16)
            return when next == 0
            at += next
        end for
    end has_version

    --  What a 64-bit little-endian ELF image's program headers say: its
    --  first load segment's file offset, address and size in the file,
    --  and where its dynamic table lies.  `loaded` is false when the
    --  image is no such object, its headers do not lie within it, or none
    --  of them is a load segment.
    segments: type = struct
        loaded: bool
        load_offset: u64
        load_address: u64
        load_size: u64
        dynamic: u64
        dynamic_size: u64
    end segments

    segments_of: (image: []u8) -> (found: segments) =
        found = (loaded: false, load_offset: 0, load_address: 0,
                 load_size: 0, dynamic: 0, dynamic_size: 0)
        return when not fits(image, 0, 64)
        return when image[0] <> 0x7f or image[1] <> 0x45 or image[2] <> 0x4c
          or image[3] <> 0x46 or image[4] <> 2 or image[5] <> 1
        headers: u64 = double_at(image, 32)
        header_size: u64 = half_at(image, 54)
        header_count: u64 = half_at(image, 56)
        return when header_size < 56
          or not fits(image, headers, header_size * header_count)
        for index in u64(0)..<header_count do
            at: u64 = headers + index * header_size
            kind: u64 = word_at(image, at)
            if kind == 1 and not found.loaded then
                found.loaded = true
                found.load_offset = double_at(image, at + 8)
                found.load_address = double_at(image, at + 16)
                found.load_size = double_at(image, at + 32)
            elsif kind == 2 then
                found.dynamic = double_at(image, at + 8)
                found.dynamic_size = double_at(image, at + 32)
            end if
        end for
    end segments_of

    --- Find the function `name` of version `version` in `image`, the
    --- bytes of a shared object as it is mapped: whether it is there, and
    --- its offset from the image's start.  A global or weak function
    --- defined in the image counts; where the image has no version
    --- tables, the name alone decides, as a dynamic loader decides it.
    --- Every offset is held to lie within the image before it is read, so
    --- an image that is not a 64-bit little-endian ELF object, is
    --- truncated or contradicts itself finds nothing and never traps.
    public link(symbol: "_landin_linux_vdso_find") vdso_find:
        (image: []u8, name: []u8, version: []u8)
        -> (found: bool, offset: usize) =
        found = false
        offset = 0
        parts: segments = segments_of(image)
        return when not parts.loaded or parts.dynamic_size == 0
          or not fits(image, parts.dynamic, parts.dynamic_size)
        load_offset: u64 = parts.load_offset
        load_address: u64 = parts.load_address
        dynamic: u64 = parts.dynamic
        dynamic_size: u64 = parts.dynamic_size
        mut found_tables: tables = (hash: 0, gnu_hash: 0, strings: 0,
                                    string_size: 0, symbols: 0, versions: 0,
                                    definitions: 0)
        for index in u64(0)..<dynamic_size / 16 do
            at: u64 = dynamic + index * 16
            tag: u64 = double_at(image, at)
            break when tag == 0
            place: u64 = placed(image, load_offset, load_address,
                                double_at(image, at + 8))
            if tag == 10 then
                found_tables.string_size = double_at(image, at + 8)
            elsif place < u64(lenof image) then
                if tag == 4 then found_tables.hash = place
                elsif tag == 0x6ffffef5 then found_tables.gnu_hash = place
                elsif tag == 5 then found_tables.strings = place
                elsif tag == 6 then found_tables.symbols = place
                elsif tag == 0x6ffffff0 then found_tables.versions = place
                elsif tag == 0x6ffffffc then found_tables.definitions = place
                end if
            end if
        end for
        return when found_tables.strings == 0 or found_tables.symbols == 0
        length: u64 = u64(lenof image)
        if found_tables.string_size == 0
          or not fits(image, found_tables.strings, found_tables.string_size)
        then
            found_tables.string_size = length - found_tables.strings
        end if
        versioned: bool = found_tables.versions <> 0
                          and found_tables.definitions <> 0
        count: u64 = symbol_count(image, found_tables)
        return when count > length / 24
          or not fits(image, found_tables.symbols, count * 24)
        for index in u64(0)..<count do
            at: u64 = found_tables.symbols + index * 24
            information: u64 = u64(image[usize(at + 4)])
            binding: u64 = information >> 4
            section: u64 = half_at(image, at + 6)
            defined: bool = section <> 0 and (information & 15) == 2
                            and (binding == 1 or binding == 2)
            if defined and string_is(image, found_tables.strings,
                                     found_tables.string_size,
                                     word_at(image, at), name)
              and (not versioned
                   or has_version(image, found_tables, index, version)) then
                place: u64 = placed(image, load_offset, load_address,
                                    double_at(image, at + 8))
                if place < length then
                    found = true
                    offset = usize(place)
                    return
                end if
            end if
        end for
    end vdso_find

    --  What `vdso_image` gives when there is no vDSO.
    no_image: [1]u8 = [0]

    --  The `length` bytes the kernel mapped at `first`, which is not zero.
    mapped: (first: usize, length: usize) -> (bytes: []u8) =
        whole: ptr [1]u8 = ptr(first)
        bytes = whole.val[0..<0]
        if length > 0 then
            unchecked begin
                bytes = whole.val[0..<length]
            end unchecked
        end if
    end mapped

    --- The vDSO as the kernel mapped it: whether the auxiliary vector
    --- names one, and its bytes, as far as its first load segment reaches
    --- and no further than `vdso_largest`.  There is none when the C
    --- runtime started the program, whose auxiliary vector `auxiliary`
    --- does not see, or when the image's first page does not describe a
    --- load segment.
    public link(symbol: "_landin_linux_vdso_image") vdso_image:
        () -> (found: bool, image: []u8) =
        (found: named, value: base) := auxiliary(at_sysinfo_ehdr)
        found = false
        image = no_image[0..<0]
        return when not named or base == 0
        page: []u8 = mapped(usize(base), first_page)
        parts: segments = segments_of(page)
        start: u64 = parts.load_offset
        size: u64 = parts.load_size
        largest: u64 = u64(vdso_largest)
        return when not parts.loaded or start > largest
          or size > largest - start or start + size < 64
        image = mapped(usize(base), usize(start + size))
        found = true
    end vdso_image

    --- The address of the vDSO's function `name` of version `version`,
    --- found by `vdso_find` in `vdso_image`: whether it is there, and
    --- where.
    public link(symbol: "_landin_linux_vdso_symbol") vdso_symbol:
        (name: []u8, version: []u8) -> (found: bool, address: usize) =
        (found: present, image) := vdso_image()
        found = false
        address = 0
        return when not present
        (found: named, offset) := vdso_find(image, name, version)
        (found: _, value: base) := auxiliary(at_sysinfo_ehdr)
        found = named
        if named then address = usize(base) + offset end if
    end vdso_symbol
end if
