--  The numbers of the calls platform/linux's wrappers make, generated by
--  scripts/linux_syscalls.py from Linux 7.2 with the module
--  platform/linux/numbers, whose header names the release.  Do not edit
--  it: the generator finds the names the module's other files use.

fixed if compiler.os == linux then
    fixed if compiler.arch == x86_64 then
        read_number: i64 = 0
        write_number: i64 = 1
        close_number: i64 = 3
        mmap_number: i64 = 9
        munmap_number: i64 = 11
        getdents64_number: i64 = 217
        exit_group_number: i64 = 231
        openat_number: i64 = 257
        mkdirat_number: i64 = 258
        unlinkat_number: i64 = 263
        ppoll_number: i64 = 271
        statx_number: i64 = 332
    elsif compiler.arch == arm64 then
        mkdirat_number: i64 = 34
        unlinkat_number: i64 = 35
        openat_number: i64 = 56
        close_number: i64 = 57
        getdents64_number: i64 = 61
        read_number: i64 = 63
        write_number: i64 = 64
        ppoll_number: i64 = 73
        exit_group_number: i64 = 94
        munmap_number: i64 = 215
        mmap_number: i64 = 222
        statx_number: i64 = 291
    elsif compiler.arch == rv64 then
        mkdirat_number: i64 = 34
        unlinkat_number: i64 = 35
        openat_number: i64 = 56
        close_number: i64 = 57
        getdents64_number: i64 = 61
        read_number: i64 = 63
        write_number: i64 = 64
        ppoll_number: i64 = 73
        exit_group_number: i64 = 94
        munmap_number: i64 = 215
        mmap_number: i64 = 222
        riscv_hwprobe_number: i64 = 258
        statx_number: i64 = 291
    end if
end if
