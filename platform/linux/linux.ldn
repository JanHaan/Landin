--  Linux's system-call interface, on x86-64, arm64 and RV64, with no C
--  library beneath it.  Linux promises this interface, so a Linux program
--  reaches the kernel directly: each call is one assembly block, and a
--  failure comes back in the result as minus the errno, with no errno cell.
--  The `*at` calls and `statx` keep one record layout on all three
--  architectures.  The module also holds the program-owned process entry,
--  `_landin_start`, which a static Linux executable starts at.  It is the
--  system's own interface, raw: platform/posix gives the same facilities in
--  Landin types, over these calls on Linux and over platform/libc on Darwin
--  and FreeBSD.
--
--  Every call is public by number: `system_call` is the raw six-argument
--  call, and the module platform/linux/numbers, generated from a pinned
--  kernel release by scripts/linux_syscalls.py, names each call's number as
--  its kernel name followed by `_number`.  It is a module of its own so
--  that a program that makes no raw call does not compile a thousand
--  declarations.  The typed wrappers below cover the calls the library
--  itself makes; their numbers are wrapped.ldn's, which the same generator
--  writes from the same tables.
--
--  Only the process entry `_landin_start` and the C routine
--  `_landin_start_main` it calls are global symbols (D415): every other
--  routine is local, so none is mistaken for, or replaces, the C
--  library's function of the same name in a program that also links libc.
--
--  Everything here is declared on Linux only.  Landin has no conditional
--  import, so platform/posix imports this module on every system it
--  serves, and the module's scope is theirs: Linux, Darwin and FreeBSD.
--  On Darwin and FreeBSD it declares nothing.

compiler.assert(compiler.os == linux or compiler.os == darwin
                or compiler.os == freebsd)

fixed if compiler.os == linux then
    fixed if compiler.arch == x86_64 then
        --- Make the system call `number` with six arguments, unused ones
        --- zero, and return the kernel's result: a failure is minus its
        --- errno, from -4095 to -1.  This is the raw route to every Linux
        --- call: the module platform/linux/numbers names each call's number,
        --- `numbers.getpid_number` for one.  A pointer goes as
        --- `i64(usize(p))`, and nothing checks an argument's type, so
        --- prefer a typed wrapper where there is one.
        ---
        --- rax names the call and carries its result; rdi, rsi, rdx, r10,
        --- r8 and r9 carry its arguments; the kernel overwrites rcx and r11.
        public system_call:
            (number: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64)
            -> (result: i64) =
            result = assembler.block("syscall", inout n: i64 at rax = number,
                                     in p: i64 at rdi = a,
                                     in q: i64 at rsi = b,
                                     in r: i64 at rdx = c,
                                     in s: i64 at r10 = d,
                                     in t: i64 at r8 = e,
                                     in u: i64 at r9 = f, out _ at rcx,
                                     out _ at r11)
        end system_call

        --- `openat` flag: fail with ENOTDIR unless `path` names a
        --- directory.  arm64 keeps a value of its own.
        public o_directory: i32 = 65536

        --- The process entry: the kernel starts a static Linux executable
        --- here, with argc on top of the stack and no return address.  It
        --- clears the frame pointer so a debugger stops at this frame,
        --- aligns the stack to sixteen bytes and calls
        --- `_landin_start_main` with the initial stack's address.
        public extern(naked) _landin_start: () -> none =
            assembler.block("xorl %ebp, %ebp\nmovq %rsp, %rdi\nandq $-16, %rsp\ncall _landin_start_main")
        end _landin_start
    elsif compiler.arch == arm64 then
        --- Make the system call `number` with six arguments, unused ones
        --- zero, and return the kernel's result: a failure is minus its
        --- errno, from -4095 to -1.  This is the raw route to every Linux
        --- call: the module platform/linux/numbers names each call's number,
        --- `numbers.getpid_number` for one.  A pointer goes as
        --- `i64(usize(p))`, and nothing checks an argument's type, so
        --- prefer a typed wrapper where there is one.
        ---
        --- x8 names the call; x0 to x5 carry its arguments and x0 its
        --- result.
        public system_call:
            (number: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64)
            -> (result: i64) =
            result = assembler.block("svc #0", in n: i64 at x8 = number,
                                     inout p: i64 at x0 = a,
                                     in q: i64 at x1 = b,
                                     in r: i64 at x2 = c,
                                     in s: i64 at x3 = d,
                                     in t: i64 at x4 = e,
                                     in u: i64 at x5 = f)
        end system_call

        --- `openat` flag: fail with ENOTDIR unless `path` names a
        --- directory.  arm64 keeps a value of its own.
        public o_directory: i32 = 16384

        --- The process entry: the kernel starts a static Linux executable
        --- here, with argc at the sixteen-byte-aligned stack pointer and no
        --- return address.  It clears the frame and link registers so a
        --- debugger stops at this frame and calls `_landin_start_main` with
        --- the initial stack's address.
        public extern(naked) _landin_start: () -> none =
            assembler.block("mov x29, #0\nmov x30, #0\nmov x0, sp\nbl _landin_start_main")
        end _landin_start
    else
        --- Make the system call `number` with six arguments, unused ones
        --- zero, and return the kernel's result: a failure is minus its
        --- errno, from -4095 to -1.  This is the raw route to every Linux
        --- call: the module platform/linux/numbers names each call's number,
        --- `numbers.getpid_number` for one.  A pointer goes as
        --- `i64(usize(p))`, and nothing checks an argument's type, so
        --- prefer a typed wrapper where there is one.
        ---
        --- a7 names the call; a0 to a5 carry its arguments and a0 its
        --- result.
        public system_call:
            (number: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64)
            -> (result: i64) =
            result = assembler.block("ecall", in n: i64 at x17 = number,
                                     inout p: i64 at x10 = a,
                                     in q: i64 at x11 = b,
                                     in r: i64 at x12 = c,
                                     in s: i64 at x13 = d,
                                     in t: i64 at x14 = e,
                                     in u: i64 at x15 = f)
        end system_call

        --- `openat` flag: fail with ENOTDIR unless `path` names a
        --- directory.  arm64 keeps a value of its own.
        public o_directory: i32 = 65536

        --- The process entry: the kernel starts a static Linux executable
        --- here, with argc on top of the stack and no return address.  It
        --- clears the frame pointer and return address so a debugger stops
        --- at this frame, aligns the stack to sixteen bytes and calls
        --- `_landin_start_main` with the initial stack's address.
        public extern(naked) _landin_start: () -> none =
            assembler.block("li x8, 0\nli ra, 0\nmv a0, sp\nandi sp, sp, -16\ncall _landin_start_main")
        end _landin_start
    end if

    --- The directory descriptor that makes an `*at` call's relative path
    --- relative to the working directory.
    public at_fdcwd: i32 = -100

    --- `openat` flag: read only.
    public o_rdonly: i32 = 0
    --- `openat` flag: write only.
    public o_wronly: i32 = 1
    --- `openat` flag: read and write.
    public o_rdwr: i32 = 2
    --- `openat` flag: create the file if it does not exist.
    public o_creat: i32 = 64
    --- `openat` flag: with `o_creat`, fail with EEXIST if the name is
    --- taken.
    public o_excl: i32 = 128
    --- `openat` flag: truncate an existing regular file to length zero.
    public o_trunc: i32 = 512
    --- `openat` flag: every write goes to the end of the file.
    public o_append: i32 = 1024

    --- `statx` flag: report a symbolic link itself rather than what it
    --- names.
    public at_symlink_nofollow: i32 = 256
    --- `unlinkat` flag: remove an empty directory rather than a file.
    public at_removedir: i32 = 512

    --- errno: the operation is not permitted.
    public eperm: i32 = 1
    --- errno: no such file or directory.
    public enoent: i32 = 2
    --- errno: interrupted by a signal before anything was transferred.
    public eintr: i32 = 4
    --- errno: permission denied.
    public eacces: i32 = 13
    --- errno: a path component is not a directory.
    public enotdir: i32 = 20
    --- errno: the name already exists.
    public eexist: i32 = 17
    --- errno: the file system is read-only.
    public erofs: i32 = 30

    --- `mmap` protection: the pages may be read.
    public prot_read: i32 = 1
    --- `mmap` protection: the pages may be written.
    public prot_write: i32 = 2
    --- `mmap` flag: the mapping is private to this process.
    public map_private: i32 = 2
    --- `mmap` flag: the mapping is backed by no file and starts zeroed.
    public map_anonymous: i32 = 32
    --- `mremap` flag: the mapping may move when it cannot grow in place.
    public mremap_maymove: i32 = 1

    --- `statx` mask: the file's type, in `mode`'s top bits.
    public statx_type: u32 = 1
    --- `statx` mask: the inode number, beside the basic fields every call
    --- fills.
    public statx_ino: u32 = 256
    --- `statx` mask: the size in bytes.
    public statx_size: u32 = 512

    --- A `statx` time: whole seconds and the nanoseconds after them.
    public statx_time: type = struct
        seconds: i64
        nanoseconds: u32
        reserved: i32
    end statx_time

    --- The kernel's `struct statx`, one layout on every architecture.  The
    --- device is `device_major` and `device_minor`; `mask` says which other
    --- fields the call filled.
    public file_status: type = struct
        mask: u32
        block_size: u32
        attributes: u64
        links: u32
        uid: u32
        gid: u32
        mode: u16
        spare0: u16
        inode: u64
        size: u64
        blocks: u64
        attributes_mask: u64
        accessed: statx_time
        born: statx_time
        changed: statx_time
        modified: statx_time
        special_device_major: u32
        special_device_minor: u32
        device_major: u32
        device_minor: u32
        mount_id: u64
        spare: [13]u64
    end file_status

    --- Read at most `length` bytes from `descriptor` into `data`: the
    --- count read, zero at end of file, or minus the errno.
    public read:
        (descriptor: i32, data: ptr mut u8, length: usize) -> (result: isize) =
        result = isize(system_call(read_number, i64(descriptor),
                                   i64(usize(data)), i64(length), 0, 0, 0))
    end read

    --- Write at most `length` bytes from `data` to `descriptor`: the count
    --- accepted, which may be short, or minus the errno.
    public write:
        (descriptor: i32, data: ptr u8, length: usize) -> (result: isize) =
        result = isize(system_call(write_number, i64(descriptor),
                                   i64(usize(data)), i64(length), 0, 0, 0))
    end write

    --- Open `path`, relative to `directory` (or `at_fdcwd`), with `flags`
    --- and, for `o_creat`, the permission bits `mode`: the new descriptor,
    --- or minus the errno.
    public openat:
        (directory: i32, path: ptr u8, flags: i32, mode: u32)
        -> (result: i32) =
        result = i32(system_call(openat_number, i64(directory),
                                 i64(usize(path)), i64(flags), i64(mode), 0,
                                 0))
    end openat

    --- Close `descriptor`: zero, or minus the errno.  The descriptor is
    --- released even when this fails, so a failed close is never retried.
    public close:
        (descriptor: i32) -> (result: i32) =
        result = i32(system_call(close_number, i64(descriptor), 0, 0, 0, 0,
                                 0))
    end close

    --- Fill `into` with the status of `path`, relative to `directory`:
    --- zero, or minus the errno.  `flags` zero follows symbolic links and
    --- `at_symlink_nofollow` does not; `mask` asks for fields beyond the
    --- basic ones.
    public statx:
        (directory: i32, path: ptr u8, flags: i32, mask: u32,
         into: ptr mut file_status) -> (result: i32) =
        result = i32(system_call(statx_number, i64(directory),
                                 i64(usize(path)), i64(flags), i64(mask),
                                 i64(usize(into)), 0))
    end statx

    --- Fill at most `length` bytes at `into` with the next records of the
    --- directory open as `descriptor`: the bytes filled, zero at the end of
    --- the directory, or minus the errno, EINVAL when not even one record
    --- fits.  A record is the entry's inode as a `u64`, an offset as an
    --- `i64`, its own length as a `u16` at byte 16, the entry's type as a
    --- `u8` at byte 18, and its NUL-terminated name from byte 19, padded
    --- to a multiple of eight; it is little-endian on every architecture
    --- Linux runs Landin on.  The records come in no promised order and
    --- include `.` and `..`.
    public getdents64:
        (descriptor: i32, into: ptr mut u8, length: usize) -> (result: isize) =
        result = isize(system_call(getdents64_number, i64(descriptor),
                                   i64(usize(into)), i64(length), 0, 0, 0))
    end getdents64

    --- Make the directory `path`, relative to `directory` (or `at_fdcwd`),
    --- with the permission bits `mode`, which the process umask filters:
    --- zero, or minus the errno, EEXIST when the name is taken.
    public mkdirat:
        (directory: i32, path: ptr u8, mode: u32) -> (result: i32) =
        result = i32(system_call(mkdirat_number, i64(directory),
                                 i64(usize(path)), i64(mode), 0, 0, 0))
    end mkdirat

    --- Remove the name `path`, relative to `directory` (or `at_fdcwd`): a
    --- file with `flags` zero, an empty directory with `at_removedir`.
    --- Zero, or minus the errno.
    public unlinkat:
        (directory: i32, path: ptr u8, flags: i32) -> (result: i32) =
        result = i32(system_call(unlinkat_number, i64(directory),
                                 i64(usize(path)), i64(flags), 0, 0, 0))
    end unlinkat

    --- Map `length` bytes: the mapping's address, or minus the errno.
    --- With `map_anonymous` the descriptor is -1 and the offset zero.
    public mmap:
        (address: usize, length: usize, protection: i32, flags: i32,
         descriptor: i32, offset: i64) -> (result: i64) =
        result = system_call(mmap_number, i64(address), i64(length),
                             i64(protection), i64(flags), i64(descriptor),
                             offset)
    end mmap

    --- Unmap the `length` bytes at `address`: zero, or minus the errno.
    public munmap:
        (address: usize, length: usize) -> (result: i32) =
        result = i32(system_call(munmap_number, i64(address), i64(length), 0,
                                 0, 0, 0))
    end munmap

    --- Make the mapping of `length` bytes at `address` `new_length` bytes
    --- long: where it is, or with `mremap_maymove` wherever the kernel
    --- finds room, its pages moved rather than copied.  The mapping's
    --- address, or minus the errno.
    public mremap:
        (address: usize, length: usize, new_length: usize, flags: i32)
        -> (result: i64) =
        result = system_call(mremap_number, i64(address), i64(length),
                             i64(new_length), i64(flags), 0, 0)
    end mremap

    --- One record `ppoll` reads and fills, the kernel's `struct pollfd`:
    --- the descriptor to watch, the events asked about and the events that
    --- happened.  A negative descriptor is ignored.
    public poll_record: type = struct
        descriptor: i32
        events: i16
        returned: i16
    end poll_record

    --- A `ppoll` time limit, the kernel's `struct __kernel_timespec`: whole
    --- seconds and the nanoseconds after them.
    public timespec: type = struct
        seconds: i64
        nanoseconds: i64
    end timespec

    --- What `ppoll` takes for no time limit: C's null pointer, so the
    --- call waits until a record is ready.
    public no_limit: atom

    --- A `ppoll` time limit, or `no_limit`.  The kernel writes the time
    --- that was left back into the limit, so it is writable.
    public poll_limit: type = no_limit | ptr mut timespec

    --- Wait until one of the `count` records at `records` has an event or
    --- `limit` passes, with no signal mask: the number of records whose
    --- `returned` is nonzero, zero when the limit passed first, or minus
    --- the errno.  arm64 and RV64 have no `poll` call; this is their one.
    public ppoll:
        (records: ptr mut poll_record, count: usize, limit: poll_limit)
        -> (result: i32) =
        address: usize = match limit
            no_limit: usize(0)
            ptr (given): usize(given)
        end match
        result = i32(system_call(ppoll_number, i64(usize(records)),
                                 i64(count), i64(address), 0, 8, 0))
    end ppoll

    --- `openat`, `pipe2` and `dup3` flag: the new descriptor is closed when
    --- the process executes a program, set with the descriptor so no
    --- other thread's exec can see it without.  The same on every
    --- architecture.
    public o_cloexec: i32 = 524288

    --- `fcntl` command: read a descriptor's flags, `fd_cloexec` among them.
    public f_getfd: i32 = 1
    --- `fcntl` command: set a descriptor's flags, `fd_cloexec` among them.
    public f_setfd: i32 = 2
    --- `fcntl` flag: the descriptor is closed when the process executes a
    --- program.
    public fd_cloexec: i32 = 1
    --- `fcntl` command: duplicate a descriptor onto the lowest free number
    --- at or above the argument, closed on exec.
    public f_dupfd_cloexec: i32 = 1030

    --- `close_range` flag: mark the descriptors closed on exec rather than
    --- closing them now.
    public close_range_cloexec: u32 = 4

    --- The signal a child sends its parent when it ends, SIGCHLD, which
    --- `clone` takes as the child's exit signal.  The same on every
    --- architecture.
    public sigchld: i64 = 17

    --- Make a pipe and put its reading end in `ends[0]` and its writing end
    --- in `ends[1]`, with `flags`, `o_cloexec` among them: zero, or minus
    --- the errno.
    public pipe2:
        (ends: ptr mut i32, flags: i32) -> (result: i32) =
        result = i32(system_call(pipe2_number, i64(usize(ends)), i64(flags),
                                 0, 0, 0, 0))
    end pipe2

    --- Make `target` a duplicate of `source`, closing what `target` was,
    --- with `flags`: `target`, or minus the errno, EINVAL when the two are
    --- the same.  arm64 and RV64 have no `dup2`; this is every
    --- architecture's.
    public dup3:
        (source: i32, target: i32, flags: i32) -> (result: i32) =
        result = i32(system_call(dup3_number, i64(source), i64(target),
                                 i64(flags), 0, 0, 0))
    end dup3

    --- `fcntl(descriptor, command, argument)` for a command whose argument
    --- is an integer: its result, or minus the errno.
    public fcntl:
        (descriptor: i32, command: i32, argument: i64) -> (result: i32) =
        result = i32(system_call(fcntl_number, i64(descriptor),
                                 i64(command), argument, 0, 0, 0))
    end fcntl

    --- Make a child process that is a copy of this one, POSIX's `fork`,
    --- through `clone` with `sigchld` as its exit signal and nothing
    --- shared: the child's process ID in the parent, zero in the child,
    --- or minus the errno.  The child is a copy of the whole address space,
    --- and of the calling thread alone.  arm64 and RV64 have no `fork`;
    --- this is every architecture's.
    public fork:
        () -> (result: i64) =
        result = system_call(clone_number, sigchld, 0, 0, 0, 0, 0)
    end fork

    --- Replace this process's program with the one at `path`, given the
    --- NUL-terminated strings of the null-terminated `arguments` and
    --- `environment` tables: it does not return when it succeeds, and
    --- returns minus the errno when it fails.
    public execve:
        (path: ptr u8, arguments: ptr ptr u8, environment: ptr ptr u8)
        -> (result: i32) =
        result = i32(system_call(execve_number, i64(usize(path)),
                                 i64(usize(arguments)),
                                 i64(usize(environment)), 0, 0, 0))
    end execve

    --- Wait for the child `child` to end, or with `options` for less, and
    --- put its status in `status`, with no resource record: the child's ID,
    --- or minus the errno, ECHILD when it is not this process's child.
    public wait4:
        (child: i32, status: ptr mut i32, options: i32) -> (result: i32) =
        result = i32(system_call(wait4_number, i64(child),
                                 i64(usize(status)), i64(options), 0, 0, 0))
    end wait4

    --- Close, or with `close_range_cloexec` mark closed on exec, the
    --- descriptors from `first` to `last`: zero, or minus the errno, ENOSYS
    --- from a kernel older than 5.9 and EINVAL for a flag older than 5.11.
    public close_range:
        (first: u32, last: u32, flags: u32) -> (result: i32) =
        result = i32(system_call(close_range_number, i64(first), i64(last),
                                 i64(flags), 0, 0, 0))
    end close_range

    --- `clock_gettime` and `clock_nanosleep` clock: the wall clock, UTC
    --- seconds and nanoseconds since 1970 as the system keeps it, which may
    --- be set and so jump either way.  The same on every architecture.
    public clock_realtime: i32 = 0
    --- `clock_gettime` and `clock_nanosleep` clock: time since the system
    --- started, counted at a steady rate and never set back.  The same on
    --- every architecture.
    public clock_monotonic: i32 = 1

    --- Fill `into` with the clock `clock`'s time: zero, or minus the errno,
    --- EINVAL for a clock the kernel does not have.  This is the system
    --- call itself; the vDSO's `clock_gettime`, which `vdso.symbol` finds,
    --- answers the same without entering the kernel.
    public clock_gettime:
        (clock: i32, into: ptr mut timespec) -> (result: i32) =
        result = i32(system_call(clock_gettime_number, i64(clock),
                                 i64(usize(into)), 0, 0, 0, 0))
    end clock_gettime

    --- Sleep for the time `request` gives, measured on the clock `clock`,
    --- relative to now when `flags` is zero: zero once it has passed, or
    --- minus the errno, EINTR when a signal came first, with what was left
    --- of the request in `remaining`.
    public clock_nanosleep:
        (clock: i32, flags: i32, request: ptr timespec,
         remaining: ptr mut timespec) -> (result: i32) =
        result = i32(system_call(clock_nanosleep_number, i64(clock),
                                 i64(flags), i64(usize(request)),
                                 i64(usize(remaining)), 0, 0))
    end clock_nanosleep

    --  `futex` operations on a word only this process maps: FUTEX_WAIT and
    --  FUTEX_WAKE with FUTEX_PRIVATE_FLAG.  The same on every architecture.
    futex_wait_private: i64 = 128
    futex_wake_private: i64 = 129

    --- A `futex_wait` time limit: `no_limit`, or the span to wait at most,
    --- measured on the monotonic clock.
    public futex_limit: type = no_limit | ptr timespec

    --- Sleep while the word at `word`, which only this process maps, holds
    --- `expected`, until `futex_wake` wakes it, a signal comes or `limit`
    --- passes: zero when woken, which may be spuriously, or minus the
    --- errno, EAGAIN at once when the word does not hold `expected`,
    --- ETIMEDOUT when the limit passed and EINTR for a signal.  The kernel
    --- compares and sleeps in one step, so a wake after the word changed
    --- is never lost.
    public futex_wait:
        (word: ptr u32, expected: u32, limit: futex_limit) -> (result: i32) =
        address: usize = match limit
            no_limit: usize(0)
            ptr (given): usize(given)
        end match
        result = i32(system_call(futex_number, i64(usize(word)),
                                 futex_wait_private, i64(expected),
                                 i64(address), 0, 0))
    end futex_wait

    --- Wake at most `count` of the threads `futex_wait` holds asleep on the
    --- word at `word`: the number woken, or minus the errno.
    public futex_wake: (word: ptr u32, count: i32) -> (result: i32) =
        result = i32(system_call(futex_number, i64(usize(word)),
                                 futex_wake_private, i64(count), 0, 0, 0))
    end futex_wake

    --- `getrandom` flag: fail with EAGAIN rather than wait while the
    --- kernel's random pool is not yet ready, which it is only early in
    --- boot.
    public grnd_nonblock: u32 = 1

    --- Fill at most `length` bytes at `into` with random bytes from the
    --- kernel's pool, waiting at boot until the pool is ready unless
    --- `flags` holds `grnd_nonblock`: the count filled, which a request
    --- over 256 bytes may find short, or minus the errno, EINTR when a
    --- signal came before any byte.
    public getrandom:
        (into: ptr mut u8, length: usize, flags: u32) -> (result: isize) =
        result = isize(system_call(getrandom_number, i64(usize(into)),
                                   i64(length), i64(flags), 0, 0, 0))
    end getrandom

    --- Read at most `length` bytes from `descriptor` into `data`, starting
    --- `offset` bytes into the file, without moving its position: the
    --- count read, zero at or past its end, or minus the errno, ESPIPE for
    --- a pipe or a socket, which has no offsets.
    public pread64:
        (descriptor: i32, data: ptr mut u8, length: usize, offset: i64)
        -> (result: isize) =
        result = isize(system_call(pread64_number, i64(descriptor),
                                   i64(usize(data)), i64(length), offset, 0,
                                   0))
    end pread64

    --- Write at most `length` bytes from `data` to `descriptor`, starting
    --- `offset` bytes into the file, without moving its position: the
    --- count accepted, or minus the errno.  A write past the end extends
    --- the file, and what lies between reads as zeros.  On a file opened
    --- with `o_append` Linux writes at the end whatever `offset` says.
    public pwrite64:
        (descriptor: i32, data: ptr u8, length: usize, offset: i64)
        -> (result: isize) =
        result = isize(system_call(pwrite64_number, i64(descriptor),
                                   i64(usize(data)), i64(length), offset, 0,
                                   0))
    end pwrite64

    --- Give the file open as `descriptor` the size `length`, cutting what
    --- lies beyond it or extending it with zeros: zero, or minus the errno.
    public ftruncate:
        (descriptor: i32, length: i64) -> (result: i32) =
        result = i32(system_call(ftruncate_number, i64(descriptor), length,
                                 0, 0, 0, 0))
    end ftruncate

    --- Write what the system holds of the file open as `descriptor` to its
    --- device, its data and its status: zero, or minus the errno.
    public fsync:
        (descriptor: i32) -> (result: i32) =
        result = i32(system_call(fsync_number, i64(descriptor), 0, 0, 0, 0,
                                 0))
    end fsync

    --- `fsync` of the data alone, and of the status only where reading the
    --- data back needs it, as a size does: zero, or minus the errno.
    public fdatasync:
        (descriptor: i32) -> (result: i32) =
        result = i32(system_call(fdatasync_number, i64(descriptor), 0, 0, 0,
                                 0, 0))
    end fdatasync

    --- Put the working directory's absolute path, with a NUL after it, in
    --- the `length` bytes at `into`: the bytes put there, NUL included, or
    --- minus the errno, ERANGE when they do not fit.
    public getcwd:
        (into: ptr mut u8, length: usize) -> (result: isize) =
        result = isize(system_call(getcwd_number, i64(usize(into)),
                                   i64(length), 0, 0, 0, 0))
    end getcwd

    --- Give the file `old`, relative to `old_directory`, the name `new`,
    --- relative to `new_directory`, with `flags`, zero for POSIX's
    --- `renameat`: a file already named `new` is replaced in the one step.
    --- Zero, or minus the errno, EXDEV across file systems.  arm64 and RV64
    --- have no `rename`; this is every architecture's.
    public renameat2:
        (old_directory: i32, old: ptr u8, new_directory: i32, new: ptr u8,
         flags: u32) -> (result: i32) =
        result = i32(system_call(renameat2_number, i64(old_directory),
                                 i64(usize(old)), i64(new_directory),
                                 i64(usize(new)), i64(flags), 0))
    end renameat2

    --- Give the file `old`, relative to `old_directory`, a second name
    --- `new`, relative to `new_directory`, a hard link, not following a
    --- final symbolic link of `old` unless `flags` holds
    --- `at_symlink_follow`: zero, or minus the errno, EEXIST when `new` is
    --- taken.
    public linkat:
        (old_directory: i32, old: ptr u8, new_directory: i32, new: ptr u8,
         flags: i32) -> (result: i32) =
        result = i32(system_call(linkat_number, i64(old_directory),
                                 i64(usize(old)), i64(new_directory),
                                 i64(usize(new)), i64(flags), 0))
    end linkat

    --- Make `path`, relative to `directory`, a symbolic link whose target is
    --- `target`, which need name nothing: zero, or minus the errno, EEXIST
    --- when `path` is taken.
    public symlinkat:
        (target: ptr u8, directory: i32, path: ptr u8) -> (result: i32) =
        result = i32(system_call(symlinkat_number, i64(usize(target)),
                                 i64(directory), i64(usize(path)), 0, 0, 0))
    end symlinkat

    --- Put the target of the symbolic link `path`, relative to `directory`,
    --- in at most `length` bytes at `into`, with no NUL after it: the bytes
    --- put there, as many as fit, or minus the errno, EINVAL when `path` is
    --- no symbolic link.
    public readlinkat:
        (directory: i32, path: ptr u8, into: ptr mut u8, length: usize)
        -> (result: isize) =
        result = isize(system_call(readlinkat_number, i64(directory),
                                   i64(usize(path)), i64(usize(into)),
                                   i64(length), 0, 0))
    end readlinkat

    --- Set the permission bits of the file `path` names, relative to
    --- `directory`, following a final symbolic link, to `mode`: zero, or
    --- minus the errno, EPERM when the process neither owns the file nor
    --- may override that.  The call takes no flags.
    public fchmodat:
        (directory: i32, path: ptr u8, mode: u32) -> (result: i32) =
        result = i32(system_call(fchmodat_number, i64(directory),
                                 i64(usize(path)), i64(mode), 0, 0, 0))
    end fchmodat

    --- Set the permission bits of the file open as `descriptor` to `mode`:
    --- zero, or minus the errno.
    public fchmod:
        (descriptor: i32, mode: u32) -> (result: i32) =
        result = i32(system_call(fchmod_number, i64(descriptor), i64(mode),
                                 0, 0, 0, 0))
    end fchmod

    --- Set the owner and group of the file `path` names, relative to
    --- `directory`, to `user` and `group`, either left as it is when it is
    --- `0xFFFFFFFF`; a final symbolic link is followed unless `flags` holds
    --- `at_symlink_nofollow`.  Zero, or minus the errno, EPERM unless the
    --- process may.
    public fchownat:
        (directory: i32, path: ptr u8, user: u32, group: u32, flags: i32)
        -> (result: i32) =
        result = i32(system_call(fchownat_number, i64(directory),
                                 i64(usize(path)), i64(user), i64(group),
                                 i64(flags), 0))
    end fchownat

    --- Set the owner and group of the file open as `descriptor`, as
    --- `fchownat` does: zero, or minus the errno.
    public fchown:
        (descriptor: i32, user: u32, group: u32) -> (result: i32) =
        result = i32(system_call(fchown_number, i64(descriptor), i64(user),
                                 i64(group), 0, 0, 0))
    end fchown

    --- What `utimensat` takes for a path it is not given: C's null
    --- pointer, so the call sets the times of the descriptor itself.
    public no_path: atom
    --- A path a call may be given, or `no_path`.
    public path_given: type = no_path | ptr u8

    --- Set the last access and modification times of the file `path`
    --- names, relative to `directory`, or of `directory` itself when the
    --- path is `no_path`, to the two `timespec`s at `times`, access first:
    --- zero, or minus the errno.  A final symbolic link is followed unless
    --- `flags` holds `at_symlink_nofollow`, which sets the link's own.
    public utimensat:
        (directory: i32, path: path_given, times: ptr timespec, flags: i32)
        -> (result: i32) =
        named: i64 = match path
            no_path: i64(0)
            ptr (given): i64(usize(given))
        end match
        result = i32(system_call(utimensat_number, i64(directory), named,
                                 i64(usize(times)), i64(flags), 0, 0))
    end utimensat

    --- Take, change or give up the whole-file lock on the open file
    --- `descriptor` belongs to, as `operation` says: `lock_sh` or `lock_ex`,
    --- with `lock_nb` not to wait for it, or `lock_un`.  Zero, or minus the
    --- errno, EWOULDBLOCK when another open file holds it and `lock_nb`
    --- was given.
    public flock:
        (descriptor: i32, operation: i32) -> (result: i32) =
        result = i32(system_call(flock_number, i64(descriptor),
                                 i64(operation), 0, 0, 0, 0))
    end flock

    --- `ioctl(descriptor, request, argument)`, the argument an integer or
    --- a pointer as `i64(usize(p))`: its result, or minus the errno,
    --- ENOTTY when the request is not one for this kind of file.
    public ioctl:
        (descriptor: i32, request: u64, argument: i64) -> (result: i32) =
        result = i32(system_call(ioctl_number, i64(descriptor), i64(request),
                                 argument, 0, 0, 0))
    end ioctl

    --- The process's real user ID.  It cannot fail.
    public getuid: () -> (user: u32) =
        user = u32(system_call(getuid_number, 0, 0, 0, 0, 0, 0))
    end getuid

    --- The process's effective user ID, which permission checks use.
    public geteuid: () -> (user: u32) =
        user = u32(system_call(geteuid_number, 0, 0, 0, 0, 0, 0))
    end geteuid

    --- The process's real group ID.
    public getgid: () -> (group: u32) =
        group = u32(system_call(getgid_number, 0, 0, 0, 0, 0, 0))
    end getgid

    --- The process's effective group ID.
    public getegid: () -> (group: u32) =
        group = u32(system_call(getegid_number, 0, 0, 0, 0, 0, 0))
    end getegid

    --- `linkat` flag: follow a final symbolic link of the old path.
    public at_symlink_follow: i32 = 1024
    --- `statx` flag: with an empty path, the status of the directory
    --- descriptor itself, which may be any open file.
    public at_empty_path: i32 = 4096
    --- `statx` mask: every field POSIX's `stat` gives, the type, mode,
    --- links, owner, group, times, inode, size and blocks.
    public statx_basic_stats: u32 = 2047
    --- `openat` flag: a terminal opened does not become the process's
    --- controlling terminal.
    public o_noctty: i32 = 256

    --- `flock` operation: a shared lock.
    public lock_sh: i32 = 1
    --- `flock` operation: an exclusive lock.
    public lock_ex: i32 = 2
    --- `flock` flag: fail at once rather than wait for the lock.
    public lock_nb: i32 = 4
    --- `flock` operation: give the lock up.
    public lock_un: i32 = 8

    --- `fcntl` command: say whether a lock described by a `lock_record`
    --- could be taken, or describe one that stands in its way.
    public f_getlk: i32 = 5
    --- `fcntl` command: take or give up a record lock, failing at once
    --- when another process holds one in its way.
    public f_setlk: i32 = 6
    --- `fcntl` command: take or give up a record lock, waiting for it.
    public f_setlkw: i32 = 7
    --- A record lock's type: shared, for reading.
    public f_rdlck: i16 = 0
    --- A record lock's type: exclusive, for writing.
    public f_wrlck: i16 = 1
    --- A record lock's type: none, to give a lock up.
    public f_unlck: i16 = 2

    --- A record lock, the kernel's `struct flock` on a 64-bit
    --- architecture: its type, where its start counts from (0 for the
    --- file's start), its start and length, zero for as far as the file
    --- will ever reach, and the process that holds it, which `f_getlk`
    --- fills.
    public lock_record: type = struct
        kind: i16
        whence: i16
        padding: i32
        start: i64
        length: i64
        process: i32
        spare: i32
    end lock_record

    --- `ioctl` request: read a terminal's `terminal_record`.
    public tcgets: u64 = 0x5401
    --- `ioctl` request: set a terminal's `terminal_record` at once.
    public tcsets: u64 = 0x5402
    --- `ioctl` request: set it once all written output has been sent.
    public tcsetsw: u64 = 0x5403
    --- `ioctl` request: set it once output has been sent, discarding input
    --- not yet read.
    public tcsetsf: u64 = 0x5404
    --- `ioctl` request: read a terminal's `window_record`.
    public tiocgwinsz: u64 = 0x5413
    --- `ioctl` request: set a terminal's `window_record`.
    public tiocswinsz: u64 = 0x5414
    --- `ioctl` request on a pseudo-terminal's controller: lock or, given
    --- zero, unlock its terminal for opening.
    public tiocsptlck: u64 = 0x40045431
    --- `ioctl` request on a pseudo-terminal's controller: open its
    --- terminal with the `openat` flags given, since Linux 4.13.
    public tiocgptpeer: u64 = 0x5441
    --- `ioctl` request on a pseudo-terminal's controller: put its
    --- terminal's number, the N of /dev/pts/N, in an `i32`.
    public tiocgptn: u64 = 0x80045430

    --- A terminal's settings, the kernel's `struct termios`, which
    --- `tcgets` reads: its input, output, control and local modes, the line
    --- discipline and the control characters, `vtime` and `vmin` among
    --- them.  It is the kernel's record, not the C library's larger one.
    public terminal_record: type = struct
        input_modes: u32
        output_modes: u32
        control_modes: u32
        local_modes: u32
        line: u8
        characters: [19]u8
    end terminal_record

    --- `terminal_record` input mode: ignore a break.
    public ignbrk: u32 = 1
    --- Input mode: a break interrupts.
    public brkint: u32 = 2
    --- Input mode: mark a parity error.
    public parmrk: u32 = 8
    --- Input mode: strip the eighth bit.
    public istrip: u32 = 32
    --- Input mode: read a newline as a carriage return.
    public inlcr: u32 = 64
    --- Input mode: ignore a carriage return.
    public igncr: u32 = 128
    --- Input mode: read a carriage return as a newline.
    public icrnl: u32 = 256
    --- Input mode: XON and XOFF control output.
    public ixon: u32 = 1024
    --- Output mode: process output, a newline written as two bytes.
    public opost: u32 = 1
    --- Control mode: the character size's bits.
    public csize: u32 = 48
    --- Control mode: eight-bit characters.
    public cs8: u32 = 48
    --- Control mode: parity.
    public parenb: u32 = 256
    --- Local mode: the interrupt, quit and suspend characters raise their
    --- signals.
    public isig: u32 = 1
    --- Local mode: input is read a line at a time and may be edited.
    public icanon: u32 = 2
    --- Local mode: input is echoed.
    public echo: u32 = 8
    --- Local mode: a newline is echoed even without `echo`.
    public echonl: u32 = 64
    --- Local mode: the implementation's own input processing.
    public iexten: u32 = 32768
    --- `terminal_record` character index: how long a read waits, in tenths
    --- of a second, outside line mode.
    public vtime: usize = 5
    --- `terminal_record` character index: how few bytes a read returns,
    --- outside line mode.
    public vmin: usize = 6

    --- A terminal's size, `struct winsize`: rows and columns of
    --- characters, and pixels, which most terminals leave zero.
    public window_record: type = struct
        rows: u16
        columns: u16
        width: u16
        height: u16
    end window_record

    --- `socket` domain: Unix-domain sockets, named by a path, AF_UNIX.
    public af_unix: i32 = 1
    --- `socket` domain: IPv4, AF_INET.
    public af_inet: i32 = 2
    --- `socket` domain: IPv6, AF_INET6.
    public af_inet6: i32 = 10
    --- `socket` type: a connected byte stream, TCP over IP.
    public sock_stream: i32 = 1
    --- `socket` type: datagrams, UDP over IP.
    public sock_dgram: i32 = 2
    --- `socket`, `socketpair` and `accept4` flag: the new descriptor is
    --- closed when the process executes a program, set with it.
    public sock_cloexec: i32 = 524288

    --- `sendto` flag: a send to a connection its peer has gone from fails
    --- with EPIPE and raises no SIGPIPE.
    public msg_nosignal: i32 = 16384

    --- `setsockopt` level: the socket itself.
    public sol_socket: i32 = 1
    --- `setsockopt` level: TCP.
    public ipproto_tcp: i32 = 6
    --- `setsockopt` level: IPv6.
    public ipproto_ipv6: i32 = 41
    --- `sol_socket` option, an `i32`: a listener may bind an address that
    --- earlier connections still hold in TIME_WAIT.
    public so_reuseaddr: i32 = 2
    --- `sol_socket` option, read with `getsockopt` as an `i32`: the
    --- socket's pending error, cleared as it is read.
    public so_error: i32 = 4
    --- `sol_socket` option, a `time_limit`: how long a receive waits before
    --- failing with EAGAIN, none when zero.
    public so_rcvtimeo: i32 = 20
    --- `sol_socket` option, a `time_limit`: how long a send waits.
    public so_sndtimeo: i32 = 21
    --- `ipproto_tcp` option, an `i32`: send small segments at once rather
    --- than gathering them, Nagle's algorithm off.
    public tcp_nodelay: i32 = 1
    --- `ipproto_ipv6` option, an `i32`: an IPv6 socket takes IPv6 alone,
    --- never IPv4 through mapped addresses.
    public ipv6_v6only: i32 = 26

    --- `shutdown` side: no more receives.
    public shut_rd: i32 = 0
    --- `shutdown` side: no more sends; the peer reads the end.
    public shut_wr: i32 = 1
    --- `shutdown` side: neither.
    public shut_rdwr: i32 = 2

    --- A socket time limit, the kernel's `struct timeval` on a 64-bit
    --- architecture: whole seconds and the microseconds after them.
    public time_limit: type = struct
        seconds: i64
        microseconds: i64
    end time_limit

    --- What the socket calls take for an address they have none of: C's
    --- null pointer.
    public no_address: atom
    --- An address record a call reads, or `no_address`.
    public address_given: type = no_address | ptr u8
    --- An address record a call fills, or `no_address`.
    public address_filled: type = no_address | ptr mut u8
    --- The cell a call reads a record's room from and writes its length
    --- into, or `no_address`.
    public address_length: type = no_address | ptr mut u32

    --  The address an optional pointer is, zero for none.
    given_address: (given: address_given) -> (address: i64) =
        address = match given
            no_address: i64(0)
            ptr (record): i64(usize(record))
        end match
    end given_address

    filled_address: (filled: address_filled) -> (address: i64) =
        address = match filled
            no_address: i64(0)
            ptr (record): i64(usize(record))
        end match
    end filled_address

    length_address: (cell: address_length) -> (address: i64) =
        address = match cell
            no_address: i64(0)
            ptr (record): i64(usize(record))
        end match
    end length_address

    --- Make a socket of `domain` and `kind`, with `sock_cloexec` among the
    --- kind's flags, for `protocol`, zero for the kind's own: the new
    --- descriptor, or minus the errno, EAFNOSUPPORT for a domain the
    --- kernel does not have.
    public socket:
        (domain: i32, kind: i32, protocol: i32) -> (result: i32) =
        result = i32(system_call(socket_number, i64(domain), i64(kind),
                                 i64(protocol), 0, 0, 0))
    end socket

    --- Make a pair of connected Unix-domain sockets of `kind` and put them
    --- in `ends[0]` and `ends[1]`: zero, or minus the errno.
    public socketpair:
        (domain: i32, kind: i32, protocol: i32, ends: ptr mut i32)
        -> (result: i32) =
        result = i32(system_call(socketpair_number, i64(domain), i64(kind),
                                 i64(protocol), i64(usize(ends)), 0, 0))
    end socketpair

    --- Give `descriptor` the address in the `length` bytes at `address`:
    --- zero, or minus the errno, EADDRINUSE when it is taken.
    public bind:
        (descriptor: i32, address: ptr u8, length: u32) -> (result: i32) =
        result = i32(system_call(bind_number, i64(descriptor),
                                 i64(usize(address)), i64(length), 0, 0, 0))
    end bind

    --- Make the bound stream socket `descriptor` accept connections, with
    --- at most `backlog` waiting, which the kernel caps at its own
    --- `somaxconn`: zero, or minus the errno.
    public listen:
        (descriptor: i32, backlog: i32) -> (result: i32) =
        result = i32(system_call(listen_number, i64(descriptor),
                                 i64(backlog), 0, 0, 0, 0))
    end listen

    --- Take the next connection waiting on `descriptor` as a new socket,
    --- with `flags`, `sock_cloexec` among them, and the peer's address in
    --- `address` when it is given: the new descriptor, or minus the errno.
    public accept4:
        (descriptor: i32, address: address_filled, length: address_length,
         flags: i32) -> (result: i32) =
        result = i32(system_call(accept4_number, i64(descriptor),
                                 filled_address(address),
                                 length_address(length), i64(flags), 0, 0))
    end accept4

    --- Connect `descriptor` to the address in the `length` bytes at
    --- `address`: zero, or minus the errno, ECONNREFUSED when nothing
    --- listens there.
    public connect:
        (descriptor: i32, address: ptr u8, length: u32) -> (result: i32) =
        result = i32(system_call(connect_number, i64(descriptor),
                                 i64(usize(address)), i64(length), 0, 0, 0))
    end connect

    --- Send at most `length` bytes from `data` on `descriptor` with
    --- `flags`, to `address` when it is given and to the connected peer
    --- when it is not: the count sent, which a stream may find short, or
    --- minus the errno.  x86-64 and arm64 have no `send`; this is it.
    public sendto:
        (descriptor: i32, data: ptr u8, length: usize, flags: i32,
         address: address_given, address_size: u32) -> (result: isize) =
        result = isize(system_call(sendto_number, i64(descriptor),
                                   i64(usize(data)), i64(length), i64(flags),
                                   given_address(address),
                                   i64(address_size)))
    end sendto

    --- Receive at most `length` bytes into `data` from `descriptor` with
    --- `flags`, and the sender's address in `address` when it is given:
    --- the count received, zero when a stream's peer has finished sending,
    --- or minus the errno, EAGAIN when the receive time limit passed.
    public recvfrom:
        (descriptor: i32, data: ptr mut u8, length: usize, flags: i32,
         address: address_filled, address_size: address_length)
        -> (result: isize) =
        result = isize(system_call(recvfrom_number, i64(descriptor),
                                   i64(usize(data)), i64(length), i64(flags),
                                   filled_address(address),
                                   length_address(address_size)))
    end recvfrom

    --- Stop receiving, sending or both on `descriptor`, `shut_rd`,
    --- `shut_wr` or `shut_rdwr`: zero, or minus the errno.
    public shutdown:
        (descriptor: i32, side: i32) -> (result: i32) =
        result = i32(system_call(shutdown_number, i64(descriptor), i64(side),
                                 0, 0, 0, 0))
    end shutdown

    --- Set the option `name` at `level` of `descriptor` to the `length`
    --- bytes at `value`: zero, or minus the errno.
    public setsockopt:
        (descriptor: i32, level: i32, name: i32, value: ptr u8, length: u32)
        -> (result: i32) =
        result = i32(system_call(setsockopt_number, i64(descriptor),
                                 i64(level), i64(name), i64(usize(value)),
                                 i64(length), 0))
    end setsockopt

    --- Read the option `name` at `level` of `descriptor` into `value`,
    --- whose room `length` holds and which then holds the option's own
    --- length: zero, or minus the errno.
    public getsockopt:
        (descriptor: i32, level: i32, name: i32, value: ptr mut u8,
         length: ptr mut u32) -> (result: i32) =
        result = i32(system_call(getsockopt_number, i64(descriptor),
                                 i64(level), i64(name), i64(usize(value)),
                                 i64(usize(length)), 0))
    end getsockopt

    --- Put the address `descriptor` is bound to in `address`, whose room
    --- `length` holds and which then holds the address's own length: zero,
    --- or minus the errno.
    public getsockname:
        (descriptor: i32, address: ptr mut u8, length: ptr mut u32)
        -> (result: i32) =
        result = i32(system_call(getsockname_number, i64(descriptor),
                                 i64(usize(address)), i64(usize(length)), 0,
                                 0, 0))
    end getsockname

    --- Put the address of the peer `descriptor` is connected to in
    --- `address`, as `getsockname` does: zero, or minus the errno, ENOTCONN
    --- when there is none.
    public getpeername:
        (descriptor: i32, address: ptr mut u8, length: ptr mut u32)
        -> (result: i32) =
        result = i32(system_call(getpeername_number, i64(descriptor),
                                 i64(usize(address)), i64(usize(length)), 0,
                                 0, 0))
    end getpeername

    --- The signal a write to a pipe or a socket nobody reads raises,
    --- SIGPIPE.  The same on every architecture.
    public sigpipe: i32 = 13
    --- A signal's disposition: the system's default, SIG_DFL.
    public sig_dfl: u64 = 0
    --- A signal's disposition: ignored, SIG_IGN.
    public sig_ign: u64 = 1

    fixed if compiler.arch == rv64 then
        --- The kernel's `struct sigaction`, as `rt_sigaction` reads and
        --- fills it: the disposition or handler, its flags and the signals
        --- blocked while a handler runs.  RV64 has no restorer.
        public signal_action: type = struct
            handler: u64
            flags: u64
            mask: u64
        end signal_action
    else
        --- The kernel's `struct sigaction`, as `rt_sigaction` reads and
        --- fills it: the disposition or handler, its flags, the restorer
        --- x86-64 and arm64 return through and the signals blocked while a
        --- handler runs.
        public signal_action: type = struct
            handler: u64
            flags: u64
            restorer: u64
            mask: u64
        end signal_action
    end if

    --- What `rt_sigaction` takes for an action it is not given: C's null
    --- pointer.
    public no_action: atom
    --- An action `rt_sigaction` sets, or `no_action`.
    public action_given: type = no_action | ptr signal_action
    --- Where `rt_sigaction` puts the action it replaces, or `no_action`.
    public action_kept: type = no_action | ptr mut signal_action

    --- Set the action of `signal` to `action` when it is given, and put the
    --- one it had in `previous` when that is given: zero, or minus the
    --- errno.  The signal set is the kernel's, eight bytes.
    public rt_sigaction:
        (signal: i32, action: action_given, previous: action_kept)
        -> (result: i32) =
        setting: i64 = match action
            no_action: i64(0)
            ptr (given): i64(usize(given))
        end match
        keeping: i64 = match previous
            no_action: i64(0)
            ptr (kept): i64(usize(kept))
        end match
        result = i32(system_call(rt_sigaction_number, i64(signal), setting,
                                 keeping, 8, 0, 0))
    end rt_sigaction

    --- End every thread of the process with `status`.  It does not return.
    public exit_group:
        (status: i32) -> noreturn =
        _ = system_call(exit_group_number, i64(status), 0, 0, 0, 0, 0)
        compiler.unreachable()
    end exit_group

    word: usize = sizeof usize

    --  The environment and the auxiliary vector as the process entry found
    --  them, or as `adopt_start` took them from what the C runtime gave
    --  `main`, or zero when neither has.
    mut environment_root: usize
    mut auxiliary_root: usize

    --- What `environment` returns when neither `_landin_start` nor
    --- `adopt_start` found the initial stack's tables.
    public no_environment: atom

    --- The environment table: NUL-terminated `NAME=value` strings ending
    --- at a null entry, or `no_environment`.
    public environment_table: type = no_environment | ptr ptr u8

    --- Adopt the environment and the auxiliary vector of a program the C
    --- runtime started, from the `argc`, `argv` and `envp` C's `main` was
    --- given: whether they were taken.  On the initial stack the kernel
    --- lays out argv, its null, envp, its null and then the auxiliary
    --- vector, with the strings they point to above them all, so the
    --- vector is found after envp's null.  Nothing is taken unless the
    --- tables look exactly like that: argv lies above the frame calling
    --- this, on the stack this thread runs on; envp follows argv's null
    --- directly; at least one string exists and every one lies above the
    --- tables; the vector ends with AT_NULL within 64 entries, each tag
    --- below 4096, before the lowest string; it gives AT_PAGESZ, a power of
    --- two of at least 4096; and AT_RANDOM's sixteen bytes lie between the
    --- vector's end and the lowest string, where the kernel puts them.
    --- Nothing above the lowest string is read, and on the initial stack
    --- all of that lies in the one mapping.  Tables a C `main` built for
    --- itself, or C's `environ` after it changed, fail these and leave
    --- `environment` and `auxiliary` as they were.  A program
    --- `_landin_start` started has its roots already and takes nothing.
    public adopt_start:
        (count: i32, values: ptr ptr u8, environment: ptr ptr u8)
        -> (adopted: bool) =
        adopted = auxiliary_root <> 0
        return when adopted or count < 0
        mut marker: u8 = 0
        frame: usize = usize(addr marker)
        table: usize = usize(values)
        given: usize = usize(environment)
        return when table <= frame
          or given <> table + (usize(count) + 1) * word
        mut lowest: usize = 0 -% 1
        for index in usize(0)..<usize(count) do
            entry: ptr usize = ptr(table + index * word)
            return when entry.val == 0
            if entry.val < lowest then lowest = entry.val end if
        end for
        terminator: ptr usize = ptr(table + usize(count) * word)
        return when terminator.val <> 0
        mut slot: usize = given
        loop do
            return when slot > lowest - word
            entry: ptr usize = ptr(slot)
            break when entry.val == 0
            if entry.val < lowest then lowest = entry.val end if
            slot += word
        end loop
        start: usize = slot + word
        return when lowest == 0 -% 1 or start > lowest
        mut page: u64 = 0
        mut random: u64 = 0
        mut ended: usize = 0
        for pair in usize(0)..<64 do
            at: usize = start + pair * 2 * word
            return when at > lowest - 2 * word
            key: ptr u64 = ptr(at)
            datum: ptr u64 = ptr(at + word)
            if key.val == 0 then
                ended = at + 2 * word
                break
            end if
            return when key.val >= 4096
            if key.val == 6 then page = datum.val end if
            if key.val == 25 then random = datum.val end if
        end for
        return when ended == 0 or page < 4096 or (page & (page - 1)) <> 0
          or random < u64(ended) or random > u64(lowest - 16)
        environment_root = given
        auxiliary_root = start
        adopted = true
    end adopt_start

    --- The environment `_landin_start` found on the initial stack, or the
    --- one `adopt_start` took from C's `main` under `--link=libc`.
    public environment:
        () -> (table: environment_table) =
        if environment_root == 0 then
            table = no_environment
        else
            first: ptr ptr u8 = ptr(environment_root)
            table = first
        end if
    end environment

    --- The auxiliary-vector entry tagged `tag` (`6` is the page size), as
    --- `_landin_start` found it, or `adopt_start` under `--link=libc`:
    --- whether there is one, and its value.  Every entry is the kernel's
    --- own.  A C library's `getauxval` can differ: on x86-64 glibc answers
    --- AT_HWCAP (`16`) from its own `dl_hwcap`, which it sets while it
    --- detects the processor and which holds glibc's library-search bits
    --- (`HWCAP_X86_64` and its AVX-512 bit), not the processor's `cpuid`
    --- word the kernel put in the vector, so the two disagree under
    --- `--link=libc`.  For the processor's features, `read_cpu_words`
    --- asks the processor itself.
    public auxiliary:
        (tag: u64) -> (found: bool, value: u64) =
        found = false
        value = 0
        return when auxiliary_root == 0
        mut at: usize = auxiliary_root
        loop do
            key: ptr u64 = ptr(at)
            break when key.val == 0
            if key.val == tag then
                datum: ptr u64 = ptr(at + word)
                found = true
                value = datum.val
                return
            end if
            at += 2 * word
        end loop
    end auxiliary

    --- The page size the kernel reported, or 4096 when it reported none.
    public page_size:
        () -> (bytes: usize) =
        (found, value) := auxiliary(6)
        bytes = if found then usize(value) else usize(4096) end if
    end page_size

    --  The CPU feature level (D255) the executable was built for is a
    --  compile-time fact, `compiler.feature.NAME` for each of its features.
    --  The process entry holds the processor to that level before `main`
    --  runs, as a dynamic loader holds it to an x86-64 executable's ISA
    --  note: each check below exists only at a level that needs it, and the
    --  baseline's check does nothing.  The checks read words the processor
    --  or the kernel gives and test constant masks against them, so they
    --  use no instruction the level adds.
    fixed if compiler.arch == x86_64 then
        --- What the processor says of itself: `cpuid` leaf 1's ecx, leaf
        --- 7's ebx, leaf 0x80000001's ecx, and the state the operating
        --- system enables, XCR0's low half, which is zero unless both the
        --- level needs AVX state and `cpuid` reports OSXSAVE.  A leaf the
        --- processor does not have reads as zero.
        public cpu_words: type = struct
            standard_ecx: u32
            structured_ebx: u32
            extended_ecx: u32
            enabled_state: u32
        end cpu_words

        --  `cpuid`'s ebx, ecx or eax for `leaf`, subleaf zero.
        cpuid_b: (leaf: u32) -> (word: u32) =
            (a, b, c, d) :=
                assembler.block("cpuid", inout a: u32 at rax = leaf,
                                out b: u32 at rbx, inout c: u32 at rcx = 0,
                                out d: u32 at rdx)
            _ = a
            _ = c
            _ = d
            word = b
        end cpuid_b

        cpuid_c: (leaf: u32) -> (word: u32) =
            (a, b, c, d) :=
                assembler.block("cpuid", inout a: u32 at rax = leaf,
                                out b: u32 at rbx, inout c: u32 at rcx = 0,
                                out d: u32 at rdx)
            _ = a
            _ = b
            _ = d
            word = c
        end cpuid_c

        cpuid_a: (leaf: u32) -> (word: u32) =
            (a, b, c, d) :=
                assembler.block("cpuid", inout a: u32 at rax = leaf,
                                out b: u32 at rbx, inout c: u32 at rcx = 0,
                                out d: u32 at rdx)
            _ = b
            _ = c
            _ = d
            word = a
        end cpuid_a

        --  OSXSAVE in leaf 1's ecx: the system enabled XGETBV and XCR0.
        osxsave: u32 = 0x08000000

        fixed if compiler.feature.avx then
            --  `xgetbv` is XSAVE's, which only an AVX level assembles.
            enabled_state: (standard_ecx: u32) -> (state: u32) =
                state = 0
                return when (standard_ecx & osxsave) == 0
                (low, high) := assembler.block("xgetbv",
                                               in c: u32 at rcx = 0,
                                               out low: u32 at rax,
                                               out high: u32 at rdx)
                _ = high
                state = low
            end enabled_state
        else
            enabled_state: (standard_ecx: u32) -> (state: u32) =
                _ = standard_ecx
                state = 0
            end enabled_state
        end if

        --- The words this processor gives.
        public read_cpu_words:
            () -> (words: cpu_words) =
            top: u32 = cpuid_a(0)
            extended_top: u32 = cpuid_a(0x80000000)
            standard: u32 = if top >= 1 then cpuid_c(1) else 0 end if
            structured: u32 = if top >= 7 then cpuid_b(7) else 0 end if
            reach: bool = extended_top >= 0x80000001
            extended: u32 = if reach then cpuid_c(0x80000001) else 0 end if
            words = (standard_ecx: standard, structured_ebx: structured,
                     extended_ecx: extended,
                     enabled_state: enabled_state(standard))
        end read_cpu_words

        --  x86-64-v2's features, in D255's order, or "" when all are there.
        missing_v2: (words: cpu_words) -> (name: []u8) =
            ecx: u32 = words.standard_ecx
            name = if (ecx & 0x00002000) == 0 then "cmpxchg16b"
                   elsif (words.extended_ecx & 0x00000001) == 0 then "lahf"
                   elsif (ecx & 0x00800000) == 0 then "popcnt"
                   elsif (ecx & 0x00000001) == 0 then "sse3"
                   elsif (ecx & 0x00000200) == 0 then "ssse3"
                   elsif (ecx & 0x00080000) == 0 then "sse4_1"
                   elsif (ecx & 0x00100000) == 0 then "sse4_2"
                   else "" end if
        end missing_v2

        --  x86-64-v3's, then the AVX state the system must save: XCR0's
        --  SSE and AVX bits.
        missing_v3: (words: cpu_words) -> (name: []u8) =
            ecx: u32 = words.standard_ecx
            ebx: u32 = words.structured_ebx
            state: u32 = words.enabled_state
            saved: bool = (ecx & osxsave) <> 0 and (state & 0x06) == 0x06
            name = if (ecx & 0x10000000) == 0 then "avx"
                   elsif (ebx & 0x00000020) == 0 then "avx2"
                   elsif (ebx & 0x00000008) == 0 then "bmi1"
                   elsif (ebx & 0x00000100) == 0 then "bmi2"
                   elsif (ecx & 0x20000000) == 0 then "f16c"
                   elsif (ecx & 0x00001000) == 0 then "fma"
                   elsif (words.extended_ecx & 0x00000020) == 0 then "lzcnt"
                   elsif (ecx & 0x00400000) == 0 then "movbe"
                   elsif (ecx & 0x04000000) == 0 then "xsave"
                   elsif not saved then "avx state"
                   else "" end if
        end missing_v3

        --  x86-64-v4's, then the AVX-512 state: XCR0's opmask and upper
        --  ZMM bits beside SSE and AVX.
        missing_v4: (words: cpu_words) -> (name: []u8) =
            ebx: u32 = words.structured_ebx
            name = if (ebx & 0x00010000) == 0 then "avx512f"
                   elsif (ebx & 0x40000000) == 0 then "avx512bw"
                   elsif (ebx & 0x10000000) == 0 then "avx512cd"
                   elsif (ebx & 0x00020000) == 0 then "avx512dq"
                   elsif (ebx & 0x80000000) == 0 then "avx512vl"
                   elsif (words.enabled_state & 0xE6) <> 0xE6 then
                       "avx512 state"
                   else "" end if
        end missing_v4

        fixed if compiler.feature.avx512f then
            --- The level this executable was built for.
            public level:
                () -> (name: []u8) =
                name = "x86-64-v4"
            end level

            --  Hold the processor to this level before `main` runs.
            check_level: () -> none =
                hold_level()
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                name = missing_v2(words)
                return when lenof name <> 0
                name = missing_v3(words)
                return when lenof name <> 0
                name = missing_v4(words)
            end missing_feature
        elsif compiler.feature.avx then
            --- The level this executable was built for.
            public level:
                () -> (name: []u8) =
                name = "x86-64-v3"
            end level

            --  Hold the processor to this level before `main` runs.
            check_level: () -> none =
                hold_level()
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                name = missing_v2(words)
                return when lenof name <> 0
                name = missing_v3(words)
            end missing_feature
        elsif compiler.feature.popcnt then
            --- The level this executable was built for.
            public level:
                () -> (name: []u8) =
                name = "x86-64-v2"
            end level

            --  Hold the processor to this level before `main` runs.
            check_level: () -> none =
                hold_level()
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                name = missing_v2(words)
            end missing_feature
        else
            --- The level this executable was built for.
            public level:
                () -> (name: []u8) =
                name = "x86-64-v1"
            end level

            --  The family's baseline needs no check, and runs none.
            check_level: () -> none =
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                _ = words
                name = ""
            end missing_feature
        end if

    elsif compiler.arch == arm64 then
        --- What the kernel says of the processor: the auxiliary vector's
        --- AT_HWCAP, as `_landin_start` found it, or zero.
        public cpu_words: type = struct
            hwcap: u64
        end cpu_words

        --- The words this processor gives.
        public read_cpu_words:
            () -> (words: cpu_words) =
            (found, value) := auxiliary(16)
            words = (hwcap: if found then value else 0 end if)
        end read_cpu_words

        fixed if compiler.feature.lse then
            --- The level this executable was built for.
            public level:
                () -> (name: []u8) =
                name = "armv8.1-a"
            end level

            --  Hold the processor to this level before `main` runs.
            check_level: () -> none =
                hold_level()
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there: HWCAP_ATOMICS, HWCAP_CRC32 and
            --- HWCAP_ASIMDRDM.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                hwcap: u64 = words.hwcap
                name = if (hwcap & 0x100) == 0 then "lse"
                       elsif (hwcap & 0x80) == 0 then "crc32"
                       elsif (hwcap & 0x1000) == 0 then "rdm"
                       else "" end if
            end missing_feature
        else
            --- The level this executable was built for.
            public level:
                () -> (name: []u8) =
                name = "armv8-a"
            end level

            --  The family's baseline needs no check, and runs none.
            check_level: () -> none =
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                _ = words
                name = ""
            end missing_feature
        end if

    else
        --- What the kernel says of the processor: `riscv_hwprobe`'s
        --- RISCV_HWPROBE_KEY_IMA_EXT_0, or zero when the kernel cannot
        --- answer.  Neither it nor AT_HWCAP reports a vendor extension, so
        --- XTheadBa is not among what an executable is held to.
        public cpu_words: type = struct
            extensions: u64
        end cpu_words

        probe_pair: type = struct
            key: i64
            value: u64
        end probe_pair

        --- The words this processor gives.
        public read_cpu_words:
            () -> (words: cpu_words) =
            mut pair: probe_pair = (key: 4, value: 0)
            result: i64 = system_call(riscv_hwprobe_number,
                                      i64(usize(addr pair)), 1, 0, 0, 0, 0)
            answered: bool = result == 0 and pair.key == 4
            words = (extensions: if answered then pair.value else 0 end if)
        end read_cpu_words

        fixed if compiler.feature.zba then
            fixed if compiler.feature.xtheadba then
                --- The level this executable was built for.
                public level:
                    () -> (name: []u8) =
                    name = "rv64gc_zba_xtheadba"
                end level
            else
                --- The level this executable was built for.
                public level:
                    () -> (name: []u8) =
                    name = "rv64gc_zba"
                end level
            end if

            --  Hold the processor to this level before `main` runs.
            check_level: () -> none =
                hold_level()
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there: RISCV_HWPROBE_EXT_ZBA.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                name = if (words.extensions & 0x8) == 0 then "zba"
                       else "" end if
            end missing_feature
        else
            fixed if compiler.feature.xtheadba then
                --- The level this executable was built for.
                public level:
                    () -> (name: []u8) =
                    name = "rv64gc_xtheadba"
                end level
            else
                --- The level this executable was built for.
                public level:
                    () -> (name: []u8) =
                    name = "rv64gc"
                end level
            end if

            --  The family's baseline needs no check, and runs none.
            check_level: () -> none =
            end check_level

            --- The first feature of this executable's level that `words`
            --- lacks, by the name `compiler.feature` gives it, or "" when
            --- the level is all there.
            public missing_feature:
                (words: cpu_words) -> (name: []u8) =
                _ = words
                name = ""
            end missing_feature
        end if

    end if

    --  The status a dynamic loader exits with when it refuses to start a
    --  program, which glibc's loader gives an executable whose x86-64 ISA
    --  note this processor does not meet: so a libc-linked and a static
    --  build of one program end alike on one machine.
    refused_status: i32 = 127

    write_all: (text: []u8) -> none =
        mut sent: usize = 0
        while sent < lenof text do
            data: ptr u8 = ptr(usize(addr text[0]) + sent)
            result: isize = write(2, data, lenof text - sent)
            return when result <= 0
            sent += usize(result)
        end while
    end write_all

    --  Hold the processor to the executable's level, or say which feature
    --  it lacks on standard error and end the process.
    hold_level: () -> none =
        missing: []u8 = missing_feature(read_cpu_words())
        return when lenof missing == 0
        write_all("landin: this executable needs ")
        write_all(level())
        write_all(", and the processor lacks ")
        write_all(missing)
        write_all("\n")
        exit_group(refused_status)
    end hold_level

    --  C's view of the program's hosted entry: the process entry calls it
    --  as C's runtime would.
    extern(c) link(symbol: "main") program_main:
        (count: i32, values: ptr ptr u8, environment: ptr ptr u8)
        -> (code: i32)

    --- What `_landin_start` runs: it reads argc, argv, the environment and
    --- the auxiliary vector from the initial stack at `stack`, keeps the
    --- environment and the vector, holds the processor to the executable's
    --- CPU feature level, calls the program's `main` with them as C's
    --- runtime would, and ends the process with main's result.  A processor
    --- without a feature of the level ends the process with status 127 and
    --- one line on standard error before `main` runs.  No C library
    --- initialisation runs and no thread-local storage exists.
    public extern(c) _landin_start_main: (stack: ptr usize) -> none =
        count: usize = stack.val
        values: usize = usize(stack) + word
        environment_first: usize = values + (count + 1) * word
        mut at: usize = environment_first
        loop do
            entry: ptr usize = ptr(at)
            at += word
            break when entry.val == 0
        end loop
        environment_root = environment_first
        auxiliary_root = at
        check_level()
        arguments: ptr ptr u8 = ptr(values)
        variables: ptr ptr u8 = ptr(environment_first)
        code: i32 = program_main(i32(count), arguments, variables)
        exit_group(code)
    end _landin_start_main
end if
