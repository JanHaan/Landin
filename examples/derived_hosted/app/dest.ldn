import core/io
import core/mem
import core/vec

--  A message owns copied arbitrary bytes. Its cursor commits the exact
--  positive count from each write attempt. A failed write_some attempt
--  transfers zero bytes, so retry never repeats a committed prefix.
public message: type = struct
    bytes: vec.list(u8)
    delivered: usize
end message
public new_message: () -> (value: message) =
    bytes := vec.new(item: u8)
    value = (bytes: bytes, delivered: 0)
end new_message
reserve_message: (provider: type is mem.allocator, inout allocator: provider,
                  inout value: message, want: usize)
                 -> none ! mem.out_of_memory =
    old_capacity: usize = vec.capacity(value.bytes)
    return when want <= old_capacity
    maximum: usize = 0 -% 1
    --  Keep a spare slot and double retained capacity as messages grow.
    --  This also bounds allocations retained by a run-lifetime region.
    mut next: usize = want
    if next < maximum then inc next end if
    if next < 8 then next = 8 end if
    if old_capacity > 0 and old_capacity <= maximum / 2 then
        doubled: usize = old_capacity * 2
        if next < doubled then next = doubled end if
    end if
    try vec.reserve(value.bytes, allocator, next)
end reserve_message
public append: (provider: type is mem.allocator, inout allocator: provider,
                inout value: message, bytes: []u8)
               -> none ! mem.out_of_memory =
    count: usize = vec.length(value.bytes)
    maximum: usize = 0 -% 1
    fail mem.out_of_memory when lenof bytes > maximum - count
    --  Reserve first: failure preserves the entire previous message.
    try vec.reserve(value.bytes, allocator, count + lenof bytes)
    for byte in bytes do try vec.push(value.bytes, allocator, byte) end for
end append
public append_line: (provider: type is mem.allocator, inout allocator: provider,
                     inout value: message, bytes: []u8)
                    -> none ! mem.out_of_memory =
    count: usize = vec.length(value.bytes)
    maximum: usize = 0 -% 1
    fail mem.out_of_memory when lenof bytes >= maximum - count
    --  Reserve the complete record before changing the message.
    try reserve_message(allocator, value, count + lenof bytes + 1)
    for byte in bytes do try vec.push(value.bytes, allocator, byte) end for
    try vec.push(value.bytes, allocator, u8(10))
end append_line
public deliver: (inout value: message, world: any io.world, stream: io.file)
                -> none ! io.io_failed =
    while value.delivered < vec.length(value.bytes) do
        bytes := vec.used(value.bytes)
        count: usize = try world.write_some(stream, bytes[value.delivered..<vec.length(value.bytes)])
        value.delivered += count
    end while
end deliver
public clear_message: (inout value: message) -> none =
    while vec.length(value.bytes) > 0 do
        _ = vec.pop(value.bytes) else u8(0)
    end while
    value.delivered = 0
end clear_message
public drop_message: (provider: type is mem.allocator, inout allocator: provider,
                      inout value: message) -> none =
    vec.release(value.bytes, allocator)
    value.delivered = 0
end drop_message

public dest: type = concept (item: type)
    emit: (self: ptr mut item, world: any io.world, inout pending: message,
           line: []u8)
          -> none ! io.io_failed
    done: (self: ptr mut item, world: any io.world) -> none ! io.io_failed
end dest
public text_dest: type = struct
    stream: io.file
end text_dest
public count_dest: type = struct
    by_level: [8]usize
    total: usize
end count_dest
text_emit: (self: ptr mut text_dest, world: any io.world, inout pending: message,
            line: []u8)
           -> none ! io.io_failed =
    --  R480_DEBUG_TEXT
    _ = line
    try deliver(pending, world, self.val.stream)
end text_emit
text_done: (self: ptr mut text_dest, world: any io.world)
           -> none ! io.io_failed =
    _ = self
    _ = world
end text_done
count_emit: (self: ptr mut count_dest, world: any io.world, inout pending: message,
             line: []u8)
            -> none ! io.io_failed =
    _ = world
    _ = pending
    level: u8 = level_of(line)
    inc self.val.by_level[usize(level)]
    inc self.val.total
end count_emit
public print_number: (world: any io.world, stream: io.file, number: usize)
                     -> none ! io.io_failed =
    if number >= 10 then try print_number(world, stream, number / 10) end if
    mut digit: [1]u8 = zeroed
    digit[0] = u8(number % 10) + 48
    try world.write(stream, digit[0..<1])
end print_number
count_done: (self: ptr mut count_dest, world: any io.world)
            -> none ! io.io_failed =
    stream: io.file = world.out()
    for level in usize(0)..<usize(8) do
        try print_number(world, stream, usize(level))
        try world.write(stream, ": ")
        try print_number(world, stream, self.val.by_level[level])
        try world.write(stream, "\n")
    end for
end count_done
text_dest is dest (emit: text_emit, done: text_done)
count_dest is dest (emit: count_emit, done: count_done)
