import core/diag
import core/io
import core/mem
import core/vec

public process: (provider: type is mem.allocator, memory: provider,
                 world: any io.world, inout cfg: config,
                 inout reading: reader) -> (kept: usize)
                ! io.io_failed | mem.out_of_memory =
    mut pending := new_message()
    defer drop_message(memory, pending)
    kept = 0
    loop do
        line: []u8 = next_line_at_least(memory, reading, world,
                                        cfg.leading_level) else (problem)
            break when problem == at_end
            fail mem.out_of_memory when problem == mem.out_of_memory
            fail io.io_failed
        end
        mut pass: bool = true
        mut encoding: line_encoding = (checked: false, valid: false)
        for selected in vec.used(cfg.chain) do
            pass = selected.keep(line, encoding)
            break when not pass
        end for
        if pass then
            if not cfg.count_only then
                try append_line(memory, pending, line)
            end if
            --  One explicit retry. The buffered cursor survives failure;
            --  a second failure is terminal and normal cleanup still runs.
            cfg.to.emit(world, pending, line) else (problem)
                _ = problem
                try cfg.to.emit(world, pending, line)
            end
            clear_message(pending)
            inc kept
        end if
    end loop
    try cfg.to.done(world)
end process

public run_logged: (provider: type is mem.allocator, memory: provider,
                    world: any io.world, chunk_size: usize, log: any diag.log) -> (kept: usize)
                   ! bad_argument | mem.out_of_memory
                   | io.not_found | io.no_access | io.io_failed =
    mut cfg := try prepare_logged(memory, world, log)
    mut reader := open_reader(memory, world, cfg.input, chunk_size)
        else (problem)
        close_config(world, cfg) else none
        fail problem
    end
    open_output(memory, world, cfg) else (problem)
        shut_reader(memory, world, reader) else none
        fail problem
    end
    kept = process(memory, world, cfg, reader) else (problem)
        shut_reader(memory, world, reader) else none
        close_config(world, cfg) else none
        fail problem
    end
    shut_reader(memory, world, reader) else (problem)
        close_config(world, cfg) else none
        fail problem
    end
    try close_config(world, cfg)
end run_logged

public run: (provider: type is mem.allocator, memory: provider,
             world: any io.world, chunk_size: usize) -> (kept: usize)
            ! bad_argument | mem.out_of_memory
            | io.not_found | io.no_access | io.io_failed =
    lent := io.writer_of(world)
    writer: any io.writer = any(addr lent)
    mut logger := diag.stream(writer, world.err())
    log: any diag.log = any(addr logger)
    kept = try run_logged(memory, world, chunk_size, log)
end run
