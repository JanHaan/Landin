import core/diag
import core/io
import core/mem
import core/text
import core/vec

public bad_argument: atom
public bad_encoding: atom
public config: type = struct
    chain: vec.list(any filter)
    leading_level: u8
    to: any dest
    count_only: bool
    input: text.host_string
    output_path: []u8
    output: io.file
    owns_output: bool
    warnings: usize
    encoding_warnings: usize
end config

public equal: (left: []u8, right: []u8) -> (yes: bool) =
    yes = false
    return when lenof left <> lenof right
    for at in usize(0)..<lenof left do return when left[at] <> right[at] end for
    yes = true
end equal

--  Copy every user argument before parsing. Admit each source byte directly
--  into raw storage; no initialized byte is overwritten. Configuration,
--  needles, and paths retain the allocated copies, and a path is a host
--  string over its copy.
public copy_arguments: (provider: type is mem.allocator, memory: provider,
                        world: any io.world)
                       -> (arguments: vec.list([]u8))
                       ! bad_argument | mem.out_of_memory =
    arguments = vec.new(item: []u8)
    count: usize = world.argument_count()
    for at in usize(0)..<count do
        arg: text.host_string = world.argument(at) else (problem)
            _ = problem
            fail bad_argument
        end
        source: []u8 = text.host_bytes(arg)
        extent: usize = if lenof source > 0 then lenof source else usize(1) end if
        block: ptr mut u8 = try mem.allocate(memory, extent, alignof u8)
        mut owner := mem.storage_over(item: u8, base: block, slots: extent)
        for byte in source do
            _ = mem.admit(owner, byte) else (problem)
                _ = problem
                fail bad_argument
            end
        end for
        initialized: []mut u8 = mem.used(owner)
        copied: []u8 = initialized[0..<lenof source]
        for byte in copied do fail bad_argument when byte == 0 end for
        try vec.push(arguments, memory, copied)
    end for
end copy_arguments

validated: (bytes: []u8) -> (valid: bool) ! bad_argument =
    text: utf8 = text.from_bytes(bytes) else (problem)
        _ = problem
        fail bad_argument
    end
    _ = text
    valid = true
end validated
sample_number: (bytes: []u8) -> (value: usize) ! bad_argument | bad_encoding =
    _ = validated(bytes) else (problem)
        _ = problem
        fail bad_encoding
    end
    value = try number(bytes)
end sample_number

number: (bytes: []u8) -> (value: usize) ! bad_argument =
    value = text.parse_usize(bytes) else (problem)
        _ = problem
        fail bad_argument
    end
end number

public prepare_logged: (provider: type is mem.allocator, memory: provider,
                        world: any io.world, log: any diag.log) -> (value: config)
                       ! bad_argument | mem.out_of_memory | io.io_failed =
    arguments := try copy_arguments(memory, world)
    args := vec.used(arguments)
    mut chain := vec.new(item: any filter)
    mut leading_level: u8 = 0
    mut only_levels: bool = true
    mut input: []u8 = ""
    mut output: []u8 = ""
    mut warnings: usize = 0
    mut encoding_warnings: usize = 0
    mut at: usize = 0
    while at < lenof args do
        arg: []u8 = args[at]
        _ = try validated(arg)
        if equal(arg, "--level") or equal(arg, "--match")
          or equal(arg, "--every") or equal(arg, "--out") then
            inc at
            fail bad_argument when at == lenof args
            parameter: []u8 = args[at]
            if not equal(arg, "--every") then
                _ = try validated(parameter)
            end if
            if equal(arg, "--level") then
                mut least: u8 = 0
                if equal(parameter, "DEBUG") then least = 1
                elsif equal(parameter, "INFO") then least = 2
                elsif equal(parameter, "WARN") then least = 3
                elsif equal(parameter, "ERROR") then least = 4
                elsif equal(parameter, "FATAL") then least = 5
                else fail bad_argument end if
                if only_levels and least > leading_level then
                    leading_level = least
                end if
                initial: level_filter = (least: least)
                object := try mem.new(memory, initial)
                selected: any filter = any(object)
                try vec.push(chain, memory, selected)
            elsif equal(arg, "--match") then
                only_levels = false
                initial: match_filter = (needle: parameter)
                object := try mem.new(memory, initial)
                selected: any filter = any(object)
                try vec.push(chain, memory, selected)
            elsif equal(arg, "--every") then
                only_levels = false
                mut every: usize = sample_number(parameter) else (problem)
                    _ = problem
                    inc warnings
                    if problem == bad_encoding then
                        inc encoding_warnings
                        try log.note(text.nowhere, diag.error,
                                     "--every argument is not UTF-8, using 1\n")
                    else
                        try log.note(text.nowhere, diag.error,
                                     "--every wants a positive number, using 1\n")
                    end if
                    1
                end
                if every == 0 then every = 1
                    inc warnings
                    try log.note(text.nowhere, diag.error,
                                 "--every 0 makes no sense, using 1\n")
                end if
                initial: sample_filter = (every: every, seen: 0)
                object := try mem.new(memory, initial)
                selected: any filter = any(object)
                try vec.push(chain, memory, selected)
            else
                fail bad_argument when lenof output > 0 or lenof parameter == 0
                output = parameter
            end if
        else
            fail bad_argument when lenof arg == 0 or arg[0] == 45 or lenof input > 0
            input = arg
        end if
        inc at
    end while
    fail bad_argument when lenof input == 0
    fail bad_argument when lenof output > 0 and equal(input, output)
    --  Keep the output path until run has opened the input reader. Opening
    --  it here would truncate an existing output on an input-open failure.
    initial: count_dest = zeroed
    object := try mem.new(memory, initial)
    chosen: any dest = any(object)
    value = (chain: chain, leading_level: leading_level, to: chosen, count_only: lenof output == 0,
             input: text.host_over(input),
             output_path: output, output: world.out(), owns_output: false,
             warnings: warnings,
             encoding_warnings: encoding_warnings)
end prepare_logged

public open_output: (provider: type is mem.allocator, memory: provider,
                     world: any io.world, inout value: config)
                    -> none ! bad_argument | mem.out_of_memory
                            | io.not_found | io.no_access | io.io_failed =
    path: []u8 = value.output_path
    if lenof path > 0 then
        target: text.host_string = text.host_over(path)
        fail bad_argument when try world.same_file(value.input, target)
        stream: io.file = try world.open_write(target)
        initial: text_dest = (stream: stream)
        object := mem.new(memory, initial) else (problem)
            world.close(stream) else none
            fail problem
        end
        value.to = any(object)
        value.output = stream
        value.owns_output = true
    end if
end open_output

public build_logged: (provider: type is mem.allocator, memory: provider,
                      world: any io.world, log: any diag.log) -> (value: config)
                     ! bad_argument | mem.out_of_memory
                     | io.not_found | io.no_access | io.io_failed =
    value = try prepare_logged(memory, world, log)
    try open_output(memory, world, value)
end build_logged

public close_config: (world: any io.world, sink value: config)
                     -> none ! io.io_failed =
    if value.owns_output then try world.close(value.output) end if
end close_config

public build: (provider: type is mem.allocator, memory: provider,
               world: any io.world) -> (value: config)
              ! bad_argument | mem.out_of_memory
              | io.not_found | io.no_access | io.io_failed =
    lent := io.writer_of(world)
    writer: any io.writer = any(addr lent)
    mut logger := diag.stream(writer, world.err())
    log: any diag.log = any(addr logger)
    value = try build_logged(memory, world, log)
end build
