import core/io
import hosted/io as hosted
import core/diag
import hosted/heap
import core/region

public entry: () -> (code: i32) =
    host := hosted.host()
    world: any io.world = any(addr host)
    heap := heap.host()
    mut ledger: region.space(0) = zeroed
    program := region.over(ledger, heap)
    defer region.release(ledger, heap)
    writer: any io.writer = any(addr host)
    mut logger := diag.stream(writer, world.err())
    log: any diag.log = any(addr logger)
    kept: usize = run_logged(program, world, usize(4096), log) else (problem)
        _ = problem
        world.write(world.err(), "log filter failed\n") else (write_problem)
            _ = write_problem
        end
        code = 1
        return
    end
    world.write(world.err(), "kept: ") else (problem)
        _ = problem
        code = 1
        return
    end
    print_number(world, world.err(), kept) else (problem)
        _ = problem
        code = 1
        return
    end
    world.write(world.err(), "\n") else (problem)
        _ = problem
        code = 1
        return
    end
    code = if log.failed() then 1 else 0 end if
end entry
