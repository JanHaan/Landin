{
  "name": "Landin",
  "scopeName": "source.landin",
  "fileTypes": [
    "ldn"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#literals"
    },
    {
      "match": "\\b(?:cstring|isize|usize|utf16|bool|i128|u128|utf8|f16|f32|f64|i16|i32|i64|u16|u32|u64|i8|u8|[ui](?:0|[1-9][0-9]{0,2}))\\b",
      "name": "storage.type.builtin.landin"
    },
    {
      "match": "\\b(?:noreturn|zeroed|false|none|true)\\b",
      "name": "constant.language.landin"
    },
    {
      "match": "\\b(?:assembler|compiler|linker)\\b",
      "name": "support.module.landin"
    },
    {
      "match": "\\b(?:unchecked|complete|continue|distinct|escaping|register|volatile|alignof|concept|variant|caller|extern|import|layout|little|option|public|return|sizeof|struct|align|arena|begin|break|defer|elsif|fixed|inout|lenof|match|range|while|addr|atom|else|fail|from|link|loop|sink|then|type|undo|when|with|and|any|big|dec|end|for|inc|mut|not|ptr|set|soa|try|as|at|do|if|in|is|of|or)\\b",
      "name": "keyword.control.landin"
    },
    {
      "match": "\\b([a-z_][a-z0-9_]*)(?=\\s*:\\s*(?:type|atom)\\b)",
      "name": "entity.name.type.landin"
    },
    {
      "match": "\\b([a-z_][a-z0-9_]*)(?=\\s*:\\s*\\([^\\n]*\\)\\s*->)",
      "name": "entity.name.function.landin"
    },
    {
      "match": "\\b[a-z_][a-z0-9_]*(?=\\s*\\()",
      "name": "entity.name.function.call.landin"
    },
    {
      "match": "(?<=\\.)[a-z_][a-z0-9_]*\\b",
      "name": "variable.other.member.landin"
    },
    {
      "match": "(?:\\+%|-%|\\*%|:=|->|\\.\\.<|\\.\\.|<<|>>|==|<>|<=|>=|[-+*/%<>=!&|^~])",
      "name": "keyword.operator.landin"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "---.*$",
          "name": "comment.line.documentation.landin"
        },
        {
          "include": "#block-comment"
        },
        {
          "match": "--.*$",
          "name": "comment.line.double-dash.landin"
        }
      ]
    },
    "block-comment": {
      "begin": "--\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.landin"
        }
      },
      "end": "\\)--",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.landin"
        }
      },
      "name": "comment.block.landin",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "begin": "(\"{3,})",
          "end": "\\1",
          "name": "string.quoted.other.raw.landin"
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.landin",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.landin"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.landin",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.landin"
            }
          ]
        },
        {
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+(?:\\.[0-9A-Fa-f_]+)?(?:[pP][-+]?[0-9]+)?|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.(?!\\.)[0-9_]+)?(?:[eE][-+]?[0-9]+)?)\\b",
          "name": "constant.numeric.landin"
        }
      ]
    }
  },
  "metadata": {
    "comment": "Generated by highlight/generate.py; do not edit by hand."
  }
}
