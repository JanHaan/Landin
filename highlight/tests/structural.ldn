import core/io

--( outer block comment
    --( nested block comment )--
)--

ready, stopped: atom

pair: type = struct
    left: i32
    right: i32
end pair

c_pair: type = layout(c) struct
    left: f64
    right: i32
end c_pair

c_callback: type = extern(c) (value: i32) -> (result: i32)
c_callback_array: type = [2]extern(c) (value: i32) -> (result: i32)

extern(c) link(symbol: "host_write") host_write: (
    value: i32,
    format: cstring,
    ...
) -> (written: i32)

public extern(c) landin_increment: (value: i32) -> (result: i32) =
    result = value + 1
end landin_increment

layout: i32 = 0
c: i32 = 0
link: i32 = 0
symbol: i32 = 0

link(symbol: "native_add") add: (left: i32, right: i32) -> (result: i32) =
    result = left + right
end add

public main: () -> (code: i32) =
    values: [3]i32 = [1, 2, 3]
    length: usize = lenof values
    if length == 3 then
        code = add(values[0], values[1])
    else
        code = 0
    end if
end main

-- D228 packed image surface; raw bits are validated at field extraction.
packed_idle: atom
packed_busy: atom
packed_mode: type = u4 (packed_idle = 0 | packed_busy = 4)
packed_image: type = layout(packed, u32) struct
    enabled: bool at 0
    mode: packed_mode at 1..4
    pins: [4]u2 at 8..15
end packed_image
