public sample: () -> (result: u23) =
    text: utf8 = "escaped\nstring"
    raw: utf8 = """raw
-- this is part of the raw literal
"""
    result = compiler.member + assembler.member + linker.member + invoke(0x2a)
    if true and not false then
        return
    end if
end sample

host is io.files (close: events_close) through services -- supplied
board is fibre.scheduler through runs

through: (flag: bool) -> (code: i32) =
    code = through_value(flag)
end through

first: (in value: items, held: items) -> (result: item from held value, spare: item from held) =
    result = value.items[held.count]
end first
