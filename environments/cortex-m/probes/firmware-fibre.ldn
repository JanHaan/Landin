mut backing: [1024]u8 = zeroed
mut main_saved: usize = 0
mut fibre_saved: usize = 0
mut handled: u32 = 0
mut observed: u32 = 0
mut finished: u32 = 0
link(vector: 16)
extern(interrupt) irq_handler: () -> none =
    handled = handled + 1
    deeper()
end irq_handler
deeper: () -> none =
    handled = handled + 10
end deeper
fibre: (argument: usize) -> noreturn =
    assembler.block("""
        ldr r0, =0xe000e100
        movs r1, #1
        str r1, [r0]
        ldr r0, =0xe000e200
        str r1, [r0]
        dsb sy
        isb sy
        """)
    observed = handled + u32(argument)
    compiler.stack_switch(addr fibre_saved, main_saved)
    loop do
    end loop
end fibre
start: () -> none =
    fibre_saved = compiler.stack_prepare(backing[0..<1024], fibre, 100)
    compiler.stack_switch(addr main_saved, fibre_saved)
    finished = observed + 1000
end start
