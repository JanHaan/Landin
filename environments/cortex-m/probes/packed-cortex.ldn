-- Compiler-generated Cortex-M register transactions against the synthetic device.
internal: atom
external: atom
pll: atom
clock: type = (internal = 0 | external = 1 | pll = 4)
control: type = layout(packed, u32) struct
    mode: clock at 1..3
    enabled: bool at 5
end control
flags: type = layout(packed, u32) struct
    bits: [8]bool at 0..7
end flags
counter: type = layout(packed, u16) struct
    count: u16 at 0..15
end counter

public main: () -> (result: u32) =
    normal: ptr mut u32 = ptr(0x40030000)
    destructive: ptr mut u32 = ptr(0x40030004)
    command_port: ptr mut u32 = ptr(0x40030008)
    pending: ptr mut u32 = ptr(0x4003000c)
    counter_port: ptr mut u16 = ptr(0x40030010)
    ones: ptr mut u32 = ptr(0x40030014)
    mut image: control = zeroed
    raw: ptr mut u32 = ptr(usize(addr image))
    raw.val = compiler.register_read(normal, compiler.normal_read)
    if image.mode <> internal then
        result = 1
        return
    end if
    image.enabled = false
    compiler.register_write(normal, raw.val, compiler.normal_write,
                            compiler.preserve, 0xff)
    if compiler.register_read(normal, compiler.normal_read) <> 0xa50000d0 then
        result = 2
        return
    end if

    -- Destructive reads remain two explicit image operations. The image
    -- with unnamed clock bits is copied without extracting that field.
    raw.val = compiler.register_read(destructive, compiler.clear_on_read)
    copy := image
    if copy.enabled or compiler.register_read(destructive, compiler.clear_on_read) <> 0 then
        result = 3
        return
    end if

    -- Write-only and one-clears images start from zero, never a hidden read.
    mut command: flags = zeroed
    command.bits[0] = true
    command.bits[4] = true
    command.bits[6] = true
    command_raw: ptr u32 = ptr(usize(addr command))
    compiler.register_write(command_port, command_raw.val, compiler.normal_write,
                            compiler.write_zero, 0xff)
    mut clear: flags = zeroed
    clear.bits[1] = true
    clear_raw: ptr mut u32 = ptr(usize(addr clear))
    compiler.register_write(pending, clear_raw.val, compiler.one_clears,
                            compiler.write_zero, 0xff)
    if compiler.register_read(pending, compiler.normal_read) <> 0xf1 then
        result = 4
        return
    end if
    clear = zeroed
    compiler.register_write(pending, clear_raw.val, compiler.one_clears,
                            compiler.write_zero, 0xff)
    if compiler.register_read(pending, compiler.normal_read) <> 0xf1 then
        result = 5
        return
    end if

    mut count: counter = zeroed
    count_raw: ptr mut u16 = ptr(usize(addr count))
    count_raw.val = compiler.register_read(counter_port, compiler.normal_read)
    if count.count <> 65535 then
        result = 6
        return
    end if
    count.count = 0
    compiler.register_write(counter_port, count_raw.val, compiler.normal_write,
                            compiler.preserve, 0xffff)
    count_raw.val = compiler.register_read(counter_port, compiler.normal_read)
    if count.count <> 0 then
        result = 7
        return
    end if
    count.count = 65535
    compiler.register_write(counter_port, count_raw.val, compiler.normal_write,
                            compiler.preserve, 0xffff)
    compiler.register_write(ones, 0xffffff51, compiler.normal_write,
                            compiler.write_one, 0xff)
    if compiler.register_read(ones, compiler.normal_read) <> 0xffffff51 then
        result = 8
        return
    end if
    result = 0x640
end main
