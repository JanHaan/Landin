import core/mem
import core/vec

mut backing: [1]u8 = zeroed
mut observed: u32 = 0
empty: type = [0]u8

exercise: () -> (result: u32) ! mem.out_of_memory =
    result = 1
    mut state := mem.fail_over(addr backing[0], 0, 1)
    mut values := vec.new_list(item: empty)
    maximum: usize = 0 -% 1
    try vec.reserve(values, state, maximum)
    return when vec.capacity(values) <> maximum or state.used <> 0
    return when state.allocations <> 1 or state.remaining <> 0
    value: empty = zeroed
    try vec.push(values, state, value)
    return when vec.length(values) <> 1
    vec.release(values, state)
    return when state.frees <> 1 or vec.capacity(values) <> 0
    result = 42
end exercise

start: () -> none = observed = exercise() else 1 end start
