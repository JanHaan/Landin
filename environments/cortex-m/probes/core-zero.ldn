import core/arena
import core/fault
import core/mem
import core/vec

mut backing: [1]u8 = zeroed
mut observed: u32 = 0
empty: type = [0]u8

exercise: () -> (result: u32) ! mem.out_of_memory =
    result = 1
    mut arena_space: arena.space = zeroed
    memory := arena.over(arena_space, addr backing[0], 0)
    mut space: fault.space = zeroed
    counted := fault.over(space, memory, usize(1))
    mut values := vec.new(item: empty)
    maximum: usize = 0 -% 1
    try vec.reserve(values, counted, maximum)
    return when vec.capacity(values) <> maximum or arena.used(memory) <> 0
    return when fault.successes(counted) <> 1 or fault.remaining(counted) <> 0
    value: empty = zeroed
    try vec.push(values, counted, value)
    return when vec.length(values) <> 1
    vec.release(values, counted)
    return when fault.frees(counted) <> 1 or vec.capacity(values) <> 0
    result = 42
end exercise

start: () -> none = observed = exercise() else 1 end start
