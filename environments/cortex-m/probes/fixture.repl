flash: Memory.MappedMemory @ sysbus 0
    size: 0x8000
ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x4000
nvic: IRQControllers.NVIC @ sysbus 0xe000e000
    priorityMask: 0xc0
    systickFrequency: 16000000
    IRQ -> cpu@0
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0"
    nvic: nvic
    PerformanceInMips: 16
model: Miscellaneous.FixturePeripheral @ sysbus 0x40070000
    IRQ -> nvic@0
