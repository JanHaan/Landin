-- QEMU's micro:bit with its constants in RAM: the constrained reference's
-- flash and RAM, read-only data placed in RAM, which reset copies from
-- its load image in flash before anything reads it (D1359).  The
-- descriptions lane runs the image from reset, and again with the copy
-- left out.  A lane description, not a chip's.

compiler.device("microbit-rodata-in-ram")
compiler.core("cortex-m0")
compiler.vectors(48)
compiler.boot("vector-table")
linker.region("FLASH", 0, 32 * 1024, "rx")
linker.region("RAM", 0x2000_0000, 16 * 1024, "rw")
linker.place("vectors", "FLASH")
linker.place("text", "FLASH")
linker.place("rodata", "RAM")
linker.place("data", "RAM")
linker.place("bss", "RAM")
linker.place("stack", "RAM", 4 * 1024)
