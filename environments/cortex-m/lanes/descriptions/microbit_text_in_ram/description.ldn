-- QEMU's micro:bit with its code run from RAM: the constrained
-- reference's flash and RAM, the first 12 KiB of RAM a region of its own
-- that text is placed in.  Reset copies the text there from its load
-- image in flash and keeps itself with the vector table (D1359); the
-- descriptions lane runs the image from reset, and again with the copy
-- left out.  A lane description, not a chip's.

compiler.device("microbit-text-in-ram")
compiler.core("cortex-m0")
compiler.vectors(48)
compiler.boot("vector-table")
linker.region("FLASH", 0, 32 * 1024, "rx")
linker.region("CODE", 0x2000_0000, 12 * 1024, "rwx")
linker.region("RAM", 0x2000_3000, 4 * 1024, "rw")
linker.place("vectors", "FLASH")
linker.place("text", "CODE")
linker.place("rodata", "FLASH")
linker.place("data", "RAM")
linker.place("bss", "RAM")
linker.place("stack", "RAM", 2 * 1024)
