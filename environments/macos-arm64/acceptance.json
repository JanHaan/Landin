{
  "schema": 2,
  "scope": "R5.40 native source debugging",
  "mode": "release",
  "commands": [
    [
      "./scripts/build.sh",
      "-j8"
    ],
    [
      "./scripts/test.sh",
      "--host"
    ],
    [
      "python3",
      "compiler/tests/darwin/check.py",
      "--refine",
      "{refine}",
      "--output",
      "{executions}"
    ],
    [
      "python3",
      "compiler/tests/darwin/bindings.py",
      "--refine",
      "{refine}",
      "--output",
      "{bindings}"
    ],
    [
      "./scripts/debug.sh",
      "--target=darwin-arm64",
      "--output",
      "{debugging}"
    ]
  ]
}
