{
  "schema": 4,
  "scope": "routine",
  "debugger": true,
  "modes": [
    "debug",
    "release"
  ],
  "hosted_modes": [
    "release"
  ],
  "debugger_modes": [
    "release"
  ],
  "commands": [
    [
      "env",
      "LANDIN_BUILD_MODE=debug",
      "./scripts/build.sh",
      "-j8"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=debug",
      "./scripts/test.sh",
      "--host"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=debug",
      "python3",
      "compiler/tests/test_determinism_controls.py"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=debug",
      "python3",
      "compiler/tests/test_determinism.py",
      "--refine",
      "{refine-debug}"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "./scripts/build.sh",
      "-j8"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "./scripts/test.sh",
      "--host"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "python3",
      "compiler/tests/test_determinism_controls.py"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "python3",
      "compiler/tests/test_determinism.py",
      "--refine",
      "{refine-release}"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "python3",
      "compiler/tests/darwin/diagnostics.py",
      "--refine",
      "{refine-release}",
      "--output",
      "{diagnostics-release}"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "python3",
      "compiler/tests/darwin/check.py",
      "--parity",
      "--refine",
      "{refine-release}",
      "--output",
      "{executions-release}"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "python3",
      "compiler/tests/darwin/bindings.py",
      "--parity",
      "--refine",
      "{refine-release}",
      "--output",
      "{bindings-release}"
    ],
    [
      "env",
      "LANDIN_BUILD_MODE=release",
      "./scripts/debug.sh",
      "--target=darwin-arm64",
      "--parity",
      "--output",
      "{debugging-release}"
    ]
  ]
}
