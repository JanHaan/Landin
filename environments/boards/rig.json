         "arguments": ["--probehive", "{probehive}", "--ram-loader", "{ram_loader}", "--hub", "{hub}", "--port", "{port}"]},
        {"board": "rp2350", "mode": "ram",
         "arguments": ["--probehive", "{probehive}", "--ram-loader", "{ram_loader}", "--hub", "{hub}", "--port", "{port}"]},
        {"board": "rp2350_hazard3", "mode": "boot",
