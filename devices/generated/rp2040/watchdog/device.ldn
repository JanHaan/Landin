-- Reset metadata performs no initialization. No device RMW is implicit.
compiler.assert(compiler.byte_order == little)
compiler.assert(sizeof u32 == 4 and alignof u32 == 4)
public base: usize = 0x40058000

public tick_offset: usize = 0x2c
public tick_address: usize = 0x4005802c
public tick_named_mask: u32 = 0x000fffff
public tick_reset_mask: u32 = 0x000003ff
public tick_reset_value: u32 = 0x00000200
public tick_image: type = layout(packed, u32) struct
    f_count: u9 at 11..19
    f_running: u1 at 10..10
    f_enable: u1 at 9..9
    f_cycles: u9 at 0..8
end tick_image

public tick_decode: (raw: u32) -> (image: tick_image) =
    image = zeroed
    bits: ptr mut u32 = ptr(usize(addr image))
    bits.val = raw
end tick_decode

public tick_encode: (image: tick_image) -> (raw: u32) =
    bits: ptr u32 = ptr(usize(addr image))
    raw = bits.val
end tick_encode

public tick_read: (device_base: usize) -> (raw: u32) =
    port: ptr u32 = ptr(device_base + tick_offset)
    raw = compiler.register_read(port, compiler.normal_read)
end tick_read

public tick_write: (device_base: usize, raw: u32) -> none =
    port: ptr mut u32 = ptr(device_base + tick_offset)
    compiler.register_write(port, raw, compiler.normal_write,
                            compiler.write_zero, 0x000fffff)
end tick_write
