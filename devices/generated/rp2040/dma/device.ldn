end intr_read

public intr_write: (device_base: usize, raw: u32) -> none =
    port: ptr mut u32 = ptr(device_base + intr_offset)
    compiler.register_write(port, raw, compiler.one_clears,
                            compiler.write_zero, 0x0000ffff)
end intr_write

public inte0_offset: usize = 0x404
public inte0_address: usize = 0x50000404
public inte0_named_mask: u32 = 0x0000ffff
public inte0_reset_mask: u32 = 0x0000ffff
public inte0_reset_value: u32 = 0x00000000
public inte0_image: type = layout(packed, u32) struct
    f_inte0: u16 at 0..15
end inte0_image

public inte0_decode: (raw: u32) -> (image: inte0_image) =
    image = zeroed
    bits: ptr mut u32 = ptr(usize(addr image))
    bits.val = raw
end inte0_decode

public inte0_encode: (image: inte0_image) -> (raw: u32) =
    bits: ptr u32 = ptr(usize(addr image))
    raw = bits.val
end inte0_encode

public inte0_read: (device_base: usize) -> (raw: u32) =
    port: ptr u32 = ptr(device_base + inte0_offset)
    raw = compiler.register_read(port, compiler.normal_read)
end inte0_read

public inte0_write: (device_base: usize, raw: u32) -> none =
    port: ptr mut u32 = ptr(device_base + inte0_offset)
    compiler.register_write(port, raw, compiler.normal_write,
                            compiler.write_zero, 0x0000ffff)
end inte0_write
