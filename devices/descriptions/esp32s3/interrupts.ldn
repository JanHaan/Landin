-- Generated from the SVD; memory.ldn beside it is written by hand.
-- The policy adds AES at 77: ESP-IDF v6.1 esp32s3 interrupts.h ETS_AES_INTR_SOURCE is 77 and interrupt_core0_reg.h AES_INT_MAP follows RSA_INT_MAP.
-- The policy moves SHA from 77 to 78: ESP-IDF v6.1 esp32s3 interrupts.h ETS_SHA_INTR_SOURCE is 78 and interrupt_core0_reg.h SHA_INT_MAP follows AES_INT_MAP; the SVD uses the AES source.
-- Its interrupts are interrupt-matrix sources, not slots: esp32s3/sources.

compiler.device("esp32-s3")
compiler.core("xtensa-lx7")
compiler.vectors(32)
