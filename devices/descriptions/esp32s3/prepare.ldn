-- Device preparation before compiler-owned Xtensa reset.
-- Cache-off entry remains stack-free. Cache-on entry is supported only
-- directly from the cold ROM loader (reset cause 1), with the checked
-- revision-0 ROM cache implementation and its unchanged callback table.
-- It writes back dirty data before disabling caches through the ROM APIs.
-- A warm RAM helper must still refuse enabled caches before writing SRAM.
--
-- Both MWDTs and the RWDT are unlocked with 0x50D8_3AA1, disabled, then
-- locked again. The CPU1 hardware stall follows cpu_utility_ll_stall_cpu:
-- RTC OPTIONS0's APP C0 is 2, SW_CPU_STALL's APP C1 is 0x21. It survives
-- debugger detach; a debug halt alone does not. The application leaves
-- caches disabled and their banks unused. Addresses/fields are independently
-- checked against the pinned vendor headers; see devices/README.md.
link(boot_stage) extern(naked) prepare: () -> none =
    assembler.block("""
        movi a2, 0x600c4000
        l32i a3, a2, 0
        bbsi a3, 0, _landin_device_cold_check
        l32i a3, a2, 0x60
        bbsi a3, 0, _landin_device_cold_check
        movi a5, 0
        j _landin_device_quiesce
        _landin_device_cold_check:
        movi a2, 0x60008000
        l32i a3, a2, 0x38     # RESET_STATE: CPU0 cause
        movi a4, 0x3f
        and a3, a3, a4
        movi a4, 1            # POWERON/CHIP_PU only; not caller provenance
        bne a3, a4, _landin_device_cache_refused
        movi a2, 0x400016f4
        l32i a3, a2, 0
        movi a4, 0x4004eaec
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x400016f8
        l32i a3, a2, 0
        movi a4, 0xa0ffff91
        bne a3, a4, _landin_device_rom_refused
        l32i a3, a2, 4
        movi a4, 9
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x4004eaec
        l32i a3, a2, 0
        movi a4, 0x81004136
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x40001868
        l32i a3, a2, 0
        movi a4, 0x4004f2b8
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x4000186c
        l32i a3, a2, 0
        movi a4, 0xa0ffff91
        bne a3, a4, _landin_device_rom_refused
        l32i a3, a2, 4
        movi a4, 9
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x4004f2b8
        l32i a3, a2, 0
        movi a4, 0x31004136
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x40001880
        l32i a3, a2, 0
        movi a4, 0x4004f32c
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x40001884
        l32i a3, a2, 0
        movi a4, 0xa0ffff91
        bne a3, a4, _landin_device_rom_refused
        l32i a3, a2, 4
        movi a4, 9
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x4004f32c
        l32i a3, a2, 0
        movi a4, 0x31004136
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x3fceffc4   # rom_cache_internal_table_ptr
        l32i a3, a2, 0
        movi a4, 0x3ff1e2b4   # immutable revision-0 default table
        bne a3, a4, _landin_device_rom_refused
        movi a2, 0x3ff1e2b4
        l32i a3, a2, 16
        movi a4, 0x4004e4c0
        bne a3, a4, _landin_device_rom_refused
        l32i a3, a2, 20
        movi a4, 0x4004e514
        bne a3, a4, _landin_device_rom_refused
        l32i a3, a2, 28
        movi a4, 0x4004e5a4
        bne a3, a4, _landin_device_rom_refused
        l32i a3, a2, 52
        movi a4, 0x4004e680
        bne a3, a4, _landin_device_rom_refused
        l32i a3, a2, 60
        movi a4, 0x4004e6d8
        bne a3, a4, _landin_device_rom_refused
        movi a5, 1
        _landin_device_quiesce:
        movi a3, 0x50d83aa1   # watchdog write key
        movi a4, 0
        movi a2, 0x6001f000   # TIMG0 base
        s32i a3, a2, 0x64     # WDTWPROTECT unlock
        s32i a4, a2, 0x48     # WDTCONFIG0 off
        s32i a4, a2, 0x64     # lock
        movi a2, 0x60020000   # TIMG1 base
        s32i a3, a2, 0x64
        s32i a4, a2, 0x48
        s32i a4, a2, 0x64
        movi a2, 0x60008000   # RTC_CNTL base
        s32i a3, a2, 0xb0     # WDTWPROTECT unlock
        s32i a4, a2, 0x98     # WDTCONFIG0 off
        s32i a4, a2, 0xb0     # lock
        movi a3, 0x8f1d312a   # SWD write key
        s32i a3, a2, 0xb8
        movi a3, 0xc0000000   # SWD_DISABLE and SWD_AUTO_FEED_EN
        s32i a3, a2, 0xb4
        s32i a4, a2, 0xb8     # lock
        l32i a3, a2, 0        # OPTIONS0
        movi a4, -4
        and a3, a3, a4
        movi a4, 2
        or a3, a3, a4
        s32i a3, a2, 0        # APP C0 = 2
        l32i a3, a2, 0xbc     # SW_CPU_STALL
        movi a4, 0xfc0fffff
        and a3, a3, a4
        movi a4, 0x02100000
        or a3, a3, a4
        s32i a3, a2, 0xbc     # APP C1 = 0x21
        memw
        bnez a5, _landin_device_cold_normalize
        j _landin_firmware_reset
        _landin_device_cold_normalize:
        # Compiler entry has prepared PS, windows, VECBASE and DRAM stack.
        movi a2, 0x600c4000
        l32i a3, a2, 0
        bbci a3, 0, _landin_device_disable_caches
        movi a8, 0x400016f8   # Cache_WriteBack_All before invalidation
        callx8 a8
        _landin_device_disable_caches:
        movi a8, 0x4000186c   # Cache_Disable_ICache: suspend, idle, invalidate
        callx8 a8
        movi a8, 0x40001884   # Cache_Disable_DCache: suspend, idle, invalidate
        callx8 a8
        movi a2, 0x600c4000
        l32i a3, a2, 0
        bbsi a3, 0, _landin_device_cache_refused
        l32i a3, a2, 0x60
        bbsi a3, 0, _landin_device_cache_refused
        memw
        isync
        j _landin_firmware_reset
        _landin_device_rom_refused:
        j _landin_device_rom_refused
        _landin_device_cache_refused:
        j _landin_device_cache_refused
        """)
end prepare
