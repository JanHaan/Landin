-- Generated from the SVD; memory.ldn beside it is written by hand.
-- The policy removes MCPWM2 at 41: ESP-IDF v6.1 esp32 interrupts.h skips reserved sources 41 and 42; the chip has PWM0 and PWM1 only.
-- The policy removes MCPWM3 at 42: ESP-IDF v6.1 esp32 interrupts.h skips reserved sources 41 and 42; the chip has PWM0 and PWM1 only.
-- The policy adds SLC0 at 10: ESP-IDF v6.1 esp32 interrupts.h ETS_SLC0_INTR_SOURCE is 10; dport_reg.h PRO_SLC0_INTR_MAP is the corresponding matrix register.
-- The policy adds SLC1 at 11: ESP-IDF v6.1 esp32 interrupts.h ETS_SLC1_INTR_SOURCE is 11; dport_reg.h PRO_SLC1_INTR_MAP is the corresponding matrix register.
-- Its interrupts are interrupt-matrix sources, not slots: esp32/sources.

compiler.device("esp32")
compiler.core("xtensa-lx6")
compiler.vectors(32)
