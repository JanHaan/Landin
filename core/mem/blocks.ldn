--  Byte blocks: copying, filling, comparing and searching byte slices, with
--  their lengths checked.

--- The left bytes order before the right ones.
public less: atom
--- The two byte strings are the same bytes.
public equal: atom
--- The left bytes order after the right ones.
public greater: atom
--- How two byte strings order: `less`, `equal` or `greater`.
public order: type = less | equal | greater

--- Order two byte strings as unsigned bytes, the first difference
--- deciding, and a string that is a proper prefix of the other ordering
--- first: C's `memcmp` with the lengths taken into account, and the order
--- `ls` gives names in the C locale.
public compare: (left: []u8, right: []u8) -> (result: order) =
    mut at: usize = 0
    while at < lenof left and at < lenof right do
        if left[at] <> right[at] then
            result = if left[at] < right[at] then less else greater end if
            return
        end if
        inc at
    end while
    if lenof left < lenof right then
        result = less
    elsif lenof left > lenof right then
        result = greater
    else
        result = equal
    end if
end compare

--  On firmware, copy, fill and find move a byte at a time.  A 32 KiB flash
--  image has no room for the word loops below: at `--optimize none` they
--  take about 7 KiB more of it, and 2.5 KiB even as one loop apiece, and
--  a Cortex-M0 word is only four bytes.
fixed if compiler.os == freestanding then
    --- Copy every byte of `source` to the start of `into`, as C's `memmove`
    --- does: the two may overlap, in either direction, and `into` then holds
    --- what `source` held before the copy.  Reports `out_of_bounds` before
    --- writing anything when `into` is shorter than `source`; bytes of `into`
    --- past the copy are untouched.
    ---
    --- One rule serves every overlap: a destination that begins after its
    --- source is copied from the last byte down, any other from the first byte
    --- up, so no byte is read after it has been overwritten.
    public copy: (into: []mut u8, source: []u8) -> none ! out_of_bounds =
        count: usize = lenof source
        fail out_of_bounds when count > lenof into
        return when count == 0
        target_address: usize = usize(addr into[0])
        source_address: usize = usize(addr source[0])
        if target_address > source_address then
            mut at: usize = count
            while at > 0 do
                dec at
                into[at] = source[at]
            end while
        else
            mut at: usize = 0
            while at < count do
                into[at] = source[at]
                inc at
            end while
        end if
    end copy

    --- Set every byte of `into` to `value`.
    public fill: (into: []mut u8, value: u8) -> none =
        mut at: usize = 0
        while at < lenof into do
            into[at] = value
            inc at
        end while
    end fill

    --- The index of the first byte of `source` equal to `value`, or the length
    --- of `source` when there is none, so that `source[0..<find(source, v)]`
    --- is always the part before it.
    public find: (source: []u8, value: u8) -> (index: usize) =
        index = 0
        while index < lenof source do
            return when source[index] == value
            inc index
        end while
    end find
else
    --  Elsewhere they move a machine word, a usize, at a time, and a word
    --  holds its bytes least significant first, as on every target Landin
    --  describes.  x86-64 and arm64 load and store a word at any address, so
    --  there copying up and searching move words from the first byte and
    --  bytes only in the tail.  RV64 may trap on a misaligned access or
    --  emulate it slowly, so there every word read or written is at a
    --  multiple of the word, between a head and a tail moved a byte at a
    --  time; so is every word copying down and filling move on any of them.
    word: usize = sizeof usize
    word_mask: usize = word - 1
    --  A one in every byte of a word, and the high bit of every byte.
    ones: usize = (0 -% 1) / 255
    highs: usize = ones << 7

    --- Copy every byte of `source` to the start of `into`, as C's `memmove`
    --- does: the two may overlap, in either direction, and `into` then holds
    --- what `source` held before the copy.  Reports `out_of_bounds` before
    --- writing anything when `into` is shorter than `source`; bytes of `into`
    --- past the copy are untouched.
    ---
    --- A destination that begins after the first byte of its source but
    --- inside it is copied from the last byte down, and any other from the
    --- first byte up, so no byte is read after it has been overwritten.
    public copy: (into: []mut u8, source: []u8) -> none ! out_of_bounds =
        count: usize = lenof source
        fail out_of_bounds when count > lenof into
        return when count == 0
        target_address: usize = usize(addr into[0])
        source_address: usize = usize(addr source[0])
        if target_address > source_address
          and target_address - source_address < count then
            copy_down(into, source, count)
        else
            copy_up(into, source, count)
        end if
    end copy

    --  The `count` words from `address` on, at a multiple of the word on
    --  RV64 and anywhere on x86-64 and arm64.  The bytes are the caller's:
    --  the view borrows nothing.
    words_over: (address: usize, count: usize) -> (words: []mut usize) =
        first: ptr mut [1]usize = ptr(address)
        words = first.val[0..<1]
        unchecked begin
            --  The caller's bytes hold `count` words.
            words = words[0..<count]
        end unchecked
    end words_over

    fixed if compiler.arch == x86_64 or compiler.arch == arm64 then
        --  Copy the first `count` bytes of `source` to the start of `into`,
        --  both at least that long, from the first byte up: a word at a time
        --  wherever the two begin, then the bytes left over.  A destination
        --  that overlaps the source begins at or before it, so every source
        --  byte is read before the destination byte over it is written.
        copy_up: (into: []mut u8, source: []u8, count: usize) -> none =
            whole: usize = count / word
            targets: []mut usize = words_over(usize(addr into[0]), whole)
            sources: []usize = words_over(usize(addr source[0]), whole)
            mut at: usize = 0
            unchecked begin
                --  Every index is below its loop's bound.
                while at < whole do
                    targets[at] = sources[at]
                    inc at
                end while
                at = whole * word
                while at < count do
                    into[at] = source[at]
                    inc at
                end while
            end unchecked
        end copy_up
    else
        --  Copy the first `count` bytes of `source` to the start of `into`,
        --  both at least that long, from the first byte up.  Once the
        --  destination is at a word, a source at a word too is copied a word
        --  at a time, and any other has each destination word put together
        --  from the two source words it straddles, read only where they lie
        --  inside the source.  A destination that overlaps the source begins
        --  at or before it, so a source word is always read before the
        --  destination word that overlaps it is written.
        copy_up: (into: []mut u8, source: []u8, count: usize) -> none =
            target_address: usize = usize(addr into[0])
            source_address: usize = usize(addr source[0])
            mut at: usize = 0
            unchecked begin
                --  Every index is below its loop's bound.
                while at < count and (target_address + at) & word_mask <> 0 do
                    into[at] = source[at]
                    inc at
                end while
                skew: usize = (source_address + at) & word_mask
                if skew == 0 then
                    whole: usize = (count - at) / word
                    targets: []mut usize =
                        words_over(target_address + at, whole)
                    sources: []usize = words_over(source_address + at, whole)
                    mut next: usize = 0
                    while next < whole do
                        targets[next] = sources[next]
                        inc next
                    end while
                    at += whole * word
                elsif count - at >= 3 * word then
                    --  The source word holding byte `at` begins `skew` bytes
                    --  before it, inside the source once `at` is at least
                    --  `skew`: a word more of bytes gets it there and keeps
                    --  the destination at a word.
                    if at < skew then
                        stop: usize = at + word
                        while at < stop do
                            into[at] = source[at]
                            inc at
                        end while
                    end if
                    --  Destination word `next` is the high bytes of source
                    --  word `next` and the low bytes of the one after it,
                    --  which ends inside the source for every one of the
                    --  `whole` words.
                    whole: usize = (count - at - (word - skew)) / word
                    targets: []mut usize =
                        words_over(target_address + at, whole)
                    sources: []usize =
                        words_over(source_address + at - skew, whole + 1)
                    shift: usize = 8 * skew
                    back: usize = 8 * word - shift
                    mut low: usize = sources[0]
                    mut next: usize = 0
                    while next < whole do
                        high: usize = sources[next + 1]
                        targets[next] = (low >> shift) | (high << back)
                        low = high
                        inc next
                    end while
                    at += whole * word
                end if
                while at < count do
                    into[at] = source[at]
                    inc at
                end while
            end unchecked
        end copy_up
    end if

    --  Copy the first `count` bytes of `source` to the start of `into` from
    --  the last byte down, for a destination that begins after the first
    --  byte of the source but inside it.
    --  Words are copied whole only when both are at a word at the same point,
    --  so the destination then begins at least a word after the source and
    --  each source word is read before it is overwritten.
    copy_down: (into: []mut u8, source: []u8, count: usize) -> none =
        target_address: usize = usize(addr into[0])
        source_address: usize = usize(addr source[0])
        mut at: usize = count
        unchecked begin
            --  Every index is below `count` by its loop's condition.
            while at > 0 and (target_address + at) & word_mask <> 0 do
                dec at
                into[at] = source[at]
            end while
            if (source_address + at) & word_mask == 0 then
                while at >= word do
                    at -= word
                    source_word: ptr usize = ptr(source_address + at)
                    target_word: ptr mut usize = ptr(target_address + at)
                    target_word.val = source_word.val
                end while
            end if
            while at > 0 do
                dec at
                into[at] = source[at]
            end while
        end unchecked
    end copy_down

    --- Set every byte of `into` to `value`.
    public fill: (into: []mut u8, value: u8) -> none =
        count: usize = lenof into
        return when count == 0
        target_address: usize = usize(addr into[0])
        pattern: usize = usize(value) * ones
        mut at: usize = 0
        unchecked begin
            --  Every index is below `count` by its loop's condition.
            while at < count and (target_address + at) & word_mask <> 0 do
                into[at] = value
                inc at
            end while
            while count - at >= word do
                target_word: ptr mut usize = ptr(target_address + at)
                target_word.val = pattern
                at += word
            end while
            while at < count do
                into[at] = value
                inc at
            end while
        end unchecked
    end fill

    --  The byte offset of the first of the `count` words from `address` on
    --  that holds the byte every byte of `pattern` is, or the offset just
    --  past them when none does; the caller searches that word a byte at a
    --  time.  A word holds the byte exactly when its exclusive or with
    --  `pattern` has a zero byte, which is exactly when subtracting a one
    --  from every byte borrows into a high bit that was clear.
    find_words: (address: usize, count: usize, pattern: usize)
                -> (index: usize) =
        held: []usize = words_over(address, count)
        mut next: usize = 0
        unchecked begin
            --  Every index is below its loop's bound.
            while next < count do
                mixed: usize = held[next] ^ pattern
                break when (mixed -% ones) & ~mixed & highs <> 0
                inc next
            end while
        end unchecked
        index = next * word
    end find_words

    fixed if compiler.arch == x86_64 or compiler.arch == arm64 then
        --- The index of the first byte of `source` equal to `value`, or the
        --- length of `source` when there is none, so that
        --- `source[0..<find(source, v)]` is always the part before it.
        public find: (source: []u8, value: u8) -> (index: usize) =
            count: usize = lenof source
            index = count
            return when count == 0
            pattern: usize = usize(value) * ones
            mut at: usize = find_words(usize(addr source[0]), count / word,
                                       pattern)
            unchecked begin
                --  Every index is below `count` by its loop's condition.
                while at < count do
                    if source[at] == value then
                        index = at
                        return
                    end if
                    inc at
                end while
            end unchecked
        end find
    else
        --- The index of the first byte of `source` equal to `value`, or the
        --- length of `source` when there is none, so that
        --- `source[0..<find(source, v)]` is always the part before it.
        public find: (source: []u8, value: u8) -> (index: usize) =
            count: usize = lenof source
            index = count
            return when count == 0
            source_address: usize = usize(addr source[0])
            pattern: usize = usize(value) * ones
            mut at: usize = 0
            unchecked begin
                --  Every index is below `count` by its loop's condition.
                while at < count and (source_address + at) & word_mask <> 0 do
                    if source[at] == value then
                        index = at
                        return
                    end if
                    inc at
                end while
            end unchecked
            at += find_words(source_address + at, (count - at) / word,
                             pattern)
            unchecked begin
                --  Every index is below `count` by its loop's condition.
                while at < count do
                    if source[at] == value then
                        index = at
                        return
                    end if
                    inc at
                end while
            end unchecked
        end find
    end if
end if
