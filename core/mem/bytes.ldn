--  The full allocation extent stays private beside the initialized witness.
--  Borrowed byte views do not replace that allocation identity.
buffer: type = struct
    values: storage(u8)
    extent: usize
end buffer
--- Opaque descriptor for an initialized byte allocation, retaining its full
--- allocation extent.
public byte_buffer: type = buffer

--- Lend the buffer's mutable initialized bytes. The buffer must remain
--- allocated while the view is used.
public bytes: (source: byte_buffer) -> (view: []mut u8 from source) =
    view = used(source.values)
end bytes

--- Allocate `count` zero-initialized bytes. A zero count returns an empty
--- buffer without calling the provider; allocation failure reports
--- `out_of_memory`.
public new_bytes: (provider: type is allocator, inout state: provider,
                   count: usize) -> (result: byte_buffer) ! out_of_memory =
    zero: usize = 0
    if count == 0 then
        none_yet := empty_storage(item: u8)
        result = (values: none_yet, extent: zero)
        return
    end if
    block: ptr mut u8 = try provider.alloc(state, count, alignof u8)
    mut fresh := storage_over(item: u8, base: block, slots: count)
    mut index: usize = 0
    initial: u8 = 0
    while index < count do
        admitted: usize = admit(fresh, initial) else (problem)
            --  Refusal is unreachable for this private state. If it occurs,
            --  release the saved allocation without trusting damaged counts.
            _ = problem
            provider.free(state, block, count)
            fail out_of_memory
        end
        _ = admitted
        inc index
    end while
    result = (values: fresh, extent: count)
end new_bytes

--- Free the buffer using its saved extent and reset it. Empty buffers require
--- no provider call. End all byte views before deletion.
public delete_bytes: (provider: type is allocator, inout state: provider,
                      inout value: byte_buffer) -> none =
    return when value.extent == 0
    extent: usize = value.extent
    clear(value.values)
    block: ptr mut u8 = dispose(value.values) else (problem)
        _ = problem
        return
    end
    value.extent = 0
    provider.free(state, block, extent)
end delete_bytes
