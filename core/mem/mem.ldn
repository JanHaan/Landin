--  Honest typed storage. The representation stays module-internal: callers
--  can hold an inferred raw(T), but only these operations can expose a value
--  or change the initialized-prefix count.

--  The two atoms every core container fails with. An index past the
--  initialized prefix is out_of_bounds whether the container is raw
--  storage, a vector, a small vector or a bounded log; taking from a
--  container with nothing to take is empty. Key lookups keep their own
--  atoms, because a missing key is not a bad index.
public out_of_bounds: atom
public empty: atom
public raw_full: atom
public raw_not_empty: atom

no_storage: atom
allocation: type = no_storage | ptr mut u8

raw: type (item: type) = struct
    base: allocation
    capacity_count: usize
    prefix: []mut item
end raw

--  The alias is the opaque name other core modules can put in fields and
--  signatures. It still normalizes to raw(item), whose private declaration
--  keeps the representation inaccessible outside this module.
public storage: type (item: type) = raw(item)
public out_of_memory: atom

public allocator: type = concept (provider: type)
    alloc: (inout state: provider, size: usize, alignment: usize)
           -> (block: ptr mut u8) ! out_of_memory
    --  Return true only when the same block now owns the larger extent.
    --  A refusal leaves both the block and provider state unchanged.
    grow: (inout state: provider, block: ptr mut u8,
           old_size: usize, new_size: usize, alignment: usize)
          -> (grown: bool)
    free: (inout state: provider, block: ptr mut u8, size: usize) -> none
end allocator

public allocate: (provider: type is allocator, inout state: provider,
                  size: usize, alignment: usize)
                 -> (block: ptr mut u8) ! out_of_memory =
    block = try provider.alloc(state, size, alignment)
end allocate

public free: (provider: type is allocator, inout state: provider,
              block: ptr mut u8, size: usize) -> none =
    provider.free(state, block, size)
end free

--  A descriptor without an allocation is not a zero-address allocation.
--  It owns no extent, admits no item and cannot yield a pointer on disposal.
public empty_storage: (item: type) -> (storage: raw(item)) =
    prefix: []mut item = []
    storage = (base: no_storage, capacity_count: 0, prefix: prefix)
end empty_storage

public reserve: (item: type, base: ptr mut u8, slots: usize)
                -> (storage: raw(item) from base) =
    prefix: []mut item = []
    storage = (base: base, capacity_count: slots, prefix: prefix)
end reserve

--  The provider validates the physical extension before the private logical
--  capacity changes. In particular, a zero-byte allocation keeps its usual
--  one-allocation-per-reserve behavior. Callers supply the actual old and
--  requested byte extents after checking capacity arithmetic.
public grow_storage: (item: type, provider: type is allocator,
                      inout storage: raw(item), inout state: provider,
                      old_size: usize, new_size: usize, slots: usize)
                     -> (grown: bool) =
    grown = false
    return when old_size == 0 or new_size <= old_size
    match storage.base
        no_storage: return
        ptr (base): begin
            grown = provider.grow(state, base, old_size, new_size,
                                  alignof item)
            if grown then
                storage.capacity_count = slots
            end if
        end
    end match
end grow_storage

public capacity: (item: type, storage: raw(item)) -> (count: usize) =
    count = storage.capacity_count
end capacity

public initialized: (item: type, storage: raw(item)) -> (count: usize) =
    prefix := storage.prefix
    count = lenof prefix
end initialized

public used: (item: type, storage: raw(item))
             -> (view: []mut item from storage) =
    view = storage.prefix
end used

public admit: (item: type, inout storage: raw(item), escaping value: item)
              -> (index: usize) ! raw_full =
    index = initialized(storage)
    fail raw_full when index >= storage.capacity_count
    wanted: usize = index + 1
    if index == 0 then
        match storage.base
            no_storage: fail raw_full
            ptr (base): begin
                first: ptr mut [1]item = ptr(usize(base))
                first.val[0] = value
                storage.prefix = first.val[0..<1]
            end
        end match
    else
        unchecked begin
            storage.prefix[index] = value
            storage.prefix = storage.prefix[0..<wanted]
        end unchecked
    end if
end admit

public get: (item: type, storage: raw(item), index: usize)
            -> (value: item from storage) ! out_of_bounds =
    fail out_of_bounds when index >= initialized(storage)
    value = storage.prefix[index]
end get

public replace: (item: type, inout storage: raw(item), index: usize,
                 escaping value: item) -> none ! out_of_bounds =
    fail out_of_bounds when index >= initialized(storage)
    storage.prefix[index] = value
end replace

--  Read a complete source value before entering the destination's narrow
--  unchecked append. The new prefix is published only after its typed store.
public transfer: (item: type, source: raw(item), index: usize,
                  inout target: raw(item))
                 -> (admitted: usize) ! out_of_bounds | raw_full =
    fail out_of_bounds when index >= initialized(source)
    admitted = initialized(target)
    fail raw_full when admitted >= target.capacity_count
    saved: item = source.prefix[index]
    wanted: usize = admitted + 1
    if admitted == 0 then
        match target.base
            no_storage: fail raw_full
            ptr (base): begin
                first: ptr mut [1]item = ptr(usize(base))
                first.val[0] = saved
                target.prefix = first.val[0..<1]
            end
        end match
    else
        unchecked begin
            --  The private transfer copies an already-retained value into
            --  independent raw storage, as the first-slot path does above.
            --  Capture that destination before publishing its new witness.
            slot: ptr mut item = ptr(usize(addr target.prefix[admitted]))
            slot.val = saved
            target.prefix = target.prefix[0..<wanted]
        end unchecked
    end if
end transfer

--  A zero-byte prefix has one logical item value repeated at the same
--  address. Establish the destination's own initialized witness with a
--  complete typed store before extending it to the requested count. The
--  source and destination counters and the destination allocation remain
--  checked, just as they are for individual transfers.
public transfer_zero_prefix: (item: type, source: raw(item),
                              inout target: raw(item), count: usize)
                             -> none ! out_of_bounds | raw_full =
    fail out_of_bounds when sizeof item <> 0
    fail out_of_bounds when count > initialized(source)
    fail raw_full when initialized(target) <> 0
    fail raw_full when count > target.capacity_count
    return when count == 0

    saved: item = source.prefix[0]
    match target.base
        no_storage: fail raw_full
        ptr (base): begin
            first: ptr mut [1]item = ptr(usize(base))
            first.val[0] = saved
            target.prefix = first.val[0..<1]
        end
    end match
    unchecked begin
        target.prefix = target.prefix[0..<count]
    end unchecked
end transfer_zero_prefix

--  With no payload bytes to destroy, shortening this witness discards all
--  logical items at once. Reject a nonzero-sized item before changing it.
public drain_zero_prefix: (item: type, inout storage: raw(item))
                          -> none ! raw_not_empty =
    fail raw_not_empty when sizeof item <> 0
    storage.prefix = storage.prefix[0..<0]
end drain_zero_prefix

--  Take the last initialized item back out of the prefix. This is the raw
--  pop; `release` is reserved for giving a container's storage back.
public withdraw: (item: type, inout storage: raw(item))
                 -> (value: item from storage) ! empty =
    count: usize = initialized(storage)
    fail empty when count == 0
    tail: usize = count - 1
    value = storage.prefix[tail]
    storage.prefix = storage.prefix[0..<tail]
end withdraw

--  Forget the initialized prefix without changing the backing allocation.
--  Values in that prefix are discarded; callers remain responsible for any
--  resources those values refer to.
public clear: (item: type, inout storage: raw(item)) -> none =
    storage.prefix = storage.prefix[0..<0]
end clear

public dispose: (item: type, inout storage: raw(item))
                -> (released: ptr mut u8 from storage)
                ! raw_not_empty | empty =
    fail raw_not_empty when initialized(storage) <> 0
    match storage.base
        no_storage: fail empty
        ptr (base): released = base
    end match
    storage.base = no_storage
    storage.prefix = []
    storage.capacity_count = 0
end dispose

--  Find the offset whose absolute address meets the requested alignment.
--  Zero alignment has the same byte-aligned meaning as one. Every operation
--  that could overflow is guarded, including the end of a zero- or nonzero-
--  sized result, so failure leaves allocator state for the caller to retain.
allocation_offset: (base: ptr mut u8, used: usize, extent: usize,
                    size: usize, alignment: usize)
                   -> (offset: usize) ! out_of_memory =
    maximum: usize = 0 -% 1
    fail out_of_memory when used > extent

    base_address: usize = usize(base)
    fail out_of_memory when used > maximum - base_address
    current_address: usize = base_address + used

    mut padding: usize = 0
    if alignment > 1 then
        --  alignof requests take the mask path; direct calls may need division.
        mask: usize = alignment - 1
        mut remainder: usize = 0
        if (alignment & mask) == 0 then
            remainder = current_address & mask
        else
            remainder = current_address % alignment
        end if
        if not (remainder == 0) then
            padding = alignment - remainder
        end if
    end if

    fail out_of_memory when padding > extent - used
    fail out_of_memory when padding > maximum - current_address
    offset = used + padding
    aligned_address: usize = current_address + padding
    fail out_of_memory when size > extent - offset
    fail out_of_memory when size > maximum - aligned_address
end allocation_offset

--  A library arena is a monotonic allocator over a caller-supplied byte
--  extent. Individual frees deliberately do nothing; ending the extent ends
--  all of its allocations together.
arena_value: type = struct
    base: ptr mut u8
    size: usize
    used: usize
end arena_value

public arena: type = arena_value

--  The independent allocator result may be retained after this call. Only
--  backing which the caller may itself retain can enter the checked arena.
public arena_over: (escaping base: ptr mut u8, size: usize)
                   -> (state: arena from base) =
    state = (base: base, size: size, used: 0)
end arena_over

--  Explicit lifetime opt-out for a local extent. The handle still keeps its
--  tracked origin, but allocations do not; users must end every allocation
--  before the backing ends, including allocations retained by helpers.
public arena_over_unchecked: (base: ptr mut u8, size: usize)
                             -> (state: arena from base) =
    state = (base: base, size: size, used: 0)
end arena_over_unchecked

public arena_used: (state: arena) -> (count: usize) =
    count = state.used
end arena_used

arena_alloc: (inout state: arena, size: usize, alignment: usize)
             -> (block: ptr mut u8) ! out_of_memory =
    offset: usize = try allocation_offset(state.base, state.used, state.size,
                                          size, alignment)
    address: usize = usize(state.base) + offset
    block = ptr(address)
    state.used = offset + size
end arena_alloc

arena_free: (inout state: arena, block: ptr mut u8, size: usize) -> none =
    _ = state.used
    _ = block
    _ = size
end arena_free

arena_grow: (inout state: arena, block: ptr mut u8,
             old_size: usize, new_size: usize, alignment: usize)
            -> (grown: bool) =
    grown = false
    return when new_size <= old_size or state.used > state.size
    base_address: usize = usize(state.base)
    block_address: usize = usize(block)
    return when block_address < base_address
    offset: usize = block_address - base_address
    return when offset > state.used or old_size <> state.used - offset
    return when alignment > 1 and block_address % alignment <> 0
    return when new_size > state.size - offset
    maximum: usize = 0 -% 1
    return when new_size > maximum - block_address
    state.used = offset + new_size
    grown = true
end arena_grow

arena is allocator (alloc: arena_alloc, grow: arena_grow, free: arena_free)

--  The same monotonic allocator with a deterministic allocation budget.
--  Tests can reach a container's out-of-memory edge without relying on the
--  host or exhausting an actual address space.
failing_value: type = struct
    base: ptr mut u8
    size: usize
    used: usize
    remaining: usize
    allocations: usize
    frees: usize
end failing_value

public failing: type = failing_value

public failing_over: (escaping base: ptr mut u8, size: usize,
                      successful_allocations: usize)
                     -> (state: failing from base) =
    state = (base: base, size: size, used: 0,
             remaining: successful_allocations, allocations: 0, frees: 0)
end failing_over

public failing_over_unchecked: (base: ptr mut u8, size: usize,
                                successful_allocations: usize)
                               -> (state: failing from base) =
    state = (base: base, size: size, used: 0,
             remaining: successful_allocations, allocations: 0, frees: 0)
end failing_over_unchecked

public failing_used: (state: failing) -> (count: usize) =
    count = state.used
end failing_used

public failing_remaining: (state: failing) -> (count: usize) =
    count = state.remaining
end failing_remaining

public failing_allocations: (state: failing) -> (count: usize) =
    count = state.allocations
end failing_allocations

public failing_frees: (state: failing) -> (count: usize) =
    count = state.frees
end failing_frees

failing_alloc: (inout state: failing, size: usize, alignment: usize)
               -> (block: ptr mut u8) ! out_of_memory =
    fail out_of_memory when state.remaining == 0
    offset: usize = try allocation_offset(state.base, state.used, state.size,
                                          size, alignment)
    dec state.remaining
    inc state.allocations
    address: usize = usize(state.base) + offset
    block = ptr(address)
    state.used = offset + size
end failing_alloc

failing_free: (inout state: failing, block: ptr mut u8, size: usize) -> none =
    _ = block
    _ = size
    inc state.frees
end failing_free

failing_grow: (inout state: failing, block: ptr mut u8,
               old_size: usize, new_size: usize, alignment: usize)
              -> (grown: bool) =
    _ = state.used
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end failing_grow

failing is allocator (alloc: failing_alloc, grow: failing_grow,
                      free: failing_free)
