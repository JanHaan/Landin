--  Honest typed storage. The representation stays module-internal: callers
--  can hold a storage(T), but only these operations can expose a value
--  or change the initialized-prefix count.

--- The index is outside the initialized prefix.
---
--- The two atoms every core container fails with. An index past the
--- initialized prefix is out_of_bounds whether the container is raw
--- storage, a vector, a spill list or a bounded log; taking from a
--- container with nothing to take is empty. Key lookups keep their own
--- atoms, because a missing key is not a bad index.
public out_of_bounds: atom
--- No initialized item or backing allocation is available for this operation.
public empty: atom
--- The storage has no spare slot for another initialized item.
public full: atom
--- The operation requires storage with an empty initialized prefix.
public not_empty: atom

no_storage: atom
allocation: type = no_storage | ptr mut u8

raw: type (item: type) = struct
    base: allocation
    capacity_count: usize
    prefix: []mut item
end raw

--- Opaque typed storage over caller-owned backing. Tracks capacity and an
--- initialized prefix; it does not own an allocator or prove the backing
--- lifetime.
---
--- The alias is the opaque name other core modules can put in fields and
--- signatures. It still normalizes to raw(item), whose private declaration
--- keeps the representation inaccessible outside this module.
public storage: type (item: type) = raw(item)
--- The provider cannot satisfy the size or alignment request, or its
--- arithmetic cannot represent the extent.
public out_of_memory: atom

--- Explicit allocation capability, given by a handle: a small copyable
--- value passed by value that refers to its provider's state. Free each
--- successful block once through the provider that allocated it, with its
--- current byte extent. Keep the provider's state and backing alive until all
--- uses end. Alignment zero or one means byte alignment; zero-byte requests
--- follow the provider's documented policy.
public allocator: type = concept (provider: type)
    --- Allocate the requested byte extent or report out_of_memory. Return
    --- backing valid until the matching free; honor the requested alignment.
    alloc: (self: provider, size: usize, alignment: usize)
           -> (block: ptr mut u8) ! out_of_memory
    --- Extend this same block in place. Return false without changing the
    --- block or provider state when extension is refused.
    grow: (self: provider, block: ptr mut u8,
           old_size: usize, new_size: usize, alignment: usize)
          -> (grown: bool)
    --- Give a successful block a new byte extent, larger or smaller, in place
    --- or by moving it, and return where it now is. Its first
    --- min(old_size, new_size) bytes are the ones it held, it honors the same
    --- alignment, and it is freed with `new_size`; a moved block's old
    --- address is given back and is not used again. Report out_of_memory
    --- with the block and provider unchanged when there is no room for it.
    --- A provider that cannot resize in place answers with `relocate`.
    resize: (self: provider, block: ptr mut u8,
             old_size: usize, new_size: usize, alignment: usize)
            -> (moved: ptr mut u8) ! out_of_memory
    --- Return a successful block with its current extent. The caller ends all
    --- uses first and must use the original provider.
    free: (self: provider, block: ptr mut u8, size: usize) -> none
end allocator

--- Request a byte extent with the supplied alignment through the provider.
--- Propagates `out_of_memory`; the caller owns the resulting allocation
--- obligation.
public allocate: (provider: type is allocator, memory: provider,
                  size: usize, alignment: usize)
                 -> (block: ptr mut u8) ! out_of_memory =
    block = try provider.alloc(memory, size, alignment)
end allocate

--- Grow a block of `old_size` bytes to `new_size` where it is, through the
--- provider: true when it did, and the block is then freed with
--- `new_size`; false, changing nothing, when the provider refuses, as any
--- may.
public grow: (provider: type is allocator, memory: provider,
              block: ptr mut u8, old_size: usize, new_size: usize,
              alignment: usize) -> (grown: bool) =
    grown = provider.grow(memory, block, old_size, new_size, alignment)
end grow

--- Give a block of `old_size` bytes the extent `new_size` through the
--- provider, which may move it: the result holds the block's first
--- min(old_size, new_size) bytes and is freed with `new_size`. Propagates
--- `out_of_memory`, after which the old block is still the caller's.
public resize: (provider: type is allocator, memory: provider,
                block: ptr mut u8, old_size: usize, new_size: usize,
                alignment: usize)
               -> (moved: ptr mut u8) ! out_of_memory =
    moved = try provider.resize(memory, block, old_size, new_size, alignment)
end resize

--  A writable view of `size` bytes at `block`, which a provider returned.
--  The block borrows nothing [0810], so neither does the view.
block_bytes: (block: ptr mut u8, size: usize) -> (view: []mut u8) =
    view = []
    return when size == 0
    first: ptr mut [1]u8 = ptr(usize(block))
    view = first.val[0..<1]
    unchecked begin
        --  The provider's block holds `size` bytes, at least one.
        view = view[0..<size]
    end unchecked
end block_bytes

--- Resize by moving, the `resize` of a provider that cannot resize in
--- place: allocate `new_size` bytes with `alignment`, copy the first
--- min(old_size, new_size) bytes there and free the old block with
--- `old_size`. A refused allocation reports `out_of_memory` with the old
--- block untouched. A provider's own `resize` entry calls it once any
--- in-place change it can make has been refused.
public relocate: (provider: type is allocator, memory: provider,
                  block: ptr mut u8, old_size: usize, new_size: usize,
                  alignment: usize)
                 -> (moved: ptr mut u8) ! out_of_memory =
    moved = try provider.alloc(memory, new_size, alignment)
    kept: usize = if new_size < old_size then new_size else old_size end if
    --  Two live blocks of at least `kept` bytes: the copy always fits.
    into: []mut u8 = block_bytes(moved, kept)
    copy(into, block_bytes(block, kept)) else none
    provider.free(memory, block, old_size)
end relocate

--- Return a block to its provider using the allocation's current extent. The
--- caller must end all uses first; no item cleanup runs.
public free: (provider: type is allocator, memory: provider,
              block: ptr mut u8, size: usize) -> none =
    provider.free(memory, block, size)
end free

--- Create an empty descriptor without allocating backing.
---
--- A descriptor without an allocation is not a zero-address allocation.
--- It owns no extent, admits no item and cannot yield a pointer on disposal.
public empty_storage: (item: type) -> (store: storage(item)) =
    prefix: []mut item = []
    store = (base: no_storage, capacity_count: 0, prefix: prefix)
end empty_storage

--- Describe `slots` items over an existing byte range without allocating or
--- initializing items. The caller supplies sufficient, correctly aligned
--- backing and keeps it alive; the extent multiplication must be
--- representable.
public storage_over: (item: type, base: ptr mut u8, slots: usize)
                     -> (result: storage(item) from base) =
    prefix: []mut item = []
    result = (base: base, capacity_count: slots, prefix: prefix)
end storage_over

--  Extend the same positive-byte allocation in place to `slots`, from
--  extents `reserve_storage` computed: the provider validates the physical
--  extension before the private logical capacity changes, so a refusal
--  leaves the storage as it was, and a zero-byte allocation keeps its one
--  allocation per reserve.
grow_storage: (item: type, provider: type is allocator,
               inout store: storage(item), memory: provider,
               old_size: usize, new_size: usize, slots: usize)
              -> (grown: bool) =
    grown = false
    return when old_size == 0 or new_size <= old_size
    match store.base
        no_storage: return
        ptr (base): begin
            grown = provider.grow(memory, base, old_size, new_size,
                                  alignof item)
            if grown then
                store.capacity_count = slots
            end if
        end
    end match
end grow_storage

--- The bytes `slots` items take: `out_of_memory` when the product is not
--- a `usize`, and zero for a zero-sized item, which still has its slots.
public storage_extent: (item: type, slots: usize)
                       -> (extent: usize) ! out_of_memory =
    size: usize = sizeof item
    extent = 0
    return when size == 0
    maximum: usize = 0 -% 1
    fail out_of_memory when slots > maximum / size
    extent = slots * size
end storage_extent

--- Give a storage's block back through the provider that gave it, first
--- discarding its initialized prefix without reading it, and leave it with
--- no storage.  Release what the items refer to first: nothing here does.
public release_storage: (item: type, provider: type is allocator,
                         inout store: storage(item), memory: provider)
                        -> none =
    clear(store)
    slots: usize = capacity(store)
    return when slots == 0
    --  Every capacity a storage reaches through `reserve_storage` passed
    --  `storage_extent`, so this product is representable.
    extent: usize = slots * sizeof item
    block: ptr mut u8 = dispose(store) else (problem)
        _ = problem
        return
    end
    provider.free(memory, block, extent)
end release_storage

--- Make room for at least `want` items, keeping the initialized prefix:
--- the block grows in place where the provider can grow it, and otherwise
--- the items move to a fresh block, which is published last, and the old
--- one is freed.  `out_of_memory` leaves the storage, its prefix and its
--- capacity as they were.  The containers' one way of taking slots
--- (D356); a move invalidates views of the old block.
public reserve_storage: (item: type, provider: type is allocator,
                         inout store: storage(item), memory: provider,
                         want: usize) -> none ! out_of_memory =
    old_count: usize = length(store)
    old_capacity: usize = capacity(store)
    return when want <= old_capacity
    extent: usize = try storage_extent(item: item, slots: want)
    old_extent: usize = old_capacity * sizeof item
    return when grow_storage(store, memory, old_extent, extent, want)
    block: ptr mut u8 = try provider.alloc(memory, extent, alignof item)
    mut fresh := storage_over(item: item, base: block, slots: want)
    transfer_prefix(store, fresh, old_count) else (problem)
        --  An empty replacement larger than the old capacity takes every
        --  item; were that invariant ever broken, roll back rather than
        --  report a provider's exhaustion that did not happen.
        _ = problem
        release_storage(fresh, memory)
        fail out_of_memory
    end
    release_storage(store, memory)
    store = fresh
end reserve_storage

--- Return the logical slot capacity, including slots for zero-sized items.
public capacity: (item: type, store: storage(item)) -> (count: usize) =
    count = store.capacity_count
end capacity

--- Return the number of initialized items in the prefix.
public length: (item: type, store: storage(item)) -> (count: usize) =
    count = lenof store.prefix
end length

--- Lend a mutable slice of the initialized prefix. End uses of the view
--- before invalidating or freeing its backing.
public used: (item: type, store: storage(item))
             -> (view: []mut item from store) =
    view = store.prefix
end used

--- Lend the bytes past a byte storage's initialized prefix, its spare
--- capacity, for the caller to write before `admit_bytes` counts them: the
--- buffer a read fills.  They hold whatever the backing held.  End uses of
--- the view before the storage is reserved, released or disposed.
public spare_bytes: (store: storage(u8)) -> (room: []mut u8 from store) =
    room = store.prefix[0..<0]
    count: usize = length(store)
    spare: usize = store.capacity_count - count
    return when spare == 0
    match store.base
        no_storage: return
        ptr (base): begin
            first: ptr mut [1]u8 = ptr(usize(base) + count)
            mut whole: []mut u8 = first.val[0..<1]
            unchecked begin
                --  The backing holds `capacity_count` bytes from `base`.
                whole = whole[0..<spare]
            end unchecked
            room = whole
        end
    end match
end spare_bytes

--- Count the first `count` bytes of the spare capacity, which the caller
--- has written, as initialized: the prefix ends past them.  Reports `full`,
--- changing nothing, when fewer than `count` bytes are spare.
public admit_bytes: (inout store: storage(u8), count: usize) -> none ! full =
    have: usize = length(store)
    fail full when count > store.capacity_count - have
    return when count == 0
    match store.base
        no_storage: fail full
        ptr (base): begin
            first: ptr mut [1]u8 = ptr(usize(base))
            mut whole: []mut u8 = first.val[0..<1]
            unchecked begin
                --  The backing holds `capacity_count` bytes from `base`.
                whole = whole[0..<have + count]
            end unchecked
            store.prefix = whole
        end
    end match
end admit_bytes

--- Copy `bytes` after a byte storage's initialized prefix and count them in
--- it, with `copy`, a word at a time where it moves words.  Reports `full`,
--- changing nothing, when the spare capacity is shorter than `bytes`.
public admit_copy: (inout store: storage(u8), bytes: []u8) -> none ! full =
    count: usize = lenof bytes
    return when count == 0
    room: []mut u8 = spare_bytes(store)
    fail full when count > lenof room
    copy(room[0..<count], bytes) else (problem)
        _ = problem
        fail full
    end
    try admit_bytes(store, count)
end admit_copy

--- Append a complete value into a spare slot and return its index. Reports
--- `full` without publishing a new prefix when no slot is available.
public admit: (item: type, inout store: storage(item), escaping value: item)
              -> (index: usize) ! full =
    index = length(store)
    fail full when index >= store.capacity_count
    wanted: usize = index + 1
    if index == 0 then
        match store.base
            no_storage: fail full
            ptr (base): begin
                first: ptr mut [1]item = ptr(usize(base))
                first.val[0] = value
                store.prefix = first.val[0..<1]
            end
        end match
    else
        unchecked begin
            store.prefix[index] = value
            store.prefix = store.prefix[0..<wanted]
        end unchecked
    end if
end admit

--- Copy the item at `index`. Reports `out_of_bounds` before reading outside
--- the initialized prefix; references inside the copy retain their origin.
public get: (item: type, store: storage(item), index: usize)
            -> (value: item from store) ! out_of_bounds =
    fail out_of_bounds when index >= length(store)
    value = store.prefix[index]
end get

--- Overwrite an initialized item. Reports `out_of_bounds` before mutation;
--- the caller handles resources held by the replaced value.
public replace: (item: type, inout store: storage(item), index: usize,
                 escaping value: item) -> none ! out_of_bounds =
    fail out_of_bounds when index >= length(store)
    store.prefix[index] = value
end replace

--- Copy one initialized source item to the end of the target. Checks source
--- index and target capacity before mutation; the source remains initialized.
---
--- Read a complete source value before entering the destination's narrow
--- unchecked append. The new prefix is published only after its typed store.
public transfer: (item: type, source: storage(item), index: usize,
                  inout target: storage(item))
                 -> (admitted: usize) ! out_of_bounds | full =
    fail out_of_bounds when index >= length(source)
    admitted = length(target)
    fail full when admitted >= target.capacity_count
    saved: item = source.prefix[index]
    wanted: usize = admitted + 1
    if admitted == 0 then
        match target.base
            no_storage: fail full
            ptr (base): begin
                first: ptr mut [1]item = ptr(usize(base))
                first.val[0] = saved
                target.prefix = first.val[0..<1]
            end
        end match
    else
        unchecked begin
            --  The private transfer copies an already-retained value into
            --  independent raw storage, as the first-slot path does above.
            --  Capture that destination before publishing its new witness.
            slot: ptr mut item = ptr(usize(addr target.prefix[admitted]))
            slot.val = saved
            target.prefix = target.prefix[0..<wanted]
        end unchecked
    end if
end transfer

--- Copy the first `count` initialized source items, in order, into an empty
--- target. Reports `out_of_bounds` when the source holds fewer, `not_empty`
--- when the target already holds items and `full` when its capacity is too
--- small, each before any mutation. The source remains initialized.
---
--- A zero-sized item has one logical value repeated at the same address, so
--- its prefix is established with one complete typed store and extended to
--- `count` in constant time.
public transfer_prefix: (item: type, source: storage(item),
                         inout target: storage(item), count: usize)
                        -> none ! out_of_bounds | not_empty | full =
    fail out_of_bounds when count > length(source)
    fail not_empty when length(target) <> 0
    fail full when count > target.capacity_count
    return when count == 0

    if sizeof item <> 0 then
        --  The items' bytes move whole, with `copy`, a word at a time where
        --  it moves words: the source holds `count` items, so their extent
        --  is representable, and the target's capacity holds them.
        extent: usize = count * sizeof item
        match target.base
            no_storage: fail full
            ptr (base): begin
                held: ptr mut u8 = ptr(usize(addr source.prefix[0]))
                copy(block_bytes(base, extent), block_bytes(held, extent))
                    else none
                first: ptr mut [1]item = ptr(usize(base))
                mut kept: []mut item = first.val[0..<1]
                unchecked begin
                    --  The target's backing holds at least `count` items.
                    kept = kept[0..<count]
                end unchecked
                target.prefix = kept
            end
        end match
        return
    end if

    saved: item = source.prefix[0]
    match target.base
        no_storage: fail full
        ptr (base): begin
            first: ptr mut [1]item = ptr(usize(base))
            first.val[0] = saved
            target.prefix = first.val[0..<1]
        end
    end match
    unchecked begin
        target.prefix = target.prefix[0..<count]
    end unchecked
end transfer_prefix

--- Remove and return the last initialized item, the raw pop. Reports `empty`
--- when the prefix is empty; backing and capacity remain available.
public withdraw: (item: type, inout store: storage(item))
                 -> (value: item from store) ! empty =
    count: usize = length(store)
    fail empty when count == 0
    tail: usize = count - 1
    value = store.prefix[tail]
    store.prefix = store.prefix[0..<tail]
end withdraw

--- Discard all initialized items in constant time while retaining backing and
--- capacity. Resources referred to by those values remain the caller's
--- responsibility.
public clear: (item: type, inout store: storage(item)) -> none =
    store.prefix = store.prefix[0..<0]
end clear

--- Detach backing from an empty descriptor and reset it. Reports
--- `not_empty` if items remain, or `empty` if no allocation exists. The
--- returned pointer must still be freed through its provider.
public dispose: (item: type, inout store: storage(item))
                -> (block: ptr mut u8 from store)
                ! not_empty | empty =
    fail not_empty when length(store) <> 0
    match store.base
        no_storage: fail empty
        ptr (base): block = base
    end match
    store.base = no_storage
    store.prefix = []
    store.capacity_count = 0
end dispose

--- Return the first offset at or after `used` within an `extent`-byte range
--- at `base` whose address meets `alignment` and leaves room for `size`
--- bytes. Reports `out_of_memory` when the range or the address space cannot
--- hold it. This is the arithmetic every bump provider needs; the caller
--- publishes `offset + size` as its new use only on success.
---
--- Zero alignment has the same byte-aligned meaning as one. Every operation
--- that could overflow is guarded, including the end of a zero- or nonzero-
--- sized result, so failure leaves allocator state for the caller to retain.
public aligned_offset: (base: ptr mut u8, used: usize, extent: usize,
                        size: usize, alignment: usize)
                       -> (offset: usize) ! out_of_memory =
    maximum: usize = 0 -% 1
    fail out_of_memory when used > extent

    base_address: usize = usize(base)
    fail out_of_memory when used > maximum - base_address
    current_address: usize = base_address + used

    mut padding: usize = 0
    if alignment > 1 then
        --  alignof requests take the mask path; direct calls may need division.
        mask: usize = alignment - 1
        mut remainder: usize = 0
        if (alignment & mask) == 0 then
            remainder = current_address & mask
        else
            remainder = current_address % alignment
        end if
        if not (remainder == 0) then
            padding = alignment - remainder
        end if
    end if

    fail out_of_memory when padding > extent - used
    fail out_of_memory when padding > maximum - current_address
    offset = used + padding
    aligned_address: usize = current_address + padding
    fail out_of_memory when size > extent - offset
    fail out_of_memory when size > maximum - aligned_address
end aligned_offset
