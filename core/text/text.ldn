--  The parser-support text layer is deliberately byte-oriented. D181--D184
--  add the hosted text identities, literals, indexing, direct ranges and
--  scalar traversal without changing this module's opaque positions or
--  bounded byte views.
--  D182 also accepts this exact public position identity for O(1) utf8
--  indexing; a position used that way must begin a codepoint.

import core/cmp

position_value: type = struct
    offset: usize
end position_value

--- Opaque byte offset for scanning. It does not retain or validate a source;
--- when used to index UTF-8 it must identify a codepoint boundary.
public position: type = position_value
--- A byte read at or beyond the end of its source, or a prefix longer
--- than the source.
public past_end: atom
--- The supplied bytes are not well-formed UTF-8.
public invalid_text: atom
--- The bytes are empty or are not the digits the parse reads: a byte
--- other than a digit, a sign where none is read, or a `-` without digits.
public invalid_number: atom
--- The parsed value is outside the type it is parsed into: above its
--- maximum, or for a signed type below its minimum.
public number_overflow: atom
--- The destination does not have room for the complete requested output.
public no_space: atom

byte_view: type = []u8

--- The zero-offset position sentinel. It has the same offset as `first`; it
--- is not a separate invalid-position tag.
public nowhere: position = (offset: 0)

--- Return a cursor at byte offset zero, including for an empty source.
public first: (source: []u8) -> (result: position) =
    _ = source
    result = (offset: 0)
end first

--- Return whether the byte offset is at or beyond the source length.
public at_end: (source: []u8, cursor: position) -> (yes: bool) =
    yes = cursor.offset >= lenof source
end at_end

--- Return the byte offset stored in a position. Index `utf8` with the
--- position itself: a `usize` index into `utf8` counts scalars, not bytes.
public offset: (cursor: position) -> (bytes: usize) =
    bytes = cursor.offset
end offset

--- Copy a position out of aggregate storage without borrowing that storage.
--- This matters to scanners that retain the token start while advancing the
--- cursor field from which it was read.
public copied: (cursor: position) -> (result: position) =
    result = (offset: cursor.offset)
end copied

--- Construct a cursor at a byte offset into `source`. Does not check bounds
--- or UTF-8 boundaries; later operations enforce their own requirements. The
--- source names the coordinate space, although the position stores only the
--- offset.
public cursor: (source: []u8, offset: usize) -> (result: position) =
    _ = source
    result = (offset: offset)
end cursor

--- Return a cursor one byte later. This is byte traversal, not Unicode-scalar
--- traversal; offset overflow follows ordinary checked arithmetic.
public next: (cursor: position) -> (result: position) =
    result = (offset: cursor.offset + 1)
end next

--- Advance the cursor by one byte in place. Does not validate the source or
--- skip a whole UTF-8 scalar.
public advance: (inout cursor: position) -> none =
    inc cursor.offset
end advance

--- Read one source byte at the cursor. Reports `past_end` before reading
--- outside the source.
public byte: (source: []u8, cursor: position)
             -> (value: u8) ! past_end =
    fail past_end when at_end(source, cursor)
    value = source[cursor.offset]
end byte

--- Lend bytes between two cursor offsets, with an exclusive end. Requires an
--- ordered interval within the source; invalid ranges follow the language's
--- checked range behavior.
public slice: (source: []u8, begins: position, ends: position)
              -> (result: []u8 from source) =
    result = source[begins.offset..<ends.offset]
end slice

--- Report whether the bytes are well-formed UTF-8: shortest-form encodings
--- of Unicode scalars, with no surrogate and nothing above U+10FFFF. This is
--- the check `from_bytes` makes; the `utf8(bytes)` conversion makes it too
--- but traps instead of reporting.
public valid: (source: []u8) -> (yes: bool) =
    mut cursor: usize = 0
    while cursor < lenof source do
        lead: u8 = source[cursor]
        if lead < 128 then
            cursor += 1
        elsif lead < 194 then
            yes = false
            return
        elsif lead < 224 then
            if lenof source - cursor < 2 then
                yes = false
                return
            end if
            second: u8 = source[cursor + 1]
            if second < 128 or second > 191 then
                yes = false
                return
            end if
            cursor += 2
        elsif lead < 240 then
            if lenof source - cursor < 3 then
                yes = false
                return
            end if
            second: u8 = source[cursor + 1]
            third: u8 = source[cursor + 2]
            if second < 128 or second > 191
              or third < 128 or third > 191
            then
                yes = false
                return
            end if
            if lead == 224 and second < 160 then
                yes = false
                return
            end if
            if lead == 237 and second > 159 then
                yes = false
                return
            end if
            cursor += 3
        elsif lead <= 244 then
            if lenof source - cursor < 4 then
                yes = false
                return
            end if
            second: u8 = source[cursor + 1]
            third: u8 = source[cursor + 2]
            fourth: u8 = source[cursor + 3]
            if second < 128 or second > 191
              or third < 128 or third > 191
              or fourth < 128 or fourth > 191
            then
                yes = false
                return
            end if
            if lead == 240 and second < 144 then
                yes = false
                return
            end if
            if lead == 244 and second > 143 then
                yes = false
                return
            end if
            cursor += 4
        else
            yes = false
            return
        end if
    end while
    yes = true
end valid

--- Validate a byte slice and lend it as UTF-8 without allocation. Reports
--- `invalid_text`; the caller keeps the bytes alive and valid while the view
--- is used.
---
--- The checked adapters report foreign or file-data defects before the
--- ordinary conversion establishes utf8's invariant.  Their result is a
--- source-derived view; no allocation, copy or canonical empty carrier is
--- introduced.
public from_bytes: (source: []u8)
                   -> (result: utf8 from source) ! invalid_text =
    fail invalid_text when not valid(source)
    result = utf8(source)
end from_bytes

--- Validate a terminated C string and lend it as UTF-8. The pointer must
--- remain readable through its terminator; invalid UTF-8 reports
--- `invalid_text`.
public from_c: (source: cstring)
               -> (result: utf8 from source) ! invalid_text =
    raw: []u8 = byte_view(source)
    result = try from_bytes(raw)
end from_c

--- Lend the encoded bytes of a UTF-8 view without copying or allocating.
public bytes: (source: utf8) -> (result: []u8 from source) =
    result = byte_view(source)
end bytes

--  A host string's representation.  Every system this compiler targets
--  names files and passes arguments as bytes, so it is the bytes.  A
--  system that names them in 16-bit units, as Windows does, fixes its own
--  representation here under `fixed if compiler.os`, and the operations
--  below keep their meaning over it.
host_value: type = struct
    bytes: []u8
end host_value

--- A host string: a path, a process argument or a directory entry's name,
--- in the representation its system gives and takes, and not converted on
--- the way through.  It is bytes on Linux, Darwin and FreeBSD, which need
--- not be UTF-8; `from_host` is the checked conversion to `utf8`,
--- `host_bytes` the conversion to bytes, and `host_equal` compares one
--- with a literal.  It lends what it was made from: an argument lends the
--- process's storage, an entry its directory's buffer, and `host_over` the
--- caller's bytes.  A NUL cannot be in a path or an argument, and the
--- system refuses one when it is given a host string holding one.
public host_string: type = host_value

--- A host string over the caller's bytes, which it lends.  Any bytes are
--- one; the system says whether it accepts them when it is given them.
--- A literal path is `text.host_over("input.txt")`.
public host_over: (source: []u8) -> (result: host_string from source) =
    result = (bytes: source)
end host_over

--- The host string's bytes, as the system gave them, lent.  Nothing is
--- validated or copied.
public host_bytes: (source: host_string) -> (result: []u8 from source) =
    result = source.bytes
end host_bytes

--- The host string as UTF-8 text, lent: the checked conversion, which
--- reports `invalid_text` when its bytes are not UTF-8, as `from_bytes`
--- does.  A host string that is not text is still a working path or
--- argument; it is only not `utf8`.
public from_host: (source: host_string)
                  -> (result: utf8 from source) ! invalid_text =
    result = try from_bytes(source.bytes)
end from_host

--- Whether the host string spells exactly the text `literal`, compared as
--- the system stores it, with no normalization: `--verbose` against an
--- argument, for one.
public host_equal: (value: host_string, literal: utf8) -> (yes: bool) =
    have: []u8 = value.bytes
    wanted: []u8 = bytes(literal)
    yes = false
    return when lenof have <> lenof wanted
    mut index: usize = 0
    while index < lenof wanted do
        return when have[index] <> wanted[index]
        inc index
    end while
    yes = true
end host_equal

--- Compare UTF-8 values by their encoded bytes. Does not normalize Unicode
--- spelling.
---
--- Equality and containment are exact encoded-byte operations.  Valid UTF-8
--- has one shortest-form encoding per scalar sequence, so neither operation
--- needs normalization or locale authority.
public equal: (left: utf8, right: utf8) -> (yes: bool) =
    left_bytes: []u8 = bytes(left)
    right_bytes: []u8 = bytes(right)
    if lenof left_bytes <> lenof right_bytes then
        yes = false
        return
    end if
    mut index: usize = 0
    while index < lenof left_bytes do
        if left_bytes[index] <> right_bytes[index] then
            yes = false
            return
        end if
        inc index
    end while
    yes = true
end equal

--- Test whether the sought UTF-8 byte sequence occurs in the source. Empty
--- text matches; no normalization or allocation is performed.
---
--- Two-Way search uses a critical split of the sought bytes.  Its two
--- lexicographic passes and the search each take linear time; only scalar
--- counters are kept, so neither a table nor a caller allocator is needed.
public contains: (source: utf8, sought: utf8) -> (yes: bool) =
    source_bytes: []u8 = bytes(source)
    sought_bytes: []u8 = bytes(sought)
    if lenof sought_bytes == 0 then
        yes = true
        return
    end if
    if lenof sought_bytes > lenof source_bytes then
        yes = false
        return
    end if

    sought_length: usize = lenof sought_bytes
    mut cut: usize = 0
    mut period: usize = 1
    mut pass: usize = 0
    while pass < 2 do
        mut maximum: usize = 0
        mut candidate: usize = 1
        mut matched: usize = 0
        mut local_period: usize = 1
        while candidate < sought_length
          and matched < sought_length - candidate
        do
            current: u8 = sought_bytes[candidate + matched]
            best: u8 = sought_bytes[maximum + matched]
            if (pass == 0 and current < best)
              or (pass == 1 and best < current)
            then
                candidate += matched + 1
                matched = 0
                local_period = candidate - maximum
            elsif current == best then
                if matched + 1 == local_period then
                    candidate += local_period
                    matched = 0
                else
                    inc matched
                end if
            else
                maximum = candidate
                inc candidate
                matched = 0
                local_period = 1
            end if
        end while
        if pass == 0 or maximum >= cut then
            cut = maximum
            period = local_period
        end if
        inc pass
    end while

    --  A period of the right half is a period of the whole sought value
    --  precisely when the left half agrees with its shifted copy.
    mut periodic: bool = cut <= sought_length - period
    mut offset: usize = 0
    while periodic and offset < cut do
        if sought_bytes[offset] <> sought_bytes[offset + period] then
            periodic = false
        end if
        inc offset
    end while
    if not periodic then
        if cut > sought_length - cut then
            period = cut + 1
        else
            period = sought_length - cut + 1
        end if
    end if

    mut start: usize = 0
    mut memory: usize = 0
    last: usize = lenof source_bytes - sought_length
    while start <= last do
        mut index: usize = cut
        if periodic and memory > index then
            index = memory
        end if
        while index < sought_length
          and sought_bytes[index] == source_bytes[start + index]
        do
            inc index
        end while
        if index < sought_length then
            start += index - cut + 1
            memory = 0
        else
            index = memory
            while index < cut
              and sought_bytes[index] == source_bytes[start + index]
            do
                inc index
            end while
            if index >= cut then
                yes = true
                return
            end if
            start += period
            if periodic then
                memory = sought_length - period
            end if
        end if
    end while
    yes = false
end contains

--- Hash UTF-8 encoded bytes consistently with `equal` and the byte-slice hash.
--- No Unicode normalization or cryptographic guarantee is provided.
---
--- utf8 is a map key and sortable as it stands: equality, hash and order
--- are over the encoded bytes, which valid UTF-8 makes unique per scalar
--- sequence. The hash is 64-bit FNV-1a, the same as core/cmp's for []u8.
public hash: (value: utf8) -> (result: u64) =
    raw: []u8 = bytes(value)
    mut folded: u64 = 14695981039346656037
    mut index: usize = 0
    while index < lenof raw do
        folded = (folded ^ u64(raw[index])) *% 1099511628211
        inc index
    end while
    result = folded
end hash

--- Compare encoded bytes lexicographically, with a shorter equal prefix
--- sorting first. This is not locale-aware collation.
---
--- Byte-wise lexicographic order, which for valid UTF-8 is scalar order.
public less: (left: utf8, right: utf8) -> (yes: bool) =
    left_bytes: []u8 = bytes(left)
    right_bytes: []u8 = bytes(right)
    mut index: usize = 0
    while index < lenof left_bytes and index < lenof right_bytes do
        if left_bytes[index] <> right_bytes[index] then
            yes = left_bytes[index] < right_bytes[index]
            return
        end if
        inc index
    end while
    yes = lenof left_bytes < lenof right_bytes
end less

utf8 is cmp.equatable (equal: equal)
utf8 is cmp.hashable (hash: hash)
utf8 is cmp.ordered (less: less)
