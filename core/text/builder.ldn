--  A builder writes typed pieces into bytes: a caller's buffer, or storage
--  an allocator the caller names grows.  Every append either writes its
--  whole piece or reports `no_space` and leaves the builder as it was.

import core/mem

--  Whose a builder's buffer is: the caller's, or nothing yet, or a block
--  the builder took from its allocator and gives back at `release`.
not_allocated: atom
allocated: atom
holding: type = not_allocated | allocated

--  `handed` counts the bytes a draining builder has handed to its outlet,
--  which `length`, `truncate` and the alignments count as written before
--  the ones the buffer holds (D1123); no other builder hands anything on.
--  `keeping` is set while a `format` is writing into the builder, and
--  `kept` is then the address of the first block a growth moved it out of
--  since, of `kept_extent` bytes, or zero when none has: the block every
--  view the call was given may read, which the call frees when it ends
--  (D1122).  It is an address, not a view, so that it borrows nothing.
builder_value: type = struct
    buffer: []mut u8
    used: usize
    handed: usize
    held: holding
    keeping: bool
    kept: usize
    kept_extent: usize
    policy: any grower
    growth: variant
        bounded |
        grows: (memory: any mem.allocator)
    end growth
end builder_value

--  What a builder does when a piece does not fit the room its buffer has
--  left: `over`'s refuses, `growing`'s doubles through the allocator, and
--  `format_onto`'s hands what it holds to an outlet.  Each builder holds
--  the table of the one that made it, and only that maker builds it, so an
--  image links the routines of only the policies its builders use: `room`
--  and `append` project the entries, and a table's routines are linked
--  only where something builds the table (D374).  A match arm calling them
--  directly would link every policy into every image that appends to a
--  builder, about 2.5 KiB of a Cortex-M0 image at none/off for the growth
--  alone.
grower: type = concept (implementation: type)
    --  Make room for `extra` more bytes after the used ones, more than the
    --  buffer has left, and append `bytes` when they are not empty, `extra`
    --  being their length; or report `no_space`.
    enlarge: (self: ptr implementation, inout target: builder_value,
              extra: usize, bytes: []u8) -> none ! no_space
end grower

--  `over`'s policy, which holds nothing and refuses.
refusing_value: type = struct
    unused: u8
end refusing_value

refusing: refusing_value = (unused: 0)

--  `growing`'s policy, which holds nothing: the doubling is `enlarge`'s.
doubling_value: type = struct
    unused: u8
end doubling_value

doubling: doubling_value = (unused: 0)

--  `format_onto`'s policy: the outlet a builder's bytes are handed to.
draining_value: type = struct
    onto: any outlet
end draining_value

--- Where `format_onto` hands the text it formats, a piece at a time.  An
--- outlet is a value the caller keeps.  It takes each piece whole or
--- reports `no_space`, and keeps its own reason for the caller, since a
--- builder's appends fail with nothing else.  `io.write_format` makes one
--- over a file.  Only a program that builds an erased `outlet` links any
--- outlet's routines (D374).
public outlet: type = concept (item: type)
    --- Take all of `bytes`, or report `no_space`.
    take: (self: ptr mut item, bytes: []u8) -> none ! no_space
end outlet

--- Text being built: the bytes written so far, in a buffer the caller gave
--- `over` or in storage that `growing` takes from an allocator.  It is a
--- value the caller keeps and edits, passing it `inout` to every append;
--- `used` lends what it holds.  It is bytes, not `utf8`: an append of bytes
--- or of a host string writes them as they are.  A `utf8_builder` holds
--- only text.
public builder: type = builder_value

--- A builder over the caller's `buffer`, empty, which never grows: an
--- append that does not fit reports `no_space`.  The buffer's earlier
--- contents are overwritten as pieces are appended.
public over: (buffer: []mut u8) -> (result: builder from buffer) =
    --  A read-only view of module storage, which no store reaches (D375).
    policy: any grower = any(addr refusing)
    result = (buffer: buffer, used: 0, handed: 0, held: not_allocated,
              keeping: false, kept: 0, kept_extent: 0, policy: policy,
              growth: bounded)
end over

--- An empty builder that takes its storage from `memory` as it needs it,
--- doubling what it holds, and reports `no_space` only when the allocator
--- refuses.  Build the erased allocator from the address of its handle's
--- binding, `text.growing(any(addr heap))`, and keep the handle and its
--- state alive while the builder is used.  `release` gives the storage
--- back: there are no destructors, so a builder dropped without it keeps
--- its storage.
public growing: (memory: any mem.allocator) -> (result: builder from memory) =
    nothing: []mut u8 = []
    --  A read-only view of module storage, which no store reaches and
    --  which outlives `memory` (D375).
    policy: any grower = any(addr doubling)
    result = (buffer: nothing, used: 0, handed: 0, held: not_allocated,
              keeping: false, kept: 0, kept_extent: 0, policy: policy,
              growth: grows(memory: memory))
end growing

--- The bytes written so far, lent from the builder until it is next
--- changed.
public used: (source: builder) -> (bytes: []u8 from source) =
    bytes = source.buffer[0..<source.used]
end used

--- How many bytes have been written: the offset the next piece begins at,
--- which `align_left` and `align_right` take as a piece's start and
--- `truncate` as where to cut.  It is the length of `used`, except in the
--- builder `format_onto` hands a conformance while it writes a value
--- longer than its whole store: there it also counts the bytes already
--- handed on, so an offset taken earlier still names the same byte
--- (D1123).
public length: (source: builder) -> (count: usize) =
    count = source.handed + source.used
end length

--- How many bytes the builder holds before it next fills: its buffer's
--- length, which grows for a builder from `growing`.
public capacity: (source: builder) -> (count: usize) =
    count = lenof source.buffer
end capacity

--- Forget everything written, keeping the buffer for the next text.
public clear: (inout target: builder) -> none =
    target.used = 0
end clear

--- Keep only the first `count` bytes written; a count at or past the
--- length changes nothing.  A `formattable` conformance that appends
--- several pieces puts the builder back with this, to an earlier `length`,
--- when a later piece reports `no_space`.  Bytes `format_onto` has already
--- handed on cannot be taken back: a count before them cuts everything
--- the builder still holds and nothing else (D1123).
public truncate: (inout target: builder, count: usize) -> none =
    if count < target.handed then
        target.used = 0
    elsif count - target.handed < target.used then
        target.used = count - target.handed
    end if
end truncate

--- Give a growing builder's storage back to its allocator and leave it
--- empty; it grows again from nothing if appended to.  A builder `over` a
--- caller's buffer has nothing to give back and is only cleared.  End every
--- use of `used` first.
public release: (inout target: builder) -> none =
    target.used = 0
    return when target.held == not_allocated
    extent: usize = lenof target.buffer
    block: ptr mut u8 = addr target.buffer[0]
    match target.growth
        bounded: return
        grows(memory): memory.free(block, extent)
    end match
    nothing: []mut u8 = []
    target.buffer = nothing
    target.held = not_allocated
end release

--  A writable view of `size` bytes at `block`, which an allocator returned.
--  The block borrows nothing [0810], so neither does the view.
view: (block: ptr mut u8, size: usize) -> (result: []mut u8) =
    first: ptr mut [1]u8 = ptr(usize(block))
    result = first.val[0..<1]
    unchecked begin
        result = result[0..<size]
    end unchecked
end view

--  Whether `bytes` lies in the block `buffer` is: a view of a builder's
--  own storage.  Both are live, so their addresses say.
within: (buffer: []mut u8, bytes: []u8) -> (yes: bool) =
    yes = false
    return when lenof bytes == 0 or lenof buffer == 0
    base: usize = usize(addr buffer[0])
    at: usize = usize(addr bytes[0])
    yes = at >= base and at - base < lenof buffer
end within

--  Room for `extra` more bytes in a growing builder, doubling the storage
--  it holds, with its bytes kept, then `bytes` appended: `no_space` when
--  the allocator refuses, changing nothing.  When nothing can read the
--  block again, the allocator's `resize` grows the storage in place or
--  moves it, a large block's pages where it can.  Something can when
--  `bytes` is a view of the block, or a `format` is writing and has kept
--  no block yet, since its template and its values may be views of it
--  (D1122).  The storage then grows where it is when the allocator can
--  grow it there, and otherwise moves to a fresh block as a container's
--  does (D356), `bytes` appended before the old block is given back.
doubling_enlarge: (self: ptr doubling_value, inout target: builder_value,
                   extra: usize, bytes: []u8) -> none ! no_space =
    maximum: usize = 0 -% 1
    fail no_space when extra > maximum - target.used
    wanted: usize = target.used + extra
    capacity_now: usize = lenof target.buffer
    mut size: usize = 16
    if capacity_now > maximum / 2 then
        size = maximum
    elsif capacity_now * 2 > size then
        size = capacity_now * 2
    end if
    if size < wanted then
        size = wanted
    end if
    match target.growth
        bounded: fail no_space
        grows(memory): begin
            mut moves: bool = true
            read_again: bool = within(target.buffer, bytes)
                               or (target.keeping and target.kept == 0)
            if target.held == allocated and not read_again then
                where: ptr mut u8 = addr target.buffer[0]
                block: ptr mut u8 = memory.resize(where, capacity_now, size,
                                                  1) else (problem)
                    _ = problem
                    fail no_space
                end
                target.buffer = view(block, size)
                moves = false
            elsif target.held == allocated then
                where: ptr mut u8 = addr target.buffer[0]
                if memory.grow(where, capacity_now, size, 1) then
                    target.buffer = view(where, size)
                    moves = false
                end if
            end if
            if moves then
                block: ptr mut u8 = memory.alloc(size, 1) else (problem)
                    _ = problem
                    fail no_space
                end
                fresh: []mut u8 = view(block, size)
                if target.held == allocated then
                    old: ptr mut u8 = addr target.buffer[0]
                    count: usize = lenof bytes
                    --  Two live blocks, the fresh one long enough for the
                    --  bytes written and `bytes`: both copies fit.  The
                    --  old block is still allocated, so `bytes` is read
                    --  before it is given back, whether or not it views
                    --  it.
                    mem.copy(fresh[0..<target.used],
                             target.buffer[0..<target.used]) else none
                    mem.copy(fresh[target.used..<target.used + count], bytes)
                        else none
                    target.buffer = fresh
                    target.used += count
                    --  The first block moved out of since a `format`
                    --  began is the one its template and values may view:
                    --  that call frees it when it ends.
                    if target.keeping and target.kept == 0 then
                        target.kept = usize(old)
                        target.kept_extent = capacity_now
                    else
                        memory.free(old, capacity_now)
                    end if
                    return
                end if
                target.buffer = fresh
                target.held = allocated
            end if
        end
    end match
    try append(target, bytes)
end doubling_enlarge

doubling_value is grower (enlarge: doubling_enlarge)

--  A bounded builder's answer to a piece that does not fit.
refusing_enlarge: (self: ptr refusing_value, inout target: builder_value,
                   extra: usize, bytes: []u8) -> none ! no_space =
    fail no_space
end refusing_enlarge

refusing_value is grower (enlarge: refusing_enlarge)

--  Hand what a builder holds to `onto`, which takes it whole or fails, and
--  empty the builder.
handed: (inout target: builder, onto: any outlet) -> none ! no_space =
    return when target.used == 0
    try onto.take(target.buffer[0..<target.used])
    target.handed += target.used
    target.used = 0
end handed

--  Room in a draining builder: what it holds is handed on and it starts
--  again from empty, which is room for anything its whole buffer holds.
--  `bytes` longer than that are handed on as they are.
draining_enlarge: (self: ptr draining_value, inout target: builder_value,
                   extra: usize, bytes: []u8) -> none ! no_space =
    onto: any outlet = self.val.onto
    try handed(target, onto)
    if extra <= lenof target.buffer then
        try append(target, bytes)
    elsif lenof bytes == extra then
        try onto.take(bytes)
        target.handed += extra
    else
        fail no_space
    end if
end draining_enlarge

draining_value is grower (enlarge: draining_enlarge)

--  Make room for `extra` more bytes after the used ones, asking the
--  builder's policy when the buffer has not the room: a bounded builder
--  reports `no_space`, a growing one doubles, and a draining one hands
--  what it holds on.  A failure changes nothing but what a draining
--  builder has handed on.
room: (inout target: builder, extra: usize) -> none ! no_space =
    return when extra <= lenof target.buffer - target.used
    policy: any grower = target.policy
    try policy.enlarge(target, extra, "")
end room

--- Append bytes as they are.
public append: (inout into: builder, bytes: []u8) -> none ! no_space =
    count: usize = lenof bytes
    if count > lenof into.buffer - into.used then
        policy: any grower = into.policy
        try policy.enlarge(into, count, bytes)
        return
    end if
    ends: usize = into.used + count
    mem.copy(into.buffer[into.used..<ends], bytes) else (problem)
        _ = problem
        fail no_space
    end
    into.used = ends
end append

--- Append one byte.
public append_byte: (inout into: builder, value: u8) -> none ! no_space =
    try room(into, 1)
    into.buffer[into.used] = value
    inc into.used
end append_byte

--- Append text's encoded bytes.
public append_text: (inout into: builder, value: utf8) -> none ! no_space =
    try append(into, bytes(value))
end append_text

--- Append a host string's bytes, as the system gave them: a name that is
--- not UTF-8 is written as it is.  Check it with `from_host` first where
--- the output must be text.
public append_host: (inout into: builder, value: host_string)
                    -> none ! no_space =
    try append(into, value.bytes)
end append_host

--- Append the UTF-8 encoding of `scalar`, one to four bytes, as `encode`
--- writes it.  A surrogate or a value above U+10FFFF reports
--- `invalid_scalar`, before a scalar that does not fit reports `no_space`,
--- and either leaves the builder as it was.
public append_scalar: (inout into: builder, scalar: u32)
                      -> none ! no_space | invalid_scalar =
    count: usize = encoded_width(scalar)
    fail invalid_scalar when count == 0
    try room(into, count)
    ends: usize = into.used + count
    stored(scalar, count, into.buffer[into.used..<ends])
    into.used = ends
end append_scalar

--  The library's one decimal writer (D355), at each width so that a
--  32-bit image writes a `u32` or a `usize` with 32-bit division: the
--  digits are counted by division before the first store, so a builder
--  without room for all of them is left as it was.

decimal_u32: (inout into: builder, value: u32) -> none ! no_space =
    mut digits: usize = 1
    mut scan: u32 = value
    while scan >= 10 do
        scan /= 10
        inc digits
    end while
    try room(into, digits)
    mut remaining: u32 = value
    mut offset: usize = digits
    while remaining >= 10 do
        quotient: u32 = remaining / 10
        dec offset
        into.buffer[into.used + offset] = u8(remaining - quotient * 10)
                                          + u8('0')
        remaining = quotient
    end while
    into.buffer[into.used] = u8(remaining) + u8('0')
    into.used += digits
end decimal_u32

decimal_u64: (inout into: builder, value: u64) -> none ! no_space =
    mut digits: usize = 1
    mut scan: u64 = value
    while scan >= 10 do
        scan /= 10
        inc digits
    end while
    try room(into, digits)
    mut remaining: u64 = value
    mut offset: usize = digits
    while remaining >= 10 do
        quotient: u64 = remaining / 10
        dec offset
        into.buffer[into.used + offset] = u8(remaining - quotient * 10)
                                          + u8('0')
        remaining = quotient
    end while
    into.buffer[into.used] = u8(remaining) + u8('0')
    into.used += digits
end decimal_u64

decimal_usize: (inout into: builder, value: usize) -> none ! no_space =
    mut digits: usize = 1
    mut scan: usize = value
    while scan >= 10 do
        scan /= 10
        inc digits
    end while
    try room(into, digits)
    mut remaining: usize = value
    mut offset: usize = digits
    while remaining >= 10 do
        quotient: usize = remaining / 10
        dec offset
        into.buffer[into.used + offset] = u8(remaining - quotient * 10)
                                          + u8('0')
        remaining = quotient
    end while
    into.buffer[into.used] = u8(remaining) + u8('0')
    into.used += digits
end decimal_usize

--- Append a `u32` in decimal: its digits, with no sign, padding or
--- separator.  Write `u8` and `u16` through it.
public append_u32: (inout into: builder, value: u32) -> none ! no_space =
    try decimal_u32(into, value)
end append_u32

--- Append a `u64` in decimal.
public append_u64: (inout into: builder, value: u64) -> none ! no_space =
    try decimal_u64(into, value)
end append_u64

--- Append a `usize` in decimal, at the target's width.
public append_usize: (inout into: builder, value: usize) -> none ! no_space =
    try decimal_usize(into, value)
end append_usize

--- Append an `i32` in decimal: a `-` before a negative value's digits and
--- nothing before any other's.  Write `i8` and `i16` through it.
public append_i32: (inout into: builder, value: i32) -> none ! no_space =
    if value >= 0 then
        try append_u32(into, u32(value))
        return
    end if
    start: usize = length(into)
    try append_byte(into, u8('-'))
    magnitude: u32 = u32(0 - (value + 1)) + 1
    append_u32(into, magnitude) else (problem)
        truncate(into, start)
        fail problem
    end
end append_i32

--- Append an `i64` in decimal, signed as `append_i32` is.
public append_i64: (inout into: builder, value: i64) -> none ! no_space =
    if value >= 0 then
        try append_u64(into, u64(value))
        return
    end if
    start: usize = length(into)
    try append_byte(into, u8('-'))
    magnitude: u64 = u64(0 - (value + 1)) + 1
    append_u64(into, magnitude) else (problem)
        truncate(into, start)
        fail problem
    end
end append_i64

--- Append an `isize` in decimal, signed as `append_i32` is.
public append_isize: (inout into: builder, value: isize) -> none ! no_space =
    if value >= 0 then
        try append_usize(into, usize(value))
        return
    end if
    start: usize = length(into)
    try append_byte(into, u8('-'))
    magnitude: usize = usize(0 - (value + 1)) + 1
    append_usize(into, magnitude) else (problem)
        truncate(into, start)
        fail problem
    end
end append_isize

hex_digits: []u8 = "0123456789abcdef"

--- Append a `u32` in hexadecimal: lower-case digits, as few as the value
--- needs, and no `0x`, which is a piece of its own.
public append_hex_u32: (inout into: builder, value: u32) -> none ! no_space =
    mut count: usize = 1
    mut scan: u32 = value >> 4
    while scan <> 0 do
        inc count
        scan = scan >> 4
    end while
    try room(into, count)
    mut remaining: u32 = value
    mut at: usize = into.used + count
    while at > into.used do
        dec at
        into.buffer[at] = hex_digits[usize(remaining & 15)]
        remaining = remaining >> 4
    end while
    into.used += count
end append_hex_u32

--- Append a `u64` in hexadecimal, as `append_hex_u32` does.
public append_hex_u64: (inout into: builder, value: u64) -> none ! no_space =
    mut count: usize = 1
    mut scan: u64 = value >> 4
    while scan <> 0 do
        inc count
        scan = scan >> 4
    end while
    try room(into, count)
    mut remaining: u64 = value
    mut at: usize = into.used + count
    while at > into.used do
        dec at
        into.buffer[at] = hex_digits[usize(remaining & 15)]
        remaining = remaining >> 4
    end while
    into.used += count
end append_hex_u64

--- Append a `usize` in hexadecimal, as `append_hex_u32` does.
public append_hex_usize: (inout into: builder, value: usize)
                         -> none ! no_space =
    mut count: usize = 1
    mut scan: usize = value >> 4
    while scan <> 0 do
        inc count
        scan = scan >> 4
    end while
    try room(into, count)
    mut remaining: usize = value
    mut at: usize = into.used + count
    while at > into.used do
        dec at
        into.buffer[at] = hex_digits[remaining & 15]
        remaining = remaining >> 4
    end while
    into.used += count
end append_hex_usize

--- Right-align the piece written since `start`, an earlier `length`, in a
--- field `width` bytes wide: `fill` goes before it until the field is
--- full.  A piece as wide as the field or wider is left as it is.  The fill
--- goes before the whole piece, a sign included, so a zero fill suits an
--- unsigned value.  A `start` past the length is a checked-range trap, as a
--- slice's would be.  The piece has to be in the builder still: where
--- `format_onto` has handed any of it on, or has to hand it on to make
--- room for the fill, nothing can go before it and the call reports
--- `no_space` (D1123).
public align_right: (inout into: builder, start: usize, width: usize,
                     fill: u8) -> none ! no_space =
    piece: usize = length(into) - start
    return when piece >= width
    fail no_space when start < into.handed
    padding: usize = width - piece
    try room(into, padding)
    --  A draining builder made the room by handing the piece on.
    fail no_space when start < into.handed
    begins: usize = start - into.handed
    ends: usize = into.used + padding
    moved: usize = begins + padding
    mem.copy(into.buffer[moved..<ends], into.buffer[begins..<into.used])
        else (problem)
        _ = problem
        fail no_space
    end
    mem.fill(into.buffer[begins..<moved], fill)
    into.used = ends
end align_right

--- Left-align the piece written since `start` in a field `width` bytes
--- wide: `fill` goes after it until the field is full.  A piece as wide as
--- the field or wider is left as it is.  The fill follows the piece
--- wherever its start now is, handed on by `format_onto` or not.
public align_left: (inout into: builder, start: usize, width: usize,
                    fill: u8) -> none ! no_space =
    piece: usize = length(into) - start
    return when piece >= width
    padding: usize = width - piece
    try room(into, padding)
    ends: usize = into.used + padding
    mem.fill(into.buffer[into.used..<ends], fill)
    into.used = ends
end align_left

--  A `utf8_builder` is a byte builder that holds only whole scalars: its
--  appends are text, scalars and numbers, whose digits and sign are ASCII,
--  and it is cut back only to a scalar's start, so its bytes are UTF-8
--  whatever was appended to it and in whatever order.
utf8_builder_value: type = struct
    inner: builder_value
end utf8_builder_value

--- Text being built that is always UTF-8: a builder over a buffer the
--- caller gave `utf8_over`, which takes text, scalars and numbers and
--- nothing else, since bytes or a host string could be anything.  Each
--- call is the byte builder's with `utf8_` before it, and writes the same
--- bytes: whole, or `no_space` and the builder left as it was.
public utf8_builder: type = utf8_builder_value

--- A `utf8_builder` over the caller's `buffer`, empty, which never grows,
--- as `over`'s builder does not.
public utf8_over: (buffer: []mut u8) -> (result: utf8_builder from buffer) =
    result = (inner: over(buffer))
end utf8_over

--- The text written so far, as bytes, lent from the builder until it is
--- next changed.  They are UTF-8 however the builder was used.
public utf8_bytes: (source: utf8_builder) -> (bytes: []u8 from source) =
    bytes = source.inner.buffer[0..<source.inner.used]
end utf8_bytes

--- The text written so far, lent from the builder until it is next
--- changed.  Nothing is scanned: every append wrote whole scalars and
--- every cut kept them, so the bytes are UTF-8 already.
public utf8_used: (source: utf8_builder) -> (result: utf8 from source) =
    held: []u8 = source.inner.buffer[0..<source.inner.used]
    unchecked begin
        --  Valid by construction (D948), so not validated again (D949).
        result = compiler.utf8_unvalidated(held)
    end unchecked
end utf8_used

--- How many bytes have been written: the offset the next piece begins
--- at, which is always a scalar's start.
public utf8_length: (source: utf8_builder) -> (count: usize) =
    count = source.inner.used
end utf8_length

--- How many bytes the builder holds before it fills: its buffer's length.
public utf8_capacity: (source: utf8_builder) -> (count: usize) =
    count = lenof source.inner.buffer
end utf8_capacity

--- Forget everything written, keeping the buffer for the next text.
public utf8_clear: (inout target: utf8_builder) -> none =
    target.inner.used = 0
end utf8_clear

--- Keep the whole scalars of the first `count` bytes written: a count
--- inside a scalar keeps only the scalars before it, so the text stays
--- UTF-8, and a count at or past the length changes nothing.  A count an
--- earlier `utf8_length` gave is always a scalar's start.
public utf8_truncate: (inout target: utf8_builder, count: usize) -> none =
    return when count >= target.inner.used
    mut kept: usize = count
    --  The byte at `kept` is the first one cut; a continuation byte there
    --  means the cut would split its scalar.
    while kept > 0 and target.inner.buffer[kept] >= 128
      and target.inner.buffer[kept] < 192
    do
        dec kept
    end while
    target.inner.used = kept
end utf8_truncate

--- Append text.
public utf8_append_text: (inout into: utf8_builder, value: utf8)
                         -> none ! no_space =
    try append(into.inner, bytes(value))
end utf8_append_text

--- Append the UTF-8 encoding of `scalar`, as `append_scalar` does.
public utf8_append_scalar: (inout into: utf8_builder, scalar: u32)
                           -> none ! no_space | invalid_scalar =
    try append_scalar(into.inner, scalar)
end utf8_append_scalar

--- Append a `u32` in decimal, as `append_u32` does.
public utf8_append_u32: (inout into: utf8_builder, value: u32)
                        -> none ! no_space =
    try decimal_u32(into.inner, value)
end utf8_append_u32

--- Append a `u64` in decimal.
public utf8_append_u64: (inout into: utf8_builder, value: u64)
                        -> none ! no_space =
    try decimal_u64(into.inner, value)
end utf8_append_u64

--- Append a `usize` in decimal, at the target's width.
public utf8_append_usize: (inout into: utf8_builder, value: usize)
                          -> none ! no_space =
    try decimal_usize(into.inner, value)
end utf8_append_usize

--- Append an `i32` in decimal, with a `-` before a negative value.
public utf8_append_i32: (inout into: utf8_builder, value: i32)
                        -> none ! no_space =
    try append_i32(into.inner, value)
end utf8_append_i32

--- Append an `i64` in decimal, signed as `utf8_append_i32` is.
public utf8_append_i64: (inout into: utf8_builder, value: i64)
                        -> none ! no_space =
    try append_i64(into.inner, value)
end utf8_append_i64

--- Append an `isize` in decimal, signed as `utf8_append_i32` is.
public utf8_append_isize: (inout into: utf8_builder, value: isize)
                          -> none ! no_space =
    try append_isize(into.inner, value)
end utf8_append_isize

--- Append a `u32` in lower-case hexadecimal, as `append_hex_u32` does.
public utf8_append_hex_u32: (inout into: utf8_builder, value: u32)
                            -> none ! no_space =
    try append_hex_u32(into.inner, value)
end utf8_append_hex_u32

--- Append a `u64` in lower-case hexadecimal.
public utf8_append_hex_u64: (inout into: utf8_builder, value: u64)
                            -> none ! no_space =
    try append_hex_u64(into.inner, value)
end utf8_append_hex_u64

--- Append a `usize` in lower-case hexadecimal.
public utf8_append_hex_usize: (inout into: utf8_builder, value: usize)
                              -> none ! no_space =
    try append_hex_usize(into.inner, value)
end utf8_append_hex_usize
