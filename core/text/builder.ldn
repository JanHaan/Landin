--  A builder writes typed pieces into bytes: a caller's buffer, or storage
--  an allocator the caller names grows.  Every append either writes its
--  whole piece or reports `no_space` and leaves the builder as it was.

import core/mem

--  Whose a builder's buffer is: the caller's, or nothing yet, or a block
--  the builder took from its allocator and gives back at `release`.
not_allocated: atom
allocated: atom
holding: type = not_allocated | allocated

builder_value: type = struct
    buffer: []mut u8
    used: usize
    held: holding
    policy: any grower
    growth: variant
        bounded |
        grows: (memory: any mem.allocator)
    end growth
end builder_value

--  What a builder does when a piece does not fit the room its buffer has
--  left: `over`'s refuses, `growing`'s doubles through the allocator, and
--  `format_onto`'s hands what it holds to an outlet.  Each builder holds
--  the table of the one that made it, and only that maker builds it, so an
--  image links the routines of only the policies its builders use: `room`
--  and `append` project the entries, and a table's routines are linked
--  only where something builds the table (D374).  A match arm calling them
--  directly would link every policy into every image that appends to a
--  builder, about 2.5 KiB of a Cortex-M0 image at none/off for the growth
--  alone.
grower: type = concept (implementation: type)
    --  Make room for `extra` more bytes after the used ones, more than the
    --  buffer has left, and append `bytes` when they are not empty, `extra`
    --  being their length; or report `no_space`.
    enlarge: (self: ptr implementation, inout target: builder_value,
              extra: usize, bytes: []u8) -> none ! no_space
end grower

--  `over`'s policy, which holds nothing and refuses.
refusing_value: type = struct
    unused: u8
end refusing_value

refusing: refusing_value = (unused: 0)

--  `growing`'s policy, which holds nothing: the doubling is `enlarge`'s.
doubling_value: type = struct
    unused: u8
end doubling_value

doubling: doubling_value = (unused: 0)

--  `format_onto`'s policy: the outlet a builder's bytes are handed to.
draining_value: type = struct
    onto: any outlet
end draining_value

--- Where `format_onto` hands the text it formats, a piece at a time: a
--- value the caller keeps, which takes each piece whole or reports
--- `no_space`, keeping its own reason for the caller, since a builder's
--- appends fail with nothing else.  `io.write_format` makes one over a
--- file.  Only a program that builds an erased `outlet` links any
--- outlet's routines (D374).
public outlet: type = concept (item: type)
    --- Take all of `bytes`, or report `no_space`.
    take: (self: ptr mut item, bytes: []u8) -> none ! no_space
end outlet

--- Text being built: the bytes written so far, in a buffer the caller gave
--- `over` or in storage that `growing` takes from an allocator.  A value
--- the caller keeps and edits, passing it `inout` to every append; `used`
--- lends what it holds.  It is bytes, not `utf8`: an append of bytes or of
--- a host string writes them as they are.
public builder: type = builder_value

--- A builder over the caller's `buffer`, empty, which never grows: an
--- append that does not fit reports `no_space`.  The buffer's earlier
--- contents are overwritten as pieces are appended.
public over: (buffer: []mut u8) -> (result: builder from buffer) =
    --  A read-only view of module storage, which no store reaches (D375).
    policy: any grower = any(addr refusing)
    result = (buffer: buffer, used: 0, held: not_allocated, policy: policy,
              growth: bounded)
end over

--- An empty builder that takes its storage from `memory` as it needs it,
--- doubling what it holds, and reports `no_space` only when the allocator
--- refuses.  Build the erased allocator from the address of its handle's
--- binding, `text.growing(any(addr heap))`, and keep the handle and its
--- state alive while the builder is used.  `release` gives the storage
--- back: there are no destructors, so a builder dropped without it keeps
--- its storage.
public growing: (memory: any mem.allocator) -> (result: builder from memory) =
    nothing: []mut u8 = []
    --  A read-only view of module storage, which no store reaches and
    --  which outlives `memory` (D375).
    policy: any grower = any(addr doubling)
    result = (buffer: nothing, used: 0, held: not_allocated, policy: policy,
              growth: grows(memory: memory))
end growing

--- The bytes written so far, lent from the builder until it is next
--- changed.
public used: (source: builder) -> (bytes: []u8 from source) =
    bytes = source.buffer[0..<source.used]
end used

--- How many bytes have been written: the offset the next piece begins at,
--- which `align_left` and `align_right` take as a piece's start.
public length: (source: builder) -> (count: usize) =
    count = source.used
end length

--- How many bytes the builder holds before it next fills: its buffer's
--- length, which grows for a builder from `growing`.
public capacity: (source: builder) -> (count: usize) =
    count = lenof source.buffer
end capacity

--- Forget everything written, keeping the buffer for the next text.
public clear: (inout target: builder) -> none =
    target.used = 0
end clear

--- Keep only the first `count` bytes written; a count at or past the
--- length changes nothing.  A `formattable` conformance that appends
--- several pieces puts the builder back with this, to an earlier `length`,
--- when a later piece reports `no_space`.
public truncate: (inout target: builder, count: usize) -> none =
    if count < target.used then
        target.used = count
    end if
end truncate

--- Give a growing builder's storage back to its allocator and leave it
--- empty; it grows again from nothing if appended to.  A builder `over` a
--- caller's buffer has nothing to give back and is only cleared.  End every
--- use of `used` first.
public release: (inout target: builder) -> none =
    target.used = 0
    return when target.held == not_allocated
    extent: usize = lenof target.buffer
    block: ptr mut u8 = addr target.buffer[0]
    match target.growth
        bounded: return
        grows(memory): memory.free(block, extent)
    end match
    nothing: []mut u8 = []
    target.buffer = nothing
    target.held = not_allocated
end release

--  A writable view of `size` bytes at `block`, which an allocator returned.
--  The block borrows nothing [0810], so neither does the view.
view: (block: ptr mut u8, size: usize) -> (result: []mut u8) =
    first: ptr mut [1]u8 = ptr(usize(block))
    result = first.val[0..<1]
    unchecked begin
        result = result[0..<size]
    end unchecked
end view

--  `size` bytes of storage for a growing builder: the `held` storage
--  `buffer` is, resized through `memory` with the bytes written kept, or a
--  first block when it holds none, since it has then written nothing.
storage: (memory: any mem.allocator, buffer: []mut u8, held: holding,
          size: usize) -> (block: ptr mut u8) ! mem.out_of_memory =
    if held == allocated then
        old: ptr mut u8 = addr buffer[0]
        block = try memory.resize(old, lenof buffer, size, 1)
    else
        block = try memory.alloc(size, 1)
    end if
end storage

--  Room for `extra` more bytes in a growing builder, doubling the storage
--  it holds, with its bytes kept, then `bytes` appended: `no_space` when
--  the allocator refuses, changing nothing.  The allocator's `resize`
--  grows the storage in place or moves it.
doubling_enlarge: (self: ptr doubling_value, inout target: builder_value,
                   extra: usize, bytes: []u8) -> none ! no_space =
    maximum: usize = 0 -% 1
    fail no_space when extra > maximum - target.used
    wanted: usize = target.used + extra
    capacity_now: usize = lenof target.buffer
    mut size: usize = 16
    if capacity_now > maximum / 2 then
        size = maximum
    elsif capacity_now * 2 > size then
        size = capacity_now * 2
    end if
    if size < wanted then
        size = wanted
    end if
    match target.growth
        bounded: fail no_space
        grows(memory): begin
            block: ptr mut u8 = storage(memory, target.buffer, target.held,
                                        size) else (problem)
                _ = problem
                fail no_space
            end
            target.buffer = view(block, size)
            target.held = allocated
        end
    end match
    try append(target, bytes)
end doubling_enlarge

doubling_value is grower (enlarge: doubling_enlarge)

--  A bounded builder's answer to a piece that does not fit.
refusing_enlarge: (self: ptr refusing_value, inout target: builder_value,
                   extra: usize, bytes: []u8) -> none ! no_space =
    fail no_space
end refusing_enlarge

refusing_value is grower (enlarge: refusing_enlarge)

--  Hand what a builder holds to `onto`, which takes it whole or fails, and
--  empty the builder.
handed: (inout target: builder, onto: any outlet) -> none ! no_space =
    return when target.used == 0
    try onto.take(target.buffer[0..<target.used])
    target.used = 0
end handed

--  Room in a draining builder: what it holds is handed on and it starts
--  again from empty, which is room for anything its whole buffer holds.
--  `bytes` longer than that are handed on as they are.
draining_enlarge: (self: ptr draining_value, inout target: builder_value,
                   extra: usize, bytes: []u8) -> none ! no_space =
    onto: any outlet = self.val.onto
    try handed(target, onto)
    if extra <= lenof target.buffer then
        try append(target, bytes)
    elsif lenof bytes == extra then
        try onto.take(bytes)
    else
        fail no_space
    end if
end draining_enlarge

draining_value is grower (enlarge: draining_enlarge)

--  Make room for `extra` more bytes after the used ones, asking the
--  builder's policy when the buffer has not the room: a bounded builder
--  reports `no_space`, a growing one doubles, and a draining one hands
--  what it holds on.  A failure changes nothing but what a draining
--  builder has handed on.
room: (inout target: builder, extra: usize) -> none ! no_space =
    return when extra <= lenof target.buffer - target.used
    policy: any grower = target.policy
    try policy.enlarge(target, extra, "")
end room

--- Append bytes as they are.
public append: (inout into: builder, bytes: []u8) -> none ! no_space =
    count: usize = lenof bytes
    if count > lenof into.buffer - into.used then
        policy: any grower = into.policy
        try policy.enlarge(into, count, bytes)
        return
    end if
    ends: usize = into.used + count
    mem.copy(into.buffer[into.used..<ends], bytes) else (problem)
        _ = problem
        fail no_space
    end
    into.used = ends
end append

--- Append one byte.
public append_byte: (inout into: builder, value: u8) -> none ! no_space =
    try room(into, 1)
    into.buffer[into.used] = value
    inc into.used
end append_byte

--- Append text's encoded bytes.
public append_text: (inout into: builder, value: utf8) -> none ! no_space =
    try append(into, bytes(value))
end append_text

--- Append a host string's bytes, as the system gave them: a name that is
--- not UTF-8 is written as it is.  Check it with `from_host` first where
--- the output must be text.
public append_host: (inout into: builder, value: host_string)
                    -> none ! no_space =
    try append(into, value.bytes)
end append_host

--  The library's one decimal writer (D355), at each width so that a
--  32-bit image writes a `u32` or a `usize` with 32-bit division: the
--  digits are counted by division before the first store, so a builder
--  without room for all of them is left as it was.

decimal_u32: (inout into: builder, value: u32) -> none ! no_space =
    mut digits: usize = 1
    mut scan: u32 = value
    while scan >= 10 do
        scan /= 10
        inc digits
    end while
    try room(into, digits)
    mut remaining: u32 = value
    mut offset: usize = digits
    while remaining >= 10 do
        quotient: u32 = remaining / 10
        dec offset
        into.buffer[into.used + offset] = u8(remaining - quotient * 10)
                                          + u8('0')
        remaining = quotient
    end while
    into.buffer[into.used] = u8(remaining) + u8('0')
    into.used += digits
end decimal_u32

decimal_u64: (inout into: builder, value: u64) -> none ! no_space =
    mut digits: usize = 1
    mut scan: u64 = value
    while scan >= 10 do
        scan /= 10
        inc digits
    end while
    try room(into, digits)
    mut remaining: u64 = value
    mut offset: usize = digits
    while remaining >= 10 do
        quotient: u64 = remaining / 10
        dec offset
        into.buffer[into.used + offset] = u8(remaining - quotient * 10)
                                          + u8('0')
        remaining = quotient
    end while
    into.buffer[into.used] = u8(remaining) + u8('0')
    into.used += digits
end decimal_u64

decimal_usize: (inout into: builder, value: usize) -> none ! no_space =
    mut digits: usize = 1
    mut scan: usize = value
    while scan >= 10 do
        scan /= 10
        inc digits
    end while
    try room(into, digits)
    mut remaining: usize = value
    mut offset: usize = digits
    while remaining >= 10 do
        quotient: usize = remaining / 10
        dec offset
        into.buffer[into.used + offset] = u8(remaining - quotient * 10)
                                          + u8('0')
        remaining = quotient
    end while
    into.buffer[into.used] = u8(remaining) + u8('0')
    into.used += digits
end decimal_usize

--- Append a `u32` in decimal: its digits, with no sign, padding or
--- separator.  Write `u8` and `u16` through it.
public append_u32: (inout into: builder, value: u32) -> none ! no_space =
    try decimal_u32(into, value)
end append_u32

--- Append a `u64` in decimal.
public append_u64: (inout into: builder, value: u64) -> none ! no_space =
    try decimal_u64(into, value)
end append_u64

--- Append a `usize` in decimal, at the target's width.
public append_usize: (inout into: builder, value: usize) -> none ! no_space =
    try decimal_usize(into, value)
end append_usize

--- Append an `i32` in decimal: a `-` before a negative value's digits and
--- nothing before any other's.  Write `i8` and `i16` through it.
public append_i32: (inout into: builder, value: i32) -> none ! no_space =
    if value >= 0 then
        try append_u32(into, u32(value))
        return
    end if
    start: usize = into.used
    try append_byte(into, u8('-'))
    magnitude: u32 = u32(0 - (value + 1)) + 1
    append_u32(into, magnitude) else (problem)
        into.used = start
        fail problem
    end
end append_i32

--- Append an `i64` in decimal, signed as `append_i32` is.
public append_i64: (inout into: builder, value: i64) -> none ! no_space =
    if value >= 0 then
        try append_u64(into, u64(value))
        return
    end if
    start: usize = into.used
    try append_byte(into, u8('-'))
    magnitude: u64 = u64(0 - (value + 1)) + 1
    append_u64(into, magnitude) else (problem)
        into.used = start
        fail problem
    end
end append_i64

--- Append an `isize` in decimal, signed as `append_i32` is.
public append_isize: (inout into: builder, value: isize) -> none ! no_space =
    if value >= 0 then
        try append_usize(into, usize(value))
        return
    end if
    start: usize = into.used
    try append_byte(into, u8('-'))
    magnitude: usize = usize(0 - (value + 1)) + 1
    append_usize(into, magnitude) else (problem)
        into.used = start
        fail problem
    end
end append_isize

hex_digits: []u8 = "0123456789abcdef"

--- Append a `u32` in hexadecimal: lower-case digits, as few as the value
--- needs, and no `0x`, which is a piece of its own.
public append_hex_u32: (inout into: builder, value: u32) -> none ! no_space =
    mut count: usize = 1
    mut scan: u32 = value >> 4
    while scan <> 0 do
        inc count
        scan = scan >> 4
    end while
    try room(into, count)
    mut remaining: u32 = value
    mut at: usize = into.used + count
    while at > into.used do
        dec at
        into.buffer[at] = hex_digits[usize(remaining & 15)]
        remaining = remaining >> 4
    end while
    into.used += count
end append_hex_u32

--- Append a `u64` in hexadecimal, as `append_hex_u32` does.
public append_hex_u64: (inout into: builder, value: u64) -> none ! no_space =
    mut count: usize = 1
    mut scan: u64 = value >> 4
    while scan <> 0 do
        inc count
        scan = scan >> 4
    end while
    try room(into, count)
    mut remaining: u64 = value
    mut at: usize = into.used + count
    while at > into.used do
        dec at
        into.buffer[at] = hex_digits[usize(remaining & 15)]
        remaining = remaining >> 4
    end while
    into.used += count
end append_hex_u64

--- Append a `usize` in hexadecimal, as `append_hex_u32` does.
public append_hex_usize: (inout into: builder, value: usize)
                         -> none ! no_space =
    mut count: usize = 1
    mut scan: usize = value >> 4
    while scan <> 0 do
        inc count
        scan = scan >> 4
    end while
    try room(into, count)
    mut remaining: usize = value
    mut at: usize = into.used + count
    while at > into.used do
        dec at
        into.buffer[at] = hex_digits[remaining & 15]
        remaining = remaining >> 4
    end while
    into.used += count
end append_hex_usize

--- Right-align the piece written since `start`, an earlier `length`, in a
--- field `width` bytes wide: `fill` goes before it until the field is
--- full.  A piece as wide as the field or wider is left as it is.  The fill
--- goes before the whole piece, a sign included, so a zero fill suits an
--- unsigned value.  A `start` past the length is a checked-range trap, as a
--- slice's would be.
public align_right: (inout into: builder, start: usize, width: usize,
                     fill: u8) -> none ! no_space =
    piece: usize = into.used - start
    return when piece >= width
    padding: usize = width - piece
    try room(into, padding)
    ends: usize = into.used + padding
    moved: usize = start + padding
    mem.copy(into.buffer[moved..<ends], into.buffer[start..<into.used])
        else (problem)
        _ = problem
        fail no_space
    end
    mem.fill(into.buffer[start..<moved], fill)
    into.used = ends
end align_right

--- Left-align the piece written since `start` in a field `width` bytes
--- wide: `fill` goes after it until the field is full.  A piece as wide as
--- the field or wider is left as it is.
public align_left: (inout into: builder, start: usize, width: usize,
                    fill: u8) -> none ! no_space =
    piece: usize = into.used - start
    return when piece >= width
    padding: usize = width - piece
    try room(into, padding)
    ends: usize = into.used + padding
    mem.fill(into.buffer[into.used..<ends], fill)
    into.used = ends
end align_left
