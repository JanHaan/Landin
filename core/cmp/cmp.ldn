--  Comparison evidence shared by every module that compares, hashes or
--  orders its items: the map, the sort and the text layer import it, and
--  a later type declares its conformances against it.

--- Equality evidence. `equal` must be an equivalence relation, and stay one
--- while an item is stored, for example as a map key.
public equatable: type = concept (item: type)
    --- Report whether two items are equal under a stable equivalence.
    equal: (left: item, right: item) -> (yes: bool)
end equatable

seed_value: type = struct
    first: u64
    second: u64
end seed_value

--- The key of a keyed hash: 128 bits that choose which of SipHash's
--- functions `hash_bytes` and `hash_word` compute.  Whoever does not know
--- the seed cannot tell which keys will collide, so a map seeded from
--- entropy cannot be filled with keys chosen to share one probe chain.
--- Make one with `seed_from`; a hosted program draws one with
--- `random.hash_seed`.
public hash_seed: type = seed_value

--- The seed whose SipHash key is `first` and then `second`, each as its
--- eight little-endian bytes: SipHash's k0 and k1.  The same words give
--- the same hashes on every target.
public seed_from: (first: u64, second: u64) -> (seed: hash_seed) =
    seed = (first: first, second: second)
end seed_from

--- Hash evidence, which composes `equatable`. Items that are `equal` must
--- have equal hashes under the same seed, and both answers must stay
--- stable while an item is stored. A hash should depend on the seed as
--- well as the item, so that one who does not know the seed cannot choose
--- items that collide: the hashes this module ships are SipHash-1-3 keyed
--- by it, and a composite key builds its hash from `hash_bytes` or
--- `hash_word` with the seed it is given. They are not cryptographic
--- digests, and the seed is a secret only as long as the program keeps
--- it one.
---
--- Although `hashable` composes `equatable`, [1340] still requires a
--- concrete type to declare both conformances explicitly.
public hashable: type = concept (item: type) is equatable
    --- Return a hash of `value` keyed by `seed`; items `equal` to each
    --- other hash equally under one seed.
    hash: (value: item, seed: hash_seed) -> (result: u64)
end hashable

--  The compiler does not prove the semantic laws: equal must be an
--  equivalence relation, equal items must hash alike, and both answers must
--  stay stable while an item is stored, including across mutation of
--  anything a pointer or reference item reaches.

--  Types the library supplies evidence for: the integer scalars, bool and
--  byte slices here, and utf8 in core/text. There is one register and no
--  override [1280]; a program wanting another equality or hash for one of
--  these wraps the type in a distinct type and declares evidence for that.
--  A scalar hashes as `hash_word` of its two's-complement bits widened,
--  computed without a narrowing conversion, and a bool as the word 0 or 1;
--  byte slices are `hash_bytes`.
equal_u8: (left: u8, right: u8) -> (yes: bool) =
    yes = left == right
end equal_u8
hash_u8: (value: u8, seed: hash_seed) -> (result: u64) =
    result = hash_word(u64(value), seed)
end hash_u8
equal_u16: (left: u16, right: u16) -> (yes: bool) =
    yes = left == right
end equal_u16
hash_u16: (value: u16, seed: hash_seed) -> (result: u64) =
    result = hash_word(u64(value), seed)
end hash_u16
equal_u32: (left: u32, right: u32) -> (yes: bool) =
    yes = left == right
end equal_u32
hash_u32: (value: u32, seed: hash_seed) -> (result: u64) =
    result = hash_word(u64(value), seed)
end hash_u32
equal_u64: (left: u64, right: u64) -> (yes: bool) =
    yes = left == right
end equal_u64
hash_u64: (value: u64, seed: hash_seed) -> (result: u64) =
    result = hash_word(u64(value), seed)
end hash_u64
equal_usize: (left: usize, right: usize) -> (yes: bool) =
    yes = left == right
end equal_usize
hash_usize: (value: usize, seed: hash_seed) -> (result: u64) =
    result = hash_word(u64(value), seed)
end hash_usize
equal_i8: (left: i8, right: i8) -> (yes: bool) =
    yes = left == right
end equal_i8
hash_i8: (value: i8, seed: hash_seed) -> (result: u64) =
    if value >= 0 then
        result = hash_word(u64(value), seed)
    else
        result = hash_word(~u64(0 - (value + 1)), seed)
    end if
end hash_i8
equal_i16: (left: i16, right: i16) -> (yes: bool) =
    yes = left == right
end equal_i16
hash_i16: (value: i16, seed: hash_seed) -> (result: u64) =
    if value >= 0 then
        result = hash_word(u64(value), seed)
    else
        result = hash_word(~u64(0 - (value + 1)), seed)
    end if
end hash_i16
equal_i32: (left: i32, right: i32) -> (yes: bool) =
    yes = left == right
end equal_i32
hash_i32: (value: i32, seed: hash_seed) -> (result: u64) =
    if value >= 0 then
        result = hash_word(u64(value), seed)
    else
        result = hash_word(~u64(0 - (value + 1)), seed)
    end if
end hash_i32
equal_i64: (left: i64, right: i64) -> (yes: bool) =
    yes = left == right
end equal_i64
hash_i64: (value: i64, seed: hash_seed) -> (result: u64) =
    if value >= 0 then
        result = hash_word(u64(value), seed)
    else
        result = hash_word(~u64(0 - (value + 1)), seed)
    end if
end hash_i64
equal_isize: (left: isize, right: isize) -> (yes: bool) =
    yes = left == right
end equal_isize
hash_isize: (value: isize, seed: hash_seed) -> (result: u64) =
    if value >= 0 then
        result = hash_word(u64(value), seed)
    else
        result = hash_word(~u64(0 - (value + 1)), seed)
    end if
end hash_isize
equal_bool: (left: bool, right: bool) -> (yes: bool) =
    yes = left == right
end equal_bool
hash_bool: (value: bool, seed: hash_seed) -> (result: u64) =
    result = hash_word(if value then 1 else 0 end if, seed)
end hash_bool
equal_bytes: (left: []u8, right: []u8) -> (yes: bool) =
    if lenof left <> lenof right then
        yes = false
        return
    end if
    mut index: usize = 0
    while index < lenof left do
        if left[index] <> right[index] then
            yes = false
            return
        end if
        inc index
    end while
    yes = true
end equal_bytes
--- SipHash-1-3 of `value` keyed by `seed`: Aumasson and Bernstein's
--- SipHash with one compression round per eight-byte word and three
--- finalization rounds, the variant Rust's and CPython's hash tables use.
--- It is `[]u8`'s hash, and `utf8`'s, and gives the same result on every
--- target.  It is not a cryptographic digest.
public hash_bytes: (value: []u8, seed: hash_seed) -> (result: u64) =
    result = siphash(value, 0, false, seed)
end hash_bytes

--- SipHash-1-3 keyed by `seed` of `value`'s eight bytes, least significant
--- first: what `hash_bytes` gives for those bytes, without storing them.
--- Every integer scalar's hash is this word's.
public hash_word: (value: u64, seed: hash_seed) -> (result: u64) =
    result = siphash(no_bytes[0..<0], value, true, seed)
end hash_word

no_bytes: [1]u8 = [0]

--  SipHash-1-3 (Aumasson and Bernstein, "SipHash: a fast short-input PRF",
--  INDOCRYPT 2012) after the authors' reference siphash.c built with
--  cROUNDS 1 and dROUNDS 3.  The message is VALUE's bytes, or WORD's eight
--  when WHOLE.  Each eight-byte word, read least significant byte first,
--  and then the last word, holding the bytes left over and the length's
--  low byte at the top, takes one round; three finish.  The round and the
--  byte loop are written once, so the code stays small on Cortex-M0.
siphash: (value: []u8, word: u64, whole: bool, seed: hash_seed)
         -> (result: u64) =
    mut v0: u64 = seed.first ^ 0x736f6d6570736575
    mut v1: u64 = seed.second ^ 0x646f72616e646f6d
    mut v2: u64 = seed.first ^ 0x6c7967656e657261
    mut v3: u64 = seed.second ^ 0x7465646279746573
    length: usize = if whole then 8 else lenof value end if
    mut at: usize = 0
    mut m: u64 = 0
    mut finishing: bool = false
    loop do
        mut rounds: usize = 1
        if at <= length then
            m = 0
            mut shift: u64 = 0
            if whole and at == 0 then
                m = word
                shift = 64
                at = 8
            end if
            while shift < 64 and at < length do
                m = m | (u64(value[at]) << shift)
                shift += 8
                inc at
            end while
            if shift < 64 then
                --  The last word: fewer than eight bytes were left.
                m = m | (u64(length & 255) << 56)
                at = length + 1
            end if
            v3 ^= m
        else
            finishing = true
            rounds = 3
            v2 ^= 0xff
        end if
        while rounds > 0 do
            v0 = v0 +% v1
            v1 = (v1 << 13) | (v1 >> 51)
            v1 ^= v0
            v0 = (v0 << 32) | (v0 >> 32)
            v2 = v2 +% v3
            v3 = (v3 << 16) | (v3 >> 48)
            v3 ^= v2
            v0 = v0 +% v3
            v3 = (v3 << 21) | (v3 >> 43)
            v3 ^= v0
            v2 = v2 +% v1
            v1 = (v1 << 17) | (v1 >> 47)
            v1 ^= v2
            v2 = (v2 << 32) | (v2 >> 32)
            dec rounds
        end while
        break when finishing
        v0 ^= m
    end loop
    result = v0 ^ v1 ^ v2 ^ v3
end siphash
u8 is equatable (equal: equal_u8)
u8 is hashable (hash: hash_u8)
u16 is equatable (equal: equal_u16)
u16 is hashable (hash: hash_u16)
u32 is equatable (equal: equal_u32)
u32 is hashable (hash: hash_u32)
u64 is equatable (equal: equal_u64)
u64 is hashable (hash: hash_u64)
usize is equatable (equal: equal_usize)
usize is hashable (hash: hash_usize)
i8 is equatable (equal: equal_i8)
i8 is hashable (hash: hash_i8)
i16 is equatable (equal: equal_i16)
i16 is hashable (hash: hash_i16)
i32 is equatable (equal: equal_i32)
i32 is hashable (hash: hash_i32)
i64 is equatable (equal: equal_i64)
i64 is hashable (hash: hash_i64)
isize is equatable (equal: equal_isize)
isize is hashable (hash: hash_isize)
bool is equatable (equal: equal_bool)
bool is hashable (hash: hash_bool)
[]u8 is equatable (equal: equal_bytes)
[]u8 is hashable (hash: hash_bytes)

--- Strict ordering evidence. `less` must be irreflexive and transitive, with
--- consistent equivalence classes, for the duration of a sort.
public ordered: type = concept (item: type)
    --- Return true exactly when left precedes right under the strict weak
    --- ordering.
    less: (left: item, right: item) -> (yes: bool)
end ordered

--  The library supplies the ordering of every integer scalar, and core/text
--  that of utf8. One register, no override [1280]: another ordering for one
--  of these goes on a distinct wrapper.
less_u8: (left: u8, right: u8) -> (yes: bool) =
    yes = left < right
end less_u8
less_u16: (left: u16, right: u16) -> (yes: bool) =
    yes = left < right
end less_u16
less_u32: (left: u32, right: u32) -> (yes: bool) =
    yes = left < right
end less_u32
less_u64: (left: u64, right: u64) -> (yes: bool) =
    yes = left < right
end less_u64
less_usize: (left: usize, right: usize) -> (yes: bool) =
    yes = left < right
end less_usize
less_i8: (left: i8, right: i8) -> (yes: bool) =
    yes = left < right
end less_i8
less_i16: (left: i16, right: i16) -> (yes: bool) =
    yes = left < right
end less_i16
less_i32: (left: i32, right: i32) -> (yes: bool) =
    yes = left < right
end less_i32
less_i64: (left: i64, right: i64) -> (yes: bool) =
    yes = left < right
end less_i64
less_isize: (left: isize, right: isize) -> (yes: bool) =
    yes = left < right
end less_isize
--  Bytes order as `compare` orders them.
less_bytes: (left: []u8, right: []u8) -> (yes: bool) =
    yes = compare(left, right) == less
end less_bytes
u8 is ordered (less: less_u8)
u16 is ordered (less: less_u16)
u32 is ordered (less: less_u32)
u64 is ordered (less: less_u64)
usize is ordered (less: less_usize)
i8 is ordered (less: less_i8)
i16 is ordered (less: less_i16)
i32 is ordered (less: less_i32)
i64 is ordered (less: less_i64)
isize is ordered (less: less_isize)
[]u8 is ordered (less: less_bytes)

--- The left bytes order before the right ones.
public less: atom
--- The two byte strings are the same bytes.
public equal: atom
--- The left bytes order after the right ones.
public greater: atom
--- How two byte strings order: `less`, `equal` or `greater`.
public order: type = less | equal | greater

--- Order two byte strings as unsigned bytes, the first difference
--- deciding, and a string that is a proper prefix of the other ordering
--- first: C's `memcmp` with the lengths taken into account, and the order
--- `ls` gives names in the C locale.  `[]u8`'s `ordered` evidence is this
--- order's `less`.
public compare: (left: []u8, right: []u8) -> (result: order) =
    mut at: usize = 0
    while at < lenof left and at < lenof right do
        if left[at] <> right[at] then
            result = if left[at] < right[at] then less else greater end if
            return
        end if
        inc at
    end while
    if lenof left < lenof right then
        result = less
    elsif lenof left > lenof right then
        result = greater
    else
        result = equal
    end if
end compare
