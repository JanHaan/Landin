--  A deterministic generator of pseudorandom numbers: xoshiro256** 1.0,
--  by David Blackman and Sebastiano Vigna, "Scrambled linear pseudorandom
--  number generators", ACM Transactions on Mathematical Software 47(4),
--  2021, from their public-domain reference implementation at
--  https://prng.di.unimi.it/xoshiro256starstar.c, seeded from a 64-bit
--  seed through their splitmix64.c, as they suggest.  It is written with
--  shifts, exclusive ors and additions on `u64`, so a seed gives the same
--  sequence on every target, a 32-bit Cortex-M0 included, and its
--  multiplications by 5 and 9 are a shift and an addition each.

import core/io

state_value: type = struct
    s0: u64
    s1: u64
    s2: u64
    s3: u64
end state_value

--- A generator: 256 bits of state that each draw advances, a value the
--- caller keeps and passes `inout`.  A seed always gives the same
--- sequence, on every target, which is what makes it useful for tests,
--- simulations and sampling; a generator is not cryptographic, and its
--- outputs reveal its state, so never make a key, a token or a password
--- with one: take those from `io.fill_random` directly.  Copying a
--- generator copies its state, and the copy repeats what the original
--- will draw.
public generator: type = state_value

--  splitmix64's step: advance `seed` by the golden ratio and mix it.
splitmix: (inout seed: u64) -> (value: u64) =
    seed = seed +% 0x9e3779b97f4a7c15
    mut z: u64 = seed
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    value = z ^ (z >> 31)
end splitmix

--- A generator seeded from `seed`: its state is four outputs of
--- splitmix64 started at `seed`, as the authors suggest, which are never
--- all zero.  Seed 0 gives first 11091344671253066420, as the reference
--- implementation does.
public new: (seed: u64) -> (result: generator) =
    mut at: u64 = seed
    first: u64 = splitmix(at)
    second: u64 = splitmix(at)
    third: u64 = splitmix(at)
    fourth: u64 = splitmix(at)
    result = (s0: first, s1: second, s2: third, s3: fourth)
end new

--- A generator seeded from 32 bytes of the provider's entropy, read as
--- four little-endian `u64`s, so no two runs repeat each other.  The one
--- state xoshiro256** cannot leave, all zero, is replaced by `new(0)`'s.
--- It fails as the provider fails.
public from_entropy: (provider: type is io.entropy, host: provider)
                     -> (result: generator) ! io.io_failed =
    mut bytes: [32]u8 = zeroed
    try io.fill_random(host, bytes[0..<32])
    result = (s0: little_endian(bytes[0..<8]),
              s1: little_endian(bytes[8..<16]),
              s2: little_endian(bytes[16..<24]),
              s3: little_endian(bytes[24..<32]))
    if result.s0 == 0 and result.s1 == 0 and result.s2 == 0
      and result.s3 == 0 then
        result = new(0)
    end if
end from_entropy

--  The eight bytes of `bytes`, least significant first.
little_endian: (bytes: []u8) -> (value: u64) =
    value = 0
    for index in usize(0)..<8 do
        value = value | (u64(bytes[index]) << u64(8 * index))
    end for
end little_endian

--  `value` rotated left by `count` bits, 0 < count < 64.
rotate: (value: u64, count: u64) -> (result: u64) =
    result = (value << count) | (value >> (64 - count))
end rotate

--- The next 64 bits of the sequence, each value equally likely.
public next: (inout source: generator) -> (value: u64) =
    s1: u64 = source.s1
    times_five: u64 = (s1 << 2) +% s1
    rotated: u64 = rotate(times_five, 7)
    value = (rotated << 3) +% rotated
    t: u64 = s1 << 17
    source.s2 = source.s2 ^ source.s0
    source.s3 = source.s3 ^ source.s1
    source.s1 = source.s1 ^ source.s2
    source.s0 = source.s0 ^ source.s3
    source.s2 = source.s2 ^ t
    source.s3 = rotate(source.s3, 45)
end next

--- The next 32 bits of the sequence: the upper half of `next`, whose bits
--- the authors recommend over the lower.
public next_u32: (inout source: generator) -> (value: u32) =
    value = u32(next(source) >> 32)
end next_u32

--- A value from 0 to `bound - 1`, each equally likely: the next draw's
--- bits below `bound`'s highest bit, drawn again while they are `bound`
--- or more, which is never more often than not, so no value is favoured
--- as a remainder would favour some.  It uses no division.  A `bound` of
--- zero has no value below it and traps.
public below: (inout source: generator, bound: u64) -> (value: u64) =
    if bound == 0 then
        compiler.unreachable()
    end if
    mut mask: u64 = bound - 1
    mask = mask | (mask >> 1)
    mask = mask | (mask >> 2)
    mask = mask | (mask >> 4)
    mask = mask | (mask >> 8)
    mask = mask | (mask >> 16)
    mask = mask | (mask >> 32)
    loop do
        value = next(source) & mask
        return when value < bound
    end loop
end below

--- Put `values` in an order drawn uniformly from every order they could
--- have, by Fisher and Yates's shuffle: from the last, each is swapped
--- with one drawn by `below` from those before it and itself.
public shuffle: (item: type, inout source: generator, values: []mut item)
                -> none =
    mut at: usize = lenof values
    while at > 1 do
        chosen: usize = usize(below(source, u64(at)))
        dec at
        saved: item = values[at]
        values[at] = values[chosen]
        values[chosen] = saved
    end while
end shuffle
