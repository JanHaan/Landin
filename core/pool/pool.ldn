--  A caller-backed reclaiming allocator.  Unlike core/mem's arena, every
--  successful allocation owns one uniform slot. Free indices form a min heap
--  in caller-supplied metadata for lowest-index reuse. No operation imports
--  or falls back to a backing allocator.

import core/mem

public slot: type = struct
    size: usize
    free_index: usize
end slot

fixed_pool: type = struct
    base: ptr mut u8
    extent: usize
    slot_size: usize
    slot_count: usize
    bookkeeping: []mut slot
    slot_alignment: usize
    first_offset: usize
    stride: usize
    free_count: usize
    allocations: usize
    frees: usize
    live_count: usize
    rejected_frees: usize
end fixed_pool

public provider: type = fixed_pool

--  This is D193's absolute-address algorithm kept local because core/mem's
--  helper is private and the pool must remain an independent module.  Every
--  potentially overflowing operation is preceded by its own bound.
allocation_offset: (base: ptr mut u8, used: usize, extent: usize,
                    size: usize, alignment: usize)
                   -> (offset: usize) ! mem.out_of_memory =
    maximum: usize = 0 -% 1
    fail mem.out_of_memory when used > extent

    base_address: usize = usize(base)
    fail mem.out_of_memory when used > maximum - base_address
    current_address: usize = base_address + used

    mut padding: usize = 0
    if alignment > 1 then
        remainder: usize = current_address % alignment
        if not (remainder == 0) then
            padding = alignment - remainder
        end if
    end if

    fail mem.out_of_memory when padding > extent - used
    fail mem.out_of_memory when padding > maximum - current_address
    offset = used + padding
    aligned_address: usize = current_address + padding
    fail mem.out_of_memory when size > extent - offset
    fail mem.out_of_memory when size > maximum - aligned_address
end allocation_offset

slot_stride: (size: usize, alignment: usize)
             -> (stride: usize) ! mem.out_of_memory =
    fail mem.out_of_memory when size == 0
    maximum: usize = 0 -% 1
    mut padding: usize = 0
    if alignment > 1 then
        remainder: usize = size % alignment
        if not (remainder == 0) then
            padding = alignment - remainder
        end if
    end if
    fail mem.out_of_memory when padding > maximum - size
    stride = size + padding
end slot_stride

--  slot_size is positive. The initialized bookkeeping slice is supplied by
--  the caller, its length is the finite bookkeeping capacity, and slot_count
--  may be zero but may not exceed it. The maximum usize marks a free slot,
--  so a positive pool cannot use that slot size. A positive pool aligns its
--  first slot from the absolute backing address, includes that padding in extent
--  accounting, and proves every later slot and its complete payload fit both
--  the backing extent and target address space before publishing the provider.
public over: (base: ptr mut u8, extent: usize, slot_size: usize,
              slot_count: usize, slot_alignment: usize,
              bookkeeping: []mut slot)
             -> (state: provider from base, bookkeeping)
             ! mem.out_of_memory =
    fail mem.out_of_memory when slot_count > lenof bookkeeping
    empty: usize = 0 -% 1
    fail mem.out_of_memory when slot_count > 0 and slot_size == empty

    mut normalized_alignment: usize = slot_alignment
    if normalized_alignment <= 1 then
        normalized_alignment = 1
    end if
    step: usize = try slot_stride(slot_size, normalized_alignment)

    mut offset: usize = 0
    if slot_count > 0 then
        offset = try allocation_offset(base, 0, extent, slot_size,
                                       normalized_alignment)
        remaining_slots: usize = slot_count - 1
        after_first: usize = extent - offset - slot_size
        fail mem.out_of_memory when remaining_slots > after_first / step

        maximum: usize = 0 -% 1
        first_address: usize = usize(base) + offset
        address_room: usize = maximum - first_address - slot_size
        fail mem.out_of_memory when remaining_slots > address_room / step
    end if

    mut index: usize = 0
    while index < slot_count do
        bookkeeping[index] = (size: empty,
                              free_index: index)
        inc index
    end while

    state = (base: base, extent: extent, slot_size: slot_size,
             slot_count: slot_count,
             bookkeeping: bookkeeping,
             slot_alignment: normalized_alignment,
             first_offset: offset, stride: step, free_count: slot_count,
             allocations: 0, frees: 0, live_count: 0,
             rejected_frees: 0)
end over

--  Keep indexed heap access in shared routines. Each access still checks its
--  slice bound, while freestanding callers do not duplicate the aggregate
--  address calculation at every step of both heap operations.
free_index_at: (state: ptr fixed_pool, index: usize) -> (value: usize) =
    value = state.val.bookkeeping[index].free_index
end free_index_at

store_free_index: (state: ptr mut fixed_pool, index: usize,
                   value: usize) -> none =
    state.val.bookkeeping[index].free_index = value
end store_free_index

take_free_index: (inout state: fixed_pool) -> (index: usize) =
    index = free_index_at(addr state, 0)
    dec state.free_count
    if state.free_count > 0 then
        last: usize = free_index_at(addr state, state.free_count)
        mut position: usize = 0
        while position < state.free_count / 2 do
            child: usize = position * 2 + 1
            mut smallest: usize = child
            if child + 1 < state.free_count
              and free_index_at(addr state, child + 1)
                  < free_index_at(addr state, child)
            then
                smallest = child + 1
            end if
            if last <= free_index_at(addr state, smallest) then
                break
            end if
            store_free_index(addr state, position,
                             free_index_at(addr state, smallest))
            position = smallest
        end while
        store_free_index(addr state, position, last)
    end if
end take_free_index

return_free_index: (inout state: fixed_pool, index: usize) -> none =
    mut position: usize = state.free_count
    while position > 0 do
        parent: usize = (position - 1) / 2
        if free_index_at(addr state, parent) <= index then
            break
        end if
        store_free_index(addr state, position,
                         free_index_at(addr state, parent))
        position = parent
    end while
    store_free_index(addr state, position, index)
    inc state.free_count
end return_free_index

pool_alloc: (inout state: fixed_pool,
             size: usize, alignment: usize)
            -> (block: ptr mut u8) ! mem.out_of_memory =
    fail mem.out_of_memory when size > state.slot_size
    if alignment > 1 then
        --  A power-of-two request divides the slot alignment iff its low
        --  bits are clear; other requests retain numeric divisibility.
        mask: usize = alignment - 1
        if (alignment & mask) == 0 then
            fail mem.out_of_memory when (state.slot_alignment & mask) <> 0
        else
            fail mem.out_of_memory when state.slot_alignment % alignment <> 0
        end if
    end if

    fail mem.out_of_memory when state.free_count == 0
    index: usize = take_free_index(state)
    distance: usize = index * state.stride
    address: usize = usize(state.base) + state.first_offset + distance
    block = ptr(address)
    selected: ptr mut slot = addr state.bookkeeping[index]
    selected.val.size = size
    inc state.allocations
    inc state.live_count
end pool_alloc

pool_free: (inout state: fixed_pool,
            block: ptr mut u8, size: usize) -> none =
    if state.slot_count == 0 then
        inc state.rejected_frees
        return
    end if
    first_address: usize = usize(state.base) + state.first_offset
    address: usize = usize(block)
    if address < first_address then
        inc state.rejected_frees
        return
    end if
    distance: usize = address - first_address
    if distance % state.stride <> 0 then
        inc state.rejected_frees
        return
    end if
    index: usize = distance / state.stride
    if index >= state.slot_count then
        inc state.rejected_frees
        return
    end if
    selected: ptr mut slot = addr state.bookkeeping[index]
    if selected.val.size == 0 -% 1 or selected.val.size <> size then
        inc state.rejected_frees
        return
    end if

    selected.val.size = 0 -% 1
    return_free_index(state, index)
    inc state.frees
    dec state.live_count
end pool_free

pool_grow: (inout state: fixed_pool, block: ptr mut u8,
            old_size: usize, new_size: usize, alignment: usize)
           -> (grown: bool) =
    _ = state.live_count
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end pool_grow

fixed_pool is mem.allocator (alloc: pool_alloc, grow: pool_grow,
                             free: pool_free)

public capacity: (state: provider) -> (count: usize) =
    count = state.slot_count
end capacity

public bookkeeping_capacity: (state: provider) -> (count: usize) =
    bookkeeping: []mut slot = state.bookkeeping
    count = lenof bookkeeping
end bookkeeping_capacity

public live: (state: provider) -> (count: usize) =
    count = state.live_count
end live

public allocation_count: (state: provider) -> (count: usize) =
    count = state.allocations
end allocation_count

public free_count: (state: provider) -> (count: usize) =
    count = state.frees
end free_count

public rejected_free_count: (state: provider) -> (count: usize) =
    count = state.rejected_frees
end rejected_free_count
