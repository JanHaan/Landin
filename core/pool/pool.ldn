--  A caller-backed reclaiming allocator.  Unlike core/mem's arena, every
--  successful allocation owns one uniform slot. Free indices form a min heap
--  in caller-supplied metadata for lowest-index reuse. No operation imports
--  or falls back to a backing allocator.

import core/mem

--- Caller-owned bookkeeping record for one pool slot. Supply an initialized
--- slice to `over`; the provider maintains its fields after construction.
public slot: type = struct
    size: usize
    free_index: usize
end slot

pool_state: type = struct
    extent: usize
    slot_size: usize
    slot_count: usize
    slot_alignment: usize
    first_offset: usize
    stride: usize
    free_count: usize
    allocations: usize
    frees: usize
    live_count: usize
    rejected_frees: usize
end pool_state

--- Caller-owned state of a pool: its geometry, free-heap size and counters.
--- Declare it `zeroed` and give it to `over`, which fills it; it must
--- outlive the pool handle.
public space: type = pool_state

fixed_pool: type = struct
    state: ptr mut pool_state
    base: ptr mut u8
    bookkeeping: []mut slot
end fixed_pool

--- Reclaiming allocator over uniform slots in caller storage, as a handle:
--- copies share one pool. Reuses the lowest free index, never grows in place,
--- and uses no fallback allocator. Even a zero-byte allocation occupies a
--- slot.
public provider: type = fixed_pool

slot_stride: (size: usize, alignment: usize)
             -> (stride: usize) ! mem.out_of_memory =
    fail mem.out_of_memory when size == 0
    maximum: usize = 0 -% 1
    mut padding: usize = 0
    if alignment > 1 then
        remainder: usize = size % alignment
        if not (remainder == 0) then
            padding = alignment - remainder
        end if
    end if
    fail mem.out_of_memory when padding > maximum - size
    stride = size + padding
end slot_stride

--- Fill `state` for a pool over caller backing and bookkeeping and return its
--- handle. Validates positive slot size, alignment, extent and record
--- capacity before changing `state`. Keep `state` and both backing ranges
--- alive until all allocations end.
---
--- slot_size is positive. The initialized bookkeeping slice is supplied by
--- the caller, its length is the finite bookkeeping capacity, and slot_count
--- may be zero but may not exceed it. The maximum usize marks a free slot,
--- so a positive pool cannot use that slot size. A positive pool aligns its
--- first slot from the absolute backing address, includes that padding in extent
--- accounting, and proves every later slot and its complete payload fit both
--- the backing extent and target address space before publishing the provider.
public over: (inout state: space, base: ptr mut u8, extent: usize,
              slot_size: usize, slot_count: usize, slot_alignment: usize,
              bookkeeping: []mut slot)
             -> (handle: provider from state, base, bookkeeping)
             ! mem.out_of_memory =
    fail mem.out_of_memory when slot_count > lenof bookkeeping
    empty: usize = 0 -% 1
    fail mem.out_of_memory when slot_count > 0 and slot_size == empty

    mut normalized_alignment: usize = slot_alignment
    if normalized_alignment <= 1 then
        normalized_alignment = 1
    end if
    step: usize = try slot_stride(slot_size, normalized_alignment)

    mut offset: usize = 0
    if slot_count > 0 then
        offset = try mem.aligned_offset(base, 0, extent, slot_size,
                                        normalized_alignment)
        remaining_slots: usize = slot_count - 1
        after_first: usize = extent - offset - slot_size
        fail mem.out_of_memory when remaining_slots > after_first / step

        maximum: usize = 0 -% 1
        first_address: usize = usize(base) + offset
        address_room: usize = maximum - first_address - slot_size
        fail mem.out_of_memory when remaining_slots > address_room / step
    end if

    mut index: usize = 0
    while index < slot_count do
        bookkeeping[index] = (size: empty,
                              free_index: index)
        inc index
    end while

    state = (extent: extent, slot_size: slot_size, slot_count: slot_count,
             slot_alignment: normalized_alignment,
             first_offset: offset, stride: step, free_count: slot_count,
             allocations: 0, frees: 0, live_count: 0,
             rejected_frees: 0)
    handle = (state: addr state, base: base, bookkeeping: bookkeeping)
end over

--  Keep indexed heap access in shared routines. Each access still checks its
--  slice bound, while freestanding callers do not duplicate the aggregate
--  address calculation at every step of both heap operations.
free_index_at: (self: fixed_pool, index: usize) -> (value: usize) =
    value = self.bookkeeping[index].free_index
end free_index_at

store_free_index: (self: fixed_pool, index: usize, value: usize) -> none =
    self.bookkeeping[index].free_index = value
end store_free_index

take_free_index: (self: fixed_pool) -> (index: usize) =
    state: ptr mut pool_state = self.state
    index = free_index_at(self, 0)
    dec state.val.free_count
    if state.val.free_count > 0 then
        last: usize = free_index_at(self, state.val.free_count)
        mut position: usize = 0
        while position < state.val.free_count / 2 do
            child: usize = position * 2 + 1
            mut smallest: usize = child
            if child + 1 < state.val.free_count
              and free_index_at(self, child + 1)
                  < free_index_at(self, child)
            then
                smallest = child + 1
            end if
            if last <= free_index_at(self, smallest) then
                break
            end if
            store_free_index(self, position, free_index_at(self, smallest))
            position = smallest
        end while
        store_free_index(self, position, last)
    end if
end take_free_index

return_free_index: (self: fixed_pool, index: usize) -> none =
    state: ptr mut pool_state = self.state
    mut position: usize = state.val.free_count
    while position > 0 do
        parent: usize = (position - 1) / 2
        if free_index_at(self, parent) <= index then
            break
        end if
        store_free_index(self, position, free_index_at(self, parent))
        position = parent
    end while
    store_free_index(self, position, index)
    inc state.val.free_count
end return_free_index

pool_alloc: (self: fixed_pool, size: usize, alignment: usize)
            -> (block: ptr mut u8) ! mem.out_of_memory =
    state: ptr mut pool_state = self.state
    fail mem.out_of_memory when size > state.val.slot_size
    if alignment > 1 then
        --  A power-of-two request divides the slot alignment iff its low
        --  bits are clear; other requests retain numeric divisibility.
        slot_alignment: usize = state.val.slot_alignment
        mask: usize = alignment - 1
        if (alignment & mask) == 0 then
            fail mem.out_of_memory when (slot_alignment & mask) <> 0
        else
            fail mem.out_of_memory when slot_alignment % alignment <> 0
        end if
    end if

    fail mem.out_of_memory when state.val.free_count == 0
    index: usize = take_free_index(self)
    distance: usize = index * state.val.stride
    --  [0810]: the block borrows nothing; the caller keeps the backing.
    address: usize = usize(self.base) + state.val.first_offset + distance
    block = ptr(address)
    selected: ptr mut slot = addr self.bookkeeping[index]
    selected.val.size = size
    inc state.val.allocations
    inc state.val.live_count
end pool_alloc

pool_free: (self: fixed_pool, block: ptr mut u8, size: usize) -> none =
    state: ptr mut pool_state = self.state
    if state.val.slot_count == 0 then
        inc state.val.rejected_frees
        return
    end if
    first_address: usize = usize(self.base) + state.val.first_offset
    address: usize = usize(block)
    if address < first_address then
        inc state.val.rejected_frees
        return
    end if
    distance: usize = address - first_address
    if distance % state.val.stride <> 0 then
        inc state.val.rejected_frees
        return
    end if
    index: usize = distance / state.val.stride
    if index >= state.val.slot_count then
        inc state.val.rejected_frees
        return
    end if
    selected: ptr mut slot = addr self.bookkeeping[index]
    if selected.val.size == 0 -% 1 or selected.val.size <> size then
        inc state.val.rejected_frees
        return
    end if

    selected.val.size = 0 -% 1
    return_free_index(self, index)
    inc state.val.frees
    dec state.val.live_count
end pool_free

pool_grow: (self: fixed_pool, block: ptr mut u8,
            old_size: usize, new_size: usize, alignment: usize)
           -> (grown: bool) =
    _ = self.state
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end pool_grow

fixed_pool is mem.allocator (alloc: pool_alloc, grow: pool_grow,
                             free: pool_free)

--- Return the configured number of allocatable slots.
public capacity: (memory: provider) -> (count: usize) =
    count = memory.state.val.slot_count
end capacity

--- Return the length of the supplied metadata slice, which may exceed the
--- configured slot count.
public bookkeeping_capacity: (memory: provider) -> (count: usize) =
    count = lenof memory.bookkeeping
end bookkeeping_capacity

--- Return the number of currently allocated slots.
public live: (memory: provider) -> (count: usize) =
    count = memory.state.val.live_count
end live

--- Return the number of successful allocations, including zero-byte
--- allocations.
public allocations: (memory: provider) -> (count: usize) =
    count = memory.state.val.allocations
end allocations

--- Return the number of successful slot reclamations.
public frees: (memory: provider) -> (count: usize) =
    count = memory.state.val.frees
end frees

--- Return frees rejected for an invalid address, extent or already-free slot.
--- A rejected free does not reclaim a slot.
public rejected_frees: (memory: provider) -> (count: usize) =
    count = memory.state.val.rejected_frees
end rejected_frees
