import core/mem

--- Ledger entry storing an allocated address and its byte extent. A region
--- records one for every payload it hands out.
public allocation: type = struct
    address: usize
    extent: usize
end allocation

--  How many records are in use, of a bounded ledger or of a growing
--  ledger's newest block, and that block: its address, zero when there is
--  none, and the records it holds.
book_value: type = struct
    used: usize
    address: usize
    room: usize
end book_value

space_value: type (fixed capacity: usize) = struct
    book: book_value
    records: [capacity]allocation
end space_value

--- Caller-owned state of a region: its ledger. With a positive `capacity`
--- the ledger is these `capacity` records and no more; with zero it grows
--- through the parent. Declare it `zeroed` and give it to `over`, which
--- fills it; it must outlive the region handle, and `release` empties it.
public space: type (fixed capacity: usize) = space_value(capacity)

region_value: type (provider: type) = struct
    parent: provider
    book: ptr mut book_value
    records: []mut allocation
end region_value

--- Allocator that records payload allocations through a parent, as a
--- handle: copies share one ledger. Releasing its state frees all recorded
--- payloads; the parent must outlive the region.
public region: type (provider: type) = region_value(provider)

--- Fill `state` for a region over `parent` and return its handle. The handle
--- holds a copy of the parent's handle. Every allocation takes one ledger
--- record until `release`, since an individual free returns nothing. A
--- bounded ledger that is full reports `mem.out_of_memory` and returns the
--- new payload to the parent; a growing ledger's own allocation failure does
--- the same.
public over: (fixed capacity: usize, provider: type is mem.allocator,
              inout state: space(capacity), parent: provider)
             -> (handle: region(provider) from state, parent) =
    state.book = (used: 0, address: 0, room: 0)
    handle = (parent: parent, book: addr state.book,
              records: state.records[0..<capacity])
end over

record_size: usize = sizeof allocation

region_alloc: (provider: type is mem.allocator,
               self: region(provider), size: usize, alignment: usize)
              -> (block: ptr mut u8) ! mem.out_of_memory =
    block = try mem.allocate(self.parent, size, alignment)
    record: allocation = (address: usize(block), extent: size)
    record_allocation(self, record) else (problem)
        mem.free(self.parent, block, size)
        fail problem
    end
end region_alloc

--  Keep one record, in the caller's bounded ledger or in the newest block of
--  a growing ledger.
record_allocation: (provider: type is mem.allocator,
                    self: region(provider), record: allocation)
                   -> none ! mem.out_of_memory =
    book: ptr mut book_value = self.book
    records: []mut allocation = self.records
    if lenof records > 0 then
        fail mem.out_of_memory when book.val.used == lenof records
        records[book.val.used] = record
        inc book.val.used
        return
    end if
    if book.val.used == book.val.room then
        try grow_ledger(self)
    end if
    inc book.val.used
    slot: ptr mut allocation =
        ptr(book.val.address + book.val.used * record_size)
    slot.val = record
end record_allocation

--  A growing ledger is a chain of blocks taken from the parent, newest
--  first, so that no record is ever copied.  A block's first record is the
--  ledger's record of the block before it, zero for the first block, and
--  the region's records follow.  The first block is seven records long and
--  each later one twice as long and one more, to at most 255: one record
--  short of a power of two, so that with a parent's two-word header it
--  fills a power-of-two size class.  A small region takes little, and a
--  large one a block per 254 allocations.
first_block: usize = 7
largest_block: usize = 255

--  Start a new block in front of the ledger.  A failure leaves the ledger as
--  it was.
grow_ledger: (provider: type is mem.allocator, self: region(provider))
             -> none ! mem.out_of_memory =
    book: ptr mut book_value = self.book
    mut length: usize = first_block
    mut older: allocation = (address: 0, extent: 0)
    if book.val.room > 0 then
        length = 2 * (book.val.room + 1) + 1
        if length > largest_block then length = largest_block end if
        older = (address: book.val.address,
                 extent: (book.val.room + 1) * record_size)
    end if
    fresh: ptr mut u8 = try mem.allocate(self.parent, length * record_size,
                                         alignof allocation)
    first: ptr mut allocation = ptr(usize(fresh))
    first.val = older
    book.val.address = usize(fresh)
    book.val.used = 0
    book.val.room = length - 1
end grow_ledger

region_free: (provider: type is mem.allocator, self: region(provider),
              block: ptr mut u8, size: usize) -> none =
    _ = self.book
    _ = block
    _ = size
end region_free

region_grow: (provider: type,
              self: region(provider), block: ptr mut u8,
              old_size: usize, new_size: usize, alignment: usize)
             -> (grown: bool) =
    _ = self.book
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end region_grow

(provider: type is mem.allocator) region_value(provider) is mem.allocator
    (alloc: region_alloc, grow: region_grow, free: region_free)

--- Free recorded payloads in reverse order through `parent`, which must be
--- the parent the region was made over, and give a growing ledger's blocks
--- back to it; `state` is then empty and may be given to `over` again. End
--- every payload use and every use of the region's handle first. An arena
--- parent keeps the bytes it handed out, since it reclaims nothing until its
--- backing ends.
public release: (fixed capacity: usize, provider: type is mem.allocator,
                 inout state: space(capacity), parent: provider) -> none =
    if capacity > 0 then
        mut remaining: usize = state.book.used
        while remaining > 0 do
            dec remaining
            record: allocation = state.records[remaining]
            block: ptr mut u8 = ptr(record.address)
            mem.free(parent, block, record.extent)
        end while
    else
        --  Each block's records from the last, then the block itself, whose
        --  first record gives the block before it; that block is full.
        mut ledger: allocation =
            (address: state.book.address,
             extent: (state.book.room + 1) * record_size)
        mut filled: usize = state.book.used + 1
        while ledger.address <> 0 do
            while filled > 1 do
                dec filled
                kept: ptr allocation =
                    ptr(ledger.address + filled * record_size)
                payload: ptr mut u8 = ptr(kept.val.address)
                mem.free(parent, payload, kept.val.extent)
            end while
            first: ptr allocation = ptr(ledger.address)
            older: allocation = first.val
            held: ptr mut u8 = ptr(ledger.address)
            mem.free(parent, held, ledger.extent)
            ledger = older
            filled = ledger.extent / record_size
        end while
    end if
    state.book = (used: 0, address: 0, room: 0)
end release
