--- Strict ordering evidence. `less` must be irreflexive and transitive, with
--- consistent equivalence classes, for the duration of a sort.
public ordered: type = concept (item: type)
    --- Return true exactly when left precedes right under the strict weak
    --- ordering.
    less: (left: item, right: item) -> (yes: bool)
end ordered

--  The library supplies the ordering of every integer scalar, and core/text
--  that of utf8. One register, no override [1280]: another ordering for one
--  of these goes on a distinct wrapper.
less_u8: (left: u8, right: u8) -> (yes: bool) =
    yes = left < right
end less_u8
less_u16: (left: u16, right: u16) -> (yes: bool) =
    yes = left < right
end less_u16
less_u32: (left: u32, right: u32) -> (yes: bool) =
    yes = left < right
end less_u32
less_u64: (left: u64, right: u64) -> (yes: bool) =
    yes = left < right
end less_u64
less_usize: (left: usize, right: usize) -> (yes: bool) =
    yes = left < right
end less_usize
less_i8: (left: i8, right: i8) -> (yes: bool) =
    yes = left < right
end less_i8
less_i16: (left: i16, right: i16) -> (yes: bool) =
    yes = left < right
end less_i16
less_i32: (left: i32, right: i32) -> (yes: bool) =
    yes = left < right
end less_i32
less_i64: (left: i64, right: i64) -> (yes: bool) =
    yes = left < right
end less_i64
less_isize: (left: isize, right: isize) -> (yes: bool) =
    yes = left < right
end less_isize
u8 is ordered (less: less_u8)
u16 is ordered (less: less_u16)
u32 is ordered (less: less_u32)
u64 is ordered (less: less_u64)
usize is ordered (less: less_usize)
i8 is ordered (less: less_i8)
i16 is ordered (less: less_i16)
i32 is ordered (less: less_i32)
i64 is ordered (less: less_i64)
isize is ordered (less: less_isize)

--  Restore the max-heap property in values[0..<count] below root.
--  A parent has a child exactly when at < count / 2, so the child-index
--  arithmetic cannot overflow even for a maximum-length view.
sift_down: (item: type is ordered, values: []mut item,
            root: usize, count: usize) -> none =
    mut at := root
    while at < count / 2 do
        mut child: usize = at * 2 + 1
        if child + 1 < count and item.less(values[child], values[child + 1]) then
            inc child
        end if
        if not item.less(values[at], values[child]) then
            return
        end if
        saved: item = values[at]
        values[at] = values[child]
        values[child] = saved
        at = child
    end while
end sift_down

--- Sort an initialized mutable slice in place using heapsort. Requires
--- consistent `ordered` evidence; uses constant auxiliary storage, no
--- allocation and O(n log n) comparisons. Equal items need not retain their
--- order.
---
--- In-place heapsort for initialized views. Worst-case O(n log n)
--- comparisons, constant auxiliary storage and bounded call depth.
--- The caller supplies a strict ordering; stability is not promised.
public sort: (item: type is ordered, values: []mut item) -> none =
    count: usize = lenof values
    mut start: usize = count / 2
    while start > 0 do
        dec start
        sift_down(values, start, count)
    end while
    mut remaining := count
    zero: usize = 0
    while remaining > 1 do
        dec remaining
        saved: item = values[zero]
        values[zero] = values[remaining]
        values[remaining] = saved
        sift_down(values, zero, remaining)
    end while
end sort

--- Sort in place using selection sort. Performs n(n-1)/2 comparisons and at
--- most n-1 swaps, with no allocation. Useful for tiny or expensive-to-swap
--- items; it is not stable.
---
--- Selection sort for tiny or swap-expensive views. Exactly n(n-1)/2
--- comparisons, at most n-1 swaps, constant storage and bounded call depth.
public sort_selection: (item: type is ordered, values: []mut item) -> none =
    mut at: usize = 0
    while at < lenof values do
        mut least := at
        mut next := at + 1
        while next < lenof values do
            if item.less(values[next], values[least]) then
                least = next
            end if
            inc next
        end while
        if least <> at then
            saved: item = values[at]
            values[at] = values[least]
            values[least] = saved
        end if
        inc at
    end while
end sort_selection
