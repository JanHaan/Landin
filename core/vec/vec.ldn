import core/mem

list_value: type (item: type) = struct
    values: mem.storage(item)
end list_value

--- Growable contiguous list with explicit allocator arguments; no
--- allocator is stored in the list.  Its storage is the module's own, so
--- nothing outside it can put another block in a list's place, or take
--- one out, behind its length and capacity.
public list: type (item: type) = list_value(item)

--- Create an empty list without allocating. Supply the allocator when growing
--- or releasing it.
public new: (item: type) -> (result: list(item)) =
    store := mem.empty_storage(item: item)
    result = (values: store)
end new

--- Return the number of initialized items.
public length: (item: type, value: list(item)) -> (count: usize) =
    count = mem.length(value.values)
end length

--- Return the number of items that fit without further growth.
public capacity: (item: type, value: list(item)) -> (count: usize) =
    count = mem.capacity(value.values)
end capacity

--- Ensure room for at least `want` items. May grow backing in place or copy
--- to a replacement. Failure preserves the old length, capacity and values;
--- successful relocation invalidates old views. Use the original provider for
--- existing backing.
public reserve: (item: type, provider: type is mem.allocator,
                 inout value: list(item), memory: provider, want: usize)
                -> none ! mem.out_of_memory =
    try mem.reserve_storage(value.values, memory, want)
end reserve

--- Append a value, growing capacity when needed. Reports `mem.out_of_memory`
--- without appending on allocation failure. Successful growth may invalidate
--- views into the previous allocation.
public push: (item: type, provider: type is mem.allocator,
              inout value: list(item), memory: provider,
              escaping added: item) -> none ! mem.out_of_memory =
    if length(value) == capacity(value) then
        next: usize = grown(capacity(value)) else (problem)
            _ = problem
            fail mem.out_of_memory
        end
        try reserve(value, memory, next)
    end if
    admitted: usize = mem.admit(value.values, added) else (problem)
        --  After successful growth or a spare-slot check, mem.full would
        --  indicate an internal invariant defect. Retain the established
        --  public fallback without claiming the provider exhausted memory.
        _ = problem
        fail mem.out_of_memory
    end
    _ = admitted
end push

--- Copy the indexed item, preserving origins of references it contains.
--- Reports `mem.out_of_bounds` outside the initialized prefix.
public get: (item: type, value: list(item), index: usize)
            -> (result: item from value) ! mem.out_of_bounds =
    result = try mem.get(value.values, index)
end get

--- Lend a writable pointer to an indexed item for in-place update. Reports
--- `mem.out_of_bounds` for a missing slot. While the result lives the list
--- binding may not be passed inout or sink [0800]: bind it, update through
--- it, and let it end before the next push, reserve or release.
public at: (item: type, inout value: list(item), index: usize)
           -> (slot: ptr mut item from value) ! mem.out_of_bounds =
    view: []mut item = mem.used(value.values)
    fail mem.out_of_bounds when index >= lenof view
    slot = addr view[index]
end at

--- Copy the last item without removing it. Reports `mem.empty` for an empty
--- list.
public last: (item: type, value: list(item))
             -> (result: item from value) ! mem.empty =
    count: usize = length(value)
    fail mem.empty when count == 0
    result = mem.get(value.values, count - 1) else (problem)
        _ = problem
        fail mem.empty
    end
end last

--- Remove and return the last item. Reports `mem.empty` without mutation when
--- empty; retains capacity.
public pop: (item: type, inout value: list(item))
            -> (result: item from value) ! mem.empty =
    result = try mem.withdraw(value.values)
end pop

--- Discard all items and retain capacity. Does not release resources
--- referenced by discarded values.
public clear: (item: type, inout value: list(item)) -> none =
    mem.clear(value.values)
end clear

--- Discard items, free backing through the original provider and reset the
--- list. End all views first; nested resources remain the caller's
--- responsibility.
public release: (item: type, provider: type is mem.allocator,
                 inout value: list(item), memory: provider) -> none =
    mem.release_storage(value.values, memory)
end release

--  A list of bytes is the library's growable byte container (D425): the
--  operations below append a slice and let a read fill the spare capacity,
--  and the list grows as `push` grows it, its bytes copied a word at a time
--  where `mem.copy` moves words.

--  Make room for `extra` more bytes after the initialized ones, doubling
--  the capacity as `push` does, or to exactly what is wanted when doubling
--  is not enough or cannot be represented.
make_room: (provider: type is mem.allocator, inout value: list(u8),
            memory: provider, extra: usize) -> none ! mem.out_of_memory =
    count: usize = length(value)
    have: usize = capacity(value)
    return when extra <= have - count
    maximum: usize = 0 -% 1
    fail mem.out_of_memory when extra > maximum - count
    wanted: usize = count + extra
    next: usize = grown(have) else (problem)
        _ = problem
        wanted
    end
    try reserve(value, memory, if next > wanted then next else wanted end if)
end make_room

--- Append every byte of `bytes`, growing capacity as `push` does, and
--- copying them a word at a time where `mem.copy` moves words.  Reports
--- `mem.out_of_memory` without appending anything when growth fails.
--- Successful growth may invalidate views into the previous allocation.
public append_bytes: (provider: type is mem.allocator,
                      inout value: list(u8), memory: provider, bytes: []u8)
                     -> none ! mem.out_of_memory =
    try make_room(value, memory, lenof bytes)
    mem.admit_copy(value.values, bytes) else (problem)
        --  After the room was made, mem.full would be an internal defect.
        _ = problem
        fail mem.out_of_memory
    end
end append_bytes

--- Lend the spare capacity past the list's bytes, at least `extra` bytes
--- of it, growing as `push` does when there are fewer: the buffer a read
--- fills, `io.read(host, file, room)`, before `extend_bytes` counts what it
--- wrote.  Its bytes are whatever the storage held.  End uses of the view
--- before the next append, reserve or release.
public spare_bytes: (provider: type is mem.allocator, inout value: list(u8),
                     memory: provider, extra: usize)
                    -> (room: []mut u8 from value) ! mem.out_of_memory =
    try make_room(value, memory, extra)
    room = mem.spare_bytes(value.values)
end spare_bytes

--- Count the first `count` bytes of the spare capacity, which the caller
--- has written through `spare_bytes`, as appended.  Reports
--- `mem.out_of_bounds`, changing nothing, when fewer than `count` are spare.
public extend_bytes: (inout value: list(u8), count: usize)
                     -> none ! mem.out_of_bounds =
    mem.admit_bytes(value.values, count) else (problem)
        _ = problem
        fail mem.out_of_bounds
    end
end extend_bytes
