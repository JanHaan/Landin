import core/mem

--- Growable contiguous list with explicit allocator arguments. Its public
--- shape contains opaque typed storage; no allocator is stored in the list.
---
--- The list shape is public, but its `values` field has the opaque
--- mem.storage(item) type: clients can inspect the container shape without
--- reaching raw-storage counters or bytes.
public list: type (item: type) = struct
    values: mem.storage(item)
end list

--- Create an empty list without allocating. Supply the allocator when growing
--- or releasing it.
public new: (item: type) -> (result: list(item)) =
    store := mem.empty_storage(item: item)
    result = (values: store)
end new

--- Return the number of initialized items.
public length: (item: type, value: list(item)) -> (count: usize) =
    count = mem.length(value.values)
end length

--- Return the number of items that fit without further growth.
public capacity: (item: type, value: list(item)) -> (count: usize) =
    count = mem.capacity(value.values)
end capacity

byte_extent: (item: type, slots: usize)
             -> (extent: usize) ! mem.out_of_memory =
    item_size: usize = sizeof item
    if item_size == 0 then
        --  A zero-sized item still has logical slots. A nonempty capacity
        --  acquires and eventually frees one zero-byte provider extent.
        extent = 0
        return
    end if

    maximum: usize = 0 -% 1
    fail mem.out_of_memory when slots > maximum / item_size
    extent = slots * item_size
end byte_extent

next_growth: (capacity: usize) -> (next: usize) ! mem.out_of_memory =
    next = grown(capacity) else (problem)
        _ = problem
        fail mem.out_of_memory
    end
end next_growth

free_empty: (item: type, provider: type is mem.allocator,
             inout value: mem.storage(item), inout state: provider) -> none =
    slots: usize = mem.capacity(value)
    return when slots == 0
    --  Every capacity published by vec passed byte_extent before reserve, so
    --  this product is an internal vector invariant rather than a second
    --  fallible allocation request.
    extent: usize = slots * sizeof item
    block: ptr mut u8 = mem.dispose(value) else (problem)
        _ = problem
        return
    end
    provider.free(state, block, extent)
end free_empty

--- Ensure room for at least `want` items. May grow backing in place or copy
--- to a replacement. Failure preserves the old length, capacity and values;
--- successful relocation invalidates old views. Use the original provider for
--- existing backing.
public reserve: (item: type, provider: type is mem.allocator,
                 inout value: list(item), inout state: provider, want: usize)
                -> none ! mem.out_of_memory =
    old_count: usize = mem.length(value.values)
    old_capacity: usize = mem.capacity(value.values)
    return when want <= old_capacity

    extent: usize = try byte_extent(item: item, slots: want)
    old_extent: usize = old_capacity * sizeof item
    if mem.grow_storage(value.values, state, old_extent, extent, want) then
        return
    end if
    block: ptr mut u8 = try provider.alloc
        (state, extent, alignof item)
    mut fresh := mem.storage_over(item: item, base: block, slots: want)
    mem.transfer_prefix(value.values, fresh, old_count) else (problem)
        --  Given D151's private counters, want > old_capacity and an empty
        --  replacement, transfer cannot reject this prefix. Keep the
        --  established rollback and public outcome if that internal
        --  invariant is ever violated; it is not evidence of provider OOM.
        _ = problem
        mem.clear(fresh)
        free_empty(fresh, state)
        fail mem.out_of_memory
    end

    mem.clear(value.values)
    free_empty(value.values, state)
    value.values = fresh
end reserve

--- Append a value, growing capacity when needed. Reports `mem.out_of_memory`
--- without appending on allocation failure. Successful growth may invalidate
--- views into the previous allocation.
public push: (item: type, provider: type is mem.allocator,
              inout value: list(item), inout state: provider,
              escaping added: item) -> none ! mem.out_of_memory =
    if length(value) == capacity(value) then
        next: usize = try next_growth(capacity(value))
        try reserve(value, state, next)
    end if
    admitted: usize = mem.admit(value.values, added) else (problem)
        --  After successful growth or a spare-slot check, mem.full would
        --  indicate an internal invariant defect. Retain the established
        --  public fallback without claiming the provider exhausted memory.
        _ = problem
        fail mem.out_of_memory
    end
    _ = admitted
end push

--- Copy the indexed item, preserving origins of references it contains.
--- Reports `mem.out_of_bounds` outside the initialized prefix.
public get: (item: type, value: list(item), index: usize)
            -> (result: item from value) ! mem.out_of_bounds =
    result = try mem.get(value.values, index)
end get

--- Lend a writable pointer to an indexed item for in-place update. Reports
--- `mem.out_of_bounds` for a missing slot. While the result lives the list
--- binding may not be passed inout or sink [0800]: bind it, update through
--- it, and let it end before the next push, reserve or release.
public at: (item: type, inout value: list(item), index: usize)
           -> (slot: ptr mut item from value) ! mem.out_of_bounds =
    view: []mut item = mem.used(value.values)
    fail mem.out_of_bounds when index >= lenof view
    slot = addr view[index]
end at

--- Copy the last item without removing it. Reports `mem.empty` for an empty
--- list.
public last: (item: type, value: list(item))
             -> (result: item from value) ! mem.empty =
    count: usize = length(value)
    fail mem.empty when count == 0
    result = mem.get(value.values, count - 1) else (problem)
        _ = problem
        fail mem.empty
    end
end last

--- Remove and return the last item. Reports `mem.empty` without mutation when
--- empty; retains capacity.
public pop: (item: type, inout value: list(item))
            -> (result: item from value) ! mem.empty =
    result = try mem.withdraw(value.values)
end pop

--- Discard all items and retain capacity. Does not release resources
--- referenced by discarded values.
public clear: (item: type, inout value: list(item)) -> none =
    mem.clear(value.values)
end clear

--- Discard items, free backing through the original provider and reset the
--- list. End all views first; nested resources remain the caller's
--- responsibility.
public release: (item: type, provider: type is mem.allocator,
                 inout value: list(item), inout state: provider) -> none =
    mem.clear(value.values)
    free_empty(value.values, state)
end release
