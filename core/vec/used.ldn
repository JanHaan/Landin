import core/mem

--- Lend a mutable slice covering only initialized items. End uses before any
--- operation that relocates or releases backing.
---
--- Only initialized elements are exposed. The descriptor derives from the
--- list; changing capacity or releasing storage requires ending that view.
public used: (item: type, value: list(item))
             -> (items: []mut item from value) =
    items = mem.used(value.values)
end used
