import core/mem

--- Lend a mutable slice covering only the initialized items. The slice
--- derives from the list.
---
--- End every use of the view before an operation that changes capacity,
--- relocates the backing or releases the storage.
public used: (item: type, value: list(item))
             -> (items: []mut item from value) =
    items = mem.used(value.values)
end used
