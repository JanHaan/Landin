--  Entropy: the system's source of random bytes, a concept beside the
--  others and outside `world`, and a scripted one whose bytes a test
--  gives.  A deterministic generator seeded from it is core/random's.

import core/mem

--- The system's source of unpredictable bytes, fit for seeding a
--- generator or making a key.  `fill_random` fills all of `into` or fails
--- `io_failed`, and after a failure what `into` holds is not to be used.
--- It is a concept of its own, outside `world`, so a provider without a
--- source, and a firmware image that never asks for one, carries none.
public entropy: type = concept (provider: type)
    --- Fill all of `into` with random bytes, or fail.
    fill_random: (self: provider, into: []mut u8) -> none ! io_failed
end entropy

--- Fill all of `into` with random bytes from the provider, through
--- `entropy` evidence.  On a hosted system they are the system's own,
--- `getrandom` on Linux and `arc4random_buf` on Darwin and FreeBSD.
public fill_random: (provider: type is entropy, host: provider,
                     into: []mut u8) -> none ! io_failed =
    try provider.fill_random(host, into)
end fill_random

--- Caller-owned state of scripted entropy: how many of its bytes it has
--- given and how often it was asked.  Declare it `zeroed` and give it to
--- `entropy_over`; it must outlive the handle, and may be read while the
--- handle is in use.
public entropy_space: type = struct
    used: usize
    requests: usize
end entropy_space

scripted_entropy_value: type = struct
    state: ptr mut entropy_space
    bytes: []u8
end scripted_entropy_value

--- Entropy whose bytes are the caller's, given in order, so a program
--- that seeds itself from entropy runs the same way in every test: a
--- provider of `entropy`.  A request for more than what is left of them
--- fails `io_failed` and gives nothing, so a test can make the source run
--- dry.  Copies share the state.
public scripted_entropy: type = scripted_entropy_value

--- Fill `state` for scripted entropy over `bytes`, which the handle lends;
--- keep them alive while it is used.
public entropy_over: (inout state: entropy_space, bytes: []u8)
                     -> (host: scripted_entropy from state, bytes) =
    state = (used: 0, requests: 0)
    host = (state: addr state, bytes: bytes)
end entropy_over

scripted_fill: (self: scripted_entropy, into: []mut u8) -> none ! io_failed =
    state: ptr mut entropy_space = self.state
    inc state.val.requests
    used: usize = state.val.used
    given: []u8 = self.bytes
    fail io_failed when used > lenof given or lenof into > lenof given - used
    mem.copy(into, given[used..<used + lenof into]) else (problem)
        _ = problem
        fail io_failed
    end
    state.val.used = used + lenof into
end scripted_fill

scripted_entropy is entropy (fill_random: scripted_fill)
