--  The rest of the file system: opening with options, renaming, a file's
--  status, read-only files, synchronizing, sizes, reading and writing at
--  an offset, temporary files and the working directory, a concept beside
--  `files` and `directories` and outside `world`; and terminals, another.
--  A firmware image that never asks for either carries neither.

import core/text

--- How `open_file` opens a file: to `read`, to `write`, or both; to
--- `append`, every write going to the end of the file, which needs
--- `write`; to `create` it when it is missing, and with `exclusive` too to
--- refuse it when it is not, `already_exists`, which no other program can
--- come between; and to `truncate` it to nothing as it is opened, which
--- needs `write`.  Any other combination, and one that neither reads nor
--- writes, is `io_failed` before the provider is asked.
public open_options: type = struct
    read: bool
    write: bool
    append: bool
    create: bool
    exclusive: bool
    truncate: bool
end open_options

--- Read and write a file that exists, from its start, keeping what it
--- holds: `io.updating`.
public updating: open_options = (read: true, write: true, append: false,
                                 create: false, exclusive: false,
                                 truncate: false)

--- Write at the end of a file, making it when it is missing: a log.
public appending: open_options = (read: false, write: true, append: true,
                                  create: true, exclusive: false,
                                  truncate: false)

--- Read and write a new file, refusing a name that is taken with
--- `already_exists`: the file is this program's alone.
public creating: open_options = (read: true, write: true, append: false,
                                 create: true, exclusive: true,
                                 truncate: false)

--- What a file is and the little every system says of it alike: its
--- size in bytes, what it is, when it was last written, as the wall clock
--- read then, and whether it is `read_only`, which on POSIX means that no
--- permission bit lets anyone write it.  A directory's own size differs
--- between file systems; a symbolic link's is the length of its target.
public status: type = struct
    size: u64
    kind: entry_kind
    modified: wall_time
    read_only: bool
end status

--- A temporary file `make_temporary` made: open for reading and writing,
--- and its path, the directory's and a name of its own, lent from the
--- caller's buffer.  Nothing removes it: close it, then rename it into
--- place or remove it, on every way out.
public temporary: type = struct
    opened: file
    path: text.host_string
end temporary

--- The rest of the file system: a narrow concept of its own beside
--- `files` and `directories`, outside `world`.  A path is a host string,
--- as `files` takes one, and a file is a `file` of the provider, which
--- `reader`, `writer` and `files` take too.
public file_system: type = concept (provider: type)
    --- Open the file at `path` as `options` say.  A missing file without
    --- `create`, and a path through something that is not a directory,
    --- are `not_found`; a file `exclusive` finds is `already_exists`; a
    --- file the provider may not open so is `no_access`.
    open_file: (self: provider, path: text.host_string,
                options: open_options)
               -> (opened: file)
               ! already_exists | not_found | no_access | io_failed
    --- Give the file at `old` the name `new` in one step, replacing a file
    --- already named `new`; a missing `old` or parent of `new` is
    --- `not_found`.  A rename does not cross from one file system to
    --- another, which is `io_failed`, nor puts a directory where a file is
    --- or a file where a directory is.
    rename: (self: provider, old: text.host_string, new: text.host_string)
            -> none ! not_found | no_access | io_failed
    --- The status of the file at `path`, of a final symbolic link's target
    --- when `follow` is true and of the link itself when it is not.
    status_of: (self: provider, path: text.host_string, follow: bool)
               -> (found: status) ! not_found | no_access | io_failed
    --- The status of an open file.
    status_of_file: (self: provider, opened: file) -> (found: status)
                    ! io_failed
    --- Make the file at `path` read-only, or with `read_only` false
    --- writable by its owner again.
    set_read_only: (self: provider, path: text.host_string, read_only: bool)
                   -> none ! not_found | no_access | io_failed
    --- Have what the provider holds of an open file written where it
    --- lasts before returning: its data and its status, or with
    --- `data_only` its data and only what reading it back needs.
    synchronize: (self: provider, opened: file, data_only: bool)
                 -> none ! io_failed
    --- Give a file open for writing the size `size`, cutting it or
    --- extending it with zeros.
    truncate: (self: provider, opened: file, size: u64) -> none ! io_failed
    --- Read at most `lenof into` bytes of an open file from `offset` on,
    --- without moving the position `read` reads from: the count, zero at or
    --- past its end.
    read_at: (self: provider, opened: file, offset: u64, into: []mut u8)
             -> (count: usize) ! io_failed
    --- Write all of `bytes` into an open file from `offset` on, without
    --- moving the position `write` writes at; a write past the end
    --- extends the file, and what lies between reads as zeros.  Never
    --- write at an offset to a file opened to `append`.
    write_at: (self: provider, opened: file, offset: u64, bytes: []u8)
              -> none ! io_failed
    --- Make and open a new file in `directory`, empty for the working
    --- directory, with a name no other file has, made from bytes of
    --- `names` and tried again when it is taken, and put its path in
    --- `into`.  It is made exclusively, so no other program's file is ever
    --- opened in its place, and readable and writable by its owner alone.
    make_temporary: (self: provider, directory: text.host_string,
                     names: any entropy, into: []mut u8)
                    -> (made: temporary from into)
                    ! not_found | no_access | io_failed
    --- The working directory's path, put in `into`; too long for it is
    --- `io_failed`.  Nothing here changes the working directory, which is
    --- the whole process's: a path is made from this one instead.
    current_directory: (self: provider, into: []mut u8)
                       -> (path: text.host_string from into) ! io_failed
end file_system

--- Whether an open can have `options`: it reads or writes, appends or
--- truncates only when it writes, and is `exclusive` only when it may
--- `create`.  A provider refuses any other with `io_failed` before it asks
--- anything.
public valid_options: (options: open_options) -> (yes: bool) =
    some: bool = options.read or options.write
    writes: bool = options.write or not (options.append or options.truncate)
    makes: bool = options.create or not options.exclusive
    yes = some and writes and makes
end valid_options

--- Open the file at `path` as `options` say, through `file_system`
--- evidence; close it through the same provider's `files`.
public open_file: (provider: type is file_system, host: provider,
                   path: text.host_string, options: open_options)
                  -> (opened: file)
                  ! already_exists | not_found | no_access | io_failed =
    opened = try provider.open_file(host, path, options)
end open_file

--- Give the file at `old` the name `new`, replacing a file already named
--- `new` in the same step: no program sees both names or neither.  The way
--- to replace a file whole is to write a `make_temporary` file beside it,
--- `synchronize` it, close it and rename it onto the file.
public rename: (provider: type is file_system, host: provider,
                old: text.host_string, new: text.host_string)
               -> none ! not_found | no_access | io_failed =
    try provider.rename(host, old, new)
end rename

--- The status of the file at `path`, of a final symbolic link's target
--- when `follow` is true and of the link itself when it is not.
public status_of: (provider: type is file_system, host: provider,
                   path: text.host_string, follow: bool)
                  -> (found: status) ! not_found | no_access | io_failed =
    found = try provider.status_of(host, path, follow)
end status_of

--- The status of an open file.
public status_of_file: (provider: type is file_system, host: provider,
                        opened: file) -> (found: status) ! io_failed =
    found = try provider.status_of_file(host, opened)
end status_of_file

--- Make the file at `path` read-only, or writable by its owner again.  A
--- read-only file refuses to be opened for writing, `no_access`, except to
--- a process the system lets past every permission, as POSIX's root.
public set_read_only: (provider: type is file_system, host: provider,
                       path: text.host_string, read_only: bool)
                      -> none ! not_found | no_access | io_failed =
    try provider.set_read_only(host, path, read_only)
end set_read_only

--- Have what the provider holds of an open file written where it lasts,
--- its status too unless `data_only`, before returning.
public synchronize: (provider: type is file_system, host: provider,
                     opened: file, data_only: bool) -> none ! io_failed =
    try provider.synchronize(host, opened, data_only)
end synchronize

--- Give a file open for writing the size `size`, cutting it or extending
--- it with zeros.
public truncate: (provider: type is file_system, host: provider,
                  opened: file, size: u64) -> none ! io_failed =
    try provider.truncate(host, opened, size)
end truncate

--- Read at most `lenof into` bytes of an open file from `offset` on: the
--- count, which may be short, and zero at or past its end.
public read_at: (provider: type is file_system, host: provider,
                 opened: file, offset: u64, into: []mut u8)
                -> (count: usize) ! io_failed =
    count = try provider.read_at(host, opened, offset, into)
end read_at

--- Write all of `bytes` into an open file from `offset` on, a write past
--- the end leaving zeros between; a failure may follow part of them.
public write_at: (provider: type is file_system, host: provider,
                  opened: file, offset: u64, bytes: []u8)
                 -> none ! io_failed =
    try provider.write_at(host, opened, offset, bytes)
end write_at

--- Make and open a new file in `directory` whose name no other file has,
--- made from bytes the entropy `names` gives, and put its path in `into`,
--- which must hold the directory, a `/` and the 21 bytes of the name; the
--- name is `.tmp-` and sixteen hexadecimal digits, hidden from an ordinary
--- listing.  The hosted provider is its own entropy too,
--- `io.make_temporary(host, host, directory, buffer)`, and a test passes
--- scripted bytes to see a name that is taken tried again.
public make_temporary: (provider: type is file_system, host: provider,
                        source: type is entropy, names: source,
                        directory: text.host_string, into: []mut u8)
                       -> (made: temporary from into)
                       ! not_found | no_access | io_failed =
    erased: any entropy = any(addr names)
    made = try provider.make_temporary(host, directory, erased, into)
end make_temporary

--- The working directory's path, put in `into`.
public current_directory: (provider: type is file_system, host: provider,
                           into: []mut u8)
                          -> (path: text.host_string from into)
                          ! io_failed =
    path = try provider.current_directory(host, into)
end current_directory

--- How many times `make_temporary` tries a name before it gives up with
--- `io_failed`: a name is taken only when the bytes `names` gives repeat.
public temporary_tries: usize = 16

--- The path `make_temporary` tries, from eight bytes of `names`: the
--- directory, a `/` unless it is empty or ends in one, `.tmp-` and the
--- bytes as sixteen lower-case hexadecimal digits, put in `into`; one that
--- does not fit is `io_failed`.  For a provider in another module.
public temporary_path: (directory: text.host_string, bytes: [8]u8,
                        into: []mut u8)
                       -> (path: text.host_string from into) ! io_failed =
    path = text.host_over(into[0..<0])
    mut made := text.over(into)
    folder: []u8 = text.host_bytes(directory)
    text.append(made, folder) else (problem)
        _ = problem
        fail io_failed
    end
    divided: bool = lenof folder == 0 or folder[lenof folder - 1] == 47
    separator: []u8 = if divided then "" else "/" end if
    text.append(made, separator) else (problem)
        _ = problem
        fail io_failed
    end
    text.append(made, ".tmp-") else (problem)
        _ = problem
        fail io_failed
    end
    for byte in bytes do
        start: usize = text.length(made)
        text.append_hex_u32(made, u32(byte)) else (problem)
            _ = problem
            fail io_failed
        end
        text.align_right(made, start, 2, 48) else (problem)
            _ = problem
            fail io_failed
        end
    end for
    length: usize = text.length(made)
    path = text.host_over(into[0..<length])
end temporary_path

--- The file is not a terminal.
public not_a_terminal: atom

--- A terminal's size in characters: its rows and columns.
public window: type = struct
    rows: u16
    columns: u16
end window

--- Terminals: whether a stream is one, and its size, so a program can
--- tell a person from a pipe and fit what it writes to the screen.  A
--- concept of its own, outside `world`.
public terminals: type = concept (provider: type)
    --- Whether `stream` is a terminal.
    is_terminal: (self: provider, stream: file) -> (yes: bool)
    --- The size of the terminal `stream`, `not_a_terminal` for anything
    --- else.  A terminal nothing has sized is zero by zero.
    window_size: (self: provider, stream: file) -> (size: window)
                 ! not_a_terminal | io_failed
end terminals

--- Whether `stream` is a terminal, through `terminals` evidence: false
--- for a file, a pipe and a socket, whatever a program writes to it.
public is_terminal: (provider: type is terminals, host: provider,
                     stream: file) -> (yes: bool) =
    yes = provider.is_terminal(host, stream)
end is_terminal

--- The size of the terminal `stream` in rows and columns.
public window_size: (provider: type is terminals, host: provider,
                     stream: file) -> (size: window)
                    ! not_a_terminal | io_failed =
    size = try provider.window_size(host, stream)
end window_size

--- One terminal of `terminals_over`'s fake: the file it is and its size.
public screen: type = struct
    stream: file
    size: window
end screen

screens_value: type = struct
    screens: []screen
end screens_value

--- Terminals a test gives: each `screen` is a terminal of its size, and
--- every other file is no terminal.  A provider of `terminals`; copies
--- share the screens.
public memory_terminals: type = screens_value

--- Terminals over `screens`, which the handle lends; keep them alive while
--- it is used.
public terminals_over: (screens: []screen)
                       -> (host: memory_terminals from screens) =
    host = (screens: screens)
end terminals_over

memory_is_terminal: (self: memory_terminals, stream: file) -> (yes: bool) =
    yes = false
    for index in usize(0)..<lenof self.screens do
        if self.screens[index].stream == stream then yes = true end if
    end for
end memory_is_terminal

memory_window_size: (self: memory_terminals, stream: file)
                    -> (size: window) ! not_a_terminal | io_failed =
    size = (rows: 0, columns: 0)
    for index in usize(0)..<lenof self.screens do
        if self.screens[index].stream == stream then
            size = self.screens[index].size
            return
        end if
    end for
    fail not_a_terminal
end memory_window_size

memory_terminals is terminals
    (is_terminal: memory_is_terminal, window_size: memory_window_size)
