import core/text

--- Caller-supplied in-memory file slot holding its path, readable bytes and
--- writable capacity. Keep all referenced ranges alive and initialize the
--- fields before constructing the provider.
---
--- Finite caller-backed provider of every io concept. Handles are indexes,
--- not ownership tokens.
--- Clients preserve length <= capacity and supply all retained backing.
public memory_file: type = struct
    name: []u8
    contents: []mut u8
    length: usize
    cursor: usize
    readable: bool
    writable: bool
    opened: bool
    writing: bool
end memory_file

--- Caller-owned state of an in-memory world: how much standard input, output
--- and error it has used, which standard streams are open, the injected
--- limits and failures, and call counts. Declare it `zeroed` and give it to
--- `memory_over`, which fills it; it must outlive the world's handle. Its
--- fields may be read, and the limits and failure points set, while the
--- handle is in use.
public memory_space: type = struct
    input_used: usize
    output_used: usize
    errors_used: usize
    input_open: bool
    output_open: bool
    errors_open: bool
    read_limit: usize
    write_limit: usize
    fail_read_at: usize
    fail_write_at: usize
    fail_close_at: usize
    read_calls: usize
    write_calls: usize
    close_calls: usize
    open_calls: usize
end memory_space

memory_value: type = struct
    state: ptr mut memory_space
    files: []mut memory_file
    arguments: [][]u8
    input: []u8
    output: []mut u8
    errors: []mut u8
end memory_value

--- In-memory world as a handle over caller-owned state, file slots,
--- standard-input bytes, output buffers and argument bytes: copies share
--- one world. No host handles or implicit allocator are used.
public memory: type = memory_value

--- Fill `state` for an in-memory world over the supplied records and buffers
--- and return its handle. The handle retains their references; keep them
--- alive and avoid conflicting access while it is used. `arguments` are the
--- bytes of each process argument, which the world lends as host strings,
--- so a firmware test can declare its table as data. `input` is what
--- standard input reads, from its first byte to end of input; pass `""` for
--- a world whose standard input is empty.
public memory_over: (inout state: memory_space, files: []mut memory_file,
                     arguments: [][]u8, input: []u8,
                     output: []mut u8, errors: []mut u8)
                    -> (host: memory from state, files, arguments, input,
                        output, errors) =
    state = (input_used: 0, output_used: 0, errors_used: 0,
             input_open: true, output_open: true, errors_open: true,
             read_limit: 0 -% 1, write_limit: 0 -% 1,
             fail_read_at: 0, fail_write_at: 0, fail_close_at: 0,
             read_calls: 0, write_calls: 0, close_calls: 0, open_calls: 0)
    host = (state: addr state, files: files, arguments: arguments,
            input: input, output: output, errors: errors)
end memory_over

memory_open: (self: memory, path: text.host_string, writing: bool)
             -> (opened: file) ! not_found | no_access | io_failed =
    inc self.state.val.open_calls
    wanted: []u8 = text.host_bytes(path)
    mut at: usize = 0
    while at < memory_file_count(self.files) do
        current: ptr mut memory_file = addr self.files[at]
        if memory_same_bytes(wanted, current.val.name) then
            fail no_access when writing and not current.val.writable
            fail no_access when not writing and not current.val.readable
            fail io_failed when current.val.opened
              or current.val.length > memory_bytes_count(current.val.contents)
            current.val.cursor = 0
            current.val.opened = true
            current.val.writing = writing
            if writing then current.val.length = 0 end if
            opened = file_value(at + 3)
            return
        end if
        inc at
    end while
    fail not_found
end memory_open

memory_open_read: (self: memory, path: text.host_string)
                  -> (opened: file) ! not_found | no_access | io_failed =
    opened = try memory_open(self, path, false)
end memory_open_read

memory_open_write: (self: memory, path: text.host_string)
                   -> (opened: file) ! not_found | no_access | io_failed =
    opened = try memory_open(self, path, true)
end memory_open_write

memory_same_file: (self: memory, left: text.host_string,
                   right: text.host_string)
                  -> (same: bool) ! io_failed =
    same = false
    left_name: []u8 = text.host_bytes(left)
    right_name: []u8 = text.host_bytes(right)
    mut left_index: usize = memory_file_count(self.files)
    mut right_index: usize = memory_file_count(self.files)
    for at in usize(0)..<memory_file_count(self.files) do
        if left_index == memory_file_count(self.files)
          and memory_same_bytes(left_name, self.files[at].name) then
            left_index = at
        end if
        if right_index == memory_file_count(self.files)
          and memory_same_bytes(right_name, self.files[at].name) then
            right_index = at
        end if
    end for
    fail io_failed when left_index == memory_file_count(self.files)
    same = left_index == right_index
end memory_same_file

memory_close: (self: memory, sink opened: file) -> none ! io_failed =
    state: ptr mut memory_space = self.state
    inc state.val.close_calls
    if usize(opened) == 0 then
        fail io_failed when not state.val.input_open
        state.val.input_open = false
    elsif usize(opened) == 1 then
        fail io_failed when not state.val.output_open
        state.val.output_open = false
    elsif usize(opened) == 2 then
        fail io_failed when not state.val.errors_open
        state.val.errors_open = false
    else
        fail io_failed when usize(opened) < 3
        index: usize = usize(opened) - 3
        fail io_failed when index >= memory_file_count(self.files)
        current: ptr mut memory_file = addr self.files[index]
        fail io_failed when not current.val.opened
        current.val.opened = false
    end if
    fail io_failed when state.val.close_calls == state.val.fail_close_at
end memory_close

--  Copy what remains of SOURCE after START into INTO, at most LIMIT bytes:
--  standard input and a file are read alike.
memory_take: (source: []u8, start: usize, into: []mut u8, limit: usize)
             -> (count: usize) ! io_failed =
    fail io_failed when start > lenof source
    count = lenof source - start
    fail io_failed when count > 0 and limit == 0
    if count > lenof into then count = lenof into end if
    if count > limit then count = limit end if
    mut at: usize = 0
    while at < count do
        into[at] = source[start + at]
        inc at
    end while
end memory_take

memory_read: (self: memory, opened: file, into: []mut u8)
             -> (count: usize) ! io_failed =
    state: ptr mut memory_space = self.state
    if lenof into == 0 then
        count = 0
        return
    end if
    inc state.val.read_calls
    fail io_failed when state.val.read_calls == state.val.fail_read_at
    if usize(opened) == 0 then
        fail io_failed when not state.val.input_open
        count = try memory_take(self.input, state.val.input_used, into,
                                state.val.read_limit)
        state.val.input_used += count
        return
    end if
    fail io_failed when usize(opened) < 3
    index: usize = usize(opened) - 3
    fail io_failed when index >= memory_file_count(self.files)
    current: ptr mut memory_file = addr self.files[index]
    fail io_failed when not current.val.opened or current.val.writing
      or current.val.length > memory_bytes_count(current.val.contents)
    count = try memory_take(current.val.contents[0..<current.val.length],
                            current.val.cursor, into, state.val.read_limit)
    current.val.cursor += count
end memory_read

memory_write_some: (self: memory, opened: file, bytes: []u8)
                   -> (count: usize) ! io_failed =
    state: ptr mut memory_space = self.state
    if lenof bytes == 0 then
        count = 0
        return
    end if
    inc state.val.write_calls
    fail io_failed when state.val.write_calls == state.val.fail_write_at
      or state.val.write_limit == 0
    count = lenof bytes
    if count > state.val.write_limit then count = state.val.write_limit end if
    if usize(opened) == 1 then
        fail io_failed when not state.val.output_open
          or state.val.output_used > memory_bytes_count(self.output)
        available: usize = memory_bytes_count(self.output) - state.val.output_used
        fail io_failed when available == 0
        if count > available then count = available end if
        mut n: usize = 0
        while n < count do
            self.output[state.val.output_used + n] = bytes[n]
            inc n
        end while
        state.val.output_used += count
    elsif usize(opened) == 2 then
        fail io_failed when not state.val.errors_open
          or state.val.errors_used > memory_bytes_count(self.errors)
        available: usize = memory_bytes_count(self.errors) - state.val.errors_used
        fail io_failed when available == 0
        if count > available then count = available end if
        mut n: usize = 0
        while n < count do
            self.errors[state.val.errors_used + n] = bytes[n]
            inc n
        end while
        state.val.errors_used += count
    else
        fail io_failed when usize(opened) < 3
        index: usize = usize(opened) - 3
        fail io_failed when index >= memory_file_count(self.files)
        current: ptr mut memory_file = addr self.files[index]
        fail io_failed when not current.val.opened or not current.val.writing
          or current.val.length > memory_bytes_count(current.val.contents)
        available: usize = memory_bytes_count(current.val.contents) - current.val.length
        fail io_failed when available == 0
        if count > available then count = available end if
        mut n: usize = 0
        while n < count do
            current.val.contents[current.val.length + n] = bytes[n]
            inc n
        end while
        current.val.length += count
        current.val.cursor = current.val.length
    end if
end memory_write_some

memory_write: (self: memory, opened: file, bytes: []u8)
              -> none ! io_failed =
    mut at: usize = 0
    while at < lenof bytes do
        count: usize = try memory_write_some(self, opened, bytes[at..<lenof bytes])
        at += count
    end while
end memory_write

memory_input: (self: memory) -> (stream: file) =
    _ = self.state.val.input_used
    stream = file_value(0)
end memory_input
memory_out: (self: memory) -> (stream: file) =
    _ = self.state.val.output_used
    stream = file_value(1)
end memory_out
memory_err: (self: memory) -> (stream: file) =
    _ = self.state.val.errors_used
    stream = file_value(2)
end memory_err
memory_argument_count: (self: memory) -> (count: usize) =
    count = memory_args_count(self.arguments)
end memory_argument_count
memory_argument: (self: memory, index: usize)
                 -> (value: text.host_string from self) ! no_argument =
    fail no_argument when index >= memory_args_count(self.arguments)
    value = text.host_over(self.arguments[index])
end memory_argument

memory is reader (read: memory_read)
memory is writer (write: memory_write, write_some: memory_write_some)
memory is files
    (open_read: memory_open_read, open_write: memory_open_write,
     same_file: memory_same_file, close: memory_close)
memory is process
    (input: memory_input, out: memory_out, err: memory_err,
     argument_count: memory_argument_count, argument: memory_argument)
memory is world ()

--  The memory world's directories are the parts of its slots' names before
--  a `/`: slot "tree/a.txt" puts a regular file "a.txt" in directory
--  "tree", "tree/sub/b.txt" a subdirectory "sub" in it, and a slot named
--  "tree/empty/" an empty directory "empty".  An open directory's handle
--  is the index of a slot under it and its stream the length of its path;
--  position is the next slot a refill looks at.  Its buffer holds records
--  of a kind byte, a two-byte length and the name.

--  Whether NAME begins with PREFIX followed by a `/`.
memory_under: (name: []u8, prefix: []u8) -> (yes: bool) =
    yes = false
    return when lenof name <= lenof prefix
    for at in usize(0)..<lenof prefix do
        return when name[at] <> prefix[at]
    end for
    yes = name[lenof prefix] == 47
end memory_under

--  The first slot under the directory at PATH, or the slot count when no
--  slot is under it.
memory_directory_slot: (self: memory, path: text.host_string)
                       -> (slot: usize) =
    slot = memory_file_count(self.files)
    wanted: []u8 = text.host_bytes(path)
    return when lenof wanted == 0
    for at in usize(0)..<memory_file_count(self.files) do
        if memory_under(self.files[at].name, wanted) then
            slot = at
            return
        end if
    end for
end memory_directory_slot

--  The name a slot gives an entry of the directory PREFIX, with whether it
--  is a subdirectory; an empty name when the slot gives none.
memory_component: (name: []u8, prefix: []u8)
                  -> (component: []u8 from name, below: bool) =
    component = name[0..<0]
    below = false
    return when not memory_under(name, prefix)
    start: usize = lenof prefix + 1
    mut stop: usize = start
    while stop < lenof name and name[stop] <> 47 do
        inc stop
    end while
    component = name[start..<stop]
    below = stop < lenof name
end memory_component

memory_same_bytes: (left: []u8, right: []u8) -> (yes: bool) =
    yes = lenof left == lenof right
    mut at: usize = 0
    while yes and at < lenof left do
        yes = left[at] == right[at]
        inc at
    end while
end memory_same_bytes

--  Whether a slot before INDEX already gave the directory PREFIX the entry
--  COMPONENT.
memory_seen: (files: []memory_file, index: usize, prefix: []u8,
              component: []u8) -> (yes: bool) =
    yes = false
    for at in usize(0)..<index do
        (component: earlier, below) := memory_component(files[at].name, prefix)
        _ = below
        if memory_same_bytes(earlier, component) then
            yes = true
            return
        end if
    end for
end memory_seen

memory_open_directory: (self: memory, path: text.host_string,
                        buffer: []mut u8)
                       -> (opened: directory from buffer)
                       ! not_found | no_access | io_failed =
    inc self.state.val.open_calls
    slot: usize = memory_directory_slot(self, path)
    fail not_found when slot == memory_file_count(self.files)
    named: []u8 = text.host_bytes(path)
    opened = (handle: slot, stream: lenof named, position: 0,
              buffer: buffer, filled: 0, cursor: 0, finished: false)
end memory_open_directory

--  Fill the directory's buffer with the records of as many entries as fit,
--  from its position on.
memory_refill: (self: memory, inout opened: directory) -> none ! io_failed =
    opened.filled = 0
    opened.cursor = 0
    prefix: []u8 = self.files[opened.handle].name[0..<opened.stream]
    while opened.position < memory_file_count(self.files) do
        (component, below) := memory_component(
            self.files[opened.position].name, prefix)
        if lenof component > 0
          and not memory_seen(self.files, opened.position, prefix, component)
        then
            fail io_failed when lenof component > 65535
            needed: usize = lenof component + 3
            if needed > memory_bytes_count(opened.buffer) - opened.filled then
                --  An entry larger than the whole buffer can never be read.
                fail io_failed when opened.filled == 0
                return
            end if
            at: usize = opened.filled
            opened.buffer[at] = if below then 1 else 0 end if
            opened.buffer[at + 1] = u8(lenof component & 255)
            opened.buffer[at + 2] = u8(lenof component >> 8)
            for n in usize(0)..<lenof component do
                opened.buffer[at + 3 + n] = component[n]
            end for
            opened.filled += needed
        end if
        inc opened.position
    end while
    opened.finished = true
end memory_refill

memory_read_entry: (self: memory, inout opened: directory)
                   -> (item: entry from opened) ! io_failed =
    if opened.cursor >= opened.filled and not opened.finished then
        try memory_refill(self, opened)
    end if
    if opened.cursor >= opened.filled then
        item = (name: text.host_over(opened.buffer[0..<0]), kind: special)
        return
    end if
    fail io_failed when opened.filled - opened.cursor < 3
    at: usize = opened.cursor
    length: usize = usize(opened.buffer[at + 1])
                    | (usize(opened.buffer[at + 2]) << 8)
    fail io_failed when length > opened.filled - at - 3
    opened.cursor = at + 3 + length
    kind: entry_kind = if opened.buffer[at] == 1 then subdirectory
                       else regular end if
    item = (name: text.host_over(opened.buffer[at + 3..<at + 3 + length]),
            kind: kind)
end memory_read_entry

memory_entry_size: (self: memory, opened: directory,
                    name: text.host_string)
                   -> (size: u64) ! not_found | no_access | io_failed =
    size = 0
    wanted: []u8 = text.host_bytes(name)
    fail not_found when lenof wanted == 0
    for byte in wanted do
        fail not_found when byte == 0 or byte == 47
    end for
    fail io_failed when opened.handle >= memory_file_count(self.files)
    prefix: []u8 = self.files[opened.handle].name[0..<opened.stream]
    for at in usize(0)..<memory_file_count(self.files) do
        (component, below) := memory_component(self.files[at].name, prefix)
        if memory_same_bytes(component, wanted) then
            current: ptr memory_file = addr self.files[at]
            size = if below then 0 else u64(current.val.length) end if
            return
        end if
    end for
    fail not_found
end memory_entry_size

memory_close_directory: (self: memory, sink opened: directory)
                        -> none ! io_failed =
    _ = opened.handle
    state: ptr mut memory_space = self.state
    inc state.val.close_calls
    fail io_failed when state.val.close_calls == state.val.fail_close_at
end memory_close_directory

--  The memory world's tree is its caller's slots, which it cannot add to
--  or take from: a directory it has already exists, and every other change
--  is refused.
memory_make_directory: (self: memory, path: text.host_string)
                       -> none
                       ! already_exists | not_found | no_access | io_failed =
    slot: usize = memory_directory_slot(self, path)
    fail already_exists when slot < memory_file_count(self.files)
    wanted: []u8 = text.host_bytes(path)
    for at in usize(0)..<memory_file_count(self.files) do
        fail already_exists when memory_same_bytes(wanted, self.files[at].name)
    end for
    fail no_access
end memory_make_directory

memory_remove_file: (self: memory, path: text.host_string)
                    -> none ! not_found | no_access | io_failed =
    wanted: []u8 = text.host_bytes(path)
    for at in usize(0)..<memory_file_count(self.files) do
        fail no_access when memory_same_bytes(wanted, self.files[at].name)
    end for
    fail not_found
end memory_remove_file

memory_remove_directory: (self: memory, path: text.host_string)
                         -> none ! not_found | no_access | io_failed =
    slot: usize = memory_directory_slot(self, path)
    fail no_access when slot < memory_file_count(self.files)
    fail not_found
end memory_remove_directory

memory is directories
    (open_directory: memory_open_directory, read_entry: memory_read_entry,
     entry_size: memory_entry_size, close_directory: memory_close_directory,
     make_directory: memory_make_directory, remove_file: memory_remove_file,
     remove_directory: memory_remove_directory)

--- Lend the initialized standard-output prefix accumulated by the memory
--- provider.
public written: (host: memory) -> (bytes: []u8 from host) =
    output: []mut u8 = host.output
    bytes = output[0..<host.state.val.output_used]
end written
--- Lend the initialized standard-error prefix accumulated by the memory
--- provider.
public written_errors: (host: memory) -> (bytes: []u8 from host) =
    errors: []mut u8 = host.errors
    bytes = errors[0..<host.state.val.errors_used]
end written_errors

memory_file_count: (values: []memory_file) -> (count: usize) =
    count = lenof values
end memory_file_count
memory_args_count: (values: [][]u8) -> (count: usize) =
    count = lenof values
end memory_args_count
memory_bytes_count: (values: []u8) -> (count: usize) =
    count = lenof values
end memory_bytes_count
