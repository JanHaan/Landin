--  A vector with a private initialized inline prefix. Unused inline slots
--  have no readable item image. The spill descriptor remains empty until
--  the first growth allocation.

import core/mem
import core/vec

spill_value: type (item: type, fixed inline_slots: usize) = struct
    count: usize
    inline_values: [inline_slots]item
    spill: vec.list(item)
    spilled: bool
end spill_value

--- Vector with an inline prefix of `inline_slots` items that spills into
--- allocator-backed storage when it fills. Only initialized slots are
--- readable; no item needs a zero image.
public list: type (item: type, fixed inline_slots: usize) = struct
    storage: spill_value(item, inline_slots)
end list

--- Create an empty inline vector without allocating. Unused inline slots have
--- no readable item value.
public new: (item: type, fixed inline_slots: usize)
            -> (value: list(item, inline_slots)) =
    fresh := vec.new(item: item)
    value = (storage: (count: 0, inline_values: uninit,
                       spill: fresh, spilled: false))
end new

--- Return the initialized item count. A read-only pointer accepts addresses
--- of mutable and immutable containers without copying their inline storage.
public length: (item: type, fixed inline_slots: usize,
                value: ptr list(item, inline_slots)) -> (count: usize) =
    count = value.val.storage.count
end length

--- Return the inline capacity before spilling, or the backing vector capacity
--- afterwards.
public capacity: (item: type, fixed inline_slots: usize,
                  value: ptr list(item, inline_slots)) -> (count: usize) =
    if value.val.storage.spilled then
        count = vec.capacity(value.val.storage.spill)
    else
        count = inline_slots
    end if
end capacity

first_capacity: (fixed inline_slots: usize)
                -> (count: usize) ! mem.out_of_memory =
    current: usize = inline_slots
    if current == 0 then
        count = 8
        return
    end if
    maximum: usize = 0 -% 1
    fail mem.out_of_memory when current > maximum / 2
    count = current * 2
end first_capacity

--- Append inline while room remains, then spill to allocated storage.
--- Allocation failure leaves the vector unchanged. Growth or the first spill
--- invalidates old item views.
public push: (item: type, fixed inline_slots: usize,
              provider: type is mem.allocator,
              escaping inout value: list(item, inline_slots),
              inout state: provider, escaping added: item)
             -> none ! mem.out_of_memory =
    if value.storage.spilled then
        try vec.push(value.storage.spill, state, added)
        inc value.storage.count
        return
    end if
    if value.storage.count < inline_slots then
        value.storage.inline_values[value.storage.count] = added
        inc value.storage.count
        return
    end if

    wanted: usize = try first_capacity(inline_slots: inline_slots)
    mut fresh := vec.new(item: item)
    try vec.reserve(fresh, state, wanted)

    mut at: usize = 0
    while at < value.storage.count do
        --  Only the prefix has an item image. Reserve established room for
        --  every one of these pushes without another allocation.
        copied: item = value.storage.inline_values[at]
        try vec.push(fresh, state, copied)
        inc at
    end while
    try vec.push(fresh, state, added)

    value.storage.spill = fresh
    value.storage.spilled = true
    inc value.storage.count
end push

--- Lend the initialized mutable prefix from inline or spill storage. The
--- container and its backing must remain valid for the view's lifetime.
public used: (item: type, fixed inline_slots: usize,
              inout value: list(item, inline_slots))
             -> (view: []mut item from value) =
    if value.storage.spilled then
        view = vec.used(value.storage.spill)
    else
        view = value.storage.inline_values[0..<value.storage.count]
    end if
end used

--- Copy the indexed item without copying the container. Reports
--- `mem.out_of_bounds` outside its initialized prefix.
public get: (item: type, fixed inline_slots: usize,
             value: ptr list(item, inline_slots), index: usize)
            -> (result: item from value) ! mem.out_of_bounds =
    if value.val.storage.spilled then
        result = try vec.get(value.val.storage.spill, index)
    else
        fail mem.out_of_bounds when index >= value.val.storage.count
        result = value.val.storage.inline_values[index]
    end if
end get

--- Lend a writable item pointer, with the same binding lock as `vec.at`
--- [0800]. Reports `mem.out_of_bounds` before forming an invalid pointer;
--- end the pointer before a push or release.
public at: (item: type, fixed inline_slots: usize,
            inout value: list(item, inline_slots), index: usize)
           -> (slot: ptr mut item from value) ! mem.out_of_bounds =
    view: []mut item = used(value)
    fail mem.out_of_bounds when index >= lenof view
    slot = addr view[index]
end at

--- Remove and return the last item, retaining spill capacity. Reports
--- `mem.empty` when empty; popping does not switch back to inline storage.
public pop: (item: type, fixed inline_slots: usize,
             inout value: list(item, inline_slots))
            -> (removed: item from value) ! mem.empty =
    fail mem.empty when value.storage.count == 0
    if value.storage.spilled then
        removed = try vec.pop(value.storage.spill)
        dec value.storage.count
    else
        dec value.storage.count
        removed = value.storage.inline_values[value.storage.count]
    end if
end pop

--- Free any spill allocation through its original provider and reset to an
--- empty inline vector. Does not clean up resources referenced by items.
public release: (item: type, fixed inline_slots: usize,
                 provider: type is mem.allocator,
                 inout value: list(item, inline_slots),
                 inout state: provider) -> none =
    if value.storage.spilled then
        vec.release(value.storage.spill, state)
    end if
    value.storage.count = 0
    value.storage.spilled = false
end release
