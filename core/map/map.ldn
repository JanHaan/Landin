import core/mem

public missing: atom
public end_of_entries: atom

public equatable: type = concept (key: type)
    eq: (left: key, right: key) -> (same: bool)
end equatable

--  A hashable conformance composes equatable, but [1340] still requires a
--  concrete key type to declare both conformances explicitly.
public hashable: type = concept (key: type) is equatable
    hash: (value: key) -> (result: u64)
end hashable

--  The compiler does not prove the semantic laws: eq must be an equivalence
--  relation, equal keys must hash alike, and both answers must stay stable
--  while a key is stored, including across mutation of anything a
--  pointer/reference key reaches.

--  Keys the library supplies evidence for: the integer scalars, bool and
--  byte slices here, and utf8 in core/text. There is one register and no
--  override [1280]; a program wanting another equality or hash for one of
--  these wraps the key in a distinct type and declares evidence for that.
--  Signed hashes are the two's-complement bits widened, computed without
--  a narrowing conversion; byte slices use 64-bit FNV-1a.
eq_u8: (left: u8, right: u8) -> (same: bool) =
    same = left == right
end eq_u8
hash_u8: (value: u8) -> (result: u64) =
    result = u64(value)
end hash_u8
eq_u16: (left: u16, right: u16) -> (same: bool) =
    same = left == right
end eq_u16
hash_u16: (value: u16) -> (result: u64) =
    result = u64(value)
end hash_u16
eq_u32: (left: u32, right: u32) -> (same: bool) =
    same = left == right
end eq_u32
hash_u32: (value: u32) -> (result: u64) =
    result = u64(value)
end hash_u32
eq_u64: (left: u64, right: u64) -> (same: bool) =
    same = left == right
end eq_u64
hash_u64: (value: u64) -> (result: u64) =
    result = u64(value)
end hash_u64
eq_usize: (left: usize, right: usize) -> (same: bool) =
    same = left == right
end eq_usize
hash_usize: (value: usize) -> (result: u64) =
    result = u64(value)
end hash_usize
eq_i8: (left: i8, right: i8) -> (same: bool) =
    same = left == right
end eq_i8
hash_i8: (value: i8) -> (result: u64) =
    if value >= 0 then
        result = u64(value)
    else
        result = ~u64(0 - (value + 1))
    end if
end hash_i8
eq_i16: (left: i16, right: i16) -> (same: bool) =
    same = left == right
end eq_i16
hash_i16: (value: i16) -> (result: u64) =
    if value >= 0 then
        result = u64(value)
    else
        result = ~u64(0 - (value + 1))
    end if
end hash_i16
eq_i32: (left: i32, right: i32) -> (same: bool) =
    same = left == right
end eq_i32
hash_i32: (value: i32) -> (result: u64) =
    if value >= 0 then
        result = u64(value)
    else
        result = ~u64(0 - (value + 1))
    end if
end hash_i32
eq_i64: (left: i64, right: i64) -> (same: bool) =
    same = left == right
end eq_i64
hash_i64: (value: i64) -> (result: u64) =
    if value >= 0 then
        result = u64(value)
    else
        result = ~u64(0 - (value + 1))
    end if
end hash_i64
eq_isize: (left: isize, right: isize) -> (same: bool) =
    same = left == right
end eq_isize
hash_isize: (value: isize) -> (result: u64) =
    if value >= 0 then
        result = u64(value)
    else
        result = ~u64(0 - (value + 1))
    end if
end hash_isize
eq_bool: (left: bool, right: bool) -> (same: bool) =
    same = left == right
end eq_bool
hash_bool: (value: bool) -> (result: u64) =
    result = if value then 1 else 0 end if
end hash_bool
eq_bytes: (left: []u8, right: []u8) -> (same: bool) =
    if lenof left <> lenof right then
        same = false
        return
    end if
    mut index: usize = 0
    while index < lenof left do
        if left[index] <> right[index] then
            same = false
            return
        end if
        inc index
    end while
    same = true
end eq_bytes
hash_bytes: (value: []u8) -> (result: u64) =
    mut hash: u64 = 14695981039346656037
    mut index: usize = 0
    while index < lenof value do
        hash = (hash ^ u64(value[index])) *% 1099511628211
        inc index
    end while
    result = hash
end hash_bytes
u8 is equatable (eq: eq_u8)
u8 is hashable (hash: hash_u8)
u16 is equatable (eq: eq_u16)
u16 is hashable (hash: hash_u16)
u32 is equatable (eq: eq_u32)
u32 is hashable (hash: hash_u32)
u64 is equatable (eq: eq_u64)
u64 is hashable (hash: hash_u64)
usize is equatable (eq: eq_usize)
usize is hashable (hash: hash_usize)
i8 is equatable (eq: eq_i8)
i8 is hashable (hash: hash_i8)
i16 is equatable (eq: eq_i16)
i16 is hashable (hash: hash_i16)
i32 is equatable (eq: eq_i32)
i32 is hashable (hash: hash_i32)
i64 is equatable (eq: eq_i64)
i64 is hashable (hash: hash_i64)
isize is equatable (eq: eq_isize)
isize is hashable (hash: hash_isize)
bool is equatable (eq: eq_bool)
bool is hashable (hash: hash_bool)
[]u8 is equatable (eq: eq_bytes)
[]u8 is hashable (hash: hash_bytes)

slot_free: u8 = 0
slot_used: u8 = 1
slot_dead: u8 = 2

--  Buckets are always initialized. Keys and values occupy two independent
--  dense initialized prefixes, and each used/dead bucket names its prefix
--  position. Used buckets also form a doubly linked walk in insertion order;
--  the map's capacity is the end marker for every link. Reusing a tombstone
--  replaces its dense position and appends it to that walk.
bucket: type = struct
    state: u8
    dense_index: usize
    previous_used: usize
    next_used: usize
end bucket

--  This is deliberately a public composition, not an encapsulated object.
--  Callers can pass each storage to mem's public operations, can reach the
--  initialized K/V prefixes (including removed dense entries), and can copy
--  inferred whole bucket values despite bucket's private identity. They must
--  preserve equal capacities, a fully initialized bucket array, paired K/V
--  prefixes, one valid used/dead bucket per dense position, exact
--  count/tombstone totals, and a linked walk of exactly the used buckets
--  when composing below the map operations.
public map: type (key: type is hashable, item: type) = struct
    buckets: mem.storage(bucket)
    keys: mem.storage(key)
    values: mem.storage(item)
    count: usize
    tombstones: usize
    first_used: usize
    last_used: usize
end map

--  Enumeration deliberately exposes ordinary public value shapes, matching
--  map's public-composition boundary above. A cursor is a manual
--  live-bucket position, not an ownership or snapshot token: it has no map
--  identity or generation check and is not transferable between maps. Any mutation,
--  including insert, remove, rehash, clear and release, invalidates an active
--  walk; callers must discard its cursor and restart.
public cursor: type = struct
    next_slot: usize
end cursor

public entry: type (key: type, item: type) = struct
    key: key
    item: item
end entry

empty_storage: (value: type) -> (result: mem.storage(value)) =
    result = mem.empty_storage(item: value)
end empty_storage

public new: (key: type is hashable, item: type)
            -> (result: map(key, item)) =
    empty_buckets := empty_storage(value: bucket)
    empty_keys := empty_storage(value: key)
    empty_values := empty_storage(value: item)
    result = (buckets: empty_buckets, keys: empty_keys,
              values: empty_values, count: 0, tombstones: 0,
              first_used: 0, last_used: 0)
end new

public length: (key: type is hashable, item: type,
                value: map(key, item)) -> (count: usize) =
    count = value.count
end length

public capacity: (key: type is hashable, item: type,
                  value: map(key, item)) -> (count: usize) =
    count = mem.capacity(value.buckets)
end capacity

public entries: () -> (position: cursor) =
    --  This marker means "start at the map's head" on the first call. It is
    --  distinct from every possible bucket capacity and from the exhausted
    --  marker, which is the capacity of the map being walked.
    position = (next_slot: 0 -% 1)
end entries

--  Each call follows one live link. Across an unmodified walk, every live
--  entry is returned once in insertion order and the walk costs O(count),
--  including the exhausted call. The result retains `from value` because K
--  or V may hold references into the map's initialized storage.
public next_entry: (key: type is hashable, item: type,
                    value: map(key, item), inout position: cursor)
                   -> (result: entry(key, item) from value) ! end_of_entries =
    slots: usize = capacity(value)
    if position.next_slot == 0 -% 1 then
        position.next_slot = value.first_used
    end if
    fail end_of_entries when position.next_slot >= slots
    record: bucket = (mem.get(value.buckets, position.next_slot)
        else (problem)
        _ = problem
        fail end_of_entries
    end)
    fail end_of_entries when record.state <> slot_used
    position.next_slot = record.next_used
    found_key: key = (mem.get(value.keys, record.dense_index)
        else (problem)
        _ = problem
        fail end_of_entries
    end)
    found_item: item = (mem.get(value.values, record.dense_index)
        else (problem)
        _ = problem
        fail end_of_entries
    end)
    result = (key: found_key, item: found_item)
end next_entry

byte_extent: (value: type, slots: usize)
             -> (extent: usize) ! mem.out_of_memory =
    size: usize = sizeof value
    if size == 0 then
        extent = 0
        return
    end if
    maximum: usize = 0 -% 1
    fail mem.out_of_memory when slots > maximum / size
    extent = slots * size
end byte_extent

drain: (value: type, inout storage: mem.storage(value)) -> none =
    while mem.initialized(storage) > 0 do
        discarded: value = mem.withdraw(storage) else (problem)
            _ = problem
            return
        end
    end while
end drain

free_empty: (value: type, provider: type is mem.allocator,
             inout storage: mem.storage(value),
             inout state: provider) -> none =
    slots: usize = mem.capacity(storage)
    return when slots == 0
    extent: usize = slots * sizeof value
    block: ptr mut u8 = mem.dispose(storage) else (problem)
        _ = problem
        return
    end
    provider.free(state, block, extent)
end free_empty

discard_storage: (value: type, provider: type is mem.allocator,
                  inout storage: mem.storage(value),
                  inout state: provider) -> none =
    drain(storage)
    free_empty(storage, state)
end discard_storage

replace_value: (value: type, inout storage: mem.storage(value),
                index: usize, escaping replacement: value) -> (ok: bool) =
    mem.replace(storage, index, replacement) else (problem)
        _ = problem
        ok = false
        return
    end
    ok = true
end replace_value

index_of: (key: type is hashable, value: key, slots: usize)
          -> (index: usize) =
    --  Every library-created nonempty capacity is a power of two. Mask in
    --  u64 before narrowing, so the same full-width reduction applies on a
    --  32-bit target. Publicly composed maps may have other capacities.
    hash: u64 = key.hash(value)
    if (slots & (slots - 1)) == 0 then
        index = usize(hash & u64(slots - 1))
    else
        index = usize(hash % u64(slots))
    end if
end index_of

next_index: (index: usize, slots: usize) -> (next: usize) =
    if index == slots - 1 then
        next = 0
    else
        next = index + 1
    end if
end next_index

--  This is equivalent to `(count + tombstones + 1) * 4 > slots * 3`
--  without overflowing either addition or multiplication. Corrupt counters
--  conservatively report pressure rather than wrapping to "not crowded".
--  Insert consults this only when no tombstones remain.
crowded: (key: type is hashable, item: type,
          value: map(key, item)) -> (yes: bool) =
    slots: usize = capacity(value)
    if slots == 0 then
        yes = true
        return
    end if
    if value.count > slots or value.tombstones > slots - value.count then
        yes = true
        return
    end if
    occupied: usize = value.count + value.tombstones
    yes = occupied >= crowding_threshold(slots)
end crowded

--  Three quarters of the slots, computed without overflow.
crowding_threshold: (slots: usize) -> (threshold: usize) =
    quarter: usize = slots / 4
    remainder: usize = slots % 4
    threshold = quarter * 3 + (remainder * 3) / 4
end crowding_threshold

install_at: (key: type is hashable, item: type,
             inout value: map(key, item), at: usize, was_dead: bool,
             escaping added_key: key, escaping added_value: item)
            -> (placed: bool) =
    slots: usize = capacity(value)
    mut dense: usize = 0
    if was_dead then
        record: bucket = (mem.get(value.buckets, at) else (problem)
            _ = problem
            placed = false
            return
        end)
        dense = record.dense_index
        if not replace_value(value.keys, dense, added_key) then
            placed = false
            return
        end if
        if not replace_value(value.values, dense, added_value) then
            placed = false
            return
        end if
    else
        dense = (mem.admit(value.keys, added_key) else (problem)
            _ = problem
            placed = false
            return
        end)
        value_dense: usize = (mem.admit(value.values, added_value)
            else (problem)
            _ = problem
            discarded: key = (mem.withdraw(value.keys) else (release_problem)
                _ = release_problem
                placed = false
                return
            end)
            placed = false
            return
        end)
        if value_dense <> dense then
            placed = false
            return
        end if
    end if

    replacement_bucket: bucket =
        (state: slot_used, dense_index: dense,
         previous_used: value.last_used, next_used: slots)
    if not replace_value(value.buckets, at, replacement_bucket) then
        placed = false
        return
    end if
    if value.last_used < slots then
        mut tail: bucket = (mem.get(value.buckets, value.last_used)
            else (problem)
            _ = problem
            placed = false
            return
        end)
        tail.next_used = at
        if not replace_value(value.buckets, value.last_used, tail) then
            placed = false
            return
        end if
    else
        value.first_used = at
    end if
    value.last_used = at
    inc value.count
    if was_dead then
        dec value.tombstones
    end if
    placed = true
end install_at

--  Keep the absent key's placement position so insertion without a rebuild
--  does not probe the same chain again. A dead bucket is usable only after
--  checking the rest of the chain for an equal used key.
insert_search: type = struct
    updated: bool
    slot_index: usize
    was_dead: bool
end insert_search

search_for_insert: (key: type is hashable, item: type,
                    inout value: map(key, item), wanted: key,
                    escaping replacement: item)
                   -> (result: insert_search) ! mem.out_of_memory =
    slots: usize = capacity(value)
    if slots == 0 then
        result = (updated: false, slot_index: slots, was_dead: false)
        return
    end if

    mut at: usize = index_of(wanted, slots)
    mut first_dead: usize = slots
    mut probed: usize = 0
    while probed < slots do
        record: bucket = (mem.get(value.buckets, at) else (problem)
            _ = problem
            fail mem.out_of_memory
        end)
        if record.state == slot_free then
            if first_dead < slots then
                result = (updated: false, slot_index: first_dead,
                          was_dead: true)
            else
                result = (updated: false, slot_index: at, was_dead: false)
            end if
            return
        end if
        if record.state == slot_dead then
            if first_dead == slots then
                first_dead = at
            end if
        elsif record.state == slot_used then
            existing: key = (mem.get(value.keys, record.dense_index)
                else (problem)
                _ = problem
                fail mem.out_of_memory
            end)
            if key.eq(existing, wanted) then
                if not replace_value(value.values, record.dense_index,
                                     replacement)
                then
                    fail mem.out_of_memory
                end if
                result = (updated: true, slot_index: at, was_dead: false)
                return
            end if
        end if
        at = next_index(at, slots)
        inc probed
    end while
    result = (updated: false, slot_index: first_dead,
              was_dead: first_dead < slots)
end search_for_insert

--  The caller has already proved this key absent. Probes are still bounded
--  if no free bucket exists, and the first tombstone wins only after the
--  search has reached a free bucket or exhausted the table.
place_absent: (key: type is hashable, item: type,
               inout value: map(key, item),
               escaping added_key: key, escaping added_value: item)
              -> (placed: bool) =
    slots: usize = capacity(value)
    if slots == 0 then
        placed = false
        return
    end if

    mut at: usize = index_of(added_key, slots)
    mut first_dead: usize = slots
    mut probed: usize = 0
    while probed < slots do
        record: bucket = (mem.get(value.buckets, at) else (problem)
            _ = problem
            placed = false
            return
        end)
        if record.state == slot_dead then
            if first_dead == slots then
                first_dead = at
            end if
        elsif record.state == slot_free then
            if first_dead < slots then
                placed = install_at(value, first_dead, true,
                                    added_key, added_value)
            else
                placed = install_at(value, at, false,
                                    added_key, added_value)
            end if
            return
        end if
        at = next_index(at, slots)
        inc probed
    end while

    if first_dead < slots then
        placed = install_at(value, first_dead, true, added_key, added_value)
    else
        placed = false
    end if
end place_absent

rehash: (key: type is hashable, item: type,
         provider: type is mem.allocator,
         inout value: map(key, item), inout state: provider, want: usize)
        -> none ! mem.out_of_memory =
    fail mem.out_of_memory when want == 0 or want < value.count

    --  Preflight every byte product before the first provider effect.
    bucket_extent: usize = try byte_extent(value: bucket, slots: want)
    key_extent: usize = try byte_extent(value: key, slots: want)
    value_extent: usize = try byte_extent(value: item, slots: want)

    bucket_block: ptr mut u8 = try provider.alloc
        (state, bucket_extent, alignof bucket)
    mut new_buckets := mem.reserve
        (item: bucket, base: bucket_block, slots: want)
    undo discard_storage(new_buckets, state)

    mut initialized: usize = 0
    while initialized < want do
        empty_bucket: bucket =
            (state: slot_free, dense_index: 0,
             previous_used: want, next_used: want)
        admitted: usize = mem.admit
            (new_buckets, empty_bucket)
            else (problem)
            _ = problem
            fail mem.out_of_memory
        end
        _ = admitted
        inc initialized
    end while

    key_block: ptr mut u8 = try provider.alloc
        (state, key_extent, alignof key)
    mut new_keys := mem.reserve(item: key, base: key_block, slots: want)
    undo discard_storage(new_keys, state)

    value_block: ptr mut u8 = try provider.alloc
        (state, value_extent, alignof item)
    mut new_values := mem.reserve(item: item, base: value_block, slots: want)
    undo discard_storage(new_values, state)

    old_slots: usize = capacity(value)
    mut old_at: usize = value.first_used
    mut migrated: usize = 0
    mut new_first: usize = want
    mut new_last: usize = want
    while migrated < value.count do
        fail mem.out_of_memory when old_at >= old_slots
        old_bucket: bucket = (mem.get(value.buckets, old_at) else (problem)
            _ = problem
            fail mem.out_of_memory
        end)
        fail mem.out_of_memory when old_bucket.state <> slot_used
        old_key: key = (mem.get(value.keys, old_bucket.dense_index)
            else (problem)
            _ = problem
            fail mem.out_of_memory
        end)
        mut target: usize = index_of(old_key, want)
        mut searched: usize = 0
        while searched < want do
            target_bucket: bucket = (mem.get(new_buckets, target)
                else (problem)
                _ = problem
                fail mem.out_of_memory
            end)
            break when target_bucket.state == slot_free
            target = next_index(target, want)
            inc searched
        end while
        fail mem.out_of_memory when searched == want

        key_dense: usize = (mem.transfer
            (value.keys, old_bucket.dense_index, new_keys)
            else (problem)
            _ = problem
            fail mem.out_of_memory
        end)
        value_dense: usize = (mem.transfer
            (value.values, old_bucket.dense_index, new_values)
            else (problem)
            _ = problem
            fail mem.out_of_memory
        end)
        fail mem.out_of_memory when key_dense <> value_dense
        moved_bucket: bucket =
            (state: slot_used, dense_index: key_dense,
             previous_used: new_last, next_used: want)
        if not replace_value(new_buckets, target, moved_bucket) then
            fail mem.out_of_memory
        end if
        if new_last < want then
            mut tail: bucket = (mem.get(new_buckets, new_last)
                else (problem)
                _ = problem
                fail mem.out_of_memory
            end)
            tail.next_used = target
            if not replace_value(new_buckets, new_last, tail) then
                fail mem.out_of_memory
            end if
        else
            new_first = target
        end if
        new_last = target
        old_at = old_bucket.next_used
        inc migrated
    end while
    fail mem.out_of_memory when old_at <> old_slots

    --  Migration has succeeded. Everything below is infallible: retire all
    --  three old extents exactly once and publish the replacement last.
    discard_storage(value.values, state)
    discard_storage(value.keys, state)
    discard_storage(value.buckets, state)
    value.buckets = new_buckets
    value.keys = new_keys
    value.values = new_values
    value.count = migrated
    value.tombstones = 0
    value.first_used = new_first
    value.last_used = new_last
end rehash

public insert: (key: type is hashable, item: type,
                provider: type is mem.allocator,
                inout value: map(key, item), inout state: provider,
                escaping added_key: key, escaping added_value: item)
               -> none ! mem.out_of_memory =
    position: insert_search = try search_for_insert
        (value, added_key, added_value)
    return when position.updated

    --  A dead bucket can be reused without extending either dense prefix.
    --  Even at full physical occupancy, the bounded placement probe finds
    --  one. Rebuilding on tombstone pressure would allocate three extents
    --  for every steady-size remove/insert cycle on an arena.
    if value.tombstones == 0 and crowded(value) then
        old_capacity: usize = capacity(value)
        mut want: usize = 8
        if old_capacity > 0 then
            maximum: usize = 0 -% 1
            fail mem.out_of_memory when old_capacity > maximum / 2
            want = old_capacity * 2
        end if
        try rehash(value, state, want)
        inserted: bool = place_absent(value, added_key, added_value)
        fail mem.out_of_memory when not inserted
        return
    end if
    fail mem.out_of_memory when position.slot_index == capacity(value)
    inserted: bool = install_at(value, position.slot_index, position.was_dead,
                                added_key, added_value)
    fail mem.out_of_memory when not inserted
end insert

--  Where a present key lives: its bucket and its dense position.
location: type = struct
    slot: usize
    dense: usize
end location

locate: (key: type is hashable, item: type,
         value: map(key, item), wanted: key)
        -> (found: location) ! missing =
    fail missing when value.count == 0
    slots: usize = capacity(value)
    fail missing when slots == 0
    mut slot: usize = index_of(wanted, slots)
    mut probed: usize = 0
    while probed < slots do
        record: bucket = (mem.get(value.buckets, slot) else (problem)
            _ = problem
            fail missing
        end)
        fail missing when record.state == slot_free
        if record.state == slot_used then
            existing: key = (mem.get(value.keys, record.dense_index)
                else (problem)
                _ = problem
                fail missing
            end)
            if key.eq(existing, wanted) then
                found = (slot: slot, dense: record.dense_index)
                return
            end if
        end if
        slot = next_index(slot, slots)
        inc probed
    end while
    fail missing
end locate

public get: (key: type is hashable, item: type,
             value: map(key, item), wanted: key)
            -> (result: item from value) ! missing =
    found: location = try locate(value, wanted)
    result = mem.get(value.values, found.dense) else (problem)
        _ = problem
        fail missing
    end
end get

--  A writable slot for the present key's item, for in-place update. While
--  the result lives the map binding may not be passed inout or sink
--  [0800]; let it end before the next insert, remove or release.
public at: (key: type is hashable, item: type,
            inout value: map(key, item), wanted: key)
           -> (slot: ptr mut item from value) ! missing =
    found: location = try locate(value, wanted)
    view: []mut item = mem.used(value.values)
    fail missing when found.dense >= lenof view
    slot = addr view[found.dense]
end at

public contains: (key: type is hashable, item: type,
                  value: map(key, item), wanted: key) -> (yes: bool) =
    _ = locate(value, wanted) else (problem)
        _ = problem
        yes = false
        return
    end
    yes = true
end contains

public remove: (key: type is hashable, item: type,
                inout value: map(key, item), wanted: key)
               -> none ! missing =
    fail missing when value.count == 0
    slots: usize = capacity(value)
    fail missing when slots == 0
    mut at: usize = index_of(wanted, slots)
    mut probed: usize = 0
    while probed < slots do
        record: bucket = (mem.get(value.buckets, at) else (problem)
            _ = problem
            fail missing
        end)
        fail missing when record.state == slot_free
        if record.state == slot_used then
            existing: key = (mem.get(value.keys, record.dense_index)
                else (problem)
                _ = problem
                fail missing
            end)
            if key.eq(existing, wanted) then
                if record.previous_used < slots then
                    mut previous: bucket =
                        (mem.get(value.buckets, record.previous_used)
                        else (problem)
                            _ = problem
                            fail missing
                        end)
                    previous.next_used = record.next_used
                    if not replace_value(value.buckets,
                                         record.previous_used, previous)
                    then
                        fail missing
                    end if
                else
                    value.first_used = record.next_used
                end if
                if record.next_used < slots then
                    mut next: bucket =
                        (mem.get(value.buckets, record.next_used)
                        else (problem)
                            _ = problem
                            fail missing
                        end)
                    next.previous_used = record.previous_used
                    if not replace_value(value.buckets, record.next_used,
                                         next)
                    then
                        fail missing
                    end if
                else
                    value.last_used = record.previous_used
                end if
                dead_bucket: bucket =
                    (state: slot_dead, dense_index: record.dense_index,
                     previous_used: slots, next_used: slots)
                if not replace_value(value.buckets, at, dead_bucket) then
                    fail missing
                end if
                dec value.count
                inc value.tombstones
                return
            end if
        end if
        at = next_index(at, slots)
        inc probed
    end while
    fail missing
end remove

public release: (key: type is hashable, item: type,
                 provider: type is mem.allocator,
                 inout value: map(key, item),
                 inout state: provider) -> none =
    discard_storage(value.values, state)
    discard_storage(value.keys, state)
    discard_storage(value.buckets, state)
    value = new(key: key, item: item)
end release

--  Forget every entry but keep the bucket capacity. Every bucket is
--  rewritten free and both dense prefixes are emptied; values in them are
--  discarded, and resources they refer to remain the caller's.
public clear: (key: type is hashable, item: type,
               inout value: map(key, item)) -> none =
    slots: usize = capacity(value)
    mut slot: usize = 0
    while slot < slots do
        free_bucket: bucket = (state: slot_free, dense_index: 0,
                               previous_used: slots, next_used: slots)
        return when not replace_value(value.buckets, slot, free_bucket)
        inc slot
    end while
    mem.clear(value.keys)
    mem.clear(value.values)
    value.count = 0
    value.tombstones = 0
    value.first_used = slots
    value.last_used = slots
end clear

--  Room for `want` entries without a growth allocation: the capacity is
--  doubled from eight until `want` sits below the crowding threshold, and
--  the map is rebuilt once at that size. A map already that large is left
--  alone, including its tombstones.
public reserve: (key: type is hashable, item: type,
                 provider: type is mem.allocator,
                 inout value: map(key, item), inout state: provider,
                 want: usize) -> none ! mem.out_of_memory =
    return when want == 0
    maximum: usize = 0 -% 1
    mut slots: usize = 8
    while want >= crowding_threshold(slots) do
        fail mem.out_of_memory when slots > maximum / 2
        slots = slots * 2
    end while
    return when slots <= capacity(value)
    try rehash(value, state, slots)
end reserve
