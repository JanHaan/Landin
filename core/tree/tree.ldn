import core/mem
import core/vec

identifier: type = distinct usize
public node_id: type = identifier

public id: (ordinal: usize) -> (value: identifier) =
    value = identifier(ordinal)
end id

public ordinal: (value: identifier) -> (number: usize) =
    number = usize(value)
end ordinal
public no_such_node: atom
public invalid_children: atom
public too_many_nodes: atom
public too_many_leaves: atom

node_value: type = struct
    name: utf8
    leaves: usize
    --  Sum of every node's leaf total through this node. Each node has a
    --  target-sized identifier; two words hold every possible cumulative sum.
    through_low: usize
    through_high: usize
    kind: variant
        leaf |
        branch: (first: node_id, count: usize)
    end kind
end node_value
public node: type = node_value

tree_value: type = struct
    nodes: vec.list(node_value)
end tree_value
public tree: type = tree_value

public new: () -> (result: tree_value) =
    result = (nodes: vec.new(item: node_value))
end new

public length: (value: tree_value) -> (count: usize) =
    count = vec.length(value.nodes)
end length

next_id: (count: usize) -> (id: node_id) ! too_many_nodes =
    maximum: usize = 0 -% 1
    fail too_many_nodes when count == maximum
    id = identifier(count)
end next_id

public add_leaf: (provider: type is mem.allocator, inout value: tree_value,
                  inout state: provider, escaping name: utf8)
                 -> (id: node_id) ! mem.out_of_memory | too_many_nodes =
    id = try next_id(length(value))
    mut previous_low: usize = 0
    mut previous_high: usize = 0
    if length(value) > 0 then
        last: node_value = (vec.get(value.nodes, length(value) - 1) else (problem)
            _ = problem
            --  A nonempty list always has its last node.
            fail too_many_nodes
        end)
        previous_low = last.through_low
        previous_high = last.through_high
    end if
    next_low: usize = previous_low +% 1
    if next_low == 0 then inc previous_high end if
    added: node_value = (name: name, leaves: 1, through_low: next_low,
                         through_high: previous_high,
                         kind: leaf)
    try vec.push(value.nodes, state, added)
end add_leaf

--  Edges name only previously published nodes. Their leaf totals are fixed,
--  so their cumulative totals give bounded-stack queries at any depth.
--  Shared children count once for each incoming path, as recursive counting
--  would. An empty child interval has total zero.
public add_branch: (provider: type is mem.allocator, inout value: tree_value,
                    inout state: provider, escaping name: utf8,
                    first: node_id, count: usize)
                   -> (id: node_id)
                   ! mem.out_of_memory | too_many_nodes
                   | invalid_children | too_many_leaves =
    id = try next_id(length(value))
    begins: usize = usize(first)
    amount: usize = usize(count)
    available: usize = length(value)
    fail invalid_children when begins > available
    fail invalid_children when amount > available - begins
    mut before_low: usize = 0
    mut before_high: usize = 0
    if begins > 0 then
        predecessor: node_value = (vec.get(value.nodes, begins - 1) else (problem)
            _ = problem
            fail invalid_children
        end)
        before_low = predecessor.through_low
        before_high = predecessor.through_high
    end if
    mut through_low: usize = 0
    mut through_high: usize = 0
    if available > 0 then
        last: node_value = (vec.get(value.nodes, available - 1) else (problem)
            _ = problem
            fail invalid_children
        end)
        through_low = last.through_low
        through_high = last.through_high
    end if
    mut total: usize = 0
    if amount > 0 then
        end_node: node_value = (vec.get(value.nodes, begins + amount - 1)
            else (problem)
            _ = problem
            fail invalid_children
        end)
        total = end_node.through_low -% before_low
        mut high: usize = end_node.through_high - before_high
        if end_node.through_low < before_low then dec high end if
        fail too_many_leaves when high <> 0
    end if
    next_low: usize = through_low +% total
    if next_low < through_low then inc through_high end if
    added: node_value =
        (name: name, leaves: total, through_low: next_low,
         through_high: through_high,
         kind: branch(first: first, count: count))
    try vec.push(value.nodes, state, added)
end add_branch

public get: (value: tree_value, id: node_id)
            -> (result: node_value from value) ! no_such_node =
    result = vec.get(value.nodes, usize(id)) else (problem)
        _ = problem
        fail no_such_node
    end
end get

public name: (value: node_value) -> (text: utf8 from value) =
    text = value.name
end name

public count_leaves: (value: tree_value, id: node_id)
                     -> (count: usize) ! no_such_node =
    selected: node_value = get(value, id) else (problem)
        _ = problem
        fail no_such_node
    end
    count = selected.leaves
end count_leaves

public release: (provider: type is mem.allocator, inout value: tree_value,
                 inout state: provider) -> none =
    vec.release(value.nodes, state)
end release
