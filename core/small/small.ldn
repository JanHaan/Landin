--  A vector with a private initialized inline prefix. Unused inline slots
--  have no readable item image. The spill descriptor remains empty until
--  the first growth allocation.

import core/mem
import core/vec

public empty: atom

small_value: type (item: type, fixed inline_slots: u32) = struct
    count: usize
    inline_values: [inline_slots]item
    spill: vec.list(item)
    spilled: bool
end small_value

public small: type (item: type is zeroable, fixed inline_slots: u32) = struct
    storage: small_value(item, inline_slots)
end small

public new: (item: type is zeroable, fixed inline_slots: u32)
            -> (value: small(item, inline_slots)) =
    fresh := vec.new_list(item: item)
    value = (storage: (count: 0, inline_values: uninit,
                       spill: fresh, spilled: false))
end new

public length: (item: type is zeroable, fixed inline_slots: u32,
                value: small(item, inline_slots)) -> (count: usize) =
    count = value.storage.count
end length

public capacity: (item: type is zeroable, fixed inline_slots: u32,
                  value: small(item, inline_slots)) -> (count: usize) =
    if value.storage.spilled then
        count = vec.capacity(value.storage.spill)
    else
        count = usize(inline_slots)
    end if
end capacity

first_capacity: (fixed inline_slots: u32)
                -> (count: usize) ! mem.out_of_memory =
    current: usize = usize(inline_slots)
    if current == 0 then
        count = 8
        return
    end if
    maximum: usize = 0 -% 1
    fail mem.out_of_memory when current > maximum / 2
    count = current * 2
end first_capacity

pop_list: (item: type is zeroable, inout values: vec.list(item))
          -> (removed: item from values) ! empty =
    removed = vec.pop(values) else (problem)
        _ = problem
        fail empty
    end
end pop_list

public push: (item: type is zeroable, fixed inline_slots: u32,
              provider: type is mem.allocator,
              inout value: small(item, inline_slots),
              inout state: provider, escaping added: item)
             -> none ! mem.out_of_memory =
    if value.storage.spilled then
        try vec.push(value.storage.spill, state, added)
        inc value.storage.count
        return
    end if
    if value.storage.count < usize(inline_slots) then
        value.storage.inline_values[value.storage.count] = added
        inc value.storage.count
        return
    end if

    wanted: usize = try first_capacity(inline_slots: inline_slots)
    mut fresh := vec.new_list(item: item)
    try vec.reserve(fresh, state, wanted)

    mut at: usize = 0
    while at < value.storage.count do
        --  Only the prefix has an item image. Reserve established room for
        --  every one of these pushes without another allocation.
        try vec.push(fresh, state, value.storage.inline_values[at])
        inc at
    end while
    try vec.push(fresh, state, added)

    value.storage.spill = fresh
    value.storage.spilled = true
    inc value.storage.count
end push

public used: (item: type is zeroable, fixed inline_slots: u32,
              inout value: small(item, inline_slots))
             -> (view: []mut item from value) =
    if value.storage.spilled then
        view = vec.used(value.storage.spill)
    else
        view = value.storage.inline_values[0..<value.storage.count]
    end if
end used

public pop: (item: type is zeroable, fixed inline_slots: u32,
             inout value: small(item, inline_slots))
            -> (removed: item from value) ! empty =
    fail empty when value.storage.count == 0
    if value.storage.spilled then
        removed = try pop_list(value.storage.spill)
        dec value.storage.count
    else
        dec value.storage.count
        removed = value.storage.inline_values[value.storage.count]
    end if
end pop

public release: (item: type is zeroable, fixed inline_slots: u32,
                 provider: type is mem.allocator,
                 inout value: small(item, inline_slots),
                 inout state: provider) -> none =
    if value.storage.spilled then
        vec.release(value.storage.spill, state)
    end if
    value.storage.count = 0
    value.storage.spilled = false
end release
