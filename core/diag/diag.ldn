--  Diagnostics are an ordinary capability.  A producer sees only `log`;
--  callers choose whether notes are retained in bounded storage or written
--  immediately to any io.writer.

import core/io
import core/mem
import core/text

--- Warning severity; recording it does not by itself mark a log as failed.
public warning: atom
--- Error severity; recording it marks the log as failed.
public error: atom
--- Diagnostic severity: `warning` or `error`.
public severity: type = warning | error

--  An array bound folds only literals and fixed formals (D136), so the
--  message array spells `message_capacity` out; keep the two equal.
entry_value: type = struct
    where: usize
    kind: severity
    what_bytes: [256]u8
    what_length: usize
end entry_value

--- Opaque stored diagnostic containing severity, position and a bounded
--- message copy.
public entry: type = entry_value
--- Maximum byte count stored for one bounded diagnostic message. Longer
--- messages are dropped as whole entries.
public message_capacity: usize = 256

--- Diagnostic capability. `note` records severity, position and message;
--- `failed` reports whether an error diagnostic has been observed. I/O
--- failures propagate separately from `note`.
public log: type = concept (logger: type)
    --- Record a diagnostic, copying or consuming the message during the call.
    --- I/O failure is returned separately from error severity.
    note: (self: ptr mut logger, where: text.position, kind: severity,
           what: []u8) -> none ! io.io_failed
    --- Report whether an error diagnostic has been observed.
    failed: (self: ptr logger) -> (yes: bool)
end log

bounded_value: type (fixed capacity: usize) = struct
    notes: [capacity]entry
    stored: usize
    dropped: usize
    errors: usize
end bounded_value

--- Fixed-capacity diagnostic log. Stores entries without allocation, counts
--- messages dropped for capacity or excessive length, and remembers errors even if
--- their entries are dropped.
public bounded: type (fixed capacity: usize) = bounded_value(capacity)

bounded_note: (fixed capacity: usize, self: ptr mut bounded(capacity),
               where: text.position, kind: severity, what: []u8)
              -> none ! io.io_failed =
    if self.val.stored < capacity and lenof what <= message_capacity then
        --  An erased producer may pass frame bytes.  Retain a copy rather
        --  than an address into the producer's storage.
        --  A severity has no zero image, so the entry is built whole.
        mut saved: entry = (where: text.offset(where), kind: kind,
                            what_bytes: zeroed, what_length: lenof what)
        mut index: usize = 0
        while index < lenof what do
            saved.what_bytes[index] = what[index]
            inc index
        end while
        self.val.notes[self.val.stored] = saved
        inc self.val.stored
    else
        inc self.val.dropped
    end if
    if kind == error then
        inc self.val.errors
    end if
end bounded_note

bounded_failed: (fixed capacity: usize, self: ptr bounded(capacity))
                -> (yes: bool) =
    yes = self.val.errors > 0
end bounded_failed

--- Create an empty bounded log with zero stored and dropped counts.
public new: (fixed capacity: usize) -> (result: bounded(capacity)) =
    result = (notes: uninit, stored: 0, dropped: 0, errors: 0)
end new

--- Return the number of retained diagnostic entries. Read-only pointers let
--- both mutable and immutable log owners query without copying the bounded
--- note array.
public length: (fixed capacity: usize, value: ptr bounded(capacity))
               -> (count: usize) =
    count = value.val.stored
end length

--- Return the number of entries not retained because the log was full or the
--- message exceeded `message_capacity`.
public dropped: (fixed capacity: usize, value: ptr bounded(capacity))
                -> (count: usize) =
    count = value.val.dropped
end dropped

--- Copy a retained entry by index. Reports `mem.out_of_bounds` if the index
--- is not stored.
public get: (fixed capacity: usize, value: ptr bounded(capacity), index: usize)
            -> (result: entry) ! mem.out_of_bounds =
    fail mem.out_of_bounds when index >= value.val.stored
    result = value.val.notes[index]
end get

--- Return the caller-supplied source position associated with an entry.
public position_of: (value: entry) -> (where: usize) =
    where = value.where
end position_of

--- Return the severity recorded in an entry.
public severity_of: (value: entry) -> (kind: severity) =
    kind = value.kind
end severity_of

--- Return the number of message bytes retained in an entry.
public message_length: (value: entry) -> (length: usize) =
    length = value.what_length
end message_length

--- Lend the retained message bytes of the entry `value` points at, for as
--- long as the entry stays as it is.
public message: (value: ptr entry) -> (bytes: []u8 from value) =
    bytes = value.val.what_bytes[0..<value.val.what_length]
end message

--- Read one retained message byte. Reports `mem.out_of_bounds` past the
--- message length.
public message_byte: (value: entry, index: usize)
                     -> (byte: u8) ! mem.out_of_bounds =
    fail mem.out_of_bounds when index >= value.what_length
    byte = value.what_bytes[index]
end message_byte

(fixed capacity: usize) bounded_value(capacity) is log
    (note: bounded_note, failed: bounded_failed)

streaming_value: type = struct
    host: any io.writer
    where_to: io.file
    errors: usize
end streaming_value

--- Diagnostic provider holding an erased writer and destination handle. Each
--- note is written as `W:` or `E:`, the position's decimal byte offset, `:`
--- and the message bytes as given, with no terminator; write failures
--- propagate to the caller.
public streaming: type = streaming_value

warning_prefix: [2]u8 = [u8('W'), u8(':')]
error_prefix: [2]u8 = [u8('E'), u8(':')]
separator: [1]u8 = [u8(':')]

write_position: (host: any io.writer, where_to: io.file, value: usize)
                -> none ! io.io_failed =
    --  Twenty bytes hold every decimal digit of a 64-bit usize, so the
    --  writer has room and the provider receives one position slice.
    mut digits: [20]u8 = zeroed
    mut line := text.over(digits[0..<20])
    text.append_usize(line, value) else (problem)
        _ = problem
        compiler.unreachable()
    end
    try host.write(where_to, text.used(line))
end write_position

--- Create a streaming logger over an erased writer and file identifier. The
--- logger holds a copy of both; keep the writer's handle and its state alive
--- while logging. A streaming log needs only a writer: a root holding an
--- `any io.world` builds the writer from the same handle, since the two
--- erased values do not convert.
public stream: (host: any io.writer, where_to: io.file)
               -> (result: streaming from host) =
    result = streaming(host: host, where_to: where_to, errors: 0)
end stream

stream_note: (self: ptr mut streaming, where: text.position,
              kind: severity, what: []u8) -> none ! io.io_failed =
    host: any io.writer = self.val.host
    where_to: io.file = self.val.where_to
    if kind == error then
        inc self.val.errors
        try host.write(where_to, error_prefix[0..<2])
    else
        try host.write(where_to, warning_prefix[0..<2])
    end if

    try write_position(host, where_to, text.offset(where))
    try host.write(where_to, separator[0..<1])
    try host.write(where_to, what)
end stream_note

stream_failed: (self: ptr streaming) -> (yes: bool) =
    yes = self.val.errors > 0
end stream_failed

streaming_value is log (note: stream_note, failed: stream_failed)
