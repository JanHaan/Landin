--  Diagnostics are an ordinary capability.  A producer sees only `log`;
--  callers choose whether notes are retained in bounded storage or written
--  immediately to any io.writer.

import core/io
import core/mem
import core/text

public severity: type = u8
public warning: severity = 0
public error: severity = 1

entry_value: type = struct
    where: usize
    kind: severity
    what_bytes: [256]u8
    what_length: usize
end entry_value

public entry: type = entry_value
public message_capacity: usize = 256

public log: type = concept (logger: type)
    note: (self: ptr mut logger, where: text.position, kind: severity,
           what: []u8) -> none ! io.io_failed
    failed: (self: ptr logger) -> (yes: bool)
end log

bounded_value: type (fixed capacity: usize) = struct
    notes: [capacity]entry
    stored: usize
    dropped: usize
    errors: usize
end bounded_value

public bounded: type (fixed capacity: usize) = bounded_value(capacity)

bounded_note: (fixed capacity: usize, self: ptr mut bounded(capacity),
               where: text.position, kind: severity, what: []u8)
              -> none ! io.io_failed =
    if self.val.stored < capacity and lenof what <= message_capacity then
        --  An erased producer may pass frame bytes.  Retain a copy rather
        --  than an address into the producer's storage.
        mut saved: entry = zeroed
        saved.where = text.ordinal(where)
        saved.kind = kind
        saved.what_length = lenof what
        mut index: usize = 0
        while index < lenof what do
            saved.what_bytes[index] = what[index]
            inc index
        end while
        self.val.notes[self.val.stored] = saved
        inc self.val.stored
    else
        inc self.val.dropped
    end if
    if kind == error then
        inc self.val.errors
    end if
end bounded_note

bounded_failed: (fixed capacity: usize, self: ptr bounded(capacity))
                -> (yes: bool) =
    yes = self.val.errors > 0
end bounded_failed

public new: (fixed capacity: usize) -> (result: bounded(capacity)) =
    result = (notes: uninit, stored: 0, dropped: 0, errors: 0)
end new

--  Read-only pointers let both mutable and immutable log owners query without
--  copying the bounded note array.
public stored: (fixed capacity: usize, value: ptr bounded(capacity))
               -> (count: usize) =
    count = value.val.stored
end stored

public dropped: (fixed capacity: usize, value: ptr bounded(capacity))
                -> (count: usize) =
    count = value.val.dropped
end dropped

public note_at: (fixed capacity: usize, value: ptr bounded(capacity), index: usize)
                -> (result: entry) ! mem.out_of_bounds =
    fail mem.out_of_bounds when index >= value.val.stored
    result = value.val.notes[index]
end note_at

public position_of: (value: entry) -> (where: usize) =
    where = value.where
end position_of

public severity_of: (value: entry) -> (kind: severity) =
    kind = value.kind
end severity_of

public message_length: (value: entry) -> (length: usize) =
    length = value.what_length
end message_length

public message_byte: (value: entry, index: usize)
                     -> (byte: u8) ! mem.out_of_bounds =
    fail mem.out_of_bounds when index >= value.what_length
    byte = value.what_bytes[index]
end message_byte

(fixed capacity: usize) bounded_value(capacity) is log
    (note: bounded_note, failed: bounded_failed)

streaming_value: type = struct
    state: ptr any io.writer
    where_to: ptr io.file
    errors: usize
end streaming_value

public streaming: type = streaming_value

warning_prefix: [2]u8 = [87, 58]
error_prefix: [2]u8 = [69, 58]
separator: [1]u8 = [58]

write_position: (state: any io.writer, where_to: io.file, value: usize)
                -> none ! io.io_failed =
    --  Twenty bytes hold every decimal digit of a 64-bit usize.  Build
    --  backwards so the provider receives exactly one position slice.
    mut digits: [20]u8 = zeroed
    mut start: usize = lenof digits
    mut remaining: usize = value
    loop do
        dec start
        digits[start] = u8(remaining % 10) + 48
        remaining /= 10
        break when remaining == 0
    end loop
    try state.write(where_to, digits[start..<lenof digits])
end write_position

--  A streaming log needs only a writer.  A root holding an `any io.world`
--  builds the writer from the same provider pointer; the two erased values
--  do not convert.
public to: (state: ptr any io.writer, where_to: ptr io.file)
           -> (result: streaming from state, where_to) =
    result = streaming(state: state, where_to: where_to, errors: 0)
end to

stream_note: (self: ptr mut streaming, where: text.position,
              kind: severity, what: []u8) -> none ! io.io_failed =
    state: ptr any io.writer = self.val.state
    where_to: ptr io.file = self.val.where_to
    if kind == error then
        inc self.val.errors
        try state.val.write(where_to.val, error_prefix[0..<2])
    else
        try state.val.write(where_to.val, warning_prefix[0..<2])
    end if

    try write_position(state.val, where_to.val, text.ordinal(where))
    try state.val.write(where_to.val, separator[0..<1])
    try state.val.write(where_to.val, what)
end stream_note

stream_failed: (self: ptr streaming) -> (yes: bool) =
    yes = self.val.errors > 0
end stream_failed

streaming_value is log (note: stream_note, failed: stream_failed)
