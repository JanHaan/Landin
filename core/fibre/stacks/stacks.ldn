--  The switch, and the one provider of turns the library carries over it
--  (D444, D450).  `prepare` and `switch` are for whoever writes a provider
--  that runs fibres on stacks of their own; `round` is one: a round of
--  fixed turns over records the caller keeps, with the wait when nobody
--  can run supplied by whoever builds on it.  It is a module of its own,
--  beneath core/fibre, so that a program that never switches a stack,
--  one over `fibre.whole` or the blocking host, carries no switch and is
--  admitted on every target, the switch's own included or not (D463).
--  Priorities, timers and preemption are not here: an operating system's
--  or an RTOS's scheduler is another provider of the same concepts.

import core/fibre
import core/mem

--  What a prepared stack holds at its top: the record the fibre runs on,
--  the record it resumes when its task has ended, and the task.
starting: type = struct
    record: usize
    after: usize
    work: any fibre.task
end starting

--  The least a prepared stack holds below its `starting`, in words: what
--  `compiler.stack_prepare` lays at its top and the margin it keeps above
--  its base for a failed check (D472), on every target, which is at most
--  976 bytes on a 64-bit one and 432 on a 32-bit one.  A smaller stack
--  is then out of memory here rather than a trap in the builtin.  Every
--  routine checks its own frame against the limit in its prologue
--  (D471), so how deep a task may go is the stack's business, not this
--  module's.
least_prepared_words: usize = 128

--  A fibre's first frame: run the task, mark the record ended, and resume
--  the record the provider named.  Nothing resumes it again.
first_frame: (argument: usize) -> noreturn =
    --  [0810]: the argument is the address of the stack's `starting`.
    start: ptr mut starting = ptr(argument)
    start.val.work.run()
    record: ptr mut fibre.space = ptr(start.val.record)
    after: ptr mut fibre.space = ptr(start.val.after)
    record.val.status = 0
    switch(record, after)
    compiler.unreachable()
end first_frame

--- Lay out a first frame on `stack` that, when a switch resumes `record`,
--- runs `work` to its end, makes the record's status zero and switches to
--- `after`, which the provider keeps unfinished for as long as a fibre
--- can end into it. A routine of the task, or of anything it calls, whose
--- frame would go below the stack's limit traps `stack_exhausted` in its
--- prologue (D451, D471), before it has written there. It fails
--- `mem.out_of_memory` when `stack` is smaller than 128 words and the few
--- words the first frame keeps at its top.
public prepare: (escaping record: ptr mut fibre.space,
                 escaping stack: []mut u8, escaping work: any fibre.task,
                 escaping after: ptr mut fibre.space)
                -> none ! mem.out_of_memory =
    fail mem.out_of_memory when lenof stack == 0
    low: usize = usize(addr stack[0])
    high: usize = low + lenof stack
    extent: usize = sizeof starting
    least: usize = least_prepared_words * sizeof usize
    fail mem.out_of_memory
        when lenof stack < extent + alignof starting + least
    mut place: usize = high - extent
    place -= place % alignof starting
    --  [0810]: the `starting` is the stack's top bytes; the first frame
    --  is laid out below it.
    start: ptr mut starting = ptr(place)
    start.val = (record: usize(record), after: usize(after), work: work)
    record.val.status = 1
    record.val.saved = compiler.stack_prepare(stack[0..<place - low],
                                              first_frame, place)
end prepare

--- Save the callee-saved registers, the frame pointer and the leaving
--- stack's limit on the leaving stack, keep its stack pointer in
--- `leaving`, and resume `entering`, returning when something switches
--- back to `leaving` (D472). A switch is a full compiler memory boundary
--- (D446). Pointers rather than two `inout` records, because both
--- commonly sit in one table.
public switch: (leaving: ptr mut fibre.space, entering: ptr mut fibre.space)
               -> none =
    compiler.stack_switch(addr leaving.val.saved, entering.val.saved)
end switch

--- What a round does when every fibre has yielded since anything last
--- started or ended: wait for something to change. A device waits for an
--- interrupt; an event-driven Io waits for its events; `spin` returns at
--- once.
public idler: type = concept (provider: type)
    --- Wait until something a fibre waits for may have changed.
    idle: (self: provider) -> none
end idler

--- An idler that returns at once, for a round whose fibres yield only
--- while they have work to do, as a test's do. Make one `zeroed`.
public spin: type = struct
    reserved: u32
end spin

spin_idle: (self: spin) -> none =
    _ = self
end spin_idle

spin is idler (idle: spin_idle)

round_state: type = struct
    home: fibre.space
    current: usize
    count: usize
    quiet: usize
    ended: usize
end round_state

--- Caller-owned state of a round: the record of the stack the round was
--- made on, which entry runs, and its counts. Declare it `zeroed` and
--- give it to `round_over`, which fills it; it must outlive the round.
public round_space: type = round_state

round_value: type = struct
    state: ptr mut round_state
    entries: []mut usize
    when_idle: any idler
end round_value

--- A round of fixed turns, as a handle: copies share one round. Entry 0 is
--- the stack the round was made on; the others are the fibres `start`
--- prepared, each the record it was given, in the order they were
--- started. `start` prepares and returns, and the fibre runs at its first
--- turn. `yield` moves to the next unfinished entry after the current
--- one, round the table, and after a whole round in which every
--- unfinished entry yielded and nothing started or ended it calls the
--- idler first. A provider of `fibre.turns`. `yield` and `wait` switch;
--- `start` prepares a fibre and returns, and `finished` only reads.
public round: type = round_value

--- Fill `state` for a round over `entries`, the caller's table of the
--- records it runs, and return its handle. The table holds entry 0 and
--- one entry for each fibre that may be unfinished at once, so a group of
--- `count` stacks needs `count + 1`; `start` fails `mem.out_of_memory`
--- when it is full. It fails `mem.out_of_memory` when `entries` holds
--- fewer than two. Keep `state`, `entries` and `when_idle` alive while the
--- round is used.
public round_over: (inout state: round_space, entries: []mut usize,
                    when_idle: any idler)
                   -> (handle: round from state, entries, when_idle)
                   ! mem.out_of_memory =
    fail mem.out_of_memory when lenof entries < 2
    state = (home: (saved: 0, status: 1), current: 0, count: 1,
             quiet: 0, ended: 0)
    entries[0] = usize(addr state.home)
    handle = (state: addr state, entries: entries, when_idle: when_idle)
end round_over

--  Empty every entry whose fibre has ended since the last sweep, counting
--  each, so a later start may take its place, and say how many entries
--  hold a fibre that has not ended, entry 0, the stack the round was made
--  on and which never ends, among them.  It calls nothing, so that it is
--  the only routine beneath a yield besides the idler and the switch
--  (D571).
sweep: (self: round) -> (live: usize) =
    state: ptr mut round_state = self.state
    live = 1
    mut index: usize = 1
    while index < state.val.count do
        held: usize = self.entries[index]
        if held <> 0 then
            --  [0810]: an entry is the address of a record the round was
            --  given.
            record: ptr mut fibre.space = ptr(held)
            if record.val.status == 0 then
                self.entries[index] = 0
                inc state.val.ended
                state.val.quiet = 0
            else
                inc live
            end if
        end if
        inc index
    end while
end sweep

round_start: (self: round, escaping record: ptr mut fibre.space,
              escaping stack: []mut u8, escaping work: any fibre.task)
             -> none ! mem.out_of_memory =
    state: ptr mut round_state = self.state
    _ = sweep(self)
    mut index: usize = 1
    while index < state.val.count and self.entries[index] <> 0 do
        inc index
    end while
    if index == state.val.count then
        fail mem.out_of_memory when index == lenof self.entries
        inc state.val.count
    end if
    --  [0810]: entry 0 is the address of the round's own record.
    home: ptr mut fibre.space = ptr(self.entries[0])
    try prepare(record, stack, work, home)
    self.entries[index] = usize(record)
    state.val.quiet = 0
end round_start

round_finished: (self: round, record: fibre.space) -> (yes: bool) =
    _ = self
    yes = record.status == 0
end round_finished

--  D571: beneath a yield only `sweep`, which calls nothing, the idler and
--  the switch take the yielding fibre's stack: the search for the next
--  entry that can run is written out here, and the switch is the
--  builtin's own.
round_yield: (self: round) -> none =
    state: ptr mut round_state = self.state
    live: usize = sweep(self)
    inc state.val.quiet
    if state.val.quiet >= live then
        state.val.quiet = 0
        self.when_idle.idle()
    end if
    was: usize = state.val.current
    mut next: usize = was
    loop do
        --  The next entry round the table, with no division, which
        --  Cortex-M0 would call its runtime for.
        inc next
        if next == state.val.count then
            next = 0
        end if
        break when next == was or next == 0
        candidate: usize = self.entries[next]
        if candidate <> 0 then
            waiting: ptr mut fibre.space = ptr(candidate)
            break when waiting.val.status <> 0
        end if
    end loop
    return when next == was
    state.val.current = next
    leaving: ptr mut fibre.space = ptr(self.entries[was])
    entering: ptr mut fibre.space = ptr(self.entries[next])
    compiler.stack_switch(addr leaving.val.saved, entering.val.saved)
    --  Whoever switched back here, a turn or a fibre that ended, this
    --  entry runs again.
    state.val.current = was
end round_yield

round_wait: (self: round) -> none =
    state: ptr mut round_state = self.state
    mut live: usize = sweep(self)
    loop do
        mut others: usize = live - 1
        if state.val.current <> 0 then
            others -= 1
        end if
        break when others == 0
        before: usize = state.val.ended
        round_yield(self)
        live = sweep(self)
        break when state.val.ended <> before
    end loop
end round_wait

round_value is fibre.scheduler (start: round_start, finished: round_finished,
                                wait: round_wait)
round_value is fibre.turns (yield: round_yield)
