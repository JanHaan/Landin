--  Generic deterministic failure injection.  The handle holds a copy of the
--  supplied provider's handle and delegates every successful free.

import core/mem

counters: type = struct
    remaining: usize
    attempts: usize
    delegated: usize
    successes: usize
    injected_failures: usize
    inner_failures: usize
    frees: usize
    live: usize
    growths: usize
end counters

--- Caller-owned state of an injector: its budget and cumulative counters.
--- Declare it `zeroed` and give it to `over`, which fills it; it must outlive
--- the injector handle.
public space: type = counters

injector_value: type (inner_provider: type) = struct
    state: ptr mut counters
    inner: inner_provider
end injector_value

--- Allocator wrapper with deterministic failure injection and cumulative
--- counters, as a handle: copies share one budget. Holds a copy of its inner
--- provider's handle and delegates permitted allocations, resizes,
--- in-place growths and frees.
public injector: type (inner_provider: type) = injector_value(inner_provider)

--- Fill `state` for an injector over `inner` with a budget of
--- `allowed_attempts` allocation and resize calls that may reach it, and
--- return its handle. An inner failure consumes one of them too; an injected
--- failure never calls the inner provider and counts only in `attempts` and
--- `injected_failures`.
public over: (inner_provider: type is mem.allocator, inout state: space,
              inner: inner_provider, allowed_attempts: usize)
             -> (handle: injector(inner_provider) from state, inner) =
    state = (remaining: allowed_attempts,
             attempts: 0, delegated: 0, successes: 0,
             injected_failures: 0, inner_failures: 0,
             frees: 0, live: 0, growths: 0)
    handle = (state: addr state, inner: inner)
end over

--- Replace the future delegation budget without resetting the counters, so
--- failed and successful calls stay distinguishable across retries.
public permit: (inner_provider: type, memory: injector(inner_provider),
                allowed_attempts: usize) -> none =
    memory.state.val.remaining = allowed_attempts
end permit

injector_alloc: (inner_provider: type is mem.allocator,
                 self: injector(inner_provider),
                 size: usize, alignment: usize)
                -> (block: ptr mut u8) ! mem.out_of_memory =
    state: ptr mut counters = self.state
    inc state.val.attempts
    if state.val.remaining == 0 then
        inc state.val.injected_failures
        fail mem.out_of_memory
    end if

    dec state.val.remaining
    inc state.val.delegated
    block = mem.allocate(self.inner, size, alignment)
        else (problem)
        _ = problem
        inc state.val.inner_failures
        fail mem.out_of_memory
    end
    inc state.val.successes
    inc state.val.live
end injector_alloc

injector_free: (inner_provider: type is mem.allocator,
                self: injector(inner_provider),
                block: ptr mut u8, size: usize) -> none =
    mem.free(self.inner, block, size)
    --  Allocator free has no result. These two counters are therefore exact
    --  under the allocator contract: the caller frees each successful block
    --  once with its original extent. A malformed or duplicate free is still
    --  delegated, but an inner rejection cannot be reflected in live.
    state: ptr mut counters = self.state
    inc state.val.frees
    if state.val.live > 0 then
        dec state.val.live
    end if
end injector_free

--  Growing in place is an attempt as an allocation is: it spends the
--  budget, may be refused without reaching the inner provider, and is
--  otherwise delegated, so a container tested through an injector takes
--  the in-place path its provider offers (D356).  A refusal of either kind
--  leaves the block as it was, and the container moves it instead.
injector_grow: (inner_provider: type is mem.allocator,
                self: injector(inner_provider), block: ptr mut u8,
                old_size: usize, new_size: usize, alignment: usize)
               -> (grown: bool) =
    state: ptr mut counters = self.state
    inc state.val.attempts
    grown = false
    if state.val.remaining == 0 then
        inc state.val.injected_failures
        return
    end if
    dec state.val.remaining
    inc state.val.delegated
    grown = mem.grow(self.inner, block, old_size, new_size, alignment)
    if grown then
        inc state.val.growths
    else
        inc state.val.inner_failures
    end if
end injector_grow

--  A resize may allocate, so it is an attempt as an allocation is: it spends
--  the budget, may be refused without reaching the inner provider, and is
--  otherwise delegated.  The block it returns replaces the one it was given,
--  so the live count does not change.
injector_resize: (inner_provider: type is mem.allocator,
                  self: injector(inner_provider), block: ptr mut u8,
                  old_size: usize, new_size: usize, alignment: usize)
                 -> (moved: ptr mut u8) ! mem.out_of_memory =
    state: ptr mut counters = self.state
    inc state.val.attempts
    if state.val.remaining == 0 then
        inc state.val.injected_failures
        fail mem.out_of_memory
    end if

    dec state.val.remaining
    inc state.val.delegated
    moved = mem.resize(self.inner, block, old_size, new_size, alignment)
        else (problem)
        _ = problem
        inc state.val.inner_failures
        fail mem.out_of_memory
    end
    inc state.val.successes
end injector_resize

(inner_provider: type is mem.allocator) injector_value(inner_provider)
    is mem.allocator (alloc: injector_alloc, grow: injector_grow,
                      resize: injector_resize, free: injector_free)

--- Return how many allocation attempts may still reach the inner provider.
public remaining: (inner_provider: type,
                   memory: injector(inner_provider)) -> (count: usize) =
    count = memory.state.val.remaining
end remaining

--- Return all allocation attempts, including injected and inner failures.
public attempts: (inner_provider: type,
                  memory: injector(inner_provider)) -> (count: usize) =
    count = memory.state.val.attempts
end attempts

--- Return allocation attempts passed through to the inner provider.
public delegated: (inner_provider: type,
                   memory: injector(inner_provider)) -> (count: usize) =
    count = memory.state.val.delegated
end delegated

--- Return the number of blocks a delegated allocation or resize gave; a
--- growth in place gives none and is counted by `growths`.
public successes: (inner_provider: type,
                   memory: injector(inner_provider)) -> (count: usize) =
    count = memory.state.val.successes
end successes

--- Return attempts rejected by the wrapper before calling the inner provider.
public injected_failures: (inner_provider: type,
                           memory: injector(inner_provider))
                          -> (count: usize) =
    count = memory.state.val.injected_failures
end injected_failures

--- Return allocation failures reported by the inner provider.
public inner_failures: (inner_provider: type,
                        memory: injector(inner_provider)) -> (count: usize) =
    count = memory.state.val.inner_failures
end inner_failures

--- Return the number of blocks the inner provider grew where they are.
public growths: (inner_provider: type,
                 memory: injector(inner_provider)) -> (count: usize) =
    count = memory.state.val.growths
end growths

--- Return the number of delegated free calls.
public frees: (inner_provider: type,
               memory: injector(inner_provider)) -> (count: usize) =
    count = memory.state.val.frees
end frees

--- Return successful allocations minus free calls, bounded below by zero.
--- Exact under the allocator contract; malformed or duplicate frees are not
--- validated here.
public live: (inner_provider: type,
              memory: injector(inner_provider)) -> (count: usize) =
    --  Successful allocations less delegated frees under valid-free use.
    count = memory.state.val.live
end live
