--  Generic deterministic failure injection.  The wrapper retains a mutable
--  pointer to its supplied provider and delegates every successful free.

import core/mem

--- Allocator wrapper with deterministic failure injection and cumulative
--- counters. Borrows its inner provider, delegates permitted allocations and
--- frees, and refuses in-place growth.
public injector: type (inner_provider: type) = struct
    inner: ptr mut inner_provider
    remaining: usize
    attempts: usize
    delegated: usize
    successes: usize
    injected_failures: usize
    inner_failures: usize
    frees: usize
    live: usize
end injector

--- Wrap an allocator with a budget of `allowed_attempts` allocation calls
--- that may reach it. An inner failure consumes one of them too; an injected
--- failure never calls the inner provider and counts only in `attempts` and
--- `injected_failures`.
public new: (inner_provider: type is mem.allocator,
             inner: ptr mut inner_provider,
             allowed_attempts: usize)
            -> (state: injector(inner_provider) from inner) =
    state = (inner: inner, remaining: allowed_attempts,
             attempts: 0, delegated: 0, successes: 0,
             injected_failures: 0, inner_failures: 0,
             frees: 0, live: 0)
end new

--- Replace the future delegation budget without resetting the counters, so
--- failed and successful calls stay distinguishable across retries.
public permit: (inner_provider: type,
                inout state: injector(inner_provider),
                allowed_attempts: usize) -> none =
    state.remaining = allowed_attempts
end permit

injector_alloc: (inner_provider: type,
                 inout state: injector(inner_provider),
                 size: usize, alignment: usize)
                -> (block: ptr mut u8) ! mem.out_of_memory =
    inc state.attempts
    if state.remaining == 0 then
        inc state.injected_failures
        fail mem.out_of_memory
    end if

    dec state.remaining
    inc state.delegated
    block = mem.allocate(state.inner.val, size, alignment)
        else (problem)
        _ = problem
        inc state.inner_failures
        fail mem.out_of_memory
    end
    inc state.successes
    inc state.live
end injector_alloc

injector_free: (inner_provider: type,
                inout state: injector(inner_provider),
                block: ptr mut u8, size: usize) -> none =
    mem.free(state.inner.val, block, size)
    --  Allocator free has no result. These two counters are therefore exact
    --  under the allocator contract: the caller frees each successful block
    --  once with its original extent. A malformed or duplicate free is still
    --  delegated, but an inner rejection cannot be reflected in live.
    inc state.frees
    if state.live > 0 then
        dec state.live
    end if
end injector_free

injector_grow: (inner_provider: type,
                inout state: injector(inner_provider), block: ptr mut u8,
                old_size: usize, new_size: usize, alignment: usize)
               -> (grown: bool) =
    _ = state.live
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end injector_grow

(inner_provider: type is mem.allocator) injector(inner_provider)
    is mem.allocator (alloc: injector_alloc, grow: injector_grow,
                      free: injector_free)

--- Return how many allocation attempts may still reach the inner provider.
public remaining: (inner_provider: type,
                   state: injector(inner_provider)) -> (count: usize) =
    count = state.remaining
end remaining

--- Return all allocation attempts, including injected and inner failures.
public attempts: (inner_provider: type,
                  state: injector(inner_provider)) -> (count: usize) =
    count = state.attempts
end attempts

--- Return allocation attempts passed through to the inner provider.
public delegated: (inner_provider: type,
                   state: injector(inner_provider)) -> (count: usize) =
    count = state.delegated
end delegated

--- Return the number of successful delegated allocations.
public successes: (inner_provider: type,
                   state: injector(inner_provider)) -> (count: usize) =
    count = state.successes
end successes

--- Return attempts rejected by the wrapper before calling the inner provider.
public injected_failures: (inner_provider: type,
                           state: injector(inner_provider))
                          -> (count: usize) =
    count = state.injected_failures
end injected_failures

--- Return allocation failures reported by the inner provider.
public inner_failures: (inner_provider: type,
                        state: injector(inner_provider)) -> (count: usize) =
    count = state.inner_failures
end inner_failures

--- Return the number of delegated free calls.
public frees: (inner_provider: type,
               state: injector(inner_provider)) -> (count: usize) =
    count = state.frees
end frees

--- Return successful allocations minus free calls, bounded below by zero.
--- Exact under the allocator contract; malformed or duplicate frees are not
--- validated here.
public live: (inner_provider: type,
              state: injector(inner_provider)) -> (count: usize) =
    --  Successful allocations less delegated frees under valid-free use.
    count = state.live
end live
