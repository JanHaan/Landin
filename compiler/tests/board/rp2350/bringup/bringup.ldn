-- Bringing the Pico 2's RP2350 up from what its boot ROM leaves when it
-- enters the image: the system clock on the ring oscillator, the
-- peripherals the image uses in reset, and the bank 0 pads isolated.  This
-- moves the reference and system clocks to the 12 MHz crystal, gives UART0
-- the system clock, makes TIMER0's 1 MHz tick from the reference clock,
-- takes UART0, DMA, TIMER0 and bank 0's pins and pads out of reset, holds
-- USBCTRL in it, and enables the pads it uses, clearing their isolation
-- latches (D654).  Values are the RP2350 datasheet's (release 8) and
-- pico-sdk 2.2.0's headers'.  Both of the Pico 2's ports use it: nothing it
-- touches differs between the two kinds of core (D831).
import rp2350/clocks
import rp2350/io_bank0
import rp2350/pads_bank0
import rp2350/resets
import rp2350/sio
import rp2350/ticks
import rp2350/xosc

-- RESETS bits (resets.h): UART0 26, TIMER0 23, PADS_BANK0 9, IO_BANK0 6,
-- DMA 2; and USBCTRL 28, held, so that nothing but the NVIC raises its
-- interrupt (D596).
public taken: u32 = 0x04800244
held_usb: u32 = 0x10000000
-- The indicator, GPIO3, which bank 0 gives to SIO as function 5.
public indicator: u32 = 8

public crystal: () -> none =
    -- STARTUP.DELAY counts 256 cycles: (12 MHz / 1000 + 128) / 256 = 47,
    -- one millisecond.  CTRL: ENABLE 0xfab, FREQ_RANGE 0xaa0 (1-15 MHz).
    xosc.startup_write(xosc.base, 47)
    xosc.ctrl_write(xosc.base, (0xfab << 12) | 0xaa0)
    while (xosc.status_read(xosc.base) & 0x80000000) == 0 do
        continue
    end while
    -- clk_ref's SRC 2 is the crystal; the switch is glitchless, so wait
    -- until CLK_REF_SELECTED says source 2.
    clocks.clk_ref_ctrl_write(clocks.base, 2)
    while clocks.clk_ref_selected_read(clocks.base) <> 4 do
        continue
    end while
    -- clk_sys's SRC 0 is clk_ref.
    clocks.clk_sys_ctrl_write(clocks.base, 0)
    while clocks.clk_sys_selected_read(clocks.base) <> 1 do
        continue
    end while
    -- clk_peri: ENABLE, bit 11, with AUXSRC 0, clk_sys.
    clocks.clk_peri_ctrl_write(clocks.base, 0x800)
    -- TIMER0's tick (8.5, Tick generators): 12 reference cycles a
    -- microsecond, then ENABLE.
    ticks.timer0_cycles_write(ticks.base, 12)
    ticks.timer0_ctrl_write(ticks.base, 1)
end crystal

public peripherals: () -> none =
    held := resets.reset_read(resets.base)
    resets.reset_write(resets.base, (held | held_usb) & ~taken)
    while (resets.reset_done_read(resets.base) & taken) <> taken do
        continue
    end while
    -- Bank 0's pads reset isolated, with their inputs off (9.3, Reset
    -- state): ISO, bit 8, is cleared and IE, bit 6, set on each pad used.
    -- GPIO1 receives, pulled up so an idle line reads high: IE 6, DRIVE
    -- 5:4 = 1, PUE 3, SCHMITT 1.  GPIO0 transmits and GPIO3 is the
    -- indicator, whose input reads it back: IE, DRIVE = 1, SCHMITT.
    pads_bank0.gpio1_write(pads_bank0.base, 0x5a)
    pads_bank0.gpio0_write(pads_bank0.base, 0x52)
    pads_bank0.gpio3_write(pads_bank0.base, 0x52)
    -- The indicator pin to SIO and driven.
    pin := io_bank0.gpio3_ctrl_read(io_bank0.base)
    io_bank0.gpio3_ctrl_write(io_bank0.base, (pin & 0xffffffe0) | 5)
    sio.gpio_oe_set_write(sio.base, indicator)
end peripherals
