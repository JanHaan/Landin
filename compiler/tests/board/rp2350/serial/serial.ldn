-- The prototype-1 receive contract on the Pico 2's RP2350: UART0 on GPIO0
-- and GPIO1 received into a ring by DMA channel 0.  Its public interface
-- and its atoms are the synthetic driver's (compiler/tests/driver) and the
-- RP2040 board's, and its device protocol is the RP2040 board's (D594)
-- with the RP2350's own channel (D654).  A snapshot reads the count live,
-- its premise the RP2040's: a write lands before the byte is copied out.
-- TRANS_COUNT carries a MODE in bits 31:28, zero for a normal count, so the
-- count is its low 28 bits.  CTRL_TRIG keeps its errors in 31:29 and BUSY
-- in 26.  Stop follows the RP2350's abort sequence (12.6.8.3, Channel
-- abort, which accounts for RP2350-E5): EN cleared first, with CHAIN_TO the
-- channel itself, then CHAN_ABORT written and polled until it clears and
-- BUSY falls; the interrupt is disabled first and cleared after, as on the
-- RP2040.  While the channel is stopped or exhausted the UART's 32-byte
-- FIFO holds what arrives; a byte past that is lost, which the UART flags
-- as an overrun (UARTRIS's OERIS, bit 10) and a snapshot reports as one,
-- so no byte is lost unreported.
import platform/cortex_m
import rp2350/dma
import rp2350/io_bank0
import rp2350/uart0

public busy: atom
public bad_baud: atom
public buffer_empty: atom
public buffer_too_big: atom
public bad_buffer: atom
public overrun: atom
public transfer_error: atom
public exhausted: atom
public stop_timeout: atom
public receive_error: type = overrun | transfer_error | exhausted | stop_timeout

public rx: type = struct
    buf: []u8
    consumed: u32
    budget: u32
    -- What the last snapshot counted, kept when the channel is aborted.
    produced: u32
    config: u32
    active: bool
    lost: bool
    broken: bool
end rx

-- CTRL_TRIG (12.6.10): AHB_ERROR 31, READ_ERROR 30, WRITE_ERROR 29,
-- BUSY 26, EN 0.  TRANS_COUNT's COUNT, bits 27:0.
errors: u32 = 0xe0000000
busy_bit: u32 = 0x04000000
count_bits: u32 = 0x0fffffff
-- UARTRIS and UARTICR: OERIS and OEIC, the receive FIFO's overrun.
uart_overrun: u32 = 0x400

public open: (rate: u32, budget: u32, escaping buf: []mut u8)
             -> (r: rx from buf) ! busy | bad_baud | buffer_empty | buffer_too_big | bad_buffer =
    size := lenof buf
    fail buffer_empty when size == 0
    fail buffer_too_big when size > 256
    fail bad_buffer when size < 2 or (size & (size - 1)) <> 0
    fail bad_buffer when (usize(addr buf[0]) & (size - 1)) <> 0
    fail bad_buffer when budget < u32(size) or budget > 65535
    fail bad_baud when rate <> 115200
    status := dma.ch0_ctrl_trig_read(dma.base)
    fail busy when (status & (errors | busy_bit | 1)) <> 0
    -- FUNCSEL 2 is UART0 on both pins; the override bits are kept.
    tx := io_bank0.gpio0_ctrl_read(io_bank0.base)
    io_bank0.gpio0_ctrl_write(io_bank0.base, (tx & 0xffffffe0) | 2)
    pin := io_bank0.gpio1_ctrl_read(io_bank0.base)
    io_bank0.gpio1_ctrl_write(io_bank0.base, (pin & 0xffffffe0) | 2)
    -- 12 MHz / (16 * 115200) = 6.51: IBRD 6, FBRD 33, as pico-sdk rounds
    -- it.  LCR_H, written after both to latch them: WLEN 8 bits, FIFOs.
    uart0.uartibrd_write(uart0.base, 6)
    uart0.uartfbrd_write(uart0.base, 33)
    uart0.uartlcr_h_write(uart0.base, 0x70)
    -- CR: UARTEN 0, TXE 8, RXE 9.  DMACR: RXDMAE.
    uart0.uartcr_write(uart0.base, 0x301)
    uart0.uartdmacr_write(uart0.base, 1)
    uart0.uarticr_write(uart0.base, uart_overrun)
    mut bits: u8 = 0
    mut extent := size
    while extent > 1 do
        extent = extent >> 1
        bits = bits +% 1
    end while
    -- Byte transfers, DATA_SIZE 0; INCR_WRITE, bit 6, in a ring of 2^bits
    -- bytes, RING_SIZE 11:8 with RING_SEL, bit 12, the write address;
    -- chained to itself, CHAIN_TO 0, no chain; paced by TREQ_SEL 22:17 =
    -- 29, UART0_RX (dma.h).
    image: u32 = 0x003a1040 | (u32(bits) << 8)
    dma.ch0_ctrl_trig_write(dma.base, image)
    dma.ch0_read_addr_write(dma.base, u32(uart0.base))
    dma.ch0_write_addr_write(dma.base, u32(usize(addr buf[0])))
    dma.ch0_trans_count_write(dma.base, budget)
    dma.intr_write(dma.base, 1)
    dma.inte0_write(dma.base, 1)
    cortex_m.device_barrier()
    dma.ch0_ctrl_trig_write(dma.base, image | 1)
    r = (buf: buf, consumed: 0, budget: budget, produced: 0, config: image,
         active: true, lost: false, broken: false)
end open

-- Count never reloads in an epoch. Failure latches until an explicit
-- restart; a stopped descriptor answers from what its last snapshot saw.
snapshot: (inout r: rx) -> (count: usize) ! overrun | transfer_error | exhausted =
    if r.active then
        status := dma.ch0_ctrl_trig_read(dma.base)
        remaining := dma.ch0_trans_count_read(dma.base) & count_bits
        cortex_m.device_barrier()
        if (status & errors) <> 0 or remaining > r.budget then
            r.broken = true
        end if
        fail transfer_error when r.broken
        r.produced = r.budget -% remaining
        if remaining == 0 then r.active = false end if
    end if
    if r.produced < r.consumed then r.broken = true end if
    fail transfer_error when r.broken
    have := r.produced -% r.consumed
    capacity := lenof r.buf
    if (uart0.uartris_read(uart0.base) & uart_overrun) <> 0 then
        r.lost = true
        r.consumed = r.produced
    end if
    if have > u32(capacity) then
        r.lost = true
        r.consumed = r.produced
    end if
    fail overrun when r.lost
    fail exhausted when r.produced == r.budget and have == 0
    count = usize(have)
end snapshot

public available: (inout r: rx) -> (count: usize) ! receive_error =
    count = try snapshot(r)
end available

public read: (inout r: rx, out_buf: []mut u8) -> (count: usize) ! receive_error =
    have := try snapshot(r)
    count = have
    if lenof out_buf < count then count = lenof out_buf end if
    backing := r.buf
    capacity := lenof backing
    -- snapshot bounds count by both initialized extents; consumed <= 65535,
    -- i < 256 and capacity is a nonzero power of two. No arithmetic wraps.
    unchecked begin
        for i in 0..<count do
            out_buf[i] = backing[(usize(r.consumed) + i) & (capacity - 1)]
        end for
    end unchecked
    r.consumed = r.consumed +% u32(count)
end read

-- After the abort CHAN_ABORT's bit and BUSY fall once the transfers in
-- flight complete, which the datasheet says generally takes a few cycles;
-- 1000 polls bound it.
public stop: (inout r: rx) -> none ! stop_timeout =
    if r.active then
        remaining := dma.ch0_trans_count_read(dma.base) & count_bits
        if remaining <= r.budget then r.produced = r.budget -% remaining end if
    end if
    r.active = false
    dma.inte0_write(dma.base, 0)
    -- EN clear pauses the channel; a write with EN clear triggers nothing.
    dma.ch0_ctrl_trig_write(dma.base, r.config)
    dma.chan_abort_write(dma.base, 1)
    mut attempts: u32 = 0
    while (dma.chan_abort_read(dma.base) & 1) <> 0
      or (dma.ch0_ctrl_trig_read(dma.base) & busy_bit) <> 0
    do
        attempts += 1
        fail stop_timeout when attempts == 1000
    end while
    dma.intr_write(dma.base, 1)
    cortex_m.device_barrier()
end stop

-- Discards unread bytes deliberately; may be called after error or exhaustion.
public restart: (inout r: rx) -> none ! stop_timeout | transfer_error =
    try stop(r)
    status := dma.ch0_ctrl_trig_read(dma.base)
    fail transfer_error when (status & errors) <> 0
    dma.ch0_write_addr_write(dma.base, u32(usize(addr r.buf[0])))
    dma.ch0_trans_count_write(dma.base, r.budget)
    dma.intr_write(dma.base, 1)
    dma.inte0_write(dma.base, 1)
    uart0.uarticr_write(uart0.base, uart_overrun)
    r.consumed = 0
    r.produced = 0
    r.lost = false
    r.broken = false
    r.active = true
    cortex_m.device_barrier()
    dma.ch0_ctrl_trig_write(dma.base, r.config | 1)
end restart
