-- UART0's FIFO interrupt feeds the bounded ring. CPU line 1 is a
-- level-one interrupt. The ring reports lost bytes and FIFO overrun;
-- masking or stopping reception does not stop bytes arriving at the UART.
-- This implements the shared commands scenario without claiming DMA.
import core/atomic
import esp32s3/interrupt_core0
import esp32s3/uart0
import platform/xtensa

public busy: atom
public bad_baud: atom
public buffer_empty: atom
public buffer_too_big: atom
public bad_buffer: atom
public overrun: atom
public transfer_error: atom
public exhausted: atom
public stop_timeout: atom
public receive_error: type = overrun | transfer_error | exhausted | stop_timeout

public rx: type = struct
    buf: []u8
    consumed: u32
    -- The loss counts the last restart accepted.
    dropped_seen: u32
    overflows_seen: u32
    active: bool
    lost: bool
end rx

public line: u32 = 1
public priority: u32 = 1
full_bit: u32 = 0x01
overflow_bit: u32 = 0x10
timeout_bit: u32 = 0x100
receive_bits: u32 = 0x111
rxfifo_reset: u32 = 0x20000

mut produced: atomic.cell(u32) = zeroed
mut taken: atomic.cell(u32) = zeroed
mut dropped: atomic.cell(u32) = zeroed
mut overflows: atomic.cell(u32) = zeroed
mut entries: atomic.cell(u32) = zeroed

public bytes_dropped: () -> (count: u32) = count = atomic.load(addr dropped) end bytes_dropped
public fifo_overflows: () -> (count: u32) = count = atomic.load(addr overflows) end fifo_overflows
public interrupts: () -> (count: u32) = count = atomic.load(addr entries) end interrupts

-- Clear notification before draining the FIFO so arrivals during draining
-- can raise the interrupt again. On overflow, discard invalid FIFO contents.
public receive: (ring: []mut u8) -> none =
    status := uart0.int_st_read(uart0.base)
    uart0.int_clr_write(uart0.base, status & receive_bits)
    _ = atomic.sole_add(addr entries, 1)
    if (status & overflow_bit) <> 0 then
        -- After an overflow the RX FIFO's contents are not the bytes that
        -- arrived, so they are discarded with the FIFO reset rather than
        -- drained, as ESP-IDF's UART driver does on RXFIFO_OVF; the
        -- overflow is counted, and the program restarts on it.
        _ = atomic.sole_add(addr overflows, 1)
        conf0 := uart0.conf0_read(uart0.base)
        uart0.conf0_write(uart0.base, conf0 | rxfifo_reset)
        uart0.conf0_write(uart0.base, conf0 & ~rxfifo_reset)
        return
    end if
    size := u32(lenof ring)
    mut p := atomic.load_relaxed(addr produced)
    limit := atomic.load(addr taken) +% size
    mut lost: u32 = 0
    -- Read the bounded FIFO occupancy.
    mut count := uart0.status_read(uart0.base) & 0x3ff
    while count > 0 do
        byte := u8(uart0.fifo_read(uart0.base) & 0xff)
        if p <> limit then
            ring[usize(p & (size - 1))] = byte
            p = p +% 1
        else
            lost = lost +% 1
        end if
        count -= 1
    end while
    atomic.store(addr produced, p)
    if lost <> 0 then _ = atomic.sole_add(addr dropped, lost) end if
end receive

public open: (rate: u32, budget: u32, escaping buf: []mut u8)
             -> (r: rx from buf) ! busy | bad_baud | buffer_empty | buffer_too_big | bad_buffer =
    size := lenof buf
    fail buffer_empty when size == 0
    fail buffer_too_big when size > 256
    fail bad_buffer when size < 2 or (size & (size - 1)) <> 0
    fail bad_buffer when budget < u32(size) or budget > 65535
    -- Bringup configures UART0 at 115200 baud on its board pins.
    fail bad_baud when rate <> 115200
    -- The line is the receiver's alone: one already enabled is busy.
    fail busy when (xtensa.enabled_lines() & (1 << line)) <> 0
    -- The pinned UART header defines this chip's threshold/timeout bits.
    conf1 := uart0.conf1_read(uart0.base)
    uart0.conf1_write(uart0.base, (conf1 & 0xfffffc00) | 0x00800001)
    -- Whatever the RX FIFO held from before is discarded.
    conf0 := uart0.conf0_read(uart0.base)
    uart0.conf0_write(uart0.base, conf0 | rxfifo_reset)
    uart0.conf0_write(uart0.base, conf0 & ~rxfifo_reset)
    uart0.int_clr_write(uart0.base, 0x111)
    atomic.store(addr produced, 0)
    atomic.store(addr taken, 0)
    -- Route UART0 to the level-one CPU interrupt line.
    saved := xtensa.disable_interrupts()
    interrupt_core0.uart_intr_map_write(interrupt_core0.base, line)
    xtensa.set_enabled_lines(xtensa.enabled_lines() | (1 << line))
    uart0.int_ena_write(uart0.base, receive_bits)
    xtensa.device_barrier()
    xtensa.restore_interrupts(saved)
    r = (buf: buf, consumed: 0, dropped_seen: atomic.load(addr dropped),
         overflows_seen: atomic.load(addr overflows), active: true, lost: false)
end open

snapshot: (inout r: rx) -> (count: usize) ! overrun =
    have := atomic.load(addr produced) -% r.consumed
    if atomic.load(addr dropped) <> r.dropped_seen
      or atomic.load(addr overflows) <> r.overflows_seen
      or have > u32(lenof r.buf)
    then
        r.lost = true
    end if
    fail overrun when r.lost
    count = usize(have)
end snapshot

public available: (inout r: rx) -> (count: usize) ! receive_error =
    count = try snapshot(r)
end available

public read: (inout r: rx, out_buf: []mut u8) -> (count: usize) ! receive_error =
    have := try snapshot(r)
    count = have
    if lenof out_buf < count then count = lenof out_buf end if
    backing := r.buf
    capacity := lenof backing
    -- snapshot bounds count by the ring; capacity is a nonzero power of
    -- two and i < 256. No arithmetic wraps.
    unchecked begin
        for i in 0..<count do
            out_buf[i] = backing[(usize(r.consumed) + i) & (capacity - 1)]
        end for
    end unchecked
    r.consumed = r.consumed +% u32(count)
    atomic.store(addr taken, r.consumed)
end read

-- Receiving stops when UART0 no longer raises its interrupt; bytes keep
-- arriving in the FIFO, which holds 128 and flags the rest lost.
public stop: (inout r: rx) -> none ! stop_timeout =
    r.active = false
    uart0.int_ena_write(uart0.base, 0)
    xtensa.device_barrier()
end stop

-- Discards unread bytes deliberately; may be called after an overrun.
public restart: (inout r: rx) -> none ! stop_timeout | transfer_error =
    try stop(r)
    saved := xtensa.disable_interrupts()
    r.consumed = atomic.load(addr produced)
    atomic.store(addr taken, r.consumed)
    r.dropped_seen = atomic.load(addr dropped)
    r.overflows_seen = atomic.load(addr overflows)
    r.lost = false
    r.active = true
    uart0.int_ena_write(uart0.base, receive_bits)
    xtensa.device_barrier()
    xtensa.restore_interrupts(saved)
end restart
