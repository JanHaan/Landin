-- The prototype-1 receive contract on the Pico's RP2040: UART0 on GPIO0
-- and GPIO1 received into a ring by DMA channel 0.  Its public interface
-- and its atoms are the synthetic driver's (compiler/tests/driver), and
-- its device protocol is the RP2040's own, which differs in two places.
-- A snapshot does not pause the channel: on the RP2040 a paused channel
-- reports no completion of its in-flight writes, and triggering it again
-- reloads its count, so the count is read live.  The count drops when a
-- transfer is issued, before its write lands; this driver's premise is
-- that the write lands before the byte is copied out, a bus latency of a
-- few cycles against the hundreds a snapshot and its copy take.  And stop
-- aborts the channel, which RP2040-E13 says may raise a completion
-- interrupt, so the interrupt is disabled first and cleared after BUSY
-- falls.  Bytes received after the last snapshot before a stop are
-- discarded with the epoch.  While the channel is stopped or exhausted the
-- UART's 32-byte FIFO holds what arrives; a byte past that is lost, which
-- the UART flags as an overrun (UARTRIS's OERIS, bit 10) and a snapshot
-- reports as one, so no byte is lost unreported.
import core/line
import platform/cortex_m
import rp2040/dma
import rp2040/io_bank0
import rp2040/uart0

public busy: atom
public buffer_empty: atom
public buffer_too_big: atom
public bad_buffer: atom
public overrun: atom
public transfer_error: atom
public exhausted: atom
public stop_timeout: atom
public receive_error: type = overrun | transfer_error | exhausted | stop_timeout

public rx: type = struct
    buf: []u8
    consumed: u32
    budget: u32
    -- What the last snapshot counted, kept when the channel is aborted.
    produced: u32
    config: u32
    active: bool
    lost: bool
    broken: bool
    -- The bits of a received byte that are its frame's data, which read
    -- keeps: the PL011 removes the parity bit on receive (RP2040 datasheet
    -- 4.2.1), and the mask holds the contract whatever the bits above the
    -- data read (D965).
    data_mask: u8
end rx

-- CTRL_TRIG: READ_ERROR 30, WRITE_ERROR 29, BUSY 24, EN 0.
errors: u32 = 0x60000000
busy_bit: u32 = 0x01000000
-- UARTRIS and UARTICR: OERIS and OEIC, the receive FIFO's overrun.
uart_overrun: u32 = 0x400

-- UART0's clock, clk_peri, which bringup takes from the 12 MHz crystal.
public clock: u32 = 12000000

-- What a line's settings program: IBRD and FBRD, the integer and fraction
-- of the baud-rate divisor, and LCR_H, the frame.
public registers: type = struct
    integer: u32
    fraction: u32
    control: u32
end registers

-- The PL011's registers for SETTINGS, computed and written nowhere, as the
-- synthetic driver computes its own (D958).  IBRD and FBRD hold 16 integer
-- and 6 fraction bits of a divisor of clk_peri sampled 16 times a bit,
-- IBRD from 1 to 65535 and FBRD 0 at 65535; at 12 MHz that is 12 to
-- 750,000 baud.  LCR_H: WLEN 6:5 the data bits less five, FEN 4, STP2 3,
-- EPS 2 and PEN 1; WLEN reaches eight bits, so nine are refused.  115200
-- 8N1 is IBRD 6, FBRD 33 and 0x70, as pico-sdk rounds it.
public line_registers: (settings: line.settings)
                       -> (images: registers) ! line.unsupported_rate | line.unsupported_format =
    try line.check(settings)
    fail line.unsupported_format when settings.data_bits > 8
    value := try line.divisor(clock, settings.rate, 16, 6, 64, 65535 * 64)
    mut control: u32 = ((u32(settings.data_bits) - 5) << 5) | 0x10
    if settings.stop_bits == line.two_stop_bits then control |= 0x08 end if
    if settings.parity == line.even_parity then
        control |= 0x06
    elsif settings.parity == line.odd_parity then
        control |= 0x02
    end if
    images = (integer: value >> 6, fraction: value & 63, control: control)
end line_registers

-- UARTCR: UARTEN 0, TXE 8 and RXE 9; UARTFR: BUSY 3 and TXFE 7.
enabled: u32 = 0x301
transmitting: u32 = 0x08
transmit_empty: u32 = 0x80

-- Program the images into the UART, LCR_H written after both divisors to
-- latch them.  The PL011 must be disabled while they change.
program: (images: registers) -> none =
    uart0.uartcr_write(uart0.base, 0)
    uart0.uartibrd_write(uart0.base, images.integer)
    uart0.uartfbrd_write(uart0.base, images.fraction)
    uart0.uartlcr_h_write(uart0.base, images.control)
    uart0.uartcr_write(uart0.base, enabled)
end program

public open: (settings: line.settings, budget: u32, escaping buf: []mut u8)
             -> (r: rx from buf) ! busy | line.unsupported_rate | line.unsupported_format
                                 | buffer_empty | buffer_too_big | bad_buffer =
    size := lenof buf
    fail buffer_empty when size == 0
    fail buffer_too_big when size > 256
    fail bad_buffer when size < 2 or (size & (size - 1)) <> 0
    fail bad_buffer when (usize(addr buf[0]) & (size - 1)) <> 0
    fail bad_buffer when budget < u32(size) or budget > 65535
    images := try line_registers(settings)
    status := dma.ch0_ctrl_trig_read(dma.base)
    fail busy when (status & (errors | busy_bit | 1)) <> 0
    -- FUNCSEL 2 is UART0 on both pins; the override bits are kept.
    tx := io_bank0.gpio0_ctrl_read(io_bank0.base)
    io_bank0.gpio0_ctrl_write(io_bank0.base, (tx & 0xffffffe0) | 2)
    pin := io_bank0.gpio1_ctrl_read(io_bank0.base)
    io_bank0.gpio1_ctrl_write(io_bank0.base, (pin & 0xffffffe0) | 2)
    program(images)
    -- DMACR: RXDMAE.
    uart0.uartdmacr_write(uart0.base, 1)
    uart0.uarticr_write(uart0.base, uart_overrun)
    mut bits: u8 = 0
    mut extent := size
    while extent > 1 do
        extent = extent >> 1
        bits = bits +% 1
    end while
    -- Byte transfers, write increment in a ring of 2^bits bytes, chained
    -- to itself (no chain), paced by DREQ 21, UART0_RX.
    image: u32 = 0x000a8420 | (u32(bits) << 6)
    dma.ch0_ctrl_trig_write(dma.base, image)
    dma.ch0_read_addr_write(dma.base, u32(uart0.base))
    dma.ch0_write_addr_write(dma.base, u32(usize(addr buf[0])))
    dma.ch0_trans_count_write(dma.base, budget)
    dma.intr_write(dma.base, 1)
    dma.inte0_write(dma.base, 1)
    cortex_m.device_barrier()
    dma.ch0_ctrl_trig_write(dma.base, image | 1)
    r = (buf: buf, consumed: 0, budget: budget, produced: 0, config: image,
         active: true, lost: false, broken: false,
         data_mask: line.data_mask(settings))
end open

-- Count never reloads in an epoch. Failure latches until an explicit
-- restart; a stopped descriptor answers from what its last snapshot saw.
snapshot: (inout r: rx) -> (count: usize) ! overrun | transfer_error | exhausted =
    if r.active then
        status := dma.ch0_ctrl_trig_read(dma.base)
        remaining := dma.ch0_trans_count_read(dma.base)
        cortex_m.device_barrier()
        if (status & errors) <> 0 or remaining > r.budget then
            r.broken = true
        end if
        fail transfer_error when r.broken
        r.produced = r.budget -% remaining
        if remaining == 0 then r.active = false end if
    end if
    if r.produced < r.consumed then r.broken = true end if
    fail transfer_error when r.broken
    have := r.produced -% r.consumed
    capacity := lenof r.buf
    if (uart0.uartris_read(uart0.base) & uart_overrun) <> 0 then
        r.lost = true
        r.consumed = r.produced
    end if
    if have > u32(capacity) then
        r.lost = true
        r.consumed = r.produced
    end if
    fail overrun when r.lost
    fail exhausted when r.produced == r.budget and have == 0
    count = usize(have)
end snapshot

public available: (inout r: rx) -> (count: usize) ! receive_error =
    count = try snapshot(r)
end available

public read: (inout r: rx, out_buf: []mut u8) -> (count: usize) ! receive_error =
    have := try snapshot(r)
    count = have
    if lenof out_buf < count then count = lenof out_buf end if
    backing := r.buf
    capacity := lenof backing
    -- snapshot bounds count by both initialized extents; consumed <= 65535,
    -- i < 256 and capacity is a nonzero power of two. No arithmetic wraps.
    unchecked begin
        for i in 0..<count do
            out_buf[i] = backing[(usize(r.consumed) + i) & (capacity - 1)] & r.data_mask
        end for
    end unchecked
    r.consumed = r.consumed +% u32(count)
end read

-- After the abort BUSY falls once the transfers in flight complete, which
-- the datasheet says generally takes a few cycles; 1000 polls bound it.
public stop: (inout r: rx) -> none ! stop_timeout =
    if r.active then
        remaining := dma.ch0_trans_count_read(dma.base)
        if remaining <= r.budget then r.produced = r.budget -% remaining end if
    end if
    r.active = false
    dma.inte0_write(dma.base, 0)
    dma.chan_abort_write(dma.base, 1)
    mut attempts: u32 = 0
    while (dma.ch0_ctrl_trig_read(dma.base) & busy_bit) <> 0 do
        attempts += 1
        fail stop_timeout when attempts == 1000
    end while
    dma.intr_write(dma.base, 1)
    cortex_m.device_barrier()
end stop

-- Discards unread bytes deliberately; may be called after error or exhaustion.
public restart: (inout r: rx) -> none ! stop_timeout | transfer_error =
    try stop(r)
    status := dma.ch0_ctrl_trig_read(dma.base)
    fail transfer_error when (status & errors) <> 0
    dma.ch0_write_addr_write(dma.base, u32(usize(addr r.buf[0])))
    dma.ch0_trans_count_write(dma.base, r.budget)
    dma.intr_write(dma.base, 1)
    dma.inte0_write(dma.base, 1)
    uart0.uarticr_write(uart0.base, uart_overrun)
    r.consumed = 0
    r.produced = 0
    r.lost = false
    r.broken = false
    r.active = true
    cortex_m.device_barrier()
    dma.ch0_ctrl_trig_write(dma.base, r.config | 1)
end restart

-- Change the line to SETTINGS: every register image computed first, so a
-- refusal writes nothing and the line keeps its settings (D955); then,
-- once the transmitter has sent everything it holds, the UART disabled,
-- reprogrammed and enabled again.  The channel and its ring are as they
-- were; a byte arriving while the UART is disabled is lost, so the caller
-- changes the line only while its peer is waiting for it.
public configure: (inout r: rx, settings: line.settings)
                  -> none ! line.unsupported_rate | line.unsupported_format =
    images := try line_registers(settings)
    while (uart0.uartfr_read(uart0.base) & (transmit_empty | transmitting)) <> transmit_empty do
        continue
    end while
    program(images)
    cortex_m.device_barrier()
    r.data_mask = line.data_mask(settings)
end configure
