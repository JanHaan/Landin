-- The prototype-1 application on an ESP32-C5: UART0 received by an
-- interrupt on CLIC identity 17 and echoed, ASCII 1 and 0 driving GPIO24,
-- a 1 ms system-timer wakeup on identity 18, rv32imac's read-modify-writes,
-- and a trace of what the board did, which environments/boards/esp32c5/board.py
-- checks against its physical oracle (D721, D722).  The echo and the
-- indicator are the shared commands.handle (D645).  The ROM loads the image
-- into SRAM and enters it with no second stage (D683).
--
-- Four bytes are also commands, after their echo: 0x06 runs the atomics
-- over the two bytes received before it and writes an `a` frame; 0x11 asks
-- for a telemetry frame; 0x12 stops reading for 100 ms, so a burst sent
-- then overflows the ring; and 0x13 raises mintthresh to the receive
-- interrupt's level for 100 ms, so a burst sent then overflows the UART's
-- FIFO while the timer's interrupt, above it, keeps running.
import bringup
import commands
import core/atomic
import descriptions/esp32c5
import esp32c5/gpio
import esp32c5/lp_clkrst
import esp32c5/systimer
import platform/riscv
import report
import serial

mut rx_storage: [256]u8 = zeroed
mut notification: atomic.cell(u32) = zeroed
mut handled: u32 = 0
mut recoveries: u32 = 0
mut timer_events: atomic.cell(u32) = zeroed
mut uart_cause: u32 = 0
mut timer_cause: u32 = 0
mut masked_ticks: u32 = 0
mut app_state: u32 = 0
-- The reset cause start read, which the probe reads beside the boot frame.
mut boot_reason: u32 = 0
-- The atomics' cells, which the probe reads beside the frame.
mut byte_cell: atomic.cell(u8) = zeroed
mut word_cell: atomic.cell(u32) = zeroed

indicate: (on: bool) -> none =
    if on then
        gpio.out_w1ts_write(gpio.base, bringup.indicator)
    else
        gpio.out_w1tc_write(gpio.base, bringup.indicator)
    end if
end indicate

transmit: (byte: u8) -> none = report.put(byte) end transmit

port: commands.port = (indicate: indicate, transmit: transmit)
budget: u32 = 4096

cause: () -> (value: u32) =
    value = assembler.block("csrr {value}, mcause", out value: u32 at general)
end cause

-- External interrupt 1 is CLIC identity 17, mcause's code and slot 17 of
-- the table compiler-owned trap entry calls through; external interrupt 2,
-- slot 18 (TRM v1.1, 2.8.2.3; D680).
link(vector: 17)
extern(interrupt) uart_irq: () -> none =
    uart_cause = cause()
    serial.receive(rx_storage[0..<256])
    atomic.store(addr notification, 1)
end uart_irq

link(vector: 18)
extern(interrupt) timer_irq: () -> none =
    systimer.int_clr_write(systimer.base, 1)
    timer_cause = cause()
    _ = atomic.sole_add(addr timer_events, 1)
    atomic.store(addr notification, 1)
end timer_irq

telemetry: (r: serial.rx) -> none =
    report.open_frame(116)
    report.field(104, handled)
    report.field(99, recoveries)
    report.field(105, serial.interrupts())
    report.field(109, atomic.load(addr timer_events))
    report.field(112, uart_cause)
    report.field(113, timer_cause)
    report.field(107, masked_ticks)
    report.field(108, serial.bytes_dropped())
    report.field(111, serial.fifo_overflows())
    report.field(101, r.consumed)
    report.field(103, gpio.in_read(gpio.base) & bringup.indicator)
    report.field(115, app_state)
    report.close_frame()
end telemetry

-- rv32imac's read-modify-writes (D690), over the operands x and y the host
-- sent: an add to a four-byte cell holding x, returning x; a
-- compare-exchange that finds x + y and stores x ^ y; one that expects
-- x + y again, finds x ^ y and stores nothing; and an add to a one-byte
-- cell, which the backend lowers over its aligned word.
atomics: (x: u8, y: u8) -> none =
    atomic.store(addr word_cell, u32(x))
    p := atomic.add(addr word_cell, u32(y))
    q := atomic.compare_exchange(addr word_cell, u32(x) + u32(y), u32(x) ^ u32(y))
    r := atomic.compare_exchange(addr word_cell, u32(x) + u32(y), 0)
    d := atomic.load(addr word_cell)
    atomic.store(addr byte_cell, x)
    e := atomic.add(addr byte_cell, y)
    f := atomic.load(addr byte_cell)
    report.open_frame(97)
    report.field(112, p)
    report.field(113, q)
    report.field(114, r)
    report.field(100, d)
    report.field(101, u32(e))
    report.field(102, u32(f))
    report.close_frame()
end atomics

-- Waits 100 ms by the system timer's own count, counting the 1 ms
-- interrupts taken meanwhile.
pause: () -> (events: u32) =
    first := atomic.load(addr timer_events)
    began := bringup.now()
    while bringup.now() -% began < 100 * bringup.ticks_per_ms do
        continue
    end while
    events = atomic.load(addr timer_events) -% first
end pause

halt: (status: u32) -> noreturn =
    app_state = status
    report.open_frame(104)
    report.field(115, status)
    report.close_frame()
    loop do riscv.wait_for_interrupt() end loop
end halt

start: () -> noreturn =
    -- Read before anything changes it: which reset this was, from
    -- LP_CLKRST_RESET_CAUSE (Register 9.90), the trap vector
    -- compiler-owned reset set, and mintthresh as the ROM left it.
    reason := lp_clkrst.reset_cause_read(lp_clkrst.base) & 0x1f
    vector := assembler.block("csrr {value}, mtvec", out value: u32 at general)
    boot_reason = reason
    first_threshold := bringup.threshold_now()
    bringup.indicator_pin()
    bringup.levels()
    bringup.threshold(0)
    bringup.timer()
    mut receiver := serial.open(115200, budget, rx_storage[0..<256]) else (problem)
        _ = problem
        halt(1)
    end
    report.open_frame(98)
    report.field(114, reason)
    report.field(118, vector)
    report.field(116, first_threshold)
    report.close_frame()
    mut scratch: [64]u8 = zeroed
    mut previous: [2]u8 = zeroed
    app_state = 2
    loop do
        atomic.store(addr notification, 0)
        n := serial.read(receiver, scratch[0..<64]) else (error)
            if error == serial.stop_timeout then halt(3) end if
            recoveries = recoveries +% 1
            serial.restart(receiver) else (problem)
                _ = problem
                halt(3)
            end
            continue
        end
        handled = handled +% commands.handle(scratch[0..<n], port)
        for byte in scratch[0..<n] do
            if byte == 6 then atomics(previous[0], previous[1]) end if
            if byte == 17 then telemetry(receiver) end if
            if byte == 18 then _ = pause() end if
            if byte == 19 then
                bringup.threshold(serial.level)
                masked_ticks = pause()
                bringup.threshold(0)
            end if
            previous[0] = previous[1]
            previous[1] = byte
        end for
        if n == 64 then continue end if
        saved := riscv.disable_interrupts()
        if atomic.load(addr notification) == 0 then riscv.wait_for_interrupt() end if
        riscv.restore_interrupts(saved)
    end loop
end start
