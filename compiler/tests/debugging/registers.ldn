--  At speed a source variable may hold a register over its live interval
--  alone, and one stored once and never read again only from that store.
--  The register still holds the variable's value after its last use, until
--  something writes over it.  Each stop the debugger lanes make here is in
--  that stretch, at speed, and they read the variable there.
register_inner: (argument: i32) -> (result: i32) =
    held: i32 = argument + 1
    result = held + 1
end register_inner

--  The branch keeps `chosen` in a register across blocks, and its last use
--  is `picked`'s initializer; the call on the next line preserves the
--  register, and only after it does anything write over it.
register_pick: (argument: i32) -> (result: i32) =
    mut chosen: i32 = argument + 1
    if argument > 100 then chosen = 0 end if
    picked: i32 = chosen
    result = register_inner(picked) - 1
end register_pick

--  D339 copies `inline_leaf` into `inline_outer` at speed, in place of
--  its call.  The stop inside the copy is `inline_leaf`'s frame, with its
--  own parameter and local, inlined into `inline_outer`'s, which still
--  shows its own; without the inlined-subroutine records it would be
--  `inline_outer`'s frame alone.
inline_leaf: (base: i32) -> (total: i32) =
    doubled: i32 = base * 2
    total = doubled + 1
end inline_leaf

inline_outer: (start: i32) -> (result: i32) =
    first: i32 = start + 1
    result = inline_leaf(first) - first
end inline_outer

--  Through function values: D339 copies no routine whose address is taken,
--  so the three routines called here keep their own frames and the stops
--  above stay where they were.
public main: () -> (code: i32) =
    pick := register_pick
    inner := register_inner
    outer := inline_outer
    code = pick(40) + outer(1) - inner(1)
end main
