import core/io
import core/text
import hosted/io as hosted

-- Native Darwin failures retain the errno captured by the helper.
missing: []u8 = "/landin-r440-absent-parent/file-does-not"
null_name: []u8 = "/dev/null"
payload: [1]u8 = [88]

missing_retains_errno: (state: hosted.system) -> (yes: bool) =
    yes = false
    opened: io.file = io.open_read(state, text.host_over(missing)) else (problem)
        return when problem <> io.not_found
        --  A pure capability query cannot clobber captured failure detail.
        _ = io.argument_count(state)
        yes = hosted.last_errno(state) == 2
        return
    end
    io.close(state, opened) else (problem)
        _ = problem
    end
end missing_retains_errno

write_retains_errno: (state: hosted.system) -> (yes: bool) =
    yes = false
    opened: io.file = io.open_write(state, text.host_over(null_name)) else (problem)
        _ = problem
        return
    end
    copy: io.file = opened
    io.close(state, opened) else (problem)
        _ = problem
        return
    end
    io.write(state, copy, payload[0..<1]) else (problem)
        yes = problem == io.io_failed and hosted.last_errno(state) == 9
    end
end write_retains_errno

close_retains_errno: (state: hosted.system) -> (yes: bool) =
    yes = false
    opened: io.file = io.open_read(state, text.host_over(null_name)) else (problem)
        _ = problem
        return
    end
    copy: io.file = opened
    io.close(state, opened) else (problem)
        _ = problem
        return
    end
    io.close(state, copy) else (problem)
        yes = problem == io.io_failed and hosted.last_errno(state) == 9
        return
    end
end close_retains_errno

public main: () -> (code: i32) =
    code = 1
    state: hosted.system = hosted.host()
    return when hosted.last_errno(state) <> 0
    code = 2
    return when not missing_retains_errno(state)
    code = 3
    return when not write_retains_errno(state)
    code = 4
    return when not close_retains_errno(state)
    code = 42
end main
