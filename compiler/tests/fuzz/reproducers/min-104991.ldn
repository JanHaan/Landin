forward_choice: (left: ptr u32, right: ptr u32, missing: bool, choose: bool)
                -> (first: maybe_pointer from le,ft,
                    second: maybe_pointer from right, got: bool) =
    if choose then pair(left, right, missing)
    else pair(left, right, true) end if
end forward_choice
