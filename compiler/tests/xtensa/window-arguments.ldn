-- D1110. `report` passes eight argument words, two of them in the
-- outgoing area of its frame; `l5`, six frames further down, takes the
-- window of `report`'s caller, whose a0 is stored below `report`'s SP.
-- `main` returns through that a0, which is read from below the same SP.
mut drain: u32 = 0
l6: (x: u32) -> (r: u32) =
    drain +%= x
    r = x + 1
end l6
l5: (x: u32) -> (r: u32) = l6(x) + 1 end l5
l4: (x: u32) -> (r: u32) = l5(x) + 1 end l4
l3: (x: u32) -> (r: u32) = l4(x) + 1 end l3
l2: (x: u32) -> (r: u32) = l3(x) + 1 end l2
l1: (x: u32) -> (r: u32) = l2(x) + 1 end l1
sum4: (a: u64, b: u64, c: u64, d: u64) -> (r: u64) =
    r = a + b + c + d + u64(l1(u32(a)))
end sum4
report: (seed: u64) -> (r: u64) =
    r = sum4(seed, 2, 3, 4) + 1
end report
main: () -> (status: i32) =
    if report(1) == 18 and report(10) == 36 then
        status = 0
    else
        status = 1
    end if
end main
