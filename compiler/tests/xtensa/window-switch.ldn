mut backing: [16384]u8 = zeroed
mut main_saved: usize = 0
mut fibre_saved: usize = 0
mut observed: u32 = 0

ratio: (a: f32, b: f32) -> (result: f32) =
    result = a / b
end ratio

transfer: (depth: u32) -> (result: u32) =
    if depth == 0 then
        before: f32 = ratio(7.0, 2.0)
        observed = observed + 1
        compiler.stack_switch(addr fibre_saved, main_saved)
        if before + ratio(9.0, 2.0) == 8.0 then
            result = 100
        else
            result = 200
        end if
    else
        result = transfer(depth - 1) + 1
    end if
end transfer

fibre: (argument: usize) -> noreturn =
    observed = transfer(12) + u32(argument)
    compiler.stack_switch(addr fibre_saved, main_saved)
    loop do
    end loop
end fibre

resume: (depth: u32) -> none =
    if depth == 0 then
        compiler.stack_switch(addr main_saved, fibre_saved)
    else
        resume(depth - 1)
    end if
end resume

main: () -> (status: i32) =
    before: f32 = ratio(5.0, 2.0)
    fibre_saved = compiler.stack_prepare(backing[0..<16384], fibre, 7)
    resume(12)
    if observed == 1 then
        resume(12)
        if observed == 119 and before + ratio(11.0, 2.0) == 8.0 then
            status = 0
        else
            status = 2
        end if
    else
        status = 1
    end if
end main
