-- What every prototype-1 application does with the bytes it receives, the
-- synthetic one in the emulator lane and each board's: each byte is
-- echoed, ASCII 1 sets the indicator and ASCII 0 clears it.  The module
-- names no device: the program that calls it passes its own indicator and
-- transmitter, so the same loop runs over the synthetic map, the RP2040's
-- SIO and UART0 and the STM32H753's GPIOB and USART3 (D645).  This is the
-- scenario whose outcome the lanes compare.

-- A program's indicator and transmitter.  `indicate` sets the indicator
-- when `on` is true and clears it otherwise; `transmit` writes one byte,
-- waiting while the transmitter has no room, since a byte written then
-- would be lost.
public port: type = struct
    indicate: (on: bool) -> none
    transmit: (byte: u8) -> none
end port

-- The indicator changes before the byte that changed it is echoed.
link(section: ".ramtext.handle")
public handle: (bytes: []u8, p: port) -> (count: u32) =
    for byte in bytes do
        if byte == 49 then p.indicate(true) end if
        if byte == 48 then p.indicate(false) end if
        p.transmit(byte)
    end for
    count = u32(lenof bytes)
end handle
