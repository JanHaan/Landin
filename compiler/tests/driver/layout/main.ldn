-- Separate target-layout control; does not stand in for driver execution.
import drivers/uart
mut storage: [8]u8 = zeroed
mut layout: [11]usize = zeroed
start: () -> none =
    mut receiver: uart.rx = (buf: storage[0..<8], consumed: 0, budget: 32,
                            config: 0xa84e0, active: false, quiet: true,
                            lost: false, broken: false)
    layout = [sizeof usize, sizeof uart.rx, alignof uart.rx,
              sizeof [2]uart.rx,
              usize(addr receiver.consumed) - usize(addr receiver),
              usize(addr receiver.budget) - usize(addr receiver),
              usize(addr receiver.config) - usize(addr receiver),
              usize(addr receiver.active) - usize(addr receiver),
              usize(addr receiver.quiet) - usize(addr receiver),
              usize(addr receiver.lost) - usize(addr receiver),
              usize(addr receiver.broken) - usize(addr receiver)]
end start
