args: compile --target=cortex-m0 --firmware-entry=start --emit=exe --toolchain=../tests/fixtures/end-to-end/firmware-archive-with-constructor/driver -L ../tests/fixtures/end-to-end/firmware-archive-with-constructor -o build/firmware-archive-with-constructor.elf ../tests/fixtures/end-to-end/firmware-archive-with-constructor/main.ldn
