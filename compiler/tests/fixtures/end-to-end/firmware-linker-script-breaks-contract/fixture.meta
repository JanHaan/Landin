class: end-to-end
summary: D546: an image linked with a developer's script that defines none of the startup symbols breaks clause 2 of the firmware linker script contract, L0519; a stand-in driver writes the image the real one linked
program: main.ldn
constructs: 1650
targets: cortex-m0
expect: expected.txt
args: compile --target=cortex-m0 --firmware-entry=start --emit=exe --linker-script=../tests/fixtures/end-to-end/firmware-linker-script-breaks-contract/dev.ld --toolchain=../tests/fixtures/end-to-end/firmware-linker-script-breaks-contract/driver -o build/firmware-linker-script-breaks-contract.elf ../tests/fixtures/end-to-end/firmware-linker-script-breaks-contract/main.ldn
status: 1
