point: type = struct
    x: i32
    y: i32
end point

mut cells: [3]point = zeroed
origin: point = (x: 1, y: 2)

whole: (at: usize) -> none =
    cells[at] = origin
    cells[at + 1] = point(x: 3, y: 4)
end whole

taken: (at: usize) -> (r: i32) =
    piece: point = cells[at]
    r = piece.x
end taken
