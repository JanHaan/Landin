cell: type = struct
    kind: variant item: (value: u32) | empty end kind
end cell
group: type = struct cells: [1]cell end group
box: type = struct
    fallback: u32
    kind: variant full: (contents: group) | vacant end kind
end box
nested: (inout source: box, index: usize) -> (result: ptr u32 from source) =
    result = addr source.fallback
    match source.kind
        full(inout contents): match contents.cells[index].kind
            item(value): result = addr value
            empty: begin end
        end match
        vacant: begin end
    end match
end nested

slice_element: (source: []u32) -> (result: ptr u32 from source) =
    result = addr source[0]
    for element in source do
        result = addr element
    end for
end slice_element

array_element: (inout source: [1]u32) -> (result: ptr u32 from source) =
    result = addr source[0]
    for element in source do
        result = addr element
    end for
end array_element

captured_slice: (source: []u32) -> (result: ptr u32 from source) =
    result = addr source[0]
    mut local: [1]u32 = [7]
    mut view: []u32 = source
    for element in view do
        view = local[0..<1]
        result = addr element
    end for
end captured_slice

module_values: [1]u32 = [42]
module_element: () -> (result: ptr u32) =
    result = addr module_values[0]
    for element in module_values do
        result = addr element
    end for
end module_element

traversal_match: (source: []mut box, index: usize)
    -> (result: ptr u32 from source) =
    result = addr source[0].fallback
    for container in source do
        match container.kind
            full(inout contents): match contents.cells[index].kind
                item(value): result = addr value
                empty: begin end
            end match
            vacant: begin end
        end match
    end for
end traversal_match

update_same_source: (source: []mut ptr u32) -> none =
    for element in source do
        element = source[0]
    end for
end update_same_source
