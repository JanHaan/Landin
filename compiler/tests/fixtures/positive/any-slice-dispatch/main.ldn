display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

thing: type = struct
    value: i32
end thing

thing_code: (self: ptr thing) -> (value: i32) =
    value = self.val.value
end thing_code

thing is display (code: thing_code)

first: (items: []any display) -> (value: i32) =
    value = items[0].code()
end first

public main: () -> (code: i32) =
    code = 42
end main
