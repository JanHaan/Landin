--  D144: a family conformance's instance has a table, which holds its
--  target's size and alignment, so the target is laid out though the
--  program holds it only through a pointer and has no main.
display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

box: type (t: type) = struct
    value: t
end box

box_code: (t: type, self: ptr box(t)) -> (value: i32) =
    value = 40 + i32(sizeof t)
end box_code

(t: type) box(t) is display (code: box_code)

make: (p: ptr box(u16)) -> (d: any display from p) = any(p) end make
