anchor: i32 = 0
other: i32 = 1

keep: () -> (result: ptr i32) =
    mut p1: ptr i32 = addr anchor
    mut p2: ptr i32 = addr anchor
    mut p3: ptr i32 = addr anchor
    mut round: usize = 0
    while round < 3 do
        p1 = p2
        p2 = p3
        p3 = addr other
        inc round
    end while
    result = p1
end keep
