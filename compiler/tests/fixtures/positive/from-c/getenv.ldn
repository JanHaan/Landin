import core/io
import core/text
import hosted/system

--- The home directory, or `/` when the environment names none.
home_directory: (host: system.host) -> (home: text.host_string from host) =
    home = io.variable_named(host, text.host_over("HOME")) else (problem)
        _ = problem
        text.host_over("/")
    end
end home_directory
