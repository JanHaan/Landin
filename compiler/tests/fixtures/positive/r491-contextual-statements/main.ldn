selected: atom

declare_loop: () -> none =
    loop_value: i32 = 0
end declare_loop
assign_loop: (v: selected) -> none =
    mut loop_value: [1]i32
    loop_value[0] = 1
    loop_value[0] += 2
    match v
        selected: loop_value[0] = 3
    end match
    while false do
        loop_value[0] = 4
    complete
        loop_value[0] = 5
    end while
end assign_loop

