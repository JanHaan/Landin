selected: atom

declare_loop: () -> none =
    loop: i32 = 0
end declare_loop
assign_loop: (v: selected) -> none =
    mut loop: [1]i32
    loop[0] = 1
    loop[0] += 2
    match v
        selected: loop[0] = 3
    end match
    while false do
        loop[0] = 4
    complete
        loop[0] = 5
    end while
end assign_loop

