compiler.device("board")
compiler.core("cortex-m0")
compiler.vectors(48)
compiler.boot("vector-table")
linker.region("FLASH", 0x0800_0000, 32 * 1024, "rx")
linker.region("DTCM", 0x2000_0000, 16 * 1024, "rw")
linker.region("SRAM", 0x2400_0000, 16 * 1024, "rwx")
linker.place("vectors", "FLASH")
linker.place("text", "FLASH")
linker.place("rodata", "DTCM")
linker.place("data", "SRAM")
linker.place("bss", "SRAM")
linker.place("stack", "SRAM", 4 * 1024)
