--  D1321: an array length that reads a compiler fact or `sizeof` of a
--  scalar folds at the selected target's width, never the host's: on the
--  32-bit model `[sizeof usize]u8` and `[compiler.word_size / 8]u8` are
--  `[4]u8`, on a 64-bit target `[8]u8`.  D1340: `alignof` of a scalar
--  folds the same way, so `[alignof usize]u8` is that type too.
fixed if compiler.word_size == 32 then
    exactly: type = [4]u8
else
    exactly: type = [8]u8
end if

word: type = [sizeof usize]u8
bits: type = [compiler.word_size / 8]u8
aligned: type = [alignof usize]u8

same: (w: word) -> (r: exactly) =
    r = w
end same

again: (b: bits) -> (r: exactly) =
    r = b
end again

lined: (a: aligned) -> (r: exactly) =
    r = a
end lined

start: () -> none =
    w: word = zeroed
    _ = again(same(w))
    a: aligned = zeroed
    _ = lined(a)
end start
