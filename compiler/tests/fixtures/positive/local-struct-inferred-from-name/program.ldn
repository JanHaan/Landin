point: type = struct
    x: u32
    y: u32
end point

holder: type = struct
    tag: u8
    row: [2]usize
    tail: u16
end holder

same: type = holder

mut module_source: holder

copy: (at: usize) -> (result: usize) =
    mut scalar_source: point
    scalar_source.x = 1
    scalar_source.y = 2
    mut scalar_copy := scalar_source

    mut source: same
    source.tag = 3
    source.row[0] = 20
    source.row[1] = 22
    source.tail = 4
    mut local := source
    through_alias := local
    mut module_source := module_source
    chained := through_alias

    mut assigned: holder
    assigned = chained
    local.row = zeroed

    _ = scalar_copy.x
    _ = scalar_copy.y
    _ = local.tag
    _ = through_alias.tail
    _ = module_source.row[at]
    result = assigned.row[at]
end copy
