--  [1630]'s operand forms on each target, in arms no target selects: a
--  positive fixture is emitted, and no target lowers named operands yet.
--  The grammar derives every arm and the parser reads it.
fixed if false then
    mask: () -> (previous: u32) =
        previous = assembler.block("mrs {mask}, primask\ncpsid i",
                                   out mask: u32 at general)
    end mask
    restore: (previous: u32) -> none =
        assembler.block("msr primask, {mask}\nisb sy",
                        in mask: u32 at general = previous)
    end restore
    add_seven: (value: u32) -> (sum: u32) =
        sum = assembler.block("adds r0, #7", inout sum: u32 at r0 = value)
    end add_seven
    ticks: () -> (count: u64) =
        (low, high) := assembler.block("rdtsc", out low: u32 at rax,
                                       out high: u32 at rdx)
        count = u64(high) << 32 | u64(low)
    end ticks
    identify: (leaf: u32) -> (b: u32) =
        (a, b, c, d) := assembler.block("cpuid", inout a: u32 at rax = leaf,
                                        out b: u32 at rbx,
                                        inout c: u32 at rcx = 0,
                                        out d: u32 at rdx)
        _ = a + c + d
    end identify
    clobbers: (value: u64) -> none =
        assembler.block("movq {value}, %rbx", in value: u64 at general = value,
                        out _ at rbx)
    end clobbers
    counter: () -> (count: u64) =
        count = assembler.block("mrs {count}, cntvct_el0",
                                out count: u64 at general)
    end counter
    reversed: (bits: u32) -> (r: u32) =
        r = assembler.block("rbit {r}, {bits}", out r: u32 at general,
                            in bits: u32 at general = bits)
    end reversed
end if
start: () -> none = end start
