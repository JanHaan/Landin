before_loop: (flag: bool) -> (r: i32) =
    r = 0
    while flag do
    complete
        r = 1
    end while
end before_loop

condition_effect: () -> (r: i32) =
    while begin r = 1 false end do
    end while
end condition_effect

bound_effect: () -> (r: i32) =
    for i in begin r = 1 0 end..<1 do
    end for
end bound_effect

loop_value: () -> (r: [2]i32) =
    r = loop do
        break with [1, 2]
    end loop
end loop_value

body_return: () -> (r: i32) =
    loop do
        r = 1
        return
    end loop
end body_return

completion_return: (flag: bool) -> (r: i32) =
    while flag do
    complete
        r = 1
        return
    end while
end completion_return

consume: (sink p: ptr i32) -> none =
    _ = p
end consume

restored: (flag: bool) -> none =
    v: i32 = 1
    mut p: ptr i32 = addr v
    consume(p)
    while flag do
    complete
        p = addr v
    end while
    _ = p
end restored
