holder: type = struct
    tag: u8
    row: [2]u32
    tail: u16
end holder

same: type = holder
mut state: same

read: (at: usize) -> (result: u32) =
    mut local: holder
    state = zeroed
    local = zeroed

    _ = state.tag
    _ = state.tail
    _ = local.tag
    _ = local.tail
    result = state.row[at] + local.row[at]
end read
