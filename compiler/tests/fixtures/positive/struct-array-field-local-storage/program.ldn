holder: type = struct
    tag: u8
    row: [2]usize
    tail: u16
end holder

holder_alias: type = holder

use: () -> none =
    mut direct: holder
    mut through_alias: holder_alias
    direct.row[0] = 70
    direct.row[1] = 1
    through_alias.row[0] = 7
    through_alias.row[1] = 2
    direct.tail = 7
    through_alias.tag = 1
    at: usize = 1
    seen_element: usize = through_alias.row[at]
    seen_tail: u16 = direct.tail
    seen_tag: u8 = through_alias.tag
end use
