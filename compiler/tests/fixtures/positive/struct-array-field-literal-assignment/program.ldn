word: type = usize
word_row: type = [2]word

holder: type = struct
    tag: u8
    row: word_row
    tail: u16
end holder

holder_alias: type = holder

mut state: holder_alias

module_field: (at: usize) -> (result: word) =
    state.row = [20, 22]
    result = state.row[at]
end module_field

local_field: (at: usize) -> (result: word) =
    mut local: holder_alias
    local.row = [20, 22]
    result = local.row[at]
end local_field
