bad: atom
problem: type = bad

consume: (value: i32) -> none =
    _ = value
end consume

leaf: () -> none ! problem =
    fail bad
end leaf

normal_fallthrough: () -> none ! problem =
    mut local: i32
    undo consume(local)
end normal_fallthrough

successful_return: () -> none ! problem =
    mut local: i32
    undo consume(local)
    return
end successful_return

direct_failure: () -> none ! problem =
    mut local: i32
    undo consume(local)
    local = 42
    fail bad
end direct_failure

propagated_failure: () -> none ! ... =
    mut local: i32
    undo consume(local)
    local = 42
    try leaf()
end propagated_failure

recovered_failure: () -> none ! problem =
    mut local: i32
    undo consume(local)
    leaf() else 0
    return
end recovered_failure
