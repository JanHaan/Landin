increment: (inout value: u32) -> none =
    value = value + 1
end increment

good: (which: bool) -> none =
    mut value: u32 = 1
    mut view: ptr u32 = addr value
    increment(value)
    if which then
        view = addr value
    else
        view = addr value
    end if
    _ = view.val
end good
