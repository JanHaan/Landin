--  [1820] over literals: [1940] admits an operator applied to literals or
--  to another module scalar binding whose value is known.
mut comparisons: [3]bool = [1 < 2, 5 == 5, 3 > 10]
mut logic: [4]bool = [true and false, true or false, not true, not false]
mut bitwise: [3]u8 = [255 & 15, 12 | 3, 15 ^ 10]
mut shifts: [3]u32 = [1 << 4, 16 >> 2, 1 << 100]
mut complement: [2]i8 = [~0, ~127]
mut measurements: [3]usize = [sizeof u32, alignof u32, lenof shifts]
