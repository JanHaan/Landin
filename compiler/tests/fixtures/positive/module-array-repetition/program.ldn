--  Two images of a billion bytes each: compact however long, and together
--  within 2 GiB, the least reach D537 holds a hosted target's written images to.
mut through: [1000000000]u8 = huge
mut huge: [1000000000]u8 = [of base + 5]
base: u8 = 160
mut counted: [2]u64 = [2 of 0x123456789ABCDEF0]
mut zero: [3]u32 = [of 0]
