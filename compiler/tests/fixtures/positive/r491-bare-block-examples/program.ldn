block_value: type = i32

-- The tour's scoping example uses the enabled unlabelled block.
demo: (x: i32) -> (out: i32) =
    out = 0
    begin
        tmp := x * 2
        out = out + tmp
    end
end demo

-- A type named block_value still belongs to the ordinary name space.
typed: () -> (result: block_value) =
    scope: block_value = 3
    result = scope
end typed
