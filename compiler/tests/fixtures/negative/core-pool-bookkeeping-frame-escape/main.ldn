import core/mem
import core/pool

pool_state: type = pool.provider

forward: (inout space: pool.space, base: ptr mut u8,
          bookkeeping: []mut pool.slot)
         -> (slab: pool_state from space, base, bookkeeping)
         ! mem.out_of_memory =
    extent: usize = 64
    slot_size: usize = 64
    slot_count: usize = 1
    alignment: usize = 1
    slab = try pool.over
        (space, base, extent, slot_size, slot_count, alignment, bookkeeping)
end forward

bad: (inout space: pool.space, base: ptr mut u8)
     -> (slab: pool_state from space, base) ! mem.out_of_memory =
    mut records: [1]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    slab = try forward(space, base, bookkeeping)
end bad
