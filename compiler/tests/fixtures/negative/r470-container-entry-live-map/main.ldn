import core/map
import core/mem
import hosted/heap

node: type = struct
    value: i32
end node

first: node = (value: 11)
second: node = (value: 22)

bad_insert: (inout value: map.map(u32, ptr node),
             provider: heap.heap) -> (result: i32)
            ! mem.out_of_memory | map.missing =
    slot := try map.at(value, 1)
    replacement_key: u32 = 2
    try map.insert(value, provider, replacement_key, addr second)
    result = slot.val.val.value
end bad_insert

bad_release: (inout value: map.map(u32, ptr node),
              provider: heap.heap) -> (result: i32) ! map.missing =
    slot := try map.at(value, 1)
    map.release(value, provider)
    result = slot.val.val.value
end bad_release

public main: () -> (code: i32) =
    code = first.value
end main
