--  D630: on a Cortex-M7's FPv5-D16, s(2n) and s(2n+1) are d(n)'s halves,
--  so the text's s17 names d8, which the routine preserves, and an f32 at
--  d1 is the register an f64 at d1 already holds.
import m7

f: (value: f64) -> none =
    assembler.block("vadd.f64 {a}, {a}, {a}\nvmov.f32 {b}, {b}",
                    in a: f64 at d1 = value, in b: f32 at d1 = f32(value))
    assembler.block("vmov.f32 s17, {v}", in v: f32 at float = f32(value))
    _ = assembler.block("vmov.f32 {r}, s17", out r: f32 at float,
                        out _ at d8)
    assembler.block("vmov.f32 s3, {v}", in v: f64 at d1 = value)
    assembler.block("vadd.f64 {a}, {b}, {c}\nvadd.f64 {d}, {e}, {g}\nvadd.f64 {h}, {i}, {i}\nvmov.f32 s1, s1",
                    in a: f64 at float = value, in b: f64 at float = value,
                    in c: f64 at float = value, in d: f64 at float = value,
                    in e: f64 at float = value, in g: f64 at float = value,
                    in h: f64 at float = value, in i: f64 at float = value)
end f
