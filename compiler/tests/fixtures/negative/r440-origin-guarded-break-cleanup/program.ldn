absent: atom
maybe_pointer: type = absent | ptr u32

consume: (value: i32) -> none =
    _ = value
end consume

bad: (cell: ptr u32, choose: bool) -> (result: maybe_pointer from cell) =
    local: u32 = 42
    mut candidate: maybe_pointer = addr local
    result = cell
    loop do
        defer consume(begin
            candidate = absent
            0
        end)
        break when choose
        result = candidate
        return
    end loop
end bad
