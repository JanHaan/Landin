import core/io
import core/mem
import core/heap
import examples/derived_hosted/app

bad: (inout allocator: heap.system,
      inout reader: app.reader, world: any io.world) -> (byte: u8)
     ! io.io_failed | mem.out_of_memory | app.at_end =
    line: []u8 = try app.next_line(allocator, reader, world)
    later: []u8 = try app.next_line(allocator, reader, world)
    _ = later
    byte = line[0]
end bad
