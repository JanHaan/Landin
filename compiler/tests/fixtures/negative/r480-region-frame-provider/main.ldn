import core/arena
import core/region

bad: (inout ledger: region.growing_space)
     -> (value: region.region(arena.arena) from ledger) =
    mut backing: [64]u8 = zeroed
    mut space: arena.space = zeroed
    provider := arena.over_unchecked(space, addr backing[0], 64)
    value = region.over(ledger, provider)
end bad
