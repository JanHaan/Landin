import core/fault
import hosted/heap

heap_provider: type = heap.heap

remaining: () -> (count: usize) =
    space: fault.space = zeroed
    inner := heap.new()
    counted := fault.over
        (inner_provider: heap_provider, state: space, inner: inner,
         allowed_attempts: usize(1))
    count = fault.remaining(counted)
end remaining

public main: () -> (code: i32) =
    code = i32(remaining())
end main
