import core/fault
import hosted/heap

heap_provider: type = heap.system

bad: () -> (state: fault.injector(heap_provider)) =
    inner := heap.host()
    attempts: usize = 1
    state = fault.new
        (inner_provider: heap_provider, inner: addr inner,
         allowed_attempts: attempts)
end bad

public main: () -> (code: i32) =
    state: fault.injector(heap_provider) = bad()
    code = i32(fault.remaining(state))
end main
