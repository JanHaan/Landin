--  [1420]: `store.state` is the binding `state` names, so a place consumed
--  under one spelling is consumed under the other, and what [0910] refuses
--  of a path it refuses of a qualified one.
import store
import store (state, both)

consume: (sink value: u32) -> (got: u32) =
    got = value
end consume

public main: () -> (code: i32) =
    a := consume(store.state)
    b := state -- error: consumed as `store.state`
    state = 1
    c := consume(state)
    d := store.state -- error: consumed as `state`
    e := consume(store.both.b)
    f := both.b -- error: consumed as `store.both.b`
    g := store.both.a
    mut index: usize = 2
    k := consume(store.cells[index]) -- error: a computed index
    h := consume(store.cells[1])
    i := store.cells[1] -- error: this element was consumed
    j := store.cells[0]
    code = i32(a + b + c + d + e + f + g + h + i + j + k)
end main
