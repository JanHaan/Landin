--  `end` may repeat the name of what it closes and may name nothing else
--  [1795] [0680] [1230] [1800].  The grammar writes any identifier there,
--  so this derives, and the parser alone refuses each wrong name.
point: type = struct
    x: i32
end piont

shape: type = concept (t: type)
    area: (item: t) -> (result: u32)
end shpae

f: () -> none =
end g

choice: type = struct
    kind: variant
        empty |
        some: (value: i32)
    end knid
end choice
