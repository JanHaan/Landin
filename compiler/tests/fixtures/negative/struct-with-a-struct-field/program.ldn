inner: type = struct
    q: u32
end inner

--  D86 lays the nested field out for measurement, but no runtime cell of
--  that containing type exists yet.  Reading another field must not add a
--  second report after the declaration was refused.
outer: type = struct
    part: inner
    count: u32
end outer

mut here: outer

f: () -> (r: u32) =
    r = here.count
end f
