import core/io
import core/io/fake
import core/text
bad: () -> (value: text.host_string) ! io.no_argument =
    mut bytes: [1]u8 = [65]
    mut args: [1][]u8
    args[0] = bytes[0..<1]
    files: []mut io.memory_file = []
    output: []mut u8 = []
    errors: []mut u8 = []
    mut space: io.memory_space = zeroed
    memory := io.memory_over(space, files, args[0..<1], "", output, errors)
    world: any io.world = any(addr memory)
    value = try world.argument(0)
end bad
