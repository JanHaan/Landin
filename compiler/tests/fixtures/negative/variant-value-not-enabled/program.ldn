choice: type = struct
    prefix: u8
    kind: variant
        leaf |
        number: (value: u8)
    end kind
end choice

declared: choice
literal_state: choice = (kind: leaf)
copied: choice = declared
inferred := choice(prefix: 1, of zeroed)

make: () -> none =
    local := choice(prefix: 1, of zeroed)
end make

copy_assignment: () -> none =
    mut left: choice
    mut right: choice
    left = right
end copy_assignment
