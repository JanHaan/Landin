import core/failing
import core/mem
import core/pool

fixed_provider: type = pool.provider

bad: () -> (state: failing.counted(fixed_provider)) ! mem.out_of_memory =
    mut words: [64]u8 = zeroed
    mut records: [1]pool.slot = zeroed
    base: ptr mut u8 = addr words[0]
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    extent: usize = 64
    slot_size: usize = 64
    slot_count: usize = 1
    alignment: usize = 8
    mut inner := try pool.over
        (base, extent, slot_size, slot_count, alignment, bookkeeping)
    attempts: usize = 1
    state = failing.count_down
        (inner_provider: fixed_provider, inner: addr inner,
         allowed_attempts: attempts)
end bad

public main: () -> (code: i32) =
    state: failing.counted(fixed_provider) = bad() else (problem)
        _ = problem
        code = 0
        return
    end
    code = i32(failing.remaining(state))
end main
