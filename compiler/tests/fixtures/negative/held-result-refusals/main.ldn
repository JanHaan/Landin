--  D1369's refusals: a result `from held` that is a view of its source's
--  storage, a view into a list's storage held across a push, a frame
--  address stored through `at` and read back out, and a function value
--  whose `from` differs in `held` from the routine it is given.
import core/mem
import core/vec
import hosted/heap

node: type = struct
    v: i32
end node

--  `vec.used` lends the list's storage, which `held` does not say.
all_of: (list: vec.list(i32)) -> (xs: []mut i32 from held list) =
    xs = vec.used(list)
end all_of

--  The address of an element is a view of the slice's storage.
first_slot: (xs: []i32) -> (p: ptr i32 from held xs) =
    p = addr xs[0]
end first_slot

--  A view into the list's storage still holds the list.
grown_under_view: (inout list: vec.list(i32)) -> (n: i32) ! mem.out_of_memory =
    memory := heap.new()
    xs := vec.used(list)
    try vec.push(list, memory, 5)
    n = xs[0]
end grown_under_view

--  What the list holds carries the origin it was given: a frame address
--  written through `at` goes out with the item read back.
read_back: (escaping seed: ptr node) -> (p: ptr node from seed)
           ! mem.out_of_memory | mem.out_of_bounds =
    memory := heap.new()
    mut list := vec.new(item: ptr node)
    try vec.push(list, memory, seed)
    local: node = (v: 1)
    slot := try vec.at(list, 0)
    slot.val = addr local
    p = try vec.get(list, 0)
end read_back

--  D1370: a view of this pass's binding still holds it.
this_pass: () -> (n: usize) ! mem.out_of_memory | mem.full =
    memory := heap.new()
    n = 0
    for at in usize(0)..<2 do
        block: ptr mut u8 = try mem.allocate(memory, 4, alignof u8)
        mut owner := mem.storage_over(item: u8, base: block, slots: 4)
        xs := mem.used(owner)
        _ = try mem.admit(owner, 1)
        n += lenof xs
    end for
end this_pass

viewed: (list: vec.list(ptr node)) -> (p: ptr node from list) ! mem.empty =
    p = try vec.last(list)
end viewed

held_reader: type = (list: vec.list(ptr node)) -> (p: ptr node from held list) ! mem.empty

pick: () -> (reader: held_reader) =
    reader = viewed
end pick
