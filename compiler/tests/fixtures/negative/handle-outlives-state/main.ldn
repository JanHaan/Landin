--  A handle is made from its state, so it cannot outlive it: returning an
--  arena whose state lives in this frame is refused where it is returned.
import core/arena

mut backing: [16]u8

make: () -> (memory: arena.arena) =
    mut space: arena.space = zeroed
    memory = arena.over(space, addr backing[0], 16)
end make

public main: () -> (code: i32) =
    memory := make()
    code = i32(arena.used(memory))
end main
