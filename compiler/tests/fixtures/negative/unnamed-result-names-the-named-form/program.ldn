--  D861: another language's unnamed result is one report naming the form
--  with a name, and named returns without their parentheses are one
--  report too; each function is still closed by its own `end`.
add: (a: i32, b: i32) -> i32 =
    a + b
end add

subtract: (a: i32, b: i32) -> difference: i32 =
    difference = a - b
end subtract

public main: () -> (code: i32) =
    code = 0
end main
