import core/fault
import core/mem
import core/pool

fixed_provider: type = pool.provider

bad: (inout space: fault.space)
     -> (counted: fault.injector(fixed_provider) from space)
     ! mem.out_of_memory =
    mut words: [64]u8 = zeroed
    mut records: [1]pool.slot = zeroed
    base: ptr mut u8 = addr words[0]
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    extent: usize = 64
    slot_size: usize = 64
    slot_count: usize = 1
    alignment: usize = 8
    mut inner_space: pool.space = zeroed
    inner := try pool.over
        (inner_space, base, extent, slot_size, slot_count, alignment,
         bookkeeping)
    attempts: usize = 1
    counted = fault.over
        (inner_provider: fixed_provider, state: space, inner: inner,
         allowed_attempts: attempts)
end bad

public main: () -> (code: i32) =
    mut space: fault.space = zeroed
    counted: fault.injector(fixed_provider) = bad(space) else (problem)
        _ = problem
        code = 0
        return
    end
    code = i32(fault.remaining(counted))
end main
