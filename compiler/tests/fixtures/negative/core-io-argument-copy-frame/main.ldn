import core/text

--  An argument's bytes once had to be copied into caller scratch; a host
--  string made over such scratch still lends it, and cannot outlive the
--  frame that owns it.
bad: () -> (value: text.host_string) =
    mut scratch: [2]u8 = [65, 66]
    value = text.host_over(scratch[0..<2])
end bad
