import hosted/heap
import core/map

node: type = struct
    value: u32
end node

bad: () -> (result: map.map(u32, ptr node)) ! ... =
    mut provider := heap.host()
    mut local: node = (value: 7)
    mut value := map.new(key: u32, item: ptr node)
    key: u32 = 11
    local_value: ptr node = addr local
    try map.insert(value, provider, key, local_value)
    result = value
end bad

public main: () -> (code: i32) =
    value: map.map(u32, ptr node) = bad() else (problem)
        _ = problem
        code = 0
        return
    end
    code = i32(map.length(value))
end main
