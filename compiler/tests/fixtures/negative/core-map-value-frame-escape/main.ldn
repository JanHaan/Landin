import core/cmp
import core/map
import hosted/heap

node: type = struct
    value: u32
end node

bad: () -> (result: map.map(u32, ptr node)) ! ... =
    provider := heap.new()
    mut local: node = (value: 7)
    mut value := map.new(key: u32, item: ptr node, seed: test_seed())
    key: u32 = 11
    local_value: ptr node = addr local
    try map.insert(value, provider, key, local_value)
    result = value
end bad

public main: () -> (code: i32) =
    value: map.map(u32, ptr node) = bad() else (problem)
        _ = problem
        code = 0
        return
    end
    code = i32(map.length(value))
end main

--  A constant seed: the same probes and rebuilds on every run.
test_seed: () -> (seed: cmp.hash_seed) =
    seed = cmp.seed_from(1, 2)
end test_seed
