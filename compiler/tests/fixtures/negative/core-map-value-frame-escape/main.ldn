import core/heap
import core/map

key_equal: (left: u32, right: u32) -> (same: bool) =
    same = left == right
end key_equal

key_hash: (value: u32) -> (result: u64) =
    result = u64(value)
end key_hash

u32 is map.equatable (eq: key_equal)
u32 is map.hashable (hash: key_hash)

node: type = struct
    value: u32
end node

bad: () -> (result: map.map(u32, ptr node)) ! ... =
    mut provider := heap.host()
    mut local: node = (value: 7)
    mut value := map.new_map(key: u32, item: ptr node)
    key: u32 = 11
    local_value: ptr node = addr local
    try map.insert(value, provider, key, local_value)
    result = value
end bad

public main: () -> (code: i32) =
    value: map.map(u32, ptr node) = bad() else (problem)
        _ = problem
        code = 0
        return
    end
    code = i32(map.length(value))
end main
