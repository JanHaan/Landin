import core/mem
bad: () -> (result: []mut u8) =
    mut bytes: [2]u8 = zeroed
    base: ptr mut u8 = addr bytes[0]
    two: usize = 2
    mut storage := mem.reserve(item: u8, base: base, slots: two)
    value: u8 = 23
    _ = mem.admit(storage, value) else two
    result = mem.used(storage)
end bad
