public disable_interrupts: () -> (previous: u32) =
    previous = assembler.block("mrs {mask}, primask\ncpsid i",
                               out mask: u32 at general)
end disable_interrupts

public restore_interrupts: (previous: u32) -> none =
    assembler.block("msr primask, {mask}\nisb sy",
                    in mask: u32 at general = previous)
end restore_interrupts

public interrupt_mask: () -> (current: u32) =
    current = assembler.block("mrs {mask}, primask", out mask: u32 at general)
end interrupt_mask

public wait_for_interrupt: () -> none =
    assembler.block("dsb sy\nwfi")
end wait_for_interrupt

public transport: (value: u32) -> (result: u32) =
    result = assembler.block("adds r0, #7", inout result: u32 at r0 = value)
end transport
