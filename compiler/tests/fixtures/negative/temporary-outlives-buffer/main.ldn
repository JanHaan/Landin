--  A temporary file's path is lent from the buffer `make_temporary` was
--  given, so a temporary returned past a frame-local buffer is refused.
import core/io
import core/io/fake
import core/text

made: (host: fake.volume, names: fake.entropy)
      -> (result: io.temporary) ! ... =
    mut room: [64]u8 = zeroed
    result = try io.make_temporary(host, names, text.host_over(""),
                                   room[0..<64])
end made
