view: type = concept (t: type)
    read: (inout self: ptr t) -> (value: i32)
end view

thing: type = struct
    value: i32
end thing

read_thing: (inout self: ptr thing) -> (value: i32) =
    value = 42
end read_thing

thing is view (read: read_thing)

public main: () -> (code: i32) =
    mut item: thing = (value: 42)
    erased: any view = any(addr item)
    code = 0
end main
