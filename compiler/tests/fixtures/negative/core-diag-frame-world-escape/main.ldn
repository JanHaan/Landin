import core/diag
import core/io
import hosted/io as hosted

retain: (escaping value: diag.streaming) -> none =
end retain

bad: () -> none =
    mut host := hosted.host()
    world: any io.world = any(addr host)
    stream := world.err()
    logger := diag.to(addr world, addr stream)
    retain(logger)
end bad
