import core/arena
import core/diag
import examples/config_parser/parser

bad: () -> none =
    mut memory: [4096]u8 = zeroed
    mut space: arena.space = zeroed
    bump := arena.over(space, addr memory[0], 4096)
    mut collected := diag.new(capacity: 1)
    mut logger: any diag.log = any(addr collected)
    mut tree := parser.empty()
    source: [1]u8 = [10]
    parser.parse_file(source[0..<1], logger, bump, tree) else none
end bad
