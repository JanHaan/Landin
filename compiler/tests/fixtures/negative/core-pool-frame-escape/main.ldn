import core/mem
import core/pool

bad: (inout space: pool.space) -> (slab: pool.provider from space)
     ! mem.out_of_memory =
    mut words: [128]u8 = zeroed
    mut records: [2]pool.slot = zeroed
    base: ptr mut u8 = addr words[0]
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    extent: usize = 128
    slot_size: usize = 64
    slot_count: usize = 2
    alignment: usize = 8
    slab = try pool.over
        (space, base, extent, slot_size, slot_count, alignment, bookkeeping)
end bad

public main: () -> (code: i32) =
    mut space: pool.space = zeroed
    slab: pool.provider = bad(space) else (problem)
        _ = problem
        code = 0
        return
    end
    code = i32(pool.capacity(slab))
end main
