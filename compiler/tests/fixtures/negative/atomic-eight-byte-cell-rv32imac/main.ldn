import core/atomic

mut uptime: atomic.cell(u64) = zeroed
mut events: atomic.cell(u32) = zeroed

public main: () -> (code: i32) =
    mut local := atomic.new(u64(1))
    _ = atomic.add(addr events, 1)
    _ = atomic.exchange(addr events, 2)
    _ = atomic.compare_exchange(addr events, 2, 3)
    code = i32(atomic.load(addr uptime) + atomic.load(addr local))
end main
