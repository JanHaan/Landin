display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

printable: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end printable

thing: type = struct
    value: i32
end thing

thing_code: (self: ptr thing) -> (value: i32) =
    value = self.val.value
end thing_code

thing is display (code: thing_code)
thing is printable (code: thing_code)

public main: () -> (code: i32) =
    item: thing = (value: 42)
    erased := any(addr item)
    code = 0
end main
