compiler.device("unrunnable")
compiler.core("cortex-m3")
compiler.vectors(48)
compiler.boot("vector-table")
linker.region("FLASH", 0x0800_0000, 64 * 1024, "rx")
linker.region("SRAM", 0x2000_0000, 16 * 1024, "rwx")
linker.region("DTCM", 0x1000_0000, 16 * 1024, "rw")
linker.place("vectors", "FLASH")
linker.place("text", "DTCM")
linker.place("rodata", "DTCM")
linker.place("data", "SRAM")
linker.place("bss", "SRAM")
linker.place("stack", "SRAM", 8 * 1024)
