display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

thing: type = struct
    value: i32
end thing

thing_code: (self: ptr thing) -> (value: i32) =
    value = self.val.value
end thing_code

thing is display (code: thing_code)

none_found: atom
maybe_thing: type = none_found | ptr thing

bad: (m: maybe_thing) -> (value: i32) =
    erased: any display = any(m)
    value = erased.code()
end bad
