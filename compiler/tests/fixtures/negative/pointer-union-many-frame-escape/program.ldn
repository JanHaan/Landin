none_found: atom
denied: atom
maybe_ptr: type = none_found | denied | ptr u32

retain: (escaping pointer: ptr u32) -> none =
    _ = pointer
end retain

bad: () -> none =
    value: u32 = 1
    m: maybe_ptr = addr value
    match m
        none_found: _ = 0
        denied: _ = 1
        ptr (p): retain(p)
    end match
end bad
