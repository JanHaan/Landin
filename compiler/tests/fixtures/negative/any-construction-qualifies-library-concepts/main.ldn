--  [1380]: a pointer whose pointee conforms to more than one concept needs
--  an `any C` context, and the refusal lists the concepts as this program
--  writes them: its own `display`, and core/text's `text.formattable`.
import core/text

display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

thing: type = struct
    value: i32
end thing

thing_code: (self: ptr thing) -> (value: i32) =
    value = self.val.value
end thing_code

thing_append: (self: ptr thing, inout into: text.builder)
              -> none ! text.no_space =
    _ = self
    try text.append(into, "thing")
end thing_append

thing is display (code: thing_code)
thing is text.formattable (append: thing_append)

public main: () -> (code: i32) =
    item: thing = (value: 42)
    erased := any(addr item)
    code = 0
end main
