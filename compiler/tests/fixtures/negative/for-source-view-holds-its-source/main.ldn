--  D1084: the source a `for` loop walks is a view in use until the loop is
--  done, whether or not a name holds it, so what it views may not be
--  passed `inout` or `sink` in the body on a path that reaches another
--  iteration or reads the element again.
import core/mem
import core/vec
import hosted/heap

rec: type = struct
    cells: [4]i32
    tag: i32
end rec

reset_rec: (inout r: rec) -> none =
    r.tag = 0
end reset_rec

reset: (inout buffer: [4]i32) -> none =
    buffer = [9, 9, 9, 9]
end reset

part: (r: ptr rec) -> (s: []i32 from r) = r.val.cells[0..<2] end

--  The tour's own traversal, growing the list it walks.
grow_while_walking: (inout numbers: vec.list(i64), memory: heap.heap)
                    -> (sum: i64) ! mem.out_of_memory =
    sum = 0
    for value in vec.used(numbers) do
        try vec.push(numbers, memory, value) -- error: the loop walks numbers
        sum += value
    end for
end grow_while_walking

consume: (sink r: rec) -> none =
    _ = r.tag
end consume

walks: (stop: bool) -> (n: i32) =
    mut buffer: [4]i32 = [1, 2, 3, 4]
    mut r: rec = (cells: [1, 2, 3, 4], tag: 0)
    n = 0
    --  A result `from` the record.
    for x in part(addr r) do
        reset_rec(r) -- error
        n += x
    end for
    --  A range of the record's array, with an index binding.
    for x, i in r.cells[0..<2] do
        n += x + i32(i)
        reset_rec(r) -- error
    end for
    --  An array walked where it stands.
    for x in buffer do
        reset(buffer) -- error
        n += x
    end for
    --  Leaving the loop does not help while the element is still read.
    for x in buffer do
        reset(buffer) -- error: x names an element of buffer
        n += x
        break
    end for
    --  An inner loop's `break` leaves only the inner loop.
    for x in buffer[0..<2] do
        n += x
        loop do
            reset(buffer) -- error
            break
        end loop
    end for
    --  A deferred call runs at the end of every iteration.
    for x in part(addr r) do
        defer reset_rec(r) -- error
        n += x
    end for
    --  `sink` takes the storage as `inout` may change it.
    mut gone: rec = (cells: [1, 2, 3, 4], tag: 0)
    for x in gone.cells[0..<2] do
        consume(gone) -- error
        n += x
        break
    end for
    if stop then
        n = 0
    end if
end walks

public main: () -> (code: i32) =
    code = walks(false)
end main
