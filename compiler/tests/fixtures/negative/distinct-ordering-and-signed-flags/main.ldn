--  A distinct type has `==`, `<>` and its base's order, and bit operators
--  only over an unsigned base: a signed identifier is no set of flags, and
--  arithmetic is the base's.  D427 admits `|=` over an unsigned base, so
--  runtime/distinct-equality-over-atoms-and-pointers holds that form now.
descriptor: type = distinct i32

signed: (left: descriptor, right: descriptor) -> (both: descriptor) =
    both = left | right
end signed

summed: (left: descriptor, right: descriptor) -> (total: descriptor) =
    total = left + right
end summed
