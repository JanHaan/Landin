import core/map

node: type = struct
    value: i32
end node

bad: (source: map.map(u32, ptr node), wrong: map.map(u32, ptr node))
     -> (result: ptr node from wrong) ! map.end_of_entries =
    mut position := map.entries()
    selected: map.entry(u32, ptr node) = try map.next_entry(source, position)
    result = selected.item
end bad

public main: () -> (code: i32) =
    code = 0
end main
