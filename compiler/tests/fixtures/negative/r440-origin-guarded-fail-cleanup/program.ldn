absent: atom
unavailable: atom
maybe_pointer: type = absent | ptr u32

consume: (value: i32) -> none =
    _ = value
end consume

bad: (cell: ptr u32, choose: bool)
     -> (result: maybe_pointer from cell) ! unavailable =
    local: u32 = 42
    mut candidate: maybe_pointer = addr local
    defer consume(begin
        candidate = absent
        0
    end)
    fail unavailable when choose
    result = candidate
end bad
