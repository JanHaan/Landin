f: (value: u32) -> none =
    assembler.block("movs {w}, #1", in v: u32 at general = value)
    assembler.block("movs {v, #1", in v: u32 at general = value)
    assembler.block("movs r1, #1", in v: u32 at general = value)
    assembler.block("movs {v}, #1", in v: u32 at r1 = value,
                    in v: u32 at r2 = value)
end f
