import core/arena
import core/mem

bad: (inout space: arena.space) -> (memory: arena.arena from space) =
    mut bytes: [32]u8 = zeroed
    base: ptr mut u8 = addr bytes[0]
    extent: usize = 32
    memory = arena.over(space, base, extent)
end bad

public main: () -> (code: i32) =
    mut space: arena.space = zeroed
    _ = bad(space)
    code = 0
end main

absent: atom
saved: type = absent | ptr mut u8
mut retained: saved = absent

retain: (memory: arena.arena) -> none ! mem.out_of_memory =
    retained = try mem.new(memory, u8(7))
end retain

helper_escape: () -> none =
    mut bytes: [32]u8 = zeroed
    mut space: arena.space = zeroed
    memory := arena.over(space, addr bytes[0], 32)
    retain(memory) else none
end helper_escape
