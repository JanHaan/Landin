import core/mem

bad: (inout space: mem.arena_space) -> (arena: mem.arena from space) =
    mut bytes: [32]u8 = zeroed
    base: ptr mut u8 = addr bytes[0]
    extent: usize = 32
    arena = mem.arena_over(space, base, extent)
end bad

public main: () -> (code: i32) =
    mut space: mem.arena_space = zeroed
    _ = bad(space)
    code = 0
end main

absent: atom
saved: type = absent | ptr mut u8
mut retained: saved = absent

retain: (arena: mem.arena) -> none ! mem.out_of_memory =
    retained = try mem.new(arena, u8(7))
end retain

helper_escape: () -> none =
    mut bytes: [32]u8 = zeroed
    mut space: mem.arena_space = zeroed
    arena := mem.arena_over(space, addr bytes[0], 32)
    retain(arena) else (problem)
        _ = problem
    end
end helper_escape
