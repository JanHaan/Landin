answer: () -> (result: u16) =
    result = 42
end answer

holder: type = struct
    tag: u8
    row: [2]u16
end holder

state: holder = (tag: 1, row: [answer(), 7])
full: holder = (tag: 1, row: [of answer()])
mixed_prefix: holder = (tag: 1, row: [answer(), of 7])
mixed_suffix: holder = (tag: 1, row: [7, of answer()])
