--  D1084: a view given to a call is in use until the call returns, so its
--  source may not be passed `inout` or `sink` to that call, nor to a call
--  made while the view waits for its own.
import core/mem
import core/vec
import hosted/heap

rec: type = struct
    cells: [4]i32
    tag: i32
end rec

reset_rec: (inout r: rec) -> (k: i32) =
    r.tag = 0
    k = 0
end reset_rec

part: (r: ptr rec) -> (s: []i32 from r) = r.val.cells[0..<2] end

both: (xs: []i32, inout b: [4]i32) -> (k: i32) =
    b = [9, 9, 9, 9]
    k = xs[0]
end both

after: (inout b: rec, xs: []i32) -> (k: i32) =
    b.tag = 1
    k = xs[0]
end after

sum2: (xs: []i32, k: i32) -> (r: i32) =
    r = xs[0] + k
end sum2

taken: (sink b: rec, p: ptr i32) -> (k: i32) =
    k = p.val + b.tag
end taken

append_all: (inout target: vec.list(i64), memory: heap.heap, items: []i64)
            -> none ! mem.out_of_memory =
    for item in items do
        try vec.push(target, memory, item)
    end for
end append_all

--  Appending a list's own items to it: the growth frees what `items` views.
self_append: (inout numbers: vec.list(i64), memory: heap.heap)
             -> none ! mem.out_of_memory =
    try append_all(numbers, memory, vec.used(numbers)) -- error
    --  A name for the view changes nothing: its use is the call.
    history: []i64 = vec.used(numbers)
    try append_all(numbers, memory, history[0..<1]) -- error
end self_append

calls: () -> (n: i32) =
    mut buffer: [4]i32 = [1, 2, 3, 4]
    mut r: rec = (cells: [1, 2, 3, 4], tag: 0)
    n = both(buffer[0..<2], buffer) -- error: a range beside its array
    n += both(buffer, buffer) -- error: the array lent as a slice
    n += after(r, part(addr r)) -- error: a `from` result, in either order
    n += taken(r, addr r.tag) -- error: `sink` beside an address
    mut q: rec = (cells: [1, 2, 3, 4], tag: 0)
    --  Arguments are evaluated left to right [0410]: the view is taken,
    --  then the nested call changes what it views.
    n += sum2(part(addr q), reset_rec(q)) -- error
end calls

public main: () -> (code: i32) =
    code = calls()
end main
