--  Two actual pthreads enter this exported routine concurrently.  Each owns a
--  distinct system provider supplied by main, so the only shared failure
--  source is libc's real thread-local errno reached through the emitted bridge.

import core/io
import hosted/io as hosted

extern(c) r440_run_errno_threads: (first: ptr mut hosted.system,
                                    second: ptr mut hosted.system)
                                   -> (result: i32)

thread_path: [12]u8 =
    [114, 52, 52, 48, 45, 116, 104, 114, 101, 97, 100, 0]

public extern(c) link(symbol: "r440_errno_thread_probe") thread_probe:
    (state: ptr mut hosted.system, expected: i32) -> (result: i32) =
    result = 1
    opened: io.file = io.open_read(state.val, addr thread_path[0])
        else (problem)
            if problem == io.io_failed
              and hosted.last_errno(state.val) == expected
            then
                result = 42
            end if
            return
        end
    io.close(state.val, opened) else (problem)
        _ = problem
    end
end thread_probe

public main: () -> (code: i32) =
    code = 1
    mut first: hosted.system = hosted.host()
    mut second: hosted.system = hosted.host()
    code = r440_run_errno_threads(addr first, addr second)
    return when code <> 42
    code = 1
    return when hosted.last_errno(first) <> 5 or hosted.last_errno(second) <> 28
    code = 42
end main
