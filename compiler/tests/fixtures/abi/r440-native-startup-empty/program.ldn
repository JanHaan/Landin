import core/io
import core/text
import hosted/system

-- C initialized the root with only the program name: the world exists, its
-- sequence is empty, and asking for an argument refuses rather than traps.
public extern(c) l_root: () -> (ok: bool) =
    state: system.host = system.new()
    ok = false
    return when io.argument_count(state) <> 0
    value: text.host_string = io.argument_at(state, usize(0)) else (problem)
        ok = problem == io.no_argument
        return
    end
    _ = text.host_bytes(value)
end l_root
