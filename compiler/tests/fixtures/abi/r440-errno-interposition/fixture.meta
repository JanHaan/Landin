class: abi
profiles: standard
summary: actual hosted bridge preserves errno and partial I/O policy under C interposition
program: program.ldn
root: ../../../../..
c-sources: interpose.c
c-args: -Wl,--wrap=open -Wl,--wrap=read -Wl,--wrap=write -Wl,--wrap=close
run_expect: expected.txt
status: 42
constructs: 0940, 1570, 1580, 1660, 1975
targets: darwin-arm64, freebsd-x86-64, freebsd-arm64
# On Linux hosted/system makes system calls through platform/linux,
# which no C function stands between, so these C peers cannot replace
# them there; abi/linux-file-identity and runtime/linux-system-calls hold
# the Linux path.
