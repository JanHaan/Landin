--  The program and its hand-written freestanding C peer (peer.c) call
--  each other under AAPCS32.  peer.h declares in C what this declares in
--  Landin; the peer checks every value the program passes it and returns
--  0 or the code of the first check that failed, and the program checks
--  every value the peer returns.  A status of 42 is every check held; 100
--  plus a code is the peer's check of that code; any other is the
--  program's own check of that number.
import platform/c

level: type = c.c_int
peer_low: level = -1

tiny: type = layout(c) struct
    a: u8
    b: u8
    c: u8
end tiny

small: type = layout(c) struct
    tag: u8
    value: i16
end small

medium: type = layout(c) struct
    first: u32
    second: u64
end medium

large: type = layout(c) struct
    words: [5]u32
    mark: i8
    tail: i64
end large

log: type = layout(c) struct
    calls: u32
    last: i32
    total: u64
end log

step: type = extern(c) (value: i32, wide: i64) -> (result: i64)

extern(c) peer_scalars: (a: u8, b: i8, c_: u16, d: i16, e: u32, f: i32, g: bool,
                         h: c.c_char, i: c.c_long, j: level) -> (fault: c.c_int)
extern(c) peer_pairs: (a: u32, b: u64, c_: u32, d: i64, e: u32, f: u64) -> (fault: c.c_int)
extern(c) peer_floats: (a: f32, b: f64, c_: f32, d: f64) -> (fault: c.c_int)
extern(c) peer_wide: () -> (value: u64)
extern(c) peer_narrow: () -> (value: i8)
extern(c) peer_char: () -> (value: c.c_char)
extern(c) peer_long: () -> (value: c.c_long)
extern(c) peer_double: (half: f32) -> (value: f64)
extern(c) peer_small_round: (value: small) -> (result: small)
extern(c) peer_tiny_make: (base: u8) -> (result: tiny)
extern(c) peer_tiny_check: (value: tiny, base: u8) -> (fault: c.c_int)
extern(c) peer_medium_check: (before: u32, value: medium) -> (fault: c.c_int)
extern(c) peer_large_check: (first: u32, value: large, after: u32) -> (fault: c.c_int)
extern(c) peer_large_make: (seed: i32) -> (result: large)
extern(c) peer_large_read: (value: ptr large) -> (fault: c.c_int)
extern(c) peer_large_fill: (into: ptr mut large, seed: i32) -> none
extern(c) peer_apply: (given: step) -> (fault: c.c_int)
extern(c) peer_exports: () -> (fault: c.c_int)
extern(c) peer_log_address: () -> (object: ptr mut log)
extern(c) peer_log_check: () -> (fault: c.c_int)

--  Read and written by the peer under its link name.
link(symbol: "landin_seen") mut seen: u32 = 0

--  Passed to the peer as a C function pointer.
public extern(c) landin_step: (value: i32, wide: i64) -> (result: i64) =
    result = wide * 2 + i64(value)
end landin_step

--  The peer's large record, by value: r0-r3 and the stack's four words.
public extern(c) landin_check_large: (value: large) -> (fault: c.c_int) =
    fault = large_differs(value, 2000)
end landin_check_large

public extern(c) landin_small: (tag: u8, value: i16) -> (result: small) =
    result.tag = tag + 1
    result.value = value - 1
end landin_small

--  low in r0 and high in r2:r3; the result in r0:r1.
public extern(c) landin_wide: (low: u32, high: u64) -> (result: u64) =
    result = high + u64(low)
end landin_wide

--  The peer's own fill of a large record from SEED, as peer.c makes it.
large_of: (seed: i32) -> (made: large) =
    made = zeroed
    for i in usize(0)..4 do
        made.words[i] = u32(seed) + u32(i) * 0x01010101
    end for
    made.mark = -7
    made.tail = -i64(seed) * 0x100000001
end large_of

large_differs: (value: large, seed: i32) -> (code: i32) =
    wanted: large = large_of(seed)
    for i in usize(0)..4 do
        code = 1 + i32(i)
        return when value.words[i] <> wanted.words[i]
    end for
    code = 6
    return when value.mark <> wanted.mark
    code = 7
    return when value.tail <> wanted.tail
    code = 0
end large_differs

checks: () -> (code: i32) =
    --  Each argument the peer checks; 100 plus its code otherwise.
    mut fault: i32 = peer_scalars(0xfe, -5, 0xfedc, -1234, 0xdeadbeef, -123456789,
                                  true, 200, -2, peer_low)
    code = 100 + fault
    return when fault <> 0
    fault = peer_pairs(1, 0x0123456789abcdef, 3, -0x0102030405060708, 5,
                       0xfedcba9876543210)
    code = 100 + fault
    return when fault <> 0
    fault = peer_floats(0.5, -1.0e300, 3.25, 1.0 / 3.0)
    code = 100 + fault
    return when fault <> 0

    --  Each result the peer returns.
    code = 1
    return when peer_wide() <> 0x8000000100000002
    code = 2
    return when peer_narrow() <> -128
    --  0xf0 as a plain char is 240: unsigned under AAPCS32.
    code = 3
    return when peer_char() <> 240
    code = 4
    return when peer_long() <> -2147483648
    code = 5
    return when peer_double(1.25) <> 2.5

    --  Records by value, in and out.
    round: small = peer_small_round((tag: 0x7f, value: -200))
    code = 6
    return when round.tag <> 0x80 or round.value <> -400
    made_tiny: tiny = peer_tiny_make(0x40)
    code = 7
    return when made_tiny.a <> 0x40 or made_tiny.b <> 0x41 or made_tiny.c <> 0x42
    fault = peer_tiny_check(made_tiny, 0x40)
    code = 100 + fault
    return when fault <> 0
    fault = peer_medium_check(0x11, (first: 0x22222222, second: 0x3333333344444444))
    code = 100 + fault
    return when fault <> 0
    fault = peer_large_check(0x55, large_of(1000), 0x66)
    code = 100 + fault
    return when fault <> 0
    made: large = peer_large_make(4000)
    code = 10 + large_differs(made, 4000)
    return when code <> 10

    --  Records by address, read and written by the peer.
    mut held: large = large_of(3000)
    fault = peer_large_read(addr held)
    code = 100 + fault
    return when fault <> 0
    peer_large_fill(addr held, 5000)
    code = 20 + large_differs(held, 5000)
    return when code <> 20

    --  A C function pointer to a Landin routine, and the peer calling
    --  the program's exports and its datum.
    fault = peer_apply(landin_step)
    code = 100 + fault
    return when fault <> 0
    seen = 4
    fault = peer_exports()
    code = 100 + fault
    return when fault <> 0
    code = 30
    return when seen <> 0x77

    --  The peer's global, through the address it gives.
    entry: ptr mut log = peer_log_address()
    for i in 1..3 do
        entry.val.calls = entry.val.calls + 1
    end for
    entry.val.last = -9
    entry.val.total = 0x100000003
    fault = peer_log_check()
    code = 100 + fault
    return when fault <> 0
    code = 42
end checks

public main: () -> (code: i32) =
    code = checks()
end main
