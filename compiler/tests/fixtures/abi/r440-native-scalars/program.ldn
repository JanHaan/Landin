-- C owns main; every carrier crosses directly, indirectly and reentrantly.
i8_handler: type = extern(c) (value: i8) -> (result: i8)
extern(c) c_i8: (value: i8) -> (result: i8)
extern(c) callback_i8: (handler: i8_handler, value: i8) -> (result: i8)
public extern(c) l_i8: (value: i8) -> (result: i8) =
    result = value + 2
end l_i8

u8_handler: type = extern(c) (value: u8) -> (result: u8)
extern(c) c_u8: (value: u8) -> (result: u8)
extern(c) callback_u8: (handler: u8_handler, value: u8) -> (result: u8)
public extern(c) l_u8: (value: u8) -> (result: u8) =
    result = value + 2
end l_u8

