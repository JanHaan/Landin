u32_handler: type = extern(c) (value: u32) -> (result: u32)
extern(c) c_u32: (value: u32) -> (result: u32)
extern(c) callback_u32: (handler: u32_handler, value: u32) -> (result: u32)
public extern(c) l_u32: (value: u32) -> (result: u32) =
