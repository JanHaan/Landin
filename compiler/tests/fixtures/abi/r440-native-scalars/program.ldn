extern(c) c_i16: (value: i16) -> (result: i16)
extern(c) callback_i16: (handler: i16_handler, value: i16) -> (result: i16)
public extern(c) l_i16: (value: i16) -> (result: i16) =
    result = value + 2
end l_i16

u16_handler: type = extern(c) (value: u16) -> (result: u16)
extern(c) c_u16: (value: u16) -> (result: u16)
extern(c) callback_u16: (handler: u16_handler, value: u16) -> (result: u16)
public extern(c) l_u16: (value: u16) -> (result: u16) =
    result = value + 2
