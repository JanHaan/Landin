--  The facts platform/libc, platform/linux and platform/posix keep for
--  sockets and for SIGPIPE, handed to a C peer that holds each to the
--  system's own headers: the domains, kinds, levels and options, the
--  record sizes, the time limit's and the signal action's layouts, and the
--  address records platform/posix lays out, which the peer reads as C's
--  own and builds for platform/posix to read back.
import core/net
import core/text
import platform/libc
import platform/linux
import platform/posix

--- Socket and signal numbers, by the peer's index.
public extern(c) l_number: (index: i32) -> (value: i64) =
    values: [28]i64 =
        [i64(libc.af_unix),
         i64(libc.af_inet),
         i64(libc.af_inet6),
         i64(libc.sock_stream),
         i64(libc.sock_dgram),
         i64(libc.sol_socket),
         i64(libc.so_reuseaddr),
         i64(libc.so_error),
         i64(libc.so_rcvtimeo),
         i64(libc.so_sndtimeo),
         i64(libc.ipproto_tcp),
         i64(libc.ipproto_ipv6),
         i64(libc.tcp_nodelay),
         i64(libc.ipv6_v6only),
         i64(libc.shut_rd),
         i64(libc.shut_wr),
         i64(libc.shut_rdwr),
         i64(libc.sigpipe),
         i64(libc.sig_dfl),
         i64(libc.sig_ign),
         i64(libc.f_getfd),
         i64(libc.sockaddr_storage_size),
         i64(libc.sockaddr_in_size),
         i64(libc.sockaddr_in6_size),
         i64(libc.sockaddr_un_path),
         i64(sizeof libc.time_limit),
         i64(sizeof libc.signal_action),
         i64(sizeof libc.signal_set)]
    value = -1
    return when index < 0 or usize(index) >= lenof values
    value = values[usize(index)]
end l_number

fixed if compiler.os == linux then
    --  platform/linux's own copies agree with the C library's.
    public extern(c) l_linux_agrees: () -> (yes: bool) =
        yes = linux.af_unix == libc.af_unix and linux.af_inet == libc.af_inet
              and linux.af_inet6 == libc.af_inet6
              and linux.sock_stream == libc.sock_stream
              and linux.sock_dgram == libc.sock_dgram
              and linux.sock_cloexec == libc.sock_cloexec
              and linux.msg_nosignal == libc.msg_nosignal
              and linux.sol_socket == libc.sol_socket
              and linux.so_reuseaddr == libc.so_reuseaddr
              and linux.so_error == libc.so_error
              and linux.so_rcvtimeo == libc.so_rcvtimeo
              and linux.so_sndtimeo == libc.so_sndtimeo
              and linux.ipproto_tcp == libc.ipproto_tcp
              and linux.ipproto_ipv6 == libc.ipproto_ipv6
              and linux.tcp_nodelay == libc.tcp_nodelay
              and linux.ipv6_v6only == libc.ipv6_v6only
              and linux.shut_rd == libc.shut_rd
              and linux.shut_wr == libc.shut_wr
              and linux.shut_rdwr == libc.shut_rdwr
              and linux.sigpipe == libc.sigpipe
              and linux.sig_dfl == u64(libc.sig_dfl)
              and linux.sig_ign == u64(libc.sig_ign)
              and linux.f_getfd == libc.f_getfd
              and sizeof linux.time_limit == sizeof libc.time_limit
    end l_linux_agrees

    --- The interface requests and their record: SIOCGIFINDEX,
    --- SIOCGIFNAME, `struct ifreq`'s size and where its number lies.
    public extern(c) l_interface_fact: (index: i32) -> (value: i64) =
        mut record: linux.interface_record = zeroed
        facts: [4]i64 =
            [i64(linux.siocgifindex), i64(linux.siocgifname),
             i64(sizeof linux.interface_record),
             i64(usize(addr record.index) - usize(addr record))]
        value = -1
        return when index < 0 or index > 3
        value = facts[usize(index)]
    end l_interface_fact

    public extern(c) l_cloexec_flag: () -> (value: i32) =
        value = libc.sock_cloexec
    end l_cloexec_flag

    public extern(c) l_no_signal: () -> (value: i32) =
        value = libc.msg_nosignal
    end l_no_signal
elsif compiler.os == freebsd then
    public extern(c) l_cloexec_flag: () -> (value: i32) =
        value = libc.sock_cloexec
    end l_cloexec_flag

    public extern(c) l_no_signal: () -> (value: i32) =
        value = libc.msg_nosignal
    end l_no_signal

    public extern(c) l_no_sigpipe: () -> (value: i32) =
        value = libc.so_nosigpipe
    end l_no_sigpipe

    public extern(c) l_setsigdef: () -> (value: i16) =
        value = libc.posix_spawn_setsigdef
    end l_setsigdef

    public extern(c) l_setsigmask: () -> (value: i16) =
        value = libc.posix_spawn_setsigmask
    end l_setsigmask
else
    public extern(c) l_no_sigpipe: () -> (value: i32) =
        value = libc.so_nosigpipe
    end l_no_sigpipe

    public extern(c) l_setsigdef: () -> (value: i16) =
        value = libc.posix_spawn_setsigdef
    end l_setsigdef

    public extern(c) l_setsigmask: () -> (value: i16) =
        value = libc.posix_spawn_setsigmask
    end l_setsigmask
end if

--- Where a field lies in the time limit and the signal action: the
--- microseconds, the action's flags and its mask.
public extern(c) l_offset: (index: i32) -> (offset: i64) =
    mut limit: libc.time_limit = zeroed
    mut action: libc.signal_action = zeroed
    offsets: [3]i64 =
        [i64(usize(addr limit.microseconds) - usize(addr limit)),
         i64(usize(addr action.flags) - usize(addr action)),
         i64(usize(addr action.mask) - usize(addr action))]
    offset = -1
    return when index < 0 or index > 2
    offset = offsets[usize(index)]
end l_offset

--- The record platform/posix lays out for the peer's address `index`,
--- copied into `into`, and its length.
public extern(c) l_encoded: (index: i32, into: ptr mut u8) -> (length: u32) =
    groups: [8]u16 = [0x2001, 0xdb8, 0, 0, 0, 0, 0, 1]
    record: posix.socket_address =
        if index == 0 then laid_out(net.ipv4_address(192, 0, 2, 1, 8080))
        elsif index == 1 then laid_out(net.ipv6_address(groups, 443))
        elsif index == 3 then zoned()
        else unix_record() end if
    length = record.length
    for at in usize(0)..<usize(length) do
        slot: ptr mut u8 = ptr(usize(into) + at)
        slot.val = record.bytes[at]
    end for
end l_encoded

--  The record of an address with no zone, which names no interface for
--  the system to look up and so cannot fail.
laid_out: (at: net.address) -> (record: posix.socket_address) =
    record = posix.internet_address(at) else (problem)
        _ = problem
        posix.socket_address(bytes: zeroed, length: 0)
    end
end laid_out

--  `[fe80::1%7]:1`, whose zone is an interface's number as it stands.
zoned: () -> (record: posix.socket_address) =
    record = (bytes: zeroed, length: 0)
    at: net.address = net.parse_address("[fe80::1%7]:1") else (problem)
        _ = problem
        return
    end
    record = laid_out(at)
end zoned

--- The number platform/posix finds for the interface named by the
--- `length` bytes at `name`, or 0 when it finds none.
public extern(c) l_index_of: (name: ptr u8, length: u32) -> (index: u32) =
    mut bytes: [16]u8 = zeroed
    index = 0
    return when length > 16
    for at in usize(0)..<usize(length) do
        slot: ptr u8 = ptr(usize(name) + at)
        bytes[at] = slot.val
    end for
    index = posix.interface_index(bytes[0..<usize(length)]) else (problem)
        _ = problem
        0
    end
end l_index_of

--- The zone platform/posix reads from a record whose scope is `index`,
--- copied with its NUL into the 16 bytes at `into`.
public extern(c) l_zone_of: (index: u32, into: ptr mut u8) -> none =
    mut record: posix.socket_address = laid_out(net.loopback(net.ipv6, 1))
    for at in usize(0)..<4 do
        record.bytes[24 + at] = u8((index >> u32(8 * at)) & 255)
    end for
    mut zone: [16]u8 = zeroed
    at: net.address = posix.address_of(record) else (problem)
        _ = problem
        net.loopback(net.ipv6, 1)
    end
    zone = at.zone
    for place in usize(0)..<16 do
        slot: ptr mut u8 = ptr(usize(into) + place)
        slot.val = zone[place]
    end for
end l_zone_of

unix_record: () -> (record: posix.socket_address) =
    record = posix.unix_address(text.host_over("/tmp/landin.sock")) else (problem)
        _ = problem
        laid_out(net.unspecified(net.ipv4, 0))
    end
end unix_record

--- Read the C record of `length` bytes at `source` back as an address:
--- whether it is IPv6, its port and its last byte, or -1 when
--- platform/posix refuses it.
public extern(c) l_decoded: (source: ptr u8, length: u32) -> (summary: i64) =
    mut record: posix.socket_address = (bytes: zeroed, length: length)
    for at in usize(0)..<usize(length) do
        slot: ptr u8 = ptr(usize(source) + at)
        record.bytes[at] = slot.val
    end for
    summary = -1
    at: net.address = posix.address_of(record) else (problem)
        _ = problem
        return
    end
    last: u8 = if at.family == net.ipv4 then at.octets[3] else at.octets[15]
               end if
    summary = (if at.family == net.ipv6 then i64(1) << 32 else i64(0) end if)
              | (i64(at.port) << 8) | i64(last)
end l_decoded
