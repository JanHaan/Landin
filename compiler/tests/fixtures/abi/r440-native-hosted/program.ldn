-- C-owned startup uses the library's startup-independent services: the C
-- library through platform/libc and the hosted heap, with no argument root.
import core/mem
import hosted/heap
import platform/libc

-- Private Landin names cannot replace the library's calls into libc.
strlen: () -> (result: usize) = result = 99 end strlen
malloc: () -> (result: usize) = result = 99 end malloc
free: () -> (result: usize) = result = 99 end free

public extern(c) l_length: (data: ptr u8) -> (length: usize) =
    _ = strlen()
    length = libc.strlen(data)
end l_length

public extern(c) l_copy: (input: i32, output: i32, buffer: ptr mut u8, length: usize) -> (count: usize) =
    received := libc.read(input, buffer, length)
    count = 0
    if received == isize(length) then
        count = usize(libc.write(output, buffer, length))
    end if
end l_copy

public extern(c) l_heap: () -> (ok: bool) =
    _ = malloc()
    _ = free()
    ok = false
    provider: heap.system = heap.host()
    block: ptr mut u8 = mem.allocate(provider, usize(64), usize(24)) else (problem)
        _ = problem
        return
    end
    block.val = 42
    ok = block.val == 42 and usize(block) % 24 == 0
    mem.free(provider, block, usize(64))
end l_heap
