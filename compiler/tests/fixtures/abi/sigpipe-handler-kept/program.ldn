--  Landin's side of a C main that installed its own SIGPIPE handler: it
--  says whether SIGPIPE is ignored, writes to a pipe nobody reads, and
--  sends on a socket pair whose other end is closed, each reporting 1 when
--  the call failed with EPIPE.
import platform/posix

public extern(c) l_ignored: () -> (yes: bool) =
    yes = posix.broken_pipe_ignored()
end l_ignored

public extern(c) l_pipe_write: () -> (result: i32) =
    result = 0
    ends: posix.pipe_ends = posix.pipe() else (problem)
        _ = problem
        return
    end
    posix.close(ends.reading) else (problem)
        _ = problem
        return
    end
    _ = posix.write(ends.writing, "anyone?") else (problem)
        if problem == posix.epipe then result = 1 end if
        0
    end
    posix.close(ends.writing) else (problem)
        _ = problem
        result = 0
    end
end l_pipe_write

public extern(c) l_socket_send: () -> (result: i32) =
    result = 0
    ends: posix.connected_pair = posix.socket_pair(posix.stream) else (problem)
        _ = problem
        return
    end
    posix.close(ends.second) else (problem)
        _ = problem
        return
    end
    _ = posix.send(ends.first, "anyone?") else (problem)
        if problem == posix.epipe then result = 1 end if
        0
    end
    posix.close(ends.first) else (problem)
        _ = problem
        result = 0
    end
end l_socket_send
