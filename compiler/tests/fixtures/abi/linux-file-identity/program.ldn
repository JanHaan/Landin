import core/io
import hosted/io as hosted
import hosted/linux

--  On Linux hosted/io reads file identity with hosted/linux's
--  statx, which no C function stands between and no C peer can replace.
--  The peer instead holds hosted/linux's record to the C header's
--  `struct statx` and to the C library's own statx of the same path, and
--  makes the hard link and symbolic link the identities are checked on.

extern(c) identity_setup: () -> (good: bool)
extern(c) identity_path: (which: i32) -> (path: ptr u8)
extern(c) identity_cleanup: () -> none
extern(c) identity_record_size: () -> (size: usize)
extern(c) identity_record_agrees: (path: ptr u8, record: ptr u8)
                                  -> (good: bool)

public main: () -> (code: i32) =
    code = 1
    return when sizeof linux.file_status <> identity_record_size()

    code = 10
    return when not identity_setup()
    mut status: linux.file_status = zeroed
    record: ptr u8 = ptr(usize(addr status))
    if linux.statx(linux.at_fdcwd, identity_path(0), 0, linux.statx_ino,
                   addr status) <> 0
      or not identity_record_agrees(identity_path(0), record) then
        identity_cleanup()
        return
    end if

    --  The file, its hard link and a symbolic link to it are one file;
    --  another file is not, and neither is a path that does not exist.
    mut state: hosted.system = hosted.host()
    for which in i32(0)..<i32(5) do
        code = 20 + which
        mut failed: bool = false
        same: bool = io.same_file(state, identity_path(0),
                                  identity_path(which)) else (problem)
            failed = problem == io.io_failed
            false
        end
        if failed or same <> (which <= 2) then
            identity_cleanup()
            return
        end if
    end for

    --  A first path that does not exist is a failure with its errno.
    code = 30
    mut failed: bool = false
    same: bool = io.same_file(state, identity_path(4),
                              identity_path(0)) else (problem)
        failed = problem == io.io_failed
        false
    end
    identity_cleanup()
    return when same or not failed or hosted.last_errno(state) <> 2
    code = 42
end main
