-- D256: under the standard AAPCS64 an unnamed argument is placed as a named
-- one of its promoted type would be.  Ten integers and ten doubles after
-- the count fill x1-x7 and d0-d7 first and spill the rest to the stack, so
-- C's va_arg reads them, and an assembly observer reads where they arrived.
collector: type = extern(c) (count: i32, ...) -> (result: i32)
fixed_collector: type = extern(c) (bias: f64, count: i32, ...) -> (result: i32)
extern(c) c_collect: (count: i32, ...) -> (result: i32)
extern(c) c_fixed: (bias: f64, count: i32, ...) -> (result: i32)
extern(c) observe_banks: (count: i32, ...) -> (result: i32)

public extern(c) landin_check: () -> (result: i32) =
    signed_byte: i8 = -7
    unsigned_byte: u8 = 250
    signed_half: i16 = -30000
    unsigned_half: u16 = 60000
    truth: bool = true
    single: f32 = 0.5
    call: collector = c_collect
    fixed_call: fixed_collector = c_fixed
    observe: collector = observe_banks
    direct := c_collect(10, signed_byte, single, unsigned_byte, 1.5,
        signed_half, 2.5, unsigned_half, 3.5, truth, 4.5,
        6, 5.5, 7, 6.5, 8, 7.5, 9, 8.5, 10, 9.5)
    indirect := call(10, signed_byte, single, unsigned_byte, 1.5,
        signed_half, 2.5, unsigned_half, 3.5, truth, 4.5,
        6, 5.5, 7, 6.5, 8, 7.5, 9, 8.5, 10, 9.5)
    fixed_direct := c_fixed(12.5, 10, signed_byte, single, unsigned_byte, 1.5,
        signed_half, 2.5, unsigned_half, 3.5, truth, 4.5,
        6, 5.5, 7, 6.5, 8, 7.5, 9, 8.5, 10, 9.5)
    fixed_indirect := fixed_call(12.5, 10, signed_byte, single, unsigned_byte, 1.5,
        signed_half, 2.5, unsigned_half, 3.5, truth, 4.5,
        6, 5.5, 7, 6.5, 8, 7.5, 9, 8.5, 10, 9.5)
    placed := observe_banks(10, signed_byte, single, unsigned_byte, 1.5,
        signed_half, 2.5, unsigned_half, 3.5, truth, 4.5,
        6, 5.5, 7, 6.5, 8, 7.5, 9, 8.5, 10, 9.5)
    placed_indirect := observe(10, signed_byte, single, unsigned_byte, 1.5,
        signed_half, 2.5, unsigned_half, 3.5, truth, 4.5,
        6, 5.5, 7, 6.5, 8, 7.5, 9, 8.5, 10, 9.5)
    result = 1
    if direct == 42 and indirect == 42
       and fixed_direct == 42 and fixed_indirect == 42
       and placed == 42 and placed_indirect == 42
    then
        result = 42
    end if
end landin_check
