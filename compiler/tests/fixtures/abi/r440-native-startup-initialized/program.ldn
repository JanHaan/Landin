import core/io
import hosted/io as hosted
import hosted/libc
import core/text

-- The plain C library receives file capabilities from the C root before any
-- argument root exists. Importing hosted/io also retains its unrelated
-- host/argv routines in this unit.

read: () -> (value: i32) = value = 17 end read
write: () -> (value: i32) = value = 19 end write

public extern(c) l_plain: (input: i32, output: i32) -> (ok: bool) =
    ok = false
    return when read() <> 17 or write() <> 19
    mut received: [4]u8 = zeroed
    mut copied: [4]u8 = zeroed
    count: isize = libc.read(input, addr received[0], 4)
    return when count <> 4
    source: io.argument = (data: addr received[0], length: usize(count))
    bytes: []u8 = io.copy_argument(source, copied[0..<4]) else (problem)
        _ = problem
        return
    end
    ok = libc.write(output, addr bytes[0], lenof bytes) == 4
end l_plain

callback: type = extern(c) (state: ptr hosted.system, depth: i32) -> (ok: bool)
extern(c) c_reenter: (state: ptr hosted.system, visit: callback, depth: i32)
                     -> (ok: bool)
extern(c) c_argument_storage: (count: usize, first: ptr u8, second: ptr u8)
                              -> (ok: bool)

arguments_match: (state: ptr hosted.system) -> (ok: bool) =
    ok = false
    return when io.argument_count(state.val) <> 2
    first: io.argument = io.argument_at(state, usize(0)) else (problem)
        _ = problem
        return
    end
    second: io.argument = io.argument_at(state, usize(1)) else (problem)
        _ = problem
        return
    end
    mut word_scratch: [5]u8 = zeroed
    mut number_scratch: [2]u8 = zeroed
    word_bytes: []u8 = io.copy_argument(first, word_scratch[0..<5])
      else (problem)
        _ = problem
        return
    end
    number_bytes: []u8 = io.copy_argument(second, number_scratch[0..<2])
      else (problem)
        _ = problem
        return
    end
    word: utf8 = text.from_bytes(word_bytes) else (problem)
        _ = problem
        return
    end
    number: utf8 = text.from_bytes(number_bytes) else (problem)
        _ = problem
        return
    end
    return when not text.equal(word, "alpha") or not text.equal(number, "42")
    -- Mint a fresh world from the root as well as using the one already
    -- minted. This catches a callback prologue resetting the root.
    fresh: hosted.system = hosted.host()
    again: io.argument = io.argument_at(addr fresh, usize(0)) else (problem)
        _ = problem
        return
    end
    return when usize(first.data) <> usize(again.data)
      or io.argument_count(fresh) <> 2
    ok = c_argument_storage(io.argument_count(state.val), first.data,
                            second.data)
end arguments_match

extern(c) visit: (state: ptr hosted.system, depth: i32) -> (ok: bool) =
    ok = false
    return when not arguments_match(state)
    if depth > 0 then
        return when not c_reenter(state, visit, depth - 1)
    end if
    ok = arguments_match(state)
end visit

-- C main delegates capability minting to this root exactly once. All lower
-- calls, including reentrant C callbacks, receive that ordinary capability.
public extern(c) l_root: () -> (ok: bool) =
    mut state: hosted.system = hosted.host()
    ok = false
    return when not arguments_match(addr state)
    return when not c_reenter(addr state, visit, 3)
    output: io.file = io.out(state)
    message: []u8 = "native Landin io\n"
    io.write(state, output, message) else (problem)
        _ = problem
        return
    end
    ok = arguments_match(addr state)
end l_root
