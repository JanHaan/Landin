--  The import of `foo` holds foo's own spelling, so D417 qualifies it as
--  `main.foo`.  Both that candidate and its first retry, `main.foo.1`, are
--  occupied in other namespaces, a C function and an exported datum.
foo: () -> (value: i32) =
    value = 1
end foo

extern(c) link(symbol: "foo") foreign: () -> (value: i32)
extern(c) link(symbol: "main.foo") mangled_foreign: () -> (value: i32)
link(symbol: "main.foo.1") occupied: i32 = 5

payload: i32 = 7
extern(c) link(symbol: "payload") foreign_payload: () -> (value: i32)
extern(c) link(symbol: ".L1_1") block_foreign: () -> (value: i32)
extern(c) link(symbol: ".L_1_1") retry_foreign: () -> (value: i32)

public extern(c) r440_link_identity: () -> (value: i32) =
    value = foo() + foreign() + mangled_foreign() + occupied
        + payload + foreign_payload() + block_foreign() + retry_foreign()
end r440_link_identity
