-- Every nonnumeric tail is observed in registers and after GP exhaustion,
-- through both a named variadic declaration and a variadic function value.
missing: atom
optional_pointer: type = missing | ptr mut i32
callback: type = extern(c) (value: i32) -> (result: i32)
collector: type = extern(c) (placement: i32, ...) -> (result: i32)
extern(c) r440_collect_pointers: (placement: i32, ...) -> (result: i32)

public extern(c) r440_callback: (value: i32) -> (result: i32) =
    result = value * 2 + 5
end r440_callback

public extern(c) r440_check_pointer_tails: (data: ptr mut i32, other: ptr mut i32) -> (result: i32) =
    present: optional_pointer = other
    absent: optional_pointer = missing
    saved_callback: callback = r440_callback
    indirect: collector = r440_collect_pointers
    -- placement occupies rdi; all four pointer/code tails fit in GP registers.
    direct_register := r440_collect_pointers(0, data, present, absent, r440_callback)
    indirect_register := indirect(0, data, present, absent, saved_callback)
    -- Five promoted ints consume rsi through r9. Every pointer/code tail is
    -- now on the stack, including the empty optional pointer's zero carrier.
    direct_stack := r440_collect_pointers(1, 11, 22, 33, 44, 55,
        data, present, absent, r440_callback)
    indirect_stack := indirect(1, 11, 22, 33, 44, 55,
        data, present, absent, saved_callback)
    result = 1
    if direct_register == 42 and indirect_register == 42
       and direct_stack == 42 and indirect_stack == 42 then
        result = 42
    end if
end r440_check_pointer_tails
