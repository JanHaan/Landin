-- After the banks are exhausted, clang for arm64-apple-macos puts s at +0,
-- c at +8, t at +16 and d at +24 in packed, and h at +0, c at +12, k at +16,
-- s at +32, x at +40 and d at +44 in mixed.
p3: type = layout(c) struct
    v: [3]u8
end p3

p5: type = layout(c) struct
    v: [5]u8
end p5

h3: type = layout(c) struct
    a: f32
    b: f32
    c: f32
end h3

packed_handler: type = extern(c) (a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, s: p3, c: u8, t: p5, d: i16) -> (result: i32)
extern(c) c_packed: (a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, s: p3, c: u8, t: p5, d: i16) -> (result: i32)
public extern(c) l_packed: (a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, s: p3, c: u8, t: p5, d: i16) -> (result: i32) =
    if a0 == 10
       and a1 == 11
       and a2 == 12
       and a3 == 13
       and a4 == 14
       and a5 == 15
       and a6 == 16
       and a7 == 17
       and s.v[0] == 1
       and s.v[1] == 2
       and s.v[2] == 3
       and c == 9
       and t.v[0] == 4
       and t.v[1] == 5
       and t.v[2] == 6
       and t.v[3] == 7
       and t.v[4] == 8
       and d == 77
    then
        result = 42
    else
        result = 1
    end if
end l_packed

mixed_handler: type = extern(c) (a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, f0: f64, f1: f64, f2: f64, f3: f64, f4: f64, f5: f64, f6: f64, f7: f64, h: h3, c: u8, k: h3, s: p3, x: f32, d: i16) -> (result: i32)
extern(c) c_mixed: (a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, f0: f64, f1: f64, f2: f64, f3: f64, f4: f64, f5: f64, f6: f64, f7: f64, h: h3, c: u8, k: h3, s: p3, x: f32, d: i16) -> (result: i32)
public extern(c) l_mixed: (a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, f0: f64, f1: f64, f2: f64, f3: f64, f4: f64, f5: f64, f6: f64, f7: f64, h: h3, c: u8, k: h3, s: p3, x: f32, d: i16) -> (result: i32) =
    if a0 == 20
       and a7 == 27
       and f0 == 0.5
       and f7 == 7.5
       and h.a == 1.5
       and h.b == 2.5
       and h.c == 3.5
       and c == 10
       and k.a == 4.5
       and k.b == 5.5
       and k.c == 6.5
       and s.v[0] == 7
       and s.v[1] == 8
       and s.v[2] == 9
       and x == 11.5
       and d == 12
    then
        result = 42
    else
        result = 1
    end if
end l_mixed

public extern(c) landin_check: () -> (result: i32) =
    result = 42
    s: p3 = p3(v: [1, 2, 3])
    t: p5 = p5(v: [4, 5, 6, 7, 8])
    handler_0: packed_handler = c_packed
    direct_0 := c_packed(10, 11, 12, 13, 14, 15, 16, 17, s, 9, t, 77)
    indirect_0 := handler_0(10, 11, 12, 13, 14, 15, 16, 17, s, 9, t, 77)
    if not (direct_0 == 42 and indirect_0 == 42) then
        result = 1
    end if
    h: h3 = h3(a: 1.5, b: 2.5, c: 3.5)
    k: h3 = h3(a: 4.5, b: 5.5, c: 6.5)
    q: p3 = p3(v: [7, 8, 9])
    handler_1: mixed_handler = c_mixed
    direct_1 := c_mixed(20, 21, 22, 23, 24, 25, 26, 27, 0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, h, 10, k, q, 11.5, 12)
    indirect_1 := handler_1(20, 21, 22, 23, 24, 25, 26, 27, 0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, h, 10, k, q, 11.5, 12)
    if not (direct_1 == 42 and indirect_1 == 42) then
        result = 2
    end if
end landin_check
