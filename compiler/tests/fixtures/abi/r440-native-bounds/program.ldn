-- Page-end objects expose accidental full-eightbyte loads and stores.
bytes3: type = layout(c) struct
    values: [3]u8
end bytes3
extern(c) c_bytes3: (value: bytes3) -> (result: bytes3)
public extern(c) l_bytes3: (source: ptr bytes3, target: ptr mut bytes3) -> none =
    target.val = c_bytes3(source.val)
end l_bytes3

