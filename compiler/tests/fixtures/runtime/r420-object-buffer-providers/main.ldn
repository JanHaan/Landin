import core/arena
import core/fault
import core/mem
import core/pool
import hosted/heap

no_object: atom
object_result: type = no_object | ptr mut node
is_absent: (value: object_result) -> (empty: bool) =
    match value
        no_object: empty = true
        ptr: empty = false
    end match
end is_absent

node: type = struct
    next: ptr i32
    value: i32
end node
number: i32 = 37
mut evaluations: usize = 0
initial: () -> (value: node) =
    inc evaluations
    value = (next: addr number, value: 42)
end initial

exercise: (provider: type is mem.allocator, memory: provider)
          -> (okay: bool) =
    okay = false
    zero: usize = 0
    one: usize = 1
    two: usize = 2
    three: usize = 3
    mut space: fault.space = zeroed
    counted := fault.over(space, memory, zero)
    before: usize = evaluations
    mut empty := mem.new_bytes(counted, zero) else (problem)
        _ = problem
        return
    end
    empty_size: usize = begin
        view := mem.bytes(empty)
        lenof view
    end
    mem.delete_bytes(counted, empty)
    return when empty_size <> 0 or fault.attempts(counted) <> 0
    mut refused: bool = false
    absent: object_result = mem.new(counted, initial()) else (problem)
        refused = problem == mem.out_of_memory
        no_object
    end
    return when not refused or not is_absent(absent) or evaluations <> before + 1
      or fault.live(counted) <> 0 or fault.frees(counted) <> 0
    fault.permit(counted, two)
    value: ptr mut node = mem.new(counted, initial()) else (problem)
        _ = problem
        return
    end
    mut bytes := mem.new_bytes(counted, three) else (problem)
        _ = problem
        return
    end
    content_ok: bool = begin
        view := mem.bytes(bytes)
        zeroed_ok: bool = lenof view == 3 and view[0] == 0
                         and view[1] == 0 and view[2] == 0
        view[0] = 11
        view[2] = 29
        zeroed_ok and view[0] + view[2] == 40
    end
    object_ok: bool = value.val.value == 42 and value.val.next.val == 37
      and usize(value) % alignof node == 0
    mem.delete(counted, value)
    mem.delete_bytes(counted, bytes)
    mem.delete_bytes(counted, bytes)
    return when fault.live(counted) <> 0 or fault.frees(counted) <> 2
    fault.permit(counted, one)
    mut retry := mem.new_bytes(counted, three) else (problem)
        _ = problem
        return
    end
    retry_ok: bool = begin
        view := mem.bytes(retry)
        lenof view == 3 and view[0] == 0 and view[2] == 0
    end
    mem.delete_bytes(counted, retry)
    okay = content_ok and object_ok and retry_ok and evaluations == before + 2
      and fault.attempts(counted) == 4 and fault.successes(counted) == 3
      and fault.injected_failures(counted) == 1
      and fault.inner_failures(counted) == 0
      and fault.frees(counted) == 3 and fault.live(counted) == 0
end exercise

public main: () -> (code: i32) =
    code = 1
    heap := heap.new()
    heap_ok: bool = exercise(heap)
    mut arena_bytes: [256]u8 = zeroed
    mut arena_space: arena.space = zeroed
    bump := arena.over_unchecked(arena_space, addr arena_bytes[0], 256)
    arena_ok: bool = exercise(bump)
    mut pool_bytes: [128]u8 = zeroed
    mut records: [2]pool.slot = zeroed
    mut pool_space: pool.space = zeroed
    slab := pool.over(pool_space, addr pool_bytes[0], 128, 32, 2, 16,
                      records[0..<2]) else (problem)
        _ = problem
        return
    end
    fixed_ok: bool = exercise(slab)
    if heap_ok and arena_ok and fixed_ok and evaluations == 6
      and arena.used(bump) > 0 and pool.allocations(slab) == 3
      and pool.frees(slab) == 3 and pool.live(slab) == 0
      and pool.rejected_frees(slab) == 0
    then code = 42 end if
end main
