holder: type = struct
    tag: u8
    row: [2]u16
    flags: [2]bool
    repeated: [2]u16
    mixed: [3]u16
    zero_repeat: [2]u8
    zero_hybrid: [3]u8
    truths: [2]bool
end holder

mut origin: holder =
    (flags: [true, false], row: [11, 13], tag: 5,
     repeated: [of 17], mixed: [19, of 23], zero_repeat: [of 0],
     zero_hybrid: [0, of 0], truths: [of true])
copy: holder = origin
inferred := copy

public main: () -> (code: i32) =
    origin.tag = 7
    origin.row[0] = 17
    origin.row[1] = 19
    origin.flags[0] = false
    origin.flags[1] = true
    origin.repeated[0] = 29
    origin.mixed[2] = 31
    origin.zero_repeat[0] = 1
    origin.zero_hybrid[2] = 1
    origin.truths[0] = false

    if copy.tag == 5 and copy.row[0] == 11 and copy.row[1] == 13
      and copy.flags[0] and not copy.flags[1]
      and inferred.tag == 5 and inferred.row[0] == 11
      and inferred.row[1] == 13 and inferred.flags[0]
      and not inferred.flags[1]
      and copy.repeated[0] == 17 and copy.repeated[1] == 17
      and copy.mixed[0] == 19 and copy.mixed[1] == 23
      and copy.mixed[2] == 23 and copy.zero_repeat[0] == 0
      and copy.zero_repeat[1] == 0 and copy.zero_hybrid[0] == 0
      and copy.zero_hybrid[1] == 0 and copy.zero_hybrid[2] == 0
      and inferred.repeated[0] == 17 and inferred.mixed[2] == 23
      and inferred.zero_repeat[1] == 0 and inferred.zero_hybrid[2] == 0
      and copy.truths[0] and copy.truths[1] and inferred.truths[0]
    then
        code = 42
    else
        code = 1
    end if
end main
