--  D630: a block that declares the float registers a call must preserve,
--  arm64's v8-v15 and LP64D's f8, f9 and f18-f27, makes its routine save
--  and restore them.  `held` puts a value in the first of them, calls the
--  routine that overwrites them all, and reads the register back: the
--  value is there because the callee restored it, and `held` names the
--  register in both its blocks, so nothing of its own is placed there.
--  `main` also keeps floats live across every call, which the optimising
--  allocators place in those same registers.  x86-64's ABI preserves no
--  XMM register, so it has nothing here to declare.
fixed if compiler.arch == arm64 then
    clobber: (seed: f64) -> (r: f64) =
        r = assembler.block(
            "fmov d8, {s}\nfmov d9, {s}\nfmov d10, {s}\nfmov d11, {s}\nfmov d12, {s}\nfmov d13, {s}\nfmov d14, {s}\nfmov d15, {s}\nfadd {r}, d8, d15",
            in s: f64 at float = seed, out r: f64 at float,
            out _ at v8, out _ at v9, out _ at v10, out _ at v11,
            out _ at v12, out _ at v13, out _ at v14, out _ at v15)
    end clobber
    held: (value: f64) -> (seen: f64) =
        assembler.block("fmov d8, {v}", in v: f64 at float = value,
                        out _ at v8)
        _ = clobber(value + 1.0)
        seen = assembler.block("fmov {s}, d8", out s: f64 at float,
                               out _ at v8)
    end held
elsif compiler.arch == rv64 then
    clobber: (seed: f64) -> (r: f64) =
        r = assembler.block(
            "fmv.d f8, {s}\nfmv.d f9, {s}\nfmv.d f18, {s}\nfmv.d f19, {s}\nfmv.d f20, {s}\nfmv.d f21, {s}\nfmv.d f22, {s}\nfmv.d f23, {s}\nfmv.d f24, {s}\nfmv.d f25, {s}\nfmv.d f26, {s}\nfmv.d fs11, {s}\nfadd.d {r}, fs0, f27",
            in s: f64 at float = seed, out r: f64 at float,
            out _ at f8, out _ at f9, out _ at f18, out _ at f19,
            out _ at f20, out _ at f21, out _ at f22, out _ at f23,
            out _ at f24, out _ at f25, out _ at f26, out _ at f27)
    end clobber
    held: (value: f64) -> (seen: f64) =
        assembler.block("fmv.d f8, {v}", in v: f64 at float = value,
                        out _ at f8)
        _ = clobber(value + 1.0)
        seen = assembler.block("fmv.d {s}, fs0", out s: f64 at float,
                               out _ at f8)
    end held
else
    clobber: (seed: f64) -> (r: f64) =
        r = seed + seed
    end clobber
    held: (value: f64) -> (seen: f64) =
        seen = value
    end held
end if

public main: () -> (code: i32) =
    mut wrong: u32 = 0
    for round in 0..4 do
        x := f64(round) + 0.25
        a := x * 3.0
        b := x - 7.5
        c := x * x
        d := x + 100.0
        e := 0.0 - x
        if clobber(x) <> x + x then
            wrong = wrong + 1
        end if
        if held(x * 5.0) <> x * 5.0 then
            wrong = wrong + 1
        end if
        --  Each live float is what it was before the calls.
        if a <> x * 3.0 or b <> x - 7.5 or c <> x * x or d <> x + 100.0
          or e <> 0.0 - x then
            wrong = wrong + 1
        end if
    end for
    code = if wrong == 0 then 42 else i32(wrong) end if
end main
