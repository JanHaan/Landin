class: runtime
profiles: standard
summary: a nested written byte view preserves shortest-form UTF-8 validation and trapping inside unchecked
program: main.ldn
constructs: 0310, 0600, 1120, 1950, 1960
targets: linux-x86-64, linux-arm64, macos-arm64, freebsd-x86-64, freebsd-arm64, linux-rv64
traps: yes
