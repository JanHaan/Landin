--  D377 over the closed program: the only conformance of `display`
--  is box(u16)'s, materialized by an `any` made in an array literal's element, which
--  is checked after the erased call; the call dispatches through it
--  rather than trapping as one no conformance answers.
display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

box: type (t: type) = struct
    value: t
end box

box_code: (t: type, self: ptr box(t)) -> (value: i32) =
    value = 40 + i32(sizeof t)
end box_code

(t: type) box(t) is display (code: box_code)

public main: () -> (code: i32) =
    item: box(u16) = (value: 1)
    row: [1]any display = [any(addr item)]
    code = row[0].code()
end main
