class: runtime
profiles: standard
summary: the tour's line counter named a file that is not there says why on standard error in failure.words' phrase and exits 1
constructs: 0400, 0960, 1030, 1100, 1130, 1370, 1650, 1660
program: main.ldn
root: ../../../../..
run_args: tour-line-count-missing-input.txt
run_expect: output.txt
status: 1
stream: merged
targets: linux-x86-64, linux-arm64, darwin-arm64, freebsd-x86-64, freebsd-arm64, linux-rv64
