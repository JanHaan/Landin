class: runtime
profiles: standard
summary: text.step from the end of a utf8 traps as indexing there does, so a position never steps past its text
constructs: 0570, 0600, 0610, 1410, 1420, 1950, 1960
program: main.ldn
root: ../../../../..
traps: yes
targets: linux-x86-64, linux-arm64, darwin-arm64, freebsd-x86-64, freebsd-arm64, linux-rv64, cortex-m0
