pair: type = struct
    left: i32
    right: i32
end pair

public main: () -> (code: i32) =
    mut i: i32 = 0
    first := loop do
        inc i
        continue when i < 3
        break with i * 10
    end loop

    mut j: i32 = 0
    second: i32 = while j < 2 do
        inc j
    complete
        break with 7
    end while

    third: i32 = choice: loop do
        loop do
            break choice with 5
        end loop
    end choice

    fourth: pair = loop do
        break with pair(left: 8, right: 9)
    end loop

    fifth: [3]i32 = loop do
        break with [4, 5, 6]
    end loop

    source: [3]i32 = [10, 11, 12]
    sixth: []i32 = loop do
        break with source[0..<2]
    end loop

    if first == 30 and second == 7 and third == 5
      and fourth.left == 8 and fourth.right == 9
      and fifth[0] == 4 and fifth[1] == 5 and fifth[2] == 6
      and sixth[0] == 10 and sixth[1] == 11 then
        code = 42
    else
        code = 1
    end if
end main
