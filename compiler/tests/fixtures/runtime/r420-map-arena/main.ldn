import core/map
import core/mem

arena_key: type = struct
    identity: u64
end arena_key

keys_equal: (left: arena_key, right: arena_key) -> (same: bool) =
    same = left.identity == right.identity
end keys_equal

colliding_hash: (value: arena_key) -> (result: u64) =
    result = value.identity - value.identity + 6
end colliding_hash

arena_key is map.equatable (eq: keys_equal)
arena_key is map.hashable (hash: colliding_hash)

key: (identity: u64) -> (result: arena_key) =
    result = (identity: identity)
end key

has: (value: map.map(arena_key, i32), identity: u64, wanted: i32)
     -> (ok: bool) =
    found: i32 = map.get(value, key(identity)) else (problem)
        _ = problem
        ok = false
        return
    end
    ok = found == wanted
end has

public main: () -> (code: i32) =
    --  The first eight-slot table and its sixteen-slot replacement fit. The
    --  next bucket extent does not, even before its key and value extents.
    mut backing: [1000]u8 = zeroed
    mut arena := mem.arena_over(addr backing[0], lenof backing)
    mut value := map.new_map(key: arena_key, item: i32)

    map.insert(value, arena, key(1), 101) else 0
    map.insert(value, arena, key(2), 102) else 0
    map.insert(value, arena, key(3), 103) else 0
    map.insert(value, arena, key(4), 104) else 0
    map.insert(value, arena, key(5), 105) else 0
    map.insert(value, arena, key(6), 106) else 0

    --  Collision-chain replacement allocates nothing. Deletion leaves the
    --  pressure-producing tombstone, so inserting seven grows the map.
    before_update: usize = arena.used
    map.insert(value, arena, key(6), 166) else 0
    updated: bool = arena.used == before_update and map.length(value) == 6
                    and has(value, 6, 166)
    map.remove(value, key(1)) else 0
    map.insert(value, arena, key(7), 107) else 0

    map.insert(value, arena, key(8), 108) else 0
    map.insert(value, arena, key(9), 109) else 0
    map.insert(value, arena, key(10), 110) else 0
    map.insert(value, arena, key(11), 111) else 0
    map.insert(value, arena, key(12), 112) else 0
    map.insert(value, arena, key(13), 113) else 0
    grown: bool = map.length(value) == 12 and has(value, 2, 102)
                  and has(value, 7, 107) and has(value, 13, 113)

    --  Twelve-of-sixteen pressure requests capacity 32. Bounded arena
    --  exhaustion reports OOM before publication, preserving the old map.
    before_failure: usize = arena.used
    mut exhausted: bool = false
    map.insert(value, arena, key(14), 114) else (problem)
        _ = problem
        exhausted = true
    end
    mut fourteen_missing: bool = false
    _ = map.get(value, key(14)) else (problem)
        _ = problem
        fourteen_missing = true
        i32(0)
    end
    preserved: bool = exhausted and arena.used == before_failure
                      and map.length(value) == 12 and fourteen_missing
                      and has(value, 2, 102) and has(value, 6, 166)
                      and has(value, 13, 113)

    --  Arena free is deliberately a no-op. Release still drains and resets
    --  the public map composition to its logical empty state.
    before_release: usize = arena.used
    map.release_map(value, arena)
    released: bool = map.length(value) == 0
                     and mem.capacity(value.buckets) == 0
                     and mem.capacity(value.keys) == 0
                     and mem.capacity(value.values) == 0
                     and arena.used == before_release

    if updated and grown and preserved and released then
        code = 42
    else
        code = 0
    end if
end main
