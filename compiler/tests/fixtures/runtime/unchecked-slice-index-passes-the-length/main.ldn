--  The mirror of runtime/slice-index-read-traps.  The view is the first
--  two elements of storage that has four, so the removed bound edge leaves
--  the access at the computed address inside that same storage rather than
--  anywhere else: [0430]'s existing pointer non-guarantee and nothing
--  worse.
read_at: (items: []u32, index: usize) -> (r: u32) =
    unchecked begin
        r = items[index]
    end unchecked
end read_at

public main: () -> (code: i32) =
    words: [4]u32 = [10, 20, 30, 40]
    view: []u32 = words[0..<2]
    beyond: u32 = read_at(view, 3)
    if beyond == 40 then
        code = 42
    else
        code = 1
    end if
end main
