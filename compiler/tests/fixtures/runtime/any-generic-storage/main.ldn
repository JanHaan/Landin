display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

thing: type = struct
    value: i32
end thing

box: type (t: type) = struct
    value: t
end box

thing_code: (self: ptr thing) -> (value: i32) =
    value = self.val.value
end thing_code

thing is display (code: thing_code)

public main: () -> (code: i32) =
    item: thing = (value: 42)
    wrapped: box(any display) = (value: any(addr item))
    code = wrapped.value.code()
end main
