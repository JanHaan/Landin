--  The Benchmark Game's Mandelbrot workload as firmware: a fixed 32 by 32
--  image at fifty iterations, plotted as the hosted port plots it, each
--  row packed eight pixels to a byte most-significant first, and nothing
--  printed.  Every packed byte of the bitmap, the portable bitmap's body
--  without its header, is folded into a 32-bit FNV-1a hash in output
--  order; the hash is left in `checksum` for a debugger to read after the
--  run, and the status says whether it is the one the hosted port's
--  output at size 32 gives.  The arithmetic is IEEE double: in software on
--  a core without a double-precision unit, in hardware on one with it.

--- The FNV-1a hash of the bitmap, which a debugger reads by its symbol.
mut checksum: u32 = 0

size: usize = 32
expected_hash: u32 = 0x6b603ccc

fnv_basis: u32 = 0x811c9dc5

in_set: (real_coordinate: f64, imaginary_coordinate: f64)
        -> (member: bool) =
    mut real: f64 = 0.0
    mut imaginary: f64 = 0.0
    mut real_squared: f64 = 0.0
    mut imaginary_squared: f64 = 0.0
    mut iteration: u32 = 0

    while iteration < 50
      and real_squared + imaginary_squared <= 4.0
    do
        imaginary = 2.0 * real * imaginary + imaginary_coordinate
        real = real_squared - imaginary_squared + real_coordinate
        real_squared = real * real
        imaginary_squared = imaginary * imaginary
        inc iteration
    end while
    member = real_squared + imaginary_squared <= 4.0
end in_set

--- Pack one row of the `n` by `n` image into `row`, eight pixels to a
--- byte.
pack_row: (n: usize, imaginary_coordinate: f64, row: []mut u8) -> none =
    coordinate_size: f64 = f64(n)
    first: usize = 0
    for byte_column in first..<lenof row do
        start: usize = byte_column * 8
        mut bits: usize = n - start
        if bits > 8 then
            bits = 8
        end if
        mut packed: u8 = 0
        for offset in first..<bits do
            packed <<= 1
            pixel_x: usize = start + offset
            real_coordinate: f64 = 2.0 * f64(pixel_x) / coordinate_size - 1.5
            if in_set(real_coordinate, imaginary_coordinate) then
                packed |= 1
            end if
        end for
        row[byte_column] = packed << u8(8 - bits)
    end for
end pack_row

--- The FNV-1a hash of the `n` by `n` bitmap's packed rows.
render: (n: usize) -> (hash: u32) =
    mut storage: [8]u8 = zeroed
    row: []mut u8 = storage[0..<(n + 7) / 8]
    coordinate_size: f64 = f64(n)
    hash = fnv_basis
    first: usize = 0
    for y in first..<n do
        pack_row(n, 2.0 * f64(y) / coordinate_size - 1.0, row)
        for byte in row do
            hash = (hash ^ u32(byte)) *% 16777619
        end for
    end for
end render

public main: () -> (code: i32) =
    checksum = render(size)
    if checksum == expected_hash then
        code = 42
    else
        code = 1
    end if
end main
