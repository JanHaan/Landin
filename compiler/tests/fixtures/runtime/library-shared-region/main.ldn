import core/mem
import core/region

exercise: () -> (ok: bool) ! mem.out_of_memory =
    ok = false
    mut backing: [64]u8 = zeroed
    mut inner := mem.arena_over_unchecked(addr backing[0], 64)
    mut records: [1]region.allocation = zeroed
    mut state := region.over(addr inner, records[0..<1])
    address := try mem.allocate(state, usize(4), usize(1))
    address.val = 42
    return when address.val <> 42
    _ = mem.allocate(state, usize(4), usize(1)) else (problem)
        _ = problem
        mem.free(state, address, usize(4))
        ok = true
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
