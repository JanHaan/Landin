import core/mem
import core/region

exercise: () -> (ok: bool) ! mem.out_of_memory =
    ok = false
    mut backing: [64]u8 = zeroed
    mut arena_space: mem.arena_space = zeroed
    arena := mem.arena_over_unchecked(arena_space, addr backing[0], 64)
    mut ledger: region.space(1) = zeroed
    scratch := region.over(ledger, arena)
    address := try mem.allocate(scratch, usize(4), usize(1))
    address.val = 42
    return when address.val <> 42
    _ = mem.allocate(scratch, usize(4), usize(1)) else (problem)
        _ = problem
        mem.free(scratch, address, usize(4))
        ok = true
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
