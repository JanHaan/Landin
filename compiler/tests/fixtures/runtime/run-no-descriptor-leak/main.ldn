--  A child receives no descriptor but its three streams.  The parent holds
--  two files and a directory open, another child's three pipes, and a
--  listener, a connection and a UDP socket, while it starts itself again
--  with the argument `check` and the numbers of those descriptors; the
--  copy asks `poll` about each, which answers `poll_invalid` for a closed
--  descriptor and never for an open one, and names any that is open.  It names none, since every descriptor the
--  hosted provider makes is closed on exec, and the spawn closes whatever
--  else is open in the child.  `system.descriptor_of` gives each file's
--  descriptor, so the parent knows which numbers to give.
--
--  A shell trying each number by redirecting from it cannot be the check:
--  Darwin's /bin/sh copies the descriptor a redirection replaces to the
--  lowest free number from 10 up while it works, and then finds its own
--  copy at 10, and dash refuses every number above 9.
import core/io
import core/net
import core/text
import hosted/blocking
import hosted/system
import platform/posix

--  The decimal of a file's number.
number: (opened: io.file, room: []mut u8) -> (digits: []u8 from room) ! ... =
    mut line := text.over(room)
    try text.append_i32(line, i32(system.descriptor_of(opened)))
    digits = room[0..<text.length(line)]
end number

--  The copy's part: report each descriptor it was given that is open.
check: (host: blocking.host) -> none ! ... =
    out: io.file = io.out(host)
    given: usize = io.argument_count(host)
    for at in usize(1)..<given do
        digits: []u8 = text.host_bytes(try io.argument_at(host, at))
        found: u32 = try text.parse_u32(digits)
        mut entries: [1]posix.poll_entry =
            [posix.watch(posix.descriptor(i32(found)), posix.poll_input)]
        _ = try posix.poll(entries, 0)
        events: posix.poll_events = posix.happened(entries[0])
        if (events & posix.poll_invalid) == posix.poll_no_events then
            mut room: [48]u8 = zeroed
            mut line := text.over(room)
            try text.format(line, "descriptor {} is open\n", [any(addr found)])
            try io.write(host, out, room[0..<text.length(line)])
        end if
    end for
    checked: usize = given - 1
    mut room: [32]u8 = zeroed
    mut line := text.over(room)
    try text.format(line, "checked {} descriptors\n", [any(addr checked)])
    try io.write(host, out, room[0..<text.length(line)])
end check

--  The parent's part.
parent: (host: blocking.host) -> (code: i32) =
    code = 1
    first: io.file = io.open_read(host, text.host_over("/dev/null")) else (problem)
        _ = problem
        return
    end
    second: io.file = io.open_write(host, text.host_over("/dev/null")) else (problem)
        _ = problem
        return
    end
    mut buffer: [1024]u8 = zeroed
    listed: io.directory = io.open_directory(host, text.host_over("/"),
                                             buffer[0..<1024]) else (problem)
        _ = problem
        return
    end
    waiting: [2]text.host_string = [text.host_over("-c"),
                                    text.host_over("read -r line")]
    variables: [1]io.variable =
        [(name: text.host_over("PATH"), value: text.host_over("/bin:/usr/bin"))]
    piped: io.child_streams = (input: io.piped, output: io.piped,
                               errors: io.piped)
    mut other: io.child = io.spawn(host, text.host_over("/bin/sh"),
                                   waiting[0..<2], variables[0..<1],
                                   piped) else (problem)
        _ = problem
        return
    end
    code = 2
    listener: io.file = net.listen(host, net.loopback(net.ipv4, 0)) else (problem)
        _ = problem
        return
    end
    at: net.address = net.local_address(host, listener) else (problem)
        _ = problem
        return
    end
    connection: io.file = net.connect(host, at) else (problem)
        _ = problem
        return
    end
    datagrams: io.file = net.open_datagram(host,
                                           net.loopback(net.ipv4, 0)) else (problem)
        _ = problem
        return
    end
    mut rooms: [9][4]u8 = zeroed
    held: [9]io.file = [first, second, io.file(listed.handle), other.input,
                        other.output, other.errors, listener, connection,
                        datagrams]
    mut arguments: [10]text.host_string =
        [10 of text.host_over("")]
    arguments[0] = text.host_over("check")
    for at in usize(0)..<9 do
        digits: []u8 = number(held[at], rooms[at][0..<4]) else (problem)
            _ = problem
            return
        end
        arguments[1 + at] = text.host_over(digits)
    end for
    checked: io.child = io.spawn(host, posix.program_name(),
                                 arguments[0..<10], variables[0..<1],
                                 io.inheriting) else (problem)
        _ = problem
        return
    end
    ended: io.ending = io.wait(host, checked) else (problem)
        _ = problem
        return
    end
    code = 3
    match ended.how
        io.exited(given):
            return when given <> 42
        io.signalled:
            return
    end match
    io.close_input(host, other) else (problem)
        _ = problem
        return
    end
    finished: io.ending = io.wait(host, other) else (problem)
        _ = problem
        return
    end
    _ = finished
    net.close_socket(host, datagrams) else (problem)
        _ = problem
        return
    end
    net.close_socket(host, connection) else (problem)
        _ = problem
        return
    end
    net.close_socket(host, listener) else (problem)
        _ = problem
        return
    end
    io.close_directory(host, listed) else (problem)
        _ = problem
        return
    end
    io.close(host, second) else (problem)
        _ = problem
        return
    end
    io.close(host, first) else (problem)
        _ = problem
        return
    end
    code = 42
end parent

public main: () -> (code: i32) =
    host := blocking.new()
    if io.argument_count(host) == 0 then
        code = parent(host)
        return
    end if
    code = 1
    check(host) else (problem)
        _ = problem
        return
    end
    code = 42
end main
