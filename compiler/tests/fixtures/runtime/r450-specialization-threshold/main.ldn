ordered: type = concept (t: type)
    less: (a: t, b: t) -> (yes: bool)
end ordered

less_i32: (a: i32, b: i32) -> (yes: bool) = a < b end less_i32
less_u32: (a: u32, b: u32) -> (yes: bool) = a < b end less_u32
i32 is ordered (less: less_i32)
u32 is ordered (less: less_u32)

compare: (t: type is ordered, a: t, b: t) -> (yes: bool) =
    yes = false
    loop do
        loop do
            loop do
                loop do
                    _ = t.less(a, b)
                    _ = t.less(a, b)
                    _ = t.less(a, b)
                    _ = t.less(a, b)
                    _ = t.less(a, b)
                    _ = t.less(a, b)
                    _ = t.less(a, b)
                    yes = t.less(a, b)
                    break
                end loop
                break
            end loop
            break
        end loop
        break
    end loop
end compare

public main: () -> (code: i32) =
    a := compare(t: i32, a: -1, b: 1)
    b := compare(t: u32, a: u32(1), b: u32(2))
    code = if a and b then 0 else 1 end if
end main
