--  A flush whose writer fails reports the writer's own failure, and the
--  bytes it could not write stay waiting: the hosted writer refuses a
--  closed standard output with EBADF.
import core/io
import hosted/blocking

public main: () -> (code: i32) =
    code = 1
    host := blocking.new()
    output: io.file = io.out(host)
    stale: io.file = output
    io.close(host, stale) else (problem)
        _ = problem
        return
    end
    code = 2
    mut storage: [16]u8 = zeroed
    mut out := io.buffered_over(host, output, storage[0..<16])
    io.put(out, "unwritten\n") else (problem)
        _ = problem
        return
    end
    code = 3
    return when io.pending(out) <> 10
    code = 4
    io.flush(out) else (problem)
        if problem == io.io_failed and blocking.last_errno(host) == 9
          and io.pending(out) == 10
        then
            code = 42
        end if
        return
    end
end main
