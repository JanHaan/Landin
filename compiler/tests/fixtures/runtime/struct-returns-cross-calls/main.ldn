pair: type = struct
    left: i32
    right: i32
end pair

holder: type = struct
    value: pair
end holder

make: (left: i32, right: i32) -> (result: pair) =
    result = (left: left, right: right)
end make

forward: () -> (result: pair) = make(19, 23) end forward

score: (value: pair) -> (result: i32) =
    result = value.left + value.right
end score

public main: () -> (code: i32) =
    _ = make(90, 90)
    mut answer := forward()
    mut other: pair = make(1, 2)
    other.left = 40
    mut storage: holder = zeroed
    storage.value = make(10, 11)
    code = answer.left + answer.right
           + storage.value.left + storage.value.right
           + score(make(1, 2))
end main
