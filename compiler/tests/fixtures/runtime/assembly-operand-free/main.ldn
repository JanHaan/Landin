--  [1630]: a block without operands, and D230's shorthand where the target
--  has it, are the same instruction as the operand form.
fixed if compiler.arch == x86_64 then
    idle: () -> none = assembler.block("nop\npause") end idle
    through: (value: u32) -> (r: u32) = r = value + 7 end through
elsif compiler.arch == arm64 then
    idle: () -> none = assembler.block("nop\nyield") end idle
    through: (value: u32) -> (r: u32) = r = value + 7 end through
else
    idle: () -> none = assembler.block("nop\nyield") end idle
    through: (value: u32) -> (r: u32) =
        r = assembler.block("adds r0, #7", value)
    end through
end if

public main: () -> (code: i32) =
    idle()
    idle()
    code = i32(through(35))
end main
