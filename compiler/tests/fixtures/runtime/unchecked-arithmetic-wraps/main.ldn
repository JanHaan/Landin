--  The mirror of runtime/checked-overflow-traps: the same expression on
--  the same value the compiler cannot read, inside [1120]'s region.  With
--  the edge still emitted this program traps instead of returning 42.
grow: (n: u8) -> (r: u8) =
    unchecked begin
        r = n + 1
    end unchecked
end grow

public main: () -> (code: i32) =
    wrapped: u8 = grow(255)
    if wrapped == 0 then
        code = 42
    else
        code = 1
    end if
end main
