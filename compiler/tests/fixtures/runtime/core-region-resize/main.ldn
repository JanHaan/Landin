--  mem.resize through a region over a counting parent.  The block the
--  newest record holds is resized through the parent and its record follows
--  it; a block behind a newer one moves into a record of its own; a full
--  ledger refuses the move, the parent taking back the block it gave for
--  it; and releasing the region frees every block with the extent it ended
--  with, a zero extent among them.
import core/arena
import core/mem
import core/region

--  The first `count` bytes at `block` set to 1, 2, 3 and on: what a
--  resize must keep.
ramp: (block: ptr mut u8, count: usize) -> none =
    for at in usize(0)..<count do
        cell: ptr mut u8 = ptr(usize(block) + at)
        cell.val = u8(at + 1)
    end for
end ramp

holds_ramp: (block: ptr mut u8, count: usize) -> (yes: bool) =
    yes = false
    for at in usize(0)..<count do
        cell: ptr u8 = ptr(usize(block) + at)
        return when cell.val <> u8(at + 1)
    end for
    yes = true
end holds_ramp

--  A parent over an arena that counts what it is asked to resize and to
--  free, and how many bytes the frees give back.
ledger_state: type = struct
    resizes: usize
    frees: usize
    freed: usize
end ledger_state

ledger: type = struct
    state: ptr mut ledger_state
    inner: arena.arena
end ledger

ledger_alloc: (self: ledger, size: usize, alignment: usize)
              -> (block: ptr mut u8) ! mem.out_of_memory =
    block = try mem.allocate(self.inner, size, alignment)
end ledger_alloc

ledger_grow: (self: ledger, block: ptr mut u8,
              old_size: usize, new_size: usize, alignment: usize)
             -> (grown: bool) =
    _ = self.state
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end ledger_grow

ledger_resize: (self: ledger, block: ptr mut u8,
                old_size: usize, new_size: usize, alignment: usize)
               -> (moved: ptr mut u8) ! mem.out_of_memory =
    inc self.state.val.resizes
    moved = try mem.resize(self.inner, block, old_size, new_size, alignment)
end ledger_resize

ledger_free: (self: ledger, block: ptr mut u8, size: usize) -> none =
    inc self.state.val.frees
    self.state.val.freed += size
    mem.free(self.inner, block, size)
end ledger_free

ledger is mem.allocator (alloc: ledger_alloc, grow: ledger_grow,
                         resize: ledger_resize, free: ledger_free)

region_resizes: () -> (ok: bool) ! mem.out_of_memory =
    ok = false
    mut backing: [128]u8 = zeroed
    mut space: arena.space = zeroed
    memory := arena.over_unchecked(space, addr backing[0], 128)
    mut counts: ledger_state = (resizes: 0, frees: 0, freed: 0)
    parent: ledger = (state: addr counts, inner: memory)
    mut records: region.space(3) = zeroed
    scratch := region.over(records, parent)
    first := try mem.allocate(scratch, usize(4), usize(1))
    ramp(first, 4)
    --  The newest record's block is resized through the parent, here in
    --  place, and its record follows it.
    grown := try mem.resize(scratch, first, usize(4), usize(10), usize(1))
    return when usize(grown) <> usize(first) or counts.resizes <> 1
      or not holds_ramp(grown, 4)
    --  Behind a newer block it moves into a record of its own, and the
    --  parent is not asked.
    second := try mem.allocate(scratch, usize(2), usize(1))
    moved := try mem.resize(scratch, grown, usize(10), usize(12), usize(1))
    return when usize(moved) <> usize(second) + 2 or counts.resizes <> 1
      or not holds_ramp(moved, 4)
    --  The ledger is full, so moving another block is refused: the parent
    --  takes back the block it gave for the move, and the old one is kept.
    ramp(second, 2)
    mut refused: bool = false
    _ = mem.resize(scratch, second, usize(2), usize(6), usize(1))
        else (problem)
        _ = problem
        refused = true
        second
    end
    return when not refused or counts.frees <> 1 or counts.freed <> 6
      or not holds_ramp(second, 2)
    --  The newest block shrinks to nothing through the parent.
    empty := try mem.resize(scratch, moved, usize(12), usize(0), usize(1))
    return when usize(empty) <> usize(moved) or counts.resizes <> 2
    --  Release frees each record with the extent its block ended with.
    region.release(records, parent)
    ok = counts.frees == 4 and counts.freed == 6 + 0 + 2 + 10
end region_resizes

public main: () -> (code: i32) =
    code = 1
    return when not (region_resizes() else false)
    code = 42
end main
