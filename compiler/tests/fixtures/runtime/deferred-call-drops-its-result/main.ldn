bad: atom
pair: type = struct
    a: i32
    b: i32
end pair
mut calls: i32 = 0

count: () -> (n: i32) =
    inc calls
    n = calls
end count
make: () -> (p: pair) =
    inc calls
    p = (a: 1, b: 2)
end make
split: () -> (a: i32, b: i32) =
    inc calls
    a = 3
    b = 4
end split
four: () -> (row: [4]i32) =
    inc calls
    row = [5, 6, 7, 8]
end four

run: (stop: bool) -> none ! bad =
    defer count()
    defer make()
    undo split()
    undo four()
    fail bad when stop
end run

public main: () -> (code: i32) =
    run(false) else (error)
        code = 1
        return
    end
    if calls <> 2 then
        code = 2
        return
    end if
    run(true) else (error)
        code = if calls == 6 then 42 else 3 end if
        return
    end
    code = 4
end main
