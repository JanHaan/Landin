mut words: [4]u32
mut flags: [1]bool

at: (i: usize, value: u32) -> (r: u32) =
    words[i] = value
    inc words[i]
    r = words[i]
end at

at_flag: (i: usize, left: bool, right: bool) -> (r: bool) =
    flags[i] = left and right
    r = flags[i]
end at_flag

public main: () -> (code: i32) =
    if at(0, 11) == 12 and at(3, 44) == 45
        and words[0] == 12 and words[3] == 45
        and at_flag(0, true, true) == true
        and at_flag(0, true, false) == false
    then
        code = 42
    else
        code = 1
    end if
end main
