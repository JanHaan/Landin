import hosted/heap
import core/mem

empty: type = [0]u8
public main: () -> (code: i32) =
    code = 1
    mut allocator := heap.host()
    zero: usize = 0
    one: usize = 1
    two: usize = 2
    base: ptr mut u8 = mem.allocate(allocator, zero, alignof empty) else (problem)
        _ = problem
        return
    end
    other: ptr mut u8 = mem.allocate(allocator, zero, alignof empty) else (problem)
        _ = problem
        return
    end
    mut source := mem.storage_over(item: empty, base: base, slots: two)
    mut target := mem.storage_over(item: empty, base: other, slots: two)
    value: empty = zeroed
    a: usize = mem.admit(source, value) else two
    b: usize = mem.admit(source, value) else two
    refused: usize = mem.admit(source, value) else two
    c: usize = mem.transfer(source, zero, target) else two
    d: usize = mem.transfer(source, one, target) else two
    full: bool = begin
        view := mem.used(target)
        lenof view == 2
    end
    _ = mem.withdraw(target) else value
    shortened: bool = begin
        view := mem.used(target)
        lenof view == 1
    end
    _ = mem.withdraw(target) else value
    ended: bool = begin
        view := mem.used(target)
        lenof view == 0
    end
    -- Bulk transitions retain the same source/destination bounds and leave
    -- both prefixes unchanged when refused.
    mut beyond_source: bool = false
    three: usize = 3
    mem.transfer_prefix(source, target, three) else (problem)
        _ = problem
        beyond_source = true
    end
    mut limited := mem.storage_over(item: empty, base: other, slots: one)
    mut beyond_capacity: bool = false
    mem.transfer_prefix(source, limited, two) else (problem)
        _ = problem
        beyond_capacity = true
    end
    refused_unchanged: bool = mem.length(source) == 2
                             and mem.length(target) == 0
                             and mem.length(limited) == 0
    mem.transfer_prefix(source, target, two) else (problem)
        _ = problem
        return
    end
    mut occupied: bool = false
    mem.transfer_prefix(source, target, zero) else (problem)
        _ = problem
        occupied = true
    end
    bulk_full: bool = mem.length(target) == 2
    mem.clear(target)
    mem.transfer_prefix(source, target, zero) else (problem)
        _ = problem
        return
    end
    bulk_empty: bool = mem.length(target) == 0
    positive_base: ptr mut u8 = mem.allocate(allocator, one, alignof u8)
        else (problem)
        _ = problem
        return
    end
    mut positive := mem.storage_over(item: u8, base: positive_base, slots: one)
    _ = mem.admit(positive, u8(17)) else one
    --  A sized prefix is copied item by item into its own backing.
    positive_other: ptr mut u8 = mem.allocate(allocator, one, alignof u8)
        else (problem)
        _ = problem
        return
    end
    mut positive_target := mem.storage_over(item: u8, base: positive_other, slots: one)
    mem.transfer_prefix(positive, positive_target, one) else (problem)
        _ = problem
        return
    end
    positive_copied: bool = mem.length(positive) == 1
                            and mem.length(positive_target) == 1
                            and (mem.get(positive_target, zero) else u8(0)) == 17
    mem.clear(positive)
    mem.clear(positive_target)
    _ = mem.dispose(positive) else positive_base
    _ = mem.dispose(positive_target) else positive_other
    mem.free(allocator, positive_base, one)
    mem.free(allocator, positive_other, one)
    _ = mem.withdraw(source) else value
    _ = mem.withdraw(source) else value
    released: ptr mut u8 = mem.dispose(source) else (problem)
        _ = problem
        return
    end
    released_other: ptr mut u8 = mem.dispose(target) else (problem)
        _ = problem
        return
    end
    exact: bool = usize(released) == usize(base)
                 and usize(released_other) == usize(other)
    mem.free(allocator, released, zero)
    mem.free(allocator, released_other, zero)
    if a == 0 and b == 1 and refused == 2 and c == 0 and d == 1
      and full and shortened and ended and exact
      and beyond_source and beyond_capacity and refused_unchanged
      and occupied and bulk_full and bulk_empty
      and positive_copied
      and mem.capacity(source) == 0 and mem.capacity(target) == 0
    then
        code = 42
    end if
end main
