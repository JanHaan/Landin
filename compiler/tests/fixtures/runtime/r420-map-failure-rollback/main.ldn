import core/fault
import core/cmp
import core/map
import core/mem
import core/pool

fixed_provider: type = pool.provider

--  Every key hashes alike, so each insert probes the same chain. The
--  library's own u64 evidence cannot be overridden [1280]; the colliding
--  key is a distinct wrapper with its own.
colliding: type = distinct u64

key_equal: (left: colliding, right: colliding) -> (same: bool) =
    same = u64(left) == u64(right)
end key_equal

colliding_hash: (value: colliding) -> (result: u64) =
    _ = value
    result = 6
end colliding_hash

colliding is cmp.equatable (equal: key_equal)
colliding is cmp.hashable (hash: colliding_hash)

node: type = struct
    payload: i32
end node

n1: node = (payload: 11)
n2: node = (payload: 22)
n3: node = (payload: 33)
n4: node = (payload: 44)
n5: node = (payload: 55)
n6: node = (payload: 66)
n7: node = (payload: 77)

has: (value: map.map(colliding, ptr node), key: colliding, wanted: i32)
     -> (ok: bool) =
    found: ptr node = map.get(value, key) else (problem)
        _ = problem
        ok = false
        return
    end
    ok = found.val.payload == wanted
end has

failure_case: (allowed: usize, rollback_frees: usize) -> (ok: bool) =
    --  Six uniform reclaiming slots hold the three old and three replacement
    --  allocations simultaneously. 512 bytes holds the capacity-sixteen
    --  bucket extent after adding live links.
    mut words: [385]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]) + 1)
    extent: usize = 3079
    slot_size: usize = 512
    slot_count: usize = 6
    alignment: usize = 8
    mut records: [6]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut pool_space: pool.space = zeroed
    inner := pool.over
        (pool_space, base, extent, slot_size, slot_count, alignment,
         bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end

    three: usize = 3
    mut space: fault.space = zeroed
    budget := fault.over
        (inner_provider: fixed_provider, state: space, inner: inner,
         allowed_attempts: three)
    mut value := map.new(key: colliding, item: ptr node)
    k1: colliding = colliding(u64(1))
    k2: colliding = colliding(u64(2))
    k3: colliding = colliding(u64(3))
    k4: colliding = colliding(u64(4))
    k5: colliding = colliding(u64(5))
    k6: colliding = colliding(u64(6))
    k7: colliding = colliding(u64(7))
    map.insert(value, budget, k1, addr n1) else 0
    map.insert(value, budget, k2, addr n2) else 0
    map.insert(value, budget, k3, addr n3) else 0
    map.insert(value, budget, k4, addr n4) else 0
    map.insert(value, budget, k5, addr n5) else 0
    map.insert(value, budget, k6, addr n6) else 0

    mut initial: bool = map.length(value) == 6
                        and fault.attempts(budget) == 3
                        and fault.successes(budget) == 3
                        and fault.frees(budget) == 0
                        and fault.live(budget) == 3
                        and pool.allocations(inner) == 3
                        and pool.frees(inner) == 0
                        and pool.live(inner) == 3

    --  An existing-key update at the six-of-eight threshold needs no growth.
    zero: usize = 0
    fault.permit(budget, zero)
    map.insert(value, budget, k6, addr n7) else (problem)
        _ = problem
        initial = false
    end
    updated_without_allocation: bool = map.length(value) == 6
                                       and has(value, k6, 77)
                                       and has(value, k1, 11)
                                       and fault.attempts(budget) == 3
                                       and fault.injected_failures(budget) == 0
                                       and fault.frees(budget) == 0
                                       and fault.live(budget) == 3

    fault.permit(budget, allowed)
    mut failed: bool = false
    map.insert(value, budget, k7, addr n7) else (problem)
        _ = problem
        failed = true
    end

    --  No old allocation was released, every acquired replacement was, and
    --  all old logical contents remain observable after each failure stage.
    mut preserved: bool = failed and map.length(value) == 6
                          and has(value, k2, 22) and has(value, k3, 33)
                          and has(value, k6, 77)
                          and fault.frees(budget) == rollback_frees
                          and fault.live(budget) == 3
                          and pool.frees(inner) == rollback_frees
                          and pool.live(inner) == 3
                          and pool.rejected_frees(inner) == 0
    mut seventh_missing: bool = false
    _ = map.get(value, k7) else (problem)
        _ = problem
        seventh_missing = true
    end
    preserved = preserved and seventh_missing

    --  The rollback returned every temporary slot to the pool. A three-call
    --  retry can therefore coexist with all three unchanged old allocations.
    fault.permit(budget, three)
    map.insert(value, budget, k7, addr n7) else (problem)
        _ = problem
        preserved = false
    end
    retried: bool = map.length(value) == 7
                   and map.slots(value) == 16
                   and has(value, k2, 22)
                   and has(value, k4, 44) and has(value, k7, 77)
                   and fault.frees(budget) == rollback_frees + 3
                   and fault.live(budget) == 3
                   and pool.frees(inner) == rollback_frees + 3
                   and pool.live(inner) == 3
                   and pool.rejected_frees(inner) == 0

    expected_allocations: usize = 6 + allowed
    expected_attempts: usize = 7 + allowed
    counts: bool = fault.attempts(budget) == expected_attempts
                   and fault.delegated(budget) == expected_allocations
                   and fault.successes(budget) == expected_allocations
                   and fault.injected_failures(budget) == 1
                   and fault.inner_failures(budget) == 0
                   and pool.allocations(inner) == expected_allocations

    map.release(value, budget)
    released: bool = map.length(value) == 0
                     and fault.frees(budget) == rollback_frees + 6
                     and fault.live(budget) == 0
                     and pool.frees(inner) == rollback_frees + 6
                     and pool.live(inner) == 0
                     and pool.rejected_frees(inner) == 0
    ok = initial and updated_without_allocation and preserved
         and retried and counts and released
end failure_case

churn_case: () -> (ok: bool) =
    mut words: [64]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]))
    mut space: mem.arena_space = zeroed
    arena := mem.arena_over_unchecked(space, base, lenof words * sizeof u64)
    mut value := map.new(key: colliding, item: ptr node)
    map.insert(value, arena, colliding(u64(1)), addr n1) else 0
    map.insert(value, arena, colliding(u64(2)), addr n2) else 0
    map.insert(value, arena, colliding(u64(3)), addr n3) else 0
    map.insert(value, arena, colliding(u64(4)), addr n4) else 0
    map.insert(value, arena, colliding(u64(5)), addr n5) else 0
    map.insert(value, arena, colliding(u64(6)), addr n6) else 0
    before: usize = mem.arena_used(arena)
    mut departing: colliding = colliding(u64(1))
    mut arriving: colliding = colliding(u64(7))
    mut cycles: usize = 0
    mut intact: bool = true
    while cycles < 32 do
        map.remove(value, departing) else (problem)
            _ = problem
            intact = false
        end
        map.insert(value, arena, arriving, addr n7) else (problem)
            _ = problem
            intact = false
        end
        intact = intact and mem.arena_used(arena) == before
                 and map.slots(value) == 8
                 and map.length(value) == 6
                 and has(value, arriving, 77)
                 and has(value, colliding(u64(6)), 66)
        departing = arriving
        arriving = colliding(u64(arriving) + 1)
        inc cycles
    end while
    map.release(value, arena)
    ok = intact and mem.arena_used(arena) == before and map.length(value) == 0
end churn_case

public main: () -> (code: i32) =
    if failure_case(0, 0) and failure_case(1, 1)
      and failure_case(2, 2) and churn_case()
    then
        code = 42
    else
        code = 0
    end if
end main
