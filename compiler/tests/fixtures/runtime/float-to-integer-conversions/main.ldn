module_fraction: f64 = 127.9
module_whole: i8 = i8(module_fraction)
module_high: u64 = u64(f64(0x1.fffffffffffffp63))

to_i8: (value: f64) -> (result: i8) =
    result = i8(value)
end to_i8

to_u8: (value: f64) -> (result: u8) =
    result = u8(value)
end to_u8

to_i64: (value: f64) -> (result: i64) =
    result = i64(value)
end to_i64

to_u64: (value: f64) -> (result: u64) =
    result = u64(value)
end to_u64

to_u64_f32: (value: f32) -> (result: u64) =
    result = u64(value)
end to_u64_f32

public main: () -> (code: i32) =
    if i32(42.75) == 42
      and to_i8(-128.9) == -128
      and to_u8(-0.75) == 0
      and to_i64(-0x1.0p63) == -9223372036854775808
      and to_u64(0x1.fffffffffffffp63) == 18446744073709549568
      and to_u64_f32(0x1.fffffep63) == 18446742974197923840
      and module_whole == 127
      and module_high == 18446744073709549568 then
        code = 42
    else
        code = 1
    end if
end main
