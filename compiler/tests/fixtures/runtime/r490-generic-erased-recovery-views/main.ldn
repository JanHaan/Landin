problem, denied: atom
leaf: () -> none ! ... = fail problem end leaf
deny: () -> none ! ... = fail denied end deny
display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display
box: type (t: type) = (value: i32)
box_code: (t: type, self: ptr box(t)) -> (value: i32) =
    value = self.val.value
end box_code
(t: type) box(t) is display (code: box_code)
wrap: (t: type, value: t, code: i32) -> (result: box(t)) =
    _ = value
    result = (value: code)
end wrap
run: (t: type, value: t) -> (code: i32) =
    _ = value
    code = 0
    leaf() else (error)
        alias := error
        held := wrap(alias, 17)
        erased: any display = any(addr held)
        code += erased.code()
    end
    deny() else (error)
        held := wrap(error, 25)
        erased: any display = any(addr held)
        code += erased.code()
    end
end run
public main: () -> (code: i32) =
    first := run(1)
    second := run(false)
    code = if first == 42 and second == 42 then 42 else 1 end if
end main
