import core/mem
import core/spill

exercise: () -> (ok: bool) ! mem.out_of_memory | mem.empty | mem.out_of_bounds =
    ok = false
    mut backing: [32]u8 = zeroed
    mut state := mem.arena_over_unchecked(addr backing[0], 32)
    mut values := spill.new(item: i32, inline_slots: 1)
    try spill.push(values, state, i32(41))
    return when spill.length(addr values) <> 1 or mem.arena_used(state) <> 0
    slot: ptr mut i32 = try spill.at(values, usize(0))
    slot.val = 42
    value := try spill.pop(values)
    return when value <> 42
    _ = spill.pop(values) else (problem)
        ok = problem == mem.empty and spill.length(addr values) == 0
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
