import core/arena
import core/fault
import core/mem

no_allocation: atom
allocation: type = no_allocation | ptr mut u8
is_absent: (value: allocation) -> (empty: bool) =
    match value
        no_allocation: empty = true
        ptr: empty = false
    end match
end is_absent

public main: () -> (code: i32) =
    code = 1
    zero: usize = 0
    one: usize = 1
    two: usize = 2
    three: usize = 3
    eight: usize = 8
    sixteen: usize = 16
    sixty_three: usize = 63
    maximum: usize = 0 -% 1

    mut bytes: [80]u8 = zeroed
    raw_base: ptr mut u8 = addr bytes[0]
    misaligned_base: ptr mut u8 =
        ptr((usize(raw_base) + 7) / 8 * 8 + 1)
    mut space: arena.space = zeroed
    memory := arena.over_unchecked(space, misaligned_base, sixty_three)

    zero_unaligned: ptr mut u8 =
        mem.allocate(memory, zero, zero) else (problem)
        _ = problem
        return
    end
    aligned: ptr mut u8 = mem.allocate(memory, three, eight) else (problem)
        _ = problem
        return
    end
    impossible_alignment: allocation =
        mem.allocate(memory, zero, maximum) else no_allocation

    mut exact_bytes: [16]u8 = zeroed
    exact_base: ptr mut u8 = addr exact_bytes[0]
    mut exact_space: arena.space = zeroed
    exact := arena.over_unchecked(exact_space, exact_base, sixteen)
    whole: ptr mut u8 = mem.allocate(exact, sixteen, one) else (problem)
        _ = problem
        return
    end
    beyond: allocation = mem.allocate(exact, one, one) else no_allocation
    empty_at_end: ptr mut u8 = mem.allocate(exact, zero, one) else (problem)
        _ = problem
        return
    end

    mut limited_space: arena.space = zeroed
    limited_arena := arena.over_unchecked(limited_space, misaligned_base,
                                              sixty_three)
    --  The backing refuses the size boundary; that refusal reached the arena
    --  and so spends one of the three permits.
    mut counted_space: fault.space = zeroed
    limited := fault.over(counted_space, limited_arena, three)
    first: ptr mut u8 = mem.allocate(limited, one, eight) else (problem)
        _ = problem
        return
    end
    size_boundary: allocation =
        mem.allocate(limited, maximum, one) else no_allocation
    second: ptr mut u8 = mem.allocate(limited, zero, zero) else (problem)
        _ = problem
        return
    end

    mut top_space: arena.space = zeroed
    top := arena.over_unchecked(top_space, raw_base, maximum)
    at_top: ptr mut u8 =
        mem.allocate(top, zero, maximum) else (problem)
        _ = problem
        return
    end
    rounding_past_top: allocation =
        mem.allocate(top, zero, two) else no_allocation
    past_top: allocation = mem.allocate(top, one, maximum) else no_allocation

    mut limited_top_space: arena.space = zeroed
    limited_top_arena := arena.over_unchecked(limited_top_space, raw_base,
                                                  maximum)
    mut counted_top_space: fault.space = zeroed
    limited_top := fault.over(counted_top_space, limited_top_arena, two)
    limited_at_top: ptr mut u8 =
        mem.allocate(limited_top, zero, maximum) else (problem)
        _ = problem
        return
    end
    limited_rounding_past_top: allocation =
        mem.allocate(limited_top, zero, two) else no_allocation

    --  Direct allocator calls can request divisors other than powers of two.
    mut odd_space: arena.space = zeroed
    odd := arena.over_unchecked(odd_space, misaligned_base, sixty_three)
    odd_first: ptr mut u8 = mem.allocate(odd, three, three) else (problem)
        _ = problem
        return
    end
    six: usize = 6
    odd_second: ptr mut u8 = mem.allocate(odd, two, six) else (problem)
        _ = problem
        return
    end

    if usize(zero_unaligned) == usize(misaligned_base)
      and usize(aligned) % 8 == 0
      and arena.used(memory) == usize(aligned) - usize(misaligned_base) + 3
      and is_absent(impossible_alignment)
      and usize(whole) == usize(exact_base)
      and arena.used(exact) == 16
      and is_absent(beyond)
      and usize(empty_at_end) == usize(exact_base) + 16
      and usize(first) % 8 == 0
      and arena.used(limited_arena) == usize(first) - usize(misaligned_base) + 1
      and is_absent(size_boundary)
      and usize(second) == usize(misaligned_base) + arena.used(limited_arena)
      and fault.remaining(limited) == 0 and fault.successes(limited) == 2
      and fault.inner_failures(limited) == 1
      and usize(at_top) == maximum
      and arena.used(top) == maximum - usize(raw_base)
      and is_absent(rounding_past_top)
      and is_absent(past_top)
      and usize(limited_at_top) == maximum
      and is_absent(limited_rounding_past_top)
      and arena.used(limited_top_arena) == maximum - usize(raw_base)
      and fault.remaining(limited_top) == 0
      and fault.inner_failures(limited_top) == 1
      and fault.successes(limited_top) == 1 and fault.frees(limited_top) == 0
      and usize(odd_first) % three == 0
      and usize(odd_second) % six == 0
      and arena.used(odd) == usize(odd_second) - usize(misaligned_base) + two
    then
        code = 42
    else
        code = 1
    end if
end main
