--  The hosted provider's clocks and entropy: the monotonic clock never
--  goes back across many readings, a sleep returns no sooner than it was
--  asked to as that clock measures it, a sleep of zero returns, the wall
--  clock reads a time after this item was written and moves with the
--  monotonic one, and the system's entropy fills small buffers
--  differently each time, a large one and an empty one, and seeds a
--  generator.  Each check that fails returns its own code.
import core/io
import core/random
import core/time
import hosted/system

--  The wall clock's reading in nanoseconds since 1970.
wall_nanoseconds: (host: system.host) -> (at: i64) =
    wall: time.wall_time = time.wall_now(host)
    at = wall.seconds * 1000000000 + i64(wall.nanoseconds)
end wall_nanoseconds

--  Whether ten thousand readings of the monotonic clock never go back.
in_order: (host: system.host) -> (yes: bool) =
    yes = false
    mut last: time.instant = time.now(host)
    for round in usize(0)..<10000 do
        _ = round
        reading: time.instant = time.now(host)
        return when reading < last
        last = reading
    end for
    yes = true
end in_order

--  Whether a sleep of SPAN lasted at least SPAN on the monotonic clock,
--  and no more than a minute.
slept_for: (host: system.host, span: time.duration) -> (yes: bool) =
    start: time.instant = time.now(host)
    time.sleep(host, span)
    took: time.duration = time.elapsed(start, time.now(host))
    yes = took >= span and took < time.seconds(60)
end slept_for

--  Whether BYTES are all zero.
all_zero: (bytes: []u8) -> (yes: bool) =
    yes = false
    for byte in bytes do
        return when byte <> 0
    end for
    yes = true
end all_zero

--  A buffer far larger than a seed.
mut large: [300000]u8

--  Whether the system's entropy fills two buffers differently, a large
--  one and an empty one.
entropy_answers: (host: system.host) -> (yes: bool) ! ... =
    yes = false
    mut first: [64]u8 = zeroed
    mut second: [64]u8 = zeroed
    try io.fill_random(host, first[0..<64])
    try io.fill_random(host, second[0..<64])
    return when all_zero(first[0..<64]) or all_zero(second[0..<64])
    mut same: bool = true
    for at in usize(0)..<64 do
        if first[at] <> second[at] then same = false end if
    end for
    return when same
    try io.fill_random(host, large[0..<300000])
    return when all_zero(large[299936..<300000])
    mut empty: [1]u8 = zeroed
    try io.fill_random(host, empty[0..<0])
    yes = system.last_errno(host) == 0
end entropy_answers

--  Two generators seeded from the system's entropy draw differently.
seeded_apart: (host: system.host) -> (yes: bool) ! ... =
    mut one := try random.from_entropy(host)
    mut other := try random.from_entropy(host)
    yes = random.next(one) <> random.next(other)
end seeded_apart

public main: () -> (code: i32) =
    host := system.new()
    code = 1
    return when not in_order(host)
    code = 2
    return when not slept_for(host, time.milliseconds(20))
      or not slept_for(host, time.microseconds(1500))
    code = 3
    return when not slept_for(host, time.duration(0))
    code = 4
    --  2026-01-01T00:00:00Z, before which no run of this program is.
    wall: time.wall_time = time.wall_now(host)
    return when wall.seconds < 1767225600 or wall.nanoseconds >= 1000000000
    code = 5
    before: i64 = wall_nanoseconds(host)
    time.sleep(host, time.milliseconds(10))
    after: i64 = wall_nanoseconds(host)
    return when after - before < 0 or after - before > 60000000000
    code = 6
    answered: bool = entropy_answers(host) else (problem)
        _ = problem
        return
    end
    return when not answered
    code = 7
    apart: bool = seeded_apart(host) else (problem)
        _ = problem
        return
    end
    return when not apart
    code = 42
end main
