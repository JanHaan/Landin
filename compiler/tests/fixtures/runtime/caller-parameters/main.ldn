site: type = struct
    file_id: u32
    line: u32
    column: u32
end site

capture: (caller where: site) -> (result: site) =
    result = where
end capture

forward: (caller where: site) -> (result: site) =
    result = capture(where: where)
end forward

own: (caller where: site) -> (result: site) =
    _ = where.line
    result = capture() -- own
end own

pair: (caller first: site, value: u32, caller last: site)
      -> (result: bool) =
    result = first.file_id == last.file_id and first.line == last.line
             and first.column == last.column and value == 7
end pair

generic: (element: type, value: element, caller where: site) -> (result: site) =
    _ = value
    result = forward(where: where)
end generic

public main: () -> (code: i32) =
    direct := capture() -- direct
    forwarded := forward() -- forwarded
    local := own()
    callback: (caller renamed: site) -> (result: site) = capture
    indirect := callback() -- indirect
    generic_site := generic(7) -- generic_site
    code = 1
    if direct.file_id <> 1 or direct.line <> 32
      or direct.column <> 15 then return end if
    if forwarded.file_id <> 1 or forwarded.line <> 33
      or forwarded.column <> 18 then return end if
    if local.line <> 17 or local.column <> 14 then return end if
    if indirect.line <> 36 or indirect.column <> 17 then
        return
    end if
    if generic_site.line <> 37 or generic_site.column <> 21 then
        return
    end if
    if not pair(7) or sizeof site <> 12 then return end if
    elsewhere := remote()
    if elsewhere.file_id <> 2 or elsewhere.line <> 2
      or elsewhere.column <> 14 then return end if
    saved: site = direct
    if saved.file_id <> direct.file_id or saved.line <> direct.line
      or saved.column <> direct.column then return end if
    first := capture() second := capture()
    if first.line <> second.line or first.column >= second.column then
        return
    end if
    code = 42
end main
