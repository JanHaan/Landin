import core/fault
import hosted/heap
import core/mem

no_object: atom
object_result: type = no_object | ptr mut u32
is_absent: (value: object_result) -> (empty: bool) =
    match value
        no_object: empty = true
        ptr: empty = false
    end match
end is_absent

counter: type = concept (t: type)
    bump: (self: ptr mut t) -> (result: i32)
end counter
node: type = struct
    value: i32
end node
bump_node: (self: ptr mut node) -> (result: i32) =
    inc self.val.value
    result = self.val.value
end bump_node
node is counter (bump: bump_node)
bundle: type = struct
    sentinel: u32
    head: ptr mut node
    action: any counter
    bytes: []mut u8
end bundle
filter: type = struct
    needle: utf8
end filter
keep_text: (provider: type is mem.allocator, inout state: provider,
            escaping source: utf8)
           -> (result: ptr mut filter) ! mem.out_of_memory =
    initial: filter = (needle: source)
    result = try mem.new(state, initial)
end keep_text
empty: type = [0]u8
mut target: node = (value: 11)
mut data: [2]u8 = [17, 23]
mut evaluations: u32 = 0
initial_value: () -> (value: u32) =
    inc evaluations
    value = 29
end initial_value

public main: () -> (code: i32) =
    code = 1
    mut heap_state := heap.host()
    zero: usize = 0
    four: usize = 4
    mut state := fault.new(addr heap_state, zero)
    mut refused: bool = false
    failed: object_result = mem.new(state, initial_value()) else (problem)
        _ = problem
        refused = true
        no_object
    end
    fault.permit(state, four)
    scalar: ptr mut u32 = mem.new(state, initial_value()) else (problem)
        _ = problem
        return
    end
    initial: bundle = (sentinel: 101, head: addr target,
                       action: any(addr target), bytes: data[0..<2])
    object: ptr mut bundle = mem.new(state, initial) else (problem)
        _ = problem
        return
    end
    nothing: empty = zeroed
    empty_object: ptr mut empty = mem.new(state, nothing) else (problem)
        _ = problem
        return
    end
    text: utf8 = "needle"
    filter_object: ptr mut filter = keep_text(state, text) else (problem)
        _ = problem
        return
    end
    text_ok: bool = begin
        saved := filter_object.val.needle
        lenof saved == 6 and saved[0] == 'n' and saved[1] == 'e'
          and saved[2] == 'e' and saved[3] == 'd' and saved[4] == 'l'
          and saved[5] == 'e'
    end
    scalar_ok: bool = scalar.val == 29
    object_ok: bool = begin
        saved: any counter = object.val.action
        bumped: i32 = saved.bump()
        object.val.bytes[1] = 31
        object.val.head.val.value += 2
        bumped == 12 and object.val.sentinel == 101
    end
    mem.delete(state, scalar)
    mem.delete(state, object)
    mem.delete(state, empty_object)
    mem.delete(state, filter_object)
    if refused and is_absent(failed) and evaluations == 2
      and scalar_ok and object_ok and text_ok and target.value == 14
      and data[0] == 17 and data[1] == 31
      and fault.attempts(state) == 5 and fault.successes(state) == 4
      and fault.injected_failures(state) == 1
      and fault.frees(state) == 4 and fault.live(state) == 0
    then
        code = 42
    end if
end main
