wrap: (a: [3]u8) -> (r: [3]u8) =
    unchecked begin r = a + 1 end unchecked
end wrap
public main: () -> (code: i32) =
    a: [3]u8 = [254, 255, 0]
    b := a +% 2
    c := 1 -% a
    d := a *% 2
    e := wrap(a)
    f := a % 7
    if b[0] == 0 and b[1] == 1 and b[2] == 2
      and c[0] == 3 and c[1] == 2 and c[2] == 1
      and d[0] == 252 and d[1] == 254 and d[2] == 0
      and e[0] == 255 and e[1] == 0 and e[2] == 1
      and f[0] == 2 and f[1] == 3 and f[2] == 0
    then code = 42 else code = 1 end if
end main
