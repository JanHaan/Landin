import core/io

exercise: () -> (ok: bool) ! io.empty_path | io.path_contains_nul | io.path_too_long =
    ok = false
    source: [2]u8 = [65, 66]
    mut scratch: [3]u8 = zeroed
    terminated := try io.terminate_path(source[0..<2], scratch[0..<3])
    return when terminated.val <> 65 or scratch[2] <> 0
    _ = io.terminate_path(source[0..<2], scratch[0..<1]) else (problem)
        ok = problem == io.path_too_long and scratch[0] == 65
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
