import core/io
import hosted/io as hosted
import core/text

memory_word: [5]u8 = [97, 108, 112, 104, 97]
memory_number: [10]u8 = [52, 50, 57, 52, 57, 54, 55, 50, 57, 53]
memory_empty: [1]u8 = [0]

--  Each world's two arguments, read as text through the checked
--  conversion, with nothing copied.
pair_is_expected: (world: any io.world, expected_count: usize)
                  -> (yes: bool) =
    yes = false
    return when world.argument_count() <> expected_count
    word_argument: text.host_string = world.argument(0) else (problem)
        _ = problem
        return
    end
    number_argument: text.host_string = world.argument(1) else (problem)
        _ = problem
        return
    end
    word: utf8 = text.from_host(word_argument) else (problem)
        _ = problem
        return
    end
    number: utf8 = text.from_host(number_argument) else (problem)
        _ = problem
        return
    end
    parsed: u32 = text.to_u32(number) else (problem)
        _ = problem
        return
    end
    yes = text.equal(word, "alpha") and parsed == 4294967295
end pair_is_expected

--  Whether ARGUMENT lends exactly the bytes at EXPECTED, not a copy.
lends: (argument: text.host_string, expected: []u8) -> (yes: bool) =
    bytes: []u8 = text.host_bytes(argument)
    yes = lenof bytes == lenof expected
          and usize(addr bytes[0]) == usize(addr expected[0])
end lends

public main: () -> (code: i32) =
    code = 1
    host := hosted.host()
    host_world: any io.world = any(addr host)
    return when not pair_is_expected(host_world, 2)

    arguments: [3][]u8 = [memory_word[0..<5], memory_number[0..<10],
                          memory_empty[0..<0]]
    files: []mut io.memory_file = []
    output: []mut u8 = []
    errors: []mut u8 = []
    mut state: io.memory_space = zeroed
    memory := io.memory_over(state, files, arguments[0..<3], "", output,
                             errors)
    memory_over: any io.world = any(addr memory)
    return when not pair_is_expected(memory_over, 3)

    lent: text.host_string = memory_over.argument(0) else (problem)
        _ = problem
        return
    end
    return when not lends(lent, memory_word[0..<5])

    empty_argument: text.host_string = memory_over.argument(2) else (problem)
        _ = problem
        return
    end
    empty_bytes: []u8 = text.host_bytes(empty_argument)
    empty_text: utf8 = text.from_host(empty_argument) else (problem)
        _ = problem
        return
    end
    if lenof empty_bytes == 0 and text.equal(empty_text, "")
      and state.open_calls == 0 and state.read_calls == 0
      and state.write_calls == 0 and state.close_calls == 0
    then code = 42 end if
end main
