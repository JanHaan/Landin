arena: type = struct
    value: i32
end arena

ordinary: (value: arena) -> (result: i32) =
    result = value.value
end ordinary

public main: () -> (code: i32) =
    value: arena = arena(value: 40)
    mut arena: i32 = ordinary(value)
    arena = arena + 1
    arena: loop do
        inc arena
        break arena when arena > 41
    end arena
    code = arena
end main
