--  A connection to a port nothing listens on is refused.  The program
--  listens on a free port and closes the listener again, which leaves
--  nothing behind the port, so the system answers the connection at once
--  with ECONNREFUSED, which the hosted provider keeps.  Over IPv4 and IPv6.
import core/io
import core/net
import hosted/system
import platform/posix

--  Whether a connection to a port just closed is refused.
refused: (host: system.host, family: net.address_family) -> (yes: bool)
         ! ... =
    listener: io.file = try net.listen(host, net.loopback(family, 0))
    at: net.address = try net.local_address(host, listener)
    try net.close_socket(host, listener)
    yes = false
    connected: io.file = net.connect(host, at) else (problem)
        yes = problem == net.refused
              and system.last_errno(host) == posix.number(posix.econnrefused)
        return
    end
    try net.close_socket(host, connected)
end refused

public main: () -> (code: i32) =
    host := system.new()
    code = 1
    families: [2]net.address_family = [net.ipv4, net.ipv6]
    for family in families do
        yes: bool = refused(host, family) else (problem)
            _ = problem
            return
        end
        return when not yes
        inc code
    end for
    code = 42
end main
