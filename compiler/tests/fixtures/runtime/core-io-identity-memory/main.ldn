import core/io
import core/io/fake
import core/text

public main: () -> (code: i32) =
    code = 1
    mut first: [1]u8 = [65]
    mut second: [1]u8 = [66]
    mut files: [2]io.memory_file = [
      (name: "a", contents: first[0..<1], length: 1, cursor: 0,
       readable: false, writable: false, state: io.closed_slot),
      (name: "b", contents: second[0..<1], length: 1, cursor: 0,
       readable: true, writable: true, state: io.closed_slot)]
    args: [1][]u8 = [first[0..<0]]
    mut out: [0]u8 = zeroed
    mut err: [0]u8 = zeroed
    mut state: io.memory_space = zeroed
    memory := io.memory_over(state, files[0..<2], args[0..<0], "",
                             out[0..<0], err[0..<0])
    a: text.host_string = text.host_over("a")
    b: text.host_string = text.host_over("b")
    missing: text.host_string = text.host_over("c")
    distinct: bool = io.same_file(memory, a, b) else (problem)
        _ = problem
        return
    end
    return when distinct
    world: any io.world = any(addr memory)
    same: bool = world.same_file(a, a) else (problem)
        _ = problem
        return
    end
    return when not same
    absent: bool = world.same_file(a, missing) else (problem)
        _ = problem
        return
    end
    return when absent
    mut refused: bool = false
    _ = world.same_file(missing, a) else (problem)
        refused = problem == io.io_failed
        false
    end
    return when not refused or state.opens <> 0 or state.closes <> 0
      or files[0].state <> io.closed_slot or files[1].state <> io.closed_slot or first[0] <> 65 or second[0] <> 66
      or files[0].length <> 1 or files[1].length <> 1
    code = 42
end main
