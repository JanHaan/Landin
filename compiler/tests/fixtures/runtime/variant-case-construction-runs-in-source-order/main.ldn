choice: type = struct
    prefix: u8
    kind: variant
        leaf |
        pair: (first: u8, second: u8) |
        row: (values: [2]u16)
    end kind
    tail: u8
end choice

mut calls: u8 = 0
mut state: choice

next: () -> (value: u8) =
    inc calls
    value = calls
end next

public main: () -> (code: i32) =
    mut local: choice = (
        prefix: 0,
        kind: pair(first: next(), second: next()),
        tail: 0
    )
    state.kind = pair(first: next(), second: next())
    local = (kind: row(values: zeroed), of zeroed)
    state.kind = leaf
    if calls == 4 and local.prefix == 0 and local.tail == 0 then
        code = 42
    else
        code = 1
    end if
end main
