choice: type = struct
    prefix: u8
    kind: variant
        leaf |
        pair: (first: u8, second: u8) |
        row: (values: [2]u16)
    end kind
    tail: u8
end choice

mut calls: u8 = 0
mut state: choice

next: () -> (value: u8) =
    inc calls
    value = calls
end next

public main: () -> (code: i32) =
    mut local: choice = (
        prefix: 0,
        kind: pair(first: next(), second: next()),
        tail: 0
    )
    mut inferred := choice(
        prefix: 9,
        kind: pair(first: 5, second: 6),
        tail: 8
    )
    mut inferred_ok: bool = false
    state.kind = pair(first: next(), second: next())
    local = (kind: row(values: zeroed), of zeroed)
    state.kind = leaf
    match inferred.kind
        leaf: inferred_ok = false
        pair(first, second): inferred_ok = first == 5 and second == 6
        row: inferred_ok = false
    end match
    if calls == 4 and local.prefix == 0 and local.tail == 0
      and inferred.prefix == 9 and inferred.tail == 8 and inferred_ok
    then
        code = 42
    else
        code = 1
    end if
end main
