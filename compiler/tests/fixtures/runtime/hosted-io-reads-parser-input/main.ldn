import core/io
import core/text
import hosted/system

public main: () -> (code: i32) =
    argument_host := system.new()
    fail_code: i32 = 1

    if io.argument_count(argument_host) <> 1 then
        code = fail_code
        return
    end if

    first: usize = 0
    source := io.argument_at(argument_host, first) else (argument_problem)
        _ = argument_problem
        code = fail_code
        return
    end

    host := system.new()
    opened := io.open_read(host, source) else (open_problem)
        _ = open_problem
        code = fail_code
        return
    end

    mut bytes: [13]u8 = zeroed
    count: usize = io.read(host, opened, bytes[0..<13]) else (read_problem)
        _ = read_problem
        code = fail_code
        return
    end
    io.close(host, opened) else (close_problem)
        _ = close_problem
        code = fail_code
        return
    end

    if count <> 13 or bytes[0] <> 112 or bytes[6] <> 32
      or bytes[12] <> 10
    then
        code = fail_code
        return
    end if

    missing_path: text.host_string =
        text.host_over("/definitely-not-a-landin-file-r350")
    should_fail := io.open_read(host, missing_path) else begin
        diagnostic: [3]u8 = [79, 75, 10]
        error_stream := io.err(host)
        io.write(host, error_stream, diagnostic[0..<3])
          else (write_problem)
            _ = write_problem
            code = fail_code
            return
        end
        code = 42
        return
    end
    io.close(host, should_fail) else none
    code = fail_code
end
