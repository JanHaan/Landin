pair: type = struct
    left: u32
    right: u32
end pair

reference_holder: type = struct
    pointer: ptr mut u32
    view: []u32
end reference_holder

module_words: [4]u32 = [5, 6, 7, 8]
module_view: []u32 = module_words[1..<3]
module_empty: []u32 = []
module_references: reference_holder = reference_holder(
    pointer: ptr(0x4002_0000), view: module_words[1..<3])

increment: (inout value: u32) -> none =
    value = value + 1
end increment

adjust: (inout value: pair) -> none =
    value.left = value.left + 2
    value.right = value.right + 3
end adjust

public main: () -> (code: i32) =
    mut word: u32 = 10
    pointer: ptr mut u32 = addr word
    pointer.val = 11
    increment(word)

    mut value: pair = pair(left: 20, right: 20)
    aggregate_pointer: ptr mut pair = addr value
    aggregate_pointer.val.left = 21
    adjust(value)

    mut pairs: [2]pair = zeroed
    pair_view: []mut pair = pairs[0..<2]
    pair_view[1].right = 9

    mut words: [4]u32 = [10, 20, 30, 40]
    view: []mut u32 = words[1..<3]
    inclusive: []u32 = words[1..2]
    view[0] = 22
    empty: []u32 = []

    literal_pointer: ptr mut u32 = ptr(0x4002_0000)
    address := u64(literal_pointer)

    if word == 12 and value.left == 23 and value.right == 23
      and lenof view == 2 and view[1] == 30 and words[1] == 22
      and lenof inclusive == 2 and inclusive[1] == 30
      and lenof pair_view == 2 and pairs[1].right == 9
      and lenof empty == 0 and address == 0x4002_0000
      and lenof module_view == 2 and module_view[0] == 6
      and lenof module_empty == 0
      and sizeof ptr u32 == 8 and sizeof []u32 == 16
      and alignof ptr u32 == 8 and alignof []u32 == 8
      and module_references.view[0] == 6
      and u64(module_references.pointer) == 0x4002_0000
    then
        code = 42
    else
        code = 1
    end if
end main
