import core/fault
import core/mem
import hosted/heap

no_allocation: atom
allocation: type = no_allocation | ptr mut u8
same_block: (saved: allocation, block: ptr mut u8) -> (same: bool) =
    match saved
        no_allocation: same = false
        ptr (present): same = usize(present) == usize(block)
    end match
end same_block
is_absent: (value: allocation) -> (empty: bool) =
    match value
        no_allocation: empty = true
        ptr: empty = false
    end match
end is_absent

audit_state: type = struct
    first: allocation
    second: allocation
    third: allocation
    allocated: usize
    freed: usize
    exact: bool
end audit_state
audit: type = struct
    state: ptr mut audit_state
    inner: heap.heap
end audit
--  The state's allocation fields have no zero value, so the caller starts
--  it from this value rather than from `zeroed`.
checked_state: () -> (result: audit_state) =
    result = (first: no_allocation, second: no_allocation,
              third: no_allocation, allocated: 0, freed: 0, exact: true)
end checked_state
checked_over: (inout state: audit_state) -> (handle: audit from state) =
    handle = (state: addr state, inner: heap.new())
end checked_over
checked_alloc: (self: audit, size: usize, alignment: usize)
               -> (block: ptr mut u8) ! mem.out_of_memory =
    block = try mem.allocate(self.inner, size, alignment)
    state: ptr mut audit_state = self.state
    if state.val.allocated == 0 then
        state.val.first = block
        state.val.exact = state.val.exact and size == 1
    elsif state.val.allocated == 1 then
        state.val.second = block
        state.val.exact = state.val.exact and size == 4096
    else
        state.val.third = block
        state.val.exact = state.val.exact and size == 1
    end if
    inc state.val.allocated
end checked_alloc
checked_free: (self: audit, block: ptr mut u8, size: usize) -> none =
    state: ptr mut audit_state = self.state
    if state.val.freed == 0 then
        state.val.exact = state.val.exact
                          and same_block(state.val.second, block)
                          and size == 4096
        state.val.second = no_allocation
    elsif state.val.freed == 1 then
        state.val.exact = state.val.exact
                          and same_block(state.val.first, block)
                          and size == 1
        state.val.first = no_allocation
    else
        state.val.exact = state.val.exact
                          and same_block(state.val.third, block)
                          and size == 1
        state.val.third = no_allocation
    end if
    inc state.val.freed
    mem.free(self.inner, block, size)
end checked_free
checked_grow: (self: audit, block: ptr mut u8,
               old_size: usize, new_size: usize, alignment: usize)
              -> (grown: bool) =
    _ = self.state
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end checked_grow

--  Resizing moves the block, through this provider's own allocation
--  and free.
checked_resize: (self: audit, block: ptr mut u8,
                 old_size: usize, new_size: usize, alignment: usize)
                -> (moved: ptr mut u8) ! mem.out_of_memory =
    moved = try mem.relocate(self, block, old_size, new_size, alignment)
end checked_resize

audit is mem.allocator (alloc: checked_alloc, grow: checked_grow,
                        resize: checked_resize, free: checked_free)

byte_release_case: () -> (ok: bool) =
    mut bytes: [8]u8 = zeroed
    start: ptr mut u8 = addr bytes[0]
    slots: usize = 8
    mut storage := mem.storage_over(item: u8, base: start, slots: slots)
    _ = mem.admit(storage, u8(11)) else slots
    _ = mem.admit(storage, u8(22)) else slots
    _ = mem.admit(storage, u8(33)) else slots
    before: usize = mem.length(storage)
    refused: bool = begin
        absent: allocation = mem.dispose(storage) else no_allocation
        is_absent(absent)
    end
    mem.clear(storage)
    empty: bool = mem.length(storage) == 0
                  and mem.capacity(storage) == slots
    released_address: usize = begin
        released: ptr mut u8 = mem.dispose(storage) else (problem)
            _ = problem
            ok = false
            return
        end
        usize(released)
    end
    again: bool = begin
        absent: allocation = mem.dispose(storage) else no_allocation
        is_absent(absent)
    end
    ok = before == 3 and refused and empty
         and released_address == usize(start) and again
end byte_release_case

public main: () -> (code: i32) =
    code = 1
    mut heap_state := checked_state()
    checked := checked_over(heap_state)
    zero: usize = 0
    one: usize = 1
    large: usize = 4096
    four: usize = 4
    maximum: usize = 18_446_744_073_709_551_615
    mut space: fault.space = zeroed
    counted := fault.over(space, checked, zero)
    mut empty := mem.new_bytes(counted, zero) else (problem)
        _ = problem
        return
    end
    mut refused: bool = false
    mut failed := mem.new_bytes(counted, one) else (problem)
        _ = problem
        refused = true
        empty
    end
    mem.delete_bytes(counted, failed)
    mem.delete_bytes(counted, empty)
    fault.permit(counted, four)
    mut small := mem.new_bytes(counted, one) else (problem)
        _ = problem
        return
    end
    mut bigger := mem.new_bytes(counted, large) else (problem)
        _ = problem
        return
    end
    mut other := mem.new_bytes(counted, one) else (problem)
        _ = problem
        return
    end
    initialized: bool = begin
        a := mem.bytes(small)
        b := mem.bytes(bigger)
        c := mem.bytes(other)
        mut good: bool = lenof a == 1 and lenof b == 4096
                         and lenof c == 1
        mut i: usize = 0
        while i < lenof b do
            good = good and b[i] == 0
            inc i
        end while
        good = good and a[0] == 0 and c[0] == 0
        a[0] = 17
        b[0] = 23
        b[4095] = 31
        c[0] = 37
        good and a[0] == 17 and b[0] == 23 and b[4095] == 31
        and c[0] == 37
    end
    mut overflow: bool = false
    mut huge := mem.new_bytes(counted, maximum) else (problem)
        _ = problem
        overflow = true
        empty
    end
    mem.delete_bytes(counted, huge)
    mem.delete_bytes(counted, bigger)
    survivors: bool = begin
        a := mem.bytes(small)
        c := mem.bytes(other)
        a[0] == 17 and c[0] == 37
    end
    mem.delete_bytes(counted, small)
    mem.delete_bytes(counted, other)
    cleared: bool = begin
        a := mem.bytes(small)
        b := mem.bytes(bigger)
        c := mem.bytes(other)
        lenof a == 0 and lenof b == 0 and lenof c == 0
    end
    mem.delete_bytes(counted, small)
    if refused and initialized and overflow and survivors and cleared
      and fault.attempts(counted) == 5 and fault.successes(counted) == 3
      and fault.injected_failures(counted) == 1
      and fault.inner_failures(counted) == 1
      and fault.frees(counted) == 3 and fault.live(counted) == 0
      and heap_state.exact and heap_state.allocated == 3
      and heap_state.freed == 3
      and is_absent(heap_state.first) and is_absent(heap_state.second)
      and is_absent(heap_state.third) and byte_release_case()
    then
        code = 42
    end if
end main
