pick: (t: type, source: []mut t) -> (result: t from source) =
    result = source[0]
end pick

advance: (t: type, inout source: []mut t) -> none =
    source = source[1..<lenof source]
end advance

public main: () -> (code: i32) =
    mut values: [2]u32 = [17, 25]
    mut source: []mut u32 = values[0..<2]
    chosen: u32 = pick(source)
    advance(source)
    code = if chosen == 17 and lenof source == 1 and source[0] == 25 then
        42
    else
        1
    end if
end main
