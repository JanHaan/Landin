import core/arena
import core/fault
import core/mem

exercise: () -> (ok: bool) ! mem.out_of_memory =
    ok = false
    mut backing: [32]u8 = zeroed
    mut arena_space: arena.space = zeroed
    memory := arena.over_unchecked(arena_space, addr backing[0], 32)
    mut space: fault.space = zeroed
    counted := fault.over(space, memory, usize(1))
    address := try mem.allocate(counted, usize(4), usize(1))
    address.val = 42
    return when address.val <> 42
    _ = mem.allocate(counted, usize(4), usize(1)) else (problem)
        _ = problem
        ok = fault.successes(counted) == 1 and fault.injected_failures(counted) == 1
        mem.free(counted, address, usize(4))
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
