--  Addresses on firmware, read: an IPv4 address, a compressed IPv6
--  address and a link-local one with its zone read from their text, each
--  the same address its constructors make, and text that is no address
--  refused, within a Cortex-M0 image.  Writing them is
--  runtime/network-addresses-written-firmware's, since both together do
--  not fit the profile at none/off, and runtime/network-addresses holds
--  every form on the hosted targets.
import core/net

--  Whether SOURCE reads as the address WANTED.
reads_as: (source: []u8, wanted: net.address) -> (yes: bool) =
    yes = false
    at: net.address = net.parse_ip(source) else (problem)
        _ = problem
        return
    end
    yes = net.same_address(at, wanted)
end reads_as

--  Whether SOURCE is refused as no address.
refused: (source: []u8) -> (yes: bool) =
    yes = false
    at: net.address = net.parse_ip(source) else (problem)
        yes = problem == net.invalid_address
        return
    end
    _ = at
end refused

public main: () -> (code: i32) =
    code = 1
    return when not reads_as("192.0.2.1", net.ipv4_address(192, 0, 2, 1, 0))
    code = 2
    groups: [8]u16 = [0x2001, 0xdb8, 0, 0, 0, 0xff00, 0x42, 0x8329]
    return when not reads_as("2001:db8::ff00:42:8329",
                             net.ipv6_address(groups, 0))
    code = 3
    link: [8]u16 = [0xfe80, 0, 0, 0, 0, 0, 0, 1]
    zoned: net.address = net.with_zone(net.ipv6_address(link, 0), "eth0")
        else (problem)
        _ = problem
        return
    end
    return when not reads_as("fe80::1%eth0", zoned)
      or reads_as("fe80::1%eth1", zoned) or reads_as("fe80::1", zoned)
    code = 4
    return when not refused("fe80::1%") or not refused("1.2.3")
      or not refused("127.0.0.1%lo")
    code = 42
end main
