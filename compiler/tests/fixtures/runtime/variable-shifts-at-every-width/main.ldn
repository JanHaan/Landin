-- Every amount arrives as a parameter, so no shift here is folded: each one
-- is the variable shift a level may select differently, at every width and
-- signedness, within the width, at it and beyond it.  main calls them through
-- function values, since D339 would copy a small routine called directly
-- into main at speed, where its amounts are constants.
left_32: (value: u32, amount: u32) -> (result: u32) =
    result = value << amount
end left_32

right_32: (value: i32, amount: i32) -> (result: i32) =
    result = value >> amount
end right_32

left_64: (value: i64, amount: i64) -> (result: i64) =
    result = value << amount
end left_64

right_64: (value: u64, amount: u64) -> (result: u64) =
    result = value >> amount
end right_64

arithmetic_64: (value: i64, amount: i64) -> (result: i64) =
    result = value >> amount
end arithmetic_64

left_8: (value: u8, amount: u8) -> (result: u8) =
    result = value << amount
end left_8

right_16: (value: i16, amount: i16) -> (result: i16) =
    result = value >> amount
end right_16

public main: () -> (code: i32) =
    shl32 := left_32
    sar32 := right_32
    shl64 := left_64
    shr64 := right_64
    sar64 := arithmetic_64
    shl8 := left_8
    sar16 := right_16
    if shl32(3, 30) == 3221225472
        and shl32(1, 31) == 2147483648
        and shl32(1, 32) == 0
        and shl32(1, 33) == 0
        and shl32(7, 0) == 7
        and sar32(-256, 4) == -16
        and sar32(-1, 31) == -1
        and sar32(-1, 32) == 0
        and sar32(2147483647, 30) == 1
        and shl64(1, 62) == 4611686018427387904
        and shl64(1, 0) == 1
        and shl64(1, 31) == 2147483648
        and shl64(1, 32) == 4294967296
        and shl64(1, 33) == 8589934592
        and shl64(5, 64) == 0
        and shl64(-1, 63) == -9223372036854775808
        and shr64(18446744073709551615, 0) == 18446744073709551615
        and shr64(18446744073709551615, 31) == 8589934591
        and shr64(18446744073709551615, 32) == 4294967295
        and shr64(18446744073709551615, 33) == 2147483647
        and shr64(18446744073709551615, 60) == 15
        and shr64(18446744073709551615, 63) == 1
        and shr64(18446744073709551615, 64) == 0
        and sar64(-9223372036854775808, 63) == -1
        and sar64(-4294967296, 31) == -2
        and sar64(-4294967296, 32) == -1
        and sar64(-4294967296, 33) == -1
        and sar64(-9223372036854775808, 65) == 0
        and sar64(4096, 12) == 1
        and shl8(3, 6) == 192
        and shl8(3, 8) == 0
        and sar16(-32768, 15) == -1
        and sar16(-32768, 16) == 0
    then
        code = 42
    else
        code = 1
    end if
end main
