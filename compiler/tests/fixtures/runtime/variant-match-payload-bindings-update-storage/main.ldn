choice: type = struct
    kind: variant
        leaf |
        pair: (first: i32, second: i32)
    end kind
end choice

mut state: choice

public main: () -> (code: i32) =
    state.kind = pair(first: 20, second: 21)
    mut answer: i32 = 0
    match state.kind
        leaf: answer = 1
        pair(first, inout second): if true then
            second = second + 1
            answer = first + second
        end if
    end match
    code = answer
end main
