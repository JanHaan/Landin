import core/failing
import hosted/heap
import core/sort
import core/vec

mut comparisons: usize = 0

--  The vector sorts through the library's own i32 ordering. Comparison
--  counts are taken on a wrapper struct with its own counting evidence.
counted: type = struct
    value: i32
end counted

less_counted: (left: counted, right: counted) -> (yes: bool) =
    inc comparisons
    yes = left.value < right.value
end less_counted

counted is sort.ordered (less: less_counted)

public main: () -> (code: i32) =
    code = 1
    mut heap_state := heap.host()
    budget: usize = 10
    mut state := failing.new(addr heap_state, budget)
    mut numbers := vec.new(item: i32)
    sort.sort(vec.used(numbers))
    vec.push(numbers, state, 20) else (problem)
        _ = problem
        return
    end
    sort.sort(vec.used(numbers))
    mut n: i32 = 19
    while n > 0 do
        vec.push(numbers, state, n) else (problem)
            _ = problem
            return
        end
        dec n
    end while
    before: usize = failing.attempts(state)
    sort.sort(vec.used(numbers))
    sort.sort(vec.used(numbers))
    sorted: bool = begin
        view := vec.used(numbers)
        mut next: i32 = 1
        mut good: bool = true
        for value in view do
            good = good and value == next
            inc next
        end for
        good and next == 21
    end
    mut squares: i32 = 0
    for value in vec.used(numbers) do
        squares += value * value
    end for
    duplicate: i32 = 7
    vec.push(numbers, state, duplicate) else (problem)
        _ = problem
        return
    end
    sort.sort(vec.used(numbers))
    duplicates: bool = begin
        view := vec.used(numbers)
        lenof view == 21 and view[6] == 7 and view[7] == 7
          and view[20] == 20
    end
    mut small: [5]counted = [(value: 4), (value: 1), (value: 3), (value: 1),
                             (value: 2)]
    comparisons = 0
    sort.sort_selection(small[0..<lenof small])
    selection_ok: bool = comparisons == 10 and small[0].value == 1
                         and small[1].value == 1 and small[2].value == 2
                         and small[3].value == 3 and small[4].value == 4

    mut large: [256]counted = zeroed
    mut at: usize = 0
    while at < lenof large do
        large[at] = (value: i32(lenof large - at))
        inc at
    end while
    comparisons = 0
    sort.sort(large[0..<lenof large])
    scalable_count: bool = comparisons < 8192
    at = 0
    mut large_sorted: bool = true
    while at < lenof large do
        large_sorted = large_sorted and large[at].value == i32(at + 1)
        inc at
    end while
    after: usize = failing.attempts(state)
    vec.release(numbers, state)
    if sorted and squares == 2870 and duplicates and selection_ok
      and scalable_count and large_sorted and before == after
      and failing.live(state) == 0 and failing.frees(state) == 3
    then
        code = 42
    end if
end main
