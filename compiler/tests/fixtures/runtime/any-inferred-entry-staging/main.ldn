problem: atom
problems: type = problem

cell: type = struct
    value: i32
end cell

counter: type = concept (t: type)
    bump: (self: ptr mut t) -> (value: i32)
    add: (self: ptr mut t, amount: i32) -> (value: i32)
    reerase: (self: ptr mut t) -> (result: any counter from self)
    take: (self: ptr t, source: ptr mut cell, stop: bool)
          -> (result: ptr mut cell from source) ! problems
end counter

first: type = struct
    value: i32
end first

second: type = struct
    prefix: u64
    value: i32
    suffix: u8
end second

public main: () -> (code: i32) =
    mut left: first = (value: 9)
    mut right: second = (prefix: 99, value: 19, suffix: 7)
    mut primary: cell = (value: 5)
    mut fallback: cell = (value: 4)
    a: any counter = any(addr left)
    b: any counter = any(addr right)
    inferred_label := a.add(amount: 3)
    typed_label: i32 = b.add(amount: 4)
    roundtrip := a.reerase()
    inferred := roundtrip.bump()
    explicit: i32 = b.bump()
    chosen := a.take(addr primary, false) else addr fallback
    recovered := b.take(addr primary, true) else addr fallback
    inc chosen.val.value
    inc recovered.val.value
    code = 1
    if inferred_label <> 12 or typed_label <> 23
      or inferred <> 13 or explicit <> 25
      or primary.value <> 6 or fallback.value <> 5 then
        return
    end if
    code = 42
end main

bump_second: (self: ptr mut second) -> (value: i32) =
    self.val.value = self.val.value + 2
    value = self.val.value
end bump_second

add_second: (self: ptr mut second, delta: i32) -> (answer: i32) =
    self.val.value = self.val.value + delta
    answer = self.val.value
end add_second

take_second: (self: ptr second, source: ptr mut cell, stop: bool)
      -> (result: ptr mut cell from source) ! problems =
    fail problem when stop
    result = source
end take_second

reerase_second: (self: ptr mut second)
      -> (result: any counter from self) =
    result = any(self)
end reerase_second

second is counter
    (bump: bump_second, add: add_second, reerase: reerase_second,
     take: take_second)

bump_first: (self: ptr mut first) -> (value: i32) =
    inc self.val.value
    value = self.val.value
end bump_first

add_first: (self: ptr mut first, n: i32) -> (answer: i32) =
    self.val.value = self.val.value + n
    answer = self.val.value
end add_first

take_first: (self: ptr first, source: ptr mut cell, stop: bool)
      -> (result: ptr mut cell from source) ! problems =
    fail problem when stop
    result = source
end take_first

reerase_first: (self: ptr mut first)
      -> (result: any counter from self) =
    result = any(self)
end reerase_first

first is counter
    (bump: bump_first, add: add_first, reerase: reerase_first,
     take: take_first)
