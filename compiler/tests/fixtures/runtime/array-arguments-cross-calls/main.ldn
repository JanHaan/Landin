inspect: (a: i32, first: [3]i32, c: i32, d: i32, e: i32, f: i32, second: [2]i32, h: i32) -> (result: i32) =
    result = a + first[0] + first[1] + first[2] + c + d + e + f + second[0] + second[1] + h
end inspect

public main: () -> (code: i32) =
    first: [3]i32 = [2, 3, 4]
    second: [2]i32 = [9, 10]
    code = inspect(1, first, 5, 6, 7, 8, second, 11)
           + inspect(0, [1, 1, 1], 0, 0, 0, 0, [1, 1], 0)
end main
