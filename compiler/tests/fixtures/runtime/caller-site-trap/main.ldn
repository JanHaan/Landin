site: type = struct
    file_id: u32
    line: u32
    column: u32
end site

--- A contract check: the trap is reported where `require` was called.
require: (holds: bool, caller where: site) -> none =
    if not holds then compiler.unreachable(where) end if
end require

--- A wrapper that passes its own caller on, so its caller is reported.
require_positive: (value: i32, caller where: site) -> none =
    require(value > 0, where: where)
end require_positive

first: (value: i32) -> (doubled: i32) =
    require(value < 100)
    doubled = value * 2
end first

second: (value: i32) -> (doubled: i32) =
    require_positive(value)
    doubled = first(value)
end second

public main: () -> (code: i32) =
    require(true)
    code = second(3) - 6
    code = code + second(-1)
end main
