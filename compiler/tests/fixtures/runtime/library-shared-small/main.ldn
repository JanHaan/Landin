import core/mem
import core/small

exercise: () -> (ok: bool) ! mem.out_of_memory | mem.empty =
    ok = false
    mut backing: [32]u8 = zeroed
    mut state := mem.arena_over_unchecked(addr backing[0], 32)
    mut values := small.new(item: i32, inline_slots: 1)
    try small.push(values, state, i32(42))
    return when small.length(addr values) <> 1 or mem.arena_used(state) <> 0
    value := try small.pop(values)
    return when value <> 42
    _ = small.pop(values) else (problem)
        ok = problem == mem.empty and small.length(addr values) == 0
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
