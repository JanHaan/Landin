import core/diag
import core/mem

exercise: () -> (ok: bool) ! mem.out_of_bounds =
    ok = false
    mut value := diag.new(capacity: 1)
    return when diag.length(addr value) <> 0 or diag.dropped(addr value) <> 0
    _ = diag.get(addr value, usize(0)) else (problem)
        ok = problem == mem.out_of_bounds
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
