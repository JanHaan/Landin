import core/diag

exercise: () -> (ok: bool) ! diag.out_of_bounds =
    ok = false
    mut value := diag.new_log(capacity: usize(1))
    return when diag.stored(addr value) <> 0 or diag.dropped(addr value) <> 0
    _ = diag.note_at(addr value, usize(0)) else (problem)
        ok = problem == diag.out_of_bounds
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
