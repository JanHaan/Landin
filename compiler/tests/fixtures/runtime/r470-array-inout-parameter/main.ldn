mut selections: usize = 0
mut later_calls: usize = 0
mut completed: usize = 0
refused: atom

select: (which: usize, reject: bool) -> (result: usize) ! refused =
    inc selections
    fail refused when reject
    result = which
end select

later: () -> (result: usize) =
    inc later_calls
    result = 6
end later

bump: (inout values: [7]u8, index: usize) -> none =
    values[index] = values[index] + 1
end bump

swap_copy_forward: (inout values: [7]u8, left: usize, right: usize)
                   -> none =
    saved: u8 = values[left]
    values[left] = values[right]
    values[right] = saved
    mut snapshot: [7]u8 = values
    snapshot[3] = snapshot[3] + 20
    values = snapshot
    bump(values, right)
end swap_copy_forward

recover_first_argument: (inout rows: [2][7]u8) -> none =
    swap_copy_forward(rows[(select(0, true) else (problem)
        _ = problem
        return
    end)], 0, later())
    inc completed
end recover_first_argument

public main: () -> (code: i32) =
    mut rows: [2][7]u8 = [[0, 1, 2, 3, 4, 5, 6],
                           [10, 11, 12, 13, 14, 15, 16]]
    swap_copy_forward(rows[(select(0, false) else (problem)
        _ = problem
        code = 1
        return
    end)], 0, later())
    swap_copy_forward(rows[(select(1, false) else (problem)
        _ = problem
        code = 1
        return
    end)], 0, later())
    recover_first_argument(rows)
    if rows[0][0] == 6 and rows[0][1] == 1 and rows[0][2] == 2
      and rows[0][3] == 23 and rows[0][4] == 4 and rows[0][5] == 5
      and rows[0][6] == 1
      and rows[1][0] == 16 and rows[1][1] == 11 and rows[1][2] == 12
      and rows[1][3] == 33 and rows[1][4] == 14 and rows[1][5] == 15
      and rows[1][6] == 11
      and selections == 3 and later_calls == 2 and completed == 0
    then
        code = 42
    else
        code = 1
    end if
end main
