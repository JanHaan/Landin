--  A write to a connection whose peer has gone is an error the program
--  answers, `disconnected`, never SIGPIPE ending the process.  The server
--  closes its end; the client reads the end of the stream, and the first
--  send after it may still be taken, the peer's system answering it with a
--  reset, so the client sends until it hears of that, for at most two
--  seconds.  A write through the writer concept afterwards fails with
--  EPIPE kept as the last errno: the process ignores SIGPIPE, which a
--  write to a socket would otherwise raise.  Over IPv4 and IPv6.
import core/io
import core/net
import core/time
import hosted/system
import platform/posix

--  A connection's peer never said it had gone.
still_there: atom

--  Send to CLIENT until a send says its peer has gone, sleeping a little
--  between tries, for at most two seconds.
sent_until_gone: (host: system.host, client: io.file) -> none ! ... =
    deadline: time.instant = time.later(time.now(host), time.seconds(2))
    loop do
        net.send(host, client, "anyone?") else (problem)
            return when problem == net.disconnected
            fail problem
        end
        fail still_there when time.now(host) >= deadline
        time.sleep(host, time.milliseconds(10))
    end loop
end sent_until_gone

--  Whether a send to a peer that has closed is disconnected, and a write
--  after it EPIPE.
closed: (host: system.host, family: net.address_family) -> (yes: bool)
        ! ... =
    listener: io.file = try net.listen(host, net.loopback(family, 0))
    at: net.address = try net.local_address(host, listener)
    client: io.file = try net.connect(host, at)
    server: io.file = try net.accept(host, listener)
    try net.close_socket(host, listener)
    try net.close_socket(host, server)
    mut buffer: [8]u8 = zeroed
    ended: usize = try net.receive(host, client, buffer[0..<8])
    try sent_until_gone(host, client)
    yes = false
    io.write(host, client, "again?") else (problem)
        yes = ended == 0 and problem == io.io_failed
              and system.last_errno(host) == posix.number(posix.epipe)
    end
    try net.close_socket(host, client)
end closed

public main: () -> (code: i32) =
    host := system.new()
    code = 1
    families: [2]net.address_family = [net.ipv4, net.ipv6]
    for family in families do
        yes: bool = closed(host, family) else (problem)
            _ = problem
            return
        end
        return when not yes
        inc code
    end for
    code = 42
end main
