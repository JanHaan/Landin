sum_four: (values: [4]f64) -> (r: f64) =
    r = 0.0
    for value in values do r += value end for
end sum_four
public main: () -> (code: i32) =
    values: [4]f64 = [1.0e20, -1.0e20, 3.0, 0.0]
    ordered := values + 0.0
    positive: [2]f64 = [1.0, 2.0]
    infinities := positive / 0.0
    negative := -positive
    quotients := positive / negative
    if sum_four(ordered) == 3.0
      and infinities[0] == f64.infinity and infinities[1] == f64.infinity
      and quotients[0] == -1.0 and quotients[1] == -1.0
    then code = 42 else code = 1 end if
end main
