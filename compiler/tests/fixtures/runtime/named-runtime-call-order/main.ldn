ternary: type = (left: i32, middle: i32, right: i32) -> (answer: i32)

box: type = struct
    invoke: ternary
end box

mut trace: i32 = 0

mark: (value: i32, digit: i32) -> (result: i32) =
    trace = trace * 10 + digit
    result = value
end mark

combine: (a: i32, b: i32, c: i32) -> (result: i32) =
    result = a * 100 + b * 10 + c
end combine

generic_first: (t: type, first: t, second: t) -> (result: t) =
    result = first
end generic_first

public main: () -> (code: i32) =
    trace = 0
    direct := combine(c: mark(3, 1), a: mark(1, 2), b: mark(2, 3))
    direct_order := trace

    trace = 0
    prefix := combine(mark(1, 4), c: mark(3, 5), b: mark(2, 6))
    prefix_order := trace

    indirect: ternary = combine
    trace = 0
    through_value := indirect(
        right: mark(3, 7), left: mark(1, 8), middle: mark(2, 9))
    indirect_order := trace

    holder: box = (invoke: combine)
    trace = 0
    through_field := holder.invoke(
        middle: mark(2, 1), right: mark(3, 2), left: mark(1, 3))
    field_order := trace

    mut holders: [1]box
    holders[0] = holder
    trace = 0
    through_selection := holders[0].invoke(
        right: mark(3, 4), middle: mark(2, 5), left: mark(1, 6))
    selection_order := trace

    trace = 0
    through_generic := generic_first(
        second: mark(9, 7), first: mark(8, 8))
    generic_order := trace

    code = 1
    if direct == 123 and direct_order == 123
       and prefix == 123 and prefix_order == 456
       and through_value == 123 and indirect_order == 789
       and through_field == 123 and field_order == 123
       and through_selection == 123 and selection_order == 456
       and through_generic == 8 and generic_order == 78
    then
        code = 42
    end if
end main
