--  failure.words gives every library failure atom its own phrase: each one
--  below is the phrase the reference documents, in lower case with no
--  final stop, and no two atoms share one.
import core/cmp
import core/failure
import core/io
import core/map
import core/mem
import core/net
import core/text
import core/tree

reasons: [32]failure.reason = [mem.out_of_bounds, mem.empty, mem.full,
                               mem.not_empty, mem.out_of_memory, map.missing,
                               map.end_of_entries, tree.no_such_node,
                               tree.invalid_children, tree.too_many_nodes,
                               tree.too_many_leaves, io.not_found,
                               io.no_access, io.io_failed, io.no_argument,
                               io.already_exists, io.no_variable,
                               io.line_too_long, io.not_a_terminal,
                               net.invalid_address, net.refused,
                               net.unreachable, net.address_in_use,
                               net.address_unavailable, net.timed_out,
                               net.disconnected, text.past_end,
                               text.invalid_text, text.invalid_number,
                               text.number_overflow, text.no_space,
                               text.invalid_format]

phrases: [32][]u8 = ["index out of bounds", "nothing to take",
                     "no room for another item", "storage still holds items",
                     "out of memory", "no such key", "no more entries",
                     "no such node", "children outside the tree",
                     "too many nodes", "too many leaves", "not found",
                     "permission denied", "input or output failed",
                     "no such argument", "already exists", "no such variable",
                     "line too long", "not a terminal", "invalid address",
                     "connection refused", "address unreachable",
                     "address in use", "address not available", "timed out",
                     "peer disconnected", "past the end", "invalid UTF-8",
                     "not a number", "number out of range",
                     "no room for the output",
                     "template does not fit its values"]

--  The phrase in lower case, as it reads after a colon, with no stop.
plain: (phrase: []u8) -> (yes: bool) =
    yes = lenof phrase > 0 and phrase[0] >= u8('a')
          and phrase[0] <= u8('z')
          and phrase[lenof phrase - 1] <> u8('.')
end plain

public main: () -> (code: i32) =
    code = 1
    for at in usize(0)..<usize(32) do
        phrase: []u8 = failure.words(reasons[at])
        return when cmp.compare(phrase, phrases[at]) <> cmp.equal
          or not plain(phrase)
        for other in usize(0)..<at do
            return when cmp.compare(phrase, failure.words(reasons[other]))
              == cmp.equal
        end for
    end for
    code = 42
end main
