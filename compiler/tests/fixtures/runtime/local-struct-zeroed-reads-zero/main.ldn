holder: type = struct
    tag: u8
    row: [3]u32
    tail: u16
end holder

public main: () -> (code: i32) =
    mut local: holder = zeroed

    if local.tag == 0 and local.row[0] == 0 and local.row[1] == 0
        and local.row[2] == 0 and local.tail == 0
    then
        local.tag = 7
        local.row[1] = 42
        local.tail = 701
        if local.tag == 7 and local.row[0] == 0 and local.row[1] == 42
            and local.row[2] == 0 and local.tail == 701
        then
            code = 42
        else
            code = 2
        end if
    else
        code = 1
    end if
end main
