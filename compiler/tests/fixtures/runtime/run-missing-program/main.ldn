--  A program that is not there is not started: spawning a path that names
--  nothing is io.not_found, with ENOENT as the hosted provider's last
--  errno, a path through a file is not_found too, with ENOTDIR, and a
--  path that names a directory is io.no_access, with EACCES, on every
--  hosted system.  No child is left to wait for.
import core/io
import core/text
import hosted/blocking
import platform/posix

--  How spawning PATH failed, as the hosted provider reports it, or
--  `started` when it did not.
started: atom
outcome: type = started | io.not_found | io.no_access | io.io_failed

attempt: (host: blocking.host, path: []u8) -> (result: outcome) =
    arguments: [1]text.host_string = [text.host_over("-c")]
    variables: [1]io.variable =
        [(name: text.host_over("A"), value: text.host_over("1"))]
    child: io.child = io.spawn(host, text.host_over(path), arguments[0..<1],
                               variables[0..<1], io.capturing) else (problem)
        result = problem
        return
    end
    ended: io.ending = io.wait(host, child) else (problem)
        result = problem
        return
    end
    _ = ended
    result = started
end attempt

public main: () -> (code: i32) =
    host := blocking.new()
    code = 1
    return when attempt(host, "/nonexistent/landin-program") <> io.not_found
    return when blocking.last_errno(host) <> posix.number(posix.enoent)
    code = 2
    return when attempt(host, "/dev/null/landin-program") <> io.not_found
    return when blocking.last_errno(host) <> posix.number(posix.enotdir)
    code = 3
    return when attempt(host, "/") <> io.no_access
    return when blocking.last_errno(host) <> posix.number(posix.eacces)
    code = 4
    --  A child that does start leaves the last errno at zero.
    return when attempt(host, "/bin/sh") <> started
    return when blocking.last_errno(host) <> 0
    code = 42
end main
