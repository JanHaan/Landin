import core/io
import core/text
import hosted/blocking

--  These are paths supplied by the selected Linux execution profile.  The
--  missing parent makes ENOENT deterministic; /dev/full and /dev/null provide
--  terminal write and close failures without changing repository files.
missing: []u8 = "/landin-r440-absent-parent/file-does-not"
full_name: []u8 = "/dev/full"
null_name: []u8 = "/dev/null"
payload: [1]u8 = [88]

missing_retains_errno: (state: blocking.host) -> (yes: bool) =
    yes = false
    opened: io.file = io.open_read(state, text.host_over(missing)) else (problem)
        return when problem <> io.not_found
        --  A pure capability query cannot clobber captured failure detail.
        _ = io.argument_count(state)
        yes = blocking.last_errno(state) == 2
        return
    end
    io.close(state, opened) else none
end missing_retains_errno

full_retains_errno: (state: blocking.host) -> (yes: bool) =
    yes = false
    opened: io.file = io.open_write(state, text.host_over(full_name)) else (problem)
        _ = problem
        return
    end
    io.write(state, opened, payload[0..<1]) else (problem)
        if problem == io.io_failed and blocking.last_errno(state) == 28 then
            yes = true
        end if
    end
    io.close(state, opened) else (problem)
        _ = problem
        yes = false
    end
end full_retains_errno

close_retains_errno: (state: blocking.host) -> (yes: bool) =
    yes = false
    opened: io.file = io.open_read(state, text.host_over(null_name)) else (problem)
        _ = problem
        return
    end
    copy: io.file = opened
    io.close(state, opened) else (problem)
        _ = problem
        return
    end
    io.close(state, copy) else (problem)
        yes = problem == io.io_failed and blocking.last_errno(state) == 9
        return
    end
end close_retains_errno

public main: () -> (code: i32) =
    code = 1
    state: blocking.host = blocking.new()
    return when blocking.last_errno(state) <> 0
    code = 2
    return when not missing_retains_errno(state)
    code = 3
    return when not full_retains_errno(state)
    code = 4
    return when not close_retains_errno(state)
    code = 42
end main
