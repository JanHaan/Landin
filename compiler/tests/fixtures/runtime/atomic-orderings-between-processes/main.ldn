--  D227's orderings between two CPU contexts as each backend lowers them
--  (D499): this process and a copy of it, sharing one page.  Each round
--  passes a message, an ordinary write published by a release store and
--  read after an acquire load sees it, and then runs a store-buffering
--  test, in which each side stores seq_cst to its own word and loads
--  seq_cst the other's: the two loads never both read the round before.
--  The sides start each store-buffering round from a common gate, each
--  after a delay stepping through its own range, so the two stores'
--  distance in time sweeps past zero.  With relaxed stores and loads the
--  same rounds read both old values in about one round in twenty on an
--  x86-64 host, which a seq_cst store lowered as a plain MOV would too.
--  Nothing here can show that a weaker ordering would have let a
--  forbidden outcome happen, only that none was seen.  FreeBSD arm64 is
--  not a target: its only lane is QEMU's system emulation on an x86-64
--  host, which does not keep a `stlr` before a later `ldar`, so its
--  store-buffering rounds fail there as they do under QEMU's user
--  emulation; Linux and Darwin arm64 run the same backend's code on
--  hardware.  Each check that fails returns its own code.
import platform/libc
import platform/linux
import platform/posix

--  How many rounds of each test run.
rounds: u64 = 20000

--  How long a side spins waiting for the other before it gives up, so a
--  copy that died ends the run rather than hanging it.
patience: u64 = 1000000000

--  Where each word lives in the shared page, a cache line apart.
x_at: usize = 0
y_at: usize = 64
data_at: usize = 128
flag_at: usize = 192
ack_at: usize = 256
arrived_at: usize = 320
seen_at: usize = 384
done_at: usize = 448
pad_at: usize = 512

fixed if compiler.os == linux then
    --  A zeroed page this process and its copies share, or zero.
    shared: () -> (page: usize) =
        result: i64 = linux.mmap(0, 4096, linux.prot_read | linux.prot_write,
                                 1 | linux.map_anonymous, -1, 0)
        page = if result < 0 then 0 else usize(result) end if
    end shared

    --  A copy of this process: zero in the copy, its ID in this one.
    forked: () -> (child: i64) =
        child = linux.fork()
    end forked
else
    extern(c) fork: () -> (child: i32)

    --  A zeroed page this process and its copies share, or zero.  MAP_SHARED
    --  is 1 on every system.
    shared: () -> (page: usize) =
        result: usize = libc.mmap(0, 4096, libc.prot_read | libc.prot_write,
                                  1 | libc.map_anonymous, -1, 0)
        page = if result == libc.map_failed then 0 else result end if
    end shared

    --  A copy of this process: zero in the copy, its ID in this one.
    forked: () -> (child: i64) =
        child = i64(fork())
    end forked
end if

--  The word of the shared page at PAGE + OFFSET.
cell: (page: usize, offset: usize) -> (at: ptr mut u64) =
    at = ptr(page + offset)
end cell

--  Spin until the word at AT holds VALUE, reading it with acquire: whether
--  it did before patience ran out.
waited: (at: ptr mut u64, value: u64) -> (yes: bool) =
    yes = true
    for spin in u64(0)..<patience do
        _ = spin
        return when compiler.atomic_load(at, compiler.acquire) == value
    end for
    yes = false
end waited

--  Spin COUNT times reading a word nobody writes: a delay no optimizer
--  removes.
delayed: (page: usize, count: u64) -> none =
    for spin in u64(0)..<count do
        _ = spin
        _ = compiler.atomic_load(cell(page, pad_at), compiler.relaxed)
    end for
end delayed

--  Meet the other side at round K's gate: each adds one to the arrival
--  count and waits until both have.
met: (page: usize, k: u64) -> (yes: bool) =
    _ = compiler.atomic_add(cell(page, arrived_at), 1, compiler.acq_rel)
    yes = waited(cell(page, arrived_at), 2 * k)
end met

--  The copy's side of every round, ending the copy with its code.
copy: (page: usize) -> noreturn =
    mut code: i32 = 0
    for k in u64(1)..<rounds + 1 do
        if not waited(cell(page, flag_at), k) then posix.exit(20) end if
        data: ptr mut u64 = cell(page, data_at)
        if data.val <> k then code = 21 end if
        compiler.atomic_store(cell(page, ack_at), k, compiler.release)
        if not met(page, k) then posix.exit(22) end if
        delayed(page, (k / 64) % 128)
        compiler.atomic_store(cell(page, y_at), k, compiler.seq_cst)
        seen: u64 = compiler.atomic_load(cell(page, x_at), compiler.seq_cst)
        compiler.atomic_store(cell(page, seen_at), seen, compiler.relaxed)
        compiler.atomic_store(cell(page, done_at), k, compiler.release)
    end for
    posix.exit(code)
end copy

public main: () -> (code: i32) =
    code = 1
    page: usize = shared()
    return when page == 0
    code = 2
    started: i64 = forked()
    if started == 0 then
        copy(page)
    end if
    return when started < 0
    mut forbidden: u64 = 0
    for k in u64(1)..<rounds + 1 do
        code = 3
        data: ptr mut u64 = cell(page, data_at)
        data.val = k
        compiler.atomic_store(cell(page, flag_at), k, compiler.release)
        return when not waited(cell(page, ack_at), k)
        code = 4
        return when not met(page, k)
        delayed(page, k % 128)
        compiler.atomic_store(cell(page, x_at), k, compiler.seq_cst)
        mine: u64 = compiler.atomic_load(cell(page, y_at), compiler.seq_cst)
        code = 5
        return when not waited(cell(page, done_at), k)
        theirs: u64 = compiler.atomic_load(cell(page, seen_at),
                                           compiler.relaxed)
        if mine < k and theirs < k then forbidden = forbidden + 1 end if
    end for
    code = 6
    ended: posix.child_status =
        posix.wait(posix.process_id(i32(started))) else (problem)
            _ = problem
            return
        end
    match ended.how
        posix.exited(status): begin
            code = if status == 0 then 7 else status end if
        end
        posix.signalled(signal): _ = signal
    end match
    return when code <> 7
    code = 8
    return when forbidden <> 0
    code = 42
end main
