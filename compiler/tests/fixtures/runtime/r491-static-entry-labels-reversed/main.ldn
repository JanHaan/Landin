combine: type = concept (t: type)
    apply: (left: t, right: t) -> (result: i32)
end combine
normal: (left: i32, right: i32) -> (result: i32) = left * 10 + right end normal
reverse: (right: i64, left: i64) -> (result: i32) = i32(right * 10 + left) end reverse
i32 is combine (apply: normal)
i64 is combine (apply: reverse)
invoke: (t: type is combine, a: t, b: t) -> (result: i32) =
    t.apply(left: a, right: b)
end invoke
public main: () -> (code: i32) =
    two: i32 = invoke(i64(4), i64(2))
    one: i32 = invoke(i32(4), i32(2))
    if one == 42 and two == 42 then 42 else 1 end if
end main
