--  D471: a task whose own recursion goes deeper than its stack between
--  two switches traps `stack_exhausted` in the prologue of the first call
--  whose frame would go below the stack's limit, at that routine's site,
--  before it has written below its stack.  Before D471 the check was made
--  only at a switch, and this task overwrote its own record first.
import core/failure
import core/fibre
import core/fibre/stacks

deep: type = struct
    runs: any fibre.turns
end deep

--  Goes on without end, and never switches.
descend: (depth: u32) -> (reached: u32) =
    reached = descend(depth + 1) + 1
end descend

--  One turn first, so the task runs on as a fibre that has been switched
--  away from and back to.
dive: (inout state: deep) -> none ! failure.reason =
    state.runs.yield()
    _ = descend(0)
end dive

run_all: (runs: any fibre.turns) -> none ! failure.reason =
    mut backing: [2 * 8192]u8 = zeroed
    mut tasks := try fibre.turns_over(runs, backing, 2)
    defer fibre.join(tasks) else none
    task: deep = (runs: runs)
    try fibre.admit(tasks, dive, task)
    try fibre.join(tasks)
end run_all

public main: () -> (code: i32) =
    code = 1
    mut state: stacks.round_space = zeroed
    mut entries: [3]usize = zeroed
    idler: stacks.spin = zeroed
    round := stacks.round_over(state, entries, any(addr idler)) else (problem)
        _ = problem
        return
    end
    run_all(any(addr round)) else none
    code = 0
end main
