display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

thing: type = struct
    value: i32
end thing

holder: type = struct
    item: any display
end holder

thing_code: (self: ptr thing) -> (value: i32) =
    value = self.val.value
end thing_code

thing is display (code: thing_code)

public main: () -> (code: i32) =
    item: thing = (value: 42)
    wrapped: holder = (item: any(addr item))
    code = wrapped.item.code()
end main
