as_bytes: (source: utf8) -> (result: []u8 from source) =
    result = []u8(source)
end as_bytes
c_bytes: (source: cstring) -> (result: []u8 from source) =
    result = []u8(source)
end c_bytes
public main: () -> (code: i32) =
    mut storage: [10]u8 =
        [65, 194, 162, 226, 152, 131, 240, 159, 152, 128]
    source: []u8 = storage[0..<lenof storage]
    text: utf8 = utf8(source)
    bytes: []u8 = as_bytes(text)
    nested: utf8 = utf8([]u8(text))
    terminated: cstring = "A\u{0}ignored"
    prefix: []u8 = []u8(terminated)
    prefix_text: utf8 = utf8(terminated)
    empty_c: cstring = ""
    empty_bytes: []u8 = c_bytes(empty_c)
    empty_text: utf8 = utf8(empty_c)
    empty_source: []u8 = source[1..<1]
    empty_view: []u8 = []u8(utf8(empty_source))
    if lenof bytes == 10 and bytes[1] == 194 and bytes[9] == 128
      and lenof nested == 10 and lenof prefix == 1 and prefix[0] == 65
      and lenof prefix_text == 1 and lenof empty_bytes == 0
      and lenof empty_text == 0 and lenof empty_view == 0
      and usize(addr bytes[0]) == usize(addr source[0])
    then
        code = 42
    else
        code = 1
    end if
end main
