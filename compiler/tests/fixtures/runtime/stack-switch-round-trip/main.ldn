--  D450: main prepares a stack from module storage, switches to it, and
--  the fibre switches back; main switches to it again and it switches back
--  a second time.  Each side appends a letter to `trace` and folds a digit
--  into `shared`, so the status says both the order the two stacks ran in
--  and that module state one stack wrote was read by the other across
--  every switch (D446): at the highest optimization a value kept in a
--  register over a switch would fail it.  `kept` is a local that lives in
--  main's frame across both switches.  It imports nothing, so firmware runs
--  the same source, the prepared stack there on the process stack (D460).
mut backing: [2048]u8 = zeroed
mut main_saved: usize = 0
mut fibre_saved: usize = 0
mut shared: u64 = 0
mut trace: [8]u8 = zeroed
mut steps: usize = 0

note: (letter: u8) -> none =
    trace[steps] = letter
    steps += 1
end note

fibre: (argument: usize) -> noreturn =
    note(u8(argument))
    shared = shared * 10 + 2
    compiler.stack_switch(addr fibre_saved, main_saved)
    note(u8(argument) + 2)
    shared = shared * 10 + 4
    compiler.stack_switch(addr fibre_saved, main_saved)
    compiler.unreachable()
end fibre

public main: () -> (code: i32) =
    note(97)
    kept: u64 = u64(steps) * 1000 + 7
    fibre_saved = compiler.stack_prepare(backing[0..<2048], fibre, 98)
    shared = 1
    compiler.stack_switch(addr main_saved, fibre_saved)
    note(99)
    shared = shared * 10 + 3
    compiler.stack_switch(addr main_saved, fibre_saved)
    note(101)
    shared = shared * 10 + 5
    code = 0
    if steps <> 5 or trace[0] <> 97 or trace[1] <> 98 then
        code = 1
    elsif trace[2] <> 99 or trace[3] <> 100 or trace[4] <> 101 then
        code = 1
    elsif shared <> 12345 then
        code = 2
    elsif kept <> 1007 then
        code = 3
    end if
end main
