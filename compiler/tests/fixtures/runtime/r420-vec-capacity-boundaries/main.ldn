import core/arena
import core/fault
import core/mem
import core/vec

probe_state: type = struct
    calls: usize
    frees: usize
    last_alloc_size: usize
    last_free_size: usize
    base: ptr mut u8
end probe_state

probe: type = struct
    state: ptr mut probe_state
end probe

probe_alloc: (self: probe, size: usize, alignment: usize)
             -> (block: ptr mut u8) ! mem.out_of_memory =
    _ = alignment
    inc self.state.val.calls
    self.state.val.last_alloc_size = size
    block = ptr(usize(self.state.val.base))
end probe_alloc

probe_free: (self: probe, block: ptr mut u8, size: usize) -> none =
    _ = block
    inc self.state.val.frees
    self.state.val.last_free_size = size
end probe_free

probe_grow: (self: probe, block: ptr mut u8,
             old_size: usize, new_size: usize, alignment: usize)
            -> (grown: bool) =
    _ = self.state
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end probe_grow

--  Resizing moves the block, through this provider's own allocation
--  and free.
probe_resize: (self: probe, block: ptr mut u8,
               old_size: usize, new_size: usize, alignment: usize)
              -> (moved: ptr mut u8) ! mem.out_of_memory =
    moved = try mem.relocate(self, block, old_size, new_size, alignment)
end probe_resize

probe is mem.allocator (alloc: probe_alloc, grow: probe_grow,
                        resize: probe_resize, free: probe_free)

zero_item: type = [0]u8

public main: () -> (code: i32) =
    maximum: usize = 0 -% 1
    item_size: usize = sizeof u64
    largest: usize = maximum / item_size
    impossible: usize = largest + 1

    mut bytes: [16]u8 = zeroed
    base: ptr mut u8 = addr bytes[0]

    mut overflow_state: probe_state =
        (calls: 0, frees: 0, last_alloc_size: 0,
         last_free_size: 0, base: base)
    overflow_probe: probe = (state: addr overflow_state)
    mut overflow_values := vec.new(item: u64)
    mut overflow_refused: bool = false
    vec.reserve(overflow_values, overflow_probe, impossible) else (problem)
        _ = problem
        overflow_refused = true
    end

    --  The last representable positive-sized capacity reaches the provider
    --  with its exact, non-wrapped byte extent. No item is admitted, so the
    --  deliberately synthetic backing address is never dereferenced.
    mut exact_state: probe_state =
        (calls: 0, frees: 0, last_alloc_size: 0,
         last_free_size: 0, base: base)
    exact_probe: probe = (state: addr exact_state)
    mut exact_values := vec.new(item: u64)
    vec.reserve(exact_values, exact_probe, largest) else none
    vec.release(exact_values, exact_probe)

    mut zero_state: probe_state =
        (calls: 0, frees: 0, last_alloc_size: maximum,
         last_free_size: maximum, base: base)
    zero_probe: probe = (state: addr zero_state)
    mut zero_values := vec.new(item: zero_item)
    empty_value: zero_item = zeroed
    for index in 0..<9 do
        _ = index
        vec.push(zero_values, zero_probe, empty_value) else none
    end for
    last_index: usize = 8
    last_zero: zero_item = vec.get(zero_values, last_index) else (problem)
        _ = problem
        code = 1
        return
    end
    _ = last_zero
    removed_zero: zero_item = vec.pop(zero_values) else (problem)
        _ = problem
        code = 1
        return
    end
    vec.push(zero_values, zero_probe, removed_zero) else none
    zero_length: usize = vec.length(zero_values)
    zero_capacity: usize = vec.capacity(zero_values)
    vec.release(zero_values, zero_probe)
    vec.release(zero_values, zero_probe)

    mut maximum_zero_state: probe_state =
        (calls: 0, frees: 0, last_alloc_size: maximum,
         last_free_size: maximum, base: base)
    maximum_zero_probe: probe = (state: addr maximum_zero_state)
    mut maximum_zero := vec.new(item: zero_item)
    vec.reserve(maximum_zero, maximum_zero_probe, maximum) else none
    maximum_zero_capacity: usize = vec.capacity(maximum_zero)
    vec.release(maximum_zero, maximum_zero_probe)

    --  A refused second zero-byte allocation leaves the first allocation's
    --  initialized witness available for access and eventual release.
    mut refused_arena_space: arena.space = zeroed
    refused_arena := arena.over_unchecked(refused_arena_space, base, 0)
    mut refused_space: fault.space = zeroed
    refused_counted := fault.over(refused_space, refused_arena, usize(1))
    mut refused_values := vec.new(item: zero_item)
    for index in 0..<8 do
        _ = index
        vec.push(refused_values, refused_counted, empty_value) else none
    end for
    mut zero_growth_refused: bool = false
    vec.push(refused_values, refused_counted, empty_value) else (problem)
        _ = problem
        zero_growth_refused = true
    end
    retained_index: usize = 7
    retained_zero: zero_item = vec.get(refused_values, retained_index)
        else (problem)
        _ = problem
        code = 1
        return
    end
    _ = retained_zero
    refused_length: usize = vec.length(refused_values)
    refused_capacity: usize = vec.capacity(refused_values)
    refused_frees_before_release: usize = fault.frees(refused_counted)
    vec.release(refused_values, refused_counted)

    if overflow_refused
      and overflow_state.calls == 0 and overflow_state.frees == 0
      and vec.length(overflow_values) == 0
      and vec.capacity(overflow_values) == 0
      and exact_state.calls == 1 and exact_state.frees == 1
      and exact_state.last_alloc_size == largest * item_size
      and exact_state.last_free_size == largest * item_size
      and vec.capacity(exact_values) == 0
      and zero_length == 9 and zero_capacity == 16
      and zero_state.calls == 2 and zero_state.frees == 2
      and zero_state.last_alloc_size == 0
      and zero_state.last_free_size == 0
      and vec.length(zero_values) == 0 and vec.capacity(zero_values) == 0
      and maximum_zero_capacity == maximum
      and maximum_zero_state.calls == 1 and maximum_zero_state.frees == 1
      and maximum_zero_state.last_alloc_size == 0
      and maximum_zero_state.last_free_size == 0
      and zero_growth_refused and refused_length == 8
      and refused_capacity == 8 and refused_frees_before_release == 0
      and fault.successes(refused_counted) == 1
      and fault.frees(refused_counted) == 1
      and vec.length(refused_values) == 0
      and vec.capacity(refused_values) == 0
    then
        code = 42
    else
        code = 1
    end if
end main
