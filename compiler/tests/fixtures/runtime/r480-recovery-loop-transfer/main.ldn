again, finished: atom
bytes: [1]u8 = [42]
mut cleanups: i32 = 0

mark: () -> none = inc cleanups end mark

next: (inout state: i32) -> (line: []u8) ! again | finished =
    inc state
    fail again when state == 2
    fail finished when state >= 4
    line = bytes[0..<1]
end next

failed_value: () -> (value: u32) ! finished =
    fail finished
end failed_value

public main: () -> (code: i32) =
    mut state: i32 = 0
    mut total: i32 = 0
    loop do
        defer mark()
        line: []u8 = next(state) else (problem)
            continue when problem == again
            break when problem == finished
            bytes[0..<0]
        end
        total += i32(line[0])
    end loop
    outer: loop do
        defer mark()
        loop do
            defer mark()
            line: []u8 = next(state) else (problem)
                _ = problem
                break outer
            end
            total += i32(line[0])
        end loop
    end outer
    mut assigned: u32
    recovered: u32 = (failed_value() else (problem)
        _ = problem
        assigned = 41
        assigned
    end) + 1
    code = if state == 5 and total == 84 and cleanups == 6
              and recovered == 42
           then 42 else 1 end if
end main
