--  D1074: a program the grammar derives is read by the grammar, and where
--  its lines begin decides nothing [1750].  Every routine here is one the
--  parser used to refuse, or read otherwise, for how it was laid out: a
--  closer deeper than its header before a routine closed at the margin, a
--  closer ending its line under an indented signature, and a bare block's
--  `end` with `if`, `match` or `unchecked` beginning the next statement.
small, large: atom
size: type = small | large

deeper: () -> (r: i32) =
    r = 1
  end

named_deeper: () -> (r: i32) =
    r = 2
      end named_deeper

add: (a: i32,
      b: i32) -> (r: i32) =
    r = a + b end

value_then_if: (x: i32) -> (r: i32) =
    doubled := begin
        a: i32 = x
        a * 2
    end
    if doubled == 42 then
        r = 8
    else
        r = 0
    end if
end value_then_if

block_then_if: (x: i32) -> (r: i32) =
    r = 0
    if x > 0 then
        begin
            r = x
        end
        if r == 21 then
            r = 16
        end if
    end if
end block_then_if

block_then_match: (which: size) -> (r: i32) =
    mut seen: size = small
    begin
        seen = which
    end
    match seen
        small: r = 0
        large: r = 32
    end match
end block_then_match

block_then_unchecked: (wide: u32) -> (r: i32) =
    mut narrow: u8 = 0
    begin
        narrow = 1
    end
    unchecked begin
        narrow = u8(wide)
    end unchecked
    r = i32(narrow)
end block_then_unchecked

public main: () -> (code: i32) =
    code = deeper() + named_deeper() + add(1, 3) + value_then_if(21)
           + block_then_if(21) + block_then_match(large)
           + block_then_unchecked(320)
end
