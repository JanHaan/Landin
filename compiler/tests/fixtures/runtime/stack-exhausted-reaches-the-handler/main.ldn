--  D451: a selected handler receives the fifth kind.  Its match over
--  `panic.panic_kind` needs an arm for each of the five, and the switch
--  past its limit ends the process with the stack_exhausted arm's code.
import core/panic
import platform/posix

mut saved: usize = 0

public panic_handler: (kind: panic.panic_kind, site: u32) -> noreturn =
    posix.exit(match kind
        panic.stack_exhausted: if site <> 0 then 42 else 5 end if
        panic.out_of_range: 1
        panic.overflow: 2
        panic.bad_conversion: 3
        panic.unreachable: 4
    end match)
end panic_handler

public main: () -> (code: i32) =
    mut probe: u8 = 0
    limit := usize(addr probe) + 65536
    compiler.stack_switch(addr saved, 0, limit)
    code = i32(probe) + 99
end main
