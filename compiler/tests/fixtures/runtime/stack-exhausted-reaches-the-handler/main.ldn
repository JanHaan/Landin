--  D451/D471: a selected handler receives the fifth kind.  Its match over
--  `panic.panic_kind` needs an arm for each of the five.  A fibre's own
--  recursion goes deeper than its stack between switches, and the first
--  call whose frame would go below the stack's limit traps in its
--  prologue; the handler runs on what the limit's margin left, records the
--  kind and resumes main's context, saved when main switched to the fibre.
--  main, on its own stack again, finds the paint below the fibre's stack
--  whole and ends with the stack_exhausted arm's code.  It imports no
--  provider, so firmware runs the same source, the fibre there on the
--  process stack and the handler entered on it (D460).
import core/panic

mut memory: [4096]u8 = zeroed
mut main_saved: usize = 0
mut fibre_saved: usize = 0
mut seen: i32 = 6
mut depth: u32 = 0

public panic_handler: (kind: panic.panic_kind, site: u32) -> noreturn =
    seen = match kind
        panic.stack_exhausted: if site <> 0 then 42 else 5 end if
        panic.out_of_range: 1
        panic.overflow: 2
        panic.bad_conversion: 3
        panic.unreachable: 4
    end match
    compiler.stack_switch(addr fibre_saved, main_saved)
    loop do
    end loop
end panic_handler

--  Each level keeps a few words of its own and goes on without end.
descend: (level: u32) -> (reached: u32) =
    mut words: [8]u32 = zeroed
    words[usize(level % 8)] = level
    depth = level
    reached = descend(level + 1) + words[0]
end descend

fibre: (argument: usize) -> noreturn =
    seen = i32(descend(u32(argument)))
    loop do
    end loop
end fibre

public main: () -> (code: i32) =
    mut index: usize = 0
    while index < 256 do
        memory[index] = 90
        inc index
    end while
    fibre_saved = compiler.stack_prepare(memory[256..<4096], fibre, 0)
    compiler.stack_switch(addr main_saved, fibre_saved)
    code = seen
    index = 0
    while index < 256 do
        if memory[index] <> 90 then
            code = 7
        end if
        inc index
    end while
    if depth < 4 then
        code = 8
    end if
end main
