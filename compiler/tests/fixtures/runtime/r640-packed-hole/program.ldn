a: atom
b: atom
c: atom
mode: type = (a = 0 | b = 1 | c = 4)
image: type = layout(packed) struct
    mode: mode at 1..3
    flag: bool at 7
end image
public main: () -> (code: i32) =
    mut x: image = zeroed
    p: ptr mut u8 = ptr(usize(addr x))
    p.val = 0x65
    _ = x.mode
    x.mode = c
    code = 1
    if x.mode == c and p.val == 0x69 then
        x.mode = b
        if x.mode == b and p.val == 0x63 then code = 0 end if
    end if
end main
