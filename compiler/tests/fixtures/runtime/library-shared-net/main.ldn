import core/cmp
import core/net

--  The shipped evidence answers through the concepts alone, without a map
--  to carry it.
same: (item: type is cmp.equatable, left: item, right: item) -> (yes: bool) =
    yes = item.equal(left, right)
end same

digest: (item: type is cmp.hashable, value: item) -> (result: u64) =
    result = item.hash(value)
end digest

--  Loopback addresses of both families, a port put in place, which makes
--  another address, and the unspecified address told from them.
exercise: () -> (ok: bool) =
    ok = false
    four: net.address = net.loopback(net.ipv4, 80)
    six: net.address = net.loopback(net.ipv6, 80)
    return when four.family <> net.ipv4 or six.family <> net.ipv6
      or four.port <> 80 or four.octets[0] <> 127
    moved: net.address = net.with_port(four, 8080)
    return when moved.port <> 8080 or net.same_address(moved, four)
      or not net.same_address(net.with_port(moved, 80), four)
    --  Addresses are equal as same_address says, a zone included, and
    --  equal ones hash alike.
    zoned: net.address = net.with_zone(six, "lo") else (problem)
        _ = problem
        return
    end
    return when not same(four, net.with_port(moved, 80)) or same(four, moved)
      or same(six, zoned) or digest(four) <> digest(net.with_port(moved, 80))
      or digest(six) == digest(zoned)
    ok = net.is_unspecified(net.unspecified(net.ipv4, 0))
         and not net.is_unspecified(four)
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise()
    if ok then
        code = 42
    end if
end main
