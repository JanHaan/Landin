import core/io
import core/text
import hosted/io as hosted
import platform/posix

--  A host string is the bytes it was made over, lent and unconverted:
--  these are not UTF-8, which the checked conversion refuses, and they
--  spell no text but their own.
host_string_rules_code: () -> (code: i32) =
    code = 10
    raw: []u8 = "A\xffB"
    name: text.host_string = text.host_over(raw)
    bytes: []u8 = text.host_bytes(name)
    return when lenof bytes <> 3 or usize(addr bytes[0]) <> usize(addr raw[0])
    code = 11
    shown: utf8 = text.from_host(name) else (problem)
        if problem == text.invalid_text then code = 12 end if
        ""
    end
    _ = shown
    return when code <> 12
    code = 13
    plain: text.host_string = text.host_over("plain")
    return when not text.host_equal(plain, "plain")
      or text.host_equal(plain, "plai") or text.host_equal(name, "AB")
    code = 14
    as_text: utf8 = text.from_host(plain) else (problem)
        _ = problem
        return
    end
    return when not text.equal(as_text, "plain")
    code = 42
end host_string_rules_code

--  What the system says of a path no file can have: an empty one names
--  nothing, ENOENT; one holding a NUL is refused by the POSIX layer with
--  EINVAL, since no system can be given it; and one longer than the
--  system's PATH_MAX is ENAMETOOLONG.  Each errno is kept.
path_rules_code: (state: hosted.system) -> (code: i32) =
    mut opened: io.file = io.out(state)
    code = 32
    opened = io.open_read(state, text.host_over("")) else (problem)
        if problem <> io.not_found
          or hosted.last_errno(state) <> posix.number(posix.enoent)
        then
            return
        end if
        code = 33
        io.out(state)
    end
    return when code <> 33

    opened = io.open_read(state, text.host_over("A\x00B")) else (problem)
        if problem <> io.io_failed
          or hosted.last_errno(state) <> posix.number(posix.einval)
        then
            return
        end if
        code = 34
        io.out(state)
    end
    return when code <> 34

    long: [5000]u8 = [5000 of 97]
    opened = io.open_read(state, text.host_over(long[0..<5000]))
      else (problem)
        if problem <> io.io_failed
          or hosted.last_errno(state) <> posix.number(posix.enametoolong)
        then
            return
        end if
        code = 42
        io.out(state)
    end
end path_rules_code

no_second_argument: (state: any io.world) -> (yes: bool) =
    second: usize = 1
    unexpected := state.argument(second) else (problem)
        yes = problem == io.no_argument
        return
    end
    _ = text.host_bytes(unexpected)
    yes = false
end no_second_argument

missing_read_is_reported: (state: any io.world, path: text.host_string)
                          -> (yes: bool) =
    opened := state.open_read(path) else (problem)
        yes = problem == io.not_found
        return
    end
    state.close(opened) else (problem)
        _ = problem
    end
    yes = false
end missing_read_is_reported

missing_write_is_reported: (state: any io.world, path: text.host_string)
                           -> (yes: bool) =
    opened := state.open_write(path) else (problem)
        yes = problem == io.not_found
        return
    end
    state.close(opened) else (problem)
        _ = problem
    end
    yes = false
end missing_write_is_reported

denied_write_is_reported: (state: any io.world, path: text.host_string)
                          -> (yes: bool) =
    opened := state.open_write(path) else (problem)
        yes = problem == io.no_access
        return
    end
    state.close(opened) else (problem)
        _ = problem
    end
    yes = false
end denied_write_is_reported

public main: () -> (code: i32) =
    code = 1
    string_code: i32 = host_string_rules_code()
    if string_code <> 42 then
        code = string_code
        return
    end if

    host := hosted.host()
    code = 2
    if io.argument_count(host) <> 1 then
        return
    end if
    direct_index: usize = 0
    direct_source := io.argument_at(host, direct_index) else (problem)
        _ = problem
        return
    end
    code = 3
    direct_bytes: []u8 = text.host_bytes(direct_source)
    if lenof direct_bytes == 0 then
        return
    end if
    path_code: i32 = path_rules_code(host)
    if path_code <> 42 then
        code = path_code
        return
    end if
    world: any io.world = any(addr host)
    code = 4
    if world.argument_count() <> 1 then
        return
    end if

    code = 5
    first: usize = 0
    source := world.argument(first) else (problem)
        _ = problem
        return
    end
    code = 6
    source_bytes: []u8 = text.host_bytes(source)
    if lenof source_bytes == 0 then
        return
    end if
    return when not no_second_argument(world)
    code = 7

    --  The argument is passed on as a path, never converted.
    opened := world.open_read(source) else (problem)
        _ = problem
        return
    end
    code = 8
    mut copied_opened: io.file = opened
    mut input: [13]u8 = zeroed
    count: usize = world.read(opened, input[0..<13]) else (problem)
        _ = problem
        return
    end
    code = 9
    if count <> 13 or input[0] <> 112 or input[6] <> 32
      or input[12] <> 10
    then
        return
    end if
    code = 14
    eof: usize = world.read(opened, input[0..<13]) else (problem)
        _ = problem
        return
    end
    if eof <> 0 then
        return
    end if
    code = 15
    world.close(opened) else (problem)
        _ = problem
        return
    end
    code = 16
    world.close(copied_opened) else (problem)
        if problem <> io.io_failed then
            return
        end if
        copied_opened = world.out()
    end
    code = 17

    generic_host := hosted.host()
    written_path: text.host_string =
        text.host_over("/tmp/landin-r420-io-world.out")
    code = 18
    output := io.open_write(generic_host, written_path) else (problem)
        _ = problem
        return
    end
    code = 19
    payload: [7]u8 = [76, 97, 110, 100, 105, 110, 10]
    world.write(output, payload[0..<0]) else (problem)
        _ = problem
        return
    end
    world.write(output, payload[0..<7]) else (problem)
        _ = problem
        return
    end
    code = 20
    world.close(output) else (problem)
        _ = problem
        return
    end
    code = 21

    verify := io.open_read(generic_host, written_path) else (problem)
        _ = problem
        return
    end
    code = 22
    mut result: [8]u8 = zeroed
    result_length: usize = io.read(generic_host, verify, result[0..<8])
      else (problem)
        _ = problem
        return
    end
    code = 23
    io.close(generic_host, verify) else (problem)
        _ = problem
        return
    end
    code = 24
    if result_length <> 7 or result[0] <> 76 or result[1] <> 97
      or result[2] <> 110 or result[3] <> 100 or result[4] <> 105
      or result[5] <> 110 or result[6] <> 10
    then
        return
    end if
    code = 25

    missing_path: text.host_string =
        text.host_over("/definitely-not-a-landin-directory-r420/file")
    return when not missing_read_is_reported(world, missing_path)
    code = 26
    return when not missing_write_is_reported(world, missing_path)
    code = 27

    denied_path: text.host_string = text.host_over("/sys/landin-r420-denied")
    return when not denied_write_is_reported(world, denied_path)
    code = 28

    full_path: text.host_string = text.host_over("/dev/full")
    full := world.open_write(full_path) else (problem)
        _ = problem
        return
    end
    code = 29
    world.write(full, payload[0..<0]) else (problem)
        _ = problem
        return
    end
    mut saw_write_failure: bool = false
    world.write(full, payload[0..<7]) else (problem)
        if problem <> io.io_failed then
            return
        end if
        saw_write_failure = true
    end
    return when not saw_write_failure
    code = 30
    world.close(full) else (problem)
        _ = problem
        return
    end
    code = 31

    output_stream := world.out()
    error_stream := world.err()
    world.write(error_stream, payload[0..<0]) else (problem)
        _ = problem
        return
    end
    okay: [3]u8 = [79, 75, 10]
    world.write(output_stream, okay[0..<3]) else (problem)
        _ = problem
        return
    end
    code = 42
end main
