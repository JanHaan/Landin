inner: type = struct
    x: u32
end inner
holder: type = struct
    before: u32
    round: [4]u32
    after: u32
    deep: inner
end holder
outer: type = struct
    tag: u8
    held: holder
end outer
reset: (inout round: [4]u32, seed: u32) -> none =
    round[0] = seed
    round[3] += seed
end reset
replace: (inout round: [4]u32) -> none =
    round = [1, 2, 3, 4]
end replace
through: (inout whole: holder) -> none =
    reset(whole.round, 5)
end through
mut module_held: holder = zeroed
public main: () -> (code: i32) =
    code = 1
    mut held: holder = (before: 11, round: [1, 1, 1, 1], after: 12, deep: (x: 0))
    mut wide: outer = zeroed
    mut rows: [2]holder = zeroed
    reset(held.round, 7)
    reset(wide.held.round, 3)
    reset(module_held.round, 2)
    reset(rows[1].round, 9)
    replace(wide.held.round)
    through(held)
    p := addr held
    reset(p.val.round, 1)
    if held.before == 11 and held.after == 12 and held.round[0] == 1
      and held.round[3] == 14 and held.round[1] == 1
      and wide.held.round[0] == 1 and wide.held.round[3] == 4
      and module_held.round[0] == 2 and module_held.round[3] == 2
      and rows[1].round[0] == 9 and rows[0].round[0] == 0
    then
        code = 42
    end if
end main
