--  [0370], D14 and D17: a measurement is a usize the target decides.
--  These answers are checked against what the System V ABI says for x86-64.
row: type = [3]u16
packet: type = row
header: type = struct
    tag: u8
    payload: u64
    tail: u16
end header
header_alias: type = header
header_image: [2]usize = [sizeof header, alignof header_alias]

public main: () -> (code: i32) =
    if sizeof u8 == 1 and alignof u8 == 1
        and sizeof u16 == 2 and alignof u16 == 2
        and sizeof u32 == 4 and alignof u32 == 4
        and sizeof u64 == 8 and alignof u64 == 8
        and sizeof i8 == 1 and sizeof i64 == 8
        and sizeof bool == 1 and alignof bool == 1
        and sizeof usize == 8 and sizeof isize == 8
        and sizeof [3]u16 == 6 and alignof [3]u16 == 2
        and sizeof packet == 6 and alignof packet == 2
        and sizeof header == 24 and alignof header == 8
        and sizeof header_alias == 24 and alignof header_alias == 8
        and header_image[0] == 24 and header_image[1] == 8
    then
        code = 42
    else
        code = 1
    end if
end main
