mut trace: i32 = 0

int_unary: () -> (r: i64) = -(begin r = 42 return end) end int_unary
int_binary: () -> (r: i64) = -((begin r = 42 return end) + -(-(begin r = 1 return end))) end int_binary
float_unary: () -> (r: f64) = -(begin r = 1.0000000000000002 return end) end float_unary
float_binary: () -> (r: f64) = -((begin r = 1.0000000000000002 return end) + -(-(begin r = 1.0 return end))) end float_binary
array_unary: () -> (r: [3]i32) = -(begin r = [14, 14, 14] return end) end array_unary
array_binary: () -> (r: [3]i32) = -((begin r = [14, 14, 14] return end) + -(-(begin r = [1, 1, 1] return end))) end array_binary
float_array: () -> (r: [3]f64) = -(-(-(begin r = [1.0000000000000002, 2.0, 3.0] return end))) end float_array

empty_unary: () -> (r: [0]i32) = -(begin trace = trace * 10 + 1 r = zeroed return end) end empty_unary
empty_binary: () -> (r: [0]i32) = -((begin trace = trace * 10 + 2 r = zeroed return end) + -(-(begin trace = 99 r = zeroed return end))) end empty_binary
empty_float: () -> (r: [0]f64) = -(-(-(begin trace = trace * 10 + 3 return end))) end empty_float

int_branch: (stop: bool, a: i64) -> (r: i64) =
    -(-(-(if stop then r = 42 return else a end if)))
end int_branch

float_branch: (stop: bool, a: f64) -> (r: f64) =
    -(-(-(if stop then r = 1.0000000000000002 return else a end if)))
end float_branch

array_branch: (stop: bool, a: [3]i32) -> (r: [3]i32) =
    -(-(-(if stop then r = [14, 14, 14] return else a end if)))
end array_branch

empty_branch: (stop: bool, a: [0]i32) -> (r: [0]i32) =
    -(-(-(if stop then trace = trace * 10 + 4 return else trace = trace * 10 + 5 a end if)))
end empty_branch

public main: () -> (code: i32) =
    code = 1
    if int_unary() <> 42 or int_binary() <> 42 then return end if
    if float_unary() <> 1.0000000000000002 then return end if
    if float_binary() <> 1.0000000000000002 then return end if
    a := array_unary()
    b := array_binary()
    c := float_array()
    if a[0] + a[1] + a[2] <> 42 then return end if
    if b[0] + b[1] + b[2] <> 42 then return end if
    if c[0] <> 1.0000000000000002 or c[1] <> 2.0 or c[2] <> 3.0 then return end if
    e := empty_unary()
    f := empty_binary()
    g := empty_float()
    if lenof e + lenof f + lenof g <> 0 or trace <> 123 then return end if
    if int_branch(true, 3) <> 42 or int_branch(false, 3) <> -3 then return end if
    if float_branch(true, 2.0) <> 1.0000000000000002 then return end if
    if float_branch(false, 2.0) <> -2.0 then return end if
    yes := array_branch(true, a)
    no := array_branch(false, a)
    if yes[0] + yes[1] + yes[2] <> 42 then return end if
    if no[0] + no[1] + no[2] <> -42 then return end if
    empty_yes := empty_branch(true, e)
    empty_no := empty_branch(false, e)
    if lenof empty_yes + lenof empty_no <> 0 or trace <> 12345 then return end if
    code = 42
end main
