fixed if compiler.arch == cortex_m0 then
    extern(interrupt) handler: () -> none =
        assembler.block("nop")
    end handler
    extern(naked) raw_handler: () -> none =
        assembler.block("bx lr")
    end raw_handler
    interrupt_base: type = extern(interrupt) () -> none
    interrupt_hidden: type = distinct interrupt_base
    naked_base: type = extern(naked) () -> none
    naked_hidden: type = distinct naked_base
    hidden_interrupt: interrupt_hidden = interrupt_hidden(handler)
    hidden_naked: naked_hidden = naked_hidden(raw_handler)
    alias_interrupt: interrupt_base = interrupt_base(hidden_interrupt)
    alias_naked: naked_base = naked_base(hidden_naked)
    written_interrupt: interrupt_base = extern(interrupt) () -> none(hidden_interrupt)
    written_naked: naked_base = extern(naked) () -> none(hidden_naked)
end if
public main: () -> (code: i32) = code = 42 end main
