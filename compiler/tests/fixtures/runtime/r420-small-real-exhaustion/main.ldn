--  Real inner-provider exhaustion for core/spill, in both states the spilled
--  path has: the first spill out of the inline arm, and a later growth of the
--  already spilled list. Nothing here uses an injected failure schedule.

import core/mem
import core/pool
import core/spill

--  Zero inline capacity spills on the first push. A 16-byte arena cannot
--  hold the eight-slot first capacity, so no arm is published at all.
zero_inline_first_spill: () -> (ok: bool) =
    ok = false
    mut backing: [2]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr backing[0]))
    extent: usize = 2 * sizeof u64
    mut state := mem.arena_over_unchecked(base, extent)
    mut values := spill.new(item: i32, inline_slots: 0)

    mut refused: bool = false
    spill.push(values, state, 21) else (problem)
        refused = problem == mem.out_of_memory
    end
    mut empty_view: bool = false
    begin
        view := spill.used(values)
        empty_view = lenof view == 0
    end
    ok = refused and empty_view and spill.length(addr values) == 0
         and spill.capacity(addr values) == 0 and mem.arena_used(state) == 0
    spill.release(values, state)
    ok = ok and spill.length(addr values) == 0 and mem.arena_used(state) == 0
end zero_inline_first_spill

--  A nonzero inline arm survives a refused first spill unchanged: the doubled
--  first capacity needs 16 bytes and the arena has 8.
inline_arm_survives_first_spill: () -> (ok: bool) =
    ok = false
    mut backing: [1]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr backing[0]))
    extent: usize = sizeof u64
    mut state := mem.arena_over_unchecked(base, extent)
    mut values := spill.new(item: i32, inline_slots: 2)

    spill.push(values, state, 21) else (problem)
        _ = problem
        return
    end
    spill.push(values, state, 22) else (problem)
        _ = problem
        return
    end
    --  Both pushes stayed below the inline bound and asked for nothing.
    return when mem.arena_used(state) <> 0 or spill.capacity(addr values) <> 2

    mut refused: bool = false
    spill.push(values, state, 23) else (problem)
        refused = problem == mem.out_of_memory
    end
    mut kept: bool = false
    begin
        view := spill.used(values)
        kept = lenof view == 2 and view[0] == 21 and view[1] == 22
    end
    --  No premature variant switch and no free of an arm that never existed.
    ok = refused and kept and spill.length(addr values) == 2
         and spill.capacity(addr values) == 2 and mem.arena_used(state) == 0
    spill.release(values, state)
    ok = ok and spill.length(addr values) == 0 and spill.capacity(addr values) == 2
end inline_arm_survives_first_spill

--  With exactly the first capacity available the spill succeeds and consumes
--  the whole extent, so the next growth is refused by the arena and the
--  already spilled arm must survive with its contents.
spilled_arm_survives_growth: () -> (ok: bool) =
    ok = false
    mut backing: [2]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr backing[0]))
    extent: usize = 2 * sizeof u64
    mut state := mem.arena_over_unchecked(base, extent)
    mut values := spill.new(item: i32, inline_slots: 2)

    mut at: i32 = 31
    while at < 35 do
        spill.push(values, state, at) else (problem)
            _ = problem
            return
        end
        inc at
    end while
    --  Four items: two copied out of the inline arm plus two admitted into
    --  the spare slots the spill reserved. The extent is now consumed.
    return when spill.length(addr values) <> 4 or spill.capacity(addr values) <> 4
      or mem.arena_used(state) <> extent

    mut refused: bool = false
    spill.push(values, state, 35) else (problem)
        refused = problem == mem.out_of_memory
    end
    mut kept: bool = false
    begin
        view := spill.used(values)
        kept = lenof view == 4 and view[0] == 31 and view[1] == 32
               and view[2] == 33 and view[3] == 34
    end
    ok = refused and kept and spill.length(addr values) == 4
         and spill.capacity(addr values) == 4 and mem.arena_used(state) == extent

    tail: i32 = spill.pop(values) else (problem)
        _ = problem
        return
    end
    ok = ok and tail == 34 and spill.length(addr values) == 3
    spill.release(values, state)
    --  The arena's free is a no-op, so the offset does not move.
    ok = ok and spill.length(addr values) == 0 and spill.capacity(addr values) == 2
         and mem.arena_used(state) == extent
end spilled_arm_survives_growth

--  One pool slot lets the spill happen but cannot hold the old and the new
--  list at the same time, which is what the later growth needs. Releasing
--  the container returns the slot and a second container reuses it.
pool_spill_limit_and_reuse: () -> (ok: bool) =
    ok = false
    mut words: [2]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]))
    mut records: [1]pool.slot = zeroed
    mut state := pool.over(base, 2 * sizeof u64, 16, 1, 8,
                           records[0..<1]) else (problem)
        _ = problem
        return
    end
    mut values := spill.new(item: i32, inline_slots: 1)

    spill.push(values, state, 41) else (problem)
        _ = problem
        return
    end
    return when pool.allocations(state) <> 0
    spill.push(values, state, 42) else (problem)
        _ = problem
        return
    end
    --  The spill took the only slot for a two-slot list.
    return when spill.length(addr values) <> 2 or spill.capacity(addr values) <> 2
      or pool.live(state) <> 1 or pool.allocations(state) <> 1

    mut refused: bool = false
    spill.push(values, state, 43) else (problem)
        refused = problem == mem.out_of_memory
    end
    mut kept: bool = false
    begin
        view := spill.used(values)
        kept = lenof view == 2 and view[0] == 41 and view[1] == 42
    end
    --  The four-slot block would have fitted the slot; the old list still
    --  occupies it, and no heap extended the pool behind the refusal.
    return when not refused or not kept or spill.length(addr values) <> 2
      or spill.capacity(addr values) <> 2 or pool.live(state) <> 1
      or pool.allocations(state) <> 1 or pool.frees(state) <> 0

    spill.release(values, state)
    return when pool.live(state) <> 0 or pool.frees(state) <> 1

    mut again := spill.new(item: i32, inline_slots: 1)
    spill.push(again, state, 51) else (problem)
        _ = problem
        return
    end
    spill.push(again, state, 52) else (problem)
        _ = problem
        return
    end
    begin
        view := spill.used(again)
        ok = lenof view == 2 and view[0] == 51 and view[1] == 52
             and pool.allocations(state) == 2
             and pool.live(state) == 1
    end
    spill.release(again, state)
    ok = ok and pool.live(state) == 0 and pool.frees(state) == 2
         and pool.rejected_frees(state) == 0
end pool_spill_limit_and_reuse

public main: () -> (code: i32) =
    code = 1
    if zero_inline_first_spill() and inline_arm_survives_first_spill()
      and spilled_arm_survives_growth() and pool_spill_limit_and_reuse()
    then
        code = 42
    end if
end main
