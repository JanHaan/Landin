import core/arena
import core/cmp
import core/map
import core/mem
import core/net
import core/sort
import core/text
import core/time

--  No conformance is declared here: every key and ordering is the library's.

--  Spans sort, and maps key by instants and by addresses, a zone telling
--  two addresses apart as `net.same_address` does.
timed: (memory: arena.arena) -> (ok: bool)
       ! mem.out_of_memory | map.missing | net.invalid_address =
    ok = false
    mut spans: [4]time.duration = [time.seconds(1), time.nanoseconds(7),
                                   time.milliseconds(2), time.nanoseconds(0)]
    sort.sort(spans[0..<4])
    return when spans[0] <> time.nanoseconds(0) or spans[1] <> time.nanoseconds(7)
      or spans[2] <> time.milliseconds(2) or spans[3] <> time.seconds(1)

    start: time.instant = time.instant(1000)
    mut deadlines := map.new(key: time.instant, item: u8, seed: test_seed())
    try map.insert(deadlines, memory, start, u8(1))
    try map.insert(deadlines, memory, time.later(start, time.seconds(1)), u8(2))
    try map.insert(deadlines, memory, time.instant(1000), u8(3))
    again: u8 = try map.get(deadlines, start)
    later: u8 = try map.get(deadlines, time.instant(1000001000))
    return when again <> 3 or later <> 2 or map.length(deadlines) <> 2
      or map.contains(deadlines, time.instant(0))

    bare: net.address = net.ipv6_address([0xfe80, 0, 0, 0, 0, 0, 0, 1], 80)
    zoned: net.address = try net.with_zone(bare, "eth0")
    mut peers := map.new(key: net.address, item: u8, seed: test_seed())
    try map.insert(peers, memory, net.loopback(net.ipv4, 80), u8(4))
    try map.insert(peers, memory, bare, u8(6))
    try map.insert(peers, memory, zoned, u8(7))
    read: net.address = try net.parse_address("127.0.0.1:80")
    four: u8 = try map.get(peers, read)
    near: u8 = try map.get(peers, try net.parse_address("[fe80::1%eth0]:80"))
    return when four <> 4 or near <> 7 or map.length(peers) <> 3
      or map.contains(peers, net.loopback(net.ipv4, 81))

    map.release(peers, memory)
    map.release(deadlines, memory)
    ok = true
end timed

exercise: () -> (ok: bool) ! mem.out_of_memory | map.missing | text.invalid_text =
    ok = false
    mut backing: [3072]u8 = zeroed
    mut space: arena.space = zeroed
    memory := arena.over_unchecked(space, addr backing[0], lenof backing)

    least: i32 = (0 - 2147483647) - 1
    mut signed := map.new(key: i32, item: u8, seed: test_seed())
    try map.insert(signed, memory, -1, u8(1))
    try map.insert(signed, memory, 0, u8(2))
    try map.insert(signed, memory, least, u8(3))
    first: u8 = try map.get(signed, -1)
    second: u8 = try map.get(signed, 0)
    third: u8 = try map.get(signed, least)
    return when first <> 1 or second <> 2 or third <> 3
    return when map.contains(signed, 1)

    alpha: []u8 = "alpha"
    beta: []u8 = "beta"
    mut names := map.new(key: []u8, item: u32, seed: test_seed())
    try map.insert(names, memory, alpha, u32(1))
    try map.insert(names, memory, beta, u32(2))
    mut spelled: [5]u8 = zeroed
    mut at: usize = 0
    while at < lenof alpha do
        spelled[at] = alpha[at]
        inc at
    end while
    --  Equal bytes at a different address are the same key.
    copied: []u8 = spelled[0..<5]
    found: u32 = try map.get(names, copied)
    return when found <> 1 or map.length(names) <> 2

    mut words := map.new(key: utf8, item: u32, seed: test_seed())
    try map.insert(words, memory, "one", u32(1))
    try map.insert(words, memory, "two", u32(2))
    try map.insert(words, memory, "one", u32(10))
    one: u32 = try map.get(words, "one")
    return when one <> 10 or map.length(words) <> 2
    typed: utf8 = try text.from_bytes("two")
    two: u32 = try map.get(words, typed)
    return when two <> 2

    --  A walk visits each live entry once, in insertion order, and ends
    --  with `end_of_entries`; replacing an item kept "one" first.
    mut position := map.entries()
    mut walked: u32 = 0
    mut order: u32 = 0
    loop do
        entry: map.entry(utf8, u32) = map.next_entry(words, position) else (problem)
            _ = problem
            break
        end
        order = order * 100 + entry.item
        inc walked
    end loop
    return when walked <> 2 or order <> 1002

    mut texts: [3]utf8 = ["pear", "apple", "fig"]
    sort.sort(texts[0..<3])
    return when not text.equal(texts[0], "apple") or not text.equal(texts[1], "fig")
      or not text.equal(texts[2], "pear")
    mut numbers: [4]i64 = [3, -5, 0, -1]
    sort.sort(numbers[0..<4])
    return when numbers[0] <> -5 or numbers[1] <> -1 or numbers[2] <> 0
      or numbers[3] <> 3
    mut bytes: [3]u8 = [9, 2, 5]
    sort.sort_selection(bytes[0..<3])
    return when bytes[0] <> 2 or bytes[2] <> 9

    map.release(words, memory)
    map.release(names, memory)
    map.release(signed, memory)
    ok = timed(memory) else false
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main

--  A constant seed: the same probes and rebuilds on every run.
test_seed: () -> (seed: cmp.hash_seed) =
    seed = cmp.seed_from(1, 2)
end test_seed
