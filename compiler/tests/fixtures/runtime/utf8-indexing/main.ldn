import core/text

nth: (source: utf8, index: u32) -> (result: u32) =
    result = source[index]
end nth

at: (source: utf8, cursor: text.position) -> (result: u32) =
    result = source[cursor]
end at

--  A, the two bytes of U+00E9 and the three of U+2603 come first.
position_of_emoji: () -> (result: text.position) =
    mut dummy: [1]u8 = [0]
    mut cursor := text.first(dummy[0..<1])
    mut step: u32 = 0
    while step < 6 do
        text.advance(cursor)
        inc step
    end while
    result = cursor
end position_of_emoji

public main: () -> (code: i32) =
    source: utf8 = "A\u{e9}\u{2603}\u{1f600}Z"
    mut dummy: [1]u8 = [0]
    zero := text.first(dummy[0..<1])
    snowman_at: u32 = at(source, text.next(text.next(text.next(zero))))
    emoji_at: u32 = at(source, position_of_emoji())
    snowman: []u8 = text.bytes(source[3..3])

    --  Each ordinal agrees with the scalar traversal decodes there.
    mut ordinal: u32 = 0
    mut agree := true
    for scalar in source do
        agree = agree and scalar == nth(source, ordinal)
        inc ordinal
    end for

    if source[0] == 'A' and nth(source, 1) == '\u{e9}'
      and nth(source, 2) == '\u{2603}' and nth(source, 3) == '\u{1f600}'
      and nth(source, 4) == 'Z'
      and at(source, zero) == 'A'
      and snowman_at == 9731 and emoji_at == 128512
      and lenof snowman == 3 and snowman[0] == 226 and snowman[2] == 131
      and agree and ordinal == 5
    then
        code = 42
    else
        code = 1
    end if
end main
