packet: type = struct
    kind: variant
        leaf |
        row: (values: [3]u8) |
        grid: (cells: [2][2]u16)
    end kind
end packet

mut state: packet

-- D85: a known index of an `inout` array payload takes every compound
-- assignment, whatever storage the match subject has.
through_parameter: (inout held: packet) -> none =
    match held.kind
        leaf: _ = 0
        row(inout values): if true then
                               values[1] *= 3
                               values[2] -%= 1
                           end if
        grid(inout cells): cells[1][0] |= 8
    end match
end through_parameter

public main: () -> (code: i32) =
    mut at: usize = 1
    inc at
    state.kind = row(values: [19, 23, 29])
    match state.kind
        leaf: _ = 0
        row(inout values): if true then
                               values[0] += 31
                               values[1] <<= 1
                               values[at] +%= 250
                           end if
        grid(inout cells): cells[0][0] = 0
    end match
    through_parameter(state)

    mut local: packet = packet(kind: grid(cells: [[1, 2], [3, 4]]), of zeroed)
    match local.kind
        leaf: _ = 0
        row(inout values): values[0] = 0
        grid(inout cells): if true then
                               cells[0][1] += 40
                               cells[1][1] -= 4
                           end if
    end match
    through_parameter(local)

    code = 1
    match state.kind
        leaf: _ = 0
        row(values): if values[0] == 50 and values[1] == 138
          and values[2] == 22
                     then
                         code = 2
                     end if
        grid(cells): _ = cells[0][0]
    end match
    match local.kind
        leaf: _ = 0
        row(values): _ = values[0]
        grid(cells): if code == 2 and cells[0][0] == 1 and cells[0][1] == 42
          and cells[1][0] == 11 and cells[1][1] == 0
                     then
                         code = 42
                     end if
    end match
end main
