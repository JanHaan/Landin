import core/mem
import core/pool

exercise: () -> (ok: bool) ! mem.out_of_memory =
    ok = false
    mut backing: [64]u8 = zeroed
    mut slots: [1]pool.slot = zeroed
    mut space: pool.space = zeroed
    slab := try pool.over(space, addr backing[0], 64, 16, 1, 1, slots[0..<1])
    address := try mem.allocate(slab, usize(16), usize(1))
    address.val = 42
    return when address.val <> 42 or pool.live(slab) <> 1
    _ = mem.allocate(slab, usize(1), usize(1)) else (problem)
        _ = problem
        mem.free(slab, address, usize(16))
        ok = pool.live(slab) == 0 and pool.frees(slab) == 1
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
