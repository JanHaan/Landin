--  A receive limit passes as `timed_out`, and the socket stays usable.
--  A receive on a connection whose peer sends nothing, and an accept on a
--  listener nothing connects to, each wait out a limit of 50 ms and no
--  less, by the monotonic clock; then the peer sends and the receive
--  takes it.  Darwin and FreeBSD do not limit an accept themselves, so
--  platform/posix waits the limit out there with poll.
import core/io
import core/net
import core/time
import hosted/blocking

--  The limit, and what waiting it out takes at the least.
limit: u64 = 50

--  Whether a receive and an accept each time out after the limit, and the
--  connection then receives what is sent.
timed: (host: blocking.host, family: net.address_family) -> (yes: bool)
       ! ... =
    listener: io.file = try net.listen(host, net.loopback(family, 0))
    at: net.address = try net.local_address(host, listener)
    client: io.file = try net.connect(host, at)
    server: io.file = try net.accept(host, listener)
    try net.set_timeouts(host, client, time.milliseconds(limit), time.seconds(0))
    try net.set_timeouts(host, listener, time.milliseconds(limit),
                         time.seconds(0))
    mut buffer: [8]u8 = zeroed
    began: time.instant = time.now(host)
    mut received: bool = false
    got: usize = net.receive(host, client, buffer[0..<8]) else (problem)
        received = problem == net.timed_out
        0
    end
    waited: time.duration = time.elapsed(began, time.now(host))
    began_accept: time.instant = time.now(host)
    mut accepted: bool = false
    other: io.file = net.accept(host, listener) else (problem)
        accepted = problem == net.timed_out
        listener
    end
    _ = other
    waited_accept: time.duration = time.elapsed(began_accept, time.now(host))
    try net.send(host, server, "late")
    later: usize = try net.receive(host, client, buffer[0..<8])
    yes = received and got == 0 and waited >= time.milliseconds(limit)
          and accepted and waited_accept >= time.milliseconds(limit)
          and later == 4
    try net.close_socket(host, server)
    try net.close_socket(host, client)
    try net.close_socket(host, listener)
end timed

public main: () -> (code: i32) =
    host := blocking.new()
    code = 1
    families: [2]net.address_family = [net.ipv4, net.ipv6]
    for family in families do
        yes: bool = timed(host, family) else (problem)
            _ = problem
            return
        end
        return when not yes
        inc code
    end for
    code = 42
end main
