import core/diag
import core/io
import core/io/hosted
import core/text

message_a: [2]u8 = [65, 10]
message_b: [2]u8 = [66, 10]
message_c: [2]u8 = [67, 10]

same_bytes: (actual: []u8, expected: []u8) -> (same: bool) =
    same = false
    return when lenof actual <> lenof expected
    mut at: usize = 0
    while at < lenof expected do
        return when actual[at] <> expected[at]
        inc at
    end while
    same = true
end same_bytes

check_position_writes: () -> (ok: bool) =
    ok = false
    files: []mut io.memory_file = []
    arguments: []io.argument = []
    mut output: [1]u8 = zeroed
    mut errors: [80]u8 = zeroed
    mut memory := io.memory_world(files, arguments, output[0..<1],
                                  errors[0..<lenof errors])
    destination: io.file = io.err(memory)
    world: any io.world = any(addr memory)
    mut stream := diag.to(addr world, addr destination)
    logger: any diag.log = any(addr stream)
    logger.note(text.at(message_a[0..<2], 0), diag.warning, "A")
      else (problem)
        _ = problem
        return
    end
    logger.note(text.at(message_b[0..<2], 1234567890), diag.error, "B")
      else (problem)
        _ = problem
        return
    end
    largest: usize = 0 -% 1
    logger.note(text.at(message_c[0..<2], largest), diag.warning, "C")
      else (problem)
        _ = problem
        return
    end
    bytes: []u8 = io.written_errors(memory)
    ok = memory.write_calls == 12 and
         same_bytes(bytes, "W:0:AE:1234567890:BW:18446744073709551615:C")
end check_position_writes

emit_notes: (inout logger: any diag.log) -> none ! io.io_failed =
    first: text.position = text.first(message_a[0..<2])
    second: text.position = text.next(first)
    third: text.position = text.next(second)
    try logger.note(first, diag.warning, message_a[0..<2])
    try logger.note(second, diag.error, message_b[0..<2])
    try logger.note(third, diag.warning, message_c[0..<2])
end emit_notes

public main: () -> (code: i32) =
    code = 1

    mut collected := diag.new_log(capacity: 3)
    mut bounded_log: any diag.log = any(addr collected)
    emit_notes(bounded_log) else (unexpected_bounded_failure)
        _ = unexpected_bounded_failure
        return
    end

    first_index: usize = 0
    second_index: usize = 1
    third_index: usize = 2
    first_note := diag.note_at(collected, first_index) else (missing_first)
        _ = missing_first
        return
    end
    second_note := diag.note_at(collected, second_index) else (missing_second)
        _ = missing_second
        return
    end
    third_note := diag.note_at(collected, third_index) else (missing_third)
        _ = missing_third
        return
    end
    first_byte: u8 = diag.message_byte(first_note, first_index)
      else (missing_first_byte)
        _ = missing_first_byte
        return
    end
    second_byte: u8 = diag.message_byte(second_note, first_index)
      else (missing_second_byte)
        _ = missing_second_byte
        return
    end
    third_byte: u8 = diag.message_byte(third_note, first_index)
      else (missing_third_byte)
        _ = missing_third_byte
        return
    end
    if diag.stored(collected) <> 3 or diag.dropped(collected) <> 0
      or not bounded_log.failed()
      or diag.position_of(first_note) <> 0
      or diag.position_of(second_note) <> 1
      or diag.position_of(third_note) <> 2
      or diag.severity_of(first_note) <> diag.warning
      or diag.severity_of(second_note) <> diag.error
      or diag.severity_of(third_note) <> diag.warning
      or diag.message_length(first_note) <> 2
      or diag.message_length(second_note) <> 2
      or diag.message_length(third_note) <> 2
      or first_byte <> 65
      or second_byte <> 66
      or third_byte <> 67
    then
        return
    end if

    mut host := hosted.host()
    diagnostic_stream := io.err(host)
    world: any io.world = any(addr host)
    mut immediate := diag.to(addr world, addr diagnostic_stream)
    mut streaming_log: any diag.log = any(addr immediate)
    emit_notes(streaming_log) else (unexpected_stream_failure)
        _ = unexpected_stream_failure
        return
    end
    if not streaming_log.failed() then
        return
    end if
    if not check_position_writes() then
        return
    end if

    mut overflowed := diag.new_log(capacity: 2)
    mut overflow_log: any diag.log = any(addr overflowed)
    emit_notes(overflow_log) else (unexpected_overflow_failure)
        _ = unexpected_overflow_failure
        return
    end
    if diag.stored(overflowed) <> 2 or diag.dropped(overflowed) <> 1
      or not overflow_log.failed()
    then
        return
    end if

    first_argument: usize = 0
    argument_source: ptr hosted.system = addr host
    path := io.argument_at(argument_source, first_argument)
      else (argument_failure)
        _ = argument_failure
        return
    end
    opened := world.open_read(path.data) else (open_failure)
        _ = open_failure
        return
    end
    dead_stream: io.file = opened
    world.close(opened) else (close_failure)
        _ = close_failure
        return
    end

    mut broken := diag.to(addr world, addr dead_stream)
    mut broken_log: any diag.log = any(addr broken)
    broken_log.note(text.first(message_a[0..<2]), diag.error,
                    message_a[0..<2])
      else begin
        code = 42
        return
    end
end main
