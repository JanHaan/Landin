import core/fault
import core/tree
import hosted/heap

public main: () -> (code: i32) =
    code = 1
    heap := heap.new()
    --  Seven growths of the node list, each first asking to grow in place
    --  (D356).  How many the heap grows where they are depends on the
    --  system's pages and where its mappings land, so the oracle holds what
    --  does not: every block given is freed once, a growth in place gives
    --  none, and the seven growth attempts are what attempts count beyond
    --  frees.  Fifteen attempts cover none grown in place.
    budget: usize = 15
    mut space: fault.space = zeroed
    counted := fault.over(space, heap, budget)
    zero_count: usize = 0
    one_count: usize = 1
    three_count: usize = 3
    four_count: usize = 4
    maximum: usize = 0 -% 1
    mut value := tree.new()
    a: tree.node_id = tree.add_leaf(value, counted, "a") else (problem)
        _ = problem
        return
    end
    b: tree.node_id = tree.add_leaf(value, counted, "b") else (problem)
        _ = problem
        return
    end
    c: tree.node_id = tree.add_leaf(value, counted, "c") else (problem)
        _ = problem
        return
    end
    root: tree.node_id = tree.add_branch(value, counted, "root", a,
                                         three_count)
        else (problem)
        _ = problem
        return
    end
    three: usize = tree.count_leaves(value, root) else 0
    zero: tree.node_id = tree.add_branch(value, counted, "empty", a,
                                         zero_count)
        else (problem)
        _ = problem
        return
    end
    empty: usize = tree.count_leaves(value, zero) else 1
    shared: tree.node_id = tree.add_branch(value, counted, "shared", a,
                                           four_count)
        else (problem)
        _ = problem
        return
    end
    six: usize = tree.count_leaves(value, shared) else 0
    mut deep: tree.node_id = root
    mut at: usize = 0
    while at < 512 do
        deep = tree.add_branch(value, counted, "nested", deep, one_count)
            else (problem)
            _ = problem
            return
        end
        inc at
    end while
    if not begin
        selected := tree.get(value, b) else (problem)
            _ = problem
            return
        end
        text: utf8 = tree.name(selected)
        lenof text == 1 and text[0] == 'b'
    end then
        return
    end if
    deep_count: usize = tree.count_leaves(value, deep) else 0
    --  Every range starts at the same branch and extends one child farther.
    --  The shared and empty nodes make the cumulative totals nonuniform.
    at = 0
    while at < 128 do
        span: usize = usize(at + 1)
        overlap: tree.node_id = tree.add_branch(value, counted, "overlap",
                                                root, span) else (problem)
            _ = problem
            return
        end
        observed: usize = tree.count_leaves(value, overlap) else 0
        if at < 2 then
            return when observed <> 3
        else
            return when observed <> 3 * span
        end if
        inc at
    end while
    before: usize = tree.length(value)
    mut invalid: bool = false
    _ = tree.add_branch(value, counted, "invalid", c, maximum)
        else (problem)
        _ = problem
        invalid = true
        return_id()
    end
    unchanged: bool = tree.length(value) == before
    tree.release(value, counted)
    if three == 3 and empty == 0 and six == 6 and deep_count == 3
      and invalid and unchanged and tree.length(value) == 0
      and fault.live(counted) == 0
      and fault.successes(counted) == fault.frees(counted)
      and fault.successes(counted) + fault.growths(counted) == 8
      and fault.attempts(counted) - fault.frees(counted) == 7
    then
        code = 42
    end if
end main

return_id: () -> (id: tree.node_id) = tree.id(0) end return_id
