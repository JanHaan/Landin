end signed_64_fixed_quotient

unsigned_8_fixed_remainder: (x: u8) -> (r: u8) =
    r = x % 128
end unsigned_8_fixed_remainder

unsigned_64_fixed_quotient: (x: u64) -> (r: u64) =
    r = x / 9223372036854775808
end unsigned_64_fixed_quotient

unsigned_64_fixed_remainder: (x: u64) -> (r: u64) =
    r = x % 9223372036854775808
end unsigned_64_fixed_remainder

nonpower_fixed_quotient: (x: u64) -> (r: u64) =
    r = x / 10
end nonpower_fixed_quotient

minus_one_fixed_remainder: (x: i64) -> (r: i64) =
    r = x % -1
end minus_one_fixed_remainder

