signed_8_fixed_quotient: (x: i8) -> (r: i8) =
    r = x / 8
end signed_8_fixed_quotient

signed_8_fixed_remainder: (x: i8) -> (r: i8) =
    r = x % -8
end signed_8_fixed_remainder

signed_16_fixed_quotient: (x: i16) -> (r: i16) =
    r = x / -256
end signed_16_fixed_quotient

signed_32_fixed_remainder: (x: i32) -> (r: i32) =
