import core/diag
import core/io
import hosted/io as hosted
import core/mem
import core/text
import examples/config_parser/lexer
import core/vec
import examples/config_parser/parser

--  Parsed nodes are retained through the public escaping arena capability.
--  Give the backing storage static lifetime, not a hidden frame origin.
mut first_memory: [4096]u8 = zeroed
mut second_memory: [4096]u8 = zeroed
mut tiny_memory: [1]u8 = zeroed
mut third_memory: [4096]u8 = zeroed
mut blank_memory: [1]u8 = zeroed
mut blank_source: [50000]u8 = zeroed
mut long_line: [100005]u8 = zeroed
mut long_line_memory: [4096]u8 = zeroed
mut depth_memory: [8192]u8 = zeroed

depth_group_is_expected: (node: ptr mut parser.value, level: usize)
                         -> (yes: bool) =
    yes = false
    match node.val.body
        parser.group_value(count, children): begin
            if count <> 1 then
                return
            end if
            child := vec.get(children, usize(0)) else (missing)
                _ = missing
                return
            end
            if level == 7 then
                match child.val.body
                    parser.integer_value(number): yes = number == 2
                    parser.text_value(begins, ends): return
                    parser.group_value(child_count, items): return
                end match
            else
                yes = depth_group_is_expected(child, level + 1)
            end if
        end
        parser.text_value(begins, ends): return
        parser.integer_value(number): return
    end match
end depth_group_is_expected

depth_recovery_is_expected: () -> (yes: bool) =
    yes = false
    source: []u8 = "g0 = {\ng1 = {\ng2 = {\ng3 = {\ng4 = {\ng5 = {\ng6 = {\ng7 = {\ng8 = {\ninner = {\nx = 1\n}\nafter = 9\n}\ny = 2\n}\n}\n}\n}\n}\n}\n}\n}\nz = 3\n"
    mut arena := mem.arena_over(addr depth_memory[0], lenof depth_memory)
    mut notes := diag.new(capacity: 4)
    mut logger: any diag.log = any(addr notes)
    mut tree := parser.empty()
    parser.parse_file(source, logger, arena, tree) else (problem)
        _ = problem
        return
    end
    if diag.length(addr notes) <> 1 or parser.length(tree) <> 2 then
        return
    end if
    note := diag.get(addr notes, usize(0)) else (missing)
        _ = missing
        return
    end
    if diag.message_length(note) <> 22 then
        return
    end if
    first := parser.at(tree, 0) else (missing)
        _ = missing
        return
    end
    if not depth_group_is_expected(first, 0) then
        return
    end if
    second := parser.at(tree, 1) else (missing)
        _ = missing
        return
    end
    match second.val.body
        parser.integer_value(number): yes = number == 3
        parser.text_value(begins, ends): return
        parser.group_value(count, items): return
    end match
end depth_recovery_is_expected

ast_is_expected: (tree: parser.document) -> (yes: bool) =
    yes = false
    if parser.length(tree) <> 3 then
        return
    end if

    first := parser.at(tree, 0) else (missing)
        _ = missing
        return
    end
    match first.val.body
        parser.text_value(begins, ends): begin
            if text.offset(begins) <> 8 or text.offset(ends) <> 16 then
                return
            end if
        end
        parser.integer_value(number): return
        parser.group_value(count, items): return
    end match

    second := parser.at(tree, 1) else (missing)
        _ = missing
        return
    end
    match second.val.body
        parser.integer_value(number): begin
            if number <> 42 then
                return
            end if
        end
        parser.text_value(begins, ends): return
        parser.group_value(count, items): return
    end match

    third := parser.at(tree, 2) else (missing)
        _ = missing
        return
    end
    match third.val.body
        parser.group_value(count, items): begin
            if count <> 2 then
                return
            end if
        end
        parser.text_value(begins, ends): return
        parser.integer_value(number): return
    end match
    yes = true
end ast_is_expected

notes_are_expected: (value: ptr diag.bounded(8), inout ok: bool) -> none =
    if diag.length(value) <> 3 or diag.dropped(value) <> 0 then
        ok = false
        return
    end if
    zero: usize = 0
    one: usize = 1
    two: usize = 2
    first := diag.get(value, zero) else (missing)
        _ = missing
        ok = false
        return
    end
    second := diag.get(value, one) else (missing)
        _ = missing
        ok = false
        return
    end
    third := diag.get(value, two) else (missing)
        _ = missing
        ok = false
        return
    end
    first_byte: u8 = diag.message_byte(first, zero) else (missing)
        _ = missing
        ok = false
        return
    end
    second_byte: u8 = diag.message_byte(second, zero) else (missing)
        _ = missing
        ok = false
        return
    end
    third_byte: u8 = diag.message_byte(third, zero) else (missing)
        _ = missing
        ok = false
        return
    end
    if diag.position_of(first) <> 36
      or diag.position_of(second) <> 65
      or diag.position_of(third) <> 90
      or diag.message_length(first) <> 13
      or diag.message_length(second) <> 20
      or diag.message_length(third) <> 15
      or first_byte <> 101 or second_byte <> 110 or third_byte <> 117
    then
        ok = false
    end if
end notes_are_expected

token_is: (source: []u8, inout scanning: lexer.state,
           what: lexer.kind, begins: usize, ends: usize) -> (yes: bool) =
    found: lexer.token = lexer.next(source, scanning)
    yes = found.what == what and text.offset(found.begins) == begins
          and text.offset(found.ends) == ends and scanning.cursor == ends
end token_is

lexer_positions_are_expected: () -> (yes: bool) =
    bytes: [20]u8 = [65, 95, 57, 33, 32, 9, 13, 49, 50, 51,
                     120, 32, 34, 97, 98, 34, 10, 34, 117, 10]
    source: []u8 = bytes[0..<20]
    mut scanning := lexer.open()
    yes = token_is(source, scanning, lexer.identifier, 0, 3)
          and token_is(source, scanning, lexer.bad_character, 3, 4)
          and token_is(source, scanning, lexer.number, 7, 10)
          and token_is(source, scanning, lexer.identifier, 10, 11)
          and token_is(source, scanning, lexer.string, 12, 16)
          and token_is(source, scanning, lexer.newline, 16, 17)
          and token_is(source, scanning, lexer.unterminated_string, 17, 19)
          and token_is(source, scanning, lexer.newline, 19, 20)
          and token_is(source, scanning, lexer.end_of_input, 20, 20)
end lexer_positions_are_expected

lexer_long_scans_are_expected: () -> (yes: bool) =
    mut bytes: [100002]u8 = zeroed
    mut at: usize = 0
    while at < 100000 do
        bytes[at] = 65
        inc at
    end while
    bytes[100000] = 33
    mut scanning := lexer.open()
    if not token_is(bytes[0..<100001], scanning, lexer.identifier, 0, 100000)
      or not token_is(bytes[0..<100001], scanning,
                      lexer.bad_character, 100000, 100001)
    then
        yes = false
        return
    end if

    at = 0
    while at < 100000 do
        bytes[at] = 57
        inc at
    end while
    scanning = lexer.open()
    if not token_is(bytes[0..<100001], scanning, lexer.number, 0, 100000)
      or not token_is(bytes[0..<100001], scanning,
                      lexer.bad_character, 100000, 100001)
    then
        yes = false
        return
    end if

    at = 0
    while at < 100000 do
        bytes[at] = 32
        inc at
    end while
    bytes[100000] = 65
    scanning = lexer.open()
    if not token_is(bytes[0..<100001], scanning,
                    lexer.identifier, 100000, 100001)
    then
        yes = false
        return
    end if

    bytes[0] = 34
    at = 1
    while at < 100001 do
        bytes[at] = 65
        inc at
    end while
    bytes[100001] = 34
    scanning = lexer.open()
    yes = token_is(bytes[0..<100002], scanning, lexer.string, 0, 100002)
end lexer_long_scans_are_expected

public main: () -> (code: i32) =
    code = 1
    mut host := hosted.host()
    world: any io.world = any(addr host)
    first_argument: usize = 0
    source_argument := world.argument(first_argument) else (problem)
        _ = problem
        return
    end
    opened := world.open_read(source_argument.data) else (problem)
        _ = problem
        return
    end
    dead_stream: io.file = opened
    mut source_bytes: [256]u8 = zeroed
    source_length: usize = world.read(opened, source_bytes[0..<256])
        else (problem)
        _ = problem
        return
    end
    world.close(opened) else (problem)
        _ = problem
        return
    end
    if source_length <> 92 then
        return
    end if
    source: []u8 = source_bytes[0..<source_length]

    mut first_arena := mem.arena_over_unchecked(addr first_memory[0], 4096)
    mut collected := diag.new(capacity: 8)
    mut bounded_log: any diag.log = any(addr collected)
    mut tree := parser.empty()
    parser.parse_file(source, bounded_log, first_arena, tree) else (problem)
        _ = problem
        return
    end
    mut valid: bool = ast_is_expected(tree) and bounded_log.failed()
    notes_are_expected(addr collected, valid)
    if not valid then
        return
    end if

    mut second_arena := mem.arena_over_unchecked(addr second_memory[0], 4096)
    diagnostic_stream := world.err()
    writer: any io.writer = any(addr host)
    mut immediate := diag.stream(addr writer, addr diagnostic_stream)
    mut streaming_log: any diag.log = any(addr immediate)
    mut streamed_tree := parser.empty()
    parser.parse_file(source, streaming_log, second_arena, streamed_tree)
        else (problem)
        _ = problem
        return
    end
    if not ast_is_expected(streamed_tree) or not streaming_log.failed() then
        return
    end if

    mut tiny_arena := mem.arena_over_unchecked(addr tiny_memory[0], 1)
    mut quiet := diag.new(capacity: 1)
    mut quiet_log: any diag.log = any(addr quiet)
    mut missing_tree := parser.empty()
    mut saw_out_of_memory: bool = false
    parser.parse_file(source, quiet_log, tiny_arena, missing_tree)
        else (problem)
        saw_out_of_memory = problem == mem.out_of_memory
    end
    if not saw_out_of_memory then
        return
    end if

    mut third_arena := mem.arena_over_unchecked(addr third_memory[0], 4096)
    mut broken := diag.stream(addr writer, addr dead_stream)
    mut broken_log: any diag.log = any(addr broken)
    mut interrupted_tree := parser.empty()
    mut saw_io_failure: bool = false
    parser.parse_file(source, broken_log, third_arena, interrupted_tree)
        else (problem)
        saw_io_failure = problem == io.io_failed
    end
    if not saw_io_failure then
        return
    end if

    if not lexer_positions_are_expected()
      or not lexer_long_scans_are_expected()
    then
        return
    end if
    --  Fifty thousand separate newline tokens exhausted an 8 MiB stack
    --  when the flat sequence walk retained one frame per token.
    mut at: usize = 0
    while at < 50000 do
        blank_source[at] = 10
        inc at
    end while
    mut blank_arena := mem.arena_over(addr blank_memory[0], 1)
    mut blank_notes := diag.new(capacity: 1)
    mut blank_log: any diag.log = any(addr blank_notes)
    mut blank_tree := parser.empty()
    parser.parse_file(blank_source[0..<50000], blank_log,
                      blank_arena, blank_tree) else (problem)
        _ = problem
        return
    end
    if parser.length(blank_tree) <> 0 or diag.length(addr blank_notes) <> 0
      or diag.dropped(addr blank_notes) <> 0 then
        return
    end if
    mut long_at: usize = 0
    while long_at < 100000 do
        long_line[long_at] = 64
        inc long_at
    end while
    long_line[100000] = 10
    long_line[100001] = 120
    long_line[100002] = 61
    long_line[100003] = 49
    long_line[100004] = 10
    mut long_arena := mem.arena_over(addr long_line_memory[0], 4096)
    mut long_notes := diag.new(capacity: 1)
    mut long_logger: any diag.log = any(addr long_notes)
    mut long_tree := parser.empty()
    parser.parse_file(long_line[0..<100005], long_logger, long_arena,
                      long_tree) else (problem)
        _ = problem
        return
    end
    if not long_logger.failed() or diag.length(addr long_notes) <> 1
      or parser.length(long_tree) <> 1 then
        return
    end if
    long_zero: usize = 0
    long_note := diag.get(addr long_notes, long_zero) else (missing)
        _ = missing
        return
    end
    if diag.position_of(long_note) <> 0
      or diag.message_length(long_note) <> 16 then
        return
    end if
    long_item := parser.at(long_tree, 0) else (missing)
        _ = missing
        return
    end
    match long_item.val.body
        parser.integer_value(number): begin
            if number <> 1 then
                return
            end if
        end
        parser.text_value(begins, ends): return
        parser.group_value(count, items): return
    end match
    if not depth_recovery_is_expected() then
        return
    end if

    code = 42
end main
