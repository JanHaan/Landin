convert: (source: []u8) -> (result: []u8 from source) =
    unchecked begin
        result = []u8(utf8(source))
    end unchecked
end convert
public main: () -> (code: i32) =
    mut storage: [3]u8 = [237, 160, 128]
    source: []u8 = storage[0..<lenof storage]
    _ = convert(source)
    code = 42
end main
