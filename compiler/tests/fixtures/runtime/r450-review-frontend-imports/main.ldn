import lib
import lib as things
import lib (values, row)
import other
public main: () -> (code: i32) =
    a: [2]i32 = lib.values + 1
    b := things.values + 1
    c := values + 1
    d := other.values + 1
    e := -things.values
    things.changing += 1
    f := lib.changing + 1
    if a[0] == 2 and a[1] == 3 and b[0] == 2 and b[1] == 3
        and c[0] == 2 and c[1] == 3 and d[0] == 8 and d[1] == 9
        and e[0] == -1 and e[1] == -2 and lenof row == 2
        and f[0] == 12 and f[1] == 22
    then code = 42 else code = 1 end if
end main
