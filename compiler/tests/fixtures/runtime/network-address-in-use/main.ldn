--  An address another socket holds is in use.  A second listener at the
--  first one's port is `address_in_use`, EADDRINUSE, though a listener
--  may take an address its closed connections still hold, and a second
--  UDP socket at a datagram socket's port is refused alike.  Over IPv4 and
--  IPv6.  A listener at a specific address beside one at the unspecified
--  address and the same port is not among them: Linux refuses it, and
--  Darwin and FreeBSD let the specific one take what is sent to it.
import core/io
import core/net
import hosted/system
import platform/posix

--  Whether binding a socket of the kind `listening` says at AT fails as
--  in use.
in_use: (host: system.host, at: net.address, listening: bool)
        -> (yes: bool) =
    yes = false
    second: io.file = opened(host, at, listening) else (problem)
        yes = problem == net.address_in_use
              and system.last_errno(host) == posix.number(posix.eaddrinuse)
        return
    end
    net.close_socket(host, second) else none
end in_use

--  A listener at AT, or with `listening` false a datagram socket.
opened: (host: system.host, at: net.address, listening: bool)
        -> (socket: io.file)
        ! net.address_in_use | net.address_unavailable | io.no_access
        | io.io_failed =
    if listening then
        socket = try net.listen(host, at)
    else
        socket = try net.open_datagram(host, at)
    end if
end opened

--  Whether every second binding of FAMILY's is refused.
refusals: (host: system.host, family: net.address_family) -> (yes: bool)
          ! ... =
    listener: io.file = try net.listen(host, net.loopback(family, 0))
    at: net.address = try net.local_address(host, listener)
    yes = in_use(host, at, true)
    try net.close_socket(host, listener)
    socket: io.file = try net.open_datagram(host, net.loopback(family, 0))
    taken: net.address = try net.local_address(host, socket)
    yes = yes and in_use(host, taken, false)
    try net.close_socket(host, socket)
end refusals

public main: () -> (code: i32) =
    host := system.new()
    code = 1
    families: [2]net.address_family = [net.ipv4, net.ipv6]
    for family in families do
        yes: bool = refusals(host, family) else (problem)
            _ = problem
            return
        end
        return when not yes
        inc code
    end for
    code = 42
end main
