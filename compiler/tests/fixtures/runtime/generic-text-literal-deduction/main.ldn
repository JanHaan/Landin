mut calls: i32 = 0
keep: (item: type, value: item) -> (result: item from value) =
    inc calls
    result = value
end keep
expression: (item: type, value: item) -> (result: item from value) = value end expression
public main: () -> (code: i32) =
    first := keep("A\u{2603}")
    empty := keep("")
    second := expression("42")
    typed: utf16 = "\u{1f600}"
    third := keep(typed)
    if lenof first == 4 and lenof empty == 0 and lenof second == 2
      and lenof third == 2 and calls == 3 then
        code = 42
    else
        code = 1
    end if
end main
