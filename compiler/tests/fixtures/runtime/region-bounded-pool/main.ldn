import core/mem
import core/pool
import core/region

bounded_pool: () -> (ok: bool) =
    ok = false
    mut backing: [6]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr backing[0]))
    mut slots: [3]pool.slot = zeroed
    mut space: pool.space = zeroed
    parent := pool.over(space, base, usize(48), usize(16), usize(3),
                        usize(8), slots[0..<3])
        else (problem) _ = problem
        return
    end
    mut ledger: region.space(2) = zeroed
    mut child := region.over(ledger, parent)
    region.release(ledger, parent)
    child = region.over(ledger, parent)
    return when pool.allocations(parent) <> 0

    first: ptr mut u8 = mem.allocate(child, usize(1), usize(1)) else (problem)
        _ = problem
        return
    end
    second: ptr mut u8 = mem.allocate(child, usize(16), usize(8)) else (problem)
        _ = problem
        return
    end
    first.val = 11
    second.val = 22
    return when pool.live(parent) <> 2 or pool.allocations(parent) <> 2

    mut refused: bool = false
    _ = mem.allocate(child, usize(1), usize(1)) else (problem)
        refused = problem == mem.out_of_memory
        first
    end
    return when not refused or pool.live(parent) <> 2
      or pool.allocations(parent) <> 3 or pool.frees(parent) <> 1
      or first.val <> 11 or second.val <> 22

    region.release(ledger, parent)
    return when pool.live(parent) <> 0 or pool.frees(parent) <> 3
      or pool.rejected_frees(parent) <> 0

    child = region.over(ledger, parent)

    again: ptr mut u8 = mem.allocate(child, usize(1), usize(1)) else (problem)
        _ = problem
        return
    end
    again.val = 33
    region.release(ledger, parent)
    ok = pool.live(parent) == 0 and pool.allocations(parent) == 4
         and pool.frees(parent) == 4 and pool.rejected_frees(parent) == 0
end bounded_pool

public main: () -> (code: i32) =
    if bounded_pool() then code = 42 else code = 0 end if
end main
