class: runtime
summary: native hosted application reads a long final line and validates its real output file
program: main.ldn
root: ../../../../..
run_args: --level INFO --match keep --every 2 --out build/r480-hosted-output.txt ../tests/fixtures/runtime/r480-hosted-text/input.txt
run_expect: expected.txt
status: 42
constructs: 0470, 0770, 0790, 1200, 1360, 1370, 1380, 1390, 1650, 1660
targets: linux-x86-64
