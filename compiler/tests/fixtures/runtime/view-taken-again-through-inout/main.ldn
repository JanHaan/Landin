--  [0830]'s repair is to take the view again after mutating its source.
--  When the view is taken again through an `inout` call and assigned to the
--  same binding, the old view ends at that assignment: it is not still in
--  use while the call runs.
slots: type = struct
    values: [2]i32
end slots

slot_at: (inout source: slots, index: usize) -> (slot: ptr mut i32 from source)
         ! out_of_range =
    fail out_of_range when index > 1
    slot = addr source.values[index]
end slot_at

out_of_range: atom

public main: () -> (code: i32) =
    code = 1
    mut table: slots = (values: [0, 0])
    mut slot := slot_at(table, usize(0)) else (problem)
        _ = problem
        return
    end
    slot.val = 40
    slot = slot_at(table, usize(1)) else (problem)
        _ = problem
        return
    end
    slot.val = 2
    code = table.values[0] + table.values[1]
end main
