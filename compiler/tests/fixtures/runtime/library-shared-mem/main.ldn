import core/mem

exercise: () -> (ok: bool) ! mem.out_of_memory =
    ok = false
    mut backing: [32]u8 = zeroed
    mut space: mem.arena_space = zeroed
    arena := mem.arena_over_unchecked(space, addr backing[0], 32)
    address := try mem.allocate(arena, usize(4), usize(1))
    address.val = 42
    return when address.val <> 42
    _ = mem.allocate(arena, usize(64), usize(1)) else (problem)
        _ = problem
        ok = mem.arena_used(arena) == 4
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
