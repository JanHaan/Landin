--  An I/O provider is a handle passed by value, so lending one argument
--  from it locks nothing: two lent arguments and the count are live at
--  once, and every one is read after the others were taken.
import core/io
import core/io/fake
import core/text

public main: () -> (code: i32) =
    code = 1
    arguments: [2][]u8 = ["alpha", "42"]
    files: []mut io.memory_file = []
    mut output: [1]u8 = zeroed
    mut errors: [1]u8 = zeroed
    mut state: io.memory_space = zeroed
    memory := io.memory_over(state, files, arguments[0..<2], "",
                             output[0..<1], errors[0..<1])
    first := io.argument_at(memory, usize(0)) else (problem)
        _ = problem
        return
    end
    second := io.argument_at(memory, usize(1)) else (problem)
        _ = problem
        return
    end
    count := io.argument_count(memory)
    word: []u8 = text.host_bytes(first)
    return when count <> 2 or lenof word <> 5 or word[4] <> 97
    digits: []u8 = text.host_bytes(second)
    return when lenof digits <> 2
    code = i32(digits[0] - 48) * 10 + i32(digits[1] - 48)
end main
