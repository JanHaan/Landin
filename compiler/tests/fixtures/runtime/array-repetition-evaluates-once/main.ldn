mut calls: u32 = 0
mut state: [3]u32
module_bytes: [2]u8 = [of 0xA5]
module_halves: [2]u16 = [2 of 0xBEEF]
module_longs: [2]u32 = [of 0x89ABCDEF]
module_quads: [2]u64 = [of 0x123456789ABCDEF0]
module_through: [2]u64 = module_quads
module_zero: [2]u64 = [of 0]

next: (base: u32) -> (value: u32) =
    calls = calls + 1
    value = base + calls
end next

public main: () -> (code: i32) =
    bytes: [2]u8 = [2 of 0xA5]
    halves: [2]u16 = [2 of 0xBEEF]
    local := [4 of next(10)]
    quads: [2]u64 = [2 of 0x0123456789ABCDEF]
    state = [of next(20)]

    if calls == 2
        and bytes[0] == 0xA5 and bytes[1] == 0xA5
        and halves[0] == 0xBEEF and halves[1] == 0xBEEF
        and local[0] == 11 and local[3] == 11
        and quads[0] == 0x0123456789ABCDEF
        and quads[1] == 0x0123456789ABCDEF
        and state[0] == 22 and state[2] == 22
        and module_bytes[0] == 0xA5 and module_bytes[1] == 0xA5
        and module_halves[0] == 0xBEEF and module_halves[1] == 0xBEEF
        and module_longs[0] == 0x89ABCDEF and module_longs[1] == 0x89ABCDEF
        and module_quads[0] == 0x123456789ABCDEF0
        and module_through[1] == 0x123456789ABCDEF0
        and module_zero[0] == 0 and module_zero[1] == 0
    then
        code = 42
    else
        code = 1
    end if
end main
