mut calls: u32 = 0
mut state: [4]u32 = [10, 20, 30, 40]

next: (base: u32) -> (value: u32) =
    calls = calls + 1
    value = base + calls
end next

public main: () -> (code: i32) =
    mut row: [5]u32 = [10, 20, 30, 40, 50]
    row = [next(row[1]), next(row[0]), of next(row[1])]
    state = [next(state[1]), of next(state[0])]

    if calls == 5
        and row[0] == 21 and row[1] == 23
        and row[2] == 26 and row[3] == 26 and row[4] == 26
        and state[0] == 24
        and state[1] == 29 and state[2] == 29 and state[3] == 29
    then
        code = 42
    else
        code = 1
    end if
end main
