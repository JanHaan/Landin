box: type = struct
    value: i32
end box

mut global: box = (value: 1)

change: () -> (result: i32) =
    global.value = 2
    result = 0
end change

first: (value: box, dummy: i32) -> (result: i32) =
    result = value.value + dummy
end first

by_reference: (inout value: box, dummy: i32) -> (result: i32) =
    result = value.value + dummy
end by_reference

public main: () -> (code: i32) =
    code = 0
    seen: i32 = first(global, change())
    global.value = 1
    aliased: i32 = by_reference(global, change())
    if seen == 1 and aliased == 2 and global.value == 2 then
        code = 42
    end if
end main
