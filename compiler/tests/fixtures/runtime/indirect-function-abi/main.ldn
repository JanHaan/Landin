pair: type = struct
    left: i32
    right: i32
end pair

make_first: (value: i32) -> (result: pair) =
    result = (left: value, right: 22)
end make_first

make_second: (value: i32) -> (result: pair) =
    result = (left: value + 1, right: 21)
end make_second

sum_eight: (a: i32, b: i32, c: i32, d: i32,
            e: i32, f: i32, g: i32, h: i32) -> (result: i32) =
    result = a + b + c + d + e + f + g + h
end sum_eight

public main: () -> (code: i32) =
    mut maker := make_first
    maker = make_second
    mut made := maker(20)
    wide := sum_eight
    code = made.left + made.right
           + wide(1, 2, 3, 4, 5, 6, 7, 14)
end main
