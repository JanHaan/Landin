import core/io
import hosted/system
import platform/linux

--  Under --link=libc the C runtime starts the program, so
--  platform/linux's entry never runs, but the argument initializer hands
--  it the initial stack's tables that C's `main` was given: it reports the
--  same environment and the auxiliary vector after it, with the kernel's
--  page size, as a static program's entry finds them.  hosted/system still
--  reaches the kernel through platform/linux's system calls and the
--  arguments still reach its world.
--  Whether the auxiliary vector gives the page size, a power of two of at
--  least 4 KiB, and page_size is it.
page_known: () -> (yes: bool) =
    (found, value) := linux.auxiliary(6)
    yes = found and value >= 4096 and (value & (value - 1)) == 0
          and u64(linux.page_size()) == value
end page_known

public main: () -> (code: i32) =
    code = 1
    state: system.host = system.new()
    return when io.argument_count(state) <> 1
    code = 2
    table: linux.environment_table = linux.environment()
    match table
        linux.no_environment: return
        ptr (entries): _ = entries
    end match
    code = 3
    return when not page_known()
    code = 4
    out: io.file = io.out(state)
    io.write(state, out, "libc entry\n") else (problem)
        _ = problem
        return
    end
    code = 42
end main
