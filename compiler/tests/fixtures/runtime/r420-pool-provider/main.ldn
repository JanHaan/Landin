import core/mem
import core/pool

zero_slots_exhaust: () -> (ok: bool) =
    mut words: [2]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]) + 1)
    extent: usize = 0
    size: usize = 8
    count: usize = 0
    alignment: usize = 8
    mut records: [1]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut state := pool.over(base, extent, size, count, alignment, bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end

    one: usize = 1
    mut refused: bool = false
    _ = mem.allocate(state, one, one) else (problem)
        _ = problem
        refused = true
    end
    ok = refused and pool.capacity(state) == 0
         and pool.bookkeeping_capacity(state) == lenof bookkeeping
         and pool.allocation_count(state) == 0 and pool.live(state) == 0
end zero_slots_exhaust

one_slot_reuses: () -> (ok: bool) =
    mut words: [12]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]) + 1)
    extent: usize = 95
    size: usize = 64
    count: usize = 1
    alignment: usize = 24
    mut records: [1]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut state := pool.over(base, extent, size, count, alignment, bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end

    first_size: usize = 17
    first: ptr mut u8 = mem.allocate(state, first_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    first.val = 11
    mut exhausted: bool = false
    one: usize = 1
    _ = mem.allocate(state, one, one) else (problem)
        _ = problem
        exhausted = true
    end
    mem.free(state, first, first_size)
    second_size: usize = 31
    second: ptr mut u8 = mem.allocate(state, second_size, alignment)
        else (problem)
        _ = problem
        ok = false
        return
    end
    second_last: ptr mut u8 = ptr(usize(second) + second_size - 1)
    second.val = 13
    second_last.val = 17
    ok = exhausted and usize(first) == usize(second)
         and usize(second) % alignment == 0
         and second.val == 13 and second_last.val == 17
         and pool.allocation_count(state) == 2
         and pool.free_count(state) == 1 and pool.live(state) == 1
    mem.free(state, second, second_size)
    ok = ok and pool.free_count(state) == 2 and pool.live(state) == 0

    --  The non-power-of-two slot alignment admits both kinds of divisors.
    eight: usize = 8
    three: usize = 3
    sixteen: usize = 16
    five: usize = 5
    by_eight: ptr mut u8 = mem.allocate(state, one, eight) else (problem)
        _ = problem
        ok = false
        return
    end
    ok = ok and usize(by_eight) % eight == 0
    mem.free(state, by_eight, one)
    by_three: ptr mut u8 = mem.allocate(state, one, three) else (problem)
        _ = problem
        ok = false
        return
    end
    ok = ok and usize(by_three) % three == 0
    mem.free(state, by_three, one)
    zero: usize = 0
    by_zero: ptr mut u8 = mem.allocate(state, one, zero) else (problem)
        _ = problem
        ok = false
        return
    end
    mem.free(state, by_zero, one)
    mut sixteen_refused: bool = false
    _ = mem.allocate(state, one, sixteen) else (problem)
        _ = problem
        sixteen_refused = true
    end
    mut five_refused: bool = false
    _ = mem.allocate(state, one, five) else (problem)
        _ = problem
        five_refused = true
    end
    ok = ok and sixteen_refused and five_refused
         and pool.allocation_count(state) == 5
         and pool.free_count(state) == 5 and pool.live(state) == 0
end one_slot_reuses

multiple_live_and_bounds: () -> (ok: bool) =
    mut words: [80]u64 = zeroed
    aligned: ptr mut u8 = ptr(usize(addr words[0]))
    base: ptr mut u8 = ptr(usize(aligned) + 1)
    extent: usize = 639
    slot_size: usize = 128
    count: usize = 3
    alignment: usize = 8
    mut records: [3]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut state := pool.over
        (base, extent, slot_size, count, alignment, bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end

    first_size: usize = 16
    second_size: usize = 128
    third_size: usize = 1
    first: ptr mut u8 = mem.allocate(state, first_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    second: ptr mut u8 = mem.allocate(state, second_size, alignment)
        else (problem)
        _ = problem
        ok = false
        return
    end
    third: ptr mut u8 = mem.allocate(state, third_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    second_last: ptr mut u8 = ptr(usize(second) + second_size - 1)
    first.val = 19
    second.val = 29
    second_last.val = 31

    mut exhausted: bool = false
    _ = mem.allocate(state, third_size, alignment) else (problem)
        _ = problem
        exhausted = true
    end
    mem.free(state, first, first_size)
    replacement_size: usize = 64
    replacement: ptr mut u8 = mem.allocate
        (state, replacement_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end

    wrong_size: usize = 63
    mem.free(state, replacement, wrong_size)
    mut wrong_free_kept_live: bool = false
    _ = mem.allocate(state, third_size, alignment) else (problem)
        _ = problem
        wrong_free_kept_live = true
    end

    too_large_size: usize = 129
    mut too_large: bool = false
    _ = mem.allocate(state, too_large_size, alignment) else (problem)
        _ = problem
        too_large = true
    end
    unsupported_alignment: usize = 3
    mut unsupported: bool = false
    _ = mem.allocate(state, third_size, unsupported_alignment) else (problem)
        _ = problem
        unsupported = true
    end

    ok = usize(aligned) % alignment == 0 and usize(base) % alignment == 1
         and exhausted and usize(replacement) == usize(first)
         and second.val == 29 and second_last.val == 31
         and wrong_free_kept_live and too_large and unsupported
         and pool.allocation_count(state) == 4
         and pool.free_count(state) == 1 and pool.live(state) == 3
         and pool.rejected_free_count(state) == 1

    mem.free(state, replacement, replacement_size)
    mem.free(state, second, second_size)
    mem.free(state, third, third_size)
    ok = ok and pool.free_count(state) == 4 and pool.live(state) == 0
end multiple_live_and_bounds

six_live_slots: () -> (ok: bool) =
    --  Map rehash may keep three old extents live while acquiring three
    --  replacements.  The capacity is the caller's metadata length rather
    --  than an implementation ceiling.
    mut words: [32]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]) + 1)
    extent: usize = 255
    slot_size: usize = 32
    count: usize = 6
    alignment: usize = 8
    mut records: [6]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut state := pool.over
        (base, extent, slot_size, count, alignment, bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end

    first: ptr mut u8 = mem.allocate
        (state, slot_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    second: ptr mut u8 = mem.allocate
        (state, slot_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    third: ptr mut u8 = mem.allocate
        (state, slot_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    fourth: ptr mut u8 = mem.allocate
        (state, slot_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    fifth: ptr mut u8 = mem.allocate
        (state, slot_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    sixth: ptr mut u8 = mem.allocate
        (state, slot_size, alignment) else (problem)
        _ = problem
        ok = false
        return
    end
    mut exhausted: bool = false
    _ = mem.allocate(state, slot_size, alignment) else (problem)
        _ = problem
        exhausted = true
    end

    ok = exhausted and pool.capacity(state) == lenof records
         and pool.bookkeeping_capacity(state) == lenof records
         and pool.live(state) == 6
         and usize(second) - usize(first) == slot_size
         and usize(sixth) - usize(fifth) == slot_size
    mem.free(state, first, slot_size)
    mem.free(state, second, slot_size)
    mem.free(state, third, slot_size)
    mem.free(state, fourth, slot_size)
    mem.free(state, fifth, slot_size)
    mem.free(state, sixth, slot_size)
    ok = ok and pool.live(state) == 0 and pool.free_count(state) == 6
end six_live_slots

out_of_order_reuse: () -> (ok: bool) =
    mut words: [16]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]))
    extent: usize = 128
    slot_size: usize = 16
    count: usize = 8
    alignment: usize = 8
    mut records: [8]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut state := pool.over
        (base, extent, slot_size, count, alignment, bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end

    mut addresses: [8]usize = zeroed
    mut index: usize = 0
    while index < count do
        block: ptr mut u8 = mem.allocate(state, slot_size, alignment)
            else (problem)
            _ = problem
            ok = false
            return
        end
        addresses[index] = usize(block)
        inc index
    end while

    --  None of these invalid frees may enter the free-index heap.
    before: ptr mut u8 = ptr(addresses[0] - 1)
    between: ptr mut u8 = ptr(addresses[4] + 1)
    after: ptr mut u8 = ptr(addresses[7] + slot_size)
    fourth: ptr mut u8 = ptr(addresses[4])
    mem.free(state, before, slot_size)
    mem.free(state, between, slot_size)
    mem.free(state, after, slot_size)
    mem.free(state, fourth, slot_size - 1)

    release_order: [8]usize = [7, 1, 5, 3, 6, 0, 4, 2]
    index = 0
    while index < count do
        to_release: ptr mut u8 = ptr(addresses[release_order[index]])
        mem.free(state, to_release, slot_size)
        inc index
    end while
    duplicate: ptr mut u8 = ptr(addresses[2])
    mem.free(state, duplicate, slot_size)

    ok = pool.live(state) == 0 and pool.free_count(state) == count
         and pool.rejected_free_count(state) == 5
    index = 0
    while index < count do
        block: ptr mut u8 = mem.allocate(state, slot_size, alignment)
            else (problem)
            _ = problem
            ok = false
            return
        end
        ok = ok and usize(block) == addresses[index]
        inc index
    end while
    ok = ok and pool.live(state) == count
         and pool.allocation_count(state) == count * 2
    second: ptr mut u8 = ptr(addresses[2])
    sixth: ptr mut u8 = ptr(addresses[6])
    mem.free(state, sixth, slot_size)
    mem.free(state, second, slot_size)
    reused_second: ptr mut u8 = mem.allocate(state, slot_size, alignment)
        else (problem)
        _ = problem
        ok = false
        return
    end
    reused_sixth: ptr mut u8 = mem.allocate(state, slot_size, alignment)
        else (problem)
        _ = problem
        ok = false
        return
    end
    ok = ok and usize(reused_second) == addresses[2]
         and usize(reused_sixth) == addresses[6]
         and pool.live(state) == count
end out_of_order_reuse

--  Check construction without exposing the private provider representation.
--  The caller tests only refusal; no provider value survives this helper.
check_configuration: (base: ptr mut u8, extent: usize, size: usize,
                      count: usize, alignment: usize,
                      bookkeeping: []mut pool.slot)
                     -> none ! mem.out_of_memory =
    _ = try pool.over(base, extent, size, count, alignment, bookkeeping)
end check_configuration

bad_configuration_is_refused: () -> (ok: bool) =
    mut words: [20]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]) + 1)
    extent: usize = 128
    size: usize = 128
    one: usize = 1
    two: usize = 2
    alignment: usize = 8
    mut records: [1]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]

    mut capacity_refused: bool = false
    check_configuration(base, 159, 64, two, alignment, bookkeeping)
        else (problem)
        _ = problem
        capacity_refused = true
    end

    mut extent_refused: bool = false
    check_configuration(base, extent, size, one, alignment, bookkeeping)
        else (problem)
        _ = problem
        extent_refused = true
    end
    ok = capacity_refused and extent_refused
end bad_configuration_is_refused

public main: () -> (code: i32) =
    if zero_slots_exhaust() and one_slot_reuses()
      and multiple_live_and_bounds() and six_live_slots()
      and out_of_order_reuse()
      and bad_configuration_is_refused()
    then
        code = 42
    else
        code = 0
    end if
end main
