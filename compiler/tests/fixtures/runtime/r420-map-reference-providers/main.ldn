import core/fault
import hosted/heap
import core/cmp
import core/map
import core/mem
import core/pool

node: type = struct
    payload: i32
end node
node_ptr: type = ptr node
key_equal: (left: node_ptr, right: node_ptr) -> (same: bool) =
    same = usize(left) == usize(right)
end key_equal
colliding_hash: (value: node_ptr) -> (result: u64) =
    _ = usize(value)
    result = 6
end colliding_hash
node_ptr is cmp.equatable (equal: key_equal)
node_ptr is cmp.hashable (hash: colliding_hash)
n1: node = (payload: 11)
n2: node = (payload: 22)
n3: node = (payload: 33)
n4: node = (payload: 44)
n5: node = (payload: 55)
n6: node = (payload: 66)
n7: node = (payload: 77)
has: (value: map.map(node_ptr, ptr node), key: node_ptr, wanted: i32)
     -> (ok: bool) =
    found: ptr node = map.get(value, key) else (problem)
        _ = problem
        ok = false
        return
    end
    ok = found.val.payload == wanted
end has

failure_case: (provider: type is mem.allocator, memory: provider,
               allowed: usize) -> (ok: bool) =
    rollback_frees: usize = allowed
    three: usize = 3
    mut space: fault.space = zeroed
    budget := fault.over
        (inner_provider: provider, state: space, inner: memory,
         allowed_attempts: three)
    mut value := map.new(key: node_ptr, item: ptr node)
    k1: node_ptr = addr n1
    k2: node_ptr = addr n2
    k3: node_ptr = addr n3
    k4: node_ptr = addr n4
    k5: node_ptr = addr n5
    k6: node_ptr = addr n6
    k7: node_ptr = addr n7
    map.insert(value, budget, k1, addr n1) else (ignored) _ = ignored end
    map.insert(value, budget, k2, addr n2) else (ignored) _ = ignored end
    map.insert(value, budget, k3, addr n3) else (ignored) _ = ignored end
    map.insert(value, budget, k4, addr n4) else (ignored) _ = ignored end
    map.insert(value, budget, k5, addr n5) else (ignored) _ = ignored end
    map.insert(value, budget, k6, addr n6) else (ignored) _ = ignored end

    mut initial: bool = map.length(value) == 6
                        and fault.attempts(budget) == 3
                        and fault.successes(budget) == 3
                        and fault.frees(budget) == 0
                        and fault.live(budget) == 3

    --  Six occupied records are already at the 8-slot pressure threshold.
    --  Removing the first colliding key leaves a preceding tombstone, which
    --  permits reuse. With no allocation budget, replacing the last key
    --  must still search, update, and return without consulting the provider.
    map.remove(value, k1) else (ignored) _ = ignored end
    zero: usize = 0
    fault.permit(budget, zero)
    map.insert(value, budget, k6, addr n7) else (problem)
        _ = problem
        initial = false
    end
    mut first_missing: bool = false
    _ = map.get(value, k1) else (problem)
        _ = problem
        first_missing = true
    end
    updated_without_allocation: bool = map.length(value) == 5
                                       and has(value, k6, 77)
                                       and first_missing
                                       and fault.attempts(budget) == 3
                                       and fault.injected_failures(budget) == 0
                                       and fault.frees(budget) == 0
                                       and fault.live(budget) == 3

    --  Reuse that tombstone without allocation, restoring growth pressure.
    map.insert(value, budget, k1, addr n1) else (problem)
        _ = problem
        initial = false
    end
    reused: bool = map.length(value) == 6 and value.tombstones == 0
                   and fault.attempts(budget) == 3 and has(value, k1, 11)

    fault.permit(budget, allowed)
    mut failed: bool = false
    map.insert(value, budget, k7, addr n7) else (problem)
        _ = problem
        failed = true
    end

    --  No old allocation was released, every acquired replacement was, and
    --  all old logical contents remain observable after each failure stage.
    mut preserved: bool = failed and map.length(value) == 6
                          and has(value, k2, 22) and has(value, k3, 33)
                          and has(value, k6, 77)
                          and fault.frees(budget) == rollback_frees
                          and fault.live(budget) == 3
    mut seventh_missing: bool = false
    _ = map.get(value, k7) else (problem)
        _ = problem
        seventh_missing = true
    end
    preserved = preserved and seventh_missing

    --  The rollback releases every temporary extent. A three-call
    --  retry can therefore coexist with all three unchanged old allocations.
    fault.permit(budget, three)
    map.insert(value, budget, k7, addr n7) else (problem)
        _ = problem
        preserved = false
    end
    retried: bool = map.length(value) == 7 and has(value, k2, 22)
                   and has(value, k4, 44) and has(value, k7, 77)
                   and fault.frees(budget) == rollback_frees + 3
                   and fault.live(budget) == 3

    expected_allocations: usize = 6 + allowed
    expected_attempts: usize = 7 + allowed
    counts: bool = fault.attempts(budget) == expected_attempts
                   and fault.delegated(budget) == expected_allocations
                   and fault.successes(budget) == expected_allocations
                   and fault.injected_failures(budget) == 1
                   and fault.inner_failures(budget) == 0

    map.release(value, budget)
    released: bool = map.length(value) == 0
                     and fault.frees(budget) == rollback_frees + 6
                     and fault.live(budget) == 0
    ok = initial and updated_without_allocation and reused and preserved
         and retried and counts and released
end failure_case

series: (provider: type is mem.allocator, memory: provider)
        -> (okay: bool) =
    zero: usize = 0
    one: usize = 1
    two: usize = 2
    okay = failure_case(memory, zero) and failure_case(memory, one)
           and failure_case(memory, two)
end series

public main: () -> (code: i32) =
    code = 1
    heap := heap.host()
    heap_ok: bool = series(heap)
    mut arena_bytes: [16384]u8 = zeroed
    mut arena_space: mem.arena_space = zeroed
    arena := mem.arena_over_unchecked(arena_space, addr arena_bytes[0], 16384)
    arena_ok: bool = series(arena)
    mut pool_bytes: [4096]u8 = zeroed
    mut records: [6]pool.slot = zeroed
    mut pool_space: pool.space = zeroed
    slab := pool.over(pool_space, addr pool_bytes[0], 4096, 512, 6, 16,
                      records[0..<6]) else (problem)
        _ = problem
        return
    end
    fixed_ok: bool = series(slab)
    if heap_ok and arena_ok and fixed_ok and mem.arena_used(arena) > 0
      and pool.allocations(slab) == 21
      and pool.frees(slab) == 21
      and pool.live(slab) == 0 and pool.rejected_frees(slab) == 0
    then code = 42 end if
end main
