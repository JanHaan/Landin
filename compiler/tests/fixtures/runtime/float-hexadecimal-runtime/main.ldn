sample: type = struct
    value: f64
end sample

module_value: f64 = 0x1.921fb54442d18p+1
module_values: [2]f32 = [0x1.0p-149, 0x1.fffffep+127]
module_sample: sample = sample(value: 0x1.8p+1)

public main: () -> (code: i32) =
    defaulted := 0x1.0p0
    separated: f64 = 0x1_0.8_0p-3
    minimum_f32: f32 = 0x1.0p-149
    half_minimum_f32: f32 = 0x1.0p-150
    half_between_even_f32: f32 = 0x1.000001p0
    above_half_f32: f32 = 0x1.0000011p0
    next_f32: f32 = 0x1.000002p0
    odd_half_f32: f32 = 0x1.000003p0
    even_f32: f32 = 0x1.000004p0
    one_and_half_subnormal: f32 = 0x1.8p-149
    two_subnormals: f32 = 0x1.0p-148
    minimum_f64: f64 = 0x1.0p-1074
    huge_negative_exponent: f64 = 0x1.0p-99999999999999999999
    zero_huge_exponent: f32 = 0x0.0p+99999999999999999999

    if defaulted == 1.0
      and separated == 2.0625
      and module_value > 3.1415
      and module_value < 3.1416
      and module_values[0] == minimum_f32
      and module_values[1] > 0x1.0p+127
      and module_sample.value == 3.0
      and minimum_f32 > 0.0
      and half_minimum_f32 == 0.0
      and half_between_even_f32 == 1.0
      and above_half_f32 == next_f32
      and odd_half_f32 == even_f32
      and one_and_half_subnormal == two_subnormals
      and minimum_f64 > 0.0
      and huge_negative_exponent == 0.0
      and zero_huge_exponent == 0.0 then
        code = 42
    else
        code = 1
    end if
end main
