--  A path that names nothing is `not_found` to every directory operation,
--  with ENOENT, 2 on every hosted system, kept as the last errno: opening
--  it as a directory, making a directory under it, and removing it as a
--  file or as a directory.  An entry name that is not in an open directory
--  is `not_found` too, and so is a name no entry can have, which never
--  reaches the system and leaves the last errno at zero.
import core/io
import core/text
import hosted/blocking

missing: []u8 = "/landin-absent-parent/absent"
missing_parent: []u8 = "/landin-absent-parent/absent/new"

--  Every way a directory operation can fail.
refusal: type = io.not_found | io.no_access | io.io_failed | io.already_exists

--  Whether the outcome was `not_found` with errno NUMBER.
absent: (host: blocking.host, problem: refusal, number: i32) -> (yes: bool) =
    yes = problem == io.not_found and blocking.last_errno(host) == number
end absent

opened_absent: (host: blocking.host) -> (yes: bool) =
    yes = false
    path: text.host_string = text.host_over(missing)
    mut buffer: [1024]u8 = zeroed
    listing := io.open_directory(host, path, buffer[0..<1024]) else (problem)
        yes = absent(host, problem, 2)
        return
    end
    io.close_directory(host, listing) else none
end opened_absent

made_absent: (host: blocking.host) -> (yes: bool) =
    yes = false
    path: text.host_string = text.host_over(missing_parent)
    io.make_directory(host, path) else (problem)
        yes = absent(host, problem, 2)
    end
end made_absent

removed_absent: (host: blocking.host, directory: bool) -> (yes: bool) =
    yes = false
    path: text.host_string = text.host_over(missing)
    gone(host, path, directory) else (problem)
        yes = absent(host, problem, 2)
    end
end removed_absent

gone: (host: blocking.host, path: text.host_string, directory: bool)
      -> none ! io.not_found | io.no_access | io.io_failed =
    if directory then
        try io.remove_directory(host, path)
    else
        try io.remove_file(host, path)
    end if
end gone

--  In the directory the program runs in, which is there: a name that is
--  not, and names no entry can have.
sized_absent: (host: blocking.host) -> (code: i32) =
    code = 10
    here: []u8 = "."
    path: text.host_string = text.host_over(here)
    mut buffer: [1024]u8 = zeroed
    listing := io.open_directory(host, path, buffer[0..<1024]) else (problem)
        _ = problem
        return
    end
    defer io.close_directory(host, listing) else none
    code = 11
    _ = io.entry_size(host, listing,
                      text.host_over("landin-absent-entry")) else (problem)
        return when not absent(host, problem, 2)
        0
    end
    code = 12
    _ = io.entry_size(host, listing, text.host_over("")) else (problem)
        return when not absent(host, problem, 0)
        0
    end
    code = 13
    _ = io.entry_size(host, listing, text.host_over("a/b")) else (problem)
        return when not absent(host, problem, 0)
        0
    end
    code = 0
end sized_absent

public main: () -> (code: i32) =
    host := blocking.new()
    code = 1
    return when not opened_absent(host)
    code = 2
    return when not made_absent(host)
    code = 3
    return when not removed_absent(host, false)
    code = 4
    return when not removed_absent(host, true)
    code = sized_absent(host)
    return when code <> 0
    code = 42
end main
