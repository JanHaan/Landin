holder: type = struct
    row: [3]i32
end holder

make: () -> (result: [3]i32) =
    result = [19, 20, 3]
end make

forward: () -> (result: [3]i32) = make() end forward

public main: () -> (code: i32) =
    mut answer: [3]i32 = forward()
    mut other: [3]i32 = make()
    other[0] = 40
    mut storage: holder = zeroed
    storage.row = make()
    code = answer[0] + answer[1] + answer[2]
           + storage.row[0] + storage.row[1] + storage.row[2]
end main
