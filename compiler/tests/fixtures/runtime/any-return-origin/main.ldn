display: type = concept (t: type)
    code: (self: ptr t) -> (value: i32)
end display

thing: type = struct
    value: i32
end thing

thing_code: (self: ptr thing) -> (value: i32) =
    value = self.val.value
end thing_code

thing is display (code: thing_code)

erase: (source: ptr thing) -> (result: any display from source) =
    result = any(source)
end erase

public main: () -> (code: i32) =
    item: thing = (value: 42)
    erased: any display = erase(addr item)
    code = erased.code()
end main
