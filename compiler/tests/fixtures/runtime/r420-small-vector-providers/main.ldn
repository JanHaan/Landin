import core/arena
import core/fault
import core/pool
import core/spill
import hosted/heap

pool_provider: type = pool.provider

heap_path: () -> (ok: bool) =
    host := heap.new()
    mut values := spill.new(item: i32, inline_slots: 0)
    spill.push(values, host, 1) else none
    spill.push(values, host, 2) else none
    spill.push(values, host, 3) else none
    spill.push(values, host, 4) else none
    spill.push(values, host, 5) else none
    spill.push(values, host, 6) else none
    spill.push(values, host, 7) else none
    spill.push(values, host, 8) else none
    spill.push(values, host, 9) else none
    begin
        view := spill.used(values)
        view[0] = 11
        view[8] = 19
    end
    last: i32 = spill.pop(values) else 0
    begin
        view := spill.used(values)
        ok = last == 19 and spill.length(addr values) == 8
             and spill.capacity(addr values) == 16
             and view[0] == 11 and view[7] == 8
    end
    spill.release(values, host)
    spill.release(values, host)
    ok = ok and spill.length(addr values) == 0 and spill.capacity(addr values) == 0
end heap_path

arena_path: () -> (ok: bool) =
    mut words: [32]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]))
    mut space: arena.space = zeroed
    memory := arena.over_unchecked
        (space, base, lenof words * sizeof u64)
    mut values := spill.new(item: i32, inline_slots: 2)
    spill.push(values, memory, 21) else none
    spill.push(values, memory, 22) else none
    mut inline_free: bool = arena.used(memory) == 0
    spill.push(values, memory, 23) else none
    spill_extent: usize = arena.used(memory)
    mut spill_address: usize = 0
    begin
        view := spill.used(values)
        spill_address = usize(addr view[0])
    end
    spill.push(values, memory, 24) else none
    spill.push(values, memory, 25) else none
    begin
        view := spill.used(values)
        ok = inline_free and spill.length(addr values) == 5
             and spill.capacity(addr values) == 8
             and view[0] == 21 and view[2] == 23 and view[4] == 25
             --  The first spill acquires four slots; its top arena block
             --  grows to eight in place, without retaining another block.
             and spill_extent == 4 * sizeof i32
             and usize(addr view[0]) == spill_address
             and arena.used(memory) == 8 * sizeof i32
    end
    spill.release(values, memory)
    ok = ok and spill.length(addr values) == 0
         and spill.capacity(addr values) == 2
         and arena.used(memory) == 8 * sizeof i32
end arena_path

fixed_path: () -> (ok: bool) =
    mut words: [20]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]))
    mut records: [2]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut space: pool.space = zeroed
    slab := pool.over
        (space, base, lenof words * sizeof u64,
         64, 2, 8, bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end
    mut values := spill.new(item: i32, inline_slots: 1)
    spill.push(values, slab, 31) else none
    spill.push(values, slab, 32) else none
    spill.push(values, slab, 33) else none
    begin
        view := spill.used(values)
        view[1] = 42
        ok = spill.length(addr values) == 3 and spill.capacity(addr values) == 4
             and view[0] == 31 and view[1] == 42 and view[2] == 33
    end
    spill.release(values, slab)
    --  The growth to four items stayed in the first block's slot.
    ok = ok and pool.allocations(slab) == 1
         and pool.frees(slab) == 1 and pool.live(slab) == 0
         and pool.rejected_frees(slab) == 0
end fixed_path

failing_path: () -> (ok: bool) =
    mut words: [20]u64 = zeroed
    base: ptr mut u8 = ptr(usize(addr words[0]))
    mut records: [2]pool.slot = zeroed
    bookkeeping: []mut pool.slot = records[0..<lenof records]
    mut inner_space: pool.space = zeroed
    inner := pool.over
        (inner_space, base, lenof words * sizeof u64,
         64, 2, 8, bookkeeping)
        else (problem)
        _ = problem
        ok = false
        return
    end
    zero: usize = 0
    one: usize = 1
    mut space: fault.space = zeroed
    counted := fault.over
        (inner_provider: pool_provider, state: space, inner: inner,
         allowed_attempts: zero)
    mut values := spill.new(item: i32, inline_slots: 1)
    spill.push(values, counted, 51) else none

    mut first_failed: bool = false
    spill.push(values, counted, 52) else (problem)
        _ = problem
        first_failed = true
    end
    begin
        view := spill.used(values)
        ok = first_failed and spill.length(addr values) == 1
             and spill.capacity(addr values) == 1 and view[0] == 51
             and fault.delegated(counted) == 0
             and pool.allocations(inner) == 0
    end

    fault.permit(counted, one)
    spill.push(values, counted, 52) else none
    mut growth_failed: bool = false
    spill.push(values, counted, 53) else (problem)
        _ = problem
        growth_failed = true
    end
    begin
        view := spill.used(values)
        ok = ok and growth_failed and spill.length(addr values) == 2
             and spill.capacity(addr values) == 2
             and view[0] == 51 and view[1] == 52
             and fault.successes(counted) == 1
             and fault.frees(counted) == 0
             and pool.live(inner) == 1
    end

    --  A growth asks to grow in place before it allocates (D356), and the
    --  pool grows the block in its slot: one permit, and no second block.
    fault.permit(counted, one)
    spill.push(values, counted, 53) else none
    begin
        view := spill.used(values)
        ok = ok and spill.length(addr values) == 3
             and spill.capacity(addr values) == 4 and view[2] == 53
    end
    spill.release(values, counted)
    ok = ok and fault.attempts(counted) == 5
         and fault.delegated(counted) == 2
         and fault.successes(counted) == 1
         and fault.injected_failures(counted) == 3
         and fault.inner_failures(counted) == 0
         and fault.growths(counted) == 1
         and fault.frees(counted) == 1 and fault.live(counted) == 0
         and pool.allocations(inner) == 1
         and pool.frees(inner) == 1 and pool.live(inner) == 0
         and pool.rejected_frees(inner) == 0
end failing_path

public main: () -> (code: i32) =
    if heap_path() and arena_path() and fixed_path() and failing_path() then
        code = 42
    else
        code = 1
    end if
end main
