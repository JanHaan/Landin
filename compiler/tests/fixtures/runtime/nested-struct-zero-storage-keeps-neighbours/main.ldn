inner: type = struct
    byte: u8
    word: usize
    row: [3]u16
end inner

outer: type = struct
    prefix: u16
    nested: inner
    tail: u8
end outer

mut state: outer = zeroed

public main: () -> (code: i32) =
    mut before: u8 = 17
    mut local: outer = zeroed
    mut after: u8 = 25

    state.prefix = 9
    state = zeroed
    local.tail = 11
    local = zeroed

    if state.prefix == 0 and local.tail == 0
        and before + after == 42
    then
        code = 42
    else
        code = 1
    end if
end main
