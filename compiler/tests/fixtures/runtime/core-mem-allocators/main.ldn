import core/mem

no_allocation: atom
allocation: type = no_allocation | ptr mut u8
is_absent: (value: allocation) -> (empty: bool) =
    match value
        no_allocation: empty = true
        ptr: empty = false
    end match
end is_absent

public main: () -> (code: i32) =
    code = 1
    mut bytes: [64]u8 = zeroed
    base: ptr mut u8 = addr bytes[0]
    extent: usize = 64
    mut bump := mem.arena_over(base, extent)

    three: usize = 3
    one: usize = 1
    eight: usize = 8
    first: ptr mut u8 = mem.allocate(bump, three, one) else (problem)
        _ = problem
        return
    end
    second: ptr mut u8 = mem.allocate(bump, eight, eight) else (problem)
        _ = problem
        return
    end
    too_large: usize = 64
    refused: allocation = mem.allocate(bump, too_large, one) else no_allocation

    mut limited_bytes: [32]u8 = zeroed
    limited_base: ptr mut u8 = addr limited_bytes[0]
    limited_extent: usize = 32
    allowance: usize = 1
    mut limited := mem.fail_over(limited_base, limited_extent, allowance)
    accepted: ptr mut u8 = mem.allocate(limited, eight, eight) else (problem)
        _ = problem
        return
    end
    budget_refused: allocation =
        mem.allocate(limited, eight, eight) else no_allocation
    mem.free(limited, accepted, eight)

    if usize(first) == usize(base)
      and usize(second) % eight == 0
      and bump.used == usize(second) - usize(base) + eight
      and is_absent(refused)
      and usize(accepted) % eight == 0
      and limited.used == usize(accepted) - usize(limited_base) + eight
      and is_absent(budget_refused)
      and limited.allocations == 1 and limited.remaining == 0
      and limited.frees == 1
    then
        code = 42
    else
        code = 1
    end if
end main
