--  `refine-svd`, a split command (D1383): its own executable, linked from
--  the same library as `refine` without the front end, and published
--  where the dispatcher looks for it, libexec/landin (D1384).

with "landin_common.gpr";
with "landin_lib.gpr";

project Refine_Svd is

   for Languages use ("Ada");
   for Source_Dirs use ("src/main");
   for Main use ("refine_svd.adb");
   for Object_Dir use Landin_Common.Build_Dir & "/refine-svd-obj";
   for Exec_Dir use Landin_Common.Exec_Dir;

   package Builder is
      for Executable ("refine_svd.adb") use "refine-svd";
      for Default_Switches ("Ada") use
        Landin_Common.Builder'Default_Switches ("Ada");
   end Builder;

   package Compiler renames Landin_Common.Compiler;
   package Binder   renames Landin_Common.Binder;
   package Linker   renames Landin_Common.Linker;

end Refine_Svd;
