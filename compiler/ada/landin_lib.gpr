--  The bootstrap compiler library.  Everything that is not a program entry
--  point lives here so both `refine` and the test harness link the same code.

with "landin_common.gpr";

library project Landin_Lib is

   for Languages use ("Ada");
   for Source_Dirs use
     ("src/base", "src/source", "src/diagnostics", "src/platform",
      "src/stages", "src/syntax", "src/resolution", "src/checking",
      "src/backend",
      "src/driver");
   for Object_Dir use Landin_Common.Build_Dir & "/lib-obj";
   for Library_Dir use Landin_Common.Build_Dir & "/lib";
   for Library_Name use "landin";
   for Library_Kind use "static";

   package Compiler renames Landin_Common.Compiler;
   package Builder  renames Landin_Common.Builder;

end Landin_Lib;
