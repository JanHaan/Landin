               & "        row = [of seed] -- the length comes from row"
               & LF
               & "        row = [seed, seed + 1, of 0] -- the prefix first"
               & ", then the fill"
               & LF
               & "        copies := [4 of seed] -- [4]u32"
               & LF
               & "        row = copies"
               & LF
               & "    end refill"
               & LF
               & LF
               & "Fine print:"
               & LF
               & LF
               & "- The mixed form needs an explicitly typed local or modu"
