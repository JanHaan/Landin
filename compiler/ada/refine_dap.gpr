--  `refine-dap`, the split command `refine dap` runs (D1383, D1483): the
--  Debug Adapter Protocol server, linked from the same library as `refine`
--  and without its front end.

with "landin_common.gpr";
with "landin_lib.gpr";

project Refine_Dap is

   for Languages use ("Ada");
   for Source_Dirs use ("src/main");
   for Main use ("refine_dap.adb");
   for Object_Dir use Landin_Common.Build_Dir & "/refine-dap-obj";
   for Exec_Dir use Landin_Common.Exec_Dir;

   package Builder is
      for Executable ("refine_dap.adb") use "refine-dap";
      for Default_Switches ("Ada") use
        Landin_Common.Builder'Default_Switches ("Ada");
   end Builder;

   package Compiler renames Landin_Common.Compiler;
   package Binder   renames Landin_Common.Binder;
   package Linker   renames Landin_Common.Linker;

end Refine_Dap;
