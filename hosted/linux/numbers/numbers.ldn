--  Linux's system-call numbers on x86-64, arm64 and RV64, generated by
--  scripts/linux_syscalls.py from Linux 7.2:
--  https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.tar.xz
--  SHA-256 f9fef3d14c0df53819026f4be74459835c2a0b0dcbf5b5bbd9ea19f0829402b3.
--  Do not edit it: change the pin in the generator and run it again.
--
--  Each number is named after its call, the kernel table's name
--  followed by `_number`, and goes to hosted/linux's `system_call`.
--  A number whose call the running kernel lacks gives minus ENOSYS.
--  x86-64 reads arch/x86/entry/syscalls/syscall_64.tbl
--  with the ABIs common, 64.
--  arm64 reads arch/arm64/tools/syscall_64.tbl
--  with the ABIs common, 64, renameat, rlimit, memfd_secret.
--  RV64 reads scripts/syscall.tbl
--  with the ABIs common, 64, riscv, rlimit, memfd_secret.

fixed if compiler.os == linux then
    fixed if compiler.arch == x86_64 then
        --- `read`'s system-call number on x86-64.
        public read_number: i64 = 0
