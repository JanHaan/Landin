--  The hosted heap is separate from core/mem's freestanding allocator
--  protocol and caller-backed providers.  These fixed scalar/pointer
--  routines are supplied by the selected hosted runtime [1975].

import core/mem

no_allocation: atom
allocation: type = no_allocation | ptr mut u8

extern(c) _landin_host_heap_allocate:
    (size: usize, alignment: usize) -> (block: allocation)
extern(c) _landin_host_heap_release: (block: ptr mut u8) -> none

--- Host-heap allocator capability. Allocates and frees through runtime
--- helpers; does not grow allocations in place. Available only on hosted
--- targets.
---
--- Every usize alignment is accepted.  Zero and one mean no stricter than
--- byte alignment.  A zero-byte request still returns a distinct, non-null,
--- freeable token on success.  The host shim reserves one pointer word plus
--- at most alignment - 1 bytes and refuses an overflow or an extent above
--- the host's PTRDIFF_MAX before calling libc.  Any other libc failure is
--- reported through mem.out_of_memory.
public system: type = struct
    reserved: u8
end system

system_alloc: (inout state: system, size: usize, alignment: usize)
              -> (block: ptr mut u8) ! mem.out_of_memory =
    _ = state.reserved
    allocated: allocation = _landin_host_heap_allocate(size, alignment)
    match allocated
        no_allocation: fail mem.out_of_memory
        ptr (address): block = address
    end match
end system_alloc

system_free: (inout state: system, block: ptr mut u8, size: usize) -> none =
    _ = state.reserved
    _ = size
    _landin_host_heap_release(block)
end system_free

system_grow: (inout state: system, block: ptr mut u8,
              old_size: usize, new_size: usize, alignment: usize)
             -> (grown: bool) =
    _ = state.reserved
    _ = block
    _ = old_size
    _ = new_size
    _ = alignment
    grown = false
end system_grow

system is mem.allocator (alloc: system_alloc, grow: system_grow,
                         free: system_free)

--- Create the host heap provider state. The state itself does not allocate;
--- callers retain and free each successful allocation explicitly.
public host: () -> (state: system) =
    state = (reserved: 0)
end host
