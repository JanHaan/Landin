--  The hosted heap is separate from core/mem's freestanding allocator
--  protocol and caller-backed providers.  It keeps size classes over
--  memory it maps itself through platform/posix, written once for every
--  hosted system.  It over-allocates so that every usize alignment is
--  honoured, not only the powers of two posix_memalign and aligned_alloc
--  admit.  Its classes are behind one lock once the program has started a
--  thread (D502).

import core/mem
import hosted/thread/lock
import platform/posix

--  The state carries no information; it is opaque so that only `host` makes
--  one.
system_value: type = struct
    reserved: u8
end system_value

--- Host-heap allocator capability, as a handle that borrows nothing: the heap
--- belongs to the process, and copies share it.  Allocates and frees through
--- size classes over memory it maps through platform/posix.  A block grows
--- in place when its slot or mapping holds the new extent or its mapping
--- can grow where it is, and a resize that cannot moves a mapping's pages
--- with Linux's `mremap` or otherwise copies the block.  Available only on
--- hosted targets.  Threads share it: once the program has started a
--- thread through hosted/thread, its size classes are behind one lock,
--- which a program that has started none never takes, and a block larger
--- than the largest class is a mapping of its own that needs none.  A C
--- thread calling in under `--link=libc` is no thread of the program's,
--- and two of them may not use it at once.
---
--- Every usize alignment is accepted.  Zero and one mean no stricter than
--- byte alignment.  A zero-byte request still returns a distinct, non-null,
--- freeable token on success.  The provider reserves a header plus at most
--- alignment - 1 bytes and refuses an overflow or an extent above the
--- host's PTRDIFF_MAX before asking the host for memory.  Any other failure
--- to obtain memory is reported through mem.out_of_memory, before the
--- provider's own state changes.
---
--- Freeing trusts the two words this heap keeps before every block: the
--- extent it frees is the one they hold, and the `size` passed is not
--- read.  So freeing a block it did not give, freeing one twice, or
--- writing below a block's first byte is undefined, as it is with C's
--- `free`; nothing here can tell such a block from one of its own.  A
--- block larger than the largest class is unmapped when it is freed, and
--- a refusal to unmap, which the system gives only for an address or a
--- length it never mapped, keeps the pages, costing their memory and
--- nothing else.
public heap: type = system_value

word: usize = sizeof usize

--  The largest extent either host takes: PTRDIFF_MAX.
largest: usize = (0 -% 1) >> 1

--  A header word, at a multiple of the word.
store_word: (at: usize, value: usize) -> none =
    cell: ptr mut usize = ptr(at)
    cell.val = value
end store_word

load_word: (at: usize) -> (value: usize) =
    cell: ptr usize = ptr(at)
    value = cell.val
end load_word

--  The first address at or above `first` that is a multiple of `unit`.
align_up: (first: usize, unit: usize) -> (aligned: usize) =
    over: usize = first % unit
    aligned = if over == 0 then first else first + (unit - over) end if
end align_up

--  Every block is preceded by two words: the start of the slot or mapping
--  that holds it, and that slot's or mapping's extent.  A slot of a size
--  class has the class's extent; anything larger than the largest class
--  is a mapping of its own, unmapped when it is freed.
header: usize = 2 * word

--  Where a block's two words are: at the multiple of the word at or below
--  a header before the block, so that they are aligned whatever the
--  block's alignment.  A slot or mapping starts at a multiple of the word
--  and its block is at least a header past that start, so the words never
--  reach below it.
header_at: (block: usize) -> (at: usize) =
    at = (block - header) & (0 -% word)
end header_at

--  Eight classes, of 32 to 4096 bytes.  A class with no free slot maps a
--  chunk and divides it into slots.  A freed slot goes back on its class's
--  list, linked through its first word, and is reused before any new chunk
--  is mapped; chunks are never unmapped.
classes: usize = 8
smallest_class: usize = 32
largest_class: usize = 4096
chunk: usize = 65536

--  The first free slot of each class, or zero.  The lists are plain module
--  storage, which `class_lock` serialises once a thread has started.
mut free_slots: [8]usize

--  The lock over every class's list and over mapping a class's chunk
--  (D502).  A program that has started no thread skips it: the thread
--  facility records the start before it makes the thread, and the
--  creation orders everything this thread did to the lists before.
mut class_lock: lock.lock = zeroed

--  Take the classes' lock if a thread has started, and say whether it was
--  taken, for `give_classes` to give it back alike.
take_classes: () -> (locked: bool) =
    locked = lock.threads_started()
    if locked then
        lock.take(addr class_lock)
    end if
end take_classes

give_classes: (locked: bool) -> none =
    if locked then
        lock.give(addr class_lock)
    end if
end give_classes

--  The smallest class holding `extent` bytes, which is at most the largest
--  class: its index and its size.
class_of: (extent: usize) -> (index: usize, size: usize) =
    index = 0
    size = smallest_class
    while size < extent do
        index += 1
        size = size * 2
    end while
end class_of

--  A mapping of `length` readable and writable bytes, or zero.
map: (length: usize) -> (address: usize) =
    base: ptr mut u8 = posix.map(length) else (problem)
        _ = problem
        address = 0
        return
    end
    address = usize(base)
end map

--  A free slot of class `index` and `size`, taken off its list, or zero
--  when none is free and no chunk could be mapped.
take_slot: (index: usize, size: usize) -> (slot: usize) =
    if free_slots[index] == 0 then
        base: usize = map(chunk)
        if base == 0 then
            slot = 0
            return
        end if
        --  Link the chunk's slots in address order.
        mut at: usize = base
        while at < base + chunk do
            link: ptr mut usize = ptr(at)
            link.val = if at + size < base + chunk then at + size
                       else usize(0) end if
            at += size
        end while
        free_slots[index] = base
    end if
    slot = free_slots[index]
    link: ptr usize = ptr(slot)
    free_slots[index] = link.val
end take_slot

--  Slots and mappings start at multiples of the smallest class, so a unit
--  that divides the header has the block a header past the start aligned
--  already; any other unit may need up to unit - 1 bytes more.
host_alloc: (size: usize, unit: usize) -> (block: usize) =
    slack: usize = if header % unit == 0 then 0 else unit - 1 end if
    extent: usize = size + slack + header
    mut origin: usize = 0
    mut held: usize = 0
    if extent <= largest_class then
        (index, size: class_size) := class_of(extent)
        locked: bool = take_classes()
        origin = take_slot(index, class_size)
        give_classes(locked)
        held = class_size
    else
        page: usize = posix.page_size()
        held = align_up(extent, page)
        origin = map(held)
    end if
    if origin == 0 then
        block = 0
        return
    end if
    block = align_up(origin + header, unit)
    at: usize = header_at(block)
    store_word(at, origin)
    store_word(at + word, held)
end host_alloc

host_free: (block: usize) -> none =
    at: usize = header_at(block)
    origin: usize = load_word(at)
    held: usize = load_word(at + word)
    if held <= largest_class then
        (index, size: _) := class_of(held)
        locked: bool = take_classes()
        link: ptr mut usize = ptr(origin)
        link.val = free_slots[index]
        free_slots[index] = origin
        give_classes(locked)
    else
        --  A refusal means the header no longer holds a mapping of this
        --  heap's, and free has no failure to report it by: the pages, if
        --  any, stay mapped.
        base: ptr mut u8 = ptr(origin)
        posix.unmap(base, held) else none
    end if
end host_free

--  The page rounding a mapping adds, beyond the header and alignment: a
--  page is at most 64 KiB on every hosted system.
rounding: usize = 65535

--  The alignment of a request for `size` bytes as a unit of at least one,
--  or zero when the request is refused before the host is asked: the host
--  takes no extent above PTRDIFF_MAX, and no addition may wrap.
unit_for: (size: usize, alignment: usize) -> (unit: usize) =
    unit = if alignment > 1 then alignment else 1 end if
    if unit - 1 > largest - header - rounding then
        unit = 0
        return
    end if
    padding: usize = unit - 1 + header + rounding
    if size > largest - padding then
        unit = 0
    end if
end unit_for

system_alloc: (self: heap, size: usize, alignment: usize)
              -> (block: ptr mut u8) ! mem.out_of_memory =
    _ = self.reserved
    unit: usize = unit_for(size, alignment)
    fail mem.out_of_memory when unit == 0
    address: usize = host_alloc(size, unit)
    fail mem.out_of_memory when address == 0
    block = ptr(address)
end system_alloc

system_free: (self: heap, block: ptr mut u8, size: usize) -> none =
    _ = self.reserved
    _ = size
    host_free(usize(block))
end system_free

--  Where a block's slot or mapping is: the address of the block's two
--  words, and the slot's or mapping's start and extent, which they hold.
place: type = struct
    at: usize
    origin: usize
    held: usize
end place

place_of: (block: usize) -> (where: place) =
    at: usize = header_at(block)
    where = (at: at, origin: load_word(at), held: load_word(at + word))
end place_of

--  Grow the mapping `where` describes where it is, to hold `ends` bytes
--  from its start, or report that it is a slot or that the pages after
--  it are taken.
extend_mapping: (where: place, ends: usize) -> (grown: bool) =
    grown = false
    return when where.held <= largest_class
    wanted: usize = align_up(ends, posix.page_size())
    base: ptr mut u8 = ptr(where.origin)
    posix.extend(base, where.held, wanted) else (problem)
        _ = problem
        return
    end
    store_word(where.at + word, wanted)
    grown = true
end extend_mapping

--  Make the mapping `where` describes, which holds the block at `block`,
--  hold `ends` bytes from its start, in place or with its pages moved where
--  the system can move them: the block's address afterwards, or zero.
remap_mapping: (block: usize, where: place, ends: usize) -> (moved: usize) =
    moved = 0
    wanted: usize = align_up(ends, posix.page_size())
    base: ptr mut u8 = ptr(where.origin)
    origin: ptr mut u8 = posix.remap(base, where.held, wanted)
        else (problem)
        _ = problem
        return
    end
    moved = usize(origin) + (block - where.origin)
    at: usize = header_at(moved)
    store_word(at, usize(origin))
    store_word(at + word, wanted)
end remap_mapping

--  Give the pages of the mapping `where` describes past `ends` bytes from
--  its start back, keeping it larger than the largest class so that it is
--  still freed as a mapping.  A refusal keeps them, which costs memory and
--  nothing else.
trim_mapping: (where: place, ends: usize) -> none =
    return when where.held <= largest_class
    least: usize = if ends > largest_class then ends else largest_class + 1
                   end if
    kept: usize = align_up(least, posix.page_size())
    return when kept >= where.held
    tail: ptr mut u8 = ptr(where.origin + kept)
    posix.unmap(tail, where.held - kept) else (problem)
        _ = problem
        return
    end
    store_word(where.at + word, kept)
end trim_mapping

--  Whether the block at `block` can hold `size` bytes where it is: in its
--  slot or mapping, or in its mapping grown in place.
host_grow: (block: usize, size: usize) -> (grown: bool) =
    where: place = place_of(block)
    ends: usize = block - where.origin + size
    grown = ends <= where.held or extend_mapping(where, ends)
end host_grow

--  The block at `block` made `new_size` bytes long with `unit`'s alignment
--  without copying its bytes, or zero when that cannot be done: in its slot
--  or mapping when that holds it, or its mapping grown or moved by the
--  system.  The system puts a mapping at a page, so a moved one keeps the
--  block's alignment only when a page has it too.
host_resize: (block: usize, new_size: usize, unit: usize)
             -> (resized: usize) =
    resized = block
    where: place = place_of(block)
    ends: usize = block - where.origin + new_size
    if ends <= where.held then
        trim_mapping(where, ends)
        return
    end if
    if where.held > largest_class then
        if posix.page_size() % unit == 0 then
            resized = remap_mapping(block, where, ends)
            return when resized <> 0
        else
            return when extend_mapping(where, ends)
        end if
    end if
    resized = 0
end host_resize

system_grow: (self: heap, block: ptr mut u8,
              old_size: usize, new_size: usize, alignment: usize)
             -> (grown: bool) =
    _ = self.reserved
    grown = false
    return when new_size <= old_size or unit_for(new_size, alignment) == 0
    grown = host_grow(usize(block), new_size)
end system_grow

system_resize: (self: heap, block: ptr mut u8,
                old_size: usize, new_size: usize, alignment: usize)
               -> (moved: ptr mut u8) ! mem.out_of_memory =
    _ = self.reserved
    unit: usize = unit_for(new_size, alignment)
    fail mem.out_of_memory when unit == 0
    address: usize = host_resize(usize(block), new_size, unit)
    if address <> 0 then
        moved = ptr(address)
        return
    end if
    moved = try mem.relocate(self, block, old_size, new_size, alignment)
end system_resize

heap is mem.allocator (alloc: system_alloc, grow: system_grow,
                       resize: system_resize, free: system_free)

--- Return a handle to the host heap. Making one does not allocate; callers
--- retain and free each successful allocation explicitly.
public new: () -> (handle: heap) =
    handle = (reserved: 0)
end new
