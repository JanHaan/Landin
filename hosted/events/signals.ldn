--  The event provider's `signal.signals` (D449, D477, D482): a watched
--  signal is taken from its default disposition, blocked and read through
--  a signalfd on Linux and ignored and reported by kqueue's
--  EVFILT_SIGNAL on Darwin and FreeBSD, and every child a program starts
--  gets its default back (D479).  An arrival the loop reports is kept
--  until a fibre reads it with `next_signal`, which waits as a receive
--  does, taking turns; two arrivals of one signal before it is read are
--  one event (D488).

import core/io
import core/io/signal
import platform/posix

--  Where a signal sits in `signal_numbers` and the arrivals.
slot: (which: signal.kind) -> (index: usize) =
    index = match which
        signal.interrupt: 0
        signal.terminate: 1
        signal.hangup: 2
        signal.child: 3
        signal.user1: 4
        signal.user2: 5
    end match
end slot

--  The signal at `index`, `slot`'s inverse.
kind_at: (index: usize) -> (which: signal.kind) =
    which = if index == 0 then signal.interrupt
            elsif index == 1 then signal.terminate
            elsif index == 2 then signal.hangup
            elsif index == 3 then signal.child
            elsif index == 4 then signal.user1
            else signal.user2 end if
end kind_at

--  Keep an arrival of the system's signal `number`, unless one waits to
--  be read already or it is no signal this provider watches.
arrive: (state: ptr mut loop_state, number: i32) -> none =
    for index in usize(0)..<kinds do
        if signal_numbers[index] == number then
            for at in usize(0)..<state.val.queued do
                return when usize(state.val.arrived[at]) == index
            end for
            state.val.arrived[state.val.queued] = u8(index)
            inc state.val.queued
            return
        end if
    end for
end arrive

events_watch: (self: host, which: signal.kind) -> none ! io.io_failed =
    cleared(self)
    state: ptr mut loop_state = self.state
    number: i32 = signal_numbers[slot(which)]
    bit: u64 = u64(1) << u64(number - 1)
    state.val.stopped = false
    return when (state.val.watched & bit) <> 0
    --  Named first, so that no child started from now on inherits what
    --  taking it does to its disposition.
    posix.default_in_children(number) else (problem)
        record(self, problem)
        fail io.io_failed
    end
    take_signal(state, number) else (problem)
        record(self, problem)
        fail io.io_failed
    end
    state.val.watched = state.val.watched | bit
end events_watch

events_next_signal: (self: host) -> (received: signal.event)
                    ! io.io_failed =
    cleared(self)
    state: ptr mut loop_state = self.state
    loop do
        fail io.io_failed when state.val.stopped
        collect(state)
        if state.val.queued > 0 then
            index: usize = usize(state.val.arrived[0])
            dec state.val.queued
            for at in usize(0)..<state.val.queued do
                state.val.arrived[at] = state.val.arrived[at + 1]
            end for
            received = (which: kind_at(index),
                        number: u32(signal_numbers[index]))
            return
        end if
        mut entry: waiting = (next: 0, descriptor: -1, output: false,
                              child: 0, signalled: true, deadline: 0,
                              answer: pending)
        answer: u8 = park(self, addr entry) else (problem)
            record(self, problem)
            fail io.io_failed
        end
        fail io.io_failed when answer == failed
    end loop
end events_next_signal

events_stop_watching: (self: host) -> none ! io.io_failed =
    cleared(self)
    state: ptr mut loop_state = self.state
    mut returned: bool = true
    give_signals(state) else (problem)
        record(self, problem)
        returned = false
    end
    state.val.watched = 0
    state.val.queued = 0
    state.val.stopped = true
    answer_signals(state, failed)
    fail io.io_failed when not returned
end events_stop_watching

host is signal.signals (watch: events_watch, next_signal: events_next_signal,
                        stop_watching: events_stop_watching)
