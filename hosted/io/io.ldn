--  The provider of every core/io concept on hosted targets: reader,
--  writer, files and process, and so of their composition, world, and
--  directories, the environment, programs, the clocks and entropy beside
--  them.  It is written once, over platform/posix,
--  which reaches Linux through its system calls and Darwin and FreeBSD
--  through their C library: nothing here is written per system.  Import
--  this module only at a hosted authority root.

import core/io
import core/mem
import core/text
import platform/posix

--  A file open_write creates gets 0666, which the process umask filters.
created_mode: u32 = 0o666

--  A directory made by make_directory gets 0777, which the umask filters.
created_directory_mode: u32 = 0o777

--  The process's last-error cell, which every handle from `host` shares,
--  and its last-signal cell beside it.
mut process_errno: i32
mut process_signal: i32

system_value: type = struct
    failure: ptr mut i32
    signal: ptr mut i32
end system_value

--- Hosted implementation of all four I/O capabilities, `io.world`,
--- `io.directories`, `io.environment`, `io.programs`, the clocks
--- `io.clock` and `io.wall_clock` and the system's `io.entropy`, over
--- platform/posix, as a handle:
--- copies share the process's descriptors, arguments and environment, and
--- the last-error and last-signal cells they were made with. File
--- identifiers belong to this provider; borrowed arguments and variables
--- refer to process storage.
public system: type = system_value

--- A last-error cell and a last-signal cell of the caller's own, for code
--- that must not share the process's: a C thread calling into Landin, or
--- a library keeping its own detail. Declare it `zeroed` and make its
--- handle with `over`.
public space: type = struct
    failure: i32
    signal: i32
end space

--- Return errno captured for the terminal failing provider call. Read it
--- immediately after failure; it belongs to the cell the handle was made
--- with, the process's from `host` or the caller's from `over`, and is not a
--- portable error category.
---
--- Zero means that the most recent open/read/write/close did not report a
--- failing host call.  A nonzero value is the exact errno captured for the
--- terminal call before the provider made any other host call: its number
--- as the system gives it, platform/posix's `number` of the atom the call
--- failed with.  Retriable EINTR attempts are internal and do not replace
--- a previously reported operation with a failure.
public last_errno: (host: system) -> (number: i32) =
    number = host.failure.val
end last_errno

--- Return the number of the signal that ended the child this handle's
--- cell last saw end through `io.wait`, as POSIX numbers it on this
--- system: SIGTERM is 15 and SIGKILL 9 on Linux, Darwin and FreeBSD alike.
--- Zero means that child exited with a code, or that no child has been
--- waited for.  It is the system's detail behind `io.ending`'s portable
--- `signalled`, as `last_errno` is behind an error atom.
public last_signal: (host: system) -> (number: i32) =
    number = host.signal.val
end last_signal

--  Keep a failure's errno in the handle's cell; `unlisted`, which no errno
--  describes, leaves the cell at zero.
record: (self: system, problem: posix.errno) -> none =
    number: i32 = posix.number(problem)
    if number > 0 then self.failure.val = number end if
end record

--  A path names nothing when a component is absent, ENOENT, or when a
--  component before the last is not a directory, ENOTDIR: in both cases
--  there is no file at that path for an open to find.
absent: (problem: posix.errno) -> (yes: bool) =
    yes = problem == posix.enoent or problem == posix.enotdir
end absent

--  Whether an errno says the caller may not do what it asked.
refused: (problem: posix.errno) -> (yes: bool) =
    yes = problem == posix.eperm or problem == posix.eacces
          or problem == posix.erofs
end refused

--  The descriptor a file of this provider is, and the file a descriptor
--  is: the identifier is the descriptor's number.
descriptor_of: (opened: io.file) -> (result: posix.descriptor) =
    result = posix.descriptor(i32(usize(opened)))
end descriptor_of

file_of: (opened: posix.descriptor) -> (result: io.file) =
    result = io.file(usize(i32(opened)))
end file_of

--  Open `path` with `options`.  open reports EINTR before publishing a
--  descriptor, so the same request is retried; every other errno is kept
--  before it is mapped to the stable atom set.
open: (self: system, path: text.host_string, options: posix.open_options)
      -> (opened: io.file) ! io.not_found | io.no_access | io.io_failed =
    self.failure.val = 0
    loop do
        made: posix.descriptor =
            posix.open_at(posix.working_directory, path, options,
                          created_mode) else (problem)
                continue when problem == posix.eintr
                record(self, problem)
                fail io.not_found when absent(problem)
                fail io.no_access when refused(problem)
                fail io.io_failed
            end
        opened = file_of(made)
        return
    end loop
end open

system_open_read: (self: system, path: text.host_string)
                  -> (opened: io.file)
                  ! io.not_found | io.no_access | io.io_failed =
    opened = try open(self, path, posix.reading)
end system_open_read

system_open_write: (self: system, path: text.host_string)
                   -> (opened: io.file)
                   ! io.not_found | io.no_access | io.io_failed =
    opened = try open(self, path, posix.writing)
end system_open_write

--  A stable-path identity check, not an atomic check-and-open operation.
--  Every input lookup failure refuses; only an absent output is allowed.
system_same_file: (self: system, left: text.host_string,
                   right: text.host_string)
                  -> (same: bool) ! io.io_failed =
    self.failure.val = 0
    first: posix.status =
        posix.status_at(posix.working_directory, left, true) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    same = false
    second: posix.status =
        posix.status_at(posix.working_directory, right, true) else (problem)
            return when absent(problem)
            record(self, problem)
            fail io.io_failed
        end
    same = first.device == second.device and first.inode == second.inode
end system_same_file

system_close: (self: system, sink opened: io.file)
              -> none ! io.io_failed =
    self.failure.val = 0
    --  A failed close may already have released the descriptor; retrying
    --  could close an unrelated reused descriptor, so EINTR is
    --  deliberately terminal here.
    posix.close(descriptor_of(opened)) else (problem)
        record(self, problem)
        fail io.io_failed
    end
end system_close

system_read: (self: system, opened: io.file, into: []mut u8)
             -> (count: usize) ! io.io_failed =
    self.failure.val = 0
    if lenof into == 0 then
        count = 0
        return
    end if
    loop do
        --  read returns EINTR only before transferring a byte, so the same
        --  buffer and extent may be retried.  A positive partial read is
        --  returned and is never discarded by an unnecessary retry.
        got: usize = posix.read(descriptor_of(opened), into) else (problem)
            continue when problem == posix.eintr
            record(self, problem)
            fail io.io_failed
        end
        --  A count beyond the buffer violates the system's contract and
        --  fabricates no errno.  Zero from a nonempty read is genuine EOF.
        fail io.io_failed when got > lenof into
        count = got
        return
    end loop
end system_read

write_all: (self: system, opened: io.file, bytes: []u8)
           -> none ! io.io_failed =
    mut written: usize = 0
    while written < lenof bytes do
        remaining: []u8 = bytes[written..<lenof bytes]
        --  write reports EINTR only before this attempt transfers data.
        --  Retry the same remaining suffix; a preceding positive partial
        --  write has already advanced `written` and is never repeated.
        accepted: usize =
            posix.write(descriptor_of(opened), remaining) else (problem)
                continue when problem == posix.eintr
                record(self, problem)
                fail io.io_failed
            end
        --  A nonempty zero-progress success cannot complete write-all, and
        --  an oversized count violates the system's contract.  Neither
        --  fabricates errno.
        fail io.io_failed when accepted == 0 or accepted > lenof remaining
        written += accepted
    end while
end write_all

system_write: (self: system, opened: io.file, bytes: []u8)
              -> none ! io.io_failed =
    self.failure.val = 0
    return when lenof bytes == 0
    try write_all(self, opened, bytes)
end system_write

system_write_some: (self: system, opened: io.file, bytes: []u8)
                   -> (count: usize) ! io.io_failed =
    self.failure.val = 0
    if lenof bytes == 0 then
        count = 0
        return
    end if
    --  Keep a single host request within a representable, bounded extent;
    --  the caller can send the remaining suffix after this progress.
    mut requested: usize = lenof bytes
    if requested > 65536 then requested = 65536 end if
    loop do
        --  EINTR transfers nothing on this attempt. A positive short write
        --  returns immediately so its exact prefix reaches the caller.
        accepted: usize = posix.write(descriptor_of(opened),
                                      bytes[0..<requested]) else (problem)
            continue when problem == posix.eintr
            record(self, problem)
            fail io.io_failed
        end
        fail io.io_failed when accepted == 0 or accepted > requested
        count = accepted
        return
    end loop
end system_write_some

system_input: (self: system) -> (stream: io.file) =
    _ = self.failure
    stream = file_of(posix.standard_input)
end system_input

system_out: (self: system) -> (stream: io.file) =
    _ = self.failure
    stream = file_of(posix.standard_output)
end system_out

system_err: (self: system) -> (stream: io.file) =
    _ = self.failure
    stream = file_of(posix.standard_error)
end system_err

system_argument_count: (self: system) -> (count: usize) =
    _ = self.failure
    table: posix.argument_table = posix.arguments()
    count = table.count
end system_argument_count

--  The argument is lent from the process's argument root, storage that
--  outlives every handle, which satisfies the concept's `from self`.
system_argument: (self: system, index: usize)
                 -> (value: text.host_string from self) ! io.no_argument =
    _ = self.failure
    table: posix.argument_table = posix.arguments()
    fail io.no_argument when index >= table.count
    value = posix.argument(table, index)
end system_argument

--  The environment is platform/posix's, read where the process's entry
--  left it, and lent from storage that outlives every handle, as an
--  argument is.
system_variable_count: (self: system) -> (count: usize) =
    _ = self.failure
    table: posix.environment_table = posix.environment()
    count = table.count
end system_variable_count

system_variable_at: (self: system, index: usize)
                    -> (item: io.variable from self) ! io.no_variable =
    _ = self.failure
    table: posix.environment_table = posix.environment()
    fail io.no_variable when index >= table.count
    item = posix.variable(table, index)
end system_variable_at

system_variable_named: (self: system, name: text.host_string)
                       -> (value: text.host_string from self)
                       ! io.no_variable =
    _ = self.failure
    table: posix.environment_table = posix.environment()
    wanted: []u8 = text.host_bytes(name)
    for index in usize(0)..<table.count do
        item: io.variable = posix.variable(table, index)
        found: []u8 = text.host_bytes(item.name)
        if mem.compare(found, wanted) == mem.equal then
            value = item.value
            return
        end if
    end for
    fail io.no_variable
end system_variable_named

--  The open directory as platform/posix's stream, and the stream's
--  progress kept back in the directory.  The directory's handle is its
--  descriptor's number and its stream the C library's, where there is
--  one.
stream_of: (opened: io.directory) -> (stream: posix.directory_stream) =
    stream = (descriptor: posix.descriptor(i32(opened.handle)),
              stream: opened.stream, filled: opened.filled,
              cursor: opened.cursor, finished: opened.finished)
end stream_of

keep: (inout opened: io.directory, stream: posix.directory_stream) -> none =
    opened.filled = stream.filled
    opened.cursor = stream.cursor
    opened.finished = stream.finished
end keep

system_open_directory: (self: system, path: text.host_string,
                        buffer: []mut u8)
                       -> (opened: io.directory from buffer)
                       ! io.not_found | io.no_access | io.io_failed =
    self.failure.val = 0
    --  Every name a hosted system gives fits a buffer this large, record
    --  and all, so a read never meets one that cannot fit.
    fail io.io_failed when lenof buffer < io.directory_buffer
    loop do
        --  open reports EINTR before publishing a descriptor, so the same
        --  request is retried; every other errno is kept and mapped.
        made: posix.directory_stream =
            posix.open_directory(posix.working_directory, path) else (problem)
                continue when problem == posix.eintr
                record(self, problem)
                fail io.not_found when absent(problem)
                fail io.no_access when refused(problem)
                fail io.io_failed
            end
        opened = (handle: usize(i32(made.descriptor)), stream: made.stream,
                  position: 0, buffer: buffer, filled: made.filled,
                  cursor: made.cursor, finished: made.finished)
        return
    end loop
end system_open_directory

--  `.` and `..` name the directory itself and its parent, never an entry.
dot_name: (name: []u8) -> (yes: bool) =
    yes = false
    return when lenof name == 0 or lenof name > 2 or name[0] <> 46
    yes = lenof name == 1 or name[1] == 46
end dot_name

--  What platform/posix's kind of a file is among core/io's four.
kind_of: (kind: posix.file_kind) -> (named: io.entry_kind) =
    named = if kind == posix.directory then io.subdirectory
            elsif kind == posix.regular then io.regular
            elsif kind == posix.symbolic_link then io.symbolic_link
            else io.special end if
end kind_of

--  What the entry `next` of the directory open as `at` is, and whether it
--  is still there.  Where the file system keeps no kind in its records,
--  the entry itself is asked, relative to the directory, and one removed
--  since the directory was read is no entry.
kind_at: (self: system, at: posix.descriptor, next: posix.directory_entry)
         -> (kind: io.entry_kind, present: bool) ! io.io_failed =
    kind = kind_of(next.kind)
    present = true
    return when next.kind <> posix.unknown_kind
    found: posix.status = posix.status_at(at, next.name, false) else (problem)
        if not absent(problem) then
            record(self, problem)
            fail io.io_failed
        end if
        present = false
        return
    end
    kind = kind_of(found.kind)
end kind_at

system_read_entry: (self: system, inout opened: io.directory)
                   -> (item: io.entry from opened) ! io.io_failed =
    self.failure.val = 0
    loop do
        mut stream: posix.directory_stream = stream_of(opened)
        next: posix.directory_entry =
            posix.read_directory(stream, opened.buffer) else (problem)
                keep(opened, stream)
                --  A read interrupted before it filled anything is read
                --  again.
                continue when problem == posix.eintr
                record(self, problem)
                fail io.io_failed
            end
        opened.filled = stream.filled
        opened.cursor = stream.cursor
        opened.finished = stream.finished
        name: []u8 = text.host_bytes(next.name)
        if lenof name == 0 then
            item = (name: next.name, kind: io.special)
            return
        end if
        if not dot_name(name) then
            (kind, present) := try kind_at(self, stream.descriptor, next)
            if present then
                item = (name: next.name, kind: kind)
                return
            end if
        end if
    end loop
end system_read_entry

system_entry_size: (self: system, opened: io.directory,
                    name: text.host_string)
                   -> (size: u64) ! io.not_found | io.no_access | io.io_failed =
    self.failure.val = 0
    size = 0
    --  No hosted system gives a name this long, or one with a `/` or a
    --  NUL, so no entry has one, and the system is not asked.
    bytes: []u8 = text.host_bytes(name)
    fail io.not_found when lenof bytes == 0
      or lenof bytes >= io.directory_buffer
    for byte in bytes do
        fail io.not_found when byte == 0 or byte == 47
    end for
    found: posix.status =
        posix.status_at(posix.descriptor(i32(opened.handle)), name,
                        false) else (problem)
            record(self, problem)
            fail io.not_found when absent(problem)
            fail io.no_access when refused(problem)
            fail io.io_failed
        end
    size = found.size
end system_entry_size

system_close_directory: (self: system, sink opened: io.directory)
                        -> none ! io.io_failed =
    self.failure.val = 0
    --  The descriptor may already be released, as with close, so a
    --  failure is terminal and never retried.
    posix.close_directory(stream_of(opened)) else (problem)
        record(self, problem)
        fail io.io_failed
    end
end system_close_directory

system_make_directory: (self: system, path: text.host_string)
                       -> none
                       ! io.already_exists | io.not_found | io.no_access
                       | io.io_failed =
    self.failure.val = 0
    --  Not retried on EINTR: a directory made before the interruption
    --  would then report EEXIST.
    posix.make_directory_at(posix.working_directory, path,
                            created_directory_mode) else (problem)
        record(self, problem)
        fail io.already_exists when problem == posix.eexist
        fail io.not_found when absent(problem)
        fail io.no_access when refused(problem)
        fail io.io_failed
    end
end system_make_directory

--  Remove the file, or with `directory` the empty directory, at `path`.
removed: (path: text.host_string, directory: bool) -> none ! posix.errno =
    if directory then
        try posix.remove_directory_at(posix.working_directory, path)
    else
        try posix.unlink_at(posix.working_directory, path)
    end if
end removed

remove: (self: system, path: text.host_string, directory: bool)
        -> none ! io.not_found | io.no_access | io.io_failed =
    self.failure.val = 0
    removed(path, directory) else (problem)
        record(self, problem)
        fail io.not_found when absent(problem)
        fail io.no_access when refused(problem)
        fail io.io_failed
    end
end remove

system_remove_file: (self: system, path: text.host_string)
                    -> none ! io.not_found | io.no_access | io.io_failed =
    try remove(self, path, false)
end system_remove_file

system_remove_directory: (self: system, path: text.host_string)
                         -> none ! io.not_found | io.no_access | io.io_failed =
    try remove(self, path, true)
end system_remove_directory

system is io.reader (read: system_read)
system is io.writer (write: system_write, write_some: system_write_some)
system is io.files
    (open_read: system_open_read, open_write: system_open_write,
     same_file: system_same_file, close: system_close)
system is io.process
    (input: system_input, out: system_out, err: system_err,
     argument_count: system_argument_count, argument: system_argument)
system is io.environment
    (variable_count: system_variable_count,
     variable_at: system_variable_at,
     variable_named: system_variable_named)
system is io.world ()
system is io.directories
    (open_directory: system_open_directory,
     read_entry: system_read_entry, entry_size: system_entry_size,
     close_directory: system_close_directory,
     make_directory: system_make_directory,
     remove_file: system_remove_file,
     remove_directory: system_remove_directory)

--- Return a handle to the hosted I/O provider, exposing process arguments and
--- the three standard streams, descriptors 0, 1 and 2. Regular open-write
--- operations create or truncate files; close regular files explicitly. The
--- handle borrows nothing: the argument root, the descriptors and its
--- last-error cell belong to the process. Use `over` for a cell of the
--- caller's own.
---
--- The arguments are the root platform/posix's
--- `_landin_host_initialize_arguments` established, which the hosted entry
--- establishes before its body runs; calling this before any root exists
--- traps.
public host: () -> (handle: system) =
    _ = posix.arguments()
    handle = (failure: addr process_errno, signal: addr process_signal)
end host

--- Fill `state` and return a handle that records its last error there
--- rather than in the process's cell. It shares the process's arguments
--- and descriptors like any other handle; calling this before any root
--- exists traps, as `host` does.
public over: (inout state: space) -> (handle: system from state) =
    _ = posix.arguments()
    state = (failure: 0, signal: 0)
    handle = (failure: addr state.failure, signal: addr state.signal)
end over
