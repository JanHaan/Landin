--  The hosted provider's clocks and entropy, written once over
--  platform/posix: `io.clock` is the monotonic clock and sleeping on it,
--  `io.wall_clock` the realtime clock, and `io.entropy` the system's own
--  random bytes.

import core/io
import platform/posix

--  A second in nanoseconds.
second: u64 = 1000000000

--  The longest one request to sleep asks for, about eleven days.
longest: u64 = 1000000 * second

--  The clock `clock` read now.  Every hosted system has both clocks, and
--  reading one fails only when the process is given a bad address, which
--  no call here gives, so a failure ends the program.
read: (clock: posix.clock_kind) -> (time: posix.time_value) =
    time = posix.clock_time(clock) else (problem)
        _ = problem
        compiler.unreachable()
    end
end read

--  The monotonic clock in nanoseconds since the system started, which no
--  hosted system counts as negative.
reading: () -> (at: u64) =
    time: posix.time_value = read(posix.monotonic_clock)
    at = u64(time.seconds) * second + u64(time.nanoseconds)
end reading

system_now: (self: system) -> (at: io.instant) =
    _ = self.failure
    at = io.instant(reading())
end system_now

--  The sleep is measured on the clock `now` reads, whatever clock the
--  system sleeps on: the deadline is taken first, and the system is asked
--  again for what is left until the clock has reached it, so a sleep a
--  signal interrupts, or the system ends early, sleeps on for the rest.
--  A deadline past the clock's last instant is that instant.  A system
--  that refused every sleep would leave this loop reading the clock until
--  the deadline, which is still never early; none of them does.
system_sleep: (self: system, span: io.duration) -> none =
    _ = self.failure
    start: u64 = reading()
    room: u64 = (0 -% 1) - start
    deadline: u64 = if u64(span) > room then 0 -% 1
                    else start + u64(span) end if
    loop do
        now: u64 = reading()
        return when now >= deadline
        --  No more than a million seconds at once, within what every
        --  system's sleep takes; the loop sleeps again for the rest.
        mut left: u64 = deadline - now
        if left > longest then left = longest end if
        whole: u64 = left / second
        posix.sleep((seconds: i64(whole),
                     nanoseconds: u32(left - whole * second))) else (problem)
            --  Interrupted, or refused: the clock says what is left.
            _ = problem
        end
    end loop
end system_sleep

system_wall_now: (self: system) -> (at: io.wall_time) =
    _ = self.failure
    time: posix.time_value = read(posix.realtime_clock)
    at = (seconds: time.seconds, nanoseconds: time.nanoseconds)
end system_wall_now

--  The system gives at most so much at once, and a signal may interrupt it
--  before it gives anything; both are asked again for the rest.
system_fill_random: (self: system, into: []mut u8) -> none ! io.io_failed =
    self.failure.val = 0
    mut filled: usize = 0
    while filled < lenof into do
        got: usize = posix.random_bytes(into[filled..<lenof into]) else (problem)
            continue when problem == posix.eintr
            record(self, problem)
            fail io.io_failed
        end
        fail io.io_failed when got == 0 or got > lenof into - filled
        filled += got
    end while
end system_fill_random

system is io.clock (now: system_now, sleep: system_sleep)
system is io.wall_clock (wall_now: system_wall_now)
system is io.entropy (fill_random: system_fill_random)
