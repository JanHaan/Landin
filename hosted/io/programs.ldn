--  The hosted provider's `io.programs`: a child is platform/posix's spawn,
--  its pipes are descriptors this provider made, and waiting for it is
--  POSIX's `waitpid`.  Written once, over platform/posix, like the rest.

import core/io
import core/text
import platform/posix

--  One of a child's streams as the spawn makes it: the descriptor the
--  child's stream is made from, the parent's end of its pipe when it is
--  piped, and whether the child's side was made here, a pipe's end or
--  /dev/null, and so is closed in the parent once the child has it.
stream_end: type = struct
    child_side: posix.descriptor
    parent_side: posix.descriptor
    made: bool
    piped: bool
end stream_end

--  What a discarded stream is: the system's null device, which reads at
--  once to its end and takes every write.
null_device: []u8 = "/dev/null"

--  Make the child's stream `target` as `choice` says; `output` when the
--  child writes it.
prepared: (choice: io.stream_choice, target: posix.descriptor, output: bool)
          -> (result: stream_end) ! posix.errno =
    result = (child_side: target, parent_side: target, made: false,
              piped: false)
    return when choice == io.inherited
    if choice == io.discarded then
        --  The device exists, and is neither created nor truncated.
        options: posix.open_options =
            (access: if output then posix.write_only else posix.read_only
                     end if,
             create: false, exclusive: false, truncate: false,
             append: false, directory: false)
        loop do
            made: posix.descriptor =
                posix.open_at(posix.working_directory,
                              text.host_over(null_device), options,
                              0) else (problem)
                    continue when problem == posix.eintr
                    fail problem
                end
            result = (child_side: made, parent_side: made, made: true,
                      piped: false)
            return
        end loop
    end if
    ends: posix.pipe_ends = try posix.pipe()
    result = if output then (child_side: ends.writing,
                             parent_side: ends.reading, made: true,
                             piped: true)
             else (child_side: ends.reading, parent_side: ends.writing,
                   made: true, piped: true) end if
end prepared

--  Close what the spawn made for a stream: the child's side, which the
--  child has its own copy of, and with `everything` the parent's end too,
--  when no child was started.
dropped: (given: stream_end, everything: bool) -> none =
    if given.made then quietly_closed(given.child_side) end if
    if everything and given.piped then
        quietly_closed(given.parent_side)
    end if
end dropped

--  Close a descriptor no caller is told about.
quietly_closed: (closing: posix.descriptor) -> none =
    posix.close(closing) else (problem)
        _ = problem
    end
end quietly_closed

--  posix.spawn reports a failure only when no child was started, so an
--  interrupted spawn is made again.
spawned: (path: text.host_string, arguments: []text.host_string,
          environment: []io.variable, streams: posix.standard_streams)
         -> (child: posix.process_id) ! posix.errno =
    loop do
        child = posix.spawn(path, arguments, environment,
                            streams) else (problem)
            continue when problem == posix.eintr
            fail problem
        end
        return
    end loop
end spawned

launched: (path: text.host_string, arguments: []text.host_string,
           environment: []io.variable, streams: io.child_streams)
          -> (started: io.child) ! posix.errno =
    input: stream_end = try prepared(streams.input, posix.standard_input,
                                     false)
    undo dropped(input, true)
    output: stream_end = try prepared(streams.output, posix.standard_output,
                                      true)
    undo dropped(output, true)
    errors: stream_end = try prepared(streams.errors, posix.standard_error,
                                      true)
    undo dropped(errors, true)
    child: posix.process_id = try spawned(path, arguments, environment,
                                          (input: input.child_side,
                                           output: output.child_side,
                                           errors: errors.child_side))
    dropped(input, false)
    dropped(output, false)
    dropped(errors, false)
    started = (handle: usize(i32(child)), input: file_of(input.parent_side),
               output: file_of(output.parent_side),
               errors: file_of(errors.parent_side),
               input_open: input.piped, output_open: output.piped,
               errors_open: errors.piped)
end launched

system_spawn: (self: system, path: text.host_string,
               arguments: []text.host_string, environment: []io.variable,
               streams: io.child_streams)
              -> (started: io.child)
              ! io.not_found | io.no_access | io.io_failed =
    self.failure.val = 0
    started = launched(path, arguments, environment, streams) else (problem)
        record(self, problem)
        fail io.not_found when absent(problem)
        fail io.no_access when refused(problem)
        fail io.io_failed
    end
end system_spawn

--  Close one of a child's pipes, which is closed even when the system
--  reports a failure.
close_pipe: (self: system, opened: io.file) -> none ! io.io_failed =
    posix.close(descriptor_of(opened)) else (problem)
        record(self, problem)
        fail io.io_failed
    end
end close_pipe

--  Write all of BYTES to the child's input pipe, its descriptor, as a
--  write to any file of this provider is made.
system_write_child: (self: system, inout started: io.child, bytes: []u8)
                    -> none ! io.io_failed =
    self.failure.val = 0
    fail io.io_failed when not started.input_open
    try system_write(self, started.input, bytes)
end system_write_child

system_close_input: (self: system, inout started: io.child)
                    -> none ! io.io_failed =
    self.failure.val = 0
    fail io.io_failed when not started.input_open
    started.input_open = false
    try close_pipe(self, started.input)
end system_close_input

--  Whether the child's errors, and not its output, is what to read next:
--  the output when it has anything, its end included, and the errors only
--  when they alone do.  A wait a signal interrupted is made again.
errors_first: (self: system, started: io.child) -> (yes: bool)
              ! io.io_failed =
    mut entries: [2]posix.poll_entry =
        [posix.watch(descriptor_of(started.output), posix.poll_input),
         posix.watch(descriptor_of(started.errors), posix.poll_input)]
    loop do
        _ = posix.poll(entries[0..<2], -1) else (problem)
            continue when problem == posix.eintr
            record(self, problem)
            fail io.io_failed
        end
        break
    end loop
    yes = posix.happened(entries[0]) == posix.poll_no_events
end errors_first

system_read_child: (self: system, inout started: io.child, into: []mut u8)
                   -> (taken: io.child_read) ! io.io_failed =
    self.failure.val = 0
    taken = (count: 0, errors: false,
             finished: not started.output_open and not started.errors_open)
    return when lenof into == 0
    loop do
        if not started.output_open and not started.errors_open then
            taken = (count: 0, errors: false, finished: true)
            return
        end if
        mut from_errors: bool = not started.output_open
        if started.output_open and started.errors_open then
            from_errors = try errors_first(self, started)
        end if
        opened: io.file = if from_errors then started.errors
                          else started.output end if
        count: usize = try system_read(self, opened, into)
        if count > 0 then
            taken = (count: count, errors: from_errors, finished: false)
            return
        end if
        --  That stream has ended, and its pipe is done with.
        if from_errors then
            started.errors_open = false
        else
            started.output_open = false
        end if
        try close_pipe(self, opened)
    end loop
end system_read_child

--  Close every pipe the child still has, keeping the first failure.
close_pipes: (self: system, started: io.child) -> (closed: bool) =
    closed = true
    if started.input_open and not pipe_closed(self, started.input) then
        closed = false
    end if
    if started.output_open and not pipe_closed(self, started.output) then
        closed = false
    end if
    if started.errors_open and not pipe_closed(self, started.errors) then
        closed = false
    end if
end close_pipes

--  Whether a pipe closed without a failure.
pipe_closed: (self: system, opened: io.file) -> (closed: bool) =
    closed = true
    close_pipe(self, opened) else (problem)
        _ = problem
        closed = false
    end
end pipe_closed

--  Wait for the child, again when a signal interrupts the wait.
waited: (self: system, child: posix.process_id)
        -> (status: posix.child_status) ! io.io_failed =
    loop do
        status = posix.wait(child) else (problem)
            continue when problem == posix.eintr
            record(self, problem)
            fail io.io_failed
        end
        return
    end loop
end waited

--  The pipes are closed before the wait, so a child still writing to one
--  meets a closed pipe rather than waiting for a reader that never comes.
system_wait: (self: system, sink started: io.child)
             -> (ended: io.ending) ! io.io_failed =
    self.failure.val = 0
    self.signal.val = 0
    closed: bool = close_pipes(self, started)
    status: posix.child_status =
        try waited(self, posix.process_id(i32(started.handle)))
    match status.how
        posix.exited(code): ended = (how: io.exited(code: code))
        posix.signalled(number): begin
            self.signal.val = number
            ended = (how: io.signalled)
        end
    end match
    fail io.io_failed when not closed
end system_wait

system is io.programs
    (spawn: system_spawn, write_child: system_write_child,
     close_input: system_close_input, read_child: system_read_child,
     wait: system_wait)
